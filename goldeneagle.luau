function State.NoJump.CanFire()
    if not State.Active then return false, 'Script is inactive.' end
    if not State.RequestedEnabled then return false, 'Enable Silent Aim first.' end
    if not State.NoJump.IsEnabled() then return false, 'Enable No Jump Shot first.' end
    if UserInputService:GetFocusedTextBox() then return false, 'Finish typing before firing.' end
    if State.PassInProgress or State.silentShootActive
        or (State.AutoDunk and State.AutoDunk.InProgress) then
        return false, 'Another shot action is already running.'
    end

    local Character = LP.Character
    local HumanoidObject = Character and safe_find(Character, 'Humanoid')
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local Basketball = Character and safe_find(Character, 'Basketball')
    if not (Character and HumanoidObject and Root) or HumanoidObject.Health <= 0 then
        return false, 'Character is not ready.'
    end
    if CONFIG.AimRequireBall and not Basketball then
        return false, 'Hold the basketball first.'
    end
    if HumanoidObject.FloorMaterial == Enum.Material.Air then
        return false, 'No Jump Shot requires the character to be grounded.'
    end
    return true
end

function State.NoJump.LockToGround(Root, HumanoidObject, Generation)
    local GroundY = Root.Position.Y
    local EndsAt = os.clock() + math.max(
        tonumber(CONFIG.NoJumpGroundLockTime) or 0.30, 0.08)

    State.Lifecycle:Spawn(function()
        while State.Active and State.NoJump.Active
            and State.NoJump.Generation == Generation and os.clock() < EndsAt
            and Root and Root.Parent and HumanoidObject and HumanoidObject.Parent do
            local Velocity = Root.AssemblyLinearVelocity
            Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
            local Position = Root.Position
            if math.abs(Position.Y - GroundY) > 0.01 then
                local Rotation = Root.CFrame - Position
                Root.CFrame = CFrame.new(Position.X, GroundY, Position.Z) * Rotation
            end
            RunService.Heartbeat:Wait()
        end

        if HumanoidObject and HumanoidObject.Parent then
            HumanoidObject.Jump = false
            pcall(function()
                if HumanoidObject.FloorMaterial ~= Enum.Material.Air then
                    HumanoidObject:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end
        if State.NoJump.Generation == Generation then
            State.NoJump.Active = false
        end
    end)
end

function State.NoJump.Fire()
    local CanFire, Reason = State.NoJump.CanFire()
    if not CanFire then
        Notify('NO JUMP SHOT', Reason or 'Shot is unavailable.')
        return false
    end
    State.NoJump.Generation += 1
    local Generation = State.NoJump.Generation

    if State.Enabled ~= true or SilentAim.ActorAimReady ~= true then
        SilentAim.HookNewActors()
        local Ready = SilentAim.EnsureActorAim() == true
        State.Enabled = Ready
        if Ready then
            UpdateSilentAimController()
            if HubUI.Sync then HubUI.Sync() end
        else
            Notify('NO JUMP SHOT', 'Silent Aim is on, but its actor hooks are still unavailable.')
            return false
        end
    end

    local Character = LP.Character
    local HumanoidObject = Character and safe_find(Character, 'Humanoid')
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    if not (HumanoidObject and Root) then
        Notify('NO JUMP SHOT', 'Character is not ready.')
        return false
    end

    local Rim, Distance = FindConfiguredGoal()
    if not Rim then
        Notify('NO JUMP SHOT', 'No valid scoring goal was found.')
        return false
    end

    local AimDistance = State.Backboard.GetConfiguredAimDistance(Rim, Distance)
    local AdjustedDistance = AdjustAimDistance(AimDistance)
    local Power = State.PowerBypass.GetEffectivePower()

    if CONFIG.AutoPower and not PowerSupportsDistance(Power, AdjustedDistance)
        and State.SelectBestAutoPower then
        local BestPower = State.SelectBestAutoPower(AdjustedDistance, Power)
        if BestPower then
            Power = State.PowerBypass.SyncChannels(BestPower)
            State.LastAutoPowerPick = { Power = BestPower, At = os.clock() }
        end
    end

    local Target, YOffset = BuildSilentAimTarget(Rim, AimDistance, Power, nil, true)
    if not Target then
        Notify('NO JUMP SHOT', 'No ballistic solution exists at the current power and distance.')
        return false
    end

    State.NoJump.Active = true
    State.NoJump.SyntheticInput = true
    State.NoJump.LockToGround(Root, HumanoidObject, Generation)
    SilentAim.FireActorAim(Target)

    local InputOk = pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        RunService.RenderStepped:Wait()
        HumanoidObject.Jump = true
        HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)

        local HoldUntil = os.clock() + math.max(
            tonumber(CONFIG.NoJumpJumpKeyHoldTime) or 0.05, 0.02)
        local ArmFrames = math.max(
            math.floor(tonumber(CONFIG.NoJumpArmFrames) or 4), 2)
        for _ = 1, ArmFrames do
            RunService.RenderStepped:Wait()
        end
        while os.clock() < HoldUntil do
            RunService.RenderStepped:Wait()
        end
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
    if not InputOk then
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end

    if not (State.Active and State.NoJump.Generation == Generation) then
        State.NoJump.Active = false
        State.NoJump.SyntheticInput = false
        SilentAim.ClearActorAim()
        return false
    end

    local ShotOk = SilentShoot(Rim, YOffset or 0, Target, Target)
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
    State.Lifecycle:Delay(0.08, function()
        if State.NoJump.Generation == Generation then
            State.NoJump.SyntheticInput = false
        end
    end)
    if not ShotOk then
        Notify('NO JUMP SHOT', 'Native shot input was not accepted.')
    end
    return ShotOk
end

function State.NoJump.BindKey(KeyCode)
    local ContextActionService = game:GetService('ContextActionService')
    pcall(function()
        ContextActionService:UnbindAction(State.NoJump.ActionName)
    end)
    State.NoJump.Bound = false

    if typeof(KeyCode) ~= 'EnumItem' or KeyCode.EnumType ~= Enum.KeyCode then
        return false
    end

    local BoundOk = pcall(function()
        ContextActionService:BindActionAtPriority(
            State.NoJump.ActionName,
            function(_, InputState)
            local Focused = UserInputService:GetFocusedTextBox() ~= nil
            local ShouldCapture = State.Active and State.NoJump.IsEnabled()
                and not HubUI.Open and not Focused
            if not ShouldCapture then
                return Enum.ContextActionResult.Pass
            end
            if InputState == Enum.UserInputState.Begin then
                State.Lifecycle:Spawn(State.NoJump.Fire)
            end
            return Enum.ContextActionResult.Sink
        end,
            false,
            Enum.ContextActionPriority.High.Value + 100,
            KeyCode
        )
    end)
    State.NoJump.Bound = BoundOk
    return BoundOk
end

