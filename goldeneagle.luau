function State.Utility.TryDailySpin()
    if not (State.Active and State.AutoDailySpinEnabled) then return false end
    local PlayerData = State.Utility.PlayerData
    local Remote = State.Utility.DailySpinRemote
    if not (PlayerData and type(PlayerData.Get) == 'function' and Remote and Remote.Parent) then
        State.Utility.DailySpinStatus = 'UNAVAILABLE'
        return false
    end
    local OkReady, LastDaily = pcall(PlayerData.Get, 'General', 'LastDaily')
    if not OkReady or tonumber(LastDaily) == nil then
        State.Utility.DailySpinStatus = 'WAITING FOR DATA'
        return false
    end
    local Remaining = tonumber(LastDaily) - os.time()
    if Remaining > 0.5 then
        State.Utility.DailySpinStatus = string.format('READY IN %02d:%02d', math.floor(Remaining / 60), math.floor(Remaining % 60))
        return false
    end
    local Now = os.clock()
    if Now - State.Utility.LastDailyAttempt < CONFIG.AutoDailySpinRetryDelay then return false end
    State.Utility.LastDailyAttempt = Now
    State.Utility.DailySpinStatus = 'SPINNING'
    local Success, Accepted, PrizeIndex = pcall(function()
        return Remote:InvokeServer('spin', math.random(60, 75) / 10)
    end)
    if Success and Accepted then
        State.Utility.DailySpinStatus = 'CLAIMED' .. (PrizeIndex and (' | SLOT ' .. tostring(PrizeIndex)) or '')
        Notify('GOLDEN EAGLE', 'Daily spin claimed.')
        return true
    end
    State.Utility.DailySpinStatus = Success and 'NOT READY' or 'REQUEST FAILED'
    return false
end

