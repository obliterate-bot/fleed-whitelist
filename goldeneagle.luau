function State.LocalSpoofs.IsLocalBanner(Main, Object)
    if LP.Character and Object:IsDescendantOf(LP.Character) then return true end
    if not Object:IsDescendantOf(LP.PlayerGui) then return false end
    local Root = Main
    for _ = 1, 5 do if Root.Parent then Root = Root.Parent end end
    for _, Descendant in ipairs(Root:GetDescendants()) do
        if Descendant:IsA('TextLabel') or Descendant:IsA('TextButton') then
            local Text = tostring(Descendant.Text or '')
            if Text == LP.Name or Text == LP.DisplayName or Text == ('@' .. LP.Name)
                or (State.LocalAliasEnabled and Text == tostring(State.LocalAlias)) then return true end
        end
    end
    return false
end

function State.LocalSpoofs.RegisterIntroBanner(Object)
    if not (Object and Object.Name == 'RecordLabel' and (Object:IsA('TextLabel') or Object:IsA('TextButton'))) then return end
    local Main = Object.Parent
    if not (Main and Main:FindFirstChild('RankImage') and Main:FindFirstChild('Streak')) then return end
    if not State.LocalSpoofs.IsLocalBanner(Main, Object) then return end
    State.LocalSpoofs.StatsIntroCards[Main] = true
    State.LocalSpoofs.SetStatsUI(Object, 'Text', Object.Text)
    State.LocalSpoofs.ApplyOverallVisual(Main, State.LocalOverall)
    local Streak = Main:FindFirstChild('Streak')
    local Amount = Streak and Streak:FindFirstChild('AmountLabel')
    if Amount then State.LocalSpoofs.SetStatsUI(Amount, 'Text', Amount.Text) end
    if Streak and Streak:IsA('ImageLabel') then State.LocalSpoofs.SetStatsUI(Streak, 'Image', Streak.Image) end
    local RankImage = Main:FindFirstChild('RankImage')
    if RankImage and RankImage:IsA('ImageLabel') then State.LocalSpoofs.SetStatsUI(RankImage, 'Image', RankImage.Image) end
    local RankLabel = Main:FindFirstChild('RankLabel')
    if RankLabel and RankLabel:IsA('TextLabel') then State.LocalSpoofs.SetStatsUI(RankLabel, 'Text', RankLabel.Text) end
    if State.LocalStatsSpoofEnabled then pcall(State.LocalSpoofs.ApplyStatsLock) end
end

function State.LocalSpoofs.ScanBannerRoot(Root)
    if not Root then return end
    for _, Object in ipairs(Root:GetDescendants()) do State.LocalSpoofs.RegisterIntroBanner(Object) end
end

function State.LocalSpoofs.BindIntroBanners(Character)
    if Character then
        State.LocalSpoofs.ScanBannerRoot(Character)
        GiveSignal(Character.DescendantAdded:Connect(function(Object)
            State.Lifecycle:Defer(function() State.LocalSpoofs.RegisterIntroBanner(Object) end)
        end))
    end
    if not State.LocalSpoofs.BannerGuiBound then
        State.LocalSpoofs.BannerGuiBound = true
        State.LocalSpoofs.ScanBannerRoot(LP.PlayerGui)
        GiveSignal(LP.PlayerGui.DescendantAdded:Connect(function(Object)
            State.Lifecycle:Defer(function() State.LocalSpoofs.RegisterIntroBanner(Object) end)
        end))
    end
end

function State.LocalSpoofs.RefreshFakeMatchHistory()
    for _, Object in ipairs(LP.PlayerGui:GetDescendants()) do
        if Object.Name == 'HistoryFrame' and Object:FindFirstChild('PageFrame') then
            local Frame = Object:FindFirstChild('Frame');
            local Search = Frame and Frame:FindFirstChild('SearchBox')
            if Search and Search:IsA('TextBox') then
                local Old = Search.Text
                Search.Text = Old .. ' '
                State.Lifecycle:Defer(function()
                    if Search and Search.Parent then Search.Text = Old end
                    State.Lifecycle:Delay(0.12,State.LocalSpoofs.PatchFakeDrawRows)
                end)
            end
        end
    end
end

function State.LocalSpoofs.ParseFakePlayers(Text, DefaultName)
    local Result = {}
    for Name in string.gmatch(tostring(Text or ''), '[^,]+') do
        Name = string.match(Name, '^%s*(.-)%s*$')
        if Name ~= '' then table.insert(Result, Name) end
    end
    if #Result == 0 then table.insert(Result, DefaultName) end
    return Result
end

function State.LocalSpoofs.PatchFakeDrawRows()
    local PlayerData = State.LocalSpoofs.PlayerData
    local History = PlayerData and PlayerData.storedData and PlayerData.storedData.MatchHistory
    if type(History) ~= 'table' then return end
    local Orange=Color3.fromRGB(225,105,15);
    local DarkOrange=Color3.fromRGB(155,62,8)
    local function RecolorRow(Row)
        for _,Object in ipairs(Row:GetDescendants()) do
            if Object:IsA('TextLabel') then
                local Upper=string.upper(Object.Text)
                if Upper=='LOSE' or Upper=='LOSS' then Object.Text='DRAW';
                    Object.TextColor3=Orange end
                local Gradient=Object:FindFirstChildOfClass('UIGradient')
                if Gradient and (Upper=='LOSE' or Upper=='LOSS') then Gradient.Color=ColorSequence.new(DarkOrange,Orange) end
            elseif Object:IsA('GuiObject') and Object.BackgroundTransparency<1 then
                local C=Object.BackgroundColor3
                if C.R>C.G*1.25 and C.R>C.B*1.15 then Object.BackgroundColor3=DarkOrange end
            elseif Object:IsA('ImageLabel') or Object:IsA('ImageButton') then
                local C=Object.ImageColor3
                if C.R>C.G*1.25 and C.R>C.B*1.15 then Object.ImageColor3=Orange end
            elseif Object:IsA('UIStroke') then
                local C=Object.Color
                if C.R>C.G*1.25 and C.R>C.B*1.15 then Object.Color=Orange end
            end
        end
    end
    State.LocalSpoofs.HasFakeDraws=false
    for _,Match in ipairs(History) do if Match.__GoldenEagleFake and Match.__DisplayResult=='Draw' then State.LocalSpoofs.HasFakeDraws=true end end
    if not State.LocalSpoofs.HasFakeDraws then return end
    for _,Root in ipairs(LP.PlayerGui:GetDescendants()) do
        if Root.Name=='HistoryFrame' and Root:FindFirstChild('PageFrame') then
            for _,Row in ipairs(Root.PageFrame:GetChildren()) do
                if Row:IsA('Frame') then
                    local TeamA=Row:FindFirstChild('TeamA');
                    local TeamB=Row:FindFirstChild('TeamB')
                    local ScoreA=Row:FindFirstChild('TeamAScore');
                    local ScoreB=Row:FindFirstChild('TeamBScore')
                    for _,Match in ipairs(History) do
                        if Match.__GoldenEagleFake and Match.__DisplayResult=='Draw' and TeamA and TeamB and ScoreA and ScoreB
                            and tonumber(ScoreA.Text)==tonumber(Match.HomeScore) and tonumber(ScoreB.Text)==tonumber(Match.AwayScore) then
                            local HomeHit=false;
                            local AwayHit=false
                            for Name in pairs(Match.Home) do if string.find(TeamA.Text,Name,1,true) then HomeHit=true break end end
                            for Name in pairs(Match.Away) do if string.find(TeamB.Text,Name,1,true) then AwayHit=true break end end
                            if HomeHit and AwayHit then RecolorRow(Row) end
                        end
                    end
                end
            end
        elseif Root.Name=='ResultLabel' and Root:IsA('TextLabel') and string.match(string.upper(Root.Text),'^LOSE') then
            Root.Text=string.gsub(Root.Text,'^[Ll][Oo][Ss][Ee]','DRAW')
            Root.TextColor3=Orange
            local Gradient=Root:FindFirstChildOfClass('UIGradient');
            if Gradient then Gradient.Color=ColorSequence.new(DarkOrange,Orange) end
        end
    end
end

function State.LocalSpoofs.AddFakeMatch(Custom)
    Custom = type(Custom)=='table' and Custom or {}
    State.LocalSpoofs.PlayerData = State.LocalSpoofs.PlayerData or require(ReplicatedStorage.Util.PlayerData)
    local Data = State.LocalSpoofs.PlayerData.storedData
    if type(Data) ~= 'table' then return end
    Data.MatchHistory = type(Data.MatchHistory) == 'table' and Data.MatchHistory or {}
    local Result = tostring(Custom.Result or 'Win')
    if Result=='Loss' then Result='Lose' end
    if Result~='Win' and Result~='Lose' and Result~='Draw' and Result~='Protected' then Result='Win' end
    local RenderResult = Result=='Draw' and 'Lose' or Result
    local HomeScore = math.clamp(math.floor(tonumber(Custom.HomeScore) or 21),0,999)
    local AwayScore = math.clamp(math.floor(tonumber(Custom.AwayScore) or 15),0,999)
    local DefaultLocalName = State.LocalAnonymizerEnabled and State.LocalAlias or LP.Name
    local HomeNames = State.LocalSpoofs.ParseFakePlayers(Custom.HomePlayers,DefaultLocalName)
    local AwayNames = State.LocalSpoofs.ParseFakePlayers(Custom.AwayPlayers,'Anonymous')
    local RequestedSize = math.clamp(math.floor(tonumber(Custom.TeamSize) or math.max(#HomeNames,#AwayNames)),1,4)
    while #HomeNames < RequestedSize do table.insert(HomeNames,'Home Player '..tostring(#HomeNames+1)) end
    while #AwayNames < RequestedSize do table.insert(AwayNames,'Away Player '..tostring(#AwayNames+1)) end
    while #HomeNames > RequestedSize do table.remove(HomeNames) end
    while #AwayNames > RequestedSize do table.remove(AwayNames) end
    local ELO = State.LocalELOSpoofEnabled and State.LocalELO or (LP:GetAttribute('ELO') or 0)
    local Wins=math.max(0,math.floor(tonumber(State.LocalWins) or 0));
    local Losses=math.max(0,math.floor(tonumber(State.LocalLosses) or 0))
    local Streak=math.max(0,math.floor(tonumber(State.LocalStreak) or 0));
    local Highest=math.max(Streak,math.floor(tonumber(State.LocalHighestStreak) or 0))
    local Shields=math.max(0,math.floor(tonumber(State.LocalShields) or 0))
    local function BuildInfo(Name,HomeSide,Index)
        local Player=Players:FindFirstChild(Name)
        local IsLocal=Player==LP or Name==LP.Name or Name==LP.DisplayName or Name==DefaultLocalName
        local UserId=IsLocal and LP.UserId or (Player and Player.UserId or 100000+Index)
        local SideWon=(Result=='Win' and HomeSide) or (Result=='Lose' and not HomeSide)
        local PlayerResult=(Result=='Protected' or Result=='Draw') and 'Protected' or (SideWon and 'Win' or 'Lose')
        local NewELO=IsLocal and ELO or 0;
        local Delta=PlayerResult=='Win' and 25 or (PlayerResult=='Lose' and -15 or 0)
        return {
            Name=Name,UserId=UserId,ELO=NewELO,OLD=math.max(0,NewELO-Delta),NEW=NewELO,
            Points=HomeSide and HomeScore or AwayScore,Assists=0,Steals=0,Turnovers=0,Result=PlayerResult,
            OLDWINS=math.max(0,Wins-(PlayerResult=='Win' and 1 or 0)),NEWWINS=Wins,
            OLDLOSSES=math.max(0,Losses-(PlayerResult=='Lose' and 1 or 0)),NEWLOSSES=Losses,
            OLDSTREAK=math.max(0,Streak-1),NEWSTREAK=Streak,
            OLDHIGHESTSTREAK=math.max(0,Highest-1),NEWHIGHESTSTREAK=Highest,OLDSHIELDS=Shields,NEWSHIELDS=Shields,
        }
    end
    local Home={};
    local Away={}
    for Index,Name in ipairs(HomeNames) do Home[Name]=BuildInfo(Name,true,Index) end
    for Index,Name in ipairs(AwayNames) do Away[Name]=BuildInfo(Name,false,100+Index) end
    local TeamSize=RequestedSize
    table.insert(Data.MatchHistory,1,{
        __GoldenEagleFake=true,__DisplayResult=Result,Result=RenderResult,
        HomeScore=HomeScore,AwayScore=AwayScore,Date=os.time(),PlayerCount=#HomeNames+#AwayNames,
        Mode=tostring(TeamSize)..'v'..tostring(TeamSize),Competitive=false,
        Home=Home,Away=Away,HomeIcon='',AwayIcon='',
    })
    State.LocalSpoofs.RefreshFakeMatchHistory()
end

function State.LocalSpoofs.ClearFakeMatches()
    local PlayerData = State.LocalSpoofs.PlayerData
    local History = PlayerData and PlayerData.storedData and PlayerData.storedData.MatchHistory
    if type(History) ~= 'table' then return end
    for Index=#History,1,-1 do if type(History[Index])=='table' and History[Index].__GoldenEagleFake then table.remove(History,Index) end end
    State.LocalSpoofs.HasFakeDraws=false
    State.LocalSpoofs.RefreshFakeMatchHistory()
end

State.LocalSpoofs.Extended = {
    Originals = setmetatable({}, { __mode = 'k' }), LoadoutOriginals = {},
    PreviewTracks = {}, Personas = {}, LastApplyAt = 0,
}

function State.LocalSpoofs.SetExtendedUI(Object, Property, Value)
    if not (Object and Object.Parent) then return end
    local Store = State.LocalSpoofs.Extended.Originals
    Store[Object] = Store[Object] or {}
    if Store[Object][Property] == nil then
        local Ok, Current = pcall(function() return Object[Property] end)
        if not Ok then return end
        Store[Object][Property] = { Value = Current }
    end
    pcall(function() Object[Property] = Value end)
end

function State.LocalSpoofs.RestoreExtendedUI()
    for Object, Properties in pairs(State.LocalSpoofs.Extended.Originals) do
        if Object and Object.Parent then
            for Property, Snapshot in pairs(Properties) do pcall(function() Object[Property] = Snapshot.Value end) end
        end
    end
    table.clear(State.LocalSpoofs.Extended.Originals)
end

function State.LocalSpoofs.CompactNumber(Value)
    local Text = tostring(math.max(0, math.floor(tonumber(Value) or 0)))
    while true do local Next, Count = Text:gsub('^(%-?%d+)(%d%d%d)', '%1,%2');
        Text = Next;
        if Count == 0 then break end end
    return Text
end

function State.LocalSpoofs.IsText(Object)
    return Object and (Object:IsA('TextLabel') or Object:IsA('TextButton') or Object:IsA('TextBox'))
end
function State.LocalSpoofs.IsImage(Object)
    return Object and (Object:IsA('ImageLabel') or Object:IsA('ImageButton'))
end
function State.LocalSpoofs.HasAncestorName(Object, Names, Depth)
    local Current = Object
    for _ = 1, Depth or 12 do
        if not Current then return false end
        local Lower = string.lower(Current.Name)
        for _, Name in ipairs(Names) do if string.find(Lower, Name, 1, true) then return true end end
        Current = Current.Parent
    end
    return false
end
function State.LocalSpoofs.AssetImage(Value)
    local Text = tostring(Value or ''):match('^%s*(.-)%s*$') or ''
    local Id = tonumber(Text)
    if Id and Id > 0 then return 'rbxthumb://type=AvatarHeadShot&id=' .. math.floor(Id) .. '&w=420&h=420' end
    if string.find(Text, 'rbxasset', 1, true) or string.find(Text, 'http', 1, true) then return Text end
    return 'rbxthumb://type=AvatarHeadShot&id=' .. LP.UserId .. '&w=420&h=420'
end

function State.LocalSpoofs.FindLocalProfileRoots()
    local Roots, Seen = {}, {}
    local PlayerGui = LP:FindFirstChildOfClass('PlayerGui')
    if not PlayerGui then return Roots end
    for _, Object in ipairs(PlayerGui:GetDescendants()) do
        if Object:IsA('GuiObject') and (Object.Name == 'ProfileFrame' or Object.Name == LP.Name) then
            local IsLocal = Object.Name == LP.Name
            if not IsLocal then
                local Label = Object:FindFirstChild('UserName', true) or Object:FindFirstChild('Username', true)
                local Reset = Object:FindFirstChild('ResetButton', true)
                local Text = Label and State.LocalSpoofs.IsText(Label) and tostring(Label.Text or '') or ''
                IsLocal = (Reset and Reset.Visible) or Text == LP.Name or Text == ('@' .. LP.Name) or Text == LP.DisplayName or Text == tostring(State.LocalAlias)
            end
            if IsLocal and not Seen[Object] then Seen[Object] = true;
                table.insert(Roots, Object) end
        end
    end
    local Character = LP.Character
    local RootPart = Character and Character:FindFirstChild('HumanoidRootPart')
    local NameTag = RootPart and RootPart:FindFirstChild('NameTag')
    if NameTag and not Seen[NameTag] then table.insert(Roots, NameTag) end
    return Roots
end

function State.LocalSpoofs.ApplyIdentityCardSpoof()
    if not State.LocalIdentityCardSpoofEnabled then return end
    local Set = State.LocalSpoofs.SetExtendedUI
    local Alias = tostring(State.LocalAnonymizerEnabled and State.LocalAlias or LP.DisplayName)
    local UserAlias = tostring(State.LocalAnonymizerEnabled and State.LocalAlias or LP.Name)
    local Title, Badge, Banner = tostring(CONFIG.LocalIdentityTitle or ''), tostring(CONFIG.LocalIdentityBadge or ''), tostring(CONFIG.LocalIdentityBanner or '')
    local Headshot = State.LocalSpoofs.AssetImage(CONFIG.LocalHeadshotUserId)
    local Accent = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LocalIdentityColor, Color3.fromRGB(255, 215, 90))
    for _, Root in ipairs(State.LocalSpoofs.FindLocalProfileRoots()) do
        for _, Object in ipairs(Root:GetDescendants()) do
            local Name = string.lower(Object.Name)
            if State.LocalSpoofs.IsText(Object) then
                local Current = tostring(Object.Text or '')
                if Current == LP.Name or Current == LP.DisplayName or Current == ('@' .. LP.Name) or Name == 'username' or Name == 'displayname' or Name == 'namelabel' then
                    local Prefix = string.sub(Current, 1, 1) == '@' and '@' or ''
                    Set(Object, 'Text', Prefix .. (Name == 'username' and UserAlias or Alias))
                elseif (Name == 'title' or Name == 'titlelabel' or Name == 'playertitle') and Title ~= '' then Set(Object, 'Text', Title);
                    Set(Object, 'TextColor3', Accent)
                elseif (Name == 'badgelabel' or Name == 'badge' or Name == 'rolelabel') and Badge ~= '' then Set(Object, 'Text', Badge);
                    Set(Object, 'TextColor3', Accent)
                elseif (Name == 'bannerlabel' or Name == 'profilebanner' or Name == 'subtitle') and Banner ~= '' then Set(Object, 'Text', Banner);
                    Set(Object, 'TextColor3', Accent)
                end
            elseif State.LocalSpoofs.IsImage(Object) and (string.find(Name, 'avatar', 1, true) or string.find(Name, 'headshot', 1, true) or Name == 'playericon' or Name == 'profileimage') then
                Set(Object, 'Image', Headshot)
            end
        end
    end
end

function State.LocalSpoofs.ApplyLiveMatchSpoof()
    if not State.LocalLiveMatchSpoofEnabled then return end
    local Set, PlayerGui = State.LocalSpoofs.SetExtendedUI, LP:FindFirstChildOfClass('PlayerGui')
    if not PlayerGui then return end
    local Home, Away = math.max(0, math.floor(tonumber(CONFIG.LocalMatchHomeScore) or 0)), math.max(0, math.floor(tonumber(CONFIG.LocalMatchAwayScore) or 0))
    local PTS, AST = math.max(0, math.floor(tonumber(CONFIG.LocalMatchPoints) or 0)), math.max(0, math.floor(tonumber(CONFIG.LocalMatchAssists) or 0))
    local STL, BLK = math.max(0, math.floor(tonumber(CONFIG.LocalMatchSteals) or 0)), math.max(0, math.floor(tonumber(CONFIG.LocalMatchBlocks) or 0))
    local TO = math.max(0, math.floor(tonumber(CONFIG.LocalMatchTurnovers) or 0))
    local Made = math.max(0, math.floor(tonumber(CONFIG.LocalMatchShotsMade) or 0))
    local Attempts = math.max(Made, math.floor(tonumber(CONFIG.LocalMatchShotsAttempted) or 0))
    local Result = tostring(CONFIG.LocalMatchResult or 'Win')
    local ResultText = Result == 'Win' and 'VICTORY' or (Result == 'Loss' and 'DEFEAT' or string.upper(Result))
    local Delta, Cashout = math.floor(tonumber(CONFIG.LocalMatchELODelta) or 0), math.max(0, math.floor(tonumber(CONFIG.LocalMatchCashout) or 0))
    for _, Object in ipairs(PlayerGui:GetDescendants()) do
        if State.LocalSpoofs.IsText(Object) and State.LocalSpoofs.HasAncestorName(Object, { 'results', 'scoreboard', 'matchui', 'highlight', 'performance' }, 14) then
            local Name, ParentName = string.lower(Object.Name), Object.Parent and string.lower(Object.Parent.Name) or ''
            if Name == 'scoreblue' or Name == 'bluescore' or Name == 'teamascore' or Name == 'homescore' then Set(Object, 'Text', tostring(Home))
            elseif Name == 'scorered' or Name == 'redscore' or Name == 'teambscore' or Name == 'awayscore' then Set(Object, 'Text', tostring(Away))
            elseif Name == 'pts' or (Name == 'score' and ParentName == 'points') then Set(Object, 'Text', tostring(PTS))
            elseif Name == 'ast' or (Name == 'score' and ParentName == 'assists') then Set(Object, 'Text', tostring(AST))
            elseif Name == 'stl' or (Name == 'score' and ParentName == 'steals') then Set(Object, 'Text', tostring(STL))
            elseif Name == 'blk' or (Name == 'score' and ParentName == 'blocks') then Set(Object, 'Text', tostring(BLK))
            elseif Name == 't/o' or Name == 'turnovers' or (Name == 'score' and ParentName == 'turnovers') then Set(Object, 'Text', tostring(TO))
            elseif Name == 'shots' or Name == 'shooting' then Set(Object, 'Text', tostring(Made) .. '/' .. tostring(Attempts))
            elseif Name == 'resultlabel' or Name == 'descriptionscore' then Set(Object, 'Text', ResultText)
            elseif Name == 'descriptionelo' then
                local Verb, Color = Delta >= 0 and 'won' or 'lost', Delta >= 0 and '0,255,0' or '255,0,0'
                Set(Object, 'Text', 'You ' .. Verb .. ": <font color='rgb(" .. Color .. ")'>" .. math.abs(Delta) .. ' REP</font>')
            elseif Name == 'amountlabel' and ParentName == 'cashout' then Set(Object, 'Text', '+ $' .. State.LocalSpoofs.CompactNumber(Cashout))
            end
        end
    end
    local Results = PlayerGui:FindFirstChild('ResultsV2') or PlayerGui:FindFirstChild('Results') or PlayerGui:FindFirstChild('ResultsUI')
    local Scoreboard = Results and Results:FindFirstChild('Scoreboard', true)
    if Scoreboard then
        for _, ListName in ipairs({ 'BlueList', 'RedList' }) do
            local List = Scoreboard:FindFirstChild(ListName)
            if List then for _, Row in ipairs(List:GetChildren()) do
                    local NameLabel = Row:FindFirstChild('Name', true) or Row:FindFirstChild('NameTag', true)
                    local Text = NameLabel and State.LocalSpoofs.IsText(NameLabel) and tostring(NameLabel.Text or '') or ''
                    if Text == LP.Name or Text == LP.DisplayName or Text == tostring(State.LocalAlias) then
                        for Field, Value in pairs({ AST=AST, STL=STL, PTS=PTS, ['T/O']=TO, BLK=BLK }) do local Label=Row:FindFirstChild(Field,true);
                            if Label and State.LocalSpoofs.IsText(Label) then Set(Label,'Text',tostring(Value)) end end
                    end
                end end
        end
    end
    local Highlight = Results and Results:FindFirstChild('Highlight', true)
    local MVP = Highlight and CONFIG.LocalMatchMVP and Highlight:FindFirstChild('MVP', true)
    if MVP then
        local NameLabel, Avatar, Number = MVP:FindFirstChild('NameTag', true), MVP:FindFirstChild('Avatar', true), MVP:FindFirstChild('Number', true)
        if NameLabel and State.LocalSpoofs.IsText(NameLabel) then Set(NameLabel,'Text',tostring(State.LocalAnonymizerEnabled and State.LocalAlias or LP.Name)) end
        if Avatar and State.LocalSpoofs.IsImage(Avatar) then Set(Avatar,'Image',State.LocalSpoofs.AssetImage(CONFIG.LocalHeadshotUserId)) end
        if Number and State.LocalSpoofs.IsText(Number) then Set(Number,'Text',tostring(PTS)) end
    end
end

function State.LocalSpoofs.ApplyWalletSpoof()
    if not State.LocalWalletSpoofEnabled then return end
    local Set, PlayerGui = State.LocalSpoofs.SetExtendedUI, LP:FindFirstChildOfClass('PlayerGui')
    if not PlayerGui then return end
    local Values = { money=CONFIG.LocalMoney, cash=CONFIG.LocalMoney, spin=CONFIG.LocalSpins, spins=CONFIG.LocalSpins, crate=CONFIG.LocalCrates, crates=CONFIG.LocalCrates, boost=CONFIG.LocalBoosts, boosts=CONFIG.LocalBoosts, clancoins=CONFIG.LocalClanCoins, eventcurrency=CONFIG.LocalEventCurrency, battlepass=CONFIG.LocalBattlepassLevel, battlepasslevel=CONFIG.LocalBattlepassLevel }
    for _, Object in ipairs(PlayerGui:GetDescendants()) do
        if State.LocalSpoofs.IsText(Object) then
            local Name = string.lower(Object.Name):gsub('[^%w]','')
            local Parent = Object.Parent and string.lower(Object.Parent.Name):gsub('[^%w]','') or ''
            local Key = Values[Name] ~= nil and Name or (Values[Parent] ~= nil and Parent or nil)
            if Key and not State.LocalSpoofs.HasAncestorName(Object, {'tradeframe','donatepopup'},10) then Set(Object,'Text',State.LocalSpoofs.CompactNumber(Values[Key]))
            elseif (Name=='timerlabel' or Name=='time') and State.LocalSpoofs.HasAncestorName(Object,{'dailyspin','wheel'},10) then Set(Object,'Text',tostring(CONFIG.LocalDailyRewardState)) end
        end
    end
    local TopList, Money = PlayerGui:FindFirstChild('TopList'), nil
    if TopList then Money=TopList:FindFirstChild('Money',true) end
    local Amount=Money and (Money:FindFirstChild('TextLabel') or Money:FindFirstChild('AmountLabel'))
    if Amount and State.LocalSpoofs.IsText(Amount) then Set(Amount,'Text',State.LocalSpoofs.CompactNumber(CONFIG.LocalMoney)) end
    local Wheel=Workspace:FindFirstChild('WOF')
    if Wheel then for _,Object in ipairs(Wheel:GetDescendants()) do if Object.Name=='TimerLabel' and State.LocalSpoofs.IsText(Object) then Set(Object,'Text',tostring(CONFIG.LocalDailyRewardState)) end end end
end

function State.LocalSpoofs.ApplyClanPresentation()
    if not State.LocalClanSpoofEnabled then return end
    local Frames=State.LocalSpoofs.FindMenuFrames();
    local Clans=Frames and Frames:FindFirstChild('Clans');
    local PagesRoot=Clans and Clans:FindFirstChild('PageFrames');
    local Clan=PagesRoot and PagesRoot:FindFirstChild('Clan');
    local Main=Clan and Clan:FindFirstChild('Main')
    if not Main then return end
    local Set=State.LocalSpoofs.SetExtendedUI
    local Description,Emblem,Members=Main:FindFirstChild('ClanDescription'),Main:FindFirstChild('ClanEmblem'),Main:FindFirstChild('MemberCount',true)
    if Description and State.LocalSpoofs.IsText(Description) then Set(Description,'Text',tostring(CONFIG.LocalClanDescription or '')) end
    if Emblem and State.LocalSpoofs.IsImage(Emblem) and tostring(CONFIG.LocalClanEmblem or '')~='' then local Image=tostring(CONFIG.LocalClanEmblem);
        if tonumber(Image) then Image='rbxassetid://'..math.floor(tonumber(Image)) end;
        Set(Emblem,'Image',Image) end
    if Members and State.LocalSpoofs.IsText(Members) then Set(Members,'Text',tostring(math.max(0,math.floor(tonumber(CONFIG.LocalClanMembers) or 0)))..'/'..tostring(math.max(1,math.floor(tonumber(CONFIG.LocalClanMemberCap) or 1)))) end
    for _,Object in ipairs(Main:GetDescendants()) do if State.LocalSpoofs.IsText(Object) then local Name=string.lower(Object.Name)
            if Name=='permissionlabel' or Name=='rolelabel' then Set(Object,'Text',tostring(CONFIG.LocalClanRole or 'Member'))
            elseif Name=='datelabel' or Name=='createdlabel' then Set(Object,'Text','Created: '..tostring(CONFIG.LocalClanCreated or ''))
            elseif Name=='ownerlabel' or Name=='clanowner' then Set(Object,'Text',tostring(CONFIG.LocalClanOwner~='' and CONFIG.LocalClanOwner or LP.Name))
            elseif Name=='announcement' or Name=='announcementlabel' then Set(Object,'Text',tostring(CONFIG.LocalClanAnnouncement or ''))
            elseif Name=='placement' or Name=='rankplacement' then Set(Object,'Text','#'..tostring(math.max(1,math.floor(tonumber(CONFIG.LocalClanPlacement) or 1)))) end
        end end
end

function State.LocalSpoofs.GetLoadoutOptions(Category, DefaultName)
    local Result={'None'};
    local ShopItems=ReplicatedStorage:FindFirstChild('ShopItems');
    local Folder=ShopItems and ShopItems:FindFirstChild(Category)
    if Folder then for _,Item in ipairs(Folder:GetChildren()) do table.insert(Result,Item.Name) end end
    table.sort(Result,function(A,B) if A=='None' then return true elseif B=='None' then return false end return string.lower(A)<string.lower(B) end)
    if #Result==1 and DefaultName then table.insert(Result,DefaultName) end
    return Result
end
function State.LocalSpoofs.ResolveLoadoutAnimation(Category,Name)
    if not Name or Name=='None' then return nil end
    local ShopItems=ReplicatedStorage:FindFirstChild('ShopItems');
    local Folder=ShopItems and ShopItems:FindFirstChild(Category);
    local Item=Folder and Folder:FindFirstChild(Name)
    if not Item then return nil end
    if Item:IsA('Animation') then return Item end
    return Item:FindFirstChildWhichIsA('Animation',true)
end
function State.LocalSpoofs.PreviewLoadout(Category,Name)
    local Animation=State.LocalSpoofs.ResolveLoadoutAnimation(Category,Name)
    if not Animation then Notify('GOLDEN EAGLE','No preview animation found for '..tostring(Name)..'.') return false end
    local Character=LP.Character;
    local HumanoidObject=Character and Character:FindFirstChildOfClass('Humanoid');
    local Animator=HumanoidObject and HumanoidObject:FindFirstChildOfClass('Animator')
    if not Animator then return false end
    for _,Track in ipairs(State.LocalSpoofs.Extended.PreviewTracks) do pcall(function() Track:Stop(0.1);
            Track:Destroy() end) end
    table.clear(State.LocalSpoofs.Extended.PreviewTracks)
    local Ok,Track=pcall(function() return Animator:LoadAnimation(Animation) end);
    if not Ok or not Track then return false end
    table.insert(State.LocalSpoofs.Extended.PreviewTracks,Track);
    Track:Play(0.12);
    return true
end
function State.LocalSpoofs.ApplyAnimationLoadout()
    local PlayerData=State.ClientSettings.PlayerData;
    local Data=PlayerData and PlayerData.storedData
    if not (PlayerData and type(Data)=='table') then return false end
    Data.Equipping=type(Data.Equipping)=='table' and Data.Equipping or {}
    local Original=State.LocalSpoofs.Extended.LoadoutOriginals
    local function SetKey(Key,Value) if not Value or Value=='' or Value=='None' then return end;
        if Original[Key]==nil then Original[Key]={Had=Data.Equipping[Key]~=nil,Value=Data.Equipping[Key]} end;
        PlayerData.updateData('Equipping',Key,Value) end
    local DunkOptions,RimOptions=State.LocalSpoofs.GetLoadoutOptions('Dunk','Dunk_Default'),State.LocalSpoofs.GetLoadoutOptions('RimHang','RimHang_Default')
    for Index=1,5 do local Dunk,Rim=CONFIG.LocalDunkAnimation,CONFIG.LocalRimHangAnimation
        if CONFIG.LocalAnimationRandomize then Dunk=DunkOptions[math.random(2,math.max(2,#DunkOptions))] or Dunk;
            Rim=RimOptions[math.random(2,math.max(2,#RimOptions))] or Rim end
        SetKey('Dunk'..Index,Dunk);
        SetKey('RimHang'..Index,Rim) end
    for Key,Value in pairs({Intro=CONFIG.LocalIntroAnimation,Celebration=CONFIG.LocalCelebrationAnimation,Emote=CONFIG.LocalEmoteAnimation,Idle=CONFIG.LocalIdleAnimation,Shot=CONFIG.LocalShotAnimation}) do SetKey(Key,Value) end
    return true
end
function State.LocalSpoofs.RestoreAnimationLoadout()
    local PlayerData=State.ClientSettings.PlayerData;
    local Data=PlayerData and PlayerData.storedData
    if PlayerData and type(Data)=='table' then for Key,Value in pairs(State.LocalSpoofs.Extended.LoadoutOriginals) do PlayerData.updateData('Equipping',Key,Value.Had and Value.Value or nil) end end
    table.clear(State.LocalSpoofs.Extended.LoadoutOriginals)
    for _,Track in ipairs(State.LocalSpoofs.Extended.PreviewTracks) do pcall(function() Track:Stop(0.1);
            Track:Destroy() end) end
    table.clear(State.LocalSpoofs.Extended.PreviewTracks)
end

function State.LocalSpoofs.ApplyExtendedSpoofs()
    if State.LocalIdentityCardSpoofEnabled then pcall(State.LocalSpoofs.ApplyIdentityCardSpoof) end
    if State.LocalLiveMatchSpoofEnabled then pcall(State.LocalSpoofs.ApplyLiveMatchSpoof) end
    if State.LocalWalletSpoofEnabled then pcall(State.LocalSpoofs.ApplyWalletSpoof) end
    if State.LocalClanSpoofEnabled then pcall(State.LocalSpoofs.ApplyClanPresentation) end
end
function State.LocalSpoofs.RefreshExtendedBinding()
    local Any=State.LocalIdentityCardSpoofEnabled or State.LocalLiveMatchSpoofEnabled or State.LocalWalletSpoofEnabled or State.LocalClanSpoofEnabled
    pcall(function() State.Lifecycle:UnbindFromRenderStep('GoldenEagleExtendedSpoofs') end);
    State.LocalSpoofs.RestoreExtendedUI()
    if Any then State.LocalSpoofs.ApplyExtendedSpoofs();
        State.Lifecycle:BindToRenderStep('GoldenEagleExtendedSpoofs',Enum.RenderPriority.Last.Value+13,WYNF_JIT(function()
            if not State.Active then return end;
            local Now=os.clock();
            if Now-(State.LocalSpoofs.Extended.LastApplyAt or 0)>=0.25 then State.LocalSpoofs.Extended.LastApplyAt=Now;
                State.LocalSpoofs.ApplyExtendedSpoofs() end
        end)) end
end
function State.LocalSpoofs.SetExtendedFlag(Name,Enabled)
    Enabled=Enabled==true
    if Name=='Identity' then State.LocalIdentityCardSpoofEnabled=Enabled;
        CONFIG.LocalIdentityCardSpoof=Enabled
    elseif Name=='Match' then State.LocalLiveMatchSpoofEnabled=Enabled;
        CONFIG.LocalLiveMatchSpoof=Enabled
    elseif Name=='Wallet' then State.LocalWalletSpoofEnabled=Enabled;
        CONFIG.LocalWalletSpoof=Enabled
    elseif Name=='Animation' then State.LocalAnimationSpoofEnabled=Enabled;
        CONFIG.LocalAnimationSpoof=Enabled;
        if Enabled then State.LocalSpoofs.ApplyAnimationLoadout() else State.LocalSpoofs.RestoreAnimationLoadout() end end
    State.LocalSpoofs.RefreshExtendedBinding()
end
function State.LocalSpoofs.StopExtendedSpoofs()
    State.LocalIdentityCardSpoofEnabled=false;
    State.LocalLiveMatchSpoofEnabled=false;
    State.LocalWalletSpoofEnabled=false;
    State.LocalAnimationSpoofEnabled=false
