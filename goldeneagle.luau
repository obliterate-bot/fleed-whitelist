local FindPlayerCourtSlot
FindPlayerCourtSlot = WYNF_JIT_MAX(function(TargetPlayer)
    if not TargetPlayer then
        return nil, nil, nil
    end

    local Now = os.clock()
    local Cached = PerfCache.PlayerCourtSlot[TargetPlayer]
    if Cached and Now - Cached.At < 0.25 then
        local Court = Cached.Court ~= false and Cached.Court or nil
        local Slot = Cached.Slot ~= false and Cached.Slot or nil
        if (not Court or Court.Parent) and (not Slot or Slot.Parent) then
            return Court, Cached.SlotName ~= false and Cached.SlotName or nil, Slot
        end
    end

    for _, Court in ipairs(GetAllCourts()) do
        local CourtPlayers = safe_find(Court, '_CourtPlayers') or safe_find(Court, 'CourtPlayers')
        if CourtPlayers then
            for _, Slot in ipairs(CourtPlayers:GetChildren()) do
                if safe_is_a(Slot, 'ObjectValue') and Slot.Value == TargetPlayer then
                    PerfCache.PlayerCourtSlot[TargetPlayer] = {
                        At = Now,
                        Court = Court,
                        SlotName = Slot.Name,
                        Slot = Slot,
                    }
                    return Court, Slot.Name, Slot
                end
            end
        end
    end

    PerfCache.PlayerCourtSlot[TargetPlayer] = {
        At = Now,
        Court = false,
        SlotName = false,
        Slot = false,
    }
    return nil, nil, nil
end)

local function ResolveSlotTeamName(SlotName)
    if type(SlotName) ~= 'string' or SlotName == '' then
        return nil
    end

    local Prefix = string.lower(string.match(SlotName, '^[A-Za-z]+') or SlotName)
    if Prefix == 'home' or string.find(Prefix, 'home', 1, true) == 1 then
        return 'Home'
    end

    if Prefix == 'away' or string.find(Prefix, 'away', 1, true) == 1 then
        return 'Away'
    end

    return nil
end

local ResolvePlayerCourt
ResolvePlayerCourt = WYNF_JIT_MAX(function(TargetPlayer, RuntimeSnapshot)
    if RuntimeSnapshot and TargetPlayer then
        local Entry = RuntimeSnapshot.playerSlotsByPlayer[TargetPlayer]
        if Entry then
            return Entry.court, Entry.slotName, Entry.slot
        end
    end

    local Court, SlotName, Slot = FindPlayerCourtSlot(TargetPlayer)
    if Court ~= nil then
        return Court, SlotName, Slot
    end

    local CurrentGame = GetHeldBasketballCurrentGame(TargetPlayer)
    if CurrentGame and safe_is_a(CurrentGame, 'Model') then
        return CurrentGame, nil, nil
    end

    return nil, nil, nil
end)

