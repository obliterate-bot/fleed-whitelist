SilentAim.RestoreAllHooks = function()
    SilentAim.ClearActorAim()
    if SilentAim.ActorSt then pcall(function() SilentAim.ActorSt.T = nil end) end
    if SilentAim.ActorHookCount and SilentAim.ActorHookCount > 0
        and type(getactors) == 'function' and type(run_on_actor) == 'function' then
        local Ok, Actors = pcall(getactors)
        if Ok and type(Actors) == 'table' then
            for _, Actor in ipairs(Actors) do pcall(run_on_actor, Actor, SilentAim.ActorCleanupCode) end
        end
    end
    if SilentAim.CameraDataSpoofed and type(isfunctionhooked) == 'function'
        and type(restorefunction) == 'function' then
        pcall(function()
            local CameraData = game:GetService('SharedTableRegistry'):GetSharedTable('CameraData')
            local SharedMeta = getrawmetatable(CameraData)
            if isfunctionhooked(SharedMeta.__newindex) then restorefunction(SharedMeta.__newindex) end
        end)
    end
    SilentAim.TargetPosition = nil
    SilentAim.ActorSt = nil
    SilentAim.ActorStName = nil
    SilentAim.ActorAimCodeBuilt = nil
    SilentAim.HookedActors = nil
    SilentAim.ActorHookCount = 0
    SilentAim.PendingAckDeadline = 0
    SilentAim.CameraDataSpoofed = false
    SilentAim.CameraDataSpoofBroken = false
    SilentAim.ActorAimReady = false
end

SilentAim.FireActorAim = function(Position)
    SilentAim.TargetPosition = Position
    local St = SilentAim.ActorSt
    if St then
        pcall(function() St.T = Position end)
    end
end

SilentAim.ClearActorAim = function()
    SilentAim.TargetPosition = nil
    local St = SilentAim.ActorSt
    if St then
        pcall(function() St.T = nil end)
    end
end

SilentAim.HookNewActors = function()
    if not (SilentAim.HookedActors and SilentAim.ActorAimCodeBuilt ~= nil) then
        return 0
    end
    local ok, Actors = pcall(getactors)
    if not ok or type(Actors) ~= 'table' then
        return 0
    end
    local Dispatched = 0
    for _, Actor in ipairs(Actors) do
        if not SilentAim.HookedActors[Actor] then
            local ranOk = pcall(run_on_actor, Actor, SilentAim.ActorAimCodeBuilt)
            if ranOk then
                SilentAim.HookedActors[Actor] = true
                SilentAim.ActorHookCount = SilentAim.ActorHookCount + 1
                Dispatched = Dispatched + 1
            end
        end
    end
    if Dispatched > 0 then
        SilentAim.PendingAckDeadline = os.clock() + 1
    end
    return Dispatched
end

SilentAim.EnsureActorAim = function()
    if SilentAim.CameraDataSpoofBroken then
        return false
    end
    if not SilentAim.CameraDataSpoofed then
        local SpoofOk = pcall(function()
            local CameraDataTable = game:GetService('SharedTableRegistry'):GetSharedTable('CameraData')
            local CameraHistoryTable = CameraDataTable.CameraHistory
            local SharedTableMeta = getrawmetatable(CameraDataTable)
            if isfunctionhooked(SharedTableMeta.__newindex) then
                restorefunction(SharedTableMeta.__newindex)
            end
            local OldNewIndex;
            OldNewIndex = hookfunction(SharedTableMeta.__newindex, newcclosure(function(Table, Key, Value)
                local IsCurrentCamera = Table == CameraDataTable and Key == 'CameraCFrame'
                local IsCameraHistory = CameraHistoryTable ~= nil and Table == CameraHistoryTable
                    and type(Key) == 'number'
                if SilentAim.TargetPosition and (IsCurrentCamera or IsCameraHistory)
                    and typeof(Value) == 'CFrame' and workspace.CurrentCamera
                    and (Value.Position - workspace.CurrentCamera.CFrame.Position).Magnitude < 10 then
                    local Character = LP.Character
                    local Head = Character and Character:FindFirstChild('Head')
                    if Head then
                        return OldNewIndex(Table, Key, CFrame.new(Head.Position, SilentAim.TargetPosition))
                    end
                end
                return OldNewIndex(Table, Key, Value)
            end))
        end)
        if not SpoofOk then
            Notify('GOLDEN EAGLE', 'CameraData spoof hook failed on this executor - Silent Aim inactive.')
            return false
        end

        local SavedTarget = SilentAim.TargetPosition
        SilentAim.TargetPosition = nil
        local VerifyOk = false
        for _ = 1, 3 do
            VerifyOk = pcall(function()
                local CameraDataTable = game:GetService('SharedTableRegistry'):GetSharedTable('CameraData')
                local Probe = CameraDataTable.CameraCFrame
                if typeof(Probe) ~= 'CFrame' then Probe = workspace.CurrentCamera.CFrame end
                local Marked = Probe + Vector3.new(0, 0.001, 0)
                CameraDataTable.CameraCFrame = Marked
                local ReadBack = CameraDataTable.CameraCFrame
                CameraDataTable.CameraCFrame = Probe
                assert(typeof(ReadBack) == 'CFrame'
                    and (ReadBack.Position - Marked.Position).Magnitude < 0.0005,
                    'passthrough readback mismatch')
            end)
            if VerifyOk then break end
        end
        SilentAim.TargetPosition = SavedTarget
        if not VerifyOk then
            SilentAim.CameraDataSpoofBroken = true
            local Restored = false
            pcall(function()
                local SharedTableMeta = getrawmetatable(
                    game:GetService('SharedTableRegistry'):GetSharedTable('CameraData')
                )
                if isfunctionhooked(SharedTableMeta.__newindex) then
                    restorefunction(SharedTableMeta.__newindex)
                    Restored = true
                end
            end)
            Notify('GOLDEN EAGLE', Restored
                and 'This executor\'s hookfunction failed live verification - Silent Aim disabled; hook removed.'
                or 'This executor\'s hookfunction failed and could not be removed - rejoin before shooting.')
            return false
        end
        SilentAim.CameraDataSpoofed = true
    end

    if not SilentAim.ActorSt then
        local StName, St
        local ok = pcall(function()
            StName = ('HZ%d%d'):format(math.floor(os.clock() * 1000) % 1000000, math.random(100000, 999999))
            St = game:GetService('SharedTableRegistry'):GetSharedTable(StName)
            St.Acks = 0
            St.VerifyFails = 0
        end)
        if not ok or St == nil then
            Notify('GOLDEN EAGLE', 'SharedTable transport failed on this executor - Silent Aim inactive.')
            return false
        end
        SilentAim.ActorStName = StName
        SilentAim.ActorSt = St
        SilentAim.ActorAimCodeBuilt = ('local __HZ_SilentAimSt = %q '):format(StName) .. SilentAim.ActorAimCode
        SilentAim.HookedActors = setmetatable({}, { __mode = 'k' })
        SilentAim.ActorHookCount = 0
        SilentAim.PendingAckDeadline = 0
    end

    SilentAim.EnsureGeneration = (SilentAim.EnsureGeneration or 0) + 1
    local MyGeneration = SilentAim.EnsureGeneration

    SilentAim.HookNewActors()

    if SilentAim.ActorHookCount == 0 then
        if GlobalEnv.__GEH_COMPAT and GlobalEnv.__GEH_COMPAT.NoActors then

            SilentAim.ActorAimReady = true
            return true
        end
        SilentAim.ActorAimReady = false
        Notify('GOLDEN EAGLE', 'No actors found to hook - Silent Aim inactive.')
        return false
    end

    while os.clock() < (SilentAim.PendingAckDeadline or 0)
        and (SilentAim.ActorSt.Acks or 0) < SilentAim.ActorHookCount do
        task.wait(0.05)
    end

    if SilentAim.EnsureGeneration ~= MyGeneration then
        return SilentAim.ActorAimReady == true
    end

    SilentAim.ActorAimReady = (SilentAim.ActorSt.Acks or 0) > 0
    if not SilentAim.ActorAimReady then
        Notify('GOLDEN EAGLE', (SilentAim.ActorSt.VerifyFails or 0) > 0
            and 'Actor hooks failed live verification - Silent Aim inactive; hooks removed.'
            or 'Actor hooks did not respond - Silent Aim inactive on this executor.')
    end
    return SilentAim.ActorAimReady
end

