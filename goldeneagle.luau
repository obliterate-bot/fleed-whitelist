    HubUI.SanitizeCustomGoalPresetName = function(Value)
        Value = tostring(Value or ''):gsub('[^%w _%-]', '')
        Value = Value:match('^%s*(.-)%s*$') or ''
        Value = Value:gsub('%s+', ' ')
        if #Value > 32 then Value = Value:sub(1, 32) end
        return Value
    end
    HubUI.LoadCustomGoalPresets = function()
        if type(isfile) ~= 'function' or type(readfile) ~= 'function' then return end
        local ExistsOk, Exists = pcall(isfile, HubUI.CustomGoalPresetFile)
        if not (ExistsOk and Exists) then return end
        local ReadOk, Raw = pcall(readfile, HubUI.CustomGoalPresetFile)
        if not ReadOk then return end
        local DecodeOk, Data = pcall(State.Utility.HttpService.JSONDecode, State.Utility.HttpService, Raw)
        if not (DecodeOk and type(Data) == 'table') then return end
        for Name, Preset in pairs(Data) do
            Name = HubUI.SanitizeCustomGoalPresetName(Name)
            if Name ~= '' then
                if type(Preset) == 'string' then
                    HubUI.CustomGoalPresets[Name] = { Source = Preset }
                elseif type(Preset) == 'table' and type(Preset.Source) == 'string' then
                    HubUI.CustomGoalPresets[Name] = Preset
                end
            end
        end
    end
    HubUI.WriteCustomGoalPresets = function()
        GlobalEnv.__GOLDEN_EAGLE_GOAL_EFFECT_PRESETS = HubUI.CustomGoalPresets
        if type(writefile) ~= 'function' then return false end
        local EncodeOk, Encoded = pcall(State.Utility.HttpService.JSONEncode,
            State.Utility.HttpService, HubUI.CustomGoalPresets)
        if not EncodeOk then return false end
        return pcall(writefile, HubUI.CustomGoalPresetFile, Encoded)
    end
