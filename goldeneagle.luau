local BODY_PARTS = { 'Head', 'HumanoidRootPart', 'Torso', 'Left Arm', 'Right Arm', 'Left Leg', 'Right Leg' }
local function ClearManualBodyAura(Character)
    if not Character then return end
    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:GetAttribute('GoldenEagleLocalAura') then Object:Destroy() end
    end
end

local function ApplyManualBodyAura(Character, SourceRig)
    if not (Character and SourceRig) then return end
    ClearManualBodyAura(Character)
    for _, PartName in ipairs(BODY_PARTS) do
        local TargetPart = Character:FindFirstChild(PartName)
        local SourcePart = SourceRig:FindFirstChild(PartName)
        if TargetPart and SourcePart then
            for _, Child in ipairs(SourcePart:GetChildren()) do
                if Child:GetAttribute('Takeover') then
                    local Clone = Child:Clone()
                    Clone:SetAttribute('Takeover', nil)
                    Clone:SetAttribute('GoldenEagleLocalAura', true)
                    for _, Descendant in ipairs(Clone:GetDescendants()) do
                        Descendant:SetAttribute('Takeover', nil)
                        Descendant:SetAttribute('GoldenEagleLocalAura', true)
                    end
                    Clone.Parent = TargetPart
                end
            end
        end
    end
    for _, PartName in ipairs(BODY_PARTS) do
        local TargetPart = Character:FindFirstChild(PartName)
        if TargetPart then
            for _, Object in ipairs(TargetPart:GetDescendants()) do
                if Object:GetAttribute('GoldenEagleLocalAura') then
                    if Object:IsA('ParticleEmitter') then
                        local SavedSize = Object:GetAttribute('Size')
                        if SavedSize then pcall(function() Object.Size = SavedSize end) end
                        Object.Enabled = true
                    elseif Object:IsA('Beam') or Object:IsA('Trail') then
                        local A0 = Object:GetAttribute('Attachment0')
                        local A1 = Object:GetAttribute('Attachment1')
                        if A0 then Object.Attachment0 = TargetPart:FindFirstChild(A0, true) end
                        if A1 then Object.Attachment1 = TargetPart:FindFirstChild(A1, true) end
                        Object.Enabled = true
                    elseif Object:IsA('PointLight') then
                        Object.Enabled = true
                    end
                end
            end
        end
    end
end

function State.Cosmetics.ForceBodyAuraVisible(Character)
    if not Character then return end
    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:GetAttribute('Takeover') or Object:GetAttribute('GoldenEagleLocalAura') then
            if Object:IsA('ParticleEmitter') then
                local SavedSize = Object:GetAttribute('Size')
                if SavedSize then pcall(function() Object.Size = SavedSize end) end
                Object.Enabled = true
            elseif Object:IsA('Beam') or Object:IsA('Trail') or Object:IsA('PointLight') then
                Object.Enabled = true
            end
        end
    end
end

local function GetLocalBallHandle()
    local Now = os.clock()
    State.Cosmetics.Runtime.LastBallResolveAt = Now
    local Character = LP.Character
    if Character then
        local Root = Character:FindFirstChild('HumanoidRootPart')
        local Basketball = Character:FindFirstChild('Basketball')
        if Basketball then

            local Held = State.BallAssist.GetCanonicalBallPart(Basketball)
            if Held then
                State.Cosmetics.Runtime.LastBall = Held
                State.Cosmetics.Runtime.LastLocalBallSeenAt = Now
                return Held
            end
        end

        local LastHeldAt = State.Cosmetics.Runtime.LastLocalBallSeenAt or 0
        if Root and Now - LastHeldAt <= 4 then
            local Cached = State.Cosmetics.Runtime.LastBall
            if Cached and Cached.Parent and not Cached:IsDescendantOf(Character) then
                local OwnedByOther = false
                for _, Player in ipairs(Players:GetPlayers()) do
                    if Player ~= LP and Player.Character and Cached:IsDescendantOf(Player.Character) then
                        OwnedByOther = true
                        break
                    end
                end
                if not OwnedByOther then return Cached end
            end
            local Closest, ClosestDistance
            for _, Ball in ipairs(CollectionService:GetTagged('BallHandle')) do
                if Ball:IsA('BasePart') and Ball.Parent then
                    local OwnedByOther = false
                    for _, Player in ipairs(Players:GetPlayers()) do
                        if Player ~= LP and Player.Character and Ball:IsDescendantOf(Player.Character) then
                            OwnedByOther = true
                            break
                        end
                    end
                    if not OwnedByOther then
                        local Distance = (Ball.Position - Root.Position).Magnitude
                        if Distance <= 35 and (not ClosestDistance or Distance < ClosestDistance) then
                            Closest, ClosestDistance = Ball, Distance
                        end
                    end
                end
            end
            if Closest then
                State.Cosmetics.Runtime.LastBall = Closest
                return Closest
            end
        end
    end
    State.Cosmetics.Runtime.LastBall = nil
    return nil
end

local function ForceBallCosmeticsVisible(Ball)
    if not Ball then return end
    for _, Object in ipairs(Ball:GetDescendants()) do
        if Object:GetAttribute('Aura') or Object:GetAttribute('Trail') or Object:GetAttribute('Ball') then
            if Object:IsA('ParticleEmitter') or Object:IsA('Trail') or Object:IsA('Beam')
                or Object:IsA('PointLight') or Object:IsA('SpotLight') or Object:IsA('SurfaceLight') then
                Object.Enabled = true
            end
        end
    end
end

function State.ClearBallCosmeticObjects(Ball, Category)
    if not Ball then return end
    local Objects = Ball:GetDescendants()
    for Index = #Objects, 1, -1 do
        local Object = Objects[Index]
        if Object:GetAttribute(Category) ~= nil then pcall(function() Object:Destroy() end) end
    end
end

function State.ApplyBallCosmeticCategory(Ball, Category, Value)
    if not Ball then return false end
    Ball:SetAttribute(Category, Value)
    local Method = State.Cosmetics.Replicator and State.Cosmetics.Replicator['Replicate' .. Category]
    local Success = type(Method) == 'function' and pcall(Method, Ball, Value) or false
    if Value == nil then
        State.ClearBallCosmeticObjects(Ball, Category)
        return true
    end
    return Success
end

local function RestoreLocalBallCosmetics()
    local Pending = false
    for Ball, Original in pairs(State.Cosmetics.Runtime.BallOriginals) do
        if not (Ball and Ball.Parent) then
            State.Cosmetics.Runtime.BallOriginals[Ball] = nil
        else
            local AuraOk = State.ApplyBallCosmeticCategory(Ball, 'Aura', Original.Aura)
            local TrailOk = State.ApplyBallCosmeticCategory(Ball, 'Trail', Original.Trail)
            local BallOk = State.ApplyBallCosmeticCategory(Ball, 'Ball', Original.Ball)
            if AuraOk and TrailOk and BallOk then
                State.Cosmetics.Runtime.BallOriginals[Ball] = nil
            else
                Pending = true
            end
        end
    end
    State.Cosmetics.Runtime.LastBall = Pending and State.Cosmetics.Runtime.LastBall or nil
    return not Pending
end

local function HasLocalTakeover(Character)
    if not Character then return false end
    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:GetAttribute('Takeover') or Object:GetAttribute('GoldenEagleLocalAura') then
            return true
        end
    end
    return false
end

function State.Cosmetics.ApplyLocalCosmetics(ForceBall)
    if not State.LocalCosmeticSpoofEnabled then return end
    local Now = os.clock()
    local Ball = GetLocalBallHandle()

    for TrackedBall, Original in pairs(State.Cosmetics.Runtime.BallOriginals) do
        if TrackedBall ~= Ball then
            if TrackedBall and TrackedBall.Parent then
                State.ApplyBallCosmeticCategory(TrackedBall, 'Aura', Original.Aura)
                State.ApplyBallCosmeticCategory(TrackedBall, 'Trail', Original.Trail)
                State.ApplyBallCosmeticCategory(TrackedBall, 'Ball', Original.Ball)
            end
            State.Cosmetics.Runtime.BallOriginals[TrackedBall] = nil
        end
    end
    if Ball and State.Cosmetics.Replicator then
        if not State.Cosmetics.Runtime.BallOriginals[Ball] then
            State.Cosmetics.Runtime.BallOriginals[Ball] = {
                Aura = Ball:GetAttribute('Aura'),
                Trail = Ball:GetAttribute('Trail'),
                Ball = Ball:GetAttribute('Ball'),
            }
        end
        local Aura = State.LocalAura ~= 'None' and State.LocalAura or nil
        local Trail = State.LocalTrail ~= 'None' and State.LocalTrail or nil
        local BallSkin = State.LocalBall ~= 'None' and State.LocalBall or nil
        local Signature = table.concat({
            tostring(State.LocalAura),
            tostring(State.LocalTrail),
            tostring(State.LocalBall),
            }, '\0')
        local NeedsBallApply = ForceBall == true
            or State.Cosmetics.Runtime.AppliedBall ~= Ball
            or State.Cosmetics.Runtime.AppliedSignature ~= Signature
            or State.Cosmetics.Runtime.LastError ~= nil
            or Now - State.Cosmetics.Runtime.LastBallApplyAt >= 5
        if NeedsBallApply then
            local AuraOk, TrailOk, BallOk = true, true, true
            if Aura then
                AuraOk = State.ApplyBallCosmeticCategory(Ball, 'Aura', Aura)
            else
                State.BallStudio.HardUnequip(Ball, 'Aura')
            end
            if Trail then
                TrailOk = State.ApplyBallCosmeticCategory(Ball, 'Trail', Trail)
            else
                State.BallStudio.HardUnequip(Ball, 'Trail')
            end
            if BallSkin then
                BallOk = State.ApplyBallCosmeticCategory(Ball, 'Ball', BallSkin)
            else
                State.BallStudio.HardUnequip(Ball, 'Ball')
            end
            State.Cosmetics.Runtime.LastError = (AuraOk and TrailOk and BallOk) and nil or 'BALL COSMETIC APPLY PARTIAL'
            State.Cosmetics.Runtime.AppliedBall = Ball
            State.Cosmetics.Runtime.AppliedSignature = Signature
            State.Cosmetics.Runtime.LastBallApplyAt = Now
            ForceBallCosmeticsVisible(Ball)
            if CONFIG.BallStudioEnabled then pcall(State.BallStudio.Refresh) end
        end
    end

    local Character = LP.Character
    local ShopItems = ReplicatedStorage:FindFirstChild('ShopItems')
    local AuraFolder = ShopItems and ShopItems:FindFirstChild('Aura')
    local BodyAura = State.LocalBodyAura ~= 'None' and AuraFolder
        and AuraFolder:FindFirstChild(State.LocalBodyAura) or nil
    local BodyAuraRig = BodyAura and (BodyAura:FindFirstChild('Rig') or BodyAura)
    local BodyChanged = State.Cosmetics.Runtime.Character ~= Character
        or State.Cosmetics.Runtime.BodyAura ~= State.LocalBodyAura
    local BodyCheckDue = Now - State.Cosmetics.Runtime.LastBodyCheckAt >= 2
    local NeedsAura = BodyChanged
    if not NeedsAura and BodyCheckDue and Character and State.LocalBodyAura ~= 'None' then
        State.Cosmetics.Runtime.LastBodyCheckAt = Now
        NeedsAura = not HasLocalTakeover(Character)
    end
    if Character and State.LocalBodyAura == 'None' and BodyChanged then
        ClearManualBodyAura(Character)
        State.BallStudio.StripBodyAura(Character)
        State.Cosmetics.Runtime.Character = Character
        State.Cosmetics.Runtime.BodyAura = 'None'
    elseif Character and BodyAuraRig and BodyAuraRig:IsA('Model') and NeedsAura then
        ApplyManualBodyAura(Character, BodyAuraRig)
        State.Cosmetics.ForceBodyAuraVisible(Character)
        State.Cosmetics.Runtime.LastBodyCheckAt = Now
        State.Cosmetics.Runtime.Character = Character
        State.Cosmetics.Runtime.BodyAura = State.LocalBodyAura
    elseif Character and BodyCheckDue and State.LocalBodyAura ~= 'None' then
        State.Cosmetics.ForceBodyAuraVisible(Character)
        State.Cosmetics.Runtime.LastBodyCheckAt = Now
    end
end

