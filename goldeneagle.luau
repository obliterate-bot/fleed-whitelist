local function SanitizeLocalAlias(Value)
    Value = tostring(Value or ''):gsub('[%c\r\n]', '')
    Value = Value:match('^%s*(.-)%s*$') or ''
    if #Value > 20 then Value = string.sub(Value, 1, 20) end
    return Value ~= '' and Value or 'Anonymous'
end

local function EscapeTextPattern(Value)
    return tostring(Value or ''):gsub('([^%w])', '%%%1')
end

local function SetIdentityLabels(Container, Alias, Restore)
    if not Container then return end
    for _, Object in ipairs(Container:GetDescendants()) do
        if safe_is_a(Object, 'TextLabel') or safe_is_a(Object, 'TextButton') then
            local Desired
            if Object.Name == 'UsernameLabel' then
                Desired = '@' .. (Restore and LP.Name or Alias)
            elseif Object.Name == 'DisplayNameLabel' then
                Desired = Restore and LP.DisplayName or Alias
            elseif Object.Name == 'NameLabel' then
                Desired = Restore and LP.Name or Alias
            end
            if Desired and Object.Text ~= Desired then Object.Text = Desired end
        end
    end
end

local function RefreshLocalIdentitySurfaces()
    local Enabled = State.LocalAnonymizerEnabled
    local Alias = SanitizeLocalAlias(State.LocalAlias)
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local NameTag = Root and safe_find(Root, 'NameTag')
    if NameTag then SetIdentityLabels(NameTag, Alias, not Enabled) end

    for _, TagName in ipairs({ 'IdentityTemplate', 'IdentityTemplate Queue' }) do
        for _, Template in ipairs(CollectionService:GetTagged(TagName)) do
            if Template.Name == LP.Name then
                SetIdentityLabels(Template, Alias, not Enabled)
            end
        end
    end

    local PlayerGui = safe_find(LP, 'PlayerGui')
    if PlayerGui then
        local NamePattern = EscapeTextPattern(LP.Name)
        local DisplayPattern = LP.DisplayName ~= LP.Name and EscapeTextPattern(LP.DisplayName) or nil
        local AliasPattern = EscapeTextPattern(Alias)
        for _, Object in ipairs(PlayerGui:GetDescendants()) do
            if safe_is_a(Object, 'TextLabel') or safe_is_a(Object, 'TextButton')
                or safe_is_a(Object, 'TextBox') then
                local OriginalText = tostring(Object.Text or '')
                local Text = OriginalText
                if Enabled then
                    if string.find(Text, LP.Name, 1, true) then
                        Text = Text:gsub(NamePattern, Alias)
                    end
                    if DisplayPattern and string.find(Text, LP.DisplayName, 1, true) then
                        Text = Text:gsub(DisplayPattern, Alias)
                    end
                else
                    local RestoreName = string.find(string.lower(Object.Name), 'display', 1, true)
                        and LP.DisplayName or LP.Name
                    if string.find(Text, Alias, 1, true) then
                        Text = Text:gsub(AliasPattern, RestoreName)
                    end
                end
                if Text ~= OriginalText then Object.Text = Text end
            end
        end
    end
end

