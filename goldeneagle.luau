State.PowerBypass = { Enabled = false, Value = 85, SharedPower = nil, SuspendedUntil = 0 }
function State.PowerBypass.ResolveSharedPowerTable()
    if State.PowerBypass.SharedPower then return State.PowerBypass.SharedPower end
    local Ok, SharedPower = pcall(function() return game:GetService('SharedTableRegistry'):GetSharedTable('PowerData') end)
    if Ok then State.PowerBypass.SharedPower = SharedPower end
    return State.PowerBypass.SharedPower
end
function State.PowerBypass.Snap(Value)
    local Maximum = tonumber(CONFIG.FormulaArcMaxPower) or 85
    return math.clamp(math.floor(((tonumber(Value) or 85) + 2.5) / 5) * 5, 10, Maximum)
end
function State.PowerBypass.SyncChannels(Value)
    Value = State.PowerBypass.Snap(Value)
    if safe_get_attribute(LP, 'Power') ~= Value then safe_set_attribute(LP, 'Power', Value) end
    local SharedPower = State.PowerBypass.ResolveSharedPowerTable()
    if SharedPower then pcall(function() SharedPower.Power = Value end) end
    return Value
end
function State.PowerBypass.GetEffectivePower() return State.PowerBypass.Snap(safe_get_attribute(LP, 'Power') or 85) end
function State.PowerBypass.Write(Value) return State.PowerBypass.SyncChannels(Value) end
function State.PowerBypass.Suspend(Seconds) State.PowerBypass.SuspendedUntil = os.clock() + (tonumber(Seconds) or 0) end
function State.PowerBypass.PrepareShot(Seconds) State.PowerBypass.Suspend(Seconds or 0.5) end
function State.PowerBypass.BeginInputShot() State.PowerBypass.PreviousPower = State.PowerBypass.GetEffectivePower();
    return State.PowerBypass.PreviousPower end
function State.PowerBypass.BeginSyntheticShot() return State.PowerBypass.BeginInputShot() end
function State.PowerBypass.CommitSyntheticShot(DesiredPower) return State.PowerBypass.SyncChannels(DesiredPower or State.PowerBypass.Value) end
function State.PowerBypass.EndInputShot(DelaySeconds) State.Lifecycle:Delay(tonumber(DelaySeconds) or 0, function() if State.PowerBypass.PreviousPower then State.PowerBypass.SyncChannels(State.PowerBypass.PreviousPower);
            State.PowerBypass.PreviousPower=nil end end) end
function State.PowerBypass.Apply() if State.PowerBypass.Enabled and os.clock() >= State.PowerBypass.SuspendedUntil then State.PowerBypass.SyncChannels(State.PowerBypass.Value) end end
function State.PowerBypass.SetEnabled(Enabled, ShouldNotify) State.PowerBypass.Enabled=Enabled==true;
    State.PowerBypass.Apply() end
function State.PowerBypass.SetValue(Value, ShouldNotify) State.PowerBypass.Value=State.PowerBypass.Snap(Value);
    State.PowerBypass.Apply() end
function State.PowerBypass.Cycle(ShouldNotify)
    local Maximum = tonumber(CONFIG.FormulaArcMaxPower) or 85
    State.PowerBypass.SetValue(State.PowerBypass.Value >= Maximum and 10 or State.PowerBypass.Value + 5, ShouldNotify)
end

