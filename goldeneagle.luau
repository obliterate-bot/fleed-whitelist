State.Freecam = {
    Enabled = CONFIG.Freecam == true,
    BindName = 'GoldenEagleFreecam',
    Position = Vector3.zero,
    Yaw = 0,
    Pitch = 0,
    Saved = nil,
    Status = CONFIG.Freecam and 'READY' or 'OFF',
}
function State.Freecam.GetInput()
    if UserInputService:GetFocusedTextBox() then return Vector3.zero end
    local X,Y,Z=0,0,0
    if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then Z-=1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then Z+=1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then X-=1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then X+=1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then Y+=1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then Y-=1 end
    local V=Vector3.new(X,Y,Z)
    return V.Magnitude>1 and V.Unit or V
end
function State.Freecam.SetEnabled(Value)
    Value=Value==true
    if Value==State.Freecam.Enabled then return end
    local Camera=Workspace.CurrentCamera
    if not Camera then return end
    if Value then
        if State.Watch and State.Watch.Active and State.Watch.SetActive then pcall(State.Watch.SetActive,false) end
        local X,Y=Camera.CFrame:ToOrientation()
        State.Freecam.Saved={CameraType=Camera.CameraType,CameraSubject=Camera.CameraSubject,FieldOfView=Camera.FieldOfView,CFrame=Camera.CFrame,MouseBehavior=UserInputService.MouseBehavior,MouseIconEnabled=UserInputService.MouseIconEnabled}
        State.Freecam.Position=Camera.CFrame.Position
        State.Freecam.Pitch=X
        State.Freecam.Yaw=Y
        State.Freecam.Enabled=true;
        CONFIG.Freecam=true;
        State.Freecam.Status='ACTIVE'
        Camera.CameraType=Enum.CameraType.Scriptable;
        Camera.CameraSubject=nil;
        Camera.FieldOfView=math.clamp(tonumber(CONFIG.FreecamFOV) or 70,30,120)
        UserInputService.MouseBehavior=Enum.MouseBehavior.LockCenter;
        UserInputService.MouseIconEnabled=false
        pcall(function() State.Lifecycle:UnbindFromRenderStep(State.Freecam.BindName) end)
        State.Lifecycle:BindToRenderStep(State.Freecam.BindName,Enum.RenderPriority.Camera.Value+20,function(DeltaTime)
            if not State.Active or not State.Freecam.Enabled then return end
            local Current=Workspace.CurrentCamera;
            if not Current then return end
            Current.CameraType=Enum.CameraType.Scriptable;
            Current.CameraSubject=nil
            local Delta=UserInputService:GetMouseDelta();
            local Sens=math.clamp(tonumber(CONFIG.FreecamSensitivity) or .22,.02,1.5)
            State.Freecam.Yaw-=Delta.X*Sens*.01;
            State.Freecam.Pitch=math.clamp(State.Freecam.Pitch-Delta.Y*Sens*.01,math.rad(-89),math.rad(89))
            local Rotation=CFrame.Angles(0,State.Freecam.Yaw,0)*CFrame.Angles(State.Freecam.Pitch,0,0)
            local Direction=State.Freecam.GetInput();
            local Speed=math.clamp(tonumber(CONFIG.FreecamSpeed) or 60,1,500)
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then Speed*=math.clamp(tonumber(CONFIG.FreecamBoost) or 3,1,10) end
            State.Freecam.Position+=Rotation:VectorToWorldSpace(Direction)*Speed*math.clamp(DeltaTime or 1/60,0,0.1)
            Current.CFrame=CFrame.new(State.Freecam.Position)*Rotation
            Current.FieldOfView=math.clamp(tonumber(CONFIG.FreecamFOV) or 70,30,120)
        end)
    else
        State.Freecam.Enabled=false;
        CONFIG.Freecam=false;
        State.Freecam.Status='OFF'
        pcall(function() State.Lifecycle:UnbindFromRenderStep(State.Freecam.BindName) end)
        local Saved=State.Freecam.Saved;
        local Current=Workspace.CurrentCamera
        if Current and Saved then Current.CameraType=Saved.CameraType or Enum.CameraType.Custom;
            Current.CameraSubject=Saved.CameraSubject;
            Current.FieldOfView=Saved.FieldOfView or 70;
            Current.CFrame=Saved.CFrame or Current.CFrame end
        if Saved then UserInputService.MouseBehavior=Saved.MouseBehavior or Enum.MouseBehavior.Default;
            UserInputService.MouseIconEnabled=Saved.MouseIconEnabled~=false else UserInputService.MouseBehavior=Enum.MouseBehavior.Default;
            UserInputService.MouseIconEnabled=true end
        State.Freecam.Saved=nil
    end
    if HubUI and HubUI.Sync then HubUI.Sync() end
end
function State.Freecam.SetSpeed(Value) CONFIG.FreecamSpeed=math.clamp(tonumber(Value) or 60,1,500) end
function State.Freecam.SetSensitivity(Value) CONFIG.FreecamSensitivity=math.clamp(tonumber(Value) or .22,.02,1.5) end
function State.Freecam.SetFOV(Value) CONFIG.FreecamFOV=math.clamp(tonumber(Value) or 70,30,120);
    if State.Freecam.Enabled and Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView=CONFIG.FreecamFOV end end
function State.Freecam.SetBoost(Value) CONFIG.FreecamBoost=math.clamp(tonumber(Value) or 3,1,10) end
function State.Freecam.TeleportToLook()
    if not State.Freecam.Enabled then return false,'FREECAM OFF' end
    local Camera=Workspace.CurrentCamera
    local Character=LP.Character
    local Root=Character and safe_find(Character,'HumanoidRootPart')
    local HumanoidObject=Character and safe_find(Character,'Humanoid')
    if not (Camera and Character and Root and HumanoidObject) then return false,'NO CHARACTER' end
    local Distance=math.clamp(tonumber(CONFIG.FreecamTeleportDistance) or 2000,25,10000)
    local Params=RaycastParams.new();
    Params.FilterType=Enum.RaycastFilterType.Exclude;
    Params.FilterDescendantsInstances={Character};
    Params.IgnoreWater=false
    local Result=Workspace:Raycast(Camera.CFrame.Position,Camera.CFrame.LookVector*Distance,Params)
    local Target=Result and Result.Position or (Camera.CFrame.Position+Camera.CFrame.LookVector*Distance)
    local GroundOffset=(tonumber(HumanoidObject.HipHeight) or 2)+(Root.Size.Y*.5)+.35
    if Result and math.abs(Result.Normal.Y)>.35 then Target+=Result.Normal*GroundOffset else Target+=Vector3.new(0,GroundOffset,0) end
    local FlatLook=Vector3.new(Camera.CFrame.LookVector.X,0,Camera.CFrame.LookVector.Z)
    local Destination=FlatLook.Magnitude>.001 and CFrame.lookAt(Target,Target+FlatLook.Unit) or CFrame.new(Target)
    pcall(function() Character:PivotTo(Destination);
        Root.AssemblyLinearVelocity=Vector3.zero;
        Root.AssemblyAngularVelocity=Vector3.zero end)
    State.Freecam.Status=Result and 'TELEPORTED TO LOOK HIT' or 'TELEPORTED TO LOOK RAY'
