    if DeviceEvent then pcall(function() DeviceEvent:FireServer(Protocol) end) end
    State.Extras.DeviceSpoofEnabled, CONFIG.DeviceSpoof, CONFIG.DeviceSpoofType = Enabled, Enabled, DeviceName
    safe_set_attribute(LP, 'Device', Enabled and DeviceName or (UserInputService.TouchEnabled and 'Mobile' or 'Desktop'))
end

