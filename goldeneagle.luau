local function SetSilentAimEnabled(Enabled, ShouldNotify)
    if not State.Active then return end
    Enabled = Enabled == true
    State.RequestedEnabled = Enabled
    AimToggleGeneration += 1
    local Generation = AimToggleGeneration
    if HubUI.Sync then HubUI.Sync() end

    if not Enabled then
        StopLegitAimTween()
        State.Enabled = false
        UpdateSilentAimController()
        if HubUI.Sync then HubUI.Sync() end
        return
    end

    if State.Enabled and SilentAim.ActorAimReady == true then
        if HubUI.Sync then HubUI.Sync() end
        return
    end

    State.Lifecycle:Spawn(function()
        local WaitingNotified = false
        while State.Active and State.RequestedEnabled
            and Generation == AimToggleGeneration and not ActorsAvailable() do
            if ShouldNotify and not WaitingNotified then
                WaitingNotified = true
                Notify('GOLDEN EAGLE', 'Waiting for the shooting actors to load...')
            end
            task.wait(0.5)
        end
        if not State.Active or not State.RequestedEnabled
            or Generation ~= AimToggleGeneration then return end

        local Ready = SilentAim.EnsureActorAim()
        if not State.Active or not State.RequestedEnabled
            or Generation ~= AimToggleGeneration then return end
        State.Enabled = Ready == true
        if not Ready then State.RequestedEnabled = false end
        UpdateSilentAimController()
        if HubUI.Sync then HubUI.Sync() end
        if not Ready then Notify('GOLDEN EAGLE', 'Actor hooks unavailable') end
    end)
end

