    function HubUI.ApplyFont(Name, ShouldSave)
        Name = FontOptions[Name] and Name or 'Code'
        InterfaceConfig.Font = Name
        local Font = FontOptions[Name]
        for Index = #HubUI.FontBindings, 1, -1 do
            local Binding = HubUI.FontBindings[Index]
            if Binding.Object and Binding.Object.Parent then
                pcall(function() Binding.Object.Font = Font end)
            else
                table.remove(HubUI.FontBindings, Index)
            end
        end
        if ShouldSave ~= false then SaveInterfaceConfig() end
    end

    function HubUI.ApplyTheme(ThemeData, ShouldSave)
        ThemeData = type(ThemeData) == 'table' and ThemeData or InterfaceConfig.Theme
        for Role, DefaultHex in pairs(InterfaceDefaults.Theme) do
            local Hex = NormalizeHex(ThemeData[Role], InterfaceConfig.Theme[Role] or DefaultHex)
            InterfaceConfig.Theme[Role] = Hex
            Theme[Role] = HexToColor(Hex, Theme[Role] or HexToColor(DefaultHex))
        end
        if State.Outline then State.Outline.Color = Theme.Accent end
        for Index = #HubUI.Accents, 1, -1 do
            local Binding = HubUI.Accents[Index]
            if Binding.Object and Binding.Object.Parent then
                pcall(function() Binding.Object[Binding.Property] = Theme.Accent end)
            else
                table.remove(HubUI.Accents, Index)
            end
        end
        if HubUI.RefreshSpecialThemeSurfaces then pcall(HubUI.RefreshSpecialThemeSurfaces) end
        local Updated = 0
        for Index = #HubUI.ThemeBindings, 1, -1 do
            local Binding = HubUI.ThemeBindings[Index]
            if Binding.Object and Binding.Object.Parent and Theme[Binding.Role] then
                pcall(function() Binding.Object[Binding.Property] = Theme[Binding.Role] end)
                Updated += 1
                if Updated % 120 == 0 then task.wait() end
            else
                table.remove(HubUI.ThemeBindings, Index)
            end
        end
        for _, Control in pairs(HubUI.Controls) do
            if type(Control) == 'table' and type(Control.RefreshTheme) == 'function' then
                pcall(Control.RefreshTheme, Control)
            end
        end
        for _, Data in pairs(HubUI.TabButtons or {}) do
            if Data.Button and Data.Button.Parent then
                if Data.RefreshRow then Data.RefreshRow() end
                if Data.Divider then Data.Divider.BackgroundColor3 = Theme.Border end
            end
        end
        if HubUI.KeybindManager then
            for _, Entry in ipairs(HubUI.KeybindManager.Ordered or {}) do
                HubUI.KeybindManager:RefreshEntry(Entry)
            end
            HubUI.KeybindManager:RefreshOverlay()
        end
        if ShouldSave ~= false then SaveInterfaceConfig() end
        if HubUI.RefreshThemeEditor then HubUI.RefreshThemeEditor() end
        if HubUI.ApplyCustomization then HubUI.ApplyCustomization(false) end
    end

