    function HubUI.ApplyCustomization(ShouldSave)
        local Rounded=InterfaceConfig.RoundedUI~=false
        local ButtonStyle=tostring(InterfaceConfig.ButtonStyle or 'Rounded')
        local WindowRadius=Rounded and math.clamp(tonumber(InterfaceConfig.WindowRadius) or 10,0,30) or 0
        local PanelRadius=Rounded and math.clamp(tonumber(InterfaceConfig.PanelRadius) or 8,0,24) or 0
        local ButtonRadius=Rounded and math.clamp(tonumber(InterfaceConfig.ButtonRadius) or 7,0,24) or 0
        if ButtonStyle=='Square' then ButtonRadius=0 elseif ButtonStyle=='Pill' then ButtonRadius=999 end
        if HubUI.MainCorner then HubUI.MainCorner.CornerRadius=UDim.new(ButtonRadius>=999 and 0 or 0,WindowRadius) end
        MainBorder.Thickness=math.clamp(tonumber(InterfaceConfig.BorderThickness) or 2.5,.5,8)
        MainBorder.Transparency=math.clamp(tonumber(InterfaceConfig.BorderGlow) or .08,0,.9)
        MainBorder.LineJoinMode=Rounded and Enum.LineJoinMode.Round or Enum.LineJoinMode.Miter
        MainFlameGradient.Enabled=InterfaceConfig.AnimatedBorder~=false and InterfaceConfig.BorderStyle~='Static'
        HubUI.LastBorderStyleKey=nil
        if HubUI.RefreshBorderStyle then HubUI.RefreshBorderStyle(os.clock(),true) end
        for _,Object in ipairs(Main:GetDescendants()) do
            if Object:IsA('ScrollingFrame') and Object:GetAttribute('GoldenEagleGroupScroll') then
                Object.ScrollBarThickness=math.clamp(math.floor(tonumber(InterfaceConfig.ScrollbarWidth) or 4),0,10)
                Object.ScrollBarImageColor3=Theme.Accent
            elseif Object:IsA('UICorner') then
                local Parent=Object.Parent
                if Parent==Main then Object.CornerRadius=UDim.new(0,WindowRadius)
                elseif Parent and Parent:IsA('TextButton') then Object.CornerRadius=ButtonRadius>=999 and UDim.new(1,0) or UDim.new(0,ButtonRadius)
                elseif Parent and Parent:IsA('TextBox') then Object.CornerRadius=UDim.new(0,math.min(ButtonRadius,12))
                elseif Parent and string.find(Parent.Name,'Groupbox',1,true) then Object.CornerRadius=UDim.new(0,PanelRadius)
                end
            end
        end
        for _,Gradient in ipairs(HubUI.GroupGradients or {}) do if Gradient and Gradient.Parent then Gradient.Enabled=InterfaceConfig.PanelGradients~=false end end
        if ShouldSave~=false then SaveInterfaceConfig() end
    end
