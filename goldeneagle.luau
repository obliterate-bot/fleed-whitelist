        pcall(function()
            State.Lifecycle:DisconnectConnection(State.BallAssist.AntiReachWatchConnection)
        end)
    end
    State.BallAssist.AntiReachWatchConnection = nil
    State.BallAssist.AntiReachWatchedCharacter = nil
