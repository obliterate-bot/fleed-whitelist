        local Names = {}
        for Name, Preset in pairs(HubUI.CustomGoalPresets) do
            if type(Preset) == 'table' and type(Preset.Source) == 'string' then Names[#Names + 1] = tostring(Name) end
        end
        table.sort(Names, function(A, B) return string.lower(A) < string.lower(B) end)
        return Names
    end
