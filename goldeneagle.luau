function State.AutoOffense.ApplyTunables()
    for _, Pair in ipairs(State.AutoOffense.Tunables) do
        local Value = tonumber(CONFIG[Pair[1]])
        if Value then State.AutoOffense[Pair[2]] = Value end
    end
    State.AutoOffense.DriveRequireLaneCheck = CONFIG.AutoOffenseDriveRequireLaneCheck ~= false
end

function State.AutoOffense.CaptureTunables()
    for _, Pair in ipairs(State.AutoOffense.Tunables) do
        CONFIG[Pair[1]] = State.AutoOffense[Pair[2]]
    end
end

function State.AutoOffense.ApplySimple()
    local Safe = tostring(CONFIG.AutoOffenseStyle or 'Get To Spot') == 'Safe Mode'
    local Turn = math.clamp(tonumber(CONFIG.AutoOffenseTurnAround) or 9, 3, 20)
    local Edge = math.clamp(tonumber(CONFIG.AutoOffenseEdgeRoom) or 11, 2, 25)
    local Rush = math.clamp(tonumber(CONFIG.AutoOffenseSpotUrgency) or 5, 0, 10)
    local T = Rush / 10

    State.AutoOffense.CutoffDistance = Turn
    State.AutoOffense.StealThreatDistance = Turn * 0.75
    State.AutoOffense.BallThreatDistance = Turn * 0.70
    State.AutoOffense.EmergencyDefenderDistance = Turn * 0.75
    State.AutoOffense.CutoffDot = Safe and 0.45 or 0.60
    State.AutoOffense.CutoffClosingSpeed = Safe and 4.5 or 7.0
    State.AutoOffense.TurnAroundHold = Safe and 0.70 or 0.40
    State.AutoOffense.CutoffClosingLead = Safe and 0.35 or 0.22

    State.AutoOffense.MinLaneRoom = Edge
    State.AutoOffense.KeepInDistance = math.max(Edge + 12, 24)
    State.AutoOffense.OOBSafetyMargin = math.clamp(Edge / 16, 0.25, 1.4)
    State.AutoOffense.OOBProbeDistance = math.clamp(Edge * 0.65, 4, 12)

    State.AutoOffense.PullUpDistance = 72
    State.AutoOffense.PullUpPower = 85
    State.AutoOffense.ApproachDistance = 30 + T * 45
    State.AutoOffense.ActionCooldown = 2.4 - T * 1.9
    State.AutoOffense.DriveBodyMinTime = 1.5 - T * 1.35
    State.AutoOffense.DriveMinHold = 0.55 - T * 0.35
    State.AutoOffense.DriveTurnRate = 16 + T * 12
    State.AutoOffense.DriveLaneDistance = 9 + T * 5
    State.AutoOffense.DriveRequireLaneCheck = Safe or Rush < 8

    State.AutoOffense.StrafeStickiness = Safe and 6.5 or 3.5
    State.AutoOffense.StrafeFlipCooldown = Safe and 0.60 or 0.35
    State.AutoOffense.BackdownForwardWeight = Safe and 0.45 or 0.30
    State.AutoOffense.BackdownSideDeadzone = 0.35
    State.AutoOffense.StealLaneOffset = Safe and 3.60 or 2.85
    State.AutoOffense.DefenderPredictionTime = Safe and 0.34 or 0.28
    State.AutoOffense.ShootDistance = Safe and 28 or 32
    State.AutoOffense.DunkDistance = Safe and 10 or 14
    State.AutoOffense.ShootChance = Safe and 0.60 or 0.40

    State.AutoOffense.Mode = Safe and 'conservative' or 'aggressive'
    CONFIG.AutoOffenseMode = State.AutoOffense.Mode
    State.AutoOffense.CaptureTunables()
    State.AutoOffense.LastAction = 0
end

function State.AutoOffense.GetBehaviorProfile()
    local Mode = State.AutoOffense.BehaviorMode or 'adaptive'
    if Mode == 'humanized' then
        return {
            Mode = Mode, Response = 8, RepeatWindow = 0.95,
            RepeatPenalty = 24, PredictionTime = 0.22,
            RouteCommit = 0.72, ShotCooldown = 0.45,
        }
    elseif Mode == 'robotic' then
        return {
            Mode = Mode, Response = 30, RepeatWindow = 0.20,
            RepeatPenalty = 5, PredictionTime = 0.40,
            RouteCommit = 0.95, ShotCooldown = 0.28,
        }
    end
    return {
        Mode = 'adaptive', Response = 14, RepeatWindow = 0.55,
        RepeatPenalty = 18, PredictionTime = 0.30,
        RouteCommit = 0.84, ShotCooldown = 0.35,
    }
end

function State.AutoOffense.ApplyBehaviorProfile()
    local Profile = State.AutoOffense.GetBehaviorProfile()
    State.AutoOffense.BehaviorProfile = Profile
    State.AutoOffense.BehaviorStatus = string.upper(Profile.Mode)
    State.AutoOffense.RouteResponse = Profile.Response
    State.AutoOffense.RouteRepeatWindow = Profile.RepeatWindow
    State.AutoOffense.RouteRepeatPenalty = Profile.RepeatPenalty
    State.AutoOffense.DefenderPredictionTime = Profile.PredictionTime
    State.AutoOffense.ShotCooldown = Profile.ShotCooldown
    return Profile
end

function State.AutoOffense.SetBehaviorMode(Mode)
    Mode = string.lower(tostring(Mode or 'adaptive'))
    if Mode ~= 'humanized' and Mode ~= 'robotic' and Mode ~= 'adaptive' then
        Mode = 'adaptive'
    end
    State.AutoOffense.BehaviorMode = Mode
    CONFIG.AutoOffenseBehavior = Mode
    State.AutoOffense.ApplyBehaviorProfile()
    State.AutoOffense.LastEscapeRoute = nil
    State.AutoOffense.LastEscapeRouteAt = 0
    if HubUI and HubUI.Sync then pcall(HubUI.Sync) end
end

function State.AutoOffense.SetSimple(Key, Value)
    if Key == 'AutoOffenseStyle' then
        CONFIG.AutoOffenseStyle = tostring(Value)
    else
        local Number = tonumber(Value)
        if not Number then return end
        CONFIG[Key] = Number
    end
    State.AutoOffense.ApplySimple()
    if HubUI and HubUI.Sync then pcall(HubUI.Sync) end
end

function State.AutoOffense.ApplyMode(Mode)
    Mode = string.lower(tostring(Mode or 'balanced'))
    if Mode ~= 'aggressive' and Mode ~= 'conservative' and Mode ~= 'custom' then
        Mode = 'balanced'
    end

    State.AutoOffense.Mode = Mode
    CONFIG.AutoOffenseMode = Mode

    if Mode == 'custom' then
        State.AutoOffense.ApplyTunables()
        return
    end

    if Mode == 'aggressive' then
        State.AutoOffense.ShootChance = 0.30
        State.AutoOffense.ActionCooldown = 0.8
        State.AutoOffense.ApproachDistance = 55
        State.AutoOffense.ShootDistance = 35
        State.AutoOffense.DunkDistance = 15
    elseif Mode == 'conservative' then
        State.AutoOffense.ShootChance = 0.60
        State.AutoOffense.ActionCooldown = 2.0
        State.AutoOffense.ApproachDistance = 35
        State.AutoOffense.ShootDistance = 25
        State.AutoOffense.DunkDistance = 10
    else
        State.AutoOffense.ShootChance = 0.45
        State.AutoOffense.ActionCooldown = 1.5
        State.AutoOffense.ApproachDistance = 45
        State.AutoOffense.ShootDistance = 30
        State.AutoOffense.DunkDistance = 12
    end

    State.AutoOffense.CaptureTunables()
    if HubUI and HubUI.Sync then pcall(HubUI.Sync) end
end

