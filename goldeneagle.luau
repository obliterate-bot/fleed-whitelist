                if DragSV then SetPickerFromPoint(SVField, Input.Position, false) end
                if DragHue then SetPickerFromPoint(HueField, Input.Position, true) end
            end
        end))
        GiveSignal(UserInputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                DragSV, DragHue = false, false
