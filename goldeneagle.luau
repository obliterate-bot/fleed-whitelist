        local PendingImport
        local function BuildSnapshot()
            local Data = { Version = 1, Toggles = {}, Numbers = {}, Selects = {} }
            for Key, Control in pairs(HubUI.Controls) do
                if type(Control) == 'table' and Control.Kind and Control.Value ~= nil then
                    if Control.Kind == 'Toggle' then
                        Data.Toggles[Key] = Control.Value == true
                    elseif Control.Kind == 'Number' then
                        Data.Numbers[Key] = tonumber(Control.Value)
                    elseif Control.Kind == 'Selector' or Control.Kind == 'Dropdown' then
                        Data.Selects[Key] = tostring(Control.Value)
                    end
                end
            end
            Data.Interface = {
                Theme = DeepCopy(InterfaceConfig.Theme),
                ThemePreset = InterfaceConfig.ThemePreset,
                Font = InterfaceConfig.Font,
            }
            return Data
        end
        local function ExportCode()
            local Ok, Encoded = pcall(HttpService.JSONEncode, HttpService, BuildSnapshot())
            if not Ok then
                Notify('GOLDEN EAGLE', 'Could not encode the current config.')
                return
            end
            local Code = 'GEH1.' .. B64Encode(Encoded)
            CodeBox.Text = Code
            ClearDiff()
            AddDiffRow('Share code generated: ' .. #Code .. ' characters.', true)
            if type(setclipboard) == 'function' then
                pcall(setclipboard, Code)
                Notify('GOLDEN EAGLE', 'Share code copied to clipboard.')
            else
                Notify('GOLDEN EAGLE', 'Share code placed in the box. Copy it manually.')
            end
        end
        local function DecodeCode(Text)
            Text = string.gsub(tostring(Text or ''), '%s+', '')
            local Body = string.match(Text, '^GEH1%.(.+)$') or Text
            local Raw = B64Decode(Body)
            if not Raw or #Raw == 0 then return nil, 'Not a valid share code.' end
            local Ok, Data = pcall(HttpService.JSONDecode, HttpService, Raw)
            if not Ok or type(Data) ~= 'table' then return nil, 'Share code payload is corrupted.' end
            return Data
        end
        local function PreviewCode()
            ClearDiff()
            PendingImport = nil
            local Data, DecodeError = DecodeCode(CodeBox.Text)
            if not Data then
                AddDiffRow(DecodeError or 'Not a valid share code.', true)
                return
            end
            local Rows = 0
            local function Record(Text)
                Rows += 1
                if Rows <= 22 then AddDiffRow(Text, false) end
            end
            for Key, Value in pairs(type(Data.Toggles) == 'table' and Data.Toggles or {}) do
                local Control = HubUI.Controls[Key]
                if Control and Control.Kind == 'Toggle' and (Control.Value == true) ~= (Value == true) then
                    Record((Control.SearchLabel or Key) .. '   ' .. FormatDiffValue(Control.Value == true) .. '  >  ' .. FormatDiffValue(Value == true))
                end
            end
            for Key, Value in pairs(type(Data.Numbers) == 'table' and Data.Numbers or {}) do
                local Control = HubUI.Controls[Key]
                local Target = tonumber(Value)
                if Control and Control.Kind == 'Number' and Target and math.abs((tonumber(Control.Value) or 0) - Target) > 1e-6 then
                    Record((Control.SearchLabel or Key) .. '   ' .. tostring(Control.Value) .. '  >  ' .. tostring(Target))
                end
            end
            for Key, Value in pairs(type(Data.Selects) == 'table' and Data.Selects or {}) do
                local Control = HubUI.Controls[Key]
                if Control and (Control.Kind == 'Selector' or Control.Kind == 'Dropdown') and tostring(Control.Value) ~= tostring(Value) then
                    Record((Control.SearchLabel or Key) .. '   ' .. tostring(Control.Value) .. '  >  ' .. tostring(Value))
                end
            end
            if type(Data.Interface) == 'table' and Data.Interface.ThemePreset
                and tostring(Data.Interface.ThemePreset) ~= tostring(InterfaceConfig.ThemePreset) then
                Record('Theme preset   ' .. tostring(InterfaceConfig.ThemePreset) .. '  >  ' .. tostring(Data.Interface.ThemePreset))
            end
            if Rows == 0 then
                AddDiffRow('No changes - this code matches your current setup.', true)
                return
            end
            if Rows > 22 then AddDiffRow('... plus ' .. (Rows - 22) .. ' more change(s).', true) end
            PendingImport = Data
            AddDiffRow(tostring(Rows) .. ' change(s) staged. Press APPLY to import.', true)
        end
        local function ApplyCode()
            if not PendingImport then PreviewCode() end
            if not PendingImport then
                Notify('GOLDEN EAGLE', 'Preview a valid share code before applying.')
                return
            end
            local Data = PendingImport
            local Changed = 0
            for Key, Value in pairs(type(Data.Toggles) == 'table' and Data.Toggles or {}) do
                local Control = HubUI.Controls[Key]
                if Control and Control.Kind == 'Toggle' and Control.Set and (Control.Value == true) ~= (Value == true) then
                    if pcall(function() Control:Set(Value == true, true) end) then Changed += 1 end
                end
            end
            for Key, Value in pairs(type(Data.Numbers) == 'table' and Data.Numbers or {}) do
                local Control = HubUI.Controls[Key]
                local Target = tonumber(Value)
                if Control and Control.Kind == 'Number' and Control.Set and Target
                    and math.abs((tonumber(Control.Value) or 0) - Target) > 1e-6 then
                    if pcall(function() Control:Set(Target, true) end) then Changed += 1 end
                end
            end
            for Key, Value in pairs(type(Data.Selects) == 'table' and Data.Selects or {}) do
                local Control = HubUI.Controls[Key]
                if Control and (Control.Kind == 'Selector' or Control.Kind == 'Dropdown') and Control.Set
                    and tostring(Control.Value) ~= tostring(Value) then
                    if pcall(function() Control:Set(tostring(Value), true) end) then Changed += 1 end
                end
            end
            if type(Data.Interface) == 'table' and type(Data.Interface.Theme) == 'table' then
                local Merged = DeepCopy(InterfaceConfig.Theme)
                for Role, Hex in pairs(Data.Interface.Theme) do
                    if type(Role) == 'string' and type(Hex) == 'string' then Merged[Role] = Hex end
                end
                InterfaceConfig.ThemePreset = tostring(Data.Interface.ThemePreset or 'Custom')
                pcall(HubUI.ApplyTheme, Merged, true)
                if HubUI.RefreshThemeEditor then pcall(HubUI.RefreshThemeEditor) end
            end
            PendingImport = nil
            ClearDiff()
            AddDiffRow('Applied. ' .. Changed .. ' settings changed.', true)
            Notify('GOLDEN EAGLE', 'Share code applied. ' .. Changed .. ' settings changed.')
        end
