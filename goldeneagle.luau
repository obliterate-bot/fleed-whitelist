        function KeybindManager:RefreshOverlayState(VisibleEntries)
            for _, Entry in ipairs(VisibleEntries or {}) do
                local RowData = self.OverlayRows[Entry.Id]
                if RowData and RowData.Label and RowData.Label.Parent then
                    local Active = self:GetActive(Entry)
                    RowData.Label.TextColor3 = Active and Theme.AccentBright or Theme.Text
                end
            end
        end

        function KeybindManager:RefreshOverlay()
            if not OverlayList then return end
            local VisibleEntries = {}
            for _, Entry in ipairs(self.Ordered) do
                if Entry.Show ~= false and (Entry.Key or Entry.Mode == 'Always') then
                    table.insert(VisibleEntries, Entry)
                end
            end
            table.sort(VisibleEntries, function(A, B)
                if A.Page == B.Page then return A.Label < B.Label end
                return A.Page < B.Page
            end)

            local Count = #VisibleEntries
            local SignatureParts = { tostring(InterfaceConfig.KeybindMenuVisible), tostring(Count) }
            for _, Entry in ipairs(VisibleEntries) do
                SignatureParts[#SignatureParts + 1] = table.concat({Entry.Id, tostring(Entry.Key), tostring(Entry.Mode)}, ':')
            end
            local Signature = table.concat(SignatureParts, '|')
            if self.OverlaySignature == Signature then
                self:RefreshOverlayState(VisibleEntries)
                return
            end
            self.OverlaySignature = Signature
            for _, Child in ipairs(OverlayList:GetChildren()) do
                if Child:IsA('Frame') then Child:Destroy() end
            end
            table.clear(self.OverlayRows)
            if Count == 0 then
                local Empty = New('Frame', {
                    Size = UDim2.new(1, 0, 0, OverlayRowHeight), BackgroundColor3 = Theme.Background,
                    BackgroundTransparency = 0.02, BorderSizePixel = 0, LayoutOrder = 1, ZIndex = 122,
                    }, OverlayList)
                New('TextLabel', {
                    Position = UDim2.fromOffset(5, 0), Size = UDim2.new(1, -10, 1, 0),
                    BackgroundTransparency = 1, Font = Enum.Font.Code,
                    Text = 'No keybinds assigned', TextColor3 = Theme.Muted, TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
                    TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 123,
                    }, Empty)
            else
                for Index, Entry in ipairs(VisibleEntries) do
                    local Active = self:GetActive(Entry)
                    local KeyText = Entry.Mode == 'Always' and 'ALWAYS' or TokenDisplay(Entry.Key)
                    local DisplayText = '[' .. KeyText .. '] ' .. Entry.Label .. ' (' .. tostring(Entry.Mode) .. ')'
                    local Row = New('Frame', {
                        Size = UDim2.new(1, 0, 0, OverlayRowHeight),
                        BackgroundColor3 = Theme.Background,
                        BackgroundTransparency = Index % 2 == 0 and 0.02 or 0.10,
                        BorderSizePixel = 0, LayoutOrder = Index, ZIndex = 122,
                        }, OverlayList)
                    local Label = New('TextLabel', {
                        Position = UDim2.fromOffset(5, 0), Size = UDim2.new(1, -10, 1, 0),
                        BackgroundTransparency = 1, Font = Enum.Font.Code,
                        Text = DisplayText, TextColor3 = Active and Theme.AccentBright or Theme.Text,
                        TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 123,
                        }, Row)
                    self.OverlayRows[Entry.Id] = { Row = Row, Label = Label }
                end
            end

            local ShownRows = math.max(1, math.min(Count, OverlayMaxRows))
            local ContentHeight = math.max(OverlayRowHeight, Count * OverlayRowHeight)
            OverlayList.CanvasSize = UDim2.fromOffset(0, ContentHeight)
