local AutoQueue = {
    Status = CONFIG.AutoQueue and 'SEARCHING' or 'OFF',
    Court = '--',
    Pad = '--',
    Players = '--',
    LastAttempt = 0,
    BlockedUntil = 0,
    WasIngame = false,
}

local function ReadQueueValue(Object)
    if not Object then return nil end
    local Success, Value = pcall(function()
        return cloneref(Object).Value
    end)
    return Success and Value or nil
end

local function GetQueueCourtSize(Court)
    local Settings = safe_find(Court, '_CourtSettings')
    local PlayersValue = Settings and safe_find(Settings, 'Players')
    local Value = ReadQueueValue(PlayersValue)
    return type(Value) == 'number' and math.clamp(math.floor(Value + 0.5), 1, 5) or nil
end

local function QueueCourtStarted(Court)
    local Settings = safe_find(Court, '_CourtSettings')
    return ReadQueueValue(Settings and safe_find(Settings, 'Started')) == true
end

local function GetQueueSlotPlayer(Court, SlotName)
    local CourtPlayers = safe_find(Court, '_CourtPlayers')
    return ReadQueueValue(CourtPlayers and safe_find(CourtPlayers, SlotName))
end

local function GetQueuePadPlayer(Court, Pad)
    local SlotPlayer = GetQueueSlotPlayer(Court, Pad.Name)
    if SlotPlayer then return SlotPlayer end

    local PlayerObject = safe_find(Pad, 'PlayerObject')
    local LinkedObject = ReadQueueValue(PlayerObject)
    if typeof(LinkedObject) == 'Instance' then
        local LinkedValue = ReadQueueValue(LinkedObject)
        if LinkedValue then return LinkedValue end
        if safe_is_a(LinkedObject, 'Player') then return LinkedObject end
    end
    return nil
end

local function GetQueueCourtCounts(Court)
    local Counts = { Home = 0, Away = 0 }
    local CourtPlayers = safe_find(Court, '_CourtPlayers')
    if not CourtPlayers then return Counts end

    for _, Slot in ipairs(CourtPlayers:GetChildren()) do
        if safe_is_a(Slot, 'ObjectValue') and ReadQueueValue(Slot) then
            local Side = string.match(Slot.Name, '^(Home)') or string.match(Slot.Name, '^(Away)')
            if Side then Counts[Side] = Counts[Side] + 1 end
        end
    end
    return Counts
end

local function FindCurrentQueue()
    for _, Court in ipairs(GetAllCourts()) do
        local CourtPlayers = safe_find(Court, '_CourtPlayers')
        if CourtPlayers then
            for _, Slot in ipairs(CourtPlayers:GetChildren()) do
                if safe_is_a(Slot, 'ObjectValue') and ReadQueueValue(Slot) == LP then
                    local Pads = safe_find(Court, '_CourtPads')
                    return Court, Pads and safe_find(Pads, Slot.Name), Slot.Name
                end
            end
        end
    end
    return nil
end

local function ScoreQueueCandidate(Candidate)
    local Score
    if CONFIG.AutoQueueMode == 'Nearest Court' then
        Score = -Candidate.Distance - Candidate.MissingAfter * 0.01
    elseif CONFIG.AutoQueueMode == 'Most Players' then
        Score = Candidate.Occupied * 100000
        - Candidate.MissingAfter * 1000
        - Candidate.Distance
    else
        Score = -Candidate.MissingAfter * 100000
        + Candidate.Opponents * 5000
        + Candidate.Occupied * 1000
        - Candidate.BalanceGap * 850
        - Candidate.Distance
    end
    return Score - Candidate.Index * 0.1
end

local function FindBestQueuePad()
    if not HumanoidRootPart and not InitCharacter() then return nil end
    local Best

    for _, Court in ipairs(GetAllCourts()) do
        local Size = GetQueueCourtSize(Court)
        local Pads = safe_find(Court, '_CourtPads')
        if Size and Pads and not QueueCourtStarted(Court) then
            local Counts = GetQueueCourtCounts(Court)
            for _, Pad in ipairs(Pads:GetChildren()) do
                local Side, IndexText = string.match(Pad.Name, '^(Home)(%d+)$')
                if not Side then Side, IndexText = string.match(Pad.Name, '^(Away)(%d+)$') end

                local Index = tonumber(IndexText)
                local Center = safe_find(Pad, 'Center')
                if Side and Index and Index <= Size and Center and safe_is_a(Center, 'BasePart')
                    and not GetQueuePadPlayer(Court, Pad) then
                    local HomeAfter = Counts.Home + (Side == 'Home' and 1 or 0)
                    local AwayAfter = Counts.Away + (Side == 'Away' and 1 or 0)
                    local Candidate = {
                        Court = Court,
                        Pad = Pad,
                        Center = Center,
                        Side = Side,
                        Index = Index,
                        Distance = (Center.Position - HumanoidRootPart.Position).Magnitude,
                        Occupied = Counts.Home + Counts.Away,
                        MissingAfter = math.max(Size - HomeAfter, 0) + math.max(Size - AwayAfter, 0),
                        Opponents = Side == 'Home' and Counts.Away or Counts.Home,
                        BalanceGap = math.abs(HomeAfter - AwayAfter),
                        MaxPlayers = Size * 2,
                    }
                    Candidate.Score = ScoreQueueCandidate(Candidate)
                    if not Best or Candidate.Score > Best.Score then Best = Candidate end
                end
            end
        end
    end
    return Best
end

local function UpdateAutoQueueStatus(Status, Candidate)
    AutoQueue.Status = Status
    if Candidate then
        AutoQueue.Court = Candidate.Court and Candidate.Court.Name or '--'
        AutoQueue.Pad = Candidate.Pad and Candidate.Pad.Name or '--'
        AutoQueue.Players = string.format('%d/%d', Candidate.Occupied or 0, Candidate.MaxPlayers or 0)
    elseif Status == 'OFF' or Status == 'NO OPEN SPOT' or Status == 'COMPLETE' then
        AutoQueue.Court = '--'
        AutoQueue.Pad = '--'
        AutoQueue.Players = '--'
    end
end

local function TeleportToQueuePad(Candidate)
    if not Candidate or not Candidate.Center or not Candidate.Center.Parent then return false end
    if GetQueuePadPlayer(Candidate.Court, Candidate.Pad) then return false end
    if not HumanoidRootPart and not InitCharacter() then return false end

    local Target = (Candidate.Center.CFrame + Vector3.new(0, CONFIG.AutoQueueTeleportHeight, 0))
    * CFrame.Angles(0, math.rad(90), 0)
    return pcall(function()
        HumanoidRootPart.CFrame = Target
        HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function AttemptAutoQueue()
    if not State.Active or not State.AutoQueueEnabled then return false end
    AutoQueue.LastAttempt = os.clock()

    if safe_get_attribute(LP, 'Ingame') == true then
        UpdateAutoQueueStatus('IN GAME')
        return false
    end
    if os.clock() < AutoQueue.BlockedUntil then
        UpdateAutoQueueStatus('POST-GAME COOLDOWN')
        return false
    end

    local QueuedCourt, QueuedPad, QueuedSlot = FindCurrentQueue()
    if QueuedCourt then
        local Size = GetQueueCourtSize(QueuedCourt) or 1
        local Counts = GetQueueCourtCounts(QueuedCourt)
        UpdateAutoQueueStatus('QUEUED', {
            Court = QueuedCourt,
            Pad = QueuedPad or { Name = QueuedSlot },
            Occupied = Counts.Home + Counts.Away,
            MaxPlayers = Size * 2,
        })
        return true
    end

    if not InitCharacter() then
        UpdateAutoQueueStatus('WAITING FOR CHARACTER')
        return false
    end

    local Candidate = FindBestQueuePad()
    if not Candidate then
        UpdateAutoQueueStatus('NO OPEN SPOT')
        return false
    end

    UpdateAutoQueueStatus('JOINING', Candidate)
    if TeleportToQueuePad(Candidate) then return true end
    AutoQueue.LastAttempt = 0
    UpdateAutoQueueStatus('RETRYING')
    return false
end

local function SetAutoQueueEnabled(Enabled, ShouldNotify)
    State.AutoQueueEnabled = Enabled == true
    CONFIG.AutoQueue = State.AutoQueueEnabled
    AutoQueue.LastAttempt = 0
    AutoQueue.BlockedUntil = 0
    AutoQueue.WasIngame = safe_get_attribute(LP, 'Ingame') == true
    UpdateAutoQueueStatus(State.AutoQueueEnabled and 'SEARCHING' or 'OFF')
end

State.Lifecycle:Spawn(function()
    while State.Active do
        if State.AutoQueueEnabled then
            local Ingame = safe_get_attribute(LP, 'Ingame') == true
            if Ingame then
                AutoQueue.WasIngame = true
                UpdateAutoQueueStatus('IN GAME')
            else
                if AutoQueue.WasIngame then
                    AutoQueue.WasIngame = false
                    AutoQueue.LastAttempt = 0
                    AutoQueue.BlockedUntil = os.clock() + CONFIG.AutoQueuePostGameDelay
                    if CONFIG.AutoQueueRequeue then
                        Notify('GOLDEN EAGLE', string.format('Match over: requeueing in %ds. Toggle Auto Queue off to skip.', math.floor(tonumber(CONFIG.AutoQueuePostGameDelay) or 0)))
                    end
                    if not CONFIG.AutoQueueRequeue then
                        State.AutoQueueEnabled = false
                        CONFIG.AutoQueue = false
                        UpdateAutoQueueStatus('COMPLETE')
                    end
                end

                if State.AutoQueueEnabled then
                    local QueuedCourt, QueuedPad, QueuedSlot = FindCurrentQueue()
                    if QueuedCourt then
                        local Size = GetQueueCourtSize(QueuedCourt) or 1
                        local Counts = GetQueueCourtCounts(QueuedCourt)
                        UpdateAutoQueueStatus('QUEUED', {
                            Court = QueuedCourt,
                            Pad = QueuedPad or { Name = QueuedSlot },
                            Occupied = Counts.Home + Counts.Away,
                            MaxPlayers = Size * 2,
                        })
                    elseif os.clock() < AutoQueue.BlockedUntil then
                        UpdateAutoQueueStatus('POST-GAME COOLDOWN')
                    elseif os.clock() - AutoQueue.LastAttempt >= CONFIG.AutoQueueRetryDelay then
                        UpdateAutoQueueStatus('SEARCHING')
                        AttemptAutoQueue()
                    end
                end
            end
        elseif AutoQueue.Status ~= 'COMPLETE' then
            UpdateAutoQueueStatus('OFF')
        end
        task.wait(0.4)
    end
end)

