do

    local Compat = { Missing = {}, Shimmed = {} }
    GlobalEnv.__GEH_COMPAT = Compat

    if type(getrawmetatable) ~= 'function' then
        if type(debug) == 'table' and type(debug.getmetatable) == 'function' then
            GlobalEnv.getrawmetatable = debug.getmetatable
            table.insert(Compat.Shimmed, 'getrawmetatable')
        else
            Compat.NoRawMeta = true
            table.insert(Compat.Missing, 'getrawmetatable')
        end
    end

    if type(newcclosure) ~= 'function' then
        GlobalEnv.newcclosure = function(Fn) return Fn end
        table.insert(Compat.Shimmed, 'newcclosure')
    end

    if type(hookfunction) ~= 'function' then
        local Alias = (type(replaceclosure) == 'function' and replaceclosure)
            or (type(hookfunc) == 'function' and hookfunc)
            or (type(detour_function) == 'function' and detour_function)
        if Alias then
            GlobalEnv.hookfunction = Alias
            table.insert(Compat.Shimmed, 'hookfunction')
        else
            Compat.NoHooking = true
            table.insert(Compat.Missing, 'hookfunction')
        end
    end

    if not Compat.NoHooking
        and (type(isfunctionhooked) ~= 'function' or type(restorefunction) ~= 'function') then
        local RealHook = (type(hookfunction) == 'function' and hookfunction) or GlobalEnv.hookfunction
        local HookOriginals = setmetatable({}, { __mode = 'k' })
        GlobalEnv.hookfunction = function(Target, Replacement)
            local Original = RealHook(Target, Replacement)
            if HookOriginals[Target] == nil then HookOriginals[Target] = Original end
            return Original
        end
        if type(isfunctionhooked) ~= 'function' then
            GlobalEnv.isfunctionhooked = function(Target)
                return HookOriginals[Target] ~= nil
            end
            table.insert(Compat.Shimmed, 'isfunctionhooked')
        end
        if type(restorefunction) ~= 'function' then
            GlobalEnv.restorefunction = function(Target)
                local Original = HookOriginals[Target]
                if Original ~= nil then
                    RealHook(Target, Original)
                    HookOriginals[Target] = nil
                end
            end
            table.insert(Compat.Shimmed, 'restorefunction')
        end
    end

    if type(getactors) ~= 'function' or type(run_on_actor) ~= 'function' then
        Compat.NoActors = true
        table.insert(Compat.Missing, 'getactors/run_on_actor')
    end

    if Compat.NoHooking then
        Notify('GOLDEN EAGLE', 'No hookfunction or alias found - aim spoof features are disabled, everything else works.')
        warn('[GOLDEN EAGLE] Compatibility mode, missing: ' .. table.concat(Compat.Missing, ', '))
    elseif #Compat.Shimmed > 0 or #Compat.Missing > 0 then
        local Parts = {}
        if #Compat.Shimmed > 0 then table.insert(Parts, 'shimmed: ' .. table.concat(Compat.Shimmed, ', ')) end
        if Compat.NoActors then table.insert(Parts, 'main-VM mode (no actor support)') end
        Notify('GOLDEN EAGLE', 'Compatibility mode - ' .. table.concat(Parts, '; '))
        warn('[GOLDEN EAGLE] Compatibility mode - ' .. table.concat(Parts, '; '))
    end
end

