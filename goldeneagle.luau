local EvaluateFormulaHeight
EvaluateFormulaHeight = WYNF_JIT_MAX(function(Angle, Distance, Power, Gravity)
    local HorizontalVelocity = Power * math.cos(Angle)
    if HorizontalVelocity <= 0.000001 then return -math.huge, nil end
    local FlightTime = Distance / HorizontalVelocity
    local VerticalVelocity = Power * math.sin(Angle) + CONFIG.FormulaVerticalBoost
    return VerticalVelocity * FlightTime
    - 0.5 * Gravity * FlightTime * FlightTime, FlightTime
end)

SilentAim.ArcSolveCache = {}
SilentAim.ArcSolveCacheCount = 0

SilentAim.QuantizePower = WYNF_JIT_MAX(function(Value)
    local Step = math.max(1, tonumber(CONFIG.FormulaArcPowerStep) or 5)
    local Low = tonumber(CONFIG.FormulaArcMinPower) or 10
    local High = tonumber(CONFIG.FormulaArcMaxPower) or 85
    local Snapped = Low + math.floor(((Value - Low) / Step) + 0.5) * Step
    return math.clamp(Snapped, Low, High)
end)

SilentAim.SolveArcRoots = WYNF_JIT_MAX(function(
        Distance, HeightDifference, Power, Gravity, Segments)
    local Minimum = math.rad(-89)
    local Maximum = math.rad(89)
    local Total = math.max(8, math.floor(tonumber(Segments)
        or CONFIG.FormulaSolverSegments or 360))
    local PreviousAngle = Minimum
    local PreviousHeight = EvaluateFormulaHeight(
        PreviousAngle, Distance, Power, Gravity)
    local PreviousError = PreviousHeight - HeightDifference
    local Roots = {}

    for Index = 1, Total do
        local Angle = Minimum + (Maximum - Minimum) * (Index / Total)
        local Height = EvaluateFormulaHeight(Angle, Distance, Power, Gravity)
        local Error = Height - HeightDifference

        if PreviousError == 0 or Error == 0
            or (PreviousError < 0 and Error > 0)
            or (PreviousError > 0 and Error < 0) then
            local Low, High = PreviousAngle, Angle
            local LowError = PreviousError
            for _ = 1, CONFIG.FormulaSolverIterations do
                local Middle = (Low + High) * 0.5
                local MiddleHeight = EvaluateFormulaHeight(
                    Middle, Distance, Power, Gravity)
                local MiddleError = MiddleHeight - HeightDifference
                if LowError == 0
                    or (LowError < 0 and MiddleError >= 0)
                    or (LowError > 0 and MiddleError <= 0) then
                    High = Middle
                else
                    Low = Middle
                    LowError = MiddleError
                end
            end
            local Root = (Low + High) * 0.5
            if #Roots == 0 or math.abs(Root - Roots[#Roots]) > 0.00001 then
                table.insert(Roots, Root)
            end
        end

        PreviousAngle = Angle
        PreviousError = Error
    end
    return Roots
end)

local SolveFormulaArc
SolveFormulaArc = WYNF_JIT_MAX(function(Distance, HeightDifference, Power, RootMode)
    local Gravity = Workspace.Gravity
    if Distance <= 0.0001 or Power <= 0 or Gravity <= 0 then return nil end
    local Roots = SilentAim.SolveArcRoots(Distance, HeightDifference, Power, Gravity)
    local Angle = RootMode == 'Low' and Roots[1] or Roots[#Roots]
    if not Angle then return nil end
    local _, FlightTime = EvaluateFormulaHeight(Angle, Distance, Power, Gravity)
    return Angle, FlightTime
end)

SilentAim.SolveSpecialArc = WYNF_JIT_MAX(function(Distance, HeightDifference, Mode)
    local Gravity = Workspace.Gravity
    if Distance <= 0.0001 or Gravity <= 0 then return nil end
    local Key = string.format('special|%s|%.2f|%.2f|%.1f',
        tostring(Mode), Distance, HeightDifference, Gravity)
    local Cached = SilentAim.ArcSolveCache[Key]
    if Cached then return Cached[1], Cached[2], Cached[3] end

    local Step = math.max(1, tonumber(CONFIG.FormulaArcPowerStep) or 5)
    local Minimum = tonumber(CONFIG.FormulaArcMinPower) or 10
    local Maximum = tonumber(CONFIG.FormulaArcMaxPower) or 85
    local Scan = tonumber(CONFIG.FormulaArcScanSegments) or 72
    local BestAngle, BestTime, BestPower

    for Candidate = Minimum, Maximum, Step do
        local Roots = SilentAim.SolveArcRoots(
            Distance, HeightDifference, Candidate, Gravity, Scan)
        if Mode == 'Minimum Power' and #Roots > 0 then
            BestAngle = Roots[#Roots]
            local _, SolvedTime = EvaluateFormulaHeight(
                BestAngle, Distance, Candidate, Gravity)
            BestTime = SolvedTime
            BestPower = Candidate
            break
        end
        if Mode == 'Fastest Arrival' then
            for _, Angle in ipairs(Roots) do
                local _, FlightTime = EvaluateFormulaHeight(
                    Angle, Distance, Candidate, Gravity)
                if FlightTime and FlightTime > 0
                    and (not BestTime or FlightTime < BestTime) then
                    BestAngle, BestTime, BestPower = Angle, FlightTime, Candidate
                end
            end
        end
    end

    if BestAngle then
        if SilentAim.ArcSolveCacheCount > 300 then
            SilentAim.ArcSolveCache = {}
            SilentAim.ArcSolveCacheCount = 0
        end
        SilentAim.ArcSolveCache[Key] = { BestAngle, BestTime, BestPower }
        SilentAim.ArcSolveCacheCount += 1
    end
    return BestAngle, BestTime, BestPower
end)

SilentAim.SolveMatchArc = WYNF_JIT_MAX(function(Distance, HeightDifference)
    local Gravity = Workspace.Gravity
    if Distance <= 0.0001 or Gravity <= 0 then return nil end
    local Desired = math.rad(math.clamp(tonumber(CONFIG.MatchArcAngle) or 62, 5, 88))
    local Key = string.format('match|%.1f|%.2f|%.2f|%.1f',
        math.deg(Desired), Distance, HeightDifference, Gravity)
    local Cached = SilentAim.ArcSolveCache[Key]
    if Cached then return Cached[1], Cached[2], Cached[3] end

    local Step = math.max(1, tonumber(CONFIG.FormulaArcPowerStep) or 5)
    local Minimum = tonumber(CONFIG.FormulaArcMinPower) or 10
    local Maximum = tonumber(CONFIG.FormulaArcMaxPower) or 85
    local Scan = tonumber(CONFIG.FormulaArcScanSegments) or 72
    local BestAngle, BestTime, BestPower, BestError

    for Candidate = Minimum, Maximum, Step do
        local Roots = SilentAim.SolveArcRoots(
            Distance, HeightDifference, Candidate, Gravity, Scan)
        for Index, Angle in ipairs(Roots) do

            if CONFIG.FormulaArcIncludeFlat == true or Index == #Roots then
                local AngleError = math.abs(Angle - Desired)
                if not BestError or AngleError < BestError then
                    local _, FlightTime = EvaluateFormulaHeight(
                        Angle, Distance, Candidate, Gravity)
                    BestAngle, BestTime, BestPower, BestError =
                    Angle, FlightTime, Candidate, AngleError
                end
            end
        end
    end

    if BestAngle then
        if SilentAim.ArcSolveCacheCount > 300 then
            SilentAim.ArcSolveCache = {}
            SilentAim.ArcSolveCacheCount = 0
        end
        SilentAim.ArcSolveCache[Key] = { BestAngle, BestTime, BestPower }
        SilentAim.ArcSolveCacheCount += 1
    end
    return BestAngle, BestTime, BestPower
end)

SilentAim.GetDefenderArcMode = WYNF_JIT_MAX(function(ReleaseOrigin, AimPosition)
    local Path = Vector3.new(
        AimPosition.X - ReleaseOrigin.X, 0, AimPosition.Z - ReleaseOrigin.Z)
    local PathLengthSquared = Path:Dot(Path)
    if PathLengthSquared <= 0.0001 then return 'Low' end
    local Width = tonumber(CONFIG.ShotModeDefenderPathWidth) or 7.5
    local BestClearance = math.huge

    for _, Player in ipairs(Players:GetPlayers()) do
        local SameTeam = LP.Team ~= nil and Player.Team ~= nil and LP.Team == Player.Team
        if Player ~= LP and not SameTeam then
            local Character = Player.Character
            local Root = Character and safe_find(Character, 'HumanoidRootPart')
            local HumanoidValue = Character and safe_find(Character, 'Humanoid')
            if Root and (not HumanoidValue or HumanoidValue.Health > 0) then
                local Offset = Vector3.new(
                    Root.Position.X - ReleaseOrigin.X, 0,
                    Root.Position.Z - ReleaseOrigin.Z)
                local Along = math.clamp(Offset:Dot(Path) / PathLengthSquared, 0, 1)
                if Along > 0.06 and Along < 0.94 then
                    local Closest = Vector3.new(ReleaseOrigin.X, 0, ReleaseOrigin.Z)
                    + Path * Along
                    local DefenderFlat = Vector3.new(Root.Position.X, 0, Root.Position.Z)
                    local Clearance = (DefenderFlat - Closest).Magnitude
                    if Clearance < Width and Clearance < BestClearance then
                        BestClearance = Clearance
                    end
                end
            end
        end
    end

    if BestClearance < Width * 0.46 then return 'Normal' end
    if BestClearance < Width then return 'Medium' end
    return 'Low'
end)

local GetFormulaTarget
GetFormulaTarget = WYNF_JIT_MAX(function(Rim, Power, OriginOverride)
    local Character = LP.Character
    local Head = Character and safe_find(Character, 'Head')
    if not Character or not Head or not Rim then return nil end
    local Basketball = safe_find(Character, 'Basketball')
    local Ball = Basketball and Basketball:FindFirstChild('Ball', true)
    local ReleaseY = Ball and safe_is_a(Ball, 'BasePart') and Ball.Position.Y or Head.Position.Y
    local ReleaseOrigin
    if typeof(OriginOverride) == 'Vector3' then
        ReleaseOrigin = Vector3.new(OriginOverride.X, ReleaseY, OriginOverride.Z)
    else
        ReleaseOrigin = Vector3.new(Head.Position.X, ReleaseY, Head.Position.Z)
    end

    local Mode = CONFIG.SilentMode == 'Low' and 'Low' or 'High'
    local AimPosition = Rim.Position
    local BankShot = false
    if CONFIG.BackboardEnabled == true then
        local BankRadius = Ball and safe_is_a(Ball, 'BasePart')
            and math.max(Ball.Size.X, Ball.Size.Y, Ball.Size.Z) * 0.5 or 1.25
        local BankTarget = State.Backboard.GetMirrorTarget(Rim, ReleaseOrigin, BankRadius)
        if BankTarget then
            AimPosition = BankTarget
            BankShot = true
        elseif not CONFIG.BackboardFallbackToNormal then
            return nil
        end
    end
    if Mode == 'High' and not BankShot then
        AimPosition += Vector3.new(0, CONFIG.FormulaHighAimYOffset, 0)
    end
    local Delta = AimPosition - ReleaseOrigin
    local Flat = Vector3.new(Delta.X, 0, Delta.Z)
    local Distance = Flat.Magnitude
    if Distance <= 0.0001 then return nil end
    local Angle, FlightTime

    if CONFIG.MatchArcEnabled == true and not BankShot then
        local MatchedAngle, MatchedTime, MatchedPower =
        SilentAim.SolveMatchArc(Distance, Delta.Y)
        if MatchedAngle then
            Angle, FlightTime = MatchedAngle, MatchedTime
            if MatchedPower
                and MatchedPower ~= State.PowerBypass.GetEffectivePower() then
                State.PowerBypass.SyncChannels(MatchedPower)
            end
        end
    end
    if not Angle then
        Angle, FlightTime = SolveFormulaArc(Distance, Delta.Y, Power, Mode)
    end
    if not Angle then return nil end
    local Direction = Flat.Unit * math.cos(Angle) + Vector3.new(0, math.sin(Angle), 0)
    return Head.Position + Direction * 1000, FlightTime
end)

SilentAim.BuildArcPreviewPoints = WYNF_JIT_MAX(function(Data, SampleCount)
    if not Data or not Data.Rim then return nil end
    local Origin = Data.Origin
    if typeof(Origin) ~= 'Vector3' then return nil end
    local Character = LP.Character
    local Head = Character and safe_find(Character, 'Head')
    if not Head then return nil end
    local Solved = GetFormulaTarget(Data.Rim, Data.Power)
    if typeof(Solved) ~= 'Vector3' then return nil end
    local Direction = Solved - Head.Position
    if Direction.Magnitude <= 0.0001 then return nil end
    Direction = Direction.Unit
    local Flat = Vector3.new(Direction.X, 0, Direction.Z)
    if Flat.Magnitude <= 0.0001 then return nil end
    Flat = Flat.Unit
    local Angle = math.asin(math.clamp(Direction.Y, -1, 1))
    local Power = tonumber(Data.Power) or 0
    local Gravity = Workspace.Gravity
    local Horizontal = Power * math.cos(Angle)
    if Horizontal <= 0.000001 or Gravity <= 0 then return nil end
    local Vertical = Power * math.sin(Angle)
    + (tonumber(CONFIG.FormulaVerticalBoost) or 0)
    local RimDelta = Data.Rim.Position - Origin
    local Arrival = Vector3.new(RimDelta.X, 0, RimDelta.Z).Magnitude / Horizontal
    if Arrival ~= Arrival or Arrival <= 0 or Arrival == math.huge then return nil end
    local Overshoot = math.clamp(tonumber(CONFIG.ArcPreviewOvershoot) or 1.06, 1, 1.6)
    local Duration = math.clamp(Arrival * Overshoot, 0.05, 8)
    local Count = math.clamp(math.floor(tonumber(SampleCount) or 28), 8, 64)
    local Points = {}
    for Index = 0, Count do
        local Elapsed = Duration * (Index / Count)
        Points[Index + 1] = Origin + Flat * (Horizontal * Elapsed)
        + Vector3.new(0, Vertical * Elapsed
            - 0.5 * Gravity * Elapsed * Elapsed, 0)
    end
    Points.Landing = Origin + Flat * (Horizontal * Arrival)
    + Vector3.new(0, Vertical * Arrival - 0.5 * Gravity * Arrival * Arrival, 0)
    Points.Arrival = Arrival
    Points.Error = (Points.Landing - Data.Rim.Position).Magnitude
    return Points
end)

State.Humanize = {
    Status = 'IDLE', LastAngle = 0, LastSpread = 0, LastResult = '--',
    Blocked = 0, Makes = 0, Misses = 0, Rng = Random.new(),
    Roll = nil, RollAt = 0, Tallied = true,
    CurrentMissing = false, CurrentBlocked = false,
}

function State.Humanize.NewShot()
    local R = State.Humanize.Rng or Random.new()
    State.Humanize.Rng = R
    State.Humanize.Roll = {
        Angle = R:NextNumber(0, 360), Hit = R:NextNumber(),
        Spread = R:NextNumber(), Lift = R:NextNumber(),
    }
    State.Humanize.RollAt = os.clock()
    State.Humanize.Tallied = false
    State.Humanize.CurrentMissing = false
    State.Humanize.CurrentBlocked = false
    State.Humanize.LastResult = 'PREVIEW'
    return State.Humanize.Roll
end

function State.Humanize.GetShotRoll()
    return State.Humanize.Roll or State.Humanize.NewShot()
end

function State.Humanize.Apply(Target, Rim, Commit)
    if typeof(Target) ~= 'Vector3' then return Target end
    local Camera = Workspace.CurrentCamera
    local Accuracy = math.clamp(tonumber(CONFIG.HumanizeAccuracy) or 92, 0, 100)
    local MaxAngle = math.clamp(tonumber(CONFIG.HumanizeMaxAngle) or 25, 1, 180)
    local Radius = math.clamp(tonumber(CONFIG.HumanizeErrorRadius) or 0.6, 0, 3)
    local Severity = math.clamp(tonumber(CONFIG.HumanizeMissSeverity) or 1.8, 1, 4)
    local Roll = State.Humanize.GetShotRoll()
    State.Humanize.CurrentBlocked = false

    if Camera and MaxAngle < 180 then
        local CameraOrigin = Camera.CFrame.Position
        local ToTarget = Target - CameraOrigin
        if ToTarget.Magnitude > 0.05 then
            local Dot = math.clamp(Camera.CFrame.LookVector:Dot(ToTarget.Unit), -1, 1)
            local Angle = math.deg(math.acos(Dot))
            State.Humanize.LastAngle = Angle
            if Angle > MaxAngle then
                State.Humanize.CurrentBlocked = true
                State.Humanize.CurrentMissing = false
                State.Humanize.LastSpread = 0
                State.Humanize.LastResult = 'PASSTHROUGH'
                State.Humanize.Status = string.format('OUTSIDE CONE | %.0f > %.0f DEG', Angle, MaxAngle)
                if Commit and not State.Humanize.Tallied then
                    State.Humanize.Tallied = true
                    State.Humanize.Blocked += 1
                end

                local Character = LP.Character
                local Head = Character and safe_find(Character, 'Head')
                local Origin = Head and Head.Position or CameraOrigin
                local RayLength = math.max((Target - Origin).Magnitude, 1000)
                return Origin + Camera.CFrame.LookVector.Unit * RayLength
            end
        end
    end

    local Missing = Roll.Hit > (Accuracy / 100)
    local Spread
    if Missing then
        local MissBase = math.max(Radius, 0.65)
        Spread = math.clamp(math.max(1.15,
            MissBase * Severity * (0.80 + Roll.Spread * 0.45)), 1.15, 5.5)
    else
        Spread = math.clamp(
            Radius * (0.05 + Roll.Spread * 0.13) * (1.05 - Accuracy / 200), 0, 0.18)
    end

    State.Humanize.CurrentMissing = Missing
    State.Humanize.LastSpread = Spread
    State.Humanize.LastResult = Missing and 'MISS' or 'MAKE'
    State.Humanize.Status = string.format('%s | %.2f STUDS AT RIM',
        Missing and 'MISS VARIATION' or 'MAKE VARIATION', Spread)
    if Commit and not State.Humanize.Tallied then
        State.Humanize.Tallied = true
        if Missing then State.Humanize.Misses += 1 else State.Humanize.Makes += 1 end
    end
    if Spread <= 0 or not Rim or not safe_is_a(Rim, 'BasePart') then return Target end

    local Character = LP.Character
    local Head = Character and safe_find(Character, 'Head')
    local Origin = Head and Head.Position or (Camera and Camera.CFrame.Position)
    if typeof(Origin) ~= 'Vector3' then return Target end
    local TargetVector = Target - Origin
    local RimVector = Rim.Position - Origin
    local TargetFlatDistance = Vector3.new(TargetVector.X, 0, TargetVector.Z).Magnitude
    local RimFlatDistance = Vector3.new(RimVector.X, 0, RimVector.Z).Magnitude
    if TargetFlatDistance <= 0.01 or RimFlatDistance <= 0.01 then return Target end

    local RayScale = TargetFlatDistance / RimFlatDistance
    local Theta = math.rad(Roll.Angle)
    local HorizontalOffset = Vector3.new(math.cos(Theta), 0, math.sin(Theta))
    * Spread * RayScale
    local VerticalOffset = Vector3.new(0,
        (Roll.Lift - 0.5) * Spread * 0.20 * RayScale, 0)
    return Target + HorizontalOffset + VerticalOffset
end

local BuildSilentAimTarget
BuildSilentAimTarget = WYNF_JIT_MAX(function(Rim, Distance, Power, OriginOverride, Commit)
    local Target = GetFormulaTarget(Rim, Power, OriginOverride)
    if Target and CONFIG.HumanizeEnabled then
        return State.Humanize.Apply(Target, Rim, Commit == true), nil
    end
    return Target, nil
end)

State.SmartShot = {
    Active = false, Generation = 0, Status = 'OFF', Decision = 'NORMAL', Reason = '--',
    Defender = nil, Distance = math.huge, ClosingSpeed = 0, Side = 'CENTER', Saved = nil,
}
function State.SmartShot.Restore(Status)
    local Saved = State.SmartShot.Saved
    if Saved then for Key, Value in pairs(Saved) do CONFIG[Key] = Value end end
    State.SmartShot.Generation += 1
    State.SmartShot.Active, State.SmartShot.Saved = false, nil
    State.SmartShot.Status = Status or (CONFIG.SmartShotSelector and 'READY' or 'OFF')
end
function State.SmartShot.Apply(Name, Reason, Root, DefenderRoot)
    local Saved = {}
    for _, Key in ipairs({ 'AutoStepback','StepbackActivation','StepbackDirection','AutoFadeaway','FadeawayDirection','AutoStop','TrickshotEnabled','TrickshotRotationMode','RandomTrickshotMode','MatchArcEnabled','MatchArcAngle','BackboardEnabled' }) do Saved[Key] = CONFIG[Key] end
    State.SmartShot.Saved, State.SmartShot.Active = Saved, true
    State.SmartShot.Decision, State.SmartShot.Reason = Name, Reason
    State.SmartShot.Status = 'SELECTED ' .. Name
    CONFIG.AutoStepback, CONFIG.AutoFadeaway, CONFIG.AutoStop = false, false, false
    CONFIG.TrickshotEnabled, CONFIG.MatchArcEnabled, CONFIG.BackboardEnabled = false, false, false
    if Name == 'STEPBACK' and CONFIG.SmartShotAllowStepback then
        CONFIG.AutoStepback, CONFIG.StepbackActivation = true, 'Every shot'
        CONFIG.StepbackDirection = 'Away from defender'
    elseif Name == 'SIDESTEP LEFT' and CONFIG.SmartShotAllowStepback then
        CONFIG.AutoStepback, CONFIG.StepbackActivation, CONFIG.StepbackDirection = true, 'Every shot', 'Left'
    elseif Name == 'SIDESTEP RIGHT' and CONFIG.SmartShotAllowStepback then
        CONFIG.AutoStepback, CONFIG.StepbackActivation, CONFIG.StepbackDirection = true, 'Every shot', 'Right'
    elseif Name == 'FADEAWAY' and CONFIG.SmartShotAllowFadeaway then
        CONFIG.AutoFadeaway, CONFIG.FadeawayDirection = true, 'Away from defender'
    elseif Name == 'QUICK STOP' and CONFIG.SmartShotAllowQuickStop then
        CONFIG.AutoStop = true
    elseif Name == 'TRICKSHOT' and CONFIG.SmartShotAllowTrickshot then
        CONFIG.TrickshotEnabled, CONFIG.TrickshotRotationMode, CONFIG.RandomTrickshotMode = true, 'Spin', true
    elseif Name == 'HIGH ARC' then
        CONFIG.MatchArcEnabled, CONFIG.MatchArcAngle = true, 76
    elseif Name == 'BANK SHOT' and CONFIG.SmartShotAllowBank then
        CONFIG.BackboardEnabled = true
    end
    State.SmartShot.Generation += 1
    local G=State.SmartShot.Generation
    State.Lifecycle:Delay(8,function() if State.SmartShot.Generation==G and State.SmartShot.Active then State.SmartShot.Restore('TIMEOUT') end end)
end
function State.SmartShot.Select(Root)
    if not CONFIG.SmartShotSelector then State.SmartShot.Status='OFF';
        return false end
    if State.SmartShot.Active then return true end
    local Player, Distance
    pcall(function() Player, Distance = State.AutoBody.FindDefender(Root) end)
    local Character=Player and Player.Character
    local DefenderRoot=Character and safe_find(Character,'HumanoidRootPart')
    Distance=DefenderRoot and (DefenderRoot.Position-Root.Position).Magnitude or math.huge
    local Closing, Side, Airborne=0,'CENTER',false
    if DefenderRoot then
        local Delta=DefenderRoot.Position-Root.Position
        local Flat=Vector3.new(Delta.X,0,Delta.Z)
        if Flat.Magnitude>0.01 then Closing=-(DefenderRoot.AssemblyLinearVelocity-Root.AssemblyLinearVelocity):Dot(Flat.Unit) end
        local LocalPos=Root.CFrame:PointToObjectSpace(DefenderRoot.Position)
        Side=LocalPos.X>1.5 and 'RIGHT' or (LocalPos.X < -1.5 and 'LEFT' or 'CENTER')
        local H=Character:FindFirstChildOfClass('Humanoid');
        Airborne=H and H.FloorMaterial==Enum.Material.Air or false
    end
    State.SmartShot.Defender,State.SmartShot.Distance,State.SmartShot.ClosingSpeed,State.SmartShot.Side=Player,Distance,Closing,Side
    local Close=math.clamp(tonumber(CONFIG.SmartShotCloseDistance) or 6,2,15)
    local Pressure=math.clamp(tonumber(CONFIG.SmartShotPressureDistance) or 11,Close,25)
    local Open=math.clamp(tonumber(CONFIG.SmartShotOpenDistance) or 16,Pressure,40)
    local Rush=math.clamp(tonumber(CONFIG.SmartShotRushSpeed) or 5,0,25)
    local Decision,Reason='NORMAL','OPEN LOOK'
    if not DefenderRoot or Distance>=Open then
        local Behavior=tostring(CONFIG.SmartShotOpenBehavior or 'Normal')
        if Behavior=='Trickshot' then Decision='TRICKSHOT' elseif Behavior=='Quick Stop' then Decision='QUICK STOP' elseif Behavior=='Random' then local A={'NORMAL','QUICK STOP','TRICKSHOT'};
            Decision=A[math.random(1,#A)] end
    elseif Airborne then
        local Reaction=tostring(CONFIG.SmartShotAirborneReaction or 'High Arc')
        Decision=Reaction=='Stepback' and 'STEPBACK' or (Reaction=='Fadeaway' and 'FADEAWAY' or (Reaction=='Bank Shot' and 'BANK SHOT' or 'HIGH ARC'));
        Reason='DEFENDER AIRBORNE'
    elseif Closing>=Rush and Distance<=Pressure then Decision='STEPBACK';
        Reason='DEFENDER RUSHING'
    elseif Distance<=Close then Decision='FADEAWAY';
        Reason='CLOSE CONTEST'
    elseif Distance<=Pressure and Side=='LEFT' then Decision='SIDESTEP RIGHT';
        Reason='LEFT PRESSURE'
    elseif Distance<=Pressure and Side=='RIGHT' then Decision='SIDESTEP LEFT';
        Reason='RIGHT PRESSURE'
    elseif Distance<=Pressure then Decision='QUICK STOP';
        Reason='FRONT PRESSURE'
    end
    if CONFIG.SmartShotStrategy=='Conservative' and (Decision=='TRICKSHOT' or Decision=='STEPBACK') then Decision='QUICK STOP';
        Reason='CONSERVATIVE CONTROL'
    elseif CONFIG.SmartShotStrategy=='Aggressive' and Decision=='NORMAL' and Distance<Open then Decision='STEPBACK';
        Reason='AGGRESSIVE SPACE'
    elseif CONFIG.SmartShotStrategy=='Highlight' and Decision=='NORMAL' then Decision='TRICKSHOT';
        Reason='HIGHLIGHT OPEN' end
    State.SmartShot.Apply(Decision,Reason,Root,DefenderRoot)
    return true
end
function State.SmartShot.MarkFired()
    if not State.SmartShot.Active then return end
    local G=State.SmartShot.Generation
    State.SmartShot.Status='SHOT FIRED - RESTORING'
    State.Lifecycle:Delay(0.45,function() if State.SmartShot.Generation==G then State.SmartShot.Restore('READY') end end)
end

State.Stepback = {
    Active = false,
    Generation = 0,
    Status = 'OFF',
    StartedAt = 0,
    EndsAt = 0,
    LastStartedAt = 0,
    LastDirection = '--',
    LastDistance = 0,
    LastRequestedDistance = 0,
    LastDefender = nil,
    LastDefenderDistance = math.huge,
    PendingFaceRim = false,
    BlockedReason = nil,
    JumpPhase = 'READY',
    JumpGeneration = 0,
    ChainedShot = false,
}

function State.Stepback.Cancel(Status)
    State.Stepback.Generation += 1
    State.Stepback.JumpGeneration += 1
    State.Stepback.Active = false
    State.Stepback.PendingFaceRim = false
    State.Stepback.JumpPhase = 'READY'
    State.Stepback.ChainedShot = false
    State.Stepback.Status = Status or (CONFIG.AutoStepback and 'READY' or 'OFF')
end

function State.Stepback.GetDefender(Root)
    local Player, Distance
    pcall(function()
        if State.AutoBody and State.AutoBody.FindDefender then
            Player, Distance = State.AutoBody.FindDefender(Root)
        end
    end)
    local Character = Player and Player.Character
    local DefenderRoot = Character and safe_find(Character, 'HumanoidRootPart')
    Distance = DefenderRoot and (DefenderRoot.Position - Root.Position).Magnitude or math.huge
    return Player, DefenderRoot, Distance
end

function State.Stepback.GetOpenDirection(Root, Character)
    local Candidates = {
        { Name = 'BACKWARD', Vector = -Root.CFrame.LookVector },
        { Name = 'LEFT', Vector = -Root.CFrame.RightVector },
        { Name = 'RIGHT', Vector = Root.CFrame.RightVector },
    }
    local Best, BestScore
    local ProbeDistance = math.clamp(tonumber(CONFIG.StepbackDistance) or 5, 1, 15)
    for _, Candidate in ipairs(Candidates) do
        local Flat = Vector3.new(Candidate.Vector.X, 0, Candidate.Vector.Z)
        if Flat.Magnitude > 0.01 then
            Flat = Flat.Unit
            local Destination = Root.Position + Flat * ProbeDistance
            local Clearance = math.huge
            for _, Player in ipairs(Players:GetPlayers()) do

                if Player ~= LP then
                    local TheirCharacter = Player.Character
                    local TheirRoot = TheirCharacter and safe_find(TheirCharacter, 'HumanoidRootPart')
                    if TheirRoot then
                        local Delta = Vector3.new(
                            Destination.X - TheirRoot.Position.X, 0,
                            Destination.Z - TheirRoot.Position.Z)
                        Clearance = math.min(Clearance, Delta.Magnitude)
                    end
                end
            end
            local BackwardBias = Candidate.Name == 'BACKWARD' and 0.35 or 0
            local Score = (Clearance == math.huge and 100 or Clearance) + BackwardBias
            if not BestScore or Score > BestScore then
                BestScore = Score
                Best = { Name = Candidate.Name, Vector = Flat }
            end
        end
    end
    return Best and Best.Vector or -Root.CFrame.LookVector,
    Best and Best.Name or 'BACKWARD'
end

function State.Stepback.ResolveDirection(Root, Character, DefenderRoot)
    local Mode = tostring(CONFIG.StepbackDirection or 'Away from defender')
    local Direction, Label
    if Mode == 'Left' then
        Direction, Label = -Root.CFrame.RightVector, 'LEFT'
    elseif Mode == 'Right' then
        Direction, Label = Root.CFrame.RightVector, 'RIGHT'
    elseif Mode == 'Random' then
        local Pick = math.random(1, 3)
        Direction = Pick == 1 and -Root.CFrame.LookVector
            or (Pick == 2 and -Root.CFrame.RightVector or Root.CFrame.RightVector)
        Label = Pick == 1 and 'BACKWARD' or (Pick == 2 and 'LEFT' or 'RIGHT')
    elseif Mode == 'Toward open space' then
        Direction, Label = State.Stepback.GetOpenDirection(Root, Character)
    elseif Mode == 'Away from defender' and DefenderRoot then
        Direction = Root.Position - DefenderRoot.Position
        Label = 'AWAY FROM DEFENDER'
    else
        Direction, Label = -Root.CFrame.LookVector, 'BACKWARD'
    end
    Direction = Vector3.new(Direction.X, 0, Direction.Z)
    if Direction.Magnitude <= 0.01 then
        Direction, Label = Vector3.new(0, 0, 1), 'WORLD BACK'
    end
    return Direction.Unit, Label
end

function State.Stepback.Ease(Alpha)
    Alpha = math.clamp(Alpha, 0, 1)
    local Mode = tostring(CONFIG.StepbackEasing or 'Smooth')
    if Mode == 'Linear' then return Alpha end
    if Mode == 'Ease out' then return 1 - (1 - Alpha) * (1 - Alpha) end
    if Mode == 'Sharp' then return Alpha ^ 0.45 end
    return Alpha * Alpha * (3 - 2 * Alpha)
end

function State.Stepback.ClampDistance(Character, Root, Direction, Requested)
    local Distance = math.max(0, Requested)
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = { Character }
    Params.IgnoreWater = true
    if CONFIG.StepbackCollisionCheck then
        local Hit = Workspace:Raycast(Root.Position, Direction * Distance, Params)
        if Hit then Distance = math.max(0, Hit.Distance - 1.25) end
    end
    if CONFIG.StepbackEdgeSafety and Distance > 0 then
        local Margin = math.clamp(tonumber(CONFIG.StepbackEdgeMargin) or 2.5, 0, 8)
        local SafeDistance = Distance
        local FoundGround = false
        for Index = 0, 12 do
            local ProbeDistance = Distance * (1 - Index / 12)
            local Destination = Root.Position + Direction * ProbeDistance
            local Ground = Workspace:Raycast(
                Destination + Vector3.new(0, 3, 0),
                Vector3.new(0, -(10 + Margin), 0), Params)
            if Ground then
                SafeDistance = ProbeDistance
                FoundGround = true
                break
            end
        end
        Distance = FoundGround and SafeDistance or 0
    end
    return Distance
end

function State.Stepback.FaceRim(Character, Root)
    Character = Character or LP.Character
    Root = Root or (Character and safe_find(Character, 'HumanoidRootPart'))
    if not Root then return false end
    local Rim = select(1, FindConfiguredGoal())
    if not Rim then return false end
    local Target = Vector3.new(Rim.Position.X, Root.Position.Y, Rim.Position.Z)
    if (Target - Root.Position).Magnitude <= 0.01 then return false end
    pcall(function() Root.CFrame = CFrame.lookAt(Root.Position, Target, Vector3.yAxis) end)
    return true
end

function State.Stepback.CanStart(Root)
    if not CONFIG.AutoStepback then return false, 'OFF' end
    if State.Stepback.Active then return false, 'ALREADY RUNNING' end
    local Now = os.clock()
    local Cooldown = math.clamp(tonumber(CONFIG.StepbackCooldown) or 0.65, 0, 4)
    if Now - (State.Stepback.LastStartedAt or 0) < Cooldown then
        return false, 'COOLDOWN'
    end
    local Player, DefenderRoot, DefenderDistance = State.Stepback.GetDefender(Root)
    State.Stepback.LastDefender = Player
    State.Stepback.LastDefenderDistance = DefenderDistance
    local Activation = tostring(CONFIG.StepbackActivation or 'Every shot')
    local EBLPhase = State.Trickshot and State.Trickshot.EBLPhase or 'READY'
    local EBLShot = CONFIG.AutoEBL
        and (EBLPhase == 'SECOND_JUMP' or EBLPhase == 'SHOOTING')
    if Activation == 'EBL second jump only' and not EBLShot then
        return false, 'WAITING FOR EBL', Player, DefenderRoot, DefenderDistance
    elseif Activation == 'Non-EBL shots only' and EBLShot then
        return false, 'SKIPPED EBL', Player, DefenderRoot, DefenderDistance
    elseif Activation == 'Defender close' and DefenderDistance > math.clamp(tonumber(CONFIG.StepbackDefenderRange) or 14, 2, 35) then
        return false, 'DEFENDER OUT OF RANGE', Player, DefenderRoot, DefenderDistance
    elseif Activation == 'Random chance' then
        local Chance = math.clamp(tonumber(CONFIG.StepbackRandomChance) or 50, 0, 100)
        if math.random() * 100 > Chance then
            return false, 'RANDOM SKIP', Player, DefenderRoot, DefenderDistance
        end
    end
    if CONFIG.StepbackRequireDefender and not DefenderRoot then
        return false, 'NO DEFENDER', Player, DefenderRoot, DefenderDistance
    end
    if CONFIG.StepbackRequireDefender
        and DefenderDistance > math.clamp(tonumber(CONFIG.StepbackDefenderRange) or 14, 2, 35) then
        return false, 'DEFENDER OUT OF RANGE', Player, DefenderRoot, DefenderDistance
    end
    return true, nil, Player, DefenderRoot, DefenderDistance
end

function State.Stepback.Start(Character, Root)
    Character = Character or LP.Character
    Root = Root or (Character and safe_find(Character, 'HumanoidRootPart'))
    local HumanoidObject = Character and Character:FindFirstChildOfClass('Humanoid')
    if not (Character and Root and HumanoidObject and HumanoidObject.Health > 0) then
        State.Stepback.Status = 'CHARACTER NOT READY'
        return false
    end
    local Allowed, Reason, Defender, DefenderRoot, DefenderDistance = State.Stepback.CanStart(Root)
    if not Allowed then
        State.Stepback.Status = Reason or 'SKIPPED'
        State.Stepback.BlockedReason = Reason
        return false
    end
    local Direction, DirectionLabel = State.Stepback.ResolveDirection(Root, Character, DefenderRoot)
    local Requested = math.clamp(tonumber(CONFIG.StepbackDistance) or 5, 0, 15)
    local Variance = math.clamp(tonumber(CONFIG.StepbackRandomVariance) or 0, 0, 75) / 100
    if Variance > 0 then Requested *= 1 + ((math.random() * 2 - 1) * Variance) end
    local Distance = State.Stepback.ClampDistance(Character, Root, Direction, Requested)
    if Distance < 0.15 then
        State.Stepback.Status = 'BLOCKED BY SAFETY'
        State.Stepback.BlockedReason = 'COLLISION OR EDGE'
        return false
    end
    local Delay = math.clamp(tonumber(CONFIG.StepbackDelay) or 0, 0, 0.8)
    local Duration = math.clamp(tonumber(CONFIG.StepbackDuration) or 0.24, 0.06, 0.8)
    local WalkSpeedCap = math.clamp(math.max(tonumber(CONFIG.StepbackWalkSpeed) or 42, 32), 32, 60)
    local TargetWalkSpeed = math.clamp(math.max(Distance / Duration, 32), 32, WalkSpeedCap)
    local EstimatedWalkTime = Distance / math.max(TargetWalkSpeed, 0.01)
    State.Stepback.Generation += 1
    local Generation = State.Stepback.Generation
    State.Stepback.Active = true
    State.Stepback.StartedAt = os.clock()
    State.Stepback.EndsAt = State.Stepback.StartedAt + Delay + EstimatedWalkTime + 0.75
    State.Stepback.LastStartedAt = State.Stepback.StartedAt
    State.Stepback.LastDirection = DirectionLabel
    State.Stepback.LastRequestedDistance = Requested
    State.Stepback.LastDistance = Distance
    State.Stepback.LastDefender = Defender
    State.Stepback.LastDefenderDistance = DefenderDistance
    State.Stepback.BlockedReason = nil
    State.Stepback.PendingFaceRim = false
    State.Stepback.Status = Delay > 0 and 'DELAYING' or ('STEPPING ' .. DirectionLabel)

    State.Lifecycle:Spawn(function()
        local DelayEnds = os.clock() + Delay
        while State.Active and State.Stepback.Active
            and State.Stepback.Generation == Generation and os.clock() < DelayEnds do
            RunService.Heartbeat:Wait()
        end
        if not (State.Active and State.Stepback.Active
            and State.Stepback.Generation == Generation and Root and Root.Parent) then return end

        local OriginalWalkSpeed = HumanoidObject.WalkSpeed
        local OriginalAutoRotate = HumanoidObject.AutoRotate
        local StepbackActionName = 'GoldenEagleStepbackWalk'
        local ContextActionService = game:GetService('ContextActionService')
        local Cleaned = false
        local function RestoreWalking()
            if Cleaned then return end
            Cleaned = true
            pcall(function()
                HumanoidObject:Move(Vector3.zero, false)
                HumanoidObject:MoveTo(Root.Position)
                pcall(function() ContextActionService:UnbindAction(StepbackActionName) end)
                HumanoidObject.WalkSpeed = OriginalWalkSpeed
                HumanoidObject.AutoRotate = OriginalAutoRotate
                if State.Runtime then State.Runtime.ReleaseMovement('Stepback') end
            end)
        end

        pcall(function()
            ContextActionService:BindActionAtPriority(
                StepbackActionName,
                function() return Enum.ContextActionResult.Sink end,
                false, 10000,
                Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
                Enum.KeyCode.Up, Enum.KeyCode.Left, Enum.KeyCode.Down, Enum.KeyCode.Right,
                Enum.KeyCode.Thumbstick1)
        end)

        if CONFIG.StepbackAutoStopBefore then
            pcall(function()
                local Velocity = Root.AssemblyLinearVelocity
                Root.AssemblyLinearVelocity = Vector3.new(0, Velocity.Y, 0)
                HumanoidObject:Move(Vector3.zero, false)
            end)
        end

        if CONFIG.StepbackFaceRim then
            State.Stepback.FaceRim(Character, Root)
            pcall(function() HumanoidObject.AutoRotate = false end)
        end
        pcall(function() HumanoidObject.WalkSpeed = TargetWalkSpeed end)
        State.Stepback.Status = 'WALKING ' .. DirectionLabel
        local Started = os.clock()
        local StartPosition = Root.Position
        local Destination = StartPosition + Direction * Distance
        local Travelled = 0
        local ExpectedTime = Distance / math.max(TargetWalkSpeed, 0.01)
        local Deadline = Started + math.max(Duration, ExpectedTime) + 0.75
        local StepSignal = RunService.PreSimulation or RunService.Heartbeat
        pcall(function() HumanoidObject:MoveTo(Destination) end)

        local function HasManualMovementInput()
            for _, Key in ipairs({
                Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
                Enum.KeyCode.Up, Enum.KeyCode.Left, Enum.KeyCode.Down, Enum.KeyCode.Right,
            }) do
                if UserInputService:IsKeyDown(Key) then return true end
            end
            local Ok, Inputs = pcall(function()
                return UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
            end)
            if Ok then
                for _, Input in ipairs(Inputs) do
                    if Input.KeyCode == Enum.KeyCode.Thumbstick1
                        and Vector2.new(Input.Position.X, Input.Position.Y).Magnitude > 0.35 then
                        return true
                    end
                end
            end
            return false
        end

        while State.Active and State.Stepback.Active
            and State.Stepback.Generation == Generation
            and Root and Root.Parent and HumanoidObject and HumanoidObject.Parent
            and os.clock() < Deadline do
            StepSignal:Wait()
            if State.Stepback.Generation ~= Generation or not State.Stepback.Active then
                RestoreWalking()
                return
            end
            if CONFIG.StepbackManualCancel and os.clock() - Started > 0.06
                and HasManualMovementInput() then
                RestoreWalking()
                State.Stepback.Cancel('CANCELLED BY INPUT')
                return
            end

            pcall(function()
                HumanoidObject.Jump = false
                local Velocity = Root.AssemblyLinearVelocity
                Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
                if HumanoidObject.FloorMaterial == Enum.Material.Air then
                    HumanoidObject:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)

            local Alpha = math.clamp((os.clock() - Started) / math.max(ExpectedTime, 0.06), 0, 1)
            local Curve = tostring(CONFIG.StepbackEasing or 'Smooth')
            local SpeedScale = 1
            if Curve == 'Smooth' then
                SpeedScale = 0.90 + math.sin(Alpha * math.pi) * 0.10
            elseif Curve == 'Ease out' then
                SpeedScale = 1 - Alpha * 0.12
            elseif Curve == 'Sharp' then
                SpeedScale = Alpha < 0.14 and 1.08 or 0.98
            end
            pcall(function()
                local LiveWalkSpeed = math.clamp(TargetWalkSpeed * SpeedScale, 4, WalkSpeedCap)
                HumanoidObject.WalkSpeed = LiveWalkSpeed

                if not State.Runtime or State.Runtime.AcquireMovement('Stepback', 0.12) then
                    HumanoidObject:Move(Direction, false)
                    if CONFIG.StepbackVelocityAssist then

                        Root.AssemblyLinearVelocity = Vector3.new(
                            Direction.X * LiveWalkSpeed, 0, Direction.Z * LiveWalkSpeed)
                    end
                end
            end)
            local Offset = Root.Position - StartPosition
            local FlatOffset = Vector3.new(Offset.X, 0, Offset.Z)
            Travelled = math.max(0, FlatOffset:Dot(Direction))
            State.Stepback.LastDistance = math.min(Travelled, Distance)
            if Travelled >= Distance - 0.10 then break end
        end

        RestoreWalking()
        if State.Stepback.Generation ~= Generation then return end
        if CONFIG.StepbackAutoStopAfter and Root and Root.Parent then
            pcall(function()
                local Velocity = Root.AssemblyLinearVelocity
                Root.AssemblyLinearVelocity = Vector3.new(0, Velocity.Y, 0)
                HumanoidObject:Move(Vector3.zero, false)
            end)
        end
        State.Stepback.Active = false
        State.Stepback.LastDistance = math.min(Travelled, Distance)
        State.Stepback.Status = Travelled >= Distance - 0.20
            and ('WALK COMPLETE ' .. DirectionLabel)
            or string.format('WALK PARTIAL %.1f/%.1f', Travelled, Distance)
        State.Stepback.PendingFaceRim = false
        if CONFIG.StepbackFaceRim then State.Stepback.FaceRim(Character, Root) end
    end)
    return true
end

function State.Stepback.HandleJumpAttempt(HumanoidObject, Character, Root)
    if not CONFIG.AutoStepback then
        if State.Stepback.JumpPhase ~= 'READY' then
            State.Stepback.JumpGeneration += 1
            State.Stepback.JumpPhase = 'READY'
            State.Stepback.ChainedShot = false
        end
        return false
    end
    if not (HumanoidObject and Character and Root) then return false end
    local Phase = State.Stepback.JumpPhase
    if Phase == 'FORCED_JUMP' then
        State.Stepback.JumpPhase = 'IN_SHOT'
        State.Stepback.ChainedShot = true
        return false
    end
    if Phase == 'STEPPING' then
        pcall(function() HumanoidObject.Jump = false end)
        return true
    end
    if Phase == 'IN_SHOT' then return false end

    local Allowed = select(1, State.Stepback.CanStart(Root))
    if not Allowed then return false end

    State.Stepback.JumpGeneration += 1
    local JumpGeneration = State.Stepback.JumpGeneration
    State.Stepback.JumpPhase = 'STEPPING'
    State.Stepback.ChainedShot = false
    pcall(function()
        HumanoidObject.Jump = false
        HumanoidObject:ChangeState(Enum.HumanoidStateType.Running)
        local Velocity = Root.AssemblyLinearVelocity
        Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
    end)

    local Started = State.Stepback.Start(Character, Root)
    if not Started then
        State.Stepback.JumpPhase = 'FORCED_JUMP'
        State.Lifecycle:Spawn(function()
            RunService.Heartbeat:Wait()
            if State.Active and State.Stepback.JumpGeneration == JumpGeneration
                and HumanoidObject and HumanoidObject.Parent then
                pcall(function()
                    HumanoidObject.Jump = true
                    HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)
                end)
            end
        end)
        return true
    end

    State.Lifecycle:Spawn(function()
        local Deadline = math.max(State.Stepback.EndsAt or 0, os.clock()) + 0.4
        while State.Active and State.Stepback.JumpGeneration == JumpGeneration
            and State.Stepback.Active and os.clock() < Deadline do
            RunService.Heartbeat:Wait()
        end
        if not (State.Active and CONFIG.AutoStepback
            and State.Stepback.JumpGeneration == JumpGeneration
            and HumanoidObject and HumanoidObject.Parent and Root and Root.Parent) then return end
        local JumpDelay = math.clamp(tonumber(CONFIG.StepbackJumpDelay) or 0.04, 0, 0.5)
        local JumpAt = os.clock() + JumpDelay
        State.Stepback.Status = JumpDelay > 0 and 'GROUND HOLD BEFORE JUMP' or 'JUMPING'
        while State.Active and State.Stepback.JumpGeneration == JumpGeneration
            and os.clock() < JumpAt do
            pcall(function()
                HumanoidObject.Jump = false
                local Velocity = Root.AssemblyLinearVelocity
                Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
            end)
            RunService.Heartbeat:Wait()
        end
        if not (State.Active and State.Stepback.JumpGeneration == JumpGeneration
            and HumanoidObject and HumanoidObject.Parent) then return end
        State.Stepback.JumpPhase = 'FORCED_JUMP'
        State.Stepback.Status = 'STEP COMPLETE - JUMPING'
        pcall(function() HumanoidObject.Jump = false end)
        RunService.Heartbeat:Wait()
        if not (State.Active and State.Stepback.JumpGeneration == JumpGeneration
            and State.Stepback.JumpPhase == 'FORCED_JUMP') then return end
        pcall(function()
            HumanoidObject.Jump = true
            HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)
        end)

        local WasAirborne = false
        local MonitorStarted = os.clock()
        local ResetDeadline = MonitorStarted + 8
        while State.Active and State.Stepback.JumpGeneration == JumpGeneration
            and os.clock() < ResetDeadline do
            if HumanoidObject.FloorMaterial == Enum.Material.Air then WasAirborne = true end
            if CONFIG.AutoEBL then
                if State.Trickshot.EBLPhase == 'READY' and WasAirborne
                    and os.clock() - MonitorStarted > 0.25
                    and not State.Trickshot.ForceAutoRelease then break end
            elseif WasAirborne and HumanoidObject.FloorMaterial ~= Enum.Material.Air then
                break
            end
            RunService.Heartbeat:Wait()
        end
        if State.Stepback.JumpGeneration == JumpGeneration then
            State.Stepback.JumpPhase = 'READY'
            State.Stepback.ChainedShot = false
            State.Stepback.Status = CONFIG.AutoStepback and 'READY' or 'OFF'
        end
    end)
    return true
end

State.TurnaroundShot = {
    Active = false, Generation = 0, Status = 'OFF', LastAt = 0,
    Direction = '--', Angle = 0, StartedAt = 0, EndsAt = 0,
    SavedHumanoid = nil, SavedAutoRotate = nil,
}

function State.TurnaroundShot.Cancel(Status)
    State.TurnaroundShot.Generation += 1
    State.TurnaroundShot.Active = false
    local H = State.TurnaroundShot.SavedHumanoid
    if H and H.Parent and State.TurnaroundShot.SavedAutoRotate ~= nil then
        pcall(function() H.AutoRotate = State.TurnaroundShot.SavedAutoRotate end)
    end
    State.TurnaroundShot.SavedHumanoid = nil
    State.TurnaroundShot.SavedAutoRotate = nil
    State.Runtime.ReleaseRotation('Turnaround')
    State.TurnaroundShot.Status = Status or (CONFIG.AutoTurnaroundShot and 'READY' or 'OFF')
end

function State.TurnaroundShot.GetGeometry(Root)
    local Rim = select(1, FindConfiguredGoal())
    if not (Rim and Root) then return nil end
    local ToRim = Vector3.new(Rim.Position.X - Root.Position.X, 0, Rim.Position.Z - Root.Position.Z)
    local Look = Vector3.new(Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
    if ToRim.Magnitude <= 0.05 or Look.Magnitude <= 0.05 then return nil end
    ToRim, Look = ToRim.Unit, Look.Unit
    local Dot = math.clamp(Look:Dot(ToRim), -1, 1)
    local BackAngle = math.deg(math.acos(Dot))
    local SignedAngle = math.deg(math.atan2(Look:Cross(ToRim).Y, Dot))
    return Rim, ToRim, Look, BackAngle, SignedAngle
end

function State.TurnaroundShot.ResolveDirection(Root, DefenderRoot, SignedAngle)
    local Mode = tostring(CONFIG.TurnaroundDirection or 'Automatic')
    local Sign = SignedAngle >= 0 and 1 or -1
    if Mode == 'Left' then Sign = 1
    elseif Mode == 'Right' then Sign = -1
    elseif Mode == 'Ball side' then
        Sign = State.AutoBody and State.AutoBody.CurrentHand == 'L' and 1 or -1
    elseif Mode == 'Opposite ball side' then
        Sign = State.AutoBody and State.AutoBody.CurrentHand == 'L' and -1 or 1
    elseif math.abs(SignedAngle) >= 165 and DefenderRoot then
        local LocalDefender = Root.CFrame:PointToObjectSpace(DefenderRoot.Position)
        Sign = LocalDefender.X >= 0 and 1 or -1
    end
    return Sign, Sign > 0 and 'LEFT' or 'RIGHT'
end

function State.TurnaroundShot.Start(Character, Root)
    if not CONFIG.AutoTurnaroundShot or State.TurnaroundShot.Active then return false end
    local Now = os.clock()
    Character = Character or LP.Character
    Root = Root or (Character and safe_find(Character, 'HumanoidRootPart'))
    local H = Character and Character:FindFirstChildOfClass('Humanoid')
    if not (Character and Root and H and H.Health > 0 and safe_find(Character, 'Basketball')) then
        State.TurnaroundShot.Status = 'WAITING FOR BALL';
        return false
    end

    if State.AutoBody then
        State.AutoBody.SuspendedUntil = Now + math.clamp(tonumber(CONFIG.TurnaroundDuration) or 0.24, 0.08, 0.75) + 0.45
        State.AutoBody.Status = 'PAUSED FOR TURNAROUND'
        State.AutoBody.ReleaseRotation()
    end
    if Now - (State.TurnaroundShot.LastAt or 0) < math.max(0, tonumber(CONFIG.TurnaroundCooldown) or 1) then
        State.TurnaroundShot.Status = 'COOLDOWN';
        return false
    end
    if (State.Stepback and State.Stepback.Active) or (State.AutoDunk and State.AutoDunk.InProgress)
        or (State.Trickshot and State.Trickshot.Active) then
        State.TurnaroundShot.Status = 'ACTION BUSY';
        return false
    end
    local Rim, ToRim, StartLook, BackAngle, SignedAngle = State.TurnaroundShot.GetGeometry(Root)
    if not Rim then State.TurnaroundShot.Status = 'NO RIM';
        return false end
    local MinimumAngle = math.clamp(tonumber(CONFIG.TurnaroundMinimumBackAngle) or 100, 60, 175)
    if BackAngle < MinimumAngle then State.TurnaroundShot.Status = 'NOT BACK TO RIM';
        return false end
    local Defender, DefenderDistance
    pcall(function() Defender, DefenderDistance = State.AutoBody.FindDefender(Root) end)
    local DefenderCharacter = Defender and Defender.Character
    local DefenderRoot = DefenderCharacter and safe_find(DefenderCharacter, 'HumanoidRootPart')
    DefenderDistance = DefenderRoot and (DefenderRoot.Position - Root.Position).Magnitude or math.huge
    local Range = math.clamp(tonumber(CONFIG.TurnaroundDefenderRange) or 8, 2, 20)
    if DefenderDistance > Range then DefenderRoot = nil end
    local Duration = math.clamp(tonumber(CONFIG.TurnaroundDuration) or 0.24, 0.08, 0.75)
    if not State.Runtime.AcquireRotation('Turnaround', Duration + 0.35) then
        State.TurnaroundShot.Status = 'ROTATION BUSY';
        return false
    end
    local Sign, DirectionName = State.TurnaroundShot.ResolveDirection(Root, DefenderRoot, SignedAngle)
    local ShortestSign = SignedAngle >= 0 and 1 or -1
    local RotationMagnitude = math.abs(SignedAngle)
    if Sign ~= ShortestSign then RotationMagnitude = 360 - RotationMagnitude end
    local RotationAngle = RotationMagnitude * Sign
    State.TurnaroundShot.Cancel('STARTING')
    State.Runtime.AcquireRotation('Turnaround', Duration + 0.35)
    State.TurnaroundShot.Generation += 1
    local Generation = State.TurnaroundShot.Generation
    State.TurnaroundShot.Active = true
    State.TurnaroundShot.LastAt = Now
    State.TurnaroundShot.Direction = DirectionName
    State.TurnaroundShot.Angle = RotationAngle
    State.TurnaroundShot.StartedAt, State.TurnaroundShot.EndsAt = Now, Now + Duration
    local SavedAutoRotate = H.AutoRotate
    if State.AutoBody and State.AutoBody.TrackedHumanoid == H
        and State.AutoBody.OriginalAutoRotate ~= nil then
        SavedAutoRotate = State.AutoBody.OriginalAutoRotate
    end
    State.TurnaroundShot.SavedHumanoid, State.TurnaroundShot.SavedAutoRotate = H, SavedAutoRotate
    State.TurnaroundShot.Status = string.format('TURNING %s %.0f DEG', DirectionName, math.abs(RotationAngle))
    if State.AutoBody then
        State.AutoBody.SuspendedUntil = Now + Duration + 0.30
        State.AutoBody.ReleaseRotation()
    end
    H.AutoRotate = false

    local StartPosition = Root.Position
    local StepSignal = RunService.PreSimulation or RunService.Heartbeat
    State.Lifecycle:Spawn(function()
        while State.Active and State.TurnaroundShot.Active and State.TurnaroundShot.Generation == Generation
            and Root and Root.Parent and H and H.Parent do
            StepSignal:Wait()
            if CONFIG.TurnaroundManualCancel and State.Runtime.HasManualInput(true) then
                State.TurnaroundShot.Cancel('MANUAL CANCEL');
                return
            end
            local A = math.clamp((os.clock() - Now) / Duration, 0, 1)
            local E = A * A * (3 - 2 * A)
            local Theta = math.rad(RotationAngle * E)
            local C, S = math.cos(Theta), math.sin(Theta)
            local Direction = Vector3.new(StartLook.X * C + StartLook.Z * S, 0, -StartLook.X * S + StartLook.Z * C)
            if A >= 0.98 then Direction = ToRim end
            pcall(function()
                local CurrentPosition = Root.Position
                local Position = Vector3.new(StartPosition.X, CurrentPosition.Y, StartPosition.Z)
                Root.CFrame = CFrame.lookAt(Position, Position + Direction.Unit, Vector3.yAxis)
                Root.AssemblyLinearVelocity = Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)
                Root.AssemblyAngularVelocity = Vector3.zero
            end)
            if A >= 1 then break end
        end
        if State.TurnaroundShot.Generation ~= Generation then return end
        if Root and Root.Parent then pcall(function()
                local CurrentPosition = Root.Position
                local Position = Vector3.new(StartPosition.X, CurrentPosition.Y, StartPosition.Z)
                Root.CFrame = CFrame.lookAt(Position, Position + ToRim, Vector3.yAxis)
                Root.AssemblyLinearVelocity = Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)
                Root.AssemblyAngularVelocity = Vector3.zero
            end) end
        State.TurnaroundShot.Active = false
        if H and H.Parent then pcall(function() H.AutoRotate = State.TurnaroundShot.SavedAutoRotate ~= false end) end
        State.TurnaroundShot.SavedHumanoid, State.TurnaroundShot.SavedAutoRotate = nil, nil
        State.Runtime.ReleaseRotation('Turnaround')
        State.TurnaroundShot.Status = 'COMPLETE ' .. DirectionName
    end)
    return true
end

function State.TurnaroundShot.WaitForStyle()
    local Deadline = math.max(State.TurnaroundShot.EndsAt or 0, os.clock()) + 0.18
    while State.Active and State.TurnaroundShot.Active and os.clock() < Deadline do
        RunService.Heartbeat:Wait()
    end
    return not State.TurnaroundShot.Active
end

State.Trickshot = {
    Active = false, Generation = 0, Status = 'OFF', Angle = 0,
    StartedAt = 0, EndsAt = 0, SavedHumanoid = nil, SavedAutoRotate = nil,
    EBLPhase = 'READY', EBLGeneration = 0, EBLStatus = 'OFF', ForceAutoRelease = false,
    MovementActive = false, MovementGeneration = 0, MovementEndsAt = 0,
    MovementStatus = 'OFF', LastRandomAngle = nil, LastFadeDirection = nil,
    FlipAngle = 0, RotationMode = 'Off',
    SavedRootMotor = nil, SavedRootTransform = nil,
}

function State.Trickshot.ResolveAngle()
    local Configured = math.clamp(tonumber(CONFIG.TrickshotAngle) or 360, -2160, 2160)
    if not CONFIG.RandomTrickshotMode then return Configured end
    local Angles = { 360, 720, 1080 }
    local Pick = Angles[math.random(1, #Angles)]
    if math.random() < 0.5 then Pick = -Pick end
    State.Trickshot.LastRandomAngle = Pick
    return Pick
end

function State.Trickshot.ResolveFadeDirection(Root)
    local Mode = tostring(CONFIG.FadeawayDirection or 'Away from defender')
    local Direction
    if Mode == 'Left' then
        Direction = -Root.CFrame.RightVector
    elseif Mode == 'Right' then
        Direction = Root.CFrame.RightVector
    elseif Mode == 'Random' then
        local Pick = math.random(1, 3)
        Direction = Pick == 1 and -Root.CFrame.RightVector
            or (Pick == 2 and Root.CFrame.RightVector or -Root.CFrame.LookVector)
    elseif Mode == 'Away from defender' then
        local Defender
        pcall(function()
            local Player = State.AutoBody and State.AutoBody.FindDefender
                and select(1, State.AutoBody.FindDefender(Root))
            local Character = Player and Player.Character
            Defender = Character and safe_find(Character, 'HumanoidRootPart')
        end)
        if Defender then
            Direction = Root.Position - Defender.Position
        else
            Direction = -Root.CFrame.LookVector
        end
    else
        Direction = -Root.CFrame.LookVector
    end
    Direction = Vector3.new(Direction.X, 0, Direction.Z)
    if Direction.Magnitude <= 0.01 then Direction = Vector3.new(0, 0, 1) end
    State.Trickshot.LastFadeDirection = Mode
    return Direction.Unit
end

function State.Trickshot.CancelShotMovement(Status)
    State.Trickshot.MovementGeneration += 1
    State.Trickshot.MovementActive = false
    State.Trickshot.MovementStatus = Status or ((CONFIG.AutoFadeaway or CONFIG.AutoStop) and 'READY' or 'OFF')
end

function State.Trickshot.StartShotMovement(Character, Root)
    if not (CONFIG.AutoFadeaway or CONFIG.AutoStop) then
        State.Trickshot.MovementStatus = 'OFF'
        return false
    end
    Character = Character or LP.Character
    Root = Root or (Character and safe_find(Character, 'HumanoidRootPart'))
    local H = Character and Character:FindFirstChildOfClass('Humanoid')
    if not (Root and H and H.Health > 0) then return false end
    State.Trickshot.CancelShotMovement('STARTING')
    State.Trickshot.MovementGeneration += 1
    local Generation = State.Trickshot.MovementGeneration
    local FadeEnabled = CONFIG.AutoFadeaway == true
    local StopEnabled = CONFIG.AutoStop == true
    local Distance = math.clamp(tonumber(CONFIG.FadeawayDistance) or 4.5, 0, 12)
    local Duration = FadeEnabled
        and math.clamp(tonumber(CONFIG.FadeawayDuration) or 0.28, 0.08, 0.65)
        or 0.14
    local Direction = FadeEnabled and State.Trickshot.ResolveFadeDirection(Root) or Vector3.zero
    State.Trickshot.MovementActive = true
    State.Trickshot.MovementEndsAt = os.clock() + Duration
    State.Trickshot.MovementStatus = FadeEnabled
        and ('FADING ' .. string.upper(tostring(CONFIG.FadeawayDirection)))
        or 'QUICK STOP'

    State.Lifecycle:Spawn(function()
        local StartedAt = os.clock()
        local LastEased = 0
        while State.Active and State.Trickshot.MovementActive
            and State.Trickshot.MovementGeneration == Generation
            and Root and Root.Parent and H and H.Parent do
            local Alpha = math.clamp((os.clock() - StartedAt) / Duration, 0, 1)
            local Eased = Alpha * Alpha * (3 - 2 * Alpha)
            if StopEnabled then
                pcall(function()
                    local Velocity = Root.AssemblyLinearVelocity
                    Root.AssemblyLinearVelocity = Vector3.new(0, Velocity.Y, 0)
                    H:Move(Vector3.zero, false)
                end)
            end
            if FadeEnabled and Eased > LastEased then
                local Step = Direction * Distance * (Eased - LastEased)
                pcall(function() Root.CFrame = Root.CFrame + Step end)
            end
            LastEased = Eased
            if Alpha >= 1 then break end
            RunService.Heartbeat:Wait()
        end
        if State.Trickshot.MovementGeneration ~= Generation then return end
        State.Trickshot.MovementActive = false
        State.Trickshot.MovementStatus = FadeEnabled and 'FADE COMPLETE' or 'STOPPED'
    end)
    return true
end

function State.Trickshot.CancelSpin(Status)
    State.Trickshot.Generation += 1
    State.Trickshot.Active = false
    local H = State.Trickshot.SavedHumanoid
    if H and H.Parent and State.Trickshot.SavedAutoRotate ~= nil then
        pcall(function() H.AutoRotate = State.Trickshot.SavedAutoRotate end)
    end
    local RootMotor = State.Trickshot.SavedRootMotor
    if RootMotor and RootMotor.Parent and State.Trickshot.SavedRootTransform then
        pcall(function() RootMotor.Transform = State.Trickshot.SavedRootTransform end)
    end
    State.Trickshot.SavedHumanoid, State.Trickshot.SavedAutoRotate = nil, nil
    State.Trickshot.SavedRootMotor, State.Trickshot.SavedRootTransform = nil, nil
    State.Trickshot.Status = Status or (CONFIG.TrickshotEnabled and 'READY' or 'OFF')
end

local function FindCharacterRootMotor(Character, Root)
    local Motor = Root and safe_find(Root, 'RootJoint')
    if Motor and Motor:IsA('Motor6D') then return Motor end
    local LowerTorso = Character and safe_find(Character, 'LowerTorso')
    Motor = LowerTorso and safe_find(LowerTorso, 'Root')
    if Motor and Motor:IsA('Motor6D') then return Motor end
    local Torso = Character and safe_find(Character, 'Torso')
    Motor = Torso and (safe_find(Torso, 'RootJoint') or safe_find(Torso, 'Root'))
    if Motor and Motor:IsA('Motor6D') then return Motor end
    return nil
end

function State.Trickshot.StartSpin(Character, Root)
    local Mode = tostring(CONFIG.TrickshotRotationMode or 'Spin')
    if not CONFIG.TrickshotEnabled or Mode == 'Off' then
        State.Trickshot.Status = 'OFF'
        return false
    end
    if State.Trickshot.Active then State.Trickshot.CancelSpin('RESTARTING') end
    Character = Character or LP.Character
    Root = Root or (Character and safe_find(Character, 'HumanoidRootPart'))
    local H = Character and Character:FindFirstChildOfClass('Humanoid')
    if not (Character and Root and H and H.Health > 0) then
        State.Trickshot.Status = 'CHARACTER NOT READY';
        return false
    end

    local ResolvedAngle = State.Trickshot.ResolveAngle()
    local Magnitude = math.abs(ResolvedAngle)
    local YawAngle, FlipAngle = 0, 0
    local EffectiveMode = Mode
    if Mode == 'Random Flip' then
        EffectiveMode = math.random() < 0.5 and 'Frontflip' or 'Backflip'
    end
    if EffectiveMode == 'Spin' then
        YawAngle = ResolvedAngle
    elseif EffectiveMode == 'Frontflip' then
        FlipAngle = Magnitude
    elseif EffectiveMode == 'Backflip' then
        FlipAngle = -Magnitude
    elseif EffectiveMode == 'Spin + Frontflip' then
        YawAngle, FlipAngle = ResolvedAngle, Magnitude
    elseif EffectiveMode == 'Spin + Backflip' then
        YawAngle, FlipAngle = ResolvedAngle, -Magnitude
    end
    if math.abs(YawAngle) < 0.01 and math.abs(FlipAngle) < 0.01 then
        State.Trickshot.Status = '0 DEG - NORMAL SHOT'
        return false
    end

    local RootMotor = math.abs(FlipAngle) > 0.01 and FindCharacterRootMotor(Character, Root) or nil
    if math.abs(FlipAngle) > 0.01 and not RootMotor then
        State.Trickshot.Status = 'FLIP FAILED - ROOT MOTOR NOT FOUND'
        return false
    end
    local SavedRootTransform = RootMotor and RootMotor.Transform or nil
    local Duration = math.clamp(tonumber(CONFIG.TrickshotDuration) or 0.28, 0.08, 1.2)
    State.Trickshot.Generation += 1
    local Generation = State.Trickshot.Generation
    State.Trickshot.Active = true
    State.Trickshot.Angle = YawAngle
    State.Trickshot.FlipAngle = FlipAngle
    State.Trickshot.RotationMode = EffectiveMode
    State.Trickshot.StartedAt, State.Trickshot.EndsAt = os.clock(), os.clock() + Duration
    State.Trickshot.SavedHumanoid, State.Trickshot.SavedAutoRotate = H, H.AutoRotate
    State.Trickshot.SavedRootMotor, State.Trickshot.SavedRootTransform = RootMotor, SavedRootTransform
    State.Trickshot.Status = string.format('%s %.0f DEG', string.upper(EffectiveMode), Magnitude)
    H.AutoRotate = false
    local StartRotation = Root.CFrame - Root.Position
    local StepSignal = RunService.PreSimulation or RunService.Heartbeat

    State.Lifecycle:Spawn(function()
        while State.Active and State.Trickshot.Active and State.Trickshot.Generation == Generation
            and Root and Root.Parent and H and H.Parent do
            StepSignal:Wait()
            if State.Trickshot.Generation ~= Generation or not State.Trickshot.Active then return end
            local A = math.clamp((os.clock() - State.Trickshot.StartedAt) / Duration, 0, 1)
            local E = A * A * (3 - 2 * A)
            pcall(function()
                if math.abs(YawAngle) > 0.01 then
                    Root.CFrame = CFrame.new(Root.Position) * StartRotation
                    * CFrame.Angles(0, math.rad(YawAngle * E), 0)
                end
                if RootMotor and RootMotor.Parent and SavedRootTransform then
                    RootMotor.Transform = SavedRootTransform
                    * CFrame.Angles(math.rad(FlipAngle * E), 0, 0)
                end
                Root.AssemblyAngularVelocity = Vector3.zero
            end)
            if A >= 1 then break end
        end
        if State.Trickshot.Generation ~= Generation then return end
        if Root and Root.Parent and math.abs(YawAngle) > 0.01 then pcall(function()
                Root.CFrame = CFrame.new(Root.Position) * StartRotation
                * CFrame.Angles(0, math.rad(YawAngle), 0)
                Root.AssemblyAngularVelocity = Vector3.zero
            end) end
        if RootMotor and RootMotor.Parent and SavedRootTransform then
            pcall(function() RootMotor.Transform = SavedRootTransform end)
        end
        State.Trickshot.Active = false
        if H and H.Parent then pcall(function() H.AutoRotate = State.Trickshot.SavedAutoRotate ~= false end) end
        State.Trickshot.SavedHumanoid, State.Trickshot.SavedAutoRotate = nil, nil
        State.Trickshot.SavedRootMotor, State.Trickshot.SavedRootTransform = nil, nil
        State.Trickshot.Status = string.format('COMPLETE %s %.0f DEG', string.upper(EffectiveMode), Magnitude)
    end)
    return true
end

function State.Trickshot.WaitForStyle()
    local Deadline = math.max(
        State.Trickshot.EndsAt or 0,
        State.Trickshot.MovementEndsAt or 0,
        os.clock()) + 0.18
    while State.Active and (State.Trickshot.Active or State.Trickshot.MovementActive)
        and os.clock() < Deadline do
        RunService.Heartbeat:Wait()
    end
    return not State.Trickshot.Active and not State.Trickshot.MovementActive
end

function State.Trickshot.WaitForSpin()
    return State.Trickshot.WaitForStyle()
end

function State.Trickshot.ResetAutoEBL(Status)
    State.Trickshot.EBLGeneration += 1
    State.Trickshot.EBLPhase, State.Trickshot.ForceAutoRelease = 'READY', false
    State.Trickshot.EBLStatus = Status or (CONFIG.AutoEBL and 'READY' or 'OFF')
end

function State.Trickshot.HandleAutoEBLJump(H)
    if not CONFIG.AutoEBL then State.Trickshot.EBLStatus = 'OFF';
        return false end
    if not (H and H.Parent) then return false end
    local Phase = State.Trickshot.EBLPhase
    if Phase == 'SECOND_JUMP' then
        State.Trickshot.EBLPhase, State.Trickshot.EBLStatus = 'SHOOTING', 'SECOND JUMP - SHOOTING'
        State.Trickshot.ForceAutoRelease = true
        local G = State.Trickshot.EBLGeneration
        State.Lifecycle:Delay(3, function()
            if State.Trickshot.EBLGeneration == G and State.Trickshot.EBLPhase == 'SHOOTING' then
                State.Trickshot.ResetAutoEBL('READY')
            end end)
        return false
    end
    if Phase == 'FIRST_JUMP' or Phase == 'WAITING_FOR_LAND' then return true end
    if Phase == 'SHOOTING' then return false end
    State.Trickshot.EBLGeneration += 1
    local G = State.Trickshot.EBLGeneration
    State.Trickshot.EBLPhase, State.Trickshot.EBLStatus = 'FIRST_JUMP', 'FIRST JUMP - NO SHOT'
    State.Trickshot.ForceAutoRelease = false
    State.Lifecycle:Spawn(function()
        local T = os.clock() + 1.5
        while State.Active and CONFIG.AutoEBL and State.Trickshot.EBLGeneration == G
            and H and H.Parent and H.FloorMaterial ~= Enum.Material.Air and os.clock() < T do
            RunService.Heartbeat:Wait()
        end
        if not (State.Active and CONFIG.AutoEBL and State.Trickshot.EBLGeneration == G and H and H.Parent)
            or H.FloorMaterial ~= Enum.Material.Air then
            if State.Trickshot.EBLGeneration == G then State.Trickshot.ResetAutoEBL('READY') end
            return
        end
        State.Trickshot.EBLPhase, State.Trickshot.EBLStatus = 'WAITING_FOR_LAND', 'WAITING FOR LAND'
        T = os.clock() + 4
        while State.Active and CONFIG.AutoEBL and State.Trickshot.EBLGeneration == G
            and H and H.Parent and H.FloorMaterial == Enum.Material.Air and os.clock() < T do
            RunService.Heartbeat:Wait()
        end
        if not (State.Active and CONFIG.AutoEBL and State.Trickshot.EBLGeneration == G and H and H.Parent)
            or H.FloorMaterial == Enum.Material.Air then
            if State.Trickshot.EBLGeneration == G then State.Trickshot.ResetAutoEBL('READY') end
            return
        end
        State.Trickshot.EBLPhase, State.Trickshot.EBLStatus = 'SECOND_JUMP', 'LANDED - JUMPING NEXT FRAME'
        pcall(function() H.Jump = false end)
        RunService.Heartbeat:Wait()
        if not (State.Active and CONFIG.AutoEBL and State.Trickshot.EBLGeneration == G
            and State.Trickshot.EBLPhase == 'SECOND_JUMP' and H and H.Parent) then return end
        pcall(function() H.Jump = true;
            H:ChangeState(Enum.HumanoidStateType.Jumping) end)
    end)
    return true
end

