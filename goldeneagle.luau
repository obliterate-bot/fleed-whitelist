function State.Movement.ApplyJumpPower()
    if not State.Movement.JumpPowerEnabled then
        State.Movement.JumpBoostArmed = false
        return
    end
    local _, HumanoidObject, Root = State.Movement.GetRig()
    if not (HumanoidObject and Root) or HumanoidObject.Health <= 0 then return end

    local Jumping = HumanoidObject:GetState() == Enum.HumanoidStateType.Jumping
    if not Jumping then
        State.Movement.JumpBoostArmed = false
        return
    end
    if State.Movement.JumpBoostArmed then return end
    State.Movement.JumpBoostArmed = true

    local Value = math.clamp(tonumber(State.Movement.JumpPowerValue) or 75, 1, 300)
    local Method = State.Movement.JumpMethod or 'Assembly Linear Velocity'

    if Method == 'JumpPower Property' then

        pcall(function()
            if not HumanoidObject.UseJumpPower then HumanoidObject.UseJumpPower = true end
            HumanoidObject.JumpPower = Value
        end)
        return
    end

    if Method == 'JumpHeight Property' then

        pcall(function()
            if HumanoidObject.UseJumpPower then HumanoidObject.UseJumpPower = false end
            HumanoidObject.JumpHeight = Value
        end)
        return
    end

    if Method == 'ApplyImpulse' then

        local Extra = Value - 50
        if Extra <= 0 then return end
        pcall(function()
            Root:ApplyImpulse(Vector3.new(0, Root.AssemblyMass * Extra * 0.1, 0))
        end)
        return
    end

    local Extra = Value - 50
    if Extra <= 0 then return end
    local Velocity = Root.AssemblyLinearVelocity
    Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, Velocity.Y + Extra, Velocity.Z)
end

