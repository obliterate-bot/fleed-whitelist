pcall(function() if type(writefile) == 'function' then writefile('GoldenEagle_Crash.txt', '[STARTED] Linoria black-gold fixed UI chunk began execution.\n') end end)

pcall(function()
    if type(isfile) ~= 'function' or type(readfile) ~= 'function' or type(writefile) ~= 'function' then return end
    for _, Name in ipairs({ 'Release.json', 'Offense_Training.json', 'Personas.json', 'Interface.json', 'BallPresets.json', 'GoalEffectPresets.json', 'FakeSeason.json' }) do
        local Old, Fresh = 'SilverSurfer_' .. Name, 'GoldenEagle_' .. Name
        if isfile(Old) and not isfile(Fresh) then pcall(writefile, Fresh, readfile(Old)) end
    end
    if type(isfolder) == 'function' and type(makefolder) == 'function' and type(listfiles) == 'function' and isfolder('SilverSurfer_Configs') then
        if not isfolder('GoldenEagle_Configs') then makefolder('GoldenEagle_Configs') end
        for _, Path in ipairs(listfiles('SilverSurfer_Configs')) do
            local Leaf = string.match(tostring(Path), '([^/]+)$') or tostring(Path)
            Leaf = string.match(Leaf, '([^' .. string.char(92) .. ']+)$') or Leaf
            if string.sub(Leaf, -5) == '.json' and not isfile('GoldenEagle_Configs/' .. Leaf) then
                pcall(writefile, 'GoldenEagle_Configs/' .. Leaf, readfile(Path))
            end
        end
    end
end)

