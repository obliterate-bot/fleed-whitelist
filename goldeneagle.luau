State.LegitAimMinimumJerk = function(Progress)
    local T = math.clamp(Progress, 0, 1)
    return T * T * T * (10 + T * (6 * T - 15))
end

State.LegitAimSlerpDirection = function(From, To, Alpha)
    local A = From.Unit
    local B = To.Unit
    local T = math.clamp(Alpha, 0, 1)
    local Dot = math.clamp(A:Dot(B), -1, 1)
    if Dot > 0.9995 then
        local Linear = A + (B - A) * T
        return Linear.Magnitude > 0.0001 and Linear.Unit or B
    end
    if Dot < -0.9995 then
        local Basis = math.abs(A.Y) < 0.9 and Vector3.yAxis or Vector3.xAxis
        local Axis = A:Cross(Basis)
        if Axis.Magnitude <= 0.0001 then Axis = A:Cross(Vector3.zAxis) end
        Axis = Axis.Unit
        return (A * math.cos(math.pi * T) + Axis * math.sin(math.pi * T)).Unit
    end
    local Theta = math.acos(Dot)
    local SinTheta = math.sin(Theta)
    return (A * (math.sin((1 - T) * Theta) / SinTheta)
        + B * (math.sin(T * Theta) / SinTheta)).Unit
end

State.LegitAimSmoothDampAngle = function(Current, Target, Velocity, SmoothTime, MaxSpeed, DeltaTime, Unwrapped)
    local Dt = math.max(DeltaTime, 1 / 1000)
    local Smooth = math.max(SmoothTime, 0.01)
    local WrappedTarget = Target
    if not Unwrapped then
        local WrappedDelta = math.atan2(math.sin(Target - Current), math.cos(Target - Current))
        WrappedTarget = Current + WrappedDelta
    end
    local Omega = 2 / Smooth
    local X = Omega * Dt
    local Decay = 1 / (1 + X + 0.48 * X * X + 0.235 * X * X * X)
    local Change = Current - WrappedTarget
    local MaxChange = math.max(MaxSpeed, 0) * Smooth
    Change = math.clamp(Change, -MaxChange, MaxChange)
    local DampTarget = Current - Change
    local Temp = (Velocity + Omega * Change) * Dt
    local NewVelocity = (Velocity - Omega * Temp) * Decay
    local Output = DampTarget + (Change + Temp) * Decay
    local OriginalDelta = WrappedTarget - Current
    if (OriginalDelta > 0 and Output > WrappedTarget)
        or (OriginalDelta < 0 and Output < WrappedTarget) then
        Output = WrappedTarget
        NewVelocity = 0
    end
    return Output, NewVelocity
end

local GetLegitTweenTarget
GetLegitTweenTarget = WYNF_JIT_MAX(function()
    if not HumanoidRootPart then return nil end
    local Rim, Distance = FindConfiguredGoal()

    if not Rim then
        if CONFIG.AimTargetMode == 'Nearest Goal' then
            Rim, Distance = FindNearestGoalUnscoped()
        else
            Rim = FindPlayerScoringGoal(LP)
            if Rim then
                Distance = GetHorizontalDistance(HumanoidRootPart.Position, Rim.Position)
            else
                Rim, Distance = FindNearestGoalUnscoped()
            end
        end
    end
    if not Rim then return nil end

    local Power = State.PowerBypass.GetEffectivePower()

    local FormulaTarget = GetFormulaTarget(Rim, Power)
    if FormulaTarget then return FormulaTarget end

    local MaximumPower = tonumber(CONFIG.FormulaArcMaxPower) or 85
    if Power ~= MaximumPower then
        FormulaTarget = GetFormulaTarget(Rim, MaximumPower)
        if FormulaTarget then return FormulaTarget end
    end

    local Character = LP.Character
    local Head = Character and safe_find(Character, 'Head')
    if not Head then return nil end
    local Delta = Rim.Position - Head.Position
    local Flat = Vector3.new(Delta.X, 0, Delta.Z)
    if Flat.Magnitude <= 0.0001 then return nil end
    local BestAngle, BestError = math.rad(45), math.huge
    for Index = 0, 72 do
        local Angle = math.rad(2 + 76 * (Index / 72))
        local Height = EvaluateFormulaHeight(
            Angle, Flat.Magnitude, MaximumPower, Workspace.Gravity)
        local Error = math.abs(Height - Delta.Y)
        if Error < BestError then
            BestAngle, BestError = Angle, Error
        end
    end
    local Direction = Flat.Unit * math.cos(BestAngle)
    + Vector3.new(0, math.sin(BestAngle), 0)
    return Head.Position + Direction * 1000
end)

local function IsManualCameraAimActive()
