local IsGuardOpponent
IsGuardOpponent = WYNF_JIT_MAX(function(Player)
    if not Player or Player == LP then return false end

    local Now = os.clock()
    local Cached = PerfCache.GuardOpponent[Player]
    if Cached and Now - Cached.At < 0.2 then return Cached.Value end

    local Result
    local MyCourt, MySlotName, MySlot = ResolvePlayerCourt(LP)
    local TheirCourt, TheirSlotName, TheirSlot = ResolvePlayerCourt(Player)
    if MyCourt then
        if not TheirCourt or MyCourt ~= TheirCourt then
            Result = false
        end
        local MySide = ResolvePlayerCourtTeam(LP, MyCourt, MySlotName, MySlot)
        local TheirSide = ResolvePlayerCourtTeam(Player, TheirCourt, TheirSlotName, TheirSlot)
        if Result == nil and MySide and TheirSide then Result = MySide ~= TheirSide end
    end

    if Result == nil then
        if not LP.Neutral and not Player.Neutral and LP.Team and Player.Team then
            Result = LP.Team ~= Player.Team
        else
            Result = true
        end
    end
    PerfCache.GuardOpponent[Player] = { At = Now, Value = Result }
    return Result
end)

State.CourtContext = { Value = nil, UpdatedAt = 0 }
function State.CourtContext.Refresh()
    local Court, SlotName, Slot = ResolvePlayerCourt(LP)
    local Side = Court and ResolvePlayerCourtTeam(LP, Court, SlotName, Slot) or nil
    local Settings = Court and Court:FindFirstChild('_CourtSettings')
    local CurrentBallValue = Settings and Settings:FindFirstChild('CurrentBall')
    local CurrentBall = CurrentBallValue and CurrentBallValue.Value or nil
    if CurrentBall and not CurrentBall:IsA('BasePart') then CurrentBall = State.BallAssist and State.BallAssist.GetCanonicalBallPart(CurrentBall) or nil end
    local Teammates, Opponents = {}, {}
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LP then
            local TheirCourt, TheirSlotName, TheirSlot = ResolvePlayerCourt(Player)
            if not Court or TheirCourt == Court then
                local TheirSide = TheirCourt and ResolvePlayerCourtTeam(Player, TheirCourt, TheirSlotName, TheirSlot) or nil
                if Side and TheirSide and Side == TheirSide then table.insert(Teammates, Player) else table.insert(Opponents, Player) end
            end
        end
    end
    local Hitboxes = Court and (Court:FindFirstChild('Hitboxes') or Court:FindFirstChild('HitboxesHome') or Court:FindFirstChild('HitboxesAway'))
    State.CourtContext.Value = { Court=Court, SlotName=SlotName, Side=Side, Teammates=Teammates, Opponents=Opponents, ScoringRim=FindPlayerScoringGoal(LP), CurrentBall=CurrentBall, PaintHome=Court and Court:FindFirstChild('PaintHome', true), PaintAway=Court and Court:FindFirstChild('PaintAway', true), Paint=Court and Court:FindFirstChild('Paint', true), Center=Court and Court:FindFirstChild('Center', true), Hitboxes=Hitboxes }
    State.CourtContext.UpdatedAt = os.clock()
    return State.CourtContext.Value
end
function State.CourtContext.Get()
    if not State.CourtContext.Value or os.clock() - State.CourtContext.UpdatedAt > 0.15 then return State.CourtContext.Refresh() end
    return State.CourtContext.Value
end

