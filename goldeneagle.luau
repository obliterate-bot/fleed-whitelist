State.Lifecycle:Spawn(function()
    while State.Active do
        if State.AutoMix.Enabled then
            local Character = LP.Character
            local HumanoidObject = Character and safe_find(Character, 'Humanoid')
            local Root = Character and safe_find(Character, 'HumanoidRootPart')
            if not Character or not HumanoidObject or not Root or HumanoidObject.Health <= 0 then
                State.AutoMix.Status = 'WAITING FOR CHARACTER'
                State.AutoMix.LastThreat = nil
                State.AutoMix.ReleaseBodyControl()
            elseif not safe_find(Character, 'Basketball') then
                State.AutoMix.Status = 'WAITING FOR BALL'
                State.AutoMix.Generation += 1
                State.AutoMix.Busy = false
                State.AutoMix.StopSpin()
                State.AutoMix.StopMovement()
                State.AutoMix.LastThreat = nil
                State.AutoMix.ThreatSector = 'NONE'
                State.AutoMix.ReleaseBodyControl()
                State.AutoMix.Sequence = {}
            elseif UserInputService:GetFocusedTextBox() then
                State.AutoMix.Status = 'PAUSED FOR TYPING'
                State.AutoMix.BodyPauseUntil = os.clock() + 0.12
                State.AutoMix.StopMovement()
                State.AutoMix.ReleaseBodyControl()
            elseif State.AutoMix.IsShotBusy(Character, HumanoidObject, Root) then
                State.AutoMix.Status = 'PAUSED FOR SHOT'
                State.AutoMix.Plan = 'SHOT LOCK - NO DRIBBLE'
                State.AutoMix.Generation += 1
                State.AutoMix.Busy = false
                State.AutoMix.StopSpin()
                State.AutoMix.StopMovement()
                State.AutoMix.ReleaseBodyControl()
                State.AutoMix.Sequence = {}
                State.AutoMix.NextAt = os.clock() + 0.12
            elseif not CONFIG.AutoMixManualHandles and State.AutoMix.HasManualDribbleInput() then
                State.AutoMix.Status = 'MANUAL OVERRIDE'
                State.AutoMix.Generation += 1
                State.AutoMix.Busy = false
                State.AutoMix.StopSpin()
                State.AutoMix.StopMovement()
                State.AutoMix.BodyPauseUntil = os.clock() + 0.35
                State.AutoMix.ReleaseBodyControl()
                State.AutoMix.Sequence = {}
                State.AutoMix.NextAt = os.clock() + 0.35
            elseif State.PassInProgress
                or (State.AutoDunk and State.AutoDunk.InProgress) then
                State.AutoMix.Status = 'PAUSED FOR ACTION'
                State.AutoMix.Generation += 1
                State.AutoMix.Busy = false
                State.AutoMix.StopSpin()
                State.AutoMix.StopMovement()
                State.AutoMix.BodyPauseUntil = os.clock() + 0.12
                State.AutoMix.ReleaseBodyControl()
                State.AutoMix.Sequence = {}
            else
                State.AutoMix.AttachAnimator(Character, HumanoidObject)
                local Hand = State.AutoMix.ReadHand(Character, HumanoidObject, Root)
                local Mode = tostring(CONFIG.AutoMixMode or 'Smart Mix')
                if CONFIG.AutoMixManualHandles then
                    State.AutoMix.SetSequence({})
                    State.AutoMix.SelectSmartMove(Root, Hand)
                    if not State.AutoMix.Rotating then
                        State.AutoMix.Status = 'MANUAL HANDLES - F / G'
                    end
                    State.AutoMix.NextAt = os.clock() + 0.08
                else

                    if not State.AutoMix.Busy and os.clock() < State.AutoMix.NextAt then
                        local EmergencyThreat = State.AutoMix.ReadThreat(Root, Hand)
                        local EmergencyAction = EmergencyThreat
                            and select(1, State.AutoMix.ShouldSpendMove(EmergencyThreat))
                        if EmergencyThreat and EmergencyThreat.Level == 'EMERGENCY'
                            and EmergencyAction then
                            State.AutoMix.NextAt = os.clock()
                        end
                    end
                    if not State.AutoMix.Busy and os.clock() >= State.AutoMix.NextAt then
                        if Mode == 'Smart Mix' and State.AutoMix.Sequence[State.AutoMix.SequenceIndex] then
                            State.AutoMix.SetSequence({})
                        end
                        local Name = State.AutoMix.Sequence[State.AutoMix.SequenceIndex]
                        if Name then
                            State.AutoMix.SequenceIndex += 1
                            State.AutoMix.Perform(Name)
                        else
                            local NecessarySequence = State.AutoMix.SelectSmartMove(Root, Hand)
                            local Sequence = NecessarySequence
                            if NecessarySequence and Mode ~= 'Smart Mix' then
                                local Styled = State.AutoMix.BuildSpinSequence(Mode, Hand)
                                local Preferred = Styled and Styled[1]
                                local SmartName = NecessarySequence[1]
                                local PreferredScore = Preferred and State.AutoMix.MoveScores[Preferred]
                                local SmartScore = SmartName and State.AutoMix.MoveScores[SmartName]
                                local Allowed = Preferred and State.AutoMix.IsMoveAllowed(
                                    Preferred, Root, State.AutoMix.LastThreat)

                                if Allowed and PreferredScore and SmartScore
                                    and PreferredScore >= SmartScore - 0.60 then
                                    Sequence = { Preferred }
                                else
                                    Sequence = NecessarySequence
                                end
                            end
                            State.AutoMix.SetSequence(Sequence or {})
                            Name = State.AutoMix.Sequence[State.AutoMix.SequenceIndex]
                            if Name then
                                State.AutoMix.SequenceIndex += 1
                                State.AutoMix.Perform(Name)
                            elseif State.AutoMix.NextAt <= os.clock() then
                                State.AutoMix.NextAt = os.clock() + 0.12
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.01)
    end
end)

local GetClosestOffBallOpponent

State.AutoGuardAdaptive = State.AutoGuardAdaptive or {}

function State.AutoGuardAdaptive.GetOpponentDribbler()
    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    if not Root then return nil end

    local ClosestPlayer
    local ClosestDistance = math.huge
    for _, Player in ipairs(Players:GetPlayers()) do
        local TargetCharacter = Player.Character
        local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild('HumanoidRootPart')
        local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChild('Humanoid')
        if IsGuardOpponent(Player) and TargetRoot and TargetHumanoid
            and TargetHumanoid.Health > 0 and TargetCharacter:FindFirstChild('Basketball') then
            local Distance = (TargetRoot.Position - Root.Position).Magnitude
            if Distance < CONFIG.AutoGuardThreshold and Distance < ClosestDistance then
                ClosestDistance = Distance
                ClosestPlayer = Player
            end
        end
    end
    return ClosestPlayer
end

function State.AutoGuardAdaptive.ChooseDefensiveAssignment(BallHandler)
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local HandlerRoot = BallHandler and BallHandler.Character
        and safe_find(BallHandler.Character, 'HumanoidRootPart')
    local OffBallTarget = GetClosestOffBallOpponent()
    local OffBallRoot = OffBallTarget and OffBallTarget.Character
        and safe_find(OffBallTarget.Character, 'HumanoidRootPart')

    if not Root then return nil, 'DEFENSE | WAITING', 'Off-Ball Player' end
    if not HandlerRoot then
        return OffBallTarget, 'DEFENSE | OFF-BALL INTENT', 'Off-Ball Player'
    end
    if not OffBallRoot then
        return BallHandler, 'DEFENSE | ON-BALL INTENT', 'On-Ball Player'
    end

    local HandlerDistance = (HandlerRoot.Position - Root.Position).Magnitude
    local OffBallDistance = (OffBallRoot.Position - Root.Position).Magnitude
    local CloseEnoughForOnBall = HandlerDistance <= CONFIG.AutoGuardAdaptiveOnBallDistance
    local ClearlyLeaningOffBall = OffBallDistance + CONFIG.AutoGuardAdaptiveIntentSlack
    < HandlerDistance

    if CloseEnoughForOnBall and not ClearlyLeaningOffBall then
        return BallHandler, 'DEFENSE | ON-BALL INTENT', 'On-Ball Player'
    end
    return OffBallTarget, 'DEFENSE | OFF-BALL INTENT', 'Off-Ball Player'
end

function State.AutoGuardAdaptive.GetAdaptiveGuardTarget()
    local Court, MySlotName, MySlot = ResolvePlayerCourt(LP)
    local MyTeam = ResolvePlayerCourtTeam(LP, Court, MySlotName, MySlot)
    local CourtPlayers = Court and safe_find(Court, '_CourtPlayers')
    local BallHandler
    local BallHandlerTeam

    if CourtPlayers and MyTeam then
        for _, Slot in ipairs(CourtPlayers:GetChildren()) do
            local Player = safe_is_a(Slot, 'ObjectValue') and Slot.Value or nil
            if Player and safe_is_a(Player, 'Player') then
                local Character = Player.Character
                local PlayerHumanoid = Character and safe_find(Character, 'Humanoid')
                if Character and PlayerHumanoid and PlayerHumanoid.Health > 0
                    and safe_find(Character, 'Basketball') then
                    BallHandler = Player
                    BallHandlerTeam = ResolvePlayerCourtTeam(Player, Court, Slot.Name, Slot)
                    break
                end
            end
        end

        if not BallHandler then
            local Settings = safe_find(Court, '_CourtSettings')
            local CurrentBall = Settings and safe_find(Settings, 'CurrentBall')
            local BallValue = CurrentBall and CurrentBall.Value
            if typeof(BallValue) == 'Instance' then
                if BallValue:IsA('Player') then
                    BallHandler = BallValue
                else
                    BallHandler = Players:GetPlayerFromCharacter(BallValue)
                        or Players:GetPlayerFromCharacter(BallValue.Parent)
                end
                if BallHandler then
                    local _, HandlerSlotName, HandlerSlot = ResolvePlayerCourt(BallHandler)
                    BallHandlerTeam = ResolvePlayerCourtTeam(
                        BallHandler, Court, HandlerSlotName, HandlerSlot)
                end
            end
        end

        if BallHandler then
            if BallHandler == LP or BallHandlerTeam == MyTeam then
                return nil, 'OFFENSE', 'Off-Ball Player'
            end
            return State.AutoGuardAdaptive.ChooseDefensiveAssignment(BallHandler)
        end

        if CONFIG.AutoGuardBallCheckOnly then
            return nil, 'WAITING | NO BALL', 'Off-Ball Player'
        end
        return State.AutoGuardAdaptive.ChooseDefensiveAssignment(nil)
    end

    local MyCharacter = LP.Character
    if MyCharacter and MyCharacter:FindFirstChild('Basketball') then
        return nil, 'OFFENSE', 'Off-Ball Player'
    end
    for _, Player in ipairs(Players:GetPlayers()) do
        local Character = Player.Character
        local PlayerHumanoid = Character and Character:FindFirstChild('Humanoid')
        if Character and PlayerHumanoid and PlayerHumanoid.Health > 0
            and Character:FindFirstChild('Basketball') then
            if Player == LP or not IsGuardOpponent(Player) then
                return nil, 'OFFENSE', 'Off-Ball Player'
            end
        end
    end
    local OpponentBallHandler = State.AutoGuardAdaptive.GetOpponentDribbler()
    if CONFIG.AutoGuardBallCheckOnly and not OpponentBallHandler then
        return nil, 'WAITING | NO BALL', 'Off-Ball Player'
    end
    return State.AutoGuardAdaptive.ChooseDefensiveAssignment(OpponentBallHandler)
end

GetClosestOffBallOpponent = function()
    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    if not Root then return nil end

    local ClosestPlayer
    local ClosestDistance = math.huge
    for _, Player in ipairs(Players:GetPlayers()) do
        local TargetCharacter = Player.Character
        local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild('HumanoidRootPart')
        local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChild('Humanoid')
        if IsGuardOpponent(Player) and TargetRoot and TargetHumanoid
            and TargetHumanoid.Health > 0 and not TargetCharacter:FindFirstChild('Basketball') then
            local Distance = (TargetRoot.Position - Root.Position).Magnitude
            if Distance < CONFIG.AutoGuardThreshold and Distance < ClosestDistance then
                ClosestDistance = Distance
                ClosestPlayer = Player
            end
        end
    end
    return ClosestPlayer
end

local function GetNearestGuardPosition(Target)
    if not Target then return nil end
    local TargetCharacter = Target.Character
    local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild('HumanoidRootPart')
    local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChild('Humanoid')
    local MyRoot = LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
    if not TargetRoot or not TargetHumanoid or not MyRoot then return nil end

    local MoveDirection = TargetHumanoid.MoveDirection
    local Velocity = Vector3.new(
        TargetRoot.AssemblyLinearVelocity.X,
        0,
        TargetRoot.AssemblyLinearVelocity.Z
    )
    local Distance = (TargetRoot.Position - MyRoot.Position).Magnitude
    local TimeToReach = Distance / (TargetHumanoid.WalkSpeed + 10)
    local Predicted = TargetRoot.Position
    + (MoveDirection * TargetHumanoid.WalkSpeed * CONFIG.AutoGuardPrediction + Velocity * 0.5)
    * TimeToReach
    local Look = TargetRoot.CFrame.LookVector * Vector3.new(1, 0, 1)
    local Facing = MoveDirection.Magnitude > 0 and MoveDirection.Unit
        or (Look.Magnitude > 0 and Look.Unit or Vector3.new(0, 0, 1))
    local Offset = Facing * 2
    return Vector3.new(Predicted.X + Offset.X, TargetRoot.Position.Y, Predicted.Z + Offset.Z)
end

local function GetBallHandlerGuardPosition(Target)
    if not Target then return nil end
    if LP.Character and LP.Character:FindFirstChild('Basketball') then return nil end

    local TargetCharacter = Target.Character
    if not TargetCharacter then return nil end
    local Basketball = TargetCharacter:FindFirstChild('Basketball')
    local TargetBall = Basketball and Basketball:FindFirstChild('Ball')
    if not TargetBall then return nil end

    local TargetRoot = TargetCharacter:FindFirstChild('HumanoidRootPart')
    local TargetHumanoid = TargetCharacter:FindFirstChild('Humanoid')
    local MyRoot = LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
    local MyHumanoid = LP.Character and LP.Character:FindFirstChild('Humanoid')
    if not TargetRoot or not TargetHumanoid or not MyRoot or not MyHumanoid then return nil end

    local BallPosition = TargetBall.Position
    local Velocity = TargetRoot.AssemblyLinearVelocity
    local MoveDirection = TargetHumanoid.MoveDirection
    local Distance = (BallPosition - MyRoot.Position).Magnitude
    local TimeToReach = Distance / (MyHumanoid.WalkSpeed + 10)
    local PredictedMove = MoveDirection * TargetHumanoid.WalkSpeed * CONFIG.AutoGuardPrediction
    + Velocity * 0.5
    local InterceptPosition = TargetRoot.Position + PredictedMove * TimeToReach
    local Look = TargetRoot.CFrame.LookVector * Vector3.new(1, 0, 1)
    local Facing = MoveDirection.Magnitude > 0 and MoveDirection.Unit
        or (Look.Magnitude > 0 and Look.Unit or Vector3.new(0, 0, 1))
    local Offset = Facing * 2
    return Vector3.new(
        InterceptPosition.X + Offset.X,
        BallPosition.Y,
        InterceptPosition.Z + Offset.Z
    )
end

local function GetMirrorGuardPosition(Target)
    if not Target then return nil end
    local TargetCharacter = Target.Character
    local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild('HumanoidRootPart')
    local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChild('Humanoid')
    local MyRoot = LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
    if not TargetRoot or not TargetHumanoid or not MyRoot then return nil end

    local TargetPosition = TargetRoot.Position
    local Goal = FindPlayerScoringGoal(Target)
    local BlockDirection
    if Goal then
        local ToGoal = Vector3.new(
            Goal.Position.X - TargetPosition.X,
            0,
            Goal.Position.Z - TargetPosition.Z
        )
        if ToGoal.Magnitude > 0.01 then BlockDirection = ToGoal.Unit end
    end

    local MoveDirection = Vector3.new(
        TargetHumanoid.MoveDirection.X,
        0,
        TargetHumanoid.MoveDirection.Z
    )
    if not BlockDirection then
        local Look = TargetRoot.CFrame.LookVector * Vector3.new(1, 0, 1)
        BlockDirection = MoveDirection.Magnitude > 0.01 and MoveDirection.Unit
            or (Look.Magnitude > 0.01 and Look.Unit or Vector3.new(0, 0, 1))
    end

    local SideDirection = Vector3.new(-BlockDirection.Z, 0, BlockDirection.X)
    local Velocity = Vector3.new(
        TargetRoot.AssemblyLinearVelocity.X,
        0,
        TargetRoot.AssemblyLinearVelocity.Z
    )

    local LateralLead = math.clamp(
        Velocity:Dot(SideDirection) * 0.12
        + MoveDirection:Dot(SideDirection) * 1.15,
        -2.4,
        2.4
    )
    local ForwardLead = math.clamp(Velocity:Dot(BlockDirection) * 0.055, -0.35, 0.9)
    local Gap = 2.65 + ForwardLead
    local Desired = TargetPosition
    + BlockDirection * Gap
    + SideDirection * LateralLead
    return Vector3.new(Desired.X, TargetPosition.Y, Desired.Z)
end

State.AutoGuardStyles = State.AutoGuardStyles or {
    Legit = { Target = nil, Sample = nil, Display = nil, LastSampleAt = 0 },
}

function State.AutoGuardStyles.GetBasis(Target)
    if not (Target and Target.Character) then return nil end
    local TargetRoot = safe_find(Target.Character, 'HumanoidRootPart')
    local TargetHumanoid = safe_find(Target.Character, 'Humanoid')
    local MyRoot = LP.Character and safe_find(LP.Character, 'HumanoidRootPart')
    if not (TargetRoot and TargetHumanoid and MyRoot) then return nil end
    local TargetPosition = TargetRoot.Position
    local MoveDirection = Vector3.new(TargetHumanoid.MoveDirection.X, 0, TargetHumanoid.MoveDirection.Z)
    local Velocity = Vector3.new(TargetRoot.AssemblyLinearVelocity.X, 0, TargetRoot.AssemblyLinearVelocity.Z)
    local Goal = FindPlayerScoringGoal(Target)
    local BlockDirection
    if Goal then
        local ToGoal = Vector3.new(Goal.Position.X - TargetPosition.X, 0, Goal.Position.Z - TargetPosition.Z)
        if ToGoal.Magnitude > 0.01 then BlockDirection = ToGoal.Unit end
    end
    if not BlockDirection then
        local Look = Vector3.new(TargetRoot.CFrame.LookVector.X, 0, TargetRoot.CFrame.LookVector.Z)
        BlockDirection = MoveDirection.Magnitude > 0.01 and MoveDirection.Unit
            or (Look.Magnitude > 0.01 and Look.Unit or Vector3.new(0, 0, 1))
    end
    local SideDirection = Vector3.new(-BlockDirection.Z, 0, BlockDirection.X)
    return TargetRoot, TargetHumanoid, MyRoot, TargetPosition, BlockDirection, SideDirection, Velocity, MoveDirection
end

function State.AutoGuardStyles.Cutoff(Target)
    local TargetRoot, TargetHumanoid, MyRoot, TargetPosition, BlockDirection, SideDirection, Velocity, MoveDirection =
    State.AutoGuardStyles.GetBasis(Target)
    if not TargetRoot then return nil end
    local Travel = MoveDirection * TargetHumanoid.WalkSpeed + Velocity * 0.45
    local DriveDirection = Travel.Magnitude > 0.1 and Travel.Unit or BlockDirection
    local CutoffDirection = BlockDirection * 0.68 + DriveDirection * 0.32
    if CutoffDirection.Magnitude > 0.01 then CutoffDirection = CutoffDirection.Unit else CutoffDirection = BlockDirection end
    local Lead = math.clamp(tonumber(CONFIG.AutoGuardCutoffLead) or 0.24, 0.05, 0.65)
    local Predicted = TargetPosition + Travel * Lead
    local Gap = 2.35 + math.clamp(Velocity.Magnitude * 0.07, 0, 1.35)
    local LateralLead = math.clamp(Velocity:Dot(SideDirection) * 0.08, -1.4, 1.4)
    local Desired = Predicted + CutoffDirection * Gap + SideDirection * LateralLead
    return Vector3.new(Desired.X, TargetPosition.Y, Desired.Z)
end

function State.AutoGuardStyles.Smother(Target)
    local TargetRoot, TargetHumanoid, MyRoot, TargetPosition, BlockDirection, SideDirection, Velocity =
    State.AutoGuardStyles.GetBasis(Target)
    if not TargetRoot then return nil end
    local Gap = math.clamp(tonumber(CONFIG.AutoGuardSmotherGap) or 0.8, 0.25, 1.8)
    local Lateral = math.clamp(Velocity:Dot(SideDirection) * 0.035, -0.45, 0.45)
    local Desired = TargetPosition + BlockDirection * Gap + SideDirection * Lateral
    return Vector3.new(Desired.X, TargetPosition.Y, Desired.Z)
end

function State.AutoGuardStyles.Force(Target)
    local TargetRoot, TargetHumanoid, MyRoot, TargetPosition, BlockDirection, SideDirection, Velocity, MoveDirection =
    State.AutoGuardStyles.GetBasis(Target)
    if not TargetRoot then return nil end
    local Forward = Vector3.new(TargetRoot.CFrame.LookVector.X, 0, TargetRoot.CFrame.LookVector.Z)
    if Forward.Magnitude <= 0.01 then Forward = BlockDirection else Forward = Forward.Unit end
    local Right = Vector3.new(-Forward.Z, 0, Forward.X)
    local Mode = tostring(CONFIG.AutoGuardForceDirection or 'Any Direction')
    local ForcedDirection
    if Mode == 'Left' then
        ForcedDirection = -Right
    elseif Mode == 'Right' then
        ForcedDirection = Right
    elseif Mode == 'Forward' then
        ForcedDirection = Forward
    elseif Mode == 'Backward' then
        ForcedDirection = -Forward
    else
        local Motion = MoveDirection * TargetHumanoid.WalkSpeed + Velocity
        if Motion.Magnitude > 1 then
            ForcedDirection = Motion.Unit
        else
            local Pick = math.floor(os.clock() * 0.8) % 4
            ForcedDirection = Pick == 0 and Forward or (Pick == 1 and Right or (Pick == 2 and -Forward or -Right))
        end
    end
    local Offset = math.clamp(tonumber(CONFIG.AutoGuardForceOffset) or 2, 0.5, 4)
    local Desired = TargetPosition - ForcedDirection * Offset + BlockDirection * 0.65
    return Vector3.new(Desired.X, TargetPosition.Y, Desired.Z)
end

function State.AutoGuardStyles.LegitPosition(Target, DeltaTime)
    local Raw = GetNearestGuardPosition(Target)
    if not Raw then return nil end
    local Legit = State.AutoGuardStyles.Legit
    local Now = os.clock()
    local Delay = math.clamp(tonumber(CONFIG.AutoGuardLegitReactionDelay) or 0.12, 0.02, 0.5)
    if Legit.Target ~= Target then
        Legit.Target, Legit.Sample, Legit.Display = Target, Raw, Raw
        Legit.LastSampleAt = Now
    elseif Now - Legit.LastSampleAt >= Delay then
        Legit.Sample = Raw
        Legit.LastSampleAt = Now
    end
    Legit.Sample = Legit.Sample or Raw
    Legit.Display = Legit.Display or Legit.Sample
    local Smoothing = math.clamp(tonumber(CONFIG.AutoGuardLegitSmoothing) or 7, 1, 20)
    local Alpha = 1 - math.exp(-Smoothing * math.max(tonumber(DeltaTime) or 0.016, 0.001))
    Legit.Display = Legit.Display:Lerp(Legit.Sample, math.clamp(Alpha, 0.01, 1))
    return Legit.Display
end

function State.AutoGuardStyles.ApplyMovementPattern(GuardPosition, Target, LocalRoot)
    if not GuardPosition or tostring(CONFIG.AutoGuardMovementPattern or 'Direct') ~= 'Zigzag' then return GuardPosition end
    if not (Target and Target.Character and LocalRoot) then return GuardPosition end
    local TargetRoot = safe_find(Target.Character, 'HumanoidRootPart')
    local TargetHumanoid = safe_find(Target.Character, 'Humanoid')
    if not TargetRoot then return GuardPosition end
    local ToGuard = Vector3.new(GuardPosition.X - LocalRoot.Position.X, 0, GuardPosition.Z - LocalRoot.Position.Z)
    if ToGuard.Magnitude < 1.75 then return GuardPosition end
    local Travel = TargetHumanoid and Vector3.new(TargetHumanoid.MoveDirection.X, 0, TargetHumanoid.MoveDirection.Z) or Vector3.zero
    if Travel.Magnitude <= 0.05 then Travel = ToGuard.Unit else Travel = Travel.Unit end
    local Side = Vector3.new(-Travel.Z, 0, Travel.X)
    local Width = math.clamp(tonumber(CONFIG.AutoGuardZigzagWidth) or 1.6, 0.25, 4)
    local Speed = math.clamp(tonumber(CONFIG.AutoGuardZigzagSpeed) or 2.4, 0.25, 8)
    local Offset = math.sin(os.clock() * Speed * math.pi * 2) * Width
    return GuardPosition + Side * Offset
end

local function ApplyGuardDefenseRotation(LocalRoot, Target)
    if not (LocalRoot and LocalRoot.Parent and Target and Target.Character) then return end
    local Mode = tostring(CONFIG.AutoGuardDefenseMode or 'Normal')
    if Mode == 'Normal' then return end

    local TargetRoot = safe_find(Target.Character, 'HumanoidRootPart')
    if not TargetRoot then return end
    local Origin = LocalRoot.Position
    local Focus = TargetRoot.Position

    if Mode == 'Ball Defense' then
        local Basketball = safe_find(Target.Character, 'Basketball')
        local Ball = Basketball and (safe_find(Basketball, 'Ball') or Basketball:FindFirstChildWhichIsA('BasePart', true))
        if Ball then Focus = Ball.Position end
    end

    if Mode == 'Spin Defense' then
        local Speed = math.clamp(tonumber(CONFIG.AutoGuardDefenseSpinSpeed) or 540, 45, 1440)
        local Angle = math.rad((os.clock() * Speed) % 360)
        pcall(function()
            LocalRoot.CFrame = CFrame.new(Origin) * CFrame.Angles(0, Angle, 0)
            LocalRoot.AssemblyAngularVelocity = Vector3.zero
        end)
        return
    end

    local Direction = Vector3.new(Focus.X - Origin.X, 0, Focus.Z - Origin.Z)
    if Direction.Magnitude <= 0.001 then return end
    Direction = Direction.Unit
    if Mode == 'Backwards Defense' then
        Direction = -Direction
    elseif Mode == 'Jitter Defense' then
        local Speed = math.clamp(tonumber(CONFIG.AutoGuardDefenseJitterSpeed) or 14, 1, 40)
        local Angle = math.clamp(tonumber(CONFIG.AutoGuardDefenseJitterAngle) or 35, 5, 90)
        local Sign = math.floor(os.clock() * Speed) % 2 == 0 and -1 or 1
        Direction = CFrame.Angles(0, math.rad(Angle * Sign), 0):VectorToWorldSpace(Direction)
    elseif Mode == 'Zigzag Defense' then
        local Speed = math.clamp(tonumber(CONFIG.AutoGuardZigzagSpeed) or 2.4, 0.25, 8)
        local Angle = math.clamp(tonumber(CONFIG.AutoGuardDefenseJitterAngle) or 35, 5, 90)
        local Sweep = math.sin(os.clock() * Speed * math.pi * 2) * Angle
        Direction = CFrame.Angles(0, math.rad(Sweep), 0):VectorToWorldSpace(Direction)
    end

    pcall(function()
        LocalRoot.CFrame = CFrame.lookAt(Origin, Origin + Direction, Vector3.new(0, 1, 0))
        LocalRoot.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function UpdateAutoGuardBinding()
    pcall(function()
        State.Lifecycle:UnbindFromRenderStep(AUTO_GUARD_BIND_NAME)
    end)

    if not State.AutoGuardEnabled then
        if State.AutoHeadRide then
            State.AutoHeadRide.Target = nil
            State.AutoHeadRide.TargetDistance = math.huge
            State.AutoHeadRide.Mounted = false
            State.AutoHeadRide.Engaged = false
            State.AutoHeadRide.EngagedTarget = nil
            State.AutoHeadRide.Status =
            State.AutoHeadRide.Enabled and 'AUTO GUARD OFF' or 'OFF'
        end
        local GuardOwned = State.Runtime.MovementOwner == 'Guard'
        State.Runtime.ReleaseMovement('Guard')
        if GuardOwned then
            pcall(function()
                local Character = LP.Character
                local LocalHumanoid = Character and Character:FindFirstChild('Humanoid')
                if LocalHumanoid then LocalHumanoid:Move(Vector3.zero, false) end
            end)
        end
        return
    end

    local JumpTarget
    local TargetWasJumping = false
    State.Lifecycle:BindToRenderStep(
        AUTO_GUARD_BIND_NAME,
        Enum.RenderPriority.Input.Value + 1,
        WYNF_JIT(function(DeltaTime)
        local Character = LP.Character
        local LocalHumanoid = Character and Character:FindFirstChild('Humanoid')
        local LocalRoot = Character and Character:FindFirstChild('HumanoidRootPart')
        local LocalHasBall = Character and Character:FindFirstChild('Basketball') ~= nil
        if not LocalHumanoid or not LocalRoot or LocalHasBall then
            State.Runtime.ReleaseMovement('Guard')
            if LocalHasBall then State.AutoGuardAdaptiveState = 'PAUSED | LOCAL POSSESSION' end
            if State.AutoHeadRide then
                State.AutoHeadRide.Target = nil
                State.AutoHeadRide.TargetDistance = math.huge
                State.AutoHeadRide.Mounted = false
                State.AutoHeadRide.Engaged = false
                State.AutoHeadRide.EngagedTarget = nil
                State.AutoHeadRide.Status =
                State.AutoHeadRide.Enabled and 'WAITING FOR OFF-BALL' or 'OFF'
            end
            return
        end

        local Target = State.AutoGuardTarget
        local GuardPosition
        local EffectiveMode = State.AutoGuardEffectiveMode or State.AutoGuardMode
        local HeadRideOffBall = State.AutoHeadRide and State.AutoHeadRide.Enabled
            and EffectiveMode ~= 'On-Ball Player'
        if HeadRideOffBall
            and State.AutoHeadRide.StepOffBall(
            Target, LocalHumanoid, LocalRoot, DeltaTime) then
            return
        end
        if State.AutoHeadRide then
            State.AutoHeadRide.Target = Target
            State.AutoHeadRide.Mounted = false
            if EffectiveMode == 'On-Ball Player' then
                State.AutoHeadRide.Engaged = false
                State.AutoHeadRide.EngagedTarget = nil
                State.AutoHeadRide.Status =
                State.AutoHeadRide.Enabled and 'ON-BALL | NORMAL GUARD' or 'OFF'
            end
        end

        if not HeadRideOffBall and State.Runtime.HasManualInput(true) then State.Runtime.ReleaseMovement('Guard');
            return end

        if Target and Target.Character and Target.Character:FindFirstChild('HumanoidRootPart') then
            if Target ~= JumpTarget then
                JumpTarget = Target
                TargetWasJumping = false
            end

            local TargetHumanoid = Target.Character:FindFirstChild('Humanoid')
            local TargetRoot = Target.Character:FindFirstChild('HumanoidRootPart')
            local TargetState = TargetHumanoid and TargetHumanoid:GetState()
            local TargetIsJumping = TargetHumanoid and TargetRoot and (
                TargetState == Enum.HumanoidStateType.Jumping
                or (TargetState == Enum.HumanoidStateType.Freefall
                and TargetRoot.AssemblyLinearVelocity.Y > 0)
            ) or false
            if not CONFIG.AutoGuardNoJump
                and TargetIsJumping and not TargetWasJumping
                and LocalHumanoid.FloorMaterial ~= Enum.Material.Air then
                LocalHumanoid.Jump = true
            end
            TargetWasJumping = TargetIsJumping

            if State.AutoGuardStyle == 'Blatant Mirror' then
                GuardPosition = GetMirrorGuardPosition(Target)
            elseif State.AutoGuardStyle == 'Cutoff' then
                GuardPosition = State.AutoGuardStyles.Cutoff(Target)
            elseif State.AutoGuardStyle == 'Smother' then
                GuardPosition = State.AutoGuardStyles.Smother(Target)
            elseif State.AutoGuardStyle == 'Force Mode' then
                GuardPosition = State.AutoGuardStyles.Force(Target)
            elseif State.AutoGuardStyle == 'Legit' then
                GuardPosition = State.AutoGuardStyles.LegitPosition(Target, DeltaTime)
            elseif EffectiveMode ~= 'On-Ball Player' then
                GuardPosition = GetNearestGuardPosition(Target)
            elseif Target.Character:FindFirstChild('Basketball') then
                GuardPosition = GetBallHandlerGuardPosition(Target)
            end
            GuardPosition = State.AutoGuardStyles.ApplyMovementPattern(GuardPosition, Target, LocalRoot)
        else
            JumpTarget = nil
            TargetWasJumping = false
        end

        if GuardPosition then
            if State.Runtime.AcquireMovement('Guard') then
                local Difference = GuardPosition - LocalRoot.Position
                local Horizontal = Vector3.new(Difference.X, 0, Difference.Z)
                local StopDistance = State.AutoGuardStyle == 'Blatant Mirror' and 0.35
                    or (State.AutoGuardStyle == 'Smother' and 0.3
                    or (State.AutoGuardStyle == 'Legit' and 1.8
                    or ((State.AutoGuardStyle == 'Cutoff' or State.AutoGuardStyle == 'Force Mode') and 1.0 or 1.5)))
                local GuardMethod = State.Movement.AutoGuardMethod or 'MoveTo'
                if GuardMethod == 'CFrame Offset' then

                    if Horizontal.Magnitude > StopDistance then
                        pcall(function()
                            LocalRoot.CFrame = CFrame.new(GuardPosition) * (LocalRoot.CFrame - LocalRoot.Position)
                        end)
                    end
                elseif GuardMethod == 'Velocity Match' then

                    local TargetRoot = State.AutoGuardTarget
                        and State.AutoGuardTarget.Character
                        and safe_find(State.AutoGuardTarget.Character, 'HumanoidRootPart')
                    if TargetRoot and Horizontal.Magnitude > StopDistance then
                        pcall(function()
                            LocalRoot.AssemblyLinearVelocity = TargetRoot.AssemblyLinearVelocity
                        end)
                    end
                else

                    if Horizontal.Magnitude > StopDistance then
                        LocalHumanoid:Move(Horizontal.Unit, false)
                    else
                        LocalHumanoid:Move(Vector3.zero, false)
                    end
                end
            end
        elseif State.Runtime.MovementOwner == 'Guard' then
            State.Runtime.ReleaseMovement('Guard')
            LocalHumanoid:Move(Vector3.zero, false)
        end

        if Target then
            ApplyGuardDefenseRotation(LocalRoot, Target)
        end
    end)
    )
end

local function SetAutoGuardEnabled(Enabled, ShouldNotify)
    if not State.Active then return end
    Enabled = Enabled == true
    State.AutoGuardMode = 'Adaptive'
    State.AutoGuardEffectiveMode = 'Adaptive'
    CONFIG.AutoGuardMode = 'Adaptive'
    State.AutoGuardEnabled = Enabled
    CONFIG.AutoGuard = State.AutoGuardEnabled
    if State.AutoGuardEnabled and State.AutoGetOpenEnabled then
        State.AutoGetOpenEnabled = false
        CONFIG.AutoGetOpen = false
        State.AutoGetOpenTarget = nil
        State.AutoGetOpenRoute = 'Waiting'
        State.AutoGetOpenStatus = 'OFF'
        pcall(function() State.Lifecycle:UnbindFromRenderStep(AUTO_GET_OPEN_BIND_NAME) end)
    end
    if not State.AutoGuardEnabled then
        State.AutoGuardTarget = nil
        State.AutoGuardAdaptiveState = 'WAITING'
    end
    State.AutoGuardEffectiveMode = State.AutoGuardMode
    if State.AutoHeadRide and State.AutoHeadRide.Reset then
        State.AutoHeadRide.Reset(
            State.AutoHeadRide.Enabled and (State.AutoGuardEnabled
            and 'WAITING FOR OFF-BALL' or 'AUTO GUARD OFF') or 'OFF')
    end
    UpdateAutoGuardBinding()
    if HubUI.Sync then HubUI.Sync() end
end

State.AutoDefense = {
    Enabled = CONFIG.AutoDefense,
    SavedGuard = nil,
    SavedNoclip = nil,
}

function State.AutoDefense.SetEnabled(Enabled)
    Enabled = Enabled == true
    if Enabled == State.AutoDefense.Enabled then return end
    State.AutoDefense.Enabled = Enabled
    CONFIG.AutoDefense = Enabled

    if Enabled then
        State.AutoDefense.SavedGuard = State.AutoGuardEnabled
        State.AutoDefense.SavedNoclip = State.Movement.NoclipEnabled
        State.AutoGuardMode = 'Adaptive'
        State.AutoGuardStyle = 'Predictive'
        CONFIG.AutoGuardMode = State.AutoGuardMode
        CONFIG.AutoGuardStyle = State.AutoGuardStyle
        SetAutoGuardEnabled(true, false)
        if CONFIG.AutoDefenseNoclip then State.Movement.SetNoclip(true) end
    else
        if State.AutoDefense.SavedGuard == false then SetAutoGuardEnabled(false, false) end
        if State.AutoDefense.SavedNoclip == false then State.Movement.SetNoclip(false) end
        State.AutoDefense.SavedGuard = nil
        State.AutoDefense.SavedNoclip = nil
    end
    if HubUI.Sync then HubUI.Sync() end
end

local function ToggleAdaptiveGuard()
    State.AutoGuardMode = 'Adaptive'
    State.AutoGuardEffectiveMode = 'Adaptive'
    CONFIG.AutoGuardMode = 'Adaptive'
    State.AutoGuardTarget = nil
    SetAutoGuardEnabled(not State.AutoGuardEnabled, false)
end

State.Lifecycle:Spawn(function()
    while State.Active do
        if State.AutoGuardEnabled then
            local Ok, Target, AdaptiveState, EffectiveMode = pcall(function()
                State.AutoGuardMode = 'Adaptive'
                CONFIG.AutoGuardMode = 'Adaptive'
                return State.AutoGuardAdaptive.GetAdaptiveGuardTarget()
            end)
            State.AutoGuardTarget = Ok and Target or nil
            State.AutoGuardAdaptiveState = Ok and (AdaptiveState or 'WAITING') or 'ERROR'
            State.AutoGuardEffectiveMode = Ok and (EffectiveMode or State.AutoGuardMode)
                or State.AutoGuardMode
        else
            State.AutoGuardTarget = nil
            State.AutoGuardAdaptiveState = 'WAITING'
            State.AutoGuardEffectiveMode = State.AutoGuardMode
        end
        task.wait(0.10)
    end
end)

State.BotDefender = {
    BindName = 'GoldenEagle_1v1GhostBot',
    Enabled = CONFIG.BotEnabled == true,
    Model = nil,
    Root = nil,
    Humanoid = nil,
    Animator = nil,
    Highlight = nil,
    ShiftLockAttachment = nil,
    ShiftLockOrientation = nil,
    ShiftLockFacing = 'PLAYER',
    SourceCharacter = nil,
    Status = CONFIG.BotEnabled and 'STARTING' or 'OFF',
    Distance = math.huge,
    SampledPosition = nil,
    NextSampleAt = 0,
    CurrentMoveDirection = Vector3.zero,
    GroundY = nil,
    LastTargetJumping = false,
    ContestUntil = 0,
    NextBuildAt = 0,
    NextMoveToAt = 0,
    AnimationIds = {},
    AnimationObjects = {},
    AnimationTracks = {},
    ActiveTrackName = nil,
    RigLabel = 'R6',
    HumanStatus = 'HUMAN READS',
    NextHumanDecisionAt = 0,
    DecisionPrediction = CONFIG.BotPrediction,
    DecisionGapOffset = 0,
    MistakeLateral = 0,
    MistakeUntil = 0,
    CommittedDirection = Vector3.zero,
    CommitUntil = 0,
    StealUntil = 0,
    NextStealAt = 0,
    NextStealRollAt = 0,
    Stealing = false,
    LastError = nil,
}

do
    local BotDefender = State.BotDefender

    local ClassicR6Animations = {
        Idle = 'rbxassetid://180435571',
        Walk = 'rbxassetid://180426354',
        Run = 'rbxassetid://180426354',
        Jump = 'rbxassetid://125750702',
        Fall = 'rbxassetid://180436148',
    }

    local function FlatDirection(Vector, Fallback)
        local Flat = Vector3.new(Vector.X, 0, Vector.Z)
        if Flat.Magnitude > 0.001 then return Flat.Unit end
        Fallback = Fallback or Vector3.new(0, 0, 1)
        local FlatFallback = Vector3.new(Fallback.X, 0, Fallback.Z)
        return FlatFallback.Magnitude > 0.001 and FlatFallback.Unit or Vector3.new(0, 0, 1)
    end

    local function IsTorsoPart(Object)
        return Object.Name == 'Torso' or Object.Name == 'UpperTorso'
            or Object.Name == 'LowerTorso'
    end

    local function RandomCentered()
        return math.random() * 2 - 1
    end

    function BotDefender.UpdateHumanDecision(Now)
        local BasePrediction = tonumber(CONFIG.BotPrediction) or 0.16
        if CONFIG.BotHumanize == false then
            BotDefender.DecisionPrediction = BasePrediction
            BotDefender.DecisionGapOffset = 0
            BotDefender.MistakeLateral = 0
            BotDefender.MistakeUntil = 0
            BotDefender.NextHumanDecisionAt = Now
            BotDefender.HumanStatus = 'PERFECT READS'
            return
        end
        if Now < (BotDefender.NextHumanDecisionAt or 0) then
            if Now >= (BotDefender.MistakeUntil or 0) then
                BotDefender.MistakeLateral = 0
                if BotDefender.HumanStatus == 'WRONG STEP' then BotDefender.HumanStatus = 'READING HIPS' end
            end
            return
        end
        local Interval = math.clamp(tonumber(CONFIG.BotDecisionInterval) or 0.11, 0.02, 0.8)
        BotDefender.NextHumanDecisionAt = Now + Interval * (0.82 + math.random() * 0.36)
        local PredictionVariance = math.clamp(tonumber(CONFIG.BotPredictionVariance) or 0.07, 0, 1)
        local GapVariance = math.clamp(tonumber(CONFIG.BotGapVariance) or 0.18, 0, 3)
        BotDefender.DecisionPrediction = math.clamp(
            BasePrediction + RandomCentered() * PredictionVariance, -0.75, 1.5)
        BotDefender.DecisionGapOffset = RandomCentered() * GapVariance
        if Now >= (BotDefender.MistakeUntil or 0) then
            BotDefender.MistakeLateral = 0
            local Chance = math.clamp(tonumber(CONFIG.BotMistakeChance) or 6, 0, 60)
            if math.random() * 100 < Chance then
                local Distance = math.clamp(tonumber(CONFIG.BotMistakeDistance) or 1.15, 0, 5)
                BotDefender.MistakeLateral = (math.random(0, 1) == 0 and -1 or 1)
                * Distance * (0.70 + math.random() * 0.60)
                BotDefender.MistakeUntil = Now
                + math.clamp(tonumber(CONFIG.BotMistakeDuration) or 0.22, 0.05, 1)
                BotDefender.HumanStatus = 'WRONG STEP'
            else
                BotDefender.HumanStatus = 'READING HIPS'
            end
        end
    end

    function BotDefender.CreateShiftLock(Root)
        if BotDefender.ShiftLockOrientation then
            pcall(function() BotDefender.ShiftLockOrientation:Destroy() end)
        end
        if BotDefender.ShiftLockAttachment then
            pcall(function() BotDefender.ShiftLockAttachment:Destroy() end)
        end
        BotDefender.ShiftLockAttachment = nil
        BotDefender.ShiftLockOrientation = nil
        if not (Root and Root.Parent) then return false end
        local Attachment = Instance.new('Attachment')
        Attachment.Name = 'GoldenEagleBotShiftLockAttachment'
        Attachment.Parent = Root
        local Orientation = Instance.new('AlignOrientation')
        Orientation.Name = 'GoldenEagleBotShiftLock'
        Orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        Orientation.Attachment0 = Attachment
        Orientation.RigidityEnabled = false
        Orientation.ReactionTorqueEnabled = false
        Orientation.PrimaryAxisOnly = false
        Orientation.MaxTorque = 1000000
        Orientation.MaxAngularVelocity = math.rad(
            math.clamp(tonumber(CONFIG.BotShiftLockTurnSpeed) or 720, 90, 1440))
        Orientation.Responsiveness = math.clamp(
            tonumber(CONFIG.BotShiftLockResponsiveness) or 18, 1, 60)
        Orientation.Enabled = false
        Orientation.Parent = Root
        BotDefender.ShiftLockAttachment = Attachment
        BotDefender.ShiftLockOrientation = Orientation
        return true
    end

    function BotDefender.ApplyDefensiveShiftLock(TargetRoot)
        local HumanoidObject = BotDefender.Humanoid
        local Root = BotDefender.Root
        if not (HumanoidObject and Root and TargetRoot) then return end
        if CONFIG.BotShiftLock == false then
            HumanoidObject.AutoRotate = true
            if BotDefender.ShiftLockOrientation then BotDefender.ShiftLockOrientation.Enabled = false end
            BotDefender.ShiftLockFacing = 'OFF'
            return
        end
        if not (BotDefender.ShiftLockOrientation and BotDefender.ShiftLockOrientation.Parent == Root) then
            BotDefender.CreateShiftLock(Root)
        end
        local Orientation = BotDefender.ShiftLockOrientation
        if not Orientation then return end
        HumanoidObject.AutoRotate = false
        Orientation.Enabled = true
        Orientation.Responsiveness = math.clamp(
            tonumber(CONFIG.BotShiftLockResponsiveness) or 18, 1, 60)
        Orientation.MaxAngularVelocity = math.rad(
            math.clamp(tonumber(CONFIG.BotShiftLockTurnSpeed) or 720, 90, 1440))
        local Mode = tostring(CONFIG.BotShiftLockTarget or 'Player')
        local Focus = TargetRoot.Position
        local Lead = math.clamp(tonumber(CONFIG.BotFacingLead) or 0.06, -0.5, 1.5)
        if Mode == 'Ball' then
            local Ball = GetLocalBallHandle()
            if Ball then Focus = Ball.Position else Mode = 'Player' end
        elseif Mode == 'Movement' then
            Focus = TargetRoot.Position + TargetRoot.AssemblyLinearVelocity * Lead
        else
            Focus = TargetRoot.Position
        end
        local Direction = FlatDirection(Focus - Root.Position, TargetRoot.CFrame.LookVector)
        Orientation.CFrame = CFrame.lookAt(Vector3.zero, Direction, Vector3.new(0, 1, 0))
        BotDefender.ShiftLockFacing = string.upper(Mode)
    end

    function BotDefender.ReadNaturalAnimationIds(Character)
        local Result = {}
        local Animate = Character and safe_find(Character, 'Animate')
        if Animate then
            for _, Object in ipairs(Animate:GetDescendants()) do
                if Object:IsA('Animation') and tostring(Object.AnimationId or '') ~= '' then
                    local ParentName = Object.Parent and Object.Parent.Name or ''
                    local Context = string.lower(Object.Name .. ' ' .. ParentName)
                    local Key
                    if string.find(Context, 'idle', 1, true) then Key = 'Idle'
                    elseif string.find(Context, 'walk', 1, true) then Key = 'Walk'
                    elseif string.find(Context, 'run', 1, true) then Key = 'Run'
                    elseif string.find(Context, 'jump', 1, true) then Key = 'Jump'
                    elseif string.find(Context, 'fall', 1, true) then Key = 'Fall' end
                    if Key and not Result[Key] then Result[Key] = Object.AnimationId end
                end
            end
        end
        for Key, Fallback in pairs(ClassicR6Animations) do
            if not Result[Key] or Result[Key] == '' then Result[Key] = Fallback end
        end
        if not Result.Run then Result.Run = Result.Walk end
        return Result
    end

    function BotDefender.StopNaturalAnimations()
        for _, Track in pairs(BotDefender.AnimationTracks or {}) do
            pcall(function() Track:Stop(0.08) end)
        end
        for _, Animation in pairs(BotDefender.AnimationObjects or {}) do
            pcall(function() Animation:Destroy() end)
        end
        BotDefender.AnimationObjects = {}
        BotDefender.AnimationTracks = {}
        BotDefender.ActiveTrackName = nil
    end

    function BotDefender.LoadNaturalAnimations()
        BotDefender.StopNaturalAnimations()
        local HumanoidObject = BotDefender.Humanoid
        if not HumanoidObject then return false end
        local Animator = HumanoidObject:FindFirstChildOfClass('Animator')
        if not Animator then
            Animator = Instance.new('Animator')
            Animator.Parent = HumanoidObject
        end
        BotDefender.Animator = Animator
        local Priorities = {
            Idle = Enum.AnimationPriority.Idle,
            Walk = Enum.AnimationPriority.Movement,
            Run = Enum.AnimationPriority.Movement,
            Jump = Enum.AnimationPriority.Action,
            Fall = Enum.AnimationPriority.Action,
        }
        for Name, AnimationId in pairs(BotDefender.AnimationIds or {}) do
            local Animation = Instance.new('Animation')
            Animation.Name = 'GoldenEagleNaturalR6_' .. Name
            Animation.AnimationId = tostring(AnimationId)
            local Loaded, Track = pcall(Animator.LoadAnimation, Animator, Animation)
            if Loaded and Track then
                Track.Priority = Priorities[Name] or Enum.AnimationPriority.Movement
                Track.Looped = Name == 'Idle' or Name == 'Walk' or Name == 'Run' or Name == 'Fall'
                BotDefender.AnimationObjects[Name] = Animation
                BotDefender.AnimationTracks[Name] = Track
            else
                Animation:Destroy()
            end
        end
        return next(BotDefender.AnimationTracks) ~= nil
    end

    function BotDefender.PlayNaturalAnimation(Name, Speed)
        local Track = BotDefender.AnimationTracks and BotDefender.AnimationTracks[Name]
        if not Track then return end
        if BotDefender.ActiveTrackName ~= Name then
            for OtherName, OtherTrack in pairs(BotDefender.AnimationTracks) do
                if OtherName ~= Name then pcall(function() OtherTrack:Stop(0.12) end) end
            end
            pcall(function() Track:Play(0.12, 1, Speed or 1) end)
            BotDefender.ActiveTrackName = Name
        elseif Speed then
            pcall(function() Track:AdjustSpeed(Speed) end)
        end
    end

    function BotDefender.UpdateNaturalAnimation()
        local HumanoidObject = BotDefender.Humanoid
        local Root = BotDefender.Root
        if not (HumanoidObject and Root) then return end
        local StateType = HumanoidObject:GetState()
        local HorizontalSpeed = Vector3.new(
            Root.AssemblyLinearVelocity.X, 0, Root.AssemblyLinearVelocity.Z).Magnitude
        if StateType == Enum.HumanoidStateType.Jumping then
            BotDefender.PlayNaturalAnimation('Jump', 1)
        elseif StateType == Enum.HumanoidStateType.Freefall then
            BotDefender.PlayNaturalAnimation('Fall', 1)
        elseif HorizontalSpeed > 0.65 or HumanoidObject.MoveDirection.Magnitude > 0.05 then
            local WalkSpeed = math.max(tonumber(HumanoidObject.WalkSpeed) or 16, 1)
            local Name = WalkSpeed > 18 and 'Run' or 'Walk'
            BotDefender.PlayNaturalAnimation(Name, math.clamp(WalkSpeed / 16, 0.55, 2.25))
        else
            BotDefender.PlayNaturalAnimation('Idle', 1)
        end
    end

    function BotDefender.Destroy(Status)
        BotDefender.StopNaturalAnimations()
        if BotDefender.ShiftLockOrientation then pcall(function() BotDefender.ShiftLockOrientation:Destroy() end) end
        if BotDefender.ShiftLockAttachment then pcall(function() BotDefender.ShiftLockAttachment:Destroy() end) end
        if BotDefender.Humanoid then
            pcall(function() BotDefender.Humanoid:Move(Vector3.zero, false) end)
        end
        if BotDefender.Model then pcall(function() BotDefender.Model:Destroy() end) end
        BotDefender.Model = nil
        BotDefender.Root = nil
        BotDefender.Humanoid = nil
        BotDefender.Animator = nil
        BotDefender.Highlight = nil
        BotDefender.ShiftLockAttachment = nil
        BotDefender.ShiftLockOrientation = nil
        BotDefender.ShiftLockFacing = 'OFF'
        BotDefender.SourceCharacter = nil
        BotDefender.SampledPosition = nil
        BotDefender.NextSampleAt = 0
        BotDefender.CurrentMoveDirection = Vector3.zero
        BotDefender.GroundY = nil
        BotDefender.LastTargetJumping = false
        BotDefender.ContestUntil = 0
        BotDefender.NextMoveToAt = 0
        BotDefender.Distance = math.huge
        BotDefender.NextHumanDecisionAt = 0
        BotDefender.DecisionPrediction = CONFIG.BotPrediction
        BotDefender.DecisionGapOffset = 0
        BotDefender.MistakeLateral = 0
        BotDefender.MistakeUntil = 0
        BotDefender.CommittedDirection = Vector3.zero
        BotDefender.CommitUntil = 0
        BotDefender.StealUntil = 0
        BotDefender.NextStealAt = 0
        BotDefender.Stealing = false
        if Status then BotDefender.Status = Status end
    end

    function BotDefender.ApplyAppearance()
        local Model = BotDefender.Model
        if not Model then return end
        if BotDefender.Highlight then
            BotDefender.Highlight.Enabled = CONFIG.BotHighlight ~= false
        end
        for _, Object in ipairs(Model:GetDescendants()) do
            if Object:IsA('BasePart') then
                Object.LocalTransparencyModifier = 0
                Object.Anchored = false
                Object.CanTouch = false
                Object.CanQuery = false
                if Object.Name == 'HumanoidRootPart' then
                    Object.CanCollide = false
                elseif CONFIG.BotSolid ~= false then
                    local NaturalCollision = Object:GetAttribute('GoldenEagleNaturalCollision')
                    Object.CanCollide = NaturalCollision == true or IsTorsoPart(Object)
                else

                    Object.CanCollide = IsTorsoPart(Object)
                end
            end
        end
    end

    function BotDefender.Build()
        if os.clock() < (BotDefender.NextBuildAt or 0) then return false end
        BotDefender.NextBuildAt = os.clock() + 0.75
        BotDefender.Destroy('BUILDING')

        local Character = LP.Character
        local TargetRoot = Character and safe_find(Character, 'HumanoidRootPart')
        local TargetHumanoid = Character and Character:FindFirstChildOfClass('Humanoid')
        if not (Character and TargetRoot and TargetHumanoid and TargetHumanoid.Health > 0) then
            BotDefender.Status = 'WAITING FOR CHARACTER'
            return false
        end

        BotDefender.AnimationIds = BotDefender.ReadNaturalAnimationIds(Character)
        local Clone = State.GhostReplay.CloneCompleteInstance(Character)
        if not Clone then
            BotDefender.Status = 'CLONE FAILED'
            return false
        end
        Clone.Name = 'GoldenEagle1v1R6Bot'

        for _, Child in ipairs(Clone:GetChildren()) do
            if Child.Name == 'Basketball' or Child:IsA('Tool') or Child:IsA('ForceField') then
                Child:Destroy()
            end
        end

        local CloneRoot = safe_find(Clone, 'HumanoidRootPart')
        local CloneHumanoid = Clone:FindFirstChildOfClass('Humanoid')
        if not (CloneRoot and CloneRoot:IsA('BasePart') and CloneHumanoid) then
            Clone:Destroy()
            BotDefender.Status = 'R6 HUMANOID RIG MISSING'
            return false
        end

        for _, Object in ipairs(Clone:GetDescendants()) do
            if not Object.Parent then

            elseif Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
                or Object:IsA('Sound') or Object:IsA('BillboardGui') or Object:IsA('SurfaceGui')
                or Object:IsA('ProximityPrompt') then
                Object:Destroy()
            elseif Object:IsA('BodyMover') or Object:IsA('LinearVelocity')
                or Object:IsA('AngularVelocity') or Object:IsA('AlignPosition')
                or Object:IsA('AlignOrientation') or Object:IsA('VectorForce') then
                Object:Destroy()
            elseif Object:IsA('BasePart') then
                Object:SetAttribute('GoldenEagleNaturalCollision', Object.CanCollide)
                Object.Anchored = false
                Object.CanTouch = false
                Object.CanQuery = false
                Object.Massless = Object ~= CloneRoot
                Object.AssemblyLinearVelocity = Vector3.zero
                Object.AssemblyAngularVelocity = Vector3.zero
                Object.LocalTransparencyModifier = 0
            end
        end

        CloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        CloneHumanoid.NameDisplayDistance = 0
        CloneHumanoid.HealthDisplayDistance = 0
        CloneHumanoid.AutoRotate = true
        CloneHumanoid.PlatformStand = false
        CloneHumanoid.BreakJointsOnDeath = false
        CloneHumanoid.WalkSpeed = 16 
        CloneHumanoid.Health = math.max(CloneHumanoid.Health, 100)
        BotDefender.RigLabel = CloneHumanoid.RigType == Enum.HumanoidRigType.R6 and 'R6' or 'R15 FALLBACK'

        pcall(function() Clone.PrimaryPart = CloneRoot end)
        Clone.Parent = Workspace

        local Highlight = Instance.new('Highlight')
        Highlight.Name = 'GoldenEagleBotHighlight'
        Highlight.Adornee = Clone
        Highlight.DepthMode = Enum.HighlightDepthMode.Occluded
        Highlight.FillColor = Color3.fromRGB(226, 179, 65)
        Highlight.FillTransparency = 1
        Highlight.OutlineColor = Color3.fromRGB(255, 233, 168)
        Highlight.OutlineTransparency = 0.18
        Highlight.Enabled = CONFIG.BotHighlight ~= false
        Highlight.Parent = Clone

        local Adornee = safe_find(Clone, 'Head') or CloneRoot
        local Tag = Instance.new('BillboardGui')
        Tag.Name = 'GoldenEagleBotTag'
        Tag.Adornee = Adornee
        Tag.AlwaysOnTop = true
        Tag.Size = UDim2.fromOffset(104, 20)
        Tag.StudsOffsetWorldSpace = Vector3.new(0, 2.65, 0)
        Tag.Parent = Clone
        local TagText = Instance.new('TextLabel')
        TagText.Size = UDim2.fromScale(1, 1)
        TagText.BackgroundTransparency = 1
        TagText.Font = Enum.Font.Code
        TagText.Text = '1V1  R6 BOT'
        TagText.TextColor3 = Color3.fromRGB(235, 241, 248)
        TagText.TextStrokeColor3 = Color3.new(0, 0, 0)
        TagText.TextStrokeTransparency = 0.25
        TagText.TextSize = 12
        TagText.Parent = Tag

        local Goal = FindPlayerScoringGoal(LP)
        local BlockDirection = FlatDirection(TargetRoot.CFrame.LookVector)
        if Goal then
            BlockDirection = FlatDirection(Goal.Position - TargetRoot.Position, BlockDirection)
        end
        local Gap = math.clamp(tonumber(CONFIG.BotGuardGap) or 2.8, 1.8, 12)
        local SpawnPosition = TargetRoot.Position + BlockDirection * Gap
        local SpawnCFrame = CFrame.lookAt(SpawnPosition, TargetRoot.Position, Vector3.new(0, 1, 0))
        Clone:PivotTo(SpawnCFrame)

        BotDefender.Model = Clone
        BotDefender.Root = CloneRoot
        BotDefender.Humanoid = CloneHumanoid
        BotDefender.Highlight = Highlight
        BotDefender.SourceCharacter = Character
        BotDefender.SampledPosition = SpawnPosition
        BotDefender.GroundY = TargetRoot.Position.Y
        BotDefender.NextSampleAt = 0
        BotDefender.NextMoveToAt = 0
        BotDefender.CurrentMoveDirection = Vector3.zero
        BotDefender.NextHumanDecisionAt = 0
        BotDefender.DecisionPrediction = CONFIG.BotPrediction
        BotDefender.DecisionGapOffset = 0
        BotDefender.MistakeLateral = 0
        BotDefender.MistakeUntil = 0
        BotDefender.CommittedDirection = Vector3.zero
        BotDefender.CommitUntil = 0
        BotDefender.CreateShiftLock(CloneRoot)
        BotDefender.Status = 'SHIFTLOCK ' .. BotDefender.RigLabel .. ' READY'
        BotDefender.LastError = nil
        BotDefender.ApplyAppearance()
        BotDefender.LoadNaturalAnimations()
        pcall(function()
            CloneHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            CloneHumanoid:Move(Vector3.zero, false)
        end)
        return true
    end

    function BotDefender.GetDesiredPosition(TargetRoot, TargetHumanoid)
        local TargetPosition = TargetRoot.Position
        local TargetLook = FlatDirection(TargetRoot.CFrame.LookVector)
        local Goal = FindPlayerScoringGoal(LP)
        local BlockDirection = Goal
            and FlatDirection(Goal.Position - TargetPosition, TargetLook)
            or TargetLook
        local SideDirection = Vector3.new(-BlockDirection.Z, 0, BlockDirection.X)
        local TargetRight = FlatDirection(TargetRoot.CFrame.RightVector, SideDirection)
        local Velocity = Vector3.new(
            TargetRoot.AssemblyLinearVelocity.X, 0, TargetRoot.AssemblyLinearVelocity.Z)
        if Velocity.Magnitude > 100 then Velocity = Velocity.Unit * 100 end
        local MoveDirection = Vector3.new(
            TargetHumanoid.MoveDirection.X, 0, TargetHumanoid.MoveDirection.Z)
        local Motion = Velocity.Magnitude > 0.75 and Velocity
            or (MoveDirection * math.max(tonumber(TargetHumanoid.WalkSpeed) or 16, 1))

        if TargetHumanoid.FloorMaterial ~= Enum.Material.Air
            and math.abs(TargetRoot.AssemblyLinearVelocity.Y) < 4 then
            BotDefender.GroundY = TargetPosition.Y
        end
        BotDefender.GroundY = BotDefender.GroundY or TargetPosition.Y

        local Gap = math.clamp((tonumber(CONFIG.BotGuardGap) or 2.8)
            + (tonumber(BotDefender.DecisionGapOffset) or 0), 1.8, 12)
        local Prediction = math.clamp(tonumber(BotDefender.DecisionPrediction)
            or tonumber(CONFIG.BotPrediction) or 0.16, -0.75, 1.5)
        local LateralLead = math.clamp(tonumber(CONFIG.BotLateralLead) or 0.10, -1, 1.5)
        local Style = tostring(CONFIG.BotStyle or 'Predictive')
        local Predicted = TargetPosition + Motion * Prediction
        local Lateral = math.clamp(Motion:Dot(SideDirection) * LateralLead, -4, 4)
        local Desired

        if Style == 'Mirror' then
            Desired = TargetPosition + BlockDirection * Gap + SideDirection * Lateral
        elseif Style == 'Cutoff' then
            local DriveDirection = Motion.Magnitude > 0.1 and Motion.Unit or BlockDirection
            local CutDirection = BlockDirection * 0.55 + DriveDirection * 0.45
            CutDirection = CutDirection.Magnitude > 0.01 and CutDirection.Unit or BlockDirection
            Desired = Predicted + CutDirection * (Gap + math.clamp(Motion.Magnitude * 0.035, 0, 1.1))
            + SideDirection * Lateral
        elseif Style == 'Smother' then
            Desired = TargetPosition + BlockDirection * math.min(Gap, 1.15)
            + SideDirection * math.clamp(Lateral, -0.55, 0.55)
        elseif Style == 'Force Left' then
            local Offset = math.clamp(tonumber(CONFIG.BotForceOffset) or 1.8, 0, 8)
            Desired = Predicted + BlockDirection * (Gap * 0.62) + TargetRight * Offset
        elseif Style == 'Force Right' then
            local Offset = math.clamp(tonumber(CONFIG.BotForceOffset) or 1.8, 0, 8)
            Desired = Predicted + BlockDirection * (Gap * 0.62) - TargetRight * Offset
        elseif Style == 'Legit' then
            local LegitPrediction = math.min(Prediction, 0.14)
            Desired = TargetPosition + Motion * LegitPrediction + BlockDirection * Gap
            + SideDirection * math.clamp(Lateral * 0.55, -1.1, 1.1)
        else
            Desired = Predicted + BlockDirection * Gap + SideDirection * Lateral
        end

        if tostring(CONFIG.BotMovementPattern or 'Direct') == 'Zigzag' then
            local Width = math.clamp(tonumber(CONFIG.BotZigzagWidth) or 1.25, 0, 8)
            local Speed = math.clamp(tonumber(CONFIG.BotZigzagSpeed) or 2.25, 0.05, 15)
            Desired += SideDirection * math.sin(os.clock() * Speed * math.pi * 2) * Width
        end
        if CONFIG.BotHumanize ~= false and os.clock() < (BotDefender.MistakeUntil or 0) then
            Desired += SideDirection * (tonumber(BotDefender.MistakeLateral) or 0)
        end
        return Vector3.new(Desired.X, BotDefender.GroundY, Desired.Z)
    end

    function BotDefender.Reset()
        if not BotDefender.Enabled then
            BotDefender.Status = 'ENABLE BOT FIRST'
            return false
        end
        if not (BotDefender.Model and BotDefender.Root and BotDefender.Humanoid) then
            return BotDefender.Build()
        end
        local Character = LP.Character
        local TargetRoot = Character and safe_find(Character, 'HumanoidRootPart')
        local TargetHumanoid = Character and Character:FindFirstChildOfClass('Humanoid')
        if not (TargetRoot and TargetHumanoid) then return false end
        local Desired = BotDefender.GetDesiredPosition(TargetRoot, TargetHumanoid)
        local Facing = FlatDirection(TargetRoot.Position - Desired, TargetRoot.CFrame.LookVector)
        BotDefender.Model:PivotTo(CFrame.lookAt(Desired, Desired + Facing, Vector3.new(0, 1, 0)))
        for _, Object in ipairs(BotDefender.Model:GetDescendants()) do
            if Object:IsA('BasePart') then
                Object.AssemblyLinearVelocity = Vector3.zero
                Object.AssemblyAngularVelocity = Vector3.zero
            end
        end
        BotDefender.Humanoid:Move(Vector3.zero, false)
        BotDefender.SampledPosition = Desired
        BotDefender.CurrentMoveDirection = Vector3.zero
        BotDefender.CommittedDirection = Vector3.zero
        BotDefender.CommitUntil = 0
        BotDefender.NextHumanDecisionAt = 0
        BotDefender.NextSampleAt = 0
        BotDefender.NextMoveToAt = 0
        BotDefender.StealUntil = 0
        BotDefender.NextStealAt = 0
        BotDefender.Stealing = false
        BotDefender.Status = 'RESET | HUMAN SHIFTLOCK ' .. BotDefender.RigLabel
        return true
    end

    function BotDefender.Step(DeltaTime)
        if not (State.Active and BotDefender.Enabled) then return end
        local Character = LP.Character
        local TargetRoot = Character and safe_find(Character, 'HumanoidRootPart')
        local TargetHumanoid = Character and Character:FindFirstChildOfClass('Humanoid')
        if not (TargetRoot and TargetHumanoid and TargetHumanoid.Health > 0) then
            BotDefender.Status = 'WAITING FOR CHARACTER'
            return
        end
        if not (BotDefender.Model and BotDefender.Model.Parent
            and BotDefender.Root and BotDefender.Root.Parent
            and BotDefender.Humanoid and BotDefender.Humanoid.Health > 0
            and BotDefender.SourceCharacter == Character) then
            BotDefender.Build()
            return
        end

        local BotRoot = BotDefender.Root
        local BotHumanoid = BotDefender.Humanoid
        local Now = os.clock()
        BotDefender.UpdateHumanDecision(Now)
        local Desired = BotDefender.GetDesiredPosition(TargetRoot, TargetHumanoid)
        local Reaction = math.clamp(tonumber(CONFIG.BotReactionDelay) or 0.12, 0, 1)
        if not BotDefender.SampledPosition or Now >= BotDefender.NextSampleAt then
            BotDefender.SampledPosition = Desired
            BotDefender.NextSampleAt = Now + Reaction
        end
        local Sample = BotDefender.SampledPosition or Desired

        local Stealing = false
        local StealBall = GetLocalBallHandle()
        if CONFIG.BotStealAttempts ~= false and StealBall then
            if Now < (BotDefender.StealUntil or 0) then
                Stealing = true
            elseif Now >= (BotDefender.NextStealAt or 0)
                and Now >= (BotDefender.NextStealRollAt or 0) then
                BotDefender.NextStealRollAt = Now + 0.15
                local StealRange = math.clamp(tonumber(CONFIG.BotStealRange) or 3.2, 0, 8)
                local StealChance = math.clamp(tonumber(CONFIG.BotStealChance) or 10, 0, 100)
                local BallFlat = Vector3.new(StealBall.Position.X, 0, StealBall.Position.Z)
                local BotFlat = Vector3.new(BotRoot.Position.X, 0, BotRoot.Position.Z)
                if (BallFlat - BotFlat).Magnitude <= StealRange and math.random() * 100 < StealChance then
                    BotDefender.StealUntil = Now + math.clamp(tonumber(CONFIG.BotStealDuration) or 0.35, 0.1, 1)
                    BotDefender.NextStealAt = Now + math.clamp(tonumber(CONFIG.BotStealCooldown) or 3.5, 0.5, 10)
                    Stealing = true
                end
            end
            if Stealing then
                Sample = Vector3.new(StealBall.Position.X, BotRoot.Position.Y, StealBall.Position.Z)
            end
        end
        BotDefender.Stealing = Stealing

        local TargetHorizontal = Vector3.new(TargetRoot.Position.X, 0, TargetRoot.Position.Z)
        local BotHorizontal = Vector3.new(BotRoot.Position.X, 0, BotRoot.Position.Z)
        local TargetDistance = (TargetHorizontal - BotHorizontal).Magnitude
        BotDefender.Distance = TargetDistance
        if BotRoot.Position.Y < TargetRoot.Position.Y - 18 or TargetDistance > 80 then
            BotDefender.Status = 'RECOVERING RIG'
            BotDefender.Reset()
            return
        end

        BotHumanoid.PlatformStand = false
        BotHumanoid.WalkSpeed = 16 
        BotDefender.ApplyDefensiveShiftLock(TargetRoot)
        local Difference = Vector3.new(Sample.X - BotRoot.Position.X, 0, Sample.Z - BotRoot.Position.Z)
        local StopDistance = math.clamp(tonumber(CONFIG.BotStopDistance) or 0.85, 0.05, 6)
        local Moving = Stealing or Difference.Magnitude > StopDistance
        if Moving then
            local CandidateDirection = Difference.Unit
            local WantedDirection = CandidateDirection
            if CONFIG.BotHumanize ~= false then
                local CommitTime = math.clamp(tonumber(CONFIG.BotCommitTime) or 0.08, 0, 0.5)
                local Committed = BotDefender.CommittedDirection or Vector3.zero
                if Now >= (BotDefender.CommitUntil or 0) or Committed.Magnitude <= 0.05 then
                    BotDefender.CommittedDirection = CandidateDirection
                    BotDefender.CommitUntil = Now + CommitTime * (0.80 + math.random() * 0.40)
                elseif CandidateDirection:Dot(Committed) > 0.55 then
                    local Adjusted = Committed:Lerp(CandidateDirection, 0.22)
                    if Adjusted.Magnitude > 0.05 then BotDefender.CommittedDirection = Adjusted.Unit end
                end
                WantedDirection = BotDefender.CommittedDirection
            end
            local Smoothing = math.clamp(tonumber(CONFIG.BotSmoothing) or 10, 0.5, 50)
            local Alpha = 1 - math.exp(-Smoothing * math.max(tonumber(DeltaTime) or 0.016, 0.001))
            local SmoothedDirection = (BotDefender.CurrentMoveDirection or Vector3.zero):Lerp(
                WantedDirection, math.clamp(Alpha, 0, 1))
            if SmoothedDirection.Magnitude > 1 then SmoothedDirection = SmoothedDirection.Unit end
            BotDefender.CurrentMoveDirection = SmoothedDirection
            if tostring(CONFIG.BotMoveMethod or 'Humanoid Move') == 'MoveTo' then
                local Interval = math.clamp(tonumber(CONFIG.BotMoveToInterval) or 0.12, 0.02, 1)
                if Now >= BotDefender.NextMoveToAt then
                    BotDefender.NextMoveToAt = Now + Interval
                    BotHumanoid:MoveTo(Vector3.new(Sample.X, BotRoot.Position.Y, Sample.Z))
                end
            else

                BotHumanoid:Move(SmoothedDirection, false)
            end
        else
            BotDefender.CurrentMoveDirection = Vector3.zero
            BotDefender.CommittedDirection = Vector3.zero
            BotDefender.CommitUntil = 0
            BotHumanoid:Move(Vector3.zero, false)
        end

        local TargetState = TargetHumanoid:GetState()
        local TargetJumping = TargetState == Enum.HumanoidStateType.Jumping
            or (TargetState == Enum.HumanoidStateType.Freefall
            and TargetRoot.AssemblyLinearVelocity.Y > -2)
        if CONFIG.BotAutoContest ~= false and TargetJumping and not BotDefender.LastTargetJumping
            and GetLocalBallHandle() ~= nil
            and TargetDistance <= math.clamp(tonumber(CONFIG.BotContestRange) or 7, 0, 25)
            and BotHumanoid.FloorMaterial ~= Enum.Material.Air then
            local Height = math.clamp(tonumber(CONFIG.BotContestHeight) or 3.2, 0.1, 12)
            if BotHumanoid.UseJumpPower then
                BotHumanoid.JumpPower = math.sqrt(2 * math.max(Workspace.Gravity, 1) * Height)
            else
                BotHumanoid.JumpHeight = Height
            end
            BotHumanoid.Jump = true
            pcall(function() BotHumanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
            BotDefender.ContestUntil = Now + 0.65
        end
        BotDefender.LastTargetJumping = TargetJumping

        BotDefender.UpdateNaturalAnimation()
        if Now < (BotDefender.ContestUntil or 0) then
            BotDefender.Status = 'CONTESTING | HUMANOID JUMP'
        elseif Stealing then
            BotDefender.Status = 'STEAL ATTEMPT | BALL HITBOX'
        elseif Moving then
            BotDefender.Status = 'DEFENDING | ' .. tostring(CONFIG.BotMoveMethod or 'Humanoid Move')
            .. ' | ' .. tostring(BotDefender.HumanStatus or 'HUMAN READS')
        else
            BotDefender.Status = 'HOLDING GAP | NATURAL IDLE'
        end
    end

    function BotDefender.UpdateBinding()
        pcall(function() State.Lifecycle:UnbindFromRenderStep(BotDefender.BindName) end)
        if not BotDefender.Enabled then return end
        State.Lifecycle:BindToRenderStep(
            BotDefender.BindName,
            Enum.RenderPriority.Input.Value + 2,
            WYNF_JIT(function(DeltaTime)
            local Ok, Error = pcall(BotDefender.Step, DeltaTime)
            if not Ok then
                BotDefender.LastError = tostring(Error)
                BotDefender.Status = 'BOT ERROR'
            end
        end)
        )
    end

    function BotDefender.SetEnabled(Enabled)
        Enabled = Enabled == true
        CONFIG.BotEnabled = Enabled
        if Enabled == BotDefender.Enabled then
            if Enabled and not BotDefender.Model then BotDefender.Build() end
            BotDefender.UpdateBinding()
            if HubUI.Sync then HubUI.Sync() end
            return
        end
        BotDefender.Enabled = Enabled
        if Enabled then
            BotDefender.Status = 'STARTING HUMAN SHIFTLOCK R6'
            BotDefender.Build()
        else
            BotDefender.Destroy('OFF')
        end
        BotDefender.UpdateBinding()
        if HubUI.Sync then HubUI.Sync() end
    end
end 

