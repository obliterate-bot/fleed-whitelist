function State.LocalSpoofs.AddAdvancedFakeMatch(Custom)
    Custom=type(Custom)=='table' and Custom or {};
    State.LocalSpoofs.PlayerData=State.LocalSpoofs.PlayerData or require(ReplicatedStorage.Util.PlayerData)
    local Data=State.LocalSpoofs.PlayerData.storedData;
    if type(Data)~='table' then return false end;
    Data.MatchHistory=type(Data.MatchHistory)=='table' and Data.MatchHistory or {}
    local Result=tostring(Custom.Result or 'Win');
    if Result=='Loss' then Result='Lose' end;
    local RenderResult=Result=='Draw' and 'Lose' or Result
    local HomeScore,AwayScore=math.max(0,math.floor(tonumber(Custom.HomeScore) or 21)),math.max(0,math.floor(tonumber(Custom.AwayScore) or 15))
    local LocalName=State.LocalAnonymizerEnabled and State.LocalAlias or LP.Name;
    local Enemy=tostring(Custom.Opponent or 'Anonymous');
    local ELO=State.LocalELOSpoofEnabled and State.LocalELO or (LP:GetAttribute('ELO') or 0);
    local Delta=math.floor(tonumber(Custom.ELODelta) or 0)
    local Wins,Losses,Streak,Highest=math.max(0,math.floor(tonumber(State.LocalWins) or 0)),math.max(0,math.floor(tonumber(State.LocalLosses) or 0)),math.max(0,math.floor(tonumber(State.LocalStreak) or 0)),math.max(0,math.floor(tonumber(State.LocalHighestStreak) or 0))
    local PlayerResult=Result=='Protected' or Result=='Draw' and 'Protected' or (Result=='Win' and 'Win' or 'Lose')
    local LocalInfo={Name=LocalName,UserId=LP.UserId,ELO=ELO,OLD=math.max(0,ELO-Delta),NEW=ELO,Points=math.max(0,math.floor(tonumber(Custom.Points) or HomeScore)),Assists=math.max(0,math.floor(tonumber(Custom.Assists) or 0)),Steals=math.max(0,math.floor(tonumber(Custom.Steals) or 0)),Blocks=math.max(0,math.floor(tonumber(Custom.Blocks) or 0)),Turnovers=math.max(0,math.floor(tonumber(Custom.Turnovers) or 0)),MVP=Custom.MVP==true,Result=PlayerResult,OLDWINS=math.max(0,Wins-(PlayerResult=='Win' and 1 or 0)),NEWWINS=Wins,OLDLOSSES=math.max(0,Losses-(PlayerResult=='Lose' and 1 or 0)),NEWLOSSES=Losses,OLDSTREAK=math.max(0,Streak-1),NEWSTREAK=Streak,OLDHIGHESTSTREAK=math.max(0,Highest-1),NEWHIGHESTSTREAK=Highest,OLDSHIELDS=State.LocalShields or 0,NEWSHIELDS=State.LocalShields or 0}
    local EnemyInfo={Name=Enemy,UserId=100001,ELO=0,OLD=0,NEW=0,Points=AwayScore,Assists=0,Steals=0,Blocks=0,Turnovers=0,Result=PlayerResult=='Win' and 'Lose' or 'Win',OLDWINS=0,NEWWINS=0,OLDLOSSES=0,NEWLOSSES=0,OLDSTREAK=0,NEWSTREAK=0,OLDHIGHESTSTREAK=0,NEWHIGHESTSTREAK=0,OLDSHIELDS=0,NEWSHIELDS=0}
    local Timestamp=tonumber(Custom.Timestamp);
    if not Timestamp then local Y,M,D=tostring(Custom.Date or ''):match('^(%d%d%d%d)%-(%d%d)%-(%d%d)$');
        if Y then Timestamp=os.time({year=tonumber(Y),month=tonumber(M),day=tonumber(D),hour=12}) end end
    local Home,Away={[LocalName]=LocalInfo},{[Enemy]=EnemyInfo}
    table.insert(Data.MatchHistory,1,{__GoldenEagleFake=true,__DisplayResult=Result,Result=RenderResult,HomeScore=HomeScore,AwayScore=AwayScore,Date=Timestamp or os.time(),PlayerCount=2,Mode=tostring(Custom.Mode or '1v1'),Competitive=Custom.Competitive==true,Court=tostring(Custom.Court or ''),Opponent=Enemy,Home=Home,Away=Away,HomeIcon='',AwayIcon=''})
    State.LocalSpoofs.RefreshFakeMatchHistory();
    return true
end
function State.LocalSpoofs.ExportFakeSeason()
    State.LocalSpoofs.PlayerData=State.LocalSpoofs.PlayerData or require(ReplicatedStorage.Util.PlayerData);
    local History=State.LocalSpoofs.PlayerData.storedData.MatchHistory or {};
    local Fake={}
    for _,Match in ipairs(History) do if type(Match)=='table' and Match.__GoldenEagleFake then table.insert(Fake,Match) end end
    local Ok,Raw=pcall(State.Utility.HttpService.JSONEncode,State.Utility.HttpService,{Version=2,Exported=os.time(),Matches=Fake});
    if not Ok then return false end
    if type(setclipboard)=='function' then pcall(setclipboard,Raw);
        return true elseif type(writefile)=='function' then return pcall(writefile,'GoldenEagle_FakeSeason.json',Raw) end return false
end
function State.LocalSpoofs.ImportFakeSeason()
    local Raw;
    if type(getclipboard)=='function' then local Ok,Value=pcall(getclipboard);
        if Ok then Raw=Value end end
    if not Raw and type(isfile)=='function' and type(readfile)=='function' and isfile('GoldenEagle_FakeSeason.json') then Raw=readfile('GoldenEagle_FakeSeason.json') end
    if not Raw then return false end;
    local Ok,Data=pcall(State.Utility.HttpService.JSONDecode,State.Utility.HttpService,Raw);
    if not (Ok and type(Data)=='table' and type(Data.Matches)=='table') then return false end
    State.LocalSpoofs.PlayerData=State.LocalSpoofs.PlayerData or require(ReplicatedStorage.Util.PlayerData);
    local Stored=State.LocalSpoofs.PlayerData.storedData;
    Stored.MatchHistory=type(Stored.MatchHistory)=='table' and Stored.MatchHistory or {}
    for Index=#Data.Matches,1,-1 do local Match=Data.Matches[Index];
        if type(Match)=='table' then Match.__GoldenEagleFake=true;
            table.insert(Stored.MatchHistory,1,Match) end end
    State.LocalSpoofs.RefreshFakeMatchHistory();
    return true
end

