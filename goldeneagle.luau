    function HubUI.CreateIdInput(Parent, Y, Label, InitialValue, Callback)
        New('TextLabel', {
            Position = UDim2.fromOffset(8, Y),
            Size = UDim2.new(1, -122, 0, 21),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            Text = Label,
            TextColor3 = Theme.Text,
            TextSize = 11,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 5,
            }, Parent)
        local Box = New('TextBox', {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -8, 0, Y),
            Size = UDim2.fromOffset(108, 21),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            ClearTextOnFocus = false,
            Font = Enum.Font.Code,
            PlaceholderText = '0',
            PlaceholderColor3 = Theme.Muted,
            Text = tostring(math.floor(tonumber(InitialValue) or 0)),
            TextColor3 = Theme.Text,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 6,
            }, Parent)
        AccentStroke(Box, 1, 0.18)
        GiveSignal(Box.FocusLost:Connect(function()
            local Best = 0
            for Digits in tostring(Box.Text):gmatch('%d+') do
                local Number = tonumber(Digits) or 0
                if #Digits >= #tostring(Best) and Number > Best then Best = Number end
            end
            Box.Text = tostring(math.floor(Best))
            pcall(Callback, math.floor(Best))
        end))
        return Box
    end

