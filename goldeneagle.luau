                GiveSignal(Row.MouseEnter:Connect(function() Tween(Row, 0.08, { BackgroundColor3 = Theme.SurfaceHover, BackgroundTransparency = 0 }) end))
                GiveSignal(Row.MouseLeave:Connect(function() MotionOut(Row, 0.1, { BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.25 }) end))
            end
