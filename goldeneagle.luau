        local PickerRole, PickerOriginal, PickerOriginalPreset, PickerH, PickerS, PickerV = nil, nil, nil, 0, 1, 1
        local PickerInitialColor, PickerPreviewCallback, PickerCommitCallback, PickerCustomTitle = nil, nil, nil, nil
        local DragSV, DragHue = false, false
        local function RefreshPickerVisuals(ApplyLive)
            local Color = Color3.fromHSV(PickerH, PickerS, PickerV)
            SVField.BackgroundColor3 = Color3.fromHSV(PickerH, 1, 1)
            SVCursor.Position = UDim2.fromScale(PickerS, 1 - PickerV)
            HueCursor.Position = UDim2.fromScale(0.5, PickerH)
            PickerPreview.BackgroundColor3 = Color
            PickerHex.Text = ColorToHex(Color)
            if ApplyLive and PickerRole then
                InterfaceConfig.ThemePreset = 'Custom'
                InterfaceConfig.Theme[PickerRole] = ColorToHex(Color)
                HubUI.ApplyTheme(InterfaceConfig.Theme, false)
            elseif ApplyLive and PickerPreviewCallback then
                PickerPreviewCallback(Color)
            end
        end
        local function SetPickerFromPoint(Field, Position, IsHue)
            local RelativeX = math.clamp((Position.X - Field.AbsolutePosition.X) / math.max(Field.AbsoluteSize.X, 1), 0, 1)
            local RelativeY = math.clamp((Position.Y - Field.AbsolutePosition.Y) / math.max(Field.AbsoluteSize.Y, 1), 0, 1)
            if IsHue then PickerH = RelativeY else PickerS, PickerV = RelativeX, 1 - RelativeY end
            RefreshPickerVisuals(true)
        end
        local PickerAnimationSerial = 0
        function HubUI.OpenColorPicker(Role, InitialColor, PreviewCallback, CommitCallback, Title)
            local IsThemeRole = Role ~= nil and Theme[Role] ~= nil
            if not IsThemeRole and typeof(InitialColor) ~= 'Color3' then return end
            if ActiveDropdown then ActiveDropdown:Close() end
            PickerAnimationSerial += 1
            PickerRole = IsThemeRole and Role or nil
            PickerOriginal = IsThemeRole and InterfaceConfig.Theme[Role] or nil
            PickerOriginalPreset = IsThemeRole and InterfaceConfig.ThemePreset or nil
            PickerInitialColor = IsThemeRole and Theme[Role] or InitialColor
            PickerPreviewCallback = IsThemeRole and nil or PreviewCallback
            PickerCommitCallback = IsThemeRole and nil or CommitCallback
            PickerCustomTitle = IsThemeRole and nil or Title
            PickerH, PickerS, PickerV = PickerInitialColor:ToHSV()
            PickerTitle.Text = IsThemeRole and string.upper(Role:gsub('(%l)(%u)', '%1 %2')) or string.upper(tostring(Title or 'COLOR'))
            local WasVisible = ColorPickerOverlay.Visible
            if not WasVisible then
                ColorPickerOverlay.BackgroundTransparency = 1
                ColorPickerOverlay.GroupTransparency = 1
                ColorPickerCard.Position = UDim2.fromScale(0.5, 0.515)
                ColorPickerCardScale.Scale = 0.97
            end
            ColorPickerOverlay.Visible = true
            RefreshPickerVisuals(false)
            Tween(ColorPickerOverlay, 0.26, {
                BackgroundTransparency = 0.18,
                GroupTransparency = 0,
                }, Enum.EasingStyle.Sine)
            Tween(ColorPickerCard, 0.28, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Sine)
            Tween(ColorPickerCardScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Quint)
        end
        ClosePicker = function(Commit)
            PickerAnimationSerial += 1
            local Serial = PickerAnimationSerial
            if not Commit and PickerRole and PickerOriginal then
                InterfaceConfig.ThemePreset = PickerOriginalPreset or InterfaceConfig.ThemePreset
                InterfaceConfig.Theme[PickerRole] = PickerOriginal
                HubUI.ApplyTheme(InterfaceConfig.Theme, false)
            elseif not Commit and PickerPreviewCallback and PickerInitialColor then
                PickerPreviewCallback(PickerInitialColor)
            elseif Commit and PickerRole then
                SaveInterfaceConfig()
            elseif Commit and PickerCommitCallback then
                PickerCommitCallback(Color3.fromHSV(PickerH, PickerS, PickerV))
            end
            Tween(ColorPickerOverlay, 0.20, {
                BackgroundTransparency = 1,
                GroupTransparency = 1,
                }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(ColorPickerCard, 0.20, { Position = UDim2.fromScale(0.5, 0.515) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(ColorPickerCardScale, 0.20, { Scale = 0.985 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            State.Lifecycle:Delay(HubUI.Motion.Hold(0.21), function()
                if PickerAnimationSerial == Serial and ColorPickerOverlay.Parent then ColorPickerOverlay.Visible = false end
            end)
            DragSV, DragHue = false, false
            PickerRole, PickerOriginal, PickerOriginalPreset = nil, nil, nil
            PickerInitialColor, PickerPreviewCallback, PickerCommitCallback, PickerCustomTitle = nil, nil, nil, nil
        end
        HubUI.OpenCustomColorPicker = function(Title, InitialColor, PreviewCallback, CommitCallback)
            HubUI.OpenColorPicker(nil, InitialColor, PreviewCallback, CommitCallback, Title)
        end
        State.Lifecycle:Connect(PickerApply.MouseButton1Click, function()
