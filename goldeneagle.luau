local function SilentShoot(Rim, YOffset, PreArmedTarget, SolvedTarget)
    if State.silentShootActive then return false end
    if SilentAim.ActorAimReady ~= true then return false end
    local Camera = workspace.CurrentCamera
    if not Camera then return false end
    local Character = LP.Character
    if not Character then return false end
    local HRP = safe_find(Character, 'HumanoidRootPart')
    if not HRP then return false end
    local TargetWorld = typeof(SolvedTarget) == 'Vector3'
        and SolvedTarget or Rim.Position + Vector3.new(0, YOffset, 0)
    local ActivationTarget = TargetWorld
    local WasPreArmed = typeof(PreArmedTarget) == 'Vector3'
        and (PreArmedTarget - ActivationTarget).Magnitude < 0.001

    State.silentShootActive = true

    local cx, cy = GetFullscreenCenterX(), Camera.ViewportSize.Y / 2
    local SavedCameraCFrame, SavedCameraFocus
    local ClickOk = pcall(function()
        SilentAim.FireActorAim(ActivationTarget)
        if not WasPreArmed then
            RunService.RenderStepped:Wait()
            SilentAim.FireActorAim(ActivationTarget)
        end

        if CONFIG.CameraIndependentFallback then
            local Head = safe_find(Character, 'Head')
            if Head then
                SavedCameraCFrame = Camera.CFrame
                SavedCameraFocus = Camera.Focus
                Camera.CFrame = CFrame.new(Head.Position, ActivationTarget)
                Camera.Focus = CFrame.new(ActivationTarget)
            end
        end

        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
    end)

    if CONFIG.BallStudioEnabled or State.LocalCosmeticSpoofEnabled then
        for _, Delay in ipairs({ 0.03, 0.12 }) do
            State.Lifecycle:Delay(Delay, function()
                if not State.Active then return end
                if State.LocalCosmeticSpoofEnabled then pcall(State.Cosmetics.ApplyLocalCosmetics, true) end
                if CONFIG.BallStudioEnabled then pcall(State.BallStudio.Refresh) end
            end)
        end
    end

    if SavedCameraCFrame then
        pcall(function()
            Camera.CFrame = SavedCameraCFrame
            if SavedCameraFocus then Camera.Focus = SavedCameraFocus end
        end)
    end

    State.Lifecycle:Delay(0.25, SilentAim.ClearActorAim)
    if CONFIG.HumanizeEnabled then
        local UsedRoll = State.Humanize.Roll
        State.Lifecycle:Delay(0.35, function()
            if State.Humanize.Roll == UsedRoll then
                State.Humanize.Roll = nil
                State.Humanize.Tallied = true
            end
        end)
    end
    if ClickOk and CONFIG.AutoEBL and State.Trickshot.EBLPhase == 'SHOOTING' then
        local G = State.Trickshot.EBLGeneration
        State.Trickshot.EBLPhase, State.Trickshot.EBLStatus = 'COMPLETE', 'SHOT FIRED'
        State.Trickshot.ForceAutoRelease = false
        State.Lifecycle:Delay(0.35, function() if State.Trickshot.EBLGeneration == G then State.Trickshot.ResetAutoEBL('READY') end end)
    end
    if ClickOk then pcall(State.SmartShot.MarkFired) end
    State.silentShootActive = false
    return ClickOk
end

