                    State.AutoMix.DefenderRead or '--',
                    State.AutoMix.ReachClosing or 0,
                    State.AutoMix.Plan or 'HOLD',
                    State.AutoMix.LastNecessaryReason or 'NONE',
                    State.AutoMix.PredictedBallSide or '--',
                    State.AutoMix.PredictedBallClearance or 0,
                    State.AutoMix.RiskScore or 0,
                    State.AutoMix.ClosingSpeed or 0,
                    State.AutoMix.MovementStatus or 'IDLE',
                    State.AutoMix.BlendPercent or 0,
                    State.AutoMix.SessionSummary or '--'
                )
            end
            if HubUI.SmartShotStatusText then
                HubUI.SmartShotStatusText.Text=string.format('STATUS  %s\nDECISION %s\nREASON %s\nDEFENDER %s\nDISTANCE %s\nCLOSING %.1f\nSIDE %s',CONFIG.SmartShotSelector and (State.SmartShot.Status or 'READY') or 'OFF',State.SmartShot.Decision or 'NORMAL',State.SmartShot.Reason or '--',State.SmartShot.Defender and ('@'..State.SmartShot.Defender.Name) or '--',State.SmartShot.Distance<math.huge and string.format('%.1f',State.SmartShot.Distance) or '--',State.SmartShot.ClosingSpeed or 0,State.SmartShot.Side or 'CENTER')
            end
            if HubUI.StepbackStatusText then
                local Cooldown = math.clamp(tonumber(CONFIG.StepbackCooldown) or 0.65, 0, 4)
                local Remaining = math.max(0, Cooldown - (os.clock() - (State.Stepback.LastStartedAt or 0)))
                HubUI.StepbackStatusText.Text = string.format(
                    'STATUS    %s  [%s]\nDIRECTION %s\nDISTANCE  %.1f / %.1f\nDEFENDER  %s  %s\nCOOLDOWN  %.2f SEC',
                    CONFIG.AutoStepback and (State.Stepback.Status or 'READY') or 'OFF',
                    State.Stepback.JumpPhase or 'READY',
                    State.Stepback.LastDirection or '--',
                    State.Stepback.LastDistance or 0,
                    State.Stepback.LastRequestedDistance or 0,
                    State.Stepback.LastDefender and ('@' .. State.Stepback.LastDefender.Name) or '--',
                    State.Stepback.LastDefenderDistance < math.huge
                    and string.format('%.1f', State.Stepback.LastDefenderDistance) or '--',
                    Remaining)
            end
            if HubUI.HumanizeStatusText then
                HubUI.HumanizeStatusText.Text = string.format(
                    'STATUS   %s\nRESULT   %s\nCAM ANGLE %s\nRIM ERROR %.2f STUDS\nMAKES %d | MISSES %d | BLOCKED %d',
                    CONFIG.HumanizeEnabled and (State.Humanize.Status or 'IDLE') or 'OFF',
                    CONFIG.HumanizeEnabled and (State.Humanize.LastResult or '--') or '--',
                    State.Humanize.LastAngle > 0 and string.format('%.0f deg', State.Humanize.LastAngle) or '--',
                    State.Humanize.LastSpread or 0,
                    State.Humanize.Makes or 0,
                    State.Humanize.Misses or 0,
                    State.Humanize.Blocked or 0
                )
            end
            if HubUI.AntiReachStatusText then
                local Thief = State.BallAssist.AntiReachCounterHolder
                HubUI.AntiReachStatusText.Text = string.format(
                    'STATUS    %s\nNOSTEAL   %s\nTHIEF     %s'
                    .. '\nCOUNTERS  %d\nRECOVERED %d',
                    State.BallAssist.AntiReachStatus or 'OFF',
                    State.BallAssist.IsNoStealActive() and 'ON (server)' or 'off',
                    Thief and ('@' .. Thief.Name) or '--',
                    State.BallAssist.AntiReachCounters or 0,
                    State.BallAssist.AntiReachRecoveries or 0
                )
            end

            QueueStatusText.Text = string.format(
                'STATUS    %s\nCOURT     %s\nPAD       %s\nPLAYERS   %s',
                AutoQueue.Status,
                AutoQueue.Court,
                AutoQueue.Pad,
                AutoQueue.Players
            )
            UtilityAutomationStatus.Text = string.format(
                'SPIN  %s\nSERVER  %s\nRECONNECT  %s',
                State.Utility.DailySpinStatus,
                State.Utility.ServerHopStatus,
                State.Utility.ReconnectStatus
            )
            UtilitySafetyStatus.Text = string.format(
                'PERFORMANCE  %s\nFPS  %.0f | CAP  %s\nFALL  %s'
                .. '\nTRAVEL HOOK  %s\nTRAVEL BLOCKED  %d',
                State.Utility.PerformanceStatus,
                State.Utility.FPS,
                State.Utility.FPSCapStatus,
                State.Utility.FallStatus,
                State.AntiTravelEnabled
                and (State.Utility.TravelHookMode or 'NOT INSTALLED')
                or 'OFF',
                State.Utility.TravelBlocked
            )

            if HubUI.BotStatusText then
                local DistanceText = State.BotDefender.Distance < math.huge
                    and string.format('%.1f STUDS', State.BotDefender.Distance) or '--'
                local ShiftText = CONFIG.BotShiftLock ~= false
                    and ('SHIFTLOCK ' .. tostring(State.BotDefender.ShiftLockFacing or 'PLAYER')) or 'AUTO ROTATE'
                HubUI.BotStatusText.Text = string.format(
                    'STATUS  %s\nRIG     %s HUMANOID | WS 16\nMOVE    %s\nFACE    %s\nREADS   %s\nDIST    %s',
                    State.BotDefender.Status or 'OFF',
                    State.BotDefender.RigLabel or 'R6',
                    tostring(CONFIG.BotMoveMethod or 'Humanoid Move'),
                    ShiftText,
                    tostring(State.BotDefender.HumanStatus or 'HUMAN READS'),
                    DistanceText
                )
            end

            if HubUI.GhostRecordStatus then
                HubUI.GhostRecordStatus.Text = string.format(
                    'STATUS  %s\nTIME  %.1f / %.1f SEC\nFRAMES  %d | PARTS  %d\nBALL  %s',
                    State.GhostReplay.Status,
                    State.GhostReplay.RecordTime,
                    CONFIG.GhostMaxDuration,
                    #State.GhostReplay.Frames,
                    #State.GhostReplay.SourceParts,
                    State.GhostReplay.BallTemplate and 'CAPTURED' or 'WAITING'
                )
            end
            if HubUI.GhostPlaybackStatus then
                HubUI.GhostPlaybackStatus.Text = string.format(
                    'STATUS  %s\nPLAYHEAD  %.1f SEC | SPEED  %.2fX\nACCESSORIES  %d / %d\nLOOP  %s',
                    State.GhostReplay.Status,
                    State.GhostReplay.PlaybackTime,
                    CONFIG.GhostPlaybackSpeed,
                    State.GhostReplay.GhostAccessoryCount,
                    State.GhostReplay.SourceAccessoryCount,
                    State.GhostReplay.Loop and 'ON' or 'OFF'
                )
            end

            local Rim, Distance = FindConfiguredGoal()
            local Power = State.PowerBypass.GetEffectivePower()
            local AimDistance = Rim and State.Backboard.GetConfiguredAimDistance(Rim, Distance) or math.huge
            local AdjustedDistance = Rim and AdjustAimDistance(AimDistance) or math.huge
            local Minimum = MinRangeForPower[Power]
            local Maximum = MaxRangeForPower[Power]
            local HasBall = GetHeldBasketballModel(LP) ~= nil
            local Supported = Rim ~= nil and PowerSupportsDistance(Power, AdjustedDistance)
            local BestPower = Rim and State.SelectBestAutoPower(AdjustedDistance, Power) or nil

            StatusPower.Text = tostring(Power)
            StatusDistance.Text = Rim and (CONFIG.BackboardEnabled == true
                and string.format('%.1f bank studs', AimDistance)
                or string.format('%.1f studs', Distance)) or '--'
            StatusBand.Text = Minimum and Maximum
                and string.format('%.1f     %.1f', Minimum, Maximum) or 'UNCALIBRATED'
            StatusBall.Text = HasBall and 'HELD' or 'NOT HELD'
            StatusHooks.Text = SilentAim.ActorAimReady and 'READY' or 'WAITING'
            StatusAutoPower.Text = CONFIG.AutoPower
                and (BestPower and ('ON  •  ' .. tostring(BestPower)) or 'ON  •  NO BAND') or 'OFF'
            if HubUI.StatusPerfect then
                HubUI.StatusPerfect.Text = string.format(
                    '%d  •  BEST %d  •  %d/%d',
                    State.PerfectRelease.Streak or 0,
                    State.PerfectRelease.BestStreak or 0,
                    State.PerfectRelease.Hits or 0,
                    State.PerfectRelease.Attempts or 0
                )
                HubUI.StatusPerfect.TextColor3 = (State.PerfectRelease.Streak or 0) > 0 and Theme.Success or Theme.Text
            end

            if HubUI.StatusPing then
                local PingReadout = State.PingAdaptive.GetPingReadout()
                if HubUI.StatusPing.Text ~= PingReadout then
                    HubUI.StatusPing.Text = PingReadout
                end
                HubUI.StatusPing.TextColor3 = CONFIG.PingAdaptiveRelease
                    and Accent or Theme.Muted
            end
            if HubUI.StatusOwnership then
                local OwnerReadout = State.PingAdaptive.GetOwnershipReadout()
                if HubUI.StatusOwnership.Text ~= OwnerReadout then
                    HubUI.StatusOwnership.Text = OwnerReadout
                end
                HubUI.StatusOwnership.TextColor3 =
                State.PingAdaptive.OwnerOwned and Theme.Success or Theme.Muted
            end

            if not State.RequestedEnabled then
                StatusText.Text = 'SILENT AIM OFF'
                StatusText.TextColor3 = Theme.Muted
                StatusDot.BackgroundColor3 = Theme.Off
            elseif not State.Enabled then
                StatusText.Text = 'VERIFYING HOOKS'
                StatusText.TextColor3 = Theme.Warning
                StatusDot.BackgroundColor3 = Theme.Warning
            elseif Supported and (HasBall or not CONFIG.AimRequireBall) and SilentAim.ActorAimReady then
                StatusText.Text = 'SHOT READY'
                StatusText.TextColor3 = Theme.Success
                StatusDot.BackgroundColor3 = Theme.Success
            elseif not Supported then
                StatusText.Text = 'OUT OF CALIBRATED BAND'
                StatusText.TextColor3 = Theme.Bad
                StatusDot.BackgroundColor3 = Theme.Bad
            else
                StatusText.Text = 'STANDBY'
                StatusText.TextColor3 = Accent
                StatusDot.BackgroundColor3 = Accent
            end

            local Coverage = 0
            if Rim and Minimum and Maximum and Maximum > Minimum then
                Coverage = math.clamp((AdjustedDistance - Minimum) / (Maximum - Minimum), 0, 1)
            end
            Tween(RangeFill, 0.12, { Size = UDim2.fromScale(Coverage, 1) })
            RangeText.Text = Supported and 'range coverage – supported' or 'range coverage – unsupported'
            RangeText.TextColor3 = Supported and Accent or Theme.Muted
        end)
        if not RenderOk and not HubUI.RenderFailed then
            HubUI.RenderFailed = true
            warn('[GOLDEN EAGLE] UI update paused: ' .. tostring(RenderError))
        end
    end)))

    HubUI.FitClassicGroupboxes = function()
        for _, Page in pairs(Pages) do
            for _, Group in ipairs(Page:GetChildren()) do
                if Group:IsA('Frame') and string.sub(Group.Name, -4) == 'Card' then
                    local Body = Group:FindFirstChild('Content')
                    local Bottom = 0
                    if Body then
                        for _, Child in ipairs(Body:GetChildren()) do
                            if Child:IsA('GuiObject') and Child.Visible then
                                local ChildBottom = Child.Position.Y.Offset + Child.Size.Y.Offset
                                if ChildBottom > Bottom then Bottom = ChildBottom end
                            end
                        end
                    end
                    local Height = math.clamp(14 + Bottom + 12, 82, GroupHeight)
                    Group.Size = UDim2.new(Group.Size.X.Scale, Group.Size.X.Offset, 0, Height)
                end
            end
        end
    end
    HubUI.FitClassicGroupboxes()
    State.Lifecycle:Defer(HubUI.FitClassicGroupboxes)

    HubUI.ApplyFont(InterfaceConfig.Font, false)
    Main.BackgroundTransparency = 0
    StaticGradientLayer.BackgroundTransparency = math.clamp(0.18 + InterfaceConfig.WindowTransparency * 0.72, 0.18, 0.82)
    Sidebar.BackgroundTransparency = 0
    Content.BackgroundTransparency = 0
    HubUI.Sync()
    HubUI.Open = true
    if HubUI.KeybindManager and HubUI.KeybindManager.ApplyOverlayWindowState then
        HubUI.KeybindManager:ApplyOverlayWindowState(true)
    end
    HubUI.FitScale = CalculateFitScale()
    Main.Position = PreferredWindowPosition
    Main.Rotation = 0
    MainScale.Scale = EffectiveScale()
    ClampWindowToViewport()

    State.Lifecycle:Spawn(function()
        if not InterfaceConfig.Intro or not (State.Active and ScreenGui.Parent and Intro and Intro.Parent) then
            if not InterfaceConfig.Intro and Intro and Intro.Parent then Intro:Destroy() end
            if HubUI.IntroScrim then HubUI.IntroScrim:Destroy();
                HubUI.IntroScrim = nil end
            HubUI.IntroPlaying = false
            Main.Visible = true
            Main.GroupTransparency = 0
            MainScale.Scale = EffectiveScale()
            State.Lifecycle:Defer(SaveWindowPosition)
            return
        end

        Intro.Visible = true
        Intro.GroupTransparency = 1
        IntroScale.Scale = 0.90
        IntroFill.Size = UDim2.fromScale(0, 1)
        IntroStatus.Text = 'PREPARING YOUR SESSION'
        IntroStatus.TextColor3 = Theme.Muted
        IntroStatus.TextTransparency = 1

        if HubUI.IntroScrim then
            HubUI.IntroScrim.BackgroundTransparency = 1
            Tween(HubUI.IntroScrim, 0.42, { BackgroundTransparency = 0.45 }, Enum.EasingStyle.Sine)
        end
        if HubUI.IntroTitle then
            HubUI.IntroTitle.Position = UDim2.fromOffset(0, 23)
            HubUI.IntroTitle.TextTransparency = 1
            Tween(HubUI.IntroTitle, 0.46, { Position = UDim2.fromOffset(0, 14), TextTransparency = 0 }, Enum.EasingStyle.Quint)
        end
        Tween(Intro, 0.38, { GroupTransparency = 0 }, Enum.EasingStyle.Sine)
        Tween(IntroScale, 0.52, { Scale = 1 }, Enum.EasingStyle.Quint)
        task.wait(HubUI.Motion.Hold(0.20))
        IntroBrand.TextTransparency = 1
        Tween(IntroBrand, 0.30, { TextTransparency = 0.15 }, Enum.EasingStyle.Sine)
        Tween(IntroStatus, 0.28, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
        task.wait(HubUI.Motion.Hold(0.20))

        Tween(IntroStatus, 0.10, { TextTransparency = 1 }, Enum.EasingStyle.Sine)
        task.wait(HubUI.Motion.Hold(0.10))
        IntroStatus.Text = 'SETTING THE STAGE'
        Tween(IntroStatus, 0.16, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
        if HubUI.IntroPercent then
            Tween(HubUI.IntroPercent, 0.22, { TextTransparency = 0.15 }, Enum.EasingStyle.Sine)
        end

        local FillTween = Tween(IntroFill, 0.62, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Linear)

        State.Lifecycle:Spawn(function()
            while HubUI.IntroPlaying and IntroFill.Parent and IntroFill.Size.X.Scale < 1 do
                local Progress = math.clamp(IntroFill.Size.X.Scale, 0, 1)
                if HubUI.IntroPercent then
                    HubUI.IntroPercent.Text = string.format('%d%%', math.floor(Progress * 100 + 0.5))
                end
                local Stage = Progress < 0.34 and 'SETTING THE STAGE'
                    or (Progress < 0.68 and 'FINALIZING' or 'ALMOST READY')
                if IntroStatus.Text ~= Stage then IntroStatus.Text = Stage end
                task.wait(HubUI.Motion.Hold(0.03))
            end
            if HubUI.IntroPercent then HubUI.IntroPercent.Text = '100%' end
        end)
        FillTween.Completed:Wait()
        if not (State.Active and ScreenGui.Parent and Intro.Parent) then return end

        Tween(IntroStatus, 0.10, { TextTransparency = 1 }, Enum.EasingStyle.Sine)
        task.wait(HubUI.Motion.Hold(0.10))
        IntroStatus.Text = 'WELCOME BACK'
        IntroStatus.TextColor3 = Theme.AccentBright
        Tween(IntroStatus, 0.18, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
        task.wait(HubUI.Motion.Hold(0.22))

        Main.Visible = true
        Main.GroupTransparency = 1
        MainScale.Scale = EffectiveScale()
        MainScale.Scale = EffectiveScale() * 0.975
        Tween(Main, 0.24, { GroupTransparency = 0 }, Enum.EasingStyle.Quart)
        Tween(MainScale, 0.28, { Scale = EffectiveScale() }, Enum.EasingStyle.Quart)
        Tween(Intro, 0.34, { GroupTransparency = 1 }, Enum.EasingStyle.Sine)
        Tween(IntroScale, 0.34, { Scale = 1.03 }, Enum.EasingStyle.Quint)
        if HubUI.IntroScrim then
            Tween(HubUI.IntroScrim, 0.40, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
        end
        task.wait(HubUI.Motion.Hold(0.36))

        if Intro and Intro.Parent then Intro:Destroy() end
        if HubUI.IntroScrim then HubUI.IntroScrim:Destroy();
            HubUI.IntroScrim = nil end
        HubUI.IntroPlaying = false
        State.Lifecycle:Defer(SaveWindowPosition)
    end)
end

State.Lifecycle:Spawn(function()
    while State.Active do
        if CONFIG.AutoPower then
            pcall(function()
                if not GetHeldBasketballModel(LP) then return end
                local Rim, Distance = FindConfiguredGoal()
                if not Rim then return end
                Distance = State.Backboard.GetConfiguredAimDistance(Rim, Distance)
                Distance = AdjustAimDistance(Distance)

                local CurrentPower = safe_get_attribute(LP, 'Power') or 85
                local BestPower = State.SelectBestAutoPower(Distance, CurrentPower)

                if BestPower and BestPower ~= CurrentPower then
                    State.PowerBypass.SyncChannels(BestPower)
                end
            end)
        end
        task.wait(CONFIG.AutoPower and 0.2 or 0.5)
    end
end)

