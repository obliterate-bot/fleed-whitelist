            }, ScreenGui)
        HubUI.ActiveToasts = {}
        HubUI.ToastSpacing = 8
        HubUI.ToastDuration = 3.2
        function HubUI.RestackToasts()
            local Offset = 0
            for Index = #HubUI.ActiveToasts, 1, -1 do
                local Toast = HubUI.ActiveToasts[Index]
                Tween(Toast.Frame, 0.24, { Position = UDim2.new(1, 0, 1, -Offset) }, Enum.EasingStyle.Quint)
                Offset = Offset + Toast.Height + HubUI.ToastSpacing
            end
        end
        function HubUI.DismissToast(Toast, Instant)
            if Toast.Closing then return end
            Toast.Closing = true
            Toast.Serial += 1
            if Toast.ProgressTween then pcall(function() Toast.ProgressTween:Cancel() end) end
            local Index = table.find(HubUI.ActiveToasts, Toast)
            if Index then table.remove(HubUI.ActiveToasts, Index) end
            Tween(Toast.Frame, Instant and 0.12 or 0.22, {
                GroupTransparency = 1,
                Position = Toast.Frame.Position + UDim2.fromOffset(264, 0),
                }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            State.Lifecycle:Delay(HubUI.Motion.Hold(Instant and 0.12 or 0.22), function()
                if Toast.Frame and Toast.Frame.Parent then Toast.Frame:Destroy() end
            end)
            HubUI.RestackToasts()
        end
        function HubUI.ArmToastTimer(Toast, Remaining)
            Toast.Serial += 1
            local Serial = Toast.Serial
            local Duration = math.max(0.12, tonumber(Remaining) or HubUI.ToastDuration)
            if Remaining == nil then Toast.Progress.Size = UDim2.new(1, 0, 0, 2) end
            if Toast.ProgressTween then pcall(function() Toast.ProgressTween:Cancel() end) end
            Toast.ProgressTween = TweenService:Create(Toast.Progress, TweenInfo.new(
                Duration, Enum.EasingStyle.Linear
                ), { Size = UDim2.new(0, 0, 0, 2) })
            Toast.ProgressTween:Play()
            State.Lifecycle:Delay(Duration, function()
                if Toast.Serial == Serial and not Toast.Closing and not Toast.Hovered then HubUI.DismissToast(Toast) end
            end)
        end
        function HubUI.GetToastStyle(Title, Text)
            local Message = string.lower(tostring(Title) .. ' ' .. tostring(Text))
            if string.find(Message, 'error', 1, true) or string.find(Message, 'fail', 1, true) then return '!', Theme.Bad end
            if string.find(Message, 'warn', 1, true) or string.find(Message, 'blocked', 1, true) then return '!', Theme.Warning end
            if string.find(Message, 'success', 1, true) or string.find(Message, 'saved', 1, true) or string.find(Message, 'ready', 1, true) then return '+', Theme.Success end
            return '•', Theme.Accent
        end
        function HubUI.ShowToast(Title, Text)
            Title = tostring(Title or 'GOLDEN EAGLE')
            Text = tostring(Text or '')
            local Glyph, SeverityColor = HubUI.GetToastStyle(Title, Text)

            for _, Toast in ipairs(HubUI.ActiveToasts) do
                if Toast.Title == Title and Toast.Text == Text and not Toast.Closing then
                    HubUI.ArmToastTimer(Toast)
                    return
                end
            end
            while #HubUI.ActiveToasts >= 5 do
                HubUI.DismissToast(HubUI.ActiveToasts[1], true)
            end
            local Lines = math.clamp(math.ceil(#Text / 36), 1, 4)
            local Height = 26 + Lines * 13
            local Frame = New('CanvasGroup', {
                AnchorPoint = Vector2.new(1, 1),
                Position = UDim2.new(1, 264, 1, 0),
                Size = UDim2.fromOffset(252, Height),
                BackgroundColor3 = Theme.Panel,
                BorderSizePixel = 0,
                GroupTransparency = 1,
                ZIndex = 91,
                }, ToastRoot)
            New('UICorner', { CornerRadius = UDim.new(0, 4) }, Frame)
            AccentStroke(Frame, 1, 0.25)
            local ToastScale = New('UIScale', { Scale = InterfaceConfig.ReducedMotion and 1 or 0.98 }, Frame)
            local ToastGlyph = New('TextLabel', {
                Position = UDim2.fromOffset(9, 4), Size = UDim2.fromOffset(12, 13),
                BackgroundTransparency = 1, Font = Enum.Font.Code, Text = Glyph,
                TextColor3 = SeverityColor, TextSize = 12, ZIndex = 92,
                }, Frame)
            local TitleLabel = New('TextLabel', {
                Position = UDim2.fromOffset(24, 5),
                Size = UDim2.new(1, -33, 0, 12),
                BackgroundTransparency = 1,
                Font = Enum.Font.Code,
                Text = string.upper(Title),
                TextColor3 = SeverityColor,
                TextSize = 10,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 92,
                }, Frame)

            New('TextLabel', {
                Position = UDim2.fromOffset(9, 19),
                Size = UDim2.new(1, -18, 0, Lines * 13),
                BackgroundTransparency = 1,
                Font = Enum.Font.Code,
                Text = Text,
                TextColor3 = Theme.Text,
                TextSize = 10,
                TextWrapped = true,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top,
                ZIndex = 92,
                }, Frame)
            local Progress = New('Frame', {
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(0, 0, 1, 0),
                Size = UDim2.new(1, 0, 0, 2),
                BackgroundColor3 = SeverityColor,
                BorderSizePixel = 0,
                ZIndex = 93,
                }, Frame)

            local Toast = {
                Frame = Frame, Progress = Progress, Height = Height,
                Title = Title, Text = Text, Serial = 0, Closing = false, Hovered = false,
            }
            local Hit = New('TextButton', {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Text = '',
                ZIndex = 94,
                }, Frame)
            GiveSignal(Hit.MouseButton1Click:Connect(function() HubUI.DismissToast(Toast) end))
            GiveSignal(Hit.MouseEnter:Connect(function()
                Toast.Hovered = true
                Toast.Serial += 1
                if Toast.ProgressTween then pcall(function() Toast.ProgressTween:Cancel() end) end
                Tween(Frame, 0.12, { BackgroundColor3 = Theme.SurfaceHover })
            end))
            GiveSignal(Hit.MouseLeave:Connect(function()
                Toast.Hovered = false
                MotionOut(Frame, 0.16, { BackgroundColor3 = Theme.Panel })
                local Remaining = HubUI.ToastDuration * math.clamp(Toast.Progress.Size.X.Scale, 0, 1)
                HubUI.ArmToastTimer(Toast, Remaining)
            end))
            table.insert(HubUI.ActiveToasts, Toast)
            HubUI.RestackToasts()
            Tween(Frame, 0.28, { GroupTransparency = 0 }, Enum.EasingStyle.Quint)
            Tween(ToastScale, 0.20, { Scale = 1 }, Enum.EasingStyle.Quint)
            HubUI.ArmToastTimer(Toast)
        end
        GlobalEnv.__GEH_TOAST = function(Title, Text)
            HubUI.ShowToast(Title, Text)
            return true
        end
    end

    function HubUI.AnimateUnload()
        if HubUI.UnloadAnimating then return end
        HubUI.UnloadAnimating = true
        if ActiveDropdown then ActiveDropdown:Close() end
        if ColorPickerOverlay and ColorPickerOverlay.Visible then ClosePicker(false) end
        SearchBox:ReleaseFocus()
        GlobalSearchBox:ReleaseFocus()
        CloseGlobalSearch(false)

        local Overlay = New('Frame', {
            Name = 'UnloadOverlay', Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Theme.Background, BackgroundTransparency = 1,
            BorderSizePixel = 0, Active = true, ZIndex = 500,
            }, Main)
        local Label = New('TextLabel', {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(300, 34), BackgroundTransparency = 1,
            Font = Enum.Font.Code, Text = 'UNLOADING  •  RESTORING CLIENT STATE',
            TextColor3 = Theme.AccentBright, TextTransparency = 1,
            TextSize = 13, ZIndex = 501,
            }, Overlay)
        local Bar = New('Frame', {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.58),
            Size = UDim2.fromOffset(0, 3), BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0, ZIndex = 501,
            }, Overlay)
        BindAccent(Bar, 'BackgroundColor3')

        local Speed = math.max(0.1, tonumber(InterfaceConfig.AnimationSpeed) or 1)
        local Delay = InterfaceConfig.ReducedMotion and 0.03 or (0.46 / Speed)
        Tween(Overlay, 0.12, { BackgroundTransparency = 0.16 })
        Tween(Label, 0.14, { TextTransparency = 0 })
        Tween(Bar, 0.34, { Size = UDim2.fromOffset(300, 3) })
        Tween(MainScale, 0.42, { Scale = math.max(0.05, MainScale.Scale * 0.84) })
        Tween(Main, 0.42, { GroupTransparency = 1, Rotation = 0 }, Enum.EasingStyle.Sine)

        State.Lifecycle:Delay(Delay, function()
            local Unload = GlobalEnv.__HOOPZ_SILENTAIM_UNLOAD
            if type(Unload) == 'function' then
                local Ok, ErrorText = pcall(Unload)
                if not Ok then
                    warn('[GOLDEN EAGLE] Unload failed: ' .. tostring(ErrorText))
                    HubUI.UnloadAnimating = false
                    if Main and Main.Parent then
                        Main.Rotation = 0
                        Main.GroupTransparency = 0
                        MainScale.Scale = EffectiveScale()
                        if Overlay and Overlay.Parent then Overlay:Destroy() end
                    end
                end
            elseif HubUI.Destroy then
                HubUI.Destroy()
            end
        end)
    end

    function HubUI.Destroy()
        if ScreenGui then pcall(function() ScreenGui:Destroy() end) end
        HubUI.ScreenGui = nil
        pcall(function() UserInputService.MouseIconEnabled = true end)
        HubUI.Window = nil
        HubUI.Open = false
        HubUI.IntroPlaying = false
        HubUI.UnloadAnimating = false
        HubUI.ConfigApplying = false
        table.clear(HubUI.Accents)
        table.clear(HubUI.ThemeBindings)
        table.clear(HubUI.FontBindings)
        if HubUI.PrismBorders then table.clear(HubUI.PrismBorders) end
        if HubUI.ActiveToasts then table.clear(HubUI.ActiveToasts) end
        if HubUI.ActionCallbacks then table.clear(HubUI.ActionCallbacks) end
        if HubUI.TabButtons then table.clear(HubUI.TabButtons) end
        if HubUI.Controls then table.clear(HubUI.Controls) end
    end

    function HubUI.BindGenericButtonPressAnimations()
        for _, Object in ipairs(Main:GetDescendants()) do
            if Object:IsA('TextButton') and Object.Text ~= '' and Object.Size.X.Offset > 0 and Object.Size.Y.Offset > 0 then
                local ExistingScale = Object:FindFirstChildOfClass('UIScale')
                local PressScale = ExistingScale or New('UIScale', { Scale = 1 }, Object)
                GiveSignal(Object.InputBegan:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1
                        or Input.UserInputType == Enum.UserInputType.Touch then
                        HubUI.Motion.Press(PressScale, true)
                    end
                end))
                GiveSignal(Object.InputEnded:Connect(function(Input)
                    if Input.UserInputType == Enum.UserInputType.MouseButton1
                        or Input.UserInputType == Enum.UserInputType.Touch then
                        HubUI.Motion.Press(PressScale, false)
                    end
                end))
            end
        end
    end
    HubUI.BindGenericButtonPressAnimations()

    HubUI.CloseButtonScale = New('UIScale', { Scale = 1 }, CloseButton)
    HubUI.UnloadButtonScale = New('UIScale', { Scale = 1 }, HubUI.UnloadButton)
    GiveSignal(CloseButton.MouseButton1Click:Connect(function()
        HubUI.Motion.Press(HubUI.CloseButtonScale, true)
        HubUI.SetOpen(false)
    end))
    GiveSignal(CloseButton.MouseEnter:Connect(function()
        Tween(CloseButton, 0.1, { BackgroundColor3 = Theme.SurfaceHover })
    end))
    GiveSignal(CloseButton.MouseLeave:Connect(function()
        MotionOut(CloseButton, 0.1, { BackgroundColor3 = Theme.Surface })
        MotionOut(HubUI.CloseButtonScale, 0.14, { Scale = 1 }, Enum.EasingStyle.Quint)
    end))
    GiveSignal(HubUI.UnloadButton.MouseButton1Click:Connect(function()
        HubUI.Motion.Press(HubUI.UnloadButtonScale, true)
        HubUI.AnimateUnload()
    end))
    GiveSignal(HubUI.UnloadButton.MouseEnter:Connect(function()
        Tween(HubUI.UnloadButton, 0.1, { BackgroundColor3 = Theme.Bad, TextColor3 = Color3.new(1, 1, 1) })
    end))
    GiveSignal(HubUI.UnloadButton.MouseLeave:Connect(function()
        MotionOut(HubUI.UnloadButton, 0.1, { BackgroundColor3 = Theme.Surface, TextColor3 = Theme.Bad })
        MotionOut(HubUI.UnloadButtonScale, 0.14, { Scale = 1 }, Enum.EasingStyle.Quint)
    end))

    local function PointInside(Object, Point)
        if not (Object and Object.Parent and Object.Visible) then return false end
        local Position = Object.AbsolutePosition
        local Size = Object.AbsoluteSize
        return Point.X >= Position.X and Point.X <= Position.X + Size.X
            and Point.Y >= Position.Y and Point.Y <= Position.Y + Size.Y
    end

    GiveSignal(UserInputService.InputBegan:Connect(function(Input, GameProcessed)
        if not (State.Active and Main.Parent) or HubUI.IntroPlaying then return end
        if HubUI.KeybindManager and HubUI.KeybindManager.Capture then return end
        local CtrlDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        local ShiftDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
            or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        if CtrlDown and Input.KeyCode == Enum.KeyCode.F then
            if not HubUI.Open then HubUI.SetOpen(true) end
            State.Lifecycle:Defer(function()
                if GlobalSearchBox and GlobalSearchBox.Parent then
                    GlobalSearchBox.Visible = true
                    ClearGlobalSearchButton.Visible = GlobalSearchBox.Text ~= ''
                    GlobalSearchBox:CaptureFocus()
                end
            end)
            return
        end
        if CtrlDown and Input.KeyCode == Enum.KeyCode.Tab then
            CycleTab(ShiftDown and -1 or 1)
            return
        end
        if Input.KeyCode == Enum.KeyCode.Escape then
            if HubUI.CustomGoalOverlay and HubUI.CustomGoalOverlay.Visible then
                HubUI.SetCustomGoalEditorVisible(false)
            elseif ColorPickerOverlay.Visible then
                ClosePicker(false)
            elseif ActiveDropdown then
                ActiveDropdown:Close()
            elseif GlobalSearchResults.Visible or GlobalSearchBox:IsFocused() or GlobalSearchBox.Text ~= '' then
                GlobalSearchBox:ReleaseFocus()
                CloseGlobalSearch(true)
            elseif SearchBox:IsFocused() or SearchBox.Text ~= '' then
                SearchBox:ReleaseFocus()
                SearchBox.Text = ''
            end
            return
        end
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            local Point = Vector2.new(Input.Position.X, Input.Position.Y)
            if ActiveDropdown and not PointInside(ActiveDropdown.Popup, Point) and not PointInside(ActiveDropdown.Button, Point) then
                ActiveDropdown:Close()
            end
            if GlobalSearchResults.Visible and not PointInside(GlobalSearchResults, Point)
                and not PointInside(GlobalSearchBox, Point) and not PointInside(ClearGlobalSearchButton, Point) then
                GlobalSearchBox:ReleaseFocus()
                CloseGlobalSearch(false)
            end
        end
    end))

    HubUI.Dragging = false
    HubUI.DragStart = nil
    HubUI.DragStartPosition = nil
    HubUI.LastTopbarClick = 0
    GiveSignal(Topbar.InputBegan:Connect(function(Input)
        if InterfaceConfig.LockWindow then return end
        local Point = Vector2.new(Input.Position.X, Input.Position.Y)
        if PointInside(GlobalSearchBox, Point) or PointInside(ClearGlobalSearchButton, Point) then return end
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            local Now = os.clock()
            if Input.UserInputType == Enum.UserInputType.MouseButton1 and Now - (HubUI.LastTopbarClick or 0) <= 0.28 then
                Main.Position = UDim2.fromScale(0.5, 0.5)
                ClampWindowToViewport()
                SaveWindowPosition()
                HubUI.LastTopbarClick = 0
                return
            end
            HubUI.LastTopbarClick = Now
            HubUI.Dragging = true
            HubUI.WindowDragging = true
            if HubUI.Motion and HubUI.Motion.Cancel then
                HubUI.Motion.Cancel(Main, { Position = true, Rotation = true })
            end
            HubUI.DragStart = Input.Position
            HubUI.DragStartPosition = Main.Position
        end
    end))
    GiveSignal(UserInputService.InputChanged:Connect(function(Input)
        if HubUI.Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement
            or Input.UserInputType == Enum.UserInputType.Touch) then
            local Delta = Input.Position - HubUI.DragStart
            Main.Position = UDim2.new(
                HubUI.DragStartPosition.X.Scale,
                HubUI.DragStartPosition.X.Offset + Delta.X,
                HubUI.DragStartPosition.Y.Scale,
                HubUI.DragStartPosition.Y.Offset + Delta.Y
            )
        end
    end))
    GiveSignal(UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            if HubUI.Dragging then
                ClampWindowToViewport()
                SaveWindowPosition()
            end
            HubUI.Dragging = false
            HubUI.DragStart = nil
            HubUI.DragStartPosition = nil
            HubUI.WindowDragging = false
        end
    end))

    HubUI.LastStatsAt = 0
    HubUI.LastGradientAt = 0
    HubUI.LastControlSyncAt = 0
    HubUI.LastControlVisualAt = 0
    HubUI.LastViewport = Vector2.zero
    GiveSignal(RunService.RenderStepped:Connect(WYNF_JIT(function()
        if not (State.Active and Main.Parent) then return end
        if HubUI.RenderFailed then return end
        if not Main.Visible then return end
        local HubNow = os.clock()

        local HubInterval = InterfaceConfig.ReducedMotion and 0.2 or (1 / 60)
        if HubNow - (HubUI.HubRenderAt or 0) < HubInterval then return end
        HubUI.HubRenderAt = HubNow
        local RenderOk, RenderError = pcall(function()
            local Now = os.clock()
            local IsWindowDragging = HubUI.WindowDragging == true
            local LinoriaStatic = InterfaceConfig.ThemePreset == 'Linoria'
            local MotionEnabled = not InterfaceConfig.ReducedMotion and not LinoriaStatic
            local GradientSpeed = math.max(0.01, tonumber(CONFIG.GradientCycleSpeed) or 0.18) * math.max(0.25, tonumber(InterfaceConfig.AnimationSpeed) or 1)
            local Accent = Theme.Accent
            local Pulse = MotionEnabled and (math.sin(Now * 4.2) + 1) * 0.5 or 0.5

            MainBorder.Thickness = math.clamp(tonumber(InterfaceConfig.BorderThickness) or 2.5,.5,8)
            MainBorder.Transparency = math.clamp(tonumber(InterfaceConfig.BorderGlow) or .08,0,.9)
            MainBorder.Color = InterfaceConfig.BorderStyle=='Static' and Color3.fromRGB(226,196,116) or Color3.new(1,1,1)
            MainFlameGradient.Enabled = InterfaceConfig.AnimatedBorder~=false and InterfaceConfig.BorderStyle~='Static'
            if HubUI.RefreshBorderStyle then HubUI.RefreshBorderStyle(Now,false) end

            if Intro and Intro.Parent and Intro.Visible then
                IntroStroke.Thickness = 2.2 + Pulse * 0.65
                IntroStroke.Transparency = 0.03 + (1 - Pulse) * 0.10
                IntroStrokeGradient.Rotation = MotionEnabled and ((Now * 64) % 360) or 0
                IntroStrokeGradient.Offset = MotionEnabled and Vector2.new(math.sin(Now * 1.8) * 0.30, 0) or Vector2.zero
                IntroFillGradient.Offset = MotionEnabled and Vector2.new(math.sin(Now * 2.1) * 0.45, 0) or Vector2.zero
            end

            local BorderStyle = tostring(InterfaceConfig.BorderStyle or 'Gold Sweep')
            local BorderMotion = MotionEnabled and math.clamp(tonumber(InterfaceConfig.BorderSpeed) or 1, .05, 5) or 0
            local BorderPhase = Now * BorderMotion
            local BorderActive = InterfaceConfig.AnimatedBorder ~= false and BorderStyle ~= 'Static' and MotionEnabled and not IsWindowDragging
            MainFlameGradient.Enabled = InterfaceConfig.AnimatedBorder ~= false and BorderStyle ~= 'Static'
            if BorderActive then
                if BorderStyle == 'Theme Pulse' then
                    MainFlameGradient.Offset = Vector2.new(math.sin(BorderPhase * 1.6) * .32, 0)
                    MainFlameGradient.Rotation = (BorderPhase * 38) % 360
                elseif BorderStyle == 'Double Pulse' then
                    MainFlameGradient.Offset = Vector2.new(math.sin(BorderPhase * 2.2) * .48, 0)
                    MainFlameGradient.Rotation = (BorderPhase * 22) % 360
                elseif BorderStyle == 'Comet Trail' then
                    MainFlameGradient.Offset = Vector2.new(((BorderPhase * .16) % 2) - 1, 0)
                    MainFlameGradient.Rotation = (BorderPhase * 14) % 360
                elseif BorderStyle == 'Neon Circuit' then
                    MainFlameGradient.Offset = Vector2.new(((BorderPhase * .24) % 2) - 1, math.sin(BorderPhase * 2.5) * .08)
                    MainFlameGradient.Rotation = (BorderPhase * 54) % 360
                elseif BorderStyle == 'Mono Sweep' then
                    MainFlameGradient.Offset = Vector2.new(((BorderPhase * .18) % 2) - 1, 0)
                    MainFlameGradient.Rotation = 0
                else
                    MainFlameGradient.Offset = Vector2.new(math.sin(BorderPhase * .72) * .42, math.cos(BorderPhase * .44) * .08)
                    MainFlameGradient.Rotation = (BorderPhase * 42) % 360
                end
            else
                MainFlameGradient.Offset = Vector2.zero
                MainFlameGradient.Rotation = 0
            end

            if not IsWindowDragging and Now - (HubUI.LastAccentAt or 0) >= (InterfaceConfig.ReducedMotion and 0.20 or 0.10) then
                HubUI.LastAccentAt = Now
                for Index = #HubUI.Accents, 1, -1 do
                    local Binding = HubUI.Accents[Index]
                    if Binding.Object and Binding.Object.Parent then
                        Binding.Object[Binding.Property] = Accent
                    else
                        table.remove(HubUI.Accents, Index)
                    end
                end
                if Now - (HubUI.LastControlVisualAt or 0) >= 0.22 then
                    HubUI.LastControlVisualAt = Now
                    for Name, Data in pairs(HubUI.TabButtons) do
                        Data.Button.TextColor3 = Name == HubUI.ActiveTab and Theme.Text or Theme.Muted
                        Data.Button.BackgroundColor3 = Name == HubUI.ActiveTab and Theme.SurfaceHover or Theme.Panel
                    end
                    local ActiveCount = 0
                    for _, Control in pairs(HubUI.Controls) do
                        if type(Control) == 'table' and type(Control.Value) == 'boolean' and Control.Value then
                            ActiveCount += 1
                        end
                    end
                    ActiveCountLabel.Text = tostring(ActiveCount) .. ' ACTIVE'
                    ActiveCountLabel.TextColor3 = ActiveCount > 0 and Accent or Theme.Muted
                    SearchBox.PlaceholderColor3 = SearchBox:IsFocused() and Accent or Theme.Muted
                    GlobalSearchBox.PlaceholderColor3 = GlobalSearchBox:IsFocused() and Accent or Theme.Muted
                    GlobalSearchStroke.Color = GlobalSearchBox:IsFocused() and Accent or Theme.Border
                    GlobalSearchStroke.Thickness = GlobalSearchBox:IsFocused() and 1.5 or 1
                end
            end

            local Camera = Workspace.CurrentCamera
            if Camera and Camera.ViewportSize ~= HubUI.LastViewport then
                HubUI.LastViewport = Camera.ViewportSize
                HubUI.FitScale = CalculateFitScale()
                MainScale.Scale = EffectiveScale() * (HubUI.Open and 1 or 0.95)
                ClampWindowToViewport()
                SaveWindowPosition()
            end
            if Now - HubUI.LastStatsAt < 0.2 then return end
            HubUI.LastStatsAt = Now
            if Now - State.Watch.LastRefresh >= 1 then
                State.Watch.RefreshOptions()
                if HubUI.Controls.WatchCourt and not HubUI.Controls.WatchCourt.Open then
                    HubUI.Controls.WatchCourt:RefreshOptions(nil, State.Watch.CourtSelection)
                end
                if HubUI.Controls.WatchCameraMode and HubUI.Controls.WatchCameraMode.Value ~= State.Watch.Mode then
                    HubUI.Controls.WatchCameraMode:Set(State.Watch.Mode, false)
                end
                if HubUI.WatchStartButton then HubUI.WatchStartButton.Text = State.Watch.Active and 'STOP WATCHING' or 'START WATCHING MATCH' end
                if HubUI.WatchStatusText then
                    local MatchName = State.Watch.Court and State.Watch.Court.Name or State.Watch.CourtName
                    HubUI.WatchStatusText.Text = string.format('STATUS  %s\nMATCH   %s\nPLAYERS %s\nCAMERA  %s',
                        State.Watch.Status, MatchName, State.Watch.PlayerSummary, State.Watch.Mode)
                end
            end
            if Now - State.Extras.LastTravelOptionsRefresh >= 1 then
                State.Extras.RefreshTravelOptions()
                if HubUI.Controls.QuickTravelDestination
                    and not HubUI.Controls.QuickTravelDestination.Open then
                    HubUI.Controls.QuickTravelDestination:RefreshOptions(nil, CONFIG.QuickTravelDestination)
                end
                if HubUI.Controls.QuickTravelPlayer
                    and not HubUI.Controls.QuickTravelPlayer.Open then
                    HubUI.Controls.QuickTravelPlayer:RefreshOptions(nil, CONFIG.QuickTravelPlayer)
                end
            end
            if Now - HubUI.LastControlSyncAt >= 0.5 then
                HubUI.LastControlSyncAt = Now
                HubUI.Sync()
            end
            QuickTravelStatusText.Text = string.format(
                'STATUS  %s\nTARGET  %s\nPLAYER  %s',
                State.Extras.TravelStatus, CONFIG.QuickTravelDestination, CONFIG.QuickTravelPlayer
            )

            DunkStatusText.Text = string.format(
                'STATUS  %s\nTARGET  %s\nMODE    %s\nDUNK    %s',
                State.AutoDunkStatus,
                State.AutoDunk.Target and string.format('%.1f studs', State.AutoDunk.TargetDistance) or '--',
                State.AutoDunkMode,
                State.AutoDunkRandomOwned and (State.AutoDunk.SelectedDunk or 'Random owned') or 'Equipped rotation'
            )
            if HubUI.AutoHeadRideStatusText then
                HubUI.AutoHeadRideStatusText.Text = string.format(
                    'STATUS  %s\nTARGET  %s\nDIST    %s',
                    State.AutoHeadRide.Status,
                    State.AutoHeadRide.Target and State.AutoHeadRide.Target.Name or '--',
                    State.AutoHeadRide.TargetDistance < math.huge
                    and string.format('%.1f studs', State.AutoHeadRide.TargetDistance) or '--'
                )
            end
            if HubUI.OffenseStatusText then
                HubUI.OffenseStatusText.Text = string.format(
                    'STATUS  %s\nMODE    %s\nTARGET  %s\nPLAN    %s\nHAND    %s\nANTIRIP %s\nBALL REACH  %s\nCOURT   %s | EDGE %s\nSHOT    at 72 studs with regular setup',
                    State.AutoOffense.Status,
                    State.AutoOffense.BehaviorStatus or string.upper(State.AutoOffense.BehaviorMode or 'ADAPTIVE'),
                    State.AutoOffense.Target and string.format('%.1f studs', State.AutoOffense.TargetDistance) or '--',
                    State.AutoOffense.DriveStatus or 'GOAL STRAFE TO 72 LINE',
                    State.AutoOffense.AutoHandStatus or 'WAITING',
                    State.AutoOffense.AntiRipStatus or 'ARMED',
                    State.AutoOffense.DefenderCanReachBall and 'YES - CUT BACK' or 'NO - HOLD SIDE',
                    State.AutoOffense.BoundaryStatus or 'CLEAR',
                    State.AutoOffense.EdgeClearance < math.huge
                    and string.format('%.1f', State.AutoOffense.EdgeClearance) or '--'
                )
            end
            if HubUI.DesyncStatusText then
                if State.Desync.Enabled then State.Desync.Update() end
                HubUI.DesyncStatusText.Text = State.Desync.Enabled and string.format(
                    'status  %s\noffset  x:%.2f z:%.2f\navg offset  x:%.2f z:%.2f\nsamples  %d',
                    State.Desync.Status, State.Desync.Offset.X, State.Desync.Offset.Z,
                    State.Desync.Average.X, State.Desync.Average.Z, #State.Desync.Samples
                ) or 'status  off\noffset  --\navg offset  --\nsamples  0'
            end

            GetOpenStatusText.Text = string.format(
                'STATUS  %s\nSPOT    %s\nMOVE    %s',
                State.AutoGetOpenStatus,
