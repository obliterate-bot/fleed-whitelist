function State.LogoBadges.ApplySettingsPanel()
    local PlayerGui = LP:FindFirstChildOfClass('PlayerGui')
    local MenuUI = PlayerGui and PlayerGui:FindFirstChild('MenuUI')
    local MenuFrames = MenuUI and MenuUI:FindFirstChild('MenuFrames')
    local Settings = MenuFrames and MenuFrames:FindFirstChild('Settings')
