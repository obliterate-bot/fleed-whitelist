        local TipBody = New('TextLabel', {
            Position = UDim2.fromOffset(9, 20), Size = UDim2.new(1, -18, 1, -26), BackgroundTransparency = 1,
            Font = Enum.Font.Code, Text = '', TextColor3 = Theme.Text, TextSize = 10, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 401,
            }, TipCard)
        local TipSerial = 0
        local function HideTip()
            TipSerial += 1
            TipCard.Visible = false
        end
        local function PlaceTip()
            local Mouse = UserInputService:GetMouseLocation()
            local Camera = Workspace.CurrentCamera
            local View = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
            local X = math.clamp(Mouse.X + 16, 4, math.max(4, View.X - 254))
            local Y = math.clamp(Mouse.Y + 18, 4, math.max(4, View.Y - TipCard.Size.Y.Offset - 6))
            TipCard.Position = UDim2.fromOffset(X, Y)
        end
        local function ShowTip(Label, Body)
            TipSerial += 1
            local Serial = TipSerial
            State.Lifecycle:Delay(0.35, function()
                if Serial ~= TipSerial then return end
                TipTitle.Text = string.upper(tostring(Label or ''))
                TipBody.Text = Body
                local Lines = math.clamp(math.ceil(#Body / 42), 1, 8)
                TipCard.Size = UDim2.fromOffset(250, 26 + Lines * 13)
                PlaceTip()
                TipCard.Visible = true
            end)
        end
        GiveSignal(UserInputService.InputChanged:Connect(function(Input)
            if TipCard.Visible and Input.UserInputType == Enum.UserInputType.MouseMovement then PlaceTip() end
        end))
        local KindHints = {
            Toggle = 'Click to switch this feature on or off.',
            Number = 'Numeric setting. Use the stepper arrows or type an exact value.',
            Selector = 'Click the arrows to cycle through the available options.',
            Dropdown = 'Click to open the list and pick an option.',
            Action = 'Click to run this action immediately.',
        }
        local function TipBodyFor(TipKey, Control)
            local Body = TooltipText[TipKey]
            if Body then return Body end
            Body = KindHints[Control.Kind] or 'Hub setting.'
            local Options = Control.Options
            if type(Options) == 'table' and #Options > 0 then
                local Preview = table.concat(Options, ', ')
                if #Preview > 110 then Preview = string.sub(Preview, 1, 107) .. '...' end
                Body = Body .. ' Options: ' .. Preview .. '.'
            end
            return Body
        end
        for TipKey, Control in pairs(HubUI.Controls) do
            if type(Control) == 'table' and Control.Kind then
                local Root = Control.Button or Control.SearchRoot
                if typeof(Root) == 'Instance' and Root:IsA('GuiObject') then
                    local Label = Control.SearchLabel or TipKey
                    local Body = TipBodyFor(TipKey, Control)
                    GiveSignal(Root.MouseEnter:Connect(function() ShowTip(Label, Body) end))
                    GiveSignal(Root.MouseLeave:Connect(HideTip))
                end
            end
        end

