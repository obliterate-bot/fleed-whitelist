function State.LogoBadges.NormalizeAssetId(Value)
    local Text = tostring(Value or ''):gsub('%s+', '')
    if Text == '' then return nil end
    local Digits = Text:match('id=(%d+)') or Text:match('(%d+)$') or Text:match('(%d+)')
    if not Digits then return nil end
    local Id = tonumber(Digits)
    if not Id or Id <= 0 then return nil end
    return math.floor(Id)
end

function State.LogoBadges.ResolveCustomImage(Id)
    local Cached = State.LogoBadges.CustomImageCache[Id]
    if Cached then return Cached end
    local Thumbnail = 'rbxthumb://type=Asset&id=' .. tostring(Id) .. '&w=420&h=420'
    State.LogoBadges.CustomImageCache[Id] = Thumbnail
    State.Lifecycle:Spawn(function()
        local Resolved = Thumbnail
        local Ok, Objects = pcall(function()
            return game:GetObjects('rbxassetid://' .. tostring(Id))
        end)
        if Ok and type(Objects) == 'table' then
            for _, Object in ipairs(Objects) do
                local Decal = Object:IsA('Decal') and Object or Object:FindFirstChildWhichIsA('Decal', true)
                local Image = Object:IsA('ImageLabel') and Object or Object:FindFirstChildWhichIsA('ImageLabel', true)
                if Decal and Decal.Texture ~= '' then
                    Resolved = Decal.Texture
                    break
                elseif Image and Image.Image ~= '' then
                    Resolved = Image.Image
                    break
                end
            end
        end
        State.LogoBadges.CustomImageCache[Id] = Resolved
        for _, Icon in ipairs(State.LogoBadges.CustomInstances) do
            if Icon and Icon.Parent and Icon.Name == State.LogoBadges.CustomPrefix .. tostring(Id) then
                pcall(function()
                    Icon.Image = Resolved
                    Icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
                    Icon.ImageTransparency = 0
                    Icon.Visible = true
                end)
            end
        end
    end)
    return Thumbnail
end

function State.LogoBadges.AddCustomLogo(Value)
    local Id = State.LogoBadges.NormalizeAssetId(Value)
    if not Id then return false, 'invalid asset id' end
    for _, Existing in ipairs(State.CustomLogos) do
        if Existing == Id then return false, 'already added' end
    end
    table.insert(State.CustomLogos, Id)
    State.LogoBadges.StartLoop()
    pcall(State.LogoBadges.Apply)
    return true
end

function State.LogoBadges.ClearCustomIcons(AlsoForgetIds)
    for Index = #State.LogoBadges.CustomInstances, 1, -1 do
        pcall(function() State.LogoBadges.CustomInstances[Index]:Destroy() end)
        State.LogoBadges.CustomInstances[Index] = nil
    end
    if AlsoForgetIds then
        for Index = #State.CustomLogos, 1, -1 do
            State.CustomLogos[Index] = nil
        end
    end
end

function State.LogoBadges.RemoveCustomLogo(Value)
    local Id = State.LogoBadges.NormalizeAssetId(Value)
    if not Id then return false end
    for Index = #State.CustomLogos, 1, -1 do
        if State.CustomLogos[Index] == Id then
            table.remove(State.CustomLogos, Index)
        end
    end
    State.LogoBadges.ClearCustomIcons(false)
    if State.LogoBadges.AnyActive() then pcall(State.LogoBadges.Apply) end
    return true
end

function State.LogoBadges.ApplyCustomLogos(Container)
    if typeof(Container) ~= 'Instance' then return end
    if #State.CustomLogos == 0 then return end
    local Template = Container:FindFirstChild(State.LogoBadges.CustomTemplate)
    if not Template or not Template:IsA('ImageLabel') then
        Template = nil
        for _, Child in ipairs(Container:GetChildren()) do
            if Child:IsA('ImageLabel') and not Child.Name:find(State.LogoBadges.CustomPrefix, 1, true) then
                Template = Child
                break
            end
        end
    end
    if not Template then return end
    for Index, Id in ipairs(State.CustomLogos) do
        local IconName = State.LogoBadges.CustomPrefix .. tostring(Id)
        local Icon = Container:FindFirstChild(IconName)
        if not Icon then
            local Ok, Clone = pcall(function() return Template:Clone() end)
            if Ok and Clone then

                pcall(function()
                    Clone.Name = IconName
                    Clone.LayoutOrder = 50 + Index
                    Clone.Visible = false
                    Clone.Parent = Container
                end)

                pcall(function()
                    local Gradient = Clone:FindFirstChildOfClass('UIGradient')
                    if Gradient then Gradient:Destroy() end

                    Clone.ScaleType = Enum.ScaleType.Fit
                    Clone.Image = State.LogoBadges.ResolveCustomImage(Id)
                    Clone.ImageColor3 = Color3.fromRGB(255, 255, 255)
                    Clone.ImageTransparency = 0
                    Clone.BackgroundTransparency = 1
                    Clone.Visible = true
                end)
                table.insert(State.LogoBadges.CustomInstances, Clone)
                Icon = Clone
            end
        end
        if Icon then
            pcall(function()
                Icon.Image = State.LogoBadges.ResolveCustomImage(Id)
                Icon.Visible = true
            end)
        end
    end
end

function State.LogoBadges.RefreshCustomButtons()
