                New('UICorner', { CornerRadius = UDim.new(0, 3) }, Row)
                New('TextLabel', {
                    Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -118, 1, 0), BackgroundTransparency = 1,
                    Font = Enum.Font.Code, Text = Entry.Label, TextColor3 = Entry.Kind == 'Command' and Theme.AccentBright or Theme.Text,
                    TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 294,
                    }, Row)
                local Status = New('TextLabel', {
                    AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, Entry.Kind == 'Number' and -56 or -8, 0, 0),
                    Size = UDim2.fromOffset(Entry.Kind == 'Number' and 52 or 100, 22), BackgroundTransparency = 1,
                    Font = Enum.Font.Code, Text = '', TextColor3 = Theme.Muted, TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 294,
                    }, Row)
                local function Repaint()
                    if Entry.Kind == 'Command' or Entry.Kind == 'Action' then
                        Status.Text = 'RUN'
                        Status.TextColor3 = Theme.Accent
                    elseif Entry.Kind == 'Toggle' then
                        Status.Text = Control.Value and 'ON' or 'OFF'
                        Status.TextColor3 = Control.Value and (Theme.Success or Theme.Accent) or Theme.Muted
                    else
                        Status.Text = tostring(Control.Value)
                        Status.TextColor3 = Theme.Accent
                    end
                end
                Repaint()
                if Entry.Kind == 'Number' then
                    local Minus = New('TextButton', {
                        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -30, 0, 3), Size = UDim2.fromOffset(20, 16),
                        BackgroundColor3 = Theme.Background, BorderSizePixel = 0, AutoButtonColor = false,
                        Font = Enum.Font.Code, Text = '-', TextColor3 = Theme.Text, TextSize = 11, ZIndex = 295,
                        }, Row)
                    New('UICorner', { CornerRadius = UDim.new(0, 3) }, Minus)
                    DarkStroke(Minus)
                    local Plus = New('TextButton', {
                        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 3), Size = UDim2.fromOffset(20, 16),
                        BackgroundColor3 = Theme.Background, BorderSizePixel = 0, AutoButtonColor = false,
                        Font = Enum.Font.Code, Text = '+', TextColor3 = Theme.Text, TextSize = 11, ZIndex = 295,
                        }, Row)
                    New('UICorner', { CornerRadius = UDim.new(0, 3) }, Plus)
                    DarkStroke(Plus)
                    GiveSignal(Minus.MouseButton1Click:Connect(function()
                        if Control.Step then pcall(function() Control:Step(-1) end) end
                        Repaint()
                    end))
                    GiveSignal(Plus.MouseButton1Click:Connect(function()
                        if Control.Step then pcall(function() Control:Step(1) end) end
                        Repaint()
                    end))
                end
                GiveSignal(Row.MouseButton1Click:Connect(function()
                    if Entry.Kind == 'Command' then
                        CloseModal()
                        Entry.Run()
                    elseif Entry.Kind == 'Toggle' then
                        pcall(function() Control:Set(not Control.Value, true) end)
                        Repaint()
                    elseif Entry.Kind == 'Selector' or Entry.Kind == 'Dropdown' then
                        local Options = Control.Options or {}
                        if #Options > 0 then
                            local Position = table.find(Options, Control.Value) or 0
                            pcall(function() Control:Set(Options[Position % #Options + 1], true) end)
                            Repaint()
                        end
                    elseif Entry.Kind == 'Action' then
                        pcall(Control.Trigger)
                        Status.Text = 'DONE'
                        State.Lifecycle:Delay(0.6, function()
