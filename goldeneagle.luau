local function DestroyRangeScreenTint()
    CancelRangeScreenTintTween()
    RangeScreenTint.Serial += 1
    RangeScreenTint.TargetVisible = false
    if RangeScreenTint.Gui then
        pcall(function() RangeScreenTint.Gui:Destroy() end)
    end
    if RangeScreenTint.ColorCorrection then
        pcall(function() RangeScreenTint.ColorCorrection:Destroy() end)
    end
    RangeScreenTint.Gui = nil
    RangeScreenTint.Group = nil
    RangeScreenTint.BlackHalf = nil
    RangeScreenTint.GoldHalf = nil
    RangeScreenTint.CenterBlend = nil
    RangeScreenTint.ColorCorrection = nil
end

