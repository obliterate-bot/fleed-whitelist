    local function QueryMatches(SearchText, Query)
        for Token in string.gmatch(Query, '%S+') do
            if not string.find(SearchText, Token, 1, true) then return false end
        end
        return true
    end

    local GlobalSearchQuerySerial = 0
    local function ApplyGlobalSettingSearch()
        GlobalSearchQuerySerial += 1
        local QuerySerial = GlobalSearchQuerySerial
        local Query = string.lower(GlobalSearchBox.Text or ''):gsub('^%s+', ''):gsub('%s+$', '')
        AnimateClearButton(ClearGlobalSearchButton, Query ~= '')
        VisibleGlobalResults = {}
        if Query ~= '' then
            local Prefix, Other = {}, {}
            for _, Entry in ipairs(GlobalSearchIndex) do
                if QueryMatches(Entry.SearchText, Query) then
                    local LabelLower = string.lower(Entry.Label)
                    table.insert(string.sub(LabelLower, 1, #Query) == Query and Prefix or Other, Entry)
                end
            end
            for _, Entry in ipairs(Prefix) do table.insert(VisibleGlobalResults, Entry) end
            for _, Entry in ipairs(Other) do table.insert(VisibleGlobalResults, Entry) end
        end

        SetGlobalSearchOpen(Query ~= '')
        Tween(GlobalSearchHeader, 0.07, { TextTransparency = 0.72 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        GlobalSearchHeader.Text = #VisibleGlobalResults > 0
            and (tostring(#VisibleGlobalResults) .. ' SETTING' .. (#VisibleGlobalResults == 1 and '' or 'S') .. ' FOUND')
            or 'NO SETTINGS FOUND'
        Tween(GlobalSearchHeader, 0.15, { TextTransparency = 0 })

        for Slot, RowData in ipairs(GlobalSearchRows) do
            local Entry = VisibleGlobalResults[Slot]
            RowData.AnimationSerial += 1
            local RowSerial = RowData.AnimationSerial
            RowData.Entry = Entry
            if Entry then
                local WasVisible = RowData.Button.Visible
                RowData.Button.Visible = true
                RowData.Label.Text = Entry.Label
                RowData.Meta.Text = string.upper(Entry.Page .. '  /  ' .. Entry.Category) .. '  •  ' .. Entry.Key
                if not WasVisible then
                    RowData.Button.Position = UDim2.fromOffset(8, (Slot - 1) * 28)
                    RowData.Button.BackgroundTransparency = 1
                    RowData.Label.TextTransparency = 1
                    RowData.Meta.TextTransparency = 1
                else
                    RowData.Label.TextTransparency = 0.42
                    RowData.Meta.TextTransparency = 0.55
                end
                State.Lifecycle:Delay((InterfaceConfig.ReducedMotion and 0 or HubUI.Motion.Stagger(Slot - 1)) / math.max(0.1, tonumber(InterfaceConfig.AnimationSpeed) or 1), function()
                    if QuerySerial ~= GlobalSearchQuerySerial or RowData.AnimationSerial ~= RowSerial or not RowData.Button.Parent then return end
                    Tween(RowData.Button, 0.16, {
                        Position = UDim2.fromOffset(0, (Slot - 1) * 28),
                        BackgroundTransparency = 0.06,
                        }, Enum.EasingStyle.Quart)
                    Tween(RowData.Label, 0.14, { TextTransparency = 0 })
                    Tween(RowData.Meta, 0.14, { TextTransparency = 0 })
                end)
            elseif RowData.Button.Visible then
                Tween(RowData.Button, 0.1, {
                    Position = UDim2.fromOffset(-6, (Slot - 1) * 28),
                    BackgroundTransparency = 1,
                    }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                Tween(RowData.Label, 0.08, { TextTransparency = 1 })
                Tween(RowData.Meta, 0.08, { TextTransparency = 1 })
                State.Lifecycle:Delay(HubUI.Motion.Hold(0.11), function()
                    if RowData.AnimationSerial == RowSerial and not RowData.Entry and RowData.Button.Parent then
                        RowData.Button.Visible = false
                    end
                end)
            end
        end
    end

