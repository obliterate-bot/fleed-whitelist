    if Visuals.CharacterHighlight and Visuals.CharacterHighlight.Enabled then
        pcall(function() Visuals.CharacterHighlight.Enabled = false end)
    end
    if not Visuals.Visible then return end
    for _, Object in ipairs(Visuals.All) do
        pcall(function() Object.Visible = false end)
