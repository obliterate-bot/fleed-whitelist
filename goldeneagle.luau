function State.Extras.SetLocalUnlock(Enabled)
    Enabled = Enabled == true
    local PlayerData = State.ClientSettings.PlayerData
    local Data = PlayerData and PlayerData.storedData
    local Inventory = Data and Data.Inventory
    local ShopItems = safe_find(ReplicatedStorage, 'ShopItems')
    if type(Inventory) ~= 'table' or not ShopItems then return false end
    if Enabled then
        table.clear(State.Extras.OriginalInventory)
        for _, Category in ipairs(ShopItems:GetChildren()) do
            for _, Item in ipairs(Category:GetChildren()) do
                if State.Extras.OriginalInventory[Item.Name] == nil then
                    State.Extras.OriginalInventory[Item.Name] = { Value = Inventory[Item.Name], Had = Inventory[Item.Name] ~= nil }
                end
                Inventory[Item.Name] = math.max(tonumber(Inventory[Item.Name]) or 0, 1)
            end
        end
    else
        for ItemName, Original in pairs(State.Extras.OriginalInventory) do
            Inventory[ItemName] = Original.Had and Original.Value or nil
        end
        table.clear(State.Extras.OriginalInventory)
    end
    State.Extras.LocalUnlockEnabled = Enabled
    CONFIG.LocalUnlockAllCosmetics = Enabled
    return true
end

