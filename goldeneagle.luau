    State.PassRange.ReceiverInRange = false
end

function State.PassRange.GetHighlight(Character)
    local Range = State.PassRange
    local Existing = Range.Highlight
    if Existing and Existing.Parent == HiddenGui() and Existing.Adornee == Character then return Existing end
    if Existing then pcall(function() Existing:Destroy() end) end
    local Highlight = Instance.new('Highlight')
    Highlight.Name = 'GoldenEaglePassRangeHighlight'
    Highlight.Adornee = Character
    Highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    Highlight.FillTransparency = 0.72
    Highlight.OutlineTransparency = 0.04
    Highlight.Enabled = false
    Highlight.Parent = HiddenGui()
    Range.Highlight = Highlight
    return Highlight
end

function State.PassRange.Update()
    local Range = State.PassRange
    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    if not (State.Active and State.AutoPassEnabled and CONFIG.PassRangeIndicator
        and Character and Root and GetHeldBasketballModel(LP)) then
        State.PassRange.Hide()
        return
    end

    local Maximum = State.PassRange.GetMaximum()
    local InRange = false
    for _, Teammate in ipairs(GetPassTeammates()) do
        local TargetCharacter = Teammate.Character
        local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild('HumanoidRootPart')
        if TargetRoot then
            local Delta = TargetRoot.Position - Root.Position
            local HorizontalDistance = Vector3.new(Delta.X, 0, Delta.Z).Magnitude
            if HorizontalDistance <= Maximum then
                InRange = true
                break
            end
        end
    end

    Range.ReceiverInRange = InRange
    local Highlight = State.PassRange.GetHighlight(Character)
    Highlight.Enabled = InRange
end

function State.PassRange.Render()
    local Range = State.PassRange
    local Highlight = Range.Highlight
    if not (Range.ReceiverInRange and Highlight and Highlight.Parent and Highlight.Enabled) then return end
    local Pulse = (math.sin(os.clock() * 4.2) + 1) * 0.5
    Highlight.FillColor = Range.FillA:Lerp(Range.FillB, Pulse)
    Highlight.OutlineColor = Range.OutlineColor
    Highlight.FillTransparency = 0.76 - Pulse * 0.12
    Highlight.OutlineTransparency = 0.03
end

local function UpdatePassLabels()
    if not State.AutoPassEnabled then
        if #State.PassLabels > 0 then ClearPassLabels() end
        return
    end

    local Teammates = GetPassTeammates()
    local Count = math.min(#Teammates, 5)
    while #State.PassLabels > Count do
        DestroyPassLabel(table.remove(State.PassLabels))
    end

    local GoldAlpha = (math.sin(os.clock() * 1.8) + 1) * 0.5
    local Accent = Color3.fromRGB(212, 175, 55):Lerp(Color3.fromRGB(255, 226, 122), GoldAlpha)
    for Index = 1, Count do
        local Teammate = Teammates[Index]
        local Head = Teammate.Character and Teammate.Character:FindFirstChild('Head')
        local Data = State.PassLabels[Index]
        if Head then
            if not Data or not Data.Gui or not Data.Gui.Parent then
                if Data then DestroyPassLabel(Data) end
                Data = CreatePassLabel(Index, Head)
                State.PassLabels[Index] = Data
            end
            Data.Gui.Enabled = true
            Data.Gui.Adornee = Head
            local LabelParent = HiddenGui()
            if Data.Gui.Parent ~= LabelParent then Data.Gui.Parent = LabelParent end
            Data.Label.Text = tostring(Index)
            Data.Stroke.Color = Accent
        elseif Data and Data.Gui then
            Data.Gui.Enabled = false
        end
    end
end

