    local function ResolveSearchPage(Control)
        local Current = Control and Control.SearchParent
        while Current do
            for PageName, Page in pairs(Pages) do
                if Current == Page then return PageName end
            end
            Current = Current.Parent
        end
        return nil
    end

    local CategoryByPage = {}
    for _, Definition in ipairs(TabDefinitions) do
        CategoryByPage[Definition.Name] = Definition.Category
    end

    local function AddGlobalSearchEntry(Key, Label, PageName, Root, Keywords)
        if not (Label and PageName and Pages[PageName]) then return end
        local SearchText = string.lower(table.concat({
            tostring(Label), tostring(Key or ''), tostring(PageName),
            tostring(CategoryByPage[PageName] or ''), tostring(Keywords or '')
            }, ' '))
        table.insert(GlobalSearchIndex, {
            Key = tostring(Key or Label),
            Label = tostring(Label),
            Page = PageName,
            Category = CategoryByPage[PageName] or 'SETTINGS',
            Root = Root,
            SearchText = SearchText,
        })
    end

    for Key, Control in pairs(HubUI.Controls) do
        if type(Control) == 'table' and Control.SearchLabel then
            AddGlobalSearchEntry(Key, Control.SearchLabel, ResolveSearchPage(Control), Control.SearchRoot)
        end
    end
    AddGlobalSearchEntry('LocalAlias', 'Local alias', 'Privacy', AliasBox, 'anonymous name identity')
    AddGlobalSearchEntry('LocalELOValue', 'Local ELO amount', 'Cosmetics', ELOBox, 'rank elo spoof value')

    table.sort(GlobalSearchIndex, function(A, B)
        if A.Page == B.Page then return A.Label < B.Label end
        return A.Page < B.Page
    end)

    local GlobalSearchAnimationSerial = 0
    local GlobalSearchIsOpen = false
    local function SetGlobalSearchOpen(Value)
        Value = Value == true
        if Value == GlobalSearchIsOpen and (not Value or GlobalSearchResults.Visible) then return end
        GlobalSearchAnimationSerial += 1
        local Serial = GlobalSearchAnimationSerial
        GlobalSearchIsOpen = Value
        if Value then
            local WasVisible = GlobalSearchResults.Visible
            if not WasVisible then
                GlobalSearchResults.Position = UDim2.fromOffset(218, 31)
                GlobalSearchResults.GroupTransparency = 1
                GlobalSearchResultsScale.Scale = 0.98
                GlobalSearchAccentLine.BackgroundTransparency = 1
            end
            GlobalSearchResults.Visible = true
            Tween(GlobalSearchResults, 0.25, {
                Position = UDim2.fromOffset(218, 34),
                GroupTransparency = 0,
                }, Enum.EasingStyle.Sine)
            Tween(GlobalSearchResultsScale, 0.26, { Scale = 1 }, Enum.EasingStyle.Quint)
            Tween(GlobalSearchResultsStroke, 0.24, { Transparency = 0.15 }, Enum.EasingStyle.Sine)
            Tween(GlobalSearchAccentLine, 0.26, { BackgroundTransparency = 0.18 }, Enum.EasingStyle.Sine)
        else
            Tween(GlobalSearchResults, 0.18, {
                Position = UDim2.fromOffset(218, 31),
                GroupTransparency = 1,
                }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(GlobalSearchResultsScale, 0.18, { Scale = 0.985 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(GlobalSearchAccentLine, 0.14, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            State.Lifecycle:Delay(HubUI.Motion.Hold(0.19), function()
                if GlobalSearchAnimationSerial == Serial and not GlobalSearchIsOpen and GlobalSearchResults.Parent then
                    GlobalSearchResults.Visible = false
                end
            end)
        end
    end

    local function CloseGlobalSearch(ClearText)
        SetGlobalSearchOpen(false)
        VisibleGlobalResults = {}
        if ClearText then GlobalSearchBox.Text = '' end
    end

    local function FlashSearchTarget(Entry)
        local Root = Entry and Entry.Root
        if not (Root and Root.Parent and Root:IsA('GuiObject')) then return end
        local Existing = Root:FindFirstChild('GoldenEagleSearchHighlight')
        if Existing then Existing:Destroy() end
        local Highlight = New('UIStroke', {
            Name = 'GoldenEagleSearchHighlight',
            Color = Theme.Accent,
            Thickness = 2.6,
            Transparency = 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            LineJoinMode = Enum.LineJoinMode.Round,
            }, Root)
        State.Lifecycle:Spawn(function()
            for Step = 1, 18 do
                if not (Highlight and Highlight.Parent) then return end
                Highlight.Transparency = (Step / 18) * 0.92
                Highlight.Thickness = 2.6 + math.sin(Step * 0.85) * 0.7
                task.wait(HubUI.Motion.Hold(0.035))
            end
            if Highlight and Highlight.Parent then Highlight:Destroy() end
        end)
    end

    local function OpenGlobalSearchResult(Entry)
        if not Entry then return end
        GlobalSearchBox:ReleaseFocus()
        CloseGlobalSearch(true)
        SwitchTab(Entry.Page)
        State.Lifecycle:Delay(0.23, function() FlashSearchTarget(Entry) end)
    end

