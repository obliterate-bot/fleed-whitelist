local FindGoalPartInHitboxFolder
FindGoalPartInHitboxFolder = WYNF_JIT_MAX(function(Hitboxes)
    if Hitboxes == nil then
        return nil
    end

    for _, GoalName in ipairs({ 'Goal', 'GoalHome', 'GoalAway' }) do
        local Goal = safe_find(Hitboxes, GoalName)
        if Goal and safe_is_a(Goal, 'BasePart') then
            return Goal
        end
    end

    local FieldGoal = safe_find(Hitboxes, 'FieldGoal')
    local NestedGoal = FieldGoal and (safe_find(FieldGoal, 'Goal')
        or safe_find(FieldGoal, 'GoalHome') or safe_find(FieldGoal, 'GoalAway'))
    if NestedGoal and safe_is_a(NestedGoal, 'BasePart') then
        return NestedGoal
    end

    return nil
end)

local FindNearestGoalFromPosition
FindNearestGoalFromPosition = WYNF_JIT_MAX(function(OriginPosition, CourtFilter)
    if typeof(OriginPosition) ~= 'Vector3' then
        return nil, math.huge
    end

    local NearestGoal = nil
    local ShortestDistance = math.huge
    local OriginXZ = Vector3.new(OriginPosition.X, 0, OriginPosition.Z)

    for _, Hitboxes in ipairs(GoalData.check) do
        if CourtFilter == nil or Hitboxes:IsDescendantOf(CourtFilter) then
            local Goal = FindGoalPartInHitboxFolder(Hitboxes)
            if Goal then
                local GoalXZ = Vector3.new(Goal.Position.X, 0, Goal.Position.Z)
                local Distance = (OriginXZ - GoalXZ).Magnitude
                if Distance < ShortestDistance then
                    ShortestDistance = Distance
                    NearestGoal = Goal
                end
            end
        end
    end

    return NearestGoal, ShortestDistance
end)

local GetHeldBasketballModel
GetHeldBasketballModel = WYNF_JIT_MAX(function(player)
    local TargetPlayer = player or LP
    local Character = TargetPlayer and TargetPlayer.Character
    if not Character then
        if TargetPlayer then
            PerfCache.BallValue[TargetPlayer] = nil
            PerfCache.BallChar[TargetPlayer] = nil
            PerfCache.BallAt[TargetPlayer] = nil
        end
        return nil
    end

    local Now = os.clock()
    if PerfCache.BallChar[TargetPlayer] == Character
        and (Now - (PerfCache.BallAt[TargetPlayer] or 0)) < 0.05 then
        local Cached = PerfCache.BallValue[TargetPlayer]
        if Cached == nil or Cached.Parent then return Cached end
    end

    local Resolved = nil
    local Basketball = safe_find(Character, 'Basketball')
    if Basketball and safe_find(Basketball, 'Ball') then
        Resolved = Basketball
    end

    PerfCache.BallValue[TargetPlayer] = Resolved
    PerfCache.BallChar[TargetPlayer] = Character
    PerfCache.BallAt[TargetPlayer] = Now
    return Resolved
end)

local function SafeGetAttributes(Instance, EmptyValue)
    if Instance == nil then
        return EmptyValue
    end

    local Ok, Attributes = pcall(function()
        return Instance:GetAttributes()
    end)
    if Ok and type(Attributes) == 'table' then
        return Attributes
    end

    return EmptyValue
end

