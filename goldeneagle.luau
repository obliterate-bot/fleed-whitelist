function State.Utility.FindServer()
    local Request = State.Utility.GetRequestFunction()
    if not Request then return nil, 'HTTP REQUEST UNAVAILABLE' end
    local Cursor = ''
    local Candidates = {}
    for _ = 1, 3 do
        local Url = 'https://games.roblox.com/v1/games/' .. tostring(game.PlaceId)
        .. '/servers/Public?sortOrder=Asc&limit=100'
        .. (Cursor ~= '' and ('&cursor=' .. State.Utility.HttpService:UrlEncode(Cursor)) or '')
        local Success, Response = pcall(Request, { Url = Url, Method = 'GET' })
        if not Success or type(Response) ~= 'table' then return nil, 'SERVER LIST FAILED' end
        local Body = Response.Body or Response.body
        local DecodeOk, Data = pcall(State.Utility.HttpService.JSONDecode, State.Utility.HttpService, Body or '')
        if not DecodeOk or type(Data) ~= 'table' then return nil, 'SERVER DATA INVALID' end
        for _, Server in ipairs(Data.data or {}) do
            if Server.id ~= game.JobId and tonumber(Server.playing) and tonumber(Server.maxPlayers)
                and Server.playing < Server.maxPlayers then
                table.insert(Candidates, Server)
            end
        end
        Cursor = tostring(Data.nextPageCursor or '')
        if Cursor == '' then break end
    end
    table.sort(Candidates, function(A, B)
        local APing = tonumber(A.ping) or 9999
        local BPing = tonumber(B.ping) or 9999
        local AScore = APing - math.min(tonumber(A.playing) or 0, 20) * 2
        local BScore = BPing - math.min(tonumber(B.playing) or 0, 20) * 2
        return AScore < BScore
    end)
    return Candidates[1], #Candidates > 0 and nil or 'NO OPEN SERVER'
end

