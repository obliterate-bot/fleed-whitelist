    PlaceId = 6229116934,
    Folder = 'GoldenEagle_Configs',
    LastLoaded = nil,
}

function State.AutoConfig.FindLatest()
    if game.PlaceId ~= State.AutoConfig.PlaceId then return nil end
    local Folder = State.AutoConfig.Folder
    local LatestName, LatestTime = nil, -math.huge

    if type(isfolder) == 'function' and type(listfiles) == 'function' then
        local FolderOk, Exists = pcall(isfolder, Folder)
        if FolderOk and Exists then
            local ListOk, Files = pcall(listfiles, Folder)
            if ListOk and type(Files) == 'table' then
                for _, Path in ipairs(Files) do
                    local Stem = tostring(Path):match('([^/\\]+)%.json$')
                    if Stem then
                        local Modified = 0
                        if type(lastmodified) == 'function' then
                            local TimeOk, Time = pcall(lastmodified, Path)
                            if TimeOk then Modified = tonumber(Time) or 0 end
                        end
                        if LatestName == nil or Modified > LatestTime then
                            LatestName = Stem:gsub('_', ' ')
                            LatestTime = Modified
                        end
                    end
                end
            end
        end
    end

    if LatestName == nil and type(GlobalEnv.__GOLDEN_EAGLE_CONFIGS) == 'table' then
        for Name, Profile in pairs(GlobalEnv.__GOLDEN_EAGLE_CONFIGS) do
            local SavedAt = type(Profile) == 'table' and tonumber(Profile.SavedAt) or 0
            if LatestName == nil or SavedAt > LatestTime then
                LatestName = tostring(Name)
                LatestTime = SavedAt
            end
        end
    end
    return LatestName
end

function State.AutoConfig.LoadLatest()
    if game.PlaceId ~= State.AutoConfig.PlaceId then return false end
    if not (type(HubUI) == 'table' and type(HubUI.Configs) == 'table'
        and type(HubUI.Configs.Read) == 'function' and type(HubUI.Configs.Apply) == 'function') then
        return false
    end
    local Name = State.AutoConfig.FindLatest()
    if not Name then return false end
    local Profile = HubUI.Configs.Read(Name)
    if type(Profile) ~= 'table' then return false end
    HubUI.Configs.Apply(Profile)
    State.AutoConfig.LastLoaded = Name
    return true, Name
end

