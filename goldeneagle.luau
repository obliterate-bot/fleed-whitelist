}

function State.OffenseTrainer.ModeKey()
    return IsArenaMode and 'arena' or 'park'
end

function State.OffenseTrainer.GetCourt()
    local Court = select(1, ResolvePlayerCourt(LP))
    if not Court and IsArenaMode then Court = safe_find(Workspace, 'Court') end
    return Court
end

function State.OffenseTrainer.GetMyTeam(Court)
    local Ok, Team = pcall(ResolvePlayerCourtTeam, LP, Court or State.OffenseTrainer.GetCourt())
    if Ok then return Team end
    return nil
end

function State.OffenseTrainer.GetCourtNumber(Court, Name)
    local Ok, Value = pcall(function()
        return State.Watch.GetCourtValue(Court, Name)
    end)
    if Ok then return tonumber(Value) end
    return nil
end

function State.OffenseTrainer.GetOpponents(Court, MyTeam)
    local List = {}
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LP then
            local Include = false
            local Ok, Result = pcall(IsGuardOpponent, Player)
            if Ok and Result == true then
                Include = true
            elseif MyTeam then
                local TeamOk, TheirTeam = pcall(ResolvePlayerCourtTeam, Player, Court)
                Include = TeamOk and TheirTeam ~= nil and TheirTeam ~= MyTeam
            end
            if Include then table.insert(List, Player) end
        end
    end
    return List
end

function State.OffenseTrainer.BuildFeatures()
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local HumanoidObject = Character and safe_find(Character, 'Humanoid')
    if not (Root and HumanoidObject and HumanoidObject.Health > 0) then return nil end

    local Rim = select(1, FindConfiguredGoal())
    if not Rim then return nil end

    local Position = Root.Position
    local ToGoal = Rim.Position - Position
    local FlatToGoal = Vector3.new(ToGoal.X, 0, ToGoal.Z)
    local GoalDistance = FlatToGoal.Magnitude
    if GoalDistance < 0.05 then return nil end
    local GoalDirection = FlatToGoal.Unit

    local Facing = Root.CFrame.LookVector
    local FlatFacing = Vector3.new(Facing.X, 0, Facing.Z)
    FlatFacing = FlatFacing.Magnitude > 0.001 and FlatFacing.Unit or GoalDirection

    local Velocity = Root.AssemblyLinearVelocity
    local FlatVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)

    local Court = State.OffenseTrainer.GetCourt()
    local MyTeam = State.OffenseTrainer.GetMyTeam(Court)

    local DefenderDistance, DefenderAngle, DefenderClosing = 99, 0, 0
    local DefenderOk, Defender, RawDistance = pcall(State.AutoOffense.GetDefender)
    if DefenderOk and Defender then
        local DefenderRoot = Defender.Character and safe_find(Defender.Character, 'HumanoidRootPart')
        if DefenderRoot then
            local ToDefender = DefenderRoot.Position - Position
            local FlatToDefender = Vector3.new(ToDefender.X, 0, ToDefender.Z)
            DefenderDistance = math.min(tonumber(RawDistance) or FlatToDefender.Magnitude, 99)
            if FlatToDefender.Magnitude > 0.001 then
                local Unit = FlatToDefender.Unit
                DefenderAngle = math.deg(math.atan2(
                    GoalDirection:Cross(Unit).Y, GoalDirection:Dot(Unit)))
                local Relative = DefenderRoot.AssemblyLinearVelocity - Velocity
                DefenderClosing = -Vector3.new(Relative.X, 0, Relative.Z):Dot(Unit)
            end
        end
    end

    local Opponents = State.OffenseTrainer.GetOpponents(Court, MyTeam)
    local HelpCount = 0
    for _, Player in ipairs(Opponents) do
        local OpponentRoot = Player.Character and safe_find(Player.Character, 'HumanoidRootPart')
        if OpponentRoot and (OpponentRoot.Position - Position).Magnitude <= 12 then
            HelpCount += 1
        end
    end

    local TeammateDistance, TeammateOpenness = 99, 99
    local TeammatesOk, Teammates = pcall(GetPassTeammates)
    if TeammatesOk and type(Teammates) == 'table' then
        for _, Player in ipairs(Teammates) do
            local MateRoot = Player.Character and safe_find(Player.Character, 'HumanoidRootPart')
            if MateRoot then
                local Gap = (MateRoot.Position - Position).Magnitude
                if Gap < TeammateDistance then
                    TeammateDistance = math.min(Gap, 99)
                    local Nearest = 99
                    for _, Opponent in ipairs(Opponents) do
                        local OpponentRoot = Opponent.Character
                            and safe_find(Opponent.Character, 'HumanoidRootPart')
                        if OpponentRoot then
                            Nearest = math.min(Nearest,
                                (OpponentRoot.Position - MateRoot.Position).Magnitude)
                        end
                    end
                    TeammateOpenness = Nearest
                end
            end
        end
    end

    local HomeScore = State.OffenseTrainer.GetCourtNumber(Court, 'HomeScore') or 0
    local AwayScore = State.OffenseTrainer.GetCourtNumber(Court, 'AwayScore') or 0
    local Margin = 0
    if MyTeam == 'Away' then
        Margin = AwayScore - HomeScore
    elseif MyTeam == 'Home' then
        Margin = HomeScore - AwayScore
    end

    local function Round(Value, Places)
        local Scale = 10 ^ (Places or 2)
        return math.floor((tonumber(Value) or 0) * Scale + 0.5) / Scale
    end

    return {
        gd = Round(GoalDistance, 1),
        ga = Round(math.deg(math.acos(math.clamp(
        FlatFacing:Dot(GoalDirection), -1, 1))), 0),
        dd = Round(DefenderDistance, 1),
        da = Round(DefenderAngle, 0),
        dc = Round(DefenderClosing, 1),
        help = HelpCount,
        td = Round(TeammateDistance, 1),
        to = Round(TeammateOpenness, 1),
        sp = Round(FlatVelocity.Magnitude, 1),
        vg = Round(FlatVelocity:Dot(GoalDirection), 1),
        btb = FlatFacing:Dot(GoalDirection) < 0 and 1 or 0,
        gr = HumanoidObject.FloorMaterial ~= Enum.Material.Air and 1 or 0,
        clk = Round(State.OffenseTrainer.GetCourtNumber(Court, 'Shotclock') or -1, 0),
        mg = Margin,
    }
end

function State.OffenseTrainer.Commit(Action, Features, Weight)
    if not (Action and Features) then return nil end
    local Samples = State.OffenseTrainer.Samples
    local Row = {
        a = Action,
        w = tonumber(Weight) or 1,
        m = State.OffenseTrainer.ModeKey(),
        t = os.time(),
        f = Features,
    }
    table.insert(Samples, Row)

    local Maximum = math.clamp(
        math.floor(tonumber(CONFIG.OffenseTrainerMaxSamples) or 4000), 200, 20000)
    while #Samples > Maximum do table.remove(Samples, 1) end

    State.OffenseTrainer.LastAction = Action
    State.OffenseTrainer.LastOutcome = 'PENDING'
    State.OffenseTrainer.MarkDirty()
    return Row
end

function State.OffenseTrainer.MarkDirty()
    State.OffenseTrainer.Dirty += 1
    State.OffenseTrainer.CountsAt = 0
    if CONFIG.OffenseTrainerAutoSave and State.OffenseTrainer.Dirty >= 25 then
        State.OffenseTrainer.Save()
    end
end

function State.OffenseTrainer.Resolve(Row, Outcome)
    if not Row then return end
    if Outcome == nil then
        Row.o = nil
        State.OffenseTrainer.LastOutcome = 'UNSCORED'
    else
        Row.o = Outcome and 1 or 0
        State.OffenseTrainer.LastOutcome = Outcome and 'GOOD' or 'BAD'
    end
    State.OffenseTrainer.MarkDirty()
end

function State.OffenseTrainer.WatchShotOutcome(Row)
    local Court = State.OffenseTrainer.GetCourt()
    local MyTeam = State.OffenseTrainer.GetMyTeam(Court)
    local HomeBefore = State.OffenseTrainer.GetCourtNumber(Court, 'HomeScore')
    local AwayBefore = State.OffenseTrainer.GetCourtNumber(Court, 'AwayScore')
    State.Lifecycle:Delay(3, function()
        if Row.p == nil then
            Row.p = (State.PerfectRelease and State.PerfectRelease.LastResult == 'PERFECT')
                and 1 or 0
        end
        if not MyTeam or HomeBefore == nil or AwayBefore == nil then
            State.OffenseTrainer.Resolve(Row, nil)
            return
        end
        local HomeAfter = State.OffenseTrainer.GetCourtNumber(Court, 'HomeScore') or HomeBefore
        local AwayAfter = State.OffenseTrainer.GetCourtNumber(Court, 'AwayScore') or AwayBefore
        local Scored
        if MyTeam == 'Away' then
            Scored = AwayAfter > AwayBefore
        else
            Scored = HomeAfter > HomeBefore
        end
        State.OffenseTrainer.Resolve(Row, Scored)
    end)
end

function State.OffenseTrainer.WatchPassOutcome(Row)
    State.Lifecycle:Delay(1.5, function()
        local Success = false
        local Ok, Teammates = pcall(GetPassTeammates)
        if Ok and type(Teammates) == 'table' then
            for _, Player in ipairs(Teammates) do
                if GetHeldBasketballModel(Player) then
                    Success = true
                    break
                end
            end
        end
        if not Success and GetHeldBasketballModel(LP) then Success = true end
        State.OffenseTrainer.Resolve(Row, Success)
    end)
end

function State.OffenseTrainer.WatchMotionOutcome(Row, Features)
    State.Lifecycle:Delay(2.5, function()
        local Later = State.OffenseTrainer.BuildFeatures()
        if not Later then
            State.OffenseTrainer.Resolve(Row, nil)
            return
        end
        local Improved = Later.dd > Features.dd + 1.5
        local KeptBall = GetHeldBasketballModel(LP) ~= nil
        State.OffenseTrainer.Resolve(Row, Improved and KeptBall)
    end)
end

function State.OffenseTrainer.ClassifyMotion(Features)
    if Features.sp < 3 then return nil end
    if Features.btb == 1 and Features.dd <= 10 then return 'backdown' end
    if Features.vg > 6 then return 'drive' end
    if Features.vg < -4 then return 'reset' end
    return nil
end

function State.OffenseTrainer.OnRelease(Now)
    local Features = State.OffenseTrainer.LastFeatures
    if not Features then return end
    local Airborne = (Now - State.OffenseTrainer.AirborneAt) <= 0.9
    local Action
    if Airborne and Features.gd <= 14 then
        Action = 'dunk'
    elseif Airborne then
        Action = 'shoot'
    else
        Action = 'pass'
    end
    local Row = State.OffenseTrainer.Commit(Action, Features, 1)
    if not Row then return end
    if Action == 'pass' then
        State.OffenseTrainer.WatchPassOutcome(Row)
    else
        State.OffenseTrainer.WatchShotOutcome(Row)
    end
end

function State.OffenseTrainer.Step()
    if not (State.Active and State.OffenseTrainer.Recording) then return end

    local Now = os.clock()
    local Interval = math.clamp(
        tonumber(CONFIG.OffenseTrainerSampleInterval) or 0.15, 0.05, 1)
    if Now - State.OffenseTrainer.LastSampleAt < Interval then return end
    State.OffenseTrainer.LastSampleAt = Now

    local HasBall = GetHeldBasketballModel(LP) ~= nil

    if HasBall then
        local Features = State.OffenseTrainer.BuildFeatures()
        if Features then
            State.OffenseTrainer.LastFeatures = Features
            State.OffenseTrainer.Status = 'RECORDING'
            if Features.gr == 0 then State.OffenseTrainer.AirborneAt = Now end
            if Now - State.OffenseTrainer.LastMotionLabelAt >= 1 then
                State.OffenseTrainer.LastMotionLabelAt = Now
                local Action = State.OffenseTrainer.ClassifyMotion(Features)
                if Action then
                    local Row = State.OffenseTrainer.Commit(Action, Features, 0.5)
                    State.OffenseTrainer.WatchMotionOutcome(Row, Features)
                end
            end
        else
            State.OffenseTrainer.Status = 'NO GOAL IN RANGE'
        end
    else
        State.OffenseTrainer.Status = 'WAITING FOR BALL'
        State.OffenseTrainer.LastMotionLabelAt = Now
    end

    if State.OffenseTrainer.HadBall and not HasBall then
        State.OffenseTrainer.OnRelease(Now)
        State.OffenseTrainer.LastFeatures = nil
    end
    State.OffenseTrainer.HadBall = HasBall
end

function State.OffenseTrainer.GetCounts()
    local Now = os.clock()
    if Now - State.OffenseTrainer.CountsAt < 0.5 then
        return State.OffenseTrainer.CountsTotal, State.OffenseTrainer.CountsLabeled,
        State.OffenseTrainer.CountsGood, State.OffenseTrainer.CountsByAction
    end
    local Total, Labeled, Good = 0, 0, 0
    local ByAction = {}
    for _, Row in ipairs(State.OffenseTrainer.Samples) do
        Total += 1
        ByAction[Row.a] = (ByAction[Row.a] or 0) + 1
        if Row.o ~= nil then
            Labeled += 1
            if Row.o == 1 then Good += 1 end
        end
    end
    State.OffenseTrainer.CountsAt = Now
    State.OffenseTrainer.CountsTotal = Total
    State.OffenseTrainer.CountsLabeled = Labeled
    State.OffenseTrainer.CountsGood = Good
    State.OffenseTrainer.CountsByAction = ByAction
    return Total, Labeled, Good, ByAction
end

function State.OffenseTrainer.Save()
    if type(writefile) ~= 'function' then
        State.OffenseTrainer.Status = 'FILE IO UNAVAILABLE'
        return false
    end
    local Ok = pcall(function()
        writefile(CONFIG.OffenseTrainerFile, State.Utility.HttpService:JSONEncode({
            Version = 1,
            Saved = os.time(),
            Samples = State.OffenseTrainer.Samples,
        }))
    end)
    if Ok then
        State.OffenseTrainer.Dirty = 0
        State.OffenseTrainer.LastSaveAt = os.clock()
    end
    return Ok
end

function State.OffenseTrainer.Load()
    if State.OffenseTrainer.Loaded then return end
    State.OffenseTrainer.Loaded = true
    if type(readfile) ~= 'function' or type(isfile) ~= 'function' then return end
    pcall(function()
        if not isfile(CONFIG.OffenseTrainerFile) then return end
        local Data = State.Utility.HttpService:JSONDecode(readfile(CONFIG.OffenseTrainerFile))
        if type(Data) == 'table' and type(Data.Samples) == 'table' then
            State.OffenseTrainer.Samples = Data.Samples
            State.OffenseTrainer.CountsAt = 0
        end
    end)
end

function State.OffenseTrainer.Clear()
    table.clear(State.OffenseTrainer.Samples)
    State.OffenseTrainer.LastAction = '--'
    State.OffenseTrainer.LastOutcome = '--'
    State.OffenseTrainer.CountsAt = 0
    State.OffenseTrainer.Dirty = 1
    State.OffenseTrainer.Save()
end

function State.OffenseTrainer.SetRecording(Enabled, ShouldNotify)
    Enabled = Enabled == true
    CONFIG.OffenseTrainer = Enabled
    State.OffenseTrainer.Recording = Enabled
    if Enabled then
        State.OffenseTrainer.Load()
        State.OffenseTrainer.HadBall = GetHeldBasketballModel(LP) ~= nil
        State.OffenseTrainer.LastFeatures = nil
        State.OffenseTrainer.LastMotionLabelAt = os.clock()
        State.OffenseTrainer.Status = 'RECORDING'
        if ShouldNotify then
            Notify('OFFENSE TRAINER', 'Recording your offense decisions.')
        end
    else
        State.OffenseTrainer.Status = 'OFF'
        if State.OffenseTrainer.Dirty > 0 then State.OffenseTrainer.Save() end
        if ShouldNotify then
            Notify('OFFENSE TRAINER', 'Recording stopped. Training data saved.')
        end
    end
    if HubUI.Sync then HubUI.Sync() end
end

State.OffenseTrainer.Load()
if CONFIG.OffenseTrainer then State.OffenseTrainer.SetRecording(true, false) end

