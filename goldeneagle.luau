local PRACTICE_PASS_COURT_RADIUS = 150

local function GetPracticePassCourt(Player)
    local Character = Player and Player.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    if not Root then return nil end

    local Court, Distance = FindNearestPracticeCourtFromPosition(Root.Position)
    if Court and Distance <= PRACTICE_PASS_COURT_RADIUS then
        return Court
    end
    return nil
end

local function SortPassRoster(Roster)
    table.sort(Roster, function(A, B)
        return A.UserId < B.UserId
    end)
    return Roster
end

function State.IsPassTeammate(A, B, Court, ASlotName, ASlot, BSlotName, BSlot)
    if not (A and B) then return false end
    local ASide = ResolvePlayerCourtTeam(A, Court, ASlotName, ASlot)
    local BSide = ResolvePlayerCourtTeam(B, Court, BSlotName, BSlot)
    if ASide and BSide then return ASide == BSide end

    if A.Team and B.Team and not A.Neutral and not B.Neutral then
        return A.Team == B.Team
    end

    for _, AttributeName in ipairs({ 'Team', 'TeamName', 'Side', 'CourtSide' }) do
        local AValue = safe_get_attribute(A, AttributeName)
        local BValue = safe_get_attribute(B, AttributeName)
        if AValue ~= nil and BValue ~= nil then
            return tostring(AValue) == tostring(BValue)
        end
        local ACharacter = A.Character
        local BCharacter = B.Character
        AValue = ACharacter and safe_get_attribute(ACharacter, AttributeName)
        BValue = BCharacter and safe_get_attribute(BCharacter, AttributeName)
        if AValue ~= nil and BValue ~= nil then
            return tostring(AValue) == tostring(BValue)
        end
    end
    return false
end

function PerfCache.GetPassTeammatesRaw()
    local Teammates = {}

    if State.Movement.IsInMatch() then
        local Court, SlotName, Slot = ResolvePlayerCourt(LP)
        if not Court and IsArenaMode then Court = safe_find(Workspace, 'Court') end
        local CourtPlayers = Court and (safe_find(Court, '_CourtPlayers') or safe_find(Court, 'CourtPlayers'))

        if CourtPlayers then
            for _, TeammateSlot in ipairs(CourtPlayers:GetChildren()) do
                local Player = safe_is_a(TeammateSlot, 'ObjectValue') and TeammateSlot.Value or nil
                if Player and Player ~= LP and safe_is_a(Player, 'Player')
                    and State.IsPassTeammate(LP, Player, Court, SlotName, Slot, TeammateSlot.Name, TeammateSlot) then
                    table.insert(Teammates, Player)
                end
            end
            return SortPassRoster(Teammates)
        end

        if IsArenaMode then
            for _, Player in ipairs(Players:GetPlayers()) do
                if Player ~= LP then
                    local TargetCharacter = Player.Character
                    local TargetRoot = TargetCharacter and safe_find(TargetCharacter, 'HumanoidRootPart')
                    local TargetHumanoid = TargetCharacter and safe_find(TargetCharacter, 'Humanoid')
                    if TargetRoot and TargetHumanoid and TargetHumanoid.Health > 0
                        and State.IsPassTeammate(LP, Player, Court, SlotName, Slot) then
                        table.insert(Teammates, Player)
                    end
                end
            end
            return SortPassRoster(Teammates)
        end
        return Teammates
    end

    local PracticeCourt = GetPracticePassCourt(LP)
    if not PracticeCourt then return Teammates end

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LP and GetPracticePassCourt(Player) == PracticeCourt then
            table.insert(Teammates, Player)
        end
    end
    return SortPassRoster(Teammates)
end

local function GetPassTeammates()
    local Now = os.clock()
    if PerfCache.Teammates and (Now - PerfCache.TeammatesAt) < 0.15 then
        return PerfCache.Teammates
    end
    local Roster = PerfCache.GetPassTeammatesRaw()
    PerfCache.Teammates = Roster
    PerfCache.TeammatesAt = Now
    return Roster
end

