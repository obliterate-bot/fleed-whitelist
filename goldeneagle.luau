    State.AutoOffense.BodyingSince = 0
    State.AutoOffense.DriveStatus = 'BODY'
end

function State.AutoOffense.EvaluateCutoff(Root, DefenderRoot, Forward)
    local Now = os.clock()
    if not (Root and DefenderRoot and Forward) then
        return Now < State.AutoOffense.TurnAroundUntil
    end

    local Offset = DefenderRoot.Position - Root.Position
    local Flat = Vector3.new(Offset.X, 0, Offset.Z)
    local Distance = Flat.Magnitude
    if Distance < 0.05 then return Now < State.AutoOffense.TurnAroundUntil end
    local Direction = Flat.Unit

    local Closing = 0
    local Ok, Velocity = pcall(function() return DefenderRoot.AssemblyLinearVelocity end)
    if Ok and typeof(Velocity) == 'Vector3' then
        Closing = Vector3.new(Velocity.X, 0, Velocity.Z):Dot(-Direction)
    end
    State.AutoOffense.LastClosing = Closing

    local Base = State.AutoOffense.CutoffDistance
    local Lead = math.max(0, Closing) * State.AutoOffense.CutoffClosingLead
    local Effective = Base + math.min(Lead, Base)
    if Closing < 0 then
        Effective = math.max(Base * 0.55, Effective + Closing * 0.18)
    end
    State.AutoOffense.EffectiveCutoff = Effective

    local Facing = Direction:Dot(Forward) >= State.AutoOffense.CutoffDot
    local InLane = Distance <= Effective and Facing
    local ClosingTrip = InLane and Distance > Base
    local Shielded = safe_get_attribute(LP, 'NoSteal')
    local StealPosition = not Shielded
        and Distance <= math.max(State.AutoOffense.StealThreatDistance, Effective * 0.8)
        and Closing >= State.AutoOffense.CutoffClosingSpeed

    if InLane or StealPosition then
        State.AutoOffense.TurnAroundUntil = Now + State.AutoOffense.TurnAroundHold
        State.AutoOffense.CutoffReason = InLane
            and (ClosingTrip and 'CLOSING' or 'CUT OFF')
            or 'STEAL THREAT'
        return true
    end

    if Now < State.AutoOffense.TurnAroundUntil then return true end
    State.AutoOffense.CutoffReason = nil
    return false
end

function State.AutoOffense.GetBallSideSign(Root, Right)
    if Root and Right then
        local Basketball = GetHeldBasketballModel(LP)
        local Ball = Basketball and safe_find(Basketball, 'Ball')
        if Ball then
            local Side = (Ball.Position - Root.Position):Dot(Right)
            if math.abs(Side) > 0.2 then return Side > 0 and 1 or -1 end
        end
    end
    local Hand = State.AutoBody.CurrentHand
    if Hand == 'R' then return 1 end
    if Hand == 'L' then return -1 end
    return 0
end

function State.AutoOffense.UpdateHands(Character, Humanoid, Root)
    if not (Character and safe_find(Character, 'Basketball')) then
        State.AutoOffense.HandStatus = 'WAITING FOR BALL'
        State.AutoOffense.HandCandidate = nil
        return nil
    end

    local CurrentHand, RestingTrack, DribbleTrack =
    State.AutoBody.GetCurrentHand(Character, Humanoid, Root)
    State.AutoBody.WatchBounce(DribbleTrack)
    if CurrentHand then State.AutoBody.CurrentHand = CurrentHand end

    if not CONFIG.AutoBodyAutoHands then
        State.AutoOffense.HandStatus = 'MANUAL'
        State.AutoOffense.HandCandidate = nil
        return CurrentHand
    end

    local Sign = State.AutoOffense.BackdownStrafeSign
    if not Sign or Sign == 0 then
        State.AutoOffense.HandCandidate = nil
        return CurrentHand
    end
    local DesiredHand = Sign > 0 and 'R' or 'L'

    if CurrentHand == DesiredHand then
        State.AutoOffense.HandStatus = DesiredHand
        State.AutoOffense.HandCandidate = nil
        State.AutoOffense.HandCandidateSince = 0
        return CurrentHand
    end

    local Now = os.clock()
    if not State.AutoOffense.HandSwitchAllowed
        or Now < (State.AutoOffense.HandSwitchBlockedUntil or 0) then
        State.AutoOffense.HandCandidate = nil
        State.AutoOffense.HandCandidateSince = 0
        State.AutoOffense.HandStatus = 'WAIT FOR FULL TURN'
        return CurrentHand
    end
    if State.AutoOffense.HandCandidate ~= DesiredHand then
        State.AutoOffense.HandCandidate = DesiredHand
        State.AutoOffense.HandCandidateSince = Now
        State.AutoOffense.HandStatus = 'READ ' .. DesiredHand
        return CurrentHand
    end

    local StableTime = math.clamp(
        tonumber(CONFIG.AutoBodyHandStableTime) or 0.12, 0.03, 0.4)
    local Ready = not State.AutoBody.HandInputBusy
        and Now - State.AutoBody.LastHandSwitchAt >= math.clamp(
        tonumber(CONFIG.AutoBodyHandSwitchCooldown) or 0.40, 0.15, 1.2)
    if Now - State.AutoOffense.HandCandidateSince >= StableTime
        and (RestingTrack or Ready)
        and State.AutoBody.BounceWindowOpen() then
        if State.AutoBody.RequestHandSwitch(DesiredHand) then
            State.AutoOffense.HandStatus = 'SWITCH ' .. DesiredHand
            State.AutoOffense.HandCandidate = nil
            State.AutoOffense.HandCandidateSince = 0
            return DesiredHand
        end
    elseif not State.AutoBody.HandInputBusy then
        State.AutoOffense.HandStatus = 'TIME ' .. DesiredHand
    end
    return CurrentHand
end

function State.AutoOffense.SolveStrafeSign(
        Root, DefenderRoot, Right, Forward, BallSideSign, Threat, Court)
    local Current = State.AutoOffense.BackdownStrafeSign
    if not (Root and DefenderRoot and Right and Forward) then return Current end

    local Velocity = Vector3.new(
        DefenderRoot.AssemblyLinearVelocity.X,
        0,
        DefenderRoot.AssemblyLinearVelocity.Z
    )
    local Predicted = DefenderRoot.Position
    + Velocity * State.AutoOffense.DefenderPredictionTime
    local LaneOffset = State.AutoOffense.StealLaneOffset
    local LaneForward = Forward * 0.45

    local Best = Current
    local BestScore = -math.huge
    for _, Sign in ipairs({ -1, 1 }) do
        local Lane = Root.Position + Right * (LaneOffset * Sign) + LaneForward
        local Clearance = (Predicted - Lane).Magnitude
        local Score = Clearance

        local BallSide = (BallSideSign ~= 0) and BallSideSign or Sign
        local BallLane = Lane + Right * (BallSide * 1.1)
        Score = Score + ((Predicted - BallLane).Magnitude - Clearance)
        * State.AutoOffense.BallLaneWeight

        if Velocity.Magnitude > 0.5 then
            Score = Score - Velocity.Unit:Dot(Right * Sign)
            * State.AutoOffense.DefenderDriftWeight
        end

        local Room = State.AutoOffense.LaneRoom(
            Root.Position, Right * Sign, Court, State.AutoOffense.KeepInDistance,
            Sign < 0 and 'strafe-left' or 'strafe-right')
        if Room <= State.AutoOffense.MinLaneRoom then
            Score = Score - 1000 + Room
        else
            Score = Score + Room * State.AutoOffense.KeepInWeight
        end

        if Sign == Current and not Threat then
            Score = Score + State.AutoOffense.StrafeStickiness
        end

        if Score > BestScore then
            Best = Sign
            BestScore = Score
        end
    end
    return Best
end

function State.AutoOffense.ApplyBackToDefender(
        Root, Humanoid, DefenderRoot, DeltaTime, TurnAround,
        ShieldThreat, BallClearance)
    local Character = LP.Character
    if not (Character and Root and Humanoid) then return nil end

    if not DefenderRoot then
        State.AutoOffense.HandSwitchAllowed = true
        State.AutoOffense.HandTurnAlignedSince = 0
        State.AutoOffense.UpdateHands(Character, Humanoid, Root)
        State.AutoOffense.ShieldTurnAngle = 0
        State.AutoOffense.ShieldTurnStatus = 'CLEAR'
        State.AutoOffense.ReleaseBackdown()
        return nil
    end

    State.AutoOffense.HandSwitchAllowed = false
    local CurrentHand = State.AutoOffense.UpdateHands(Character, Humanoid, Root)
    State.AutoBody.TakeRotation(Humanoid)
    State.AutoOffense.RotationOwned = true

    local Separation = Root.Position - DefenderRoot.Position
    local Away = Vector3.new(Separation.X, 0, Separation.Z)
    if Away.Magnitude <= 0.05 then return CurrentHand end

    local DesiredDirection
    if TurnAround then
        DesiredDirection = Away.Unit
    else
        DesiredDirection = State.AutoBody.SolveFacing(Root, DefenderRoot, Away)
    end

    local SpaceAngle = math.rad(math.clamp(
        tonumber(CONFIG.AutoBodySpaceAngle) or 20, 0, 45))
    if CurrentHand and SpaceAngle > 0 and not TurnAround then
        local SignedAngle = CurrentHand == 'R' and SpaceAngle or -SpaceAngle
        local Cosine = math.cos(SignedAngle)
        local Sine = math.sin(SignedAngle)
        DesiredDirection = Vector3.new(
            DesiredDirection.X * Cosine + DesiredDirection.Z * Sine,
            0,
            -DesiredDirection.X * Sine + DesiredDirection.Z * Cosine
        ).Unit
    end

    if TurnAround and ShieldThreat then
        local Basketball = GetHeldBasketballModel(LP)
        local Ball = Basketball and safe_find(Basketball, 'Ball')
        local RootRight = Vector3.new(
            Root.CFrame.RightVector.X, 0, Root.CFrame.RightVector.Z)
        local HandSign = CurrentHand == 'L' and -1 or 1
        if not CurrentHand and Ball and RootRight.Magnitude > 0.05 then
            local BallOffset = Vector3.new(
                Ball.Position.X - Root.Position.X, 0,
                Ball.Position.Z - Root.Position.Z)
            if math.abs(BallOffset:Dot(RootRight.Unit)) > 0.1 then
                HandSign = BallOffset:Dot(RootRight.Unit) >= 0 and 1 or -1
            end
        end
        local Clearance = tonumber(BallClearance) or math.huge
        local Urgency = math.clamp((8.5 - Clearance) / 5, 0, 1)
        local MinimumAngle = State.AutoOffense.StealLaneAligned and 48 or 34
        local AngleDegrees = math.clamp(MinimumAngle + Urgency * 16, 34, 62)
        local Angle = math.rad(AngleDegrees)
        local function Rotate(Direction, SignedAngle)
            local Cosine, Sine = math.cos(SignedAngle), math.sin(SignedAngle)
            return Vector3.new(
                Direction.X * Cosine + Direction.Z * Sine,
                0,
                -Direction.X * Sine + Direction.Z * Cosine).Unit
        end
        local PredictedDefender = DefenderRoot.Position
        + DefenderRoot.AssemblyLinearVelocity * 0.18
        local function Score(Candidate)
            local CandidateRight = Vector3.new(-Candidate.Z, 0, Candidate.X)
            local PredictedBall = Root.Position
            + CandidateRight * (HandSign * 2.35)
            + Candidate * 0.35
            return (PredictedBall - PredictedDefender).Magnitude
        end
        local Positive = Rotate(DesiredDirection, Angle)
        local Negative = Rotate(DesiredDirection, -Angle)
        local PositiveScore, NegativeScore = Score(Positive), Score(Negative)
        local PreviousSign = (State.AutoOffense.ShieldTurnAngle or 0) >= 0 and 1 or -1
        local TurnSign
        if State.AutoOffense.StealRangeLatched then

            TurnSign = State.AutoOffense.BackdownStrafeSign >= 0 and 1 or -1
        elseif math.abs(PositiveScore - NegativeScore) <= 0.30 then
            TurnSign = PreviousSign
        else
            TurnSign = PositiveScore > NegativeScore and 1 or -1
        end
        DesiredDirection = TurnSign > 0 and Positive or Negative
        State.AutoOffense.ShieldTurnAngle = AngleDegrees * TurnSign
        State.AutoOffense.ShieldTurnStatus = string.format(
            'SHIELD %s %.0f | ALIGN %.2f',
            TurnSign > 0 and 'RIGHT' or 'LEFT', AngleDegrees,
            State.AutoOffense.StealLaneAlignment or -1)
    else
        State.AutoOffense.ShieldTurnAngle = 0
        State.AutoOffense.ShieldTurnStatus = 'BACK SEALED'
    end

    local CurrentDirection = Vector3.new(
        Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
    local Alignment = CurrentDirection.Magnitude > 0.001
        and CurrentDirection.Unit:Dot(DesiredDirection) or -1
    local Now = os.clock()
    if Alignment >= 0.997
        and Now >= (State.AutoOffense.HandSwitchBlockedUntil or 0) then
        if (State.AutoOffense.HandTurnAlignedSince or 0) <= 0 then
            State.AutoOffense.HandTurnAlignedSince = Now
        end
        if Now - State.AutoOffense.HandTurnAlignedSince >= 0.16 then
            State.AutoOffense.HandSwitchAllowed = true
            CurrentHand = State.AutoOffense.UpdateHands(Character, Humanoid, Root)
        end
    else
        State.AutoOffense.HandTurnAlignedSince = 0
        State.AutoOffense.HandSwitchAllowed = false
    end
    if Alignment > 0.99996 then return CurrentHand end

    local Desired = CFrame.lookAt(
        Root.Position, Root.Position + DesiredDirection, Vector3.yAxis)
    local Step = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.1)
    local Rate = State.AutoBody.SolveTurnRate(Away.Magnitude, Root, DefenderRoot)
    if TurnAround then Rate = math.max(Rate, 65) end
    if ShieldThreat then Rate = math.max(Rate, 95) end
    local Alpha = 1 - math.exp(-Rate * Step)
    Root.CFrame = Root.CFrame:Lerp(Desired, Alpha)
    return CurrentHand
end

function State.AutoOffense.ResetMovement(Humanoid, YieldOnly)
    local Owned = State.Runtime.MovementOwner == 'Offense'
    State.Runtime.ReleaseMovement('Offense')
    State.Runtime.ReleaseMovement('AntiRip')
    State.AutoOffense.AntiRipActive = false
    State.AutoOffense.SmoothedMoveDirection = Vector3.zero
    State.AutoOffense.LastIssuedDirection = Vector3.zero
    State.AutoOffense.ManualBlendActive = false
    State.AutoOffense.BoundaryStatus = 'CLEAR'
    State.AutoOffense.EdgeClearance = math.huge
    if Owned and not YieldOnly and Humanoid and Humanoid.Parent then
        Humanoid:Move(Vector3.zero, false)
    end
    if State.AutoOffense.MovementIsReset then return end
    State.AutoOffense.MovementIsReset = true
    State.AutoOffense.ReleaseBackdown()
    State.AutoOffense.MovementPhase = 'backdown'
    State.AutoOffense.PhaseStarted = os.clock()
    State.AutoOffense.BackdownStrafeChanged = State.AutoOffense.PhaseStarted
    State.AutoOffense.BackdownHasCommittedSide = false
    State.AutoOffense.LastCutbackAt = 0
    State.AutoOffense.StrafeLockUntil = 0
    State.AutoOffense.PendingHardCut = false
    State.AutoOffense.StealRangeLatched = false
    State.AutoOffense.StealRangeClearSince = 0
    State.AutoOffense.HandSwitchAllowed = false
    State.AutoOffense.HandSwitchBlockedUntil = 0
    State.AutoOffense.HandTurnAlignedSince = 0
    State.AutoOffense.DefenderCanReachBall = false
    State.AutoOffense.OppositeBallClearance = math.huge
    State.AutoOffense.StrafeReason = 'GOAL ROUTE'
    State.AutoOffense.LastBallClearance = math.huge
    State.AutoOffense.LastDefenderDistance = math.huge
    State.AutoOffense.LastEscapeRoute = nil
    State.AutoOffense.LastEscapeRouteAt = 0
    State.AutoOffense.StealLaneAligned = false
    State.AutoOffense.StealLaneAlignment = -1
    State.AutoOffense.StealLaneWidth = math.huge
    State.AutoOffense.ShieldTurnUntil = 0
    State.AutoOffense.ShieldTurnAngle = 0
    State.AutoOffense.ShieldTurnStatus = 'CLEAR'
    State.AutoOffense.DefenderCache = nil
    State.AutoOffense.DefenderCachedAt = 0
    State.AutoOffense.CourtCache = nil
    State.AutoOffense.CourtCachedAt = 0
    State.AutoOffense.SafeStrafeAt = 0
    table.clear(State.AutoOffense.LaneRoomCache)
end

function State.AutoOffense.BeginMovementPhase(Phase)
    State.AutoOffense.MovementPhase = Phase
    State.AutoOffense.PhaseStarted = os.clock()
    if Phase == 'backdown' then
        State.AutoOffense.BackdownStrafeChanged = State.AutoOffense.PhaseStarted
    end
end

function State.AutoOffense.GetScoringGoal()
    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    if not Root then return nil, math.huge end

    local Goal = FindPlayerScoringGoal(LP)
    if not Goal then return nil, math.huge end
    local Delta = Goal.Position - Root.Position
    return Goal, Vector3.new(Delta.X, 0, Delta.Z).Magnitude
end

function State.AutoOffense.GetCourt()
    local Now = os.clock()
    local Cached = State.AutoOffense.CourtCache
    if Now - State.AutoOffense.CourtCachedAt < 0.25
        and (Cached == false or (Cached and Cached.Parent)) then
        return Cached ~= false and Cached or nil
    end

    local Court = ResolvePlayerCourt(LP)
    if not Court then
        local Character = LP.Character
        local Root = Character and safe_find(Character, 'HumanoidRootPart')
        if Root then
            local PracticeCourt, PracticeDistance = FindNearestPracticeCourtFromPosition(Root.Position)
            if PracticeCourt and PracticeDistance <= 150 then Court = PracticeCourt end
        end
    end
    if not Court and IsArenaMode then Court = safe_find(Workspace, 'Court') end
    State.AutoOffense.CourtCache = Court or false
    State.AutoOffense.CourtCachedAt = Now
    return Court
end

function State.AutoOffense.GetCourtFloor(Court)
    if not Court then return nil end
    local Resolver = State.AutoGetOpen and State.AutoGetOpen.GetAutoGetOpenFloor
    if Resolver then
        local Ok, Floor = pcall(Resolver, Court)
        if Ok and Floor and safe_is_a(Floor, 'BasePart') then return Floor end
    end
    local Others = safe_find(Court, 'Others')
    local Floor = (Others and safe_find(Others, 'CourtFloor'))
        or safe_find(Court, 'CourtFloor')
    if Floor and safe_is_a(Floor, 'BasePart') then return Floor end
    for _, Descendant in ipairs(Court:GetDescendants()) do
        if safe_is_a(Descendant, 'BasePart') and Descendant.Name == 'CourtFloor' then
            return Descendant
        end
    end
    return nil
end

function State.AutoOffense.GetSafeCourtBounds(Position, Court)
    if not Position or not Court then return true, Position, math.huge, nil end
    local Floor = State.AutoOffense.GetCourtFloor(Court)
    if not Floor then
        local Parts = State.AutoOffense.GetOOBParts(Court)
        local OOB = #Parts > 0 and State.AutoOffense.PositionOOB(Position, Parts)
        return not OOB, Position, OOB and -1 or math.huge, nil
    end

    local LocalPoint = Floor.CFrame:PointToObjectSpace(Position)
    local Margin = 11
    local SafeHalfX = math.max(2, Floor.Size.X * 0.5 - Margin)
    local SafeHalfZ = math.max(2, Floor.Size.Z * 0.5 - Margin)
    local Inside = math.abs(LocalPoint.X) <= SafeHalfX
        and math.abs(LocalPoint.Z) <= SafeHalfZ
    local Clearance = math.min(
        SafeHalfX - math.abs(LocalPoint.X),
        SafeHalfZ - math.abs(LocalPoint.Z))
    local RecoveryLocal = Vector3.new(
        math.clamp(LocalPoint.X, -SafeHalfX, SafeHalfX),
        LocalPoint.Y,
        math.clamp(LocalPoint.Z, -SafeHalfZ, SafeHalfZ))
    local RecoveryWorld = Floor.CFrame:PointToWorldSpace(RecoveryLocal)
    return Inside, Vector3.new(
        RecoveryWorld.X, Position.Y, RecoveryWorld.Z), Clearance, Floor
end

function State.AutoOffense.EvaluateBallThreat(Root, DefenderRoot, CourtRight)
    if not (Root and DefenderRoot and CourtRight) then
        State.AutoOffense.LastBallClearance = math.huge
        State.AutoOffense.StealLaneAligned = false
        State.AutoOffense.StealLaneAlignment = -1
        State.AutoOffense.StealLaneWidth = math.huge
        return false, nil, math.huge
    end

    local Basketball = GetHeldBasketballModel(LP)
    local Ball = Basketball and safe_find(Basketball, 'Ball')
    if not Ball then
        State.AutoOffense.LastBallClearance = math.huge
        State.AutoOffense.StealLaneAligned = false
        State.AutoOffense.StealLaneAlignment = -1
        State.AutoOffense.StealLaneWidth = math.huge
        return false, nil, math.huge
    end

    local DefenderVelocity = Vector3.new(
        DefenderRoot.AssemblyLinearVelocity.X,
        0,
        DefenderRoot.AssemblyLinearVelocity.Z)
    local PredictedDefender = DefenderRoot.Position
    + DefenderVelocity * State.AutoOffense.DefenderPredictionTime
    local FlatPredictedDefender = Vector3.new(
        PredictedDefender.X, Root.Position.Y, PredictedDefender.Z)
    local FlatBall = Vector3.new(Ball.Position.X, Root.Position.Y, Ball.Position.Z)
    local BallOffset = FlatBall - Root.Position
    local DefenderOffset = FlatPredictedDefender - Root.Position
    local CurrentClearance = (FlatPredictedDefender - FlatBall).Magnitude
    local DefenderDistance = DefenderOffset.Magnitude
    State.AutoOffense.LastBallClearance = CurrentClearance

    local Alignment = -1
    local LaneWidth = math.huge
    if BallOffset.Magnitude > 0.05 and DefenderOffset.Magnitude > 0.05 then
        local BallDirection = BallOffset.Unit
        Alignment = DefenderOffset.Unit:Dot(BallDirection)
        local AlongLane = DefenderOffset:Dot(BallDirection)
        LaneWidth = (DefenderOffset - BallDirection * AlongLane).Magnitude
    end

    local Congruent = Alignment >= 0.58
        and LaneWidth <= 3.75
        and CurrentClearance <= 8.5
    State.AutoOffense.StealLaneAligned = Congruent
    State.AutoOffense.StealLaneAlignment = Alignment
    State.AutoOffense.StealLaneWidth = LaneWidth

    local DirectReach = CurrentClearance <= State.AutoOffense.BallThreatDistance
    if Congruent or DirectReach then
        State.AutoOffense.ShieldTurnUntil = os.clock() + 0.30
    end
    local DefenderSide = DefenderOffset:Dot(CourtRight)
    local EscapeSign = DefenderSide >= 0 and -1 or 1
    local Threatened = DirectReach or Congruent
        or DefenderDistance <= State.AutoOffense.EmergencyDefenderDistance
    return Threatened, EscapeSign, CurrentClearance
end

function State.AutoOffense.GetOOBParts(Court)
    local Now = os.clock()
    if State.AutoOffense.OOBPartsCourt == Court
        and State.AutoOffense.OOBParts
        and Now - State.AutoOffense.OOBPartsAt < 2 then
        return State.AutoOffense.OOBParts
    end

    local Parts = {}
    local OOB = Court and safe_find(Court, 'OOB')
    if OOB then
        for _, ContainerName in ipairs({ 'Floor', 'Lines' }) do
            local Container = safe_find(OOB, ContainerName)
            if Container then
                for _, Part in ipairs(Container:GetDescendants()) do
                    if safe_is_a(Part, 'BasePart') then
                        Parts[#Parts + 1] = {
                            Part = Part,
                            CFrame = Part.CFrame,
                            HalfSize = Part.Size * 0.5,
                        }
                    end
                end
            end
        end
    end

    State.AutoOffense.OOBParts = Parts
    State.AutoOffense.OOBPartsAt = Now
    State.AutoOffense.OOBPartsCourt = Court
    return Parts
end

function State.AutoOffense.PositionOOB(Position, Parts)
    local Margin = State.AutoOffense.OOBSafetyMargin
    for _, Entry in ipairs(Parts) do
        local IsRecord = type(Entry) == 'table'
        local Part = IsRecord and Entry.Part or Entry
        if Part.Parent then
            local Frame = IsRecord and Entry.CFrame or Part.CFrame
            local HalfSize = IsRecord and Entry.HalfSize or (Part.Size * 0.5)
            local LocalPosition = Frame:PointToObjectSpace(Position)
            if math.abs(LocalPosition.X) <= HalfSize.X + Margin
                and math.abs(LocalPosition.Z) <= HalfSize.Z + Margin
                and math.abs(LocalPosition.Y) <= HalfSize.Y + 12 then
                return true, Part
            end
        end
    end
    return false
end

function State.AutoOffense.IsPositionOutOfBounds(Position, Court)
    if not (Position and Court) then return false end
    local Parts = State.AutoOffense.GetOOBParts(Court)
    if #Parts > 0 and State.AutoOffense.PositionOOB(Position, Parts) then
        return true
    end
    local Inside = State.AutoOffense.GetSafeCourtBounds(Position, Court)
    return not Inside
end

function State.AutoOffense.LaneRoom(
        Origin, Direction, Court, MaxDistance, CacheKey)
    MaxDistance = MaxDistance or State.AutoOffense.KeepInDistance
    if not (Origin and Direction and Court) then return MaxDistance end
    if Direction.Magnitude <= 0.001 then return MaxDistance end

    local Now = os.clock()
    if CacheKey then
        local Cached = State.AutoOffense.LaneRoomCache[CacheKey]
        if Cached and Cached.Court == Court
            and Cached.MaxDistance == MaxDistance
            and Now - Cached.At < 0.08 then
            return Cached.Value
        end
    end

    local Parts = State.AutoOffense.GetOOBParts(Court)
    local HasFloor = State.AutoOffense.GetCourtFloor(Court) ~= nil
    if #Parts == 0 and not HasFloor then
        if CacheKey then
            State.AutoOffense.LaneRoomCache[CacheKey] = {
                At = Now,
                Court = Court,
                MaxDistance = MaxDistance,
                Value = MaxDistance,
            }
        end
        return MaxDistance
    end

    local Unit = Direction.Unit
    local Step = math.max(1, State.AutoOffense.OOBSampleStep)
    local Travelled = Step
    while Travelled <= MaxDistance do
        local Probe = Origin + Unit * Travelled
        local ExplicitOOB = #Parts > 0
            and State.AutoOffense.PositionOOB(Probe, Parts)
        local InsideCourt = State.AutoOffense.GetSafeCourtBounds(Probe, Court)
        if ExplicitOOB or not InsideCourt then
            local Room = math.max(0, Travelled - Step)
            if CacheKey then
                State.AutoOffense.LaneRoomCache[CacheKey] = {
                    At = Now,
                    Court = Court,
                    MaxDistance = MaxDistance,
                    Value = Room,
                }
            end
            return Room
        end
        Travelled = Travelled + Step
    end
    if CacheKey then
        State.AutoOffense.LaneRoomCache[CacheKey] = {
            At = Now,
            Court = Court,
            MaxDistance = MaxDistance,
            Value = MaxDistance,
        }
    end
    return MaxDistance
end

function State.AutoOffense.GetSafeStrafeSign(RootPosition, Forward, Right, PreferredSign, Court)
    if not Court then return PreferredSign, false end

    local Now = os.clock()
    if State.AutoOffense.SafeStrafeCourt == Court
        and State.AutoOffense.SafeStrafePreferred == PreferredSign
        and Now - State.AutoOffense.SafeStrafeAt < 0.08 then
        return State.AutoOffense.SafeStrafeResult,
        State.AutoOffense.SafeStrafeAvoiding
    end

    local SideDistance = State.AutoOffense.OOBProbeDistance
    local ForwardOffset = Forward * State.AutoOffense.OOBProbeForward
    local LeftProbe = RootPosition - Right * SideDistance + ForwardOffset
    local RightProbe = RootPosition + Right * SideDistance + ForwardOffset
    local LeftOOB = State.AutoOffense.IsPositionOutOfBounds(LeftProbe, Court)
    local RightOOB = State.AutoOffense.IsPositionOutOfBounds(RightProbe, Court)

    local Result = PreferredSign
    local Avoiding = false
    if PreferredSign < 0 then
        if LeftOOB and not RightOOB then Result, Avoiding = 1, true end
    elseif RightOOB and not LeftOOB then
        Result, Avoiding = -1, true
    end

    if LeftOOB and RightOOB then Result, Avoiding = nil, true end
    State.AutoOffense.SafeStrafeAt = Now
    State.AutoOffense.SafeStrafeCourt = Court
    State.AutoOffense.SafeStrafePreferred = PreferredSign
    State.AutoOffense.SafeStrafeResult = Result
    State.AutoOffense.SafeStrafeAvoiding = Avoiding
    return Result, Avoiding
end

function State.AutoOffense.CanShoot()
    if not State.RequestedEnabled or not State.Enabled then
        return false, 'SILENT AIM OFF'
    end
    if SilentAim.ActorAimReady ~= true then
        return false, 'HOOKS NOT READY'
    end

    local Character = LP.Character
    local Ball = GetHeldBasketballModel(LP)
    if not Character or not Ball then return false, 'NEED BALL' end

    local Rim, Distance = FindConfiguredGoal()
    if not Rim then return false, 'NO GOAL' end

    local Power = safe_get_attribute(LP, 'Power') or 85
    local AdjustedDistance = AdjustAimDistance(Distance)
    if not PowerSupportsDistance(Power, AdjustedDistance) then
        if CONFIG.AutoPower then
            local BestPower = State.SelectBestAutoPower(AdjustedDistance, Power)
            if BestPower then
                safe_set_attribute(LP, 'Power', BestPower)
                Power = BestPower
            else
                return false, 'NO POWER BAND'
            end
        else
            return false, 'OUT OF RANGE'
        end
    end

    return true, Rim, Distance
end

function State.AutoOffense.CanDunk()
    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    local Ball = GetHeldBasketballModel(LP)
    if not Root or not Ball then return false, 'NEED BALL' end

    local Target, Distance = State.AutoDunk.ResolveTarget()
    if not Target then return false, 'NO DUNK TARGET' end
    if Distance > State.AutoOffense.DunkDistance then return false, 'TOO FAR' end

    if CONFIG.AutoDunkLaneCheck and not State.AutoDunk.LaneOpen(Root, Target) then
        return false, 'LANE BLOCKED'
    end

    local Humanoid = Character:FindFirstChildOfClass('Humanoid')
    if Humanoid and (Humanoid.PlatformStand or Humanoid.FloorMaterial == Enum.Material.Air) then
        return false, 'WAITING FOR GROUND'
    end

    return true, Target, Distance
end

function State.AutoOffense.FinishAction(Generation, Status)
    if Generation ~= State.AutoOffense.Generation then return end
    State.AutoOffense.InProgress = false
    State.AutoOffense.LastAction = os.clock()
    State.AutoOffense.Status = Status or 'READY'
end

function State.AutoOffense.IsNaturalShotPosition(Root, Humanoid, Rim, Distance, DefenderRoot, DefenderDistance, BallClearance)
    if not (Root and Humanoid and Rim) then return false, 'NO SHOT POSITION' end
    if Humanoid.PlatformStand or Humanoid.FloorMaterial == Enum.Material.Air then
        return false, 'WAITING FOR GROUND'
    end
    if Distance < 48 or Distance > 72 then return false, 'OUTSIDE SHOT WINDOW' end
    local Velocity = Root.AssemblyLinearVelocity
    local HorizontalVelocity = Vector3.new(Velocity.X, 0, Velocity.Z).Magnitude
    if HorizontalVelocity > 5.5 then return false, 'SET FEET' end
    local ToRim = Vector3.new(
        Rim.Position.X - Root.Position.X, 0,
        Rim.Position.Z - Root.Position.Z)
    if ToRim.Magnitude <= 0.05 then return false, 'NO SHOT DIRECTION' end
    local Facing = Vector3.new(Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
    if Facing.Magnitude <= 0.05 or Facing.Unit:Dot(ToRim.Unit) < 0.20 then
        return false, 'FACE THE RIM'
    end
    local MinimumSeparation = math.max(
        8.5, tonumber(State.AutoOffense.StealThreatDistance) or 6.5)
    if DefenderRoot and DefenderDistance < MinimumSeparation then
        return false, 'CREATE SEPARATION'
    end
    if (tonumber(BallClearance) or math.huge) < 5.5 then
        return false, 'PROTECT BALL'
    end
    return true, 'READY'
end

function State.AutoOffense.PerformShoot()
    if State.AutoOffense.InProgress then return false end
    local CanShoot, RimOrReason, Distance = State.AutoOffense.CanShoot()
    if not CanShoot then
        State.AutoOffense.Status = tostring(RimOrReason or 'CANNOT SHOOT')
        return false
    end

    State.AutoOffense.Generation += 1
    local Generation = State.AutoOffense.Generation
    State.AutoOffense.InProgress = true
    State.AutoOffense.ActionType = 'SHOOT'
    local Profile = State.AutoOffense.ApplyBehaviorProfile()
    State.AutoOffense.ShotRecoveryUntil = os.clock() + Profile.ShotCooldown
    State.AutoOffense.Status = 'SHOOTING'
    State.AutoOffense.Target = RimOrReason
    State.AutoOffense.TargetDistance = Distance or math.huge

    local Character = LP.Character
    local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
    if not Humanoid then
        State.AutoOffense.FinishAction(Generation, 'NO HUMANOID')
        return false
    end

    State.AutoOffense.ReleaseBackdown()
    State.AutoOffense.StopSmoothMovement(Humanoid)
    Humanoid.Jump = true
    pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)

    State.Lifecycle:Delay(0.18, function()
        if Generation == State.AutoOffense.Generation then
            State.AutoOffense.InProgress = false
            State.AutoOffense.LastAction = os.clock()
            State.AutoOffense.ActionType = 'POST SHOT ROUTE'
            State.AutoOffense.Status = 'POST-SHOT CONTINUE'
        end
    end)
    State.Lifecycle:Delay(1.2, function()
        State.AutoOffense.FinishAction(Generation, 'READY')
    end)
    return true
end

function State.AutoOffense.PerformDunk()
    if State.AutoOffense.InProgress then return false end
    local CanDunk, TargetOrReason, Distance = State.AutoOffense.CanDunk()
    if not CanDunk then
        State.AutoOffense.Status = tostring(TargetOrReason or 'CANNOT DUNK')
        return false
    end

    State.AutoOffense.Generation += 1
    local Generation = State.AutoOffense.Generation
    State.AutoOffense.InProgress = true
    State.AutoOffense.ActionType = 'DUNK'
    State.AutoOffense.Status = 'DUNKING'
    State.AutoOffense.Target = TargetOrReason
    State.AutoOffense.TargetDistance = Distance or math.huge

    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
    State.AutoOffense.ReleaseBackdown()
    if Root and Humanoid and TargetOrReason then
        local Delta = TargetOrReason.Position - Root.Position
        local Horizontal = Vector3.new(Delta.X, 0, Delta.Z)
        if Horizontal.Magnitude > 0.1 then Humanoid:Move(Horizontal.Unit, false) end
    end

    local Began = State.AutoDunk.Begin(TargetOrReason)
    if not Began then
        State.AutoOffense.FinishAction(Generation, 'DUNK INPUT FAILED')
        return false
    end

    State.Lifecycle:Delay(math.max(0.35, tonumber(CONFIG.AutoDunkHoldTime) or 1.45), function()
        if Generation ~= State.AutoOffense.Generation then return end
        State.AutoDunk.ReleaseKey()
        State.AutoOffense.FinishAction(Generation, 'READY')
    end)
    return true
end

function State.AutoOffense.TryAction(Distance)
    local Now = os.clock()
    if State.AutoOffense.InProgress
        or Now - State.AutoOffense.LastAction < State.AutoOffense.ActionCooldown then
        return false
    end

    if State.OffensePolicy then
        local Allowed, Reason = State.OffensePolicy.AllowShot()
        State.AutoOffense.PolicyReason = Reason
        if not Allowed then
            State.AutoOffense.Status = 'LEARNED ' .. tostring(Reason)
            return false
        end
    end

    local CanShoot = false
    local CanDunk = false
    if Distance <= State.AutoOffense.ShootDistance then
        CanShoot = State.AutoOffense.CanShoot() == true
    end
    if Distance <= State.AutoOffense.DunkDistance then
        CanDunk = State.AutoOffense.CanDunk() == true
    end

    if CanShoot and CanDunk then
        local Prefer = State.OffensePolicy and State.OffensePolicy.PreferredFinish()
        if Prefer == 'dunk' then return State.AutoOffense.PerformDunk() end
        if Prefer == 'shoot' then return State.AutoOffense.PerformShoot() end
        if math.random() < State.AutoOffense.ShootChance then
            return State.AutoOffense.PerformShoot()
        end
        return State.AutoOffense.PerformDunk()
    elseif CanDunk then
        return State.AutoOffense.PerformDunk()
    elseif CanShoot then
        return State.AutoOffense.PerformShoot()
    end
    return false
end

function State.AutoOffense.UpdateRecenter(Root, Right, Sign, Court)
    if not (Root and Right) then return false end
    if not Sign or Sign == 0 then Sign = 1 end

    local Max = State.AutoOffense.KeepInDistance
    local Room = State.AutoOffense.LaneRoom(
        Root.Position, Right * Sign, Court, Max,
        Sign < 0 and 'recenter-left' or 'recenter-right')
    local Opposite = State.AutoOffense.LaneRoom(
        Root.Position, Right * -Sign, Court, Max,
        Sign < 0 and 'recenter-right' or 'recenter-left')
    State.AutoOffense.RecenterSign = Sign
    State.AutoOffense.LastRoom = Room
    State.AutoOffense.LastOppositeRoom = Opposite

    if State.AutoOffense.Recentering then
        if Room >= State.AutoOffense.MinLaneRoom + State.AutoOffense.RecenterExit then
            State.AutoOffense.Recentering = false
        end
    elseif Room <= State.AutoOffense.MinLaneRoom then
        State.AutoOffense.Recentering = true
    end

    return State.AutoOffense.Recentering
end

function State.AutoOffense.FaceDirection(Root, Direction, DeltaTime, Rate)
    if not (Root and Direction) then return end
    if Direction.Magnitude <= 0.001 then return end

    local Desired = Direction.Unit
    local Current = Vector3.new(
        Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
    if Current.Magnitude > 0.001
        and Current.Unit:Dot(Desired) > 0.99996 then
        return
    end

    local Target = CFrame.lookAt(
        Root.Position, Root.Position + Desired, Vector3.yAxis)
    local StepTime = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.1)
    local Alpha = 1 - math.exp(-(tonumber(Rate) or 26) * StepTime)
    Root.CFrame = Root.CFrame:Lerp(Target, Alpha)
end

function State.AutoOffense.StopSmoothMovement(Humanoid)
    local Owned = State.Runtime.MovementOwner == 'Offense'
    State.Runtime.ReleaseMovement('Offense')
    State.AutoOffense.SmoothedMoveDirection = Vector3.zero
    State.AutoOffense.LastIssuedDirection = Vector3.zero
    if Owned and Humanoid and Humanoid.Parent then Humanoid:Move(Vector3.zero, false) end
end

function State.AutoOffense.GetBoundarySafeDirection(Root, Direction, Court)
    if not Root or not Direction or Direction.Magnitude <= 0.001 or not Court then
        return Direction, false
    end
    local Desired = Vector3.new(Direction.X, 0, Direction.Z)
    if Desired.Magnitude <= 0.001 then return Direction, false end
    Desired = Desired.Unit

    local CurrentInside, RecoveryTarget, CurrentClearance, Floor =
    State.AutoOffense.GetSafeCourtBounds(Root.Position, Court)
    State.AutoOffense.EdgeClearance = CurrentClearance or math.huge
    local Center = Floor and Floor.Position
    if not Center and State.AutoGetOpen and State.AutoGetOpen.GetAutoGetOpenCourtCenter then
        local Ok, Result = pcall(State.AutoGetOpen.GetAutoGetOpenCourtCenter, Court)
        if Ok then Center = Result end
    end
    if not Center then
        pcall(function() Center = Court:GetPivot().Position end)
    end

    local Inward = Center and Vector3.new(
        Center.X - Root.Position.X, 0, Center.Z - Root.Position.Z)
        or -Desired
    if Inward.Magnitude <= 0.001 then Inward = -Desired else Inward = Inward.Unit end
    if not CurrentInside then
        local Recovery = RecoveryTarget and Vector3.new(
            RecoveryTarget.X - Root.Position.X, 0,
            RecoveryTarget.Z - Root.Position.Z) or Inward
        if Recovery.Magnitude <= 0.05 then Recovery = Inward end
        State.AutoOffense.BoundaryStatus = 'RECENTERING'
        return Recovery.Unit, true
    end

    local Velocity = Vector3.new(
        Root.AssemblyLinearVelocity.X, 0, Root.AssemblyLinearVelocity.Z)
    local LookAhead = 8
    local VelocityLook = 0.22
    local function Predict(Candidate)
        return Root.Position + Candidate * LookAhead + Velocity * VelocityLook
    end
    local DesiredProbe = Predict(Desired)
    local DesiredInside, _, DesiredClearance =
    State.AutoOffense.GetSafeCourtBounds(DesiredProbe, Court)
    local DesiredOOB = State.AutoOffense.PositionOOB(
        DesiredProbe, State.AutoOffense.GetOOBParts(Court))
    if DesiredInside and not DesiredOOB and (DesiredClearance or 0) >= 1.5 then
        State.AutoOffense.BoundaryStatus = 'CLEAR'
        return Desired, false
    end

    local Tangent = Vector3.new(-Inward.Z, 0, Inward.X)
    local Candidates = {
        Desired,
        (Desired * 0.62 + Inward * 0.38),
        (Desired * 0.30 + Inward * 0.70),
        Inward,
        (Tangent * 0.72 + Inward * 0.28),
        (-Tangent * 0.72 + Inward * 0.28),
    }
    local Best, BestScore = Inward, -math.huge
    for _, Candidate in ipairs(Candidates) do
        if Candidate.Magnitude > 0.001 then
            Candidate = Candidate.Unit
            local Probe = Predict(Candidate)
            local Inside, _, Clearance = State.AutoOffense.GetSafeCourtBounds(Probe, Court)
            local ExplicitOOB = State.AutoOffense.PositionOOB(
                Probe, State.AutoOffense.GetOOBParts(Court))
            local Score = (Inside and not ExplicitOOB) and 100 or -100
            Score += math.clamp(tonumber(Clearance) or -30, -30, 30) * 3
            Score += Candidate:Dot(Desired) * 6
            Score += Candidate:Dot(Inward) * 2
            if Score > BestScore then Best, BestScore = Candidate, Score end
        end
    end
    State.AutoOffense.BoundaryStatus = 'EDGE GUARD'
    return Best, true
end

function State.AutoOffense.MoveSmooth(
        Humanoid, Root, Direction, DeltaTime, Court)
    if not Humanoid or not Root or not Direction or Direction.Magnitude <= 0.001 then
        State.AutoOffense.StopSmoothMovement(Humanoid)
        return Vector3.zero, false
    end
    local Target, Avoiding = State.AutoOffense.GetBoundarySafeDirection(
        Root, Direction, Court)
    if not Target or Target.Magnitude <= 0.001 then
        State.AutoOffense.StopSmoothMovement(Humanoid)
        return Vector3.zero, true
    end
    Target = Target.Unit
    local Current = State.AutoOffense.SmoothedMoveDirection or Vector3.zero
    local Step = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.1)
    local Profile = State.AutoOffense.ApplyBehaviorProfile()
    local Alpha = 1 - math.exp(-Profile.Response * Step)
    if Avoiding then Alpha = math.max(Alpha, 0.55) end
    local Smoothed = Current:Lerp(Target, Alpha)
    if Smoothed.Magnitude > 1 then Smoothed = Smoothed.Unit end

    local FinalSafe, FinalAvoiding = State.AutoOffense.GetBoundarySafeDirection(
        Root, Smoothed, Court)
    if FinalAvoiding and FinalSafe and FinalSafe.Magnitude > 0.001 then
        local Speed = math.clamp(Smoothed.Magnitude, 0.35, 1)
        Smoothed = FinalSafe.Unit * Speed
        Avoiding = true
    end
    State.AutoOffense.SmoothedMoveDirection = Smoothed
    if State.Runtime.AcquireMovement('Offense') then
        Humanoid:Move(Smoothed, false)
        State.AutoOffense.LastIssuedDirection = Smoothed
    end
    return Smoothed, Avoiding
end

function State.AutoOffense.LaneOpen(Root, DefenderRoot, Forward, Court, Rim)
    if not (Root and Forward) then return false end

    local Room = State.AutoOffense.LaneRoom(
        Root.Position, Forward, Court, State.AutoOffense.DriveForwardRoom,
        'drive-forward')
    if Room < State.AutoOffense.DriveForwardRoom then return false end

    if DefenderRoot then
        local Offset = DefenderRoot.Position - Root.Position
        local Flat = Vector3.new(Offset.X, 0, Offset.Z)
        local Distance = Flat.Magnitude
        if Distance < 0.05 then return false end
        if Distance <= State.AutoOffense.DriveLaneDistance
            and Flat.Unit:Dot(Forward) >= State.AutoOffense.DriveLaneDot then
            return false
        end
    end

    if State.AutoOffense.DriveRequireLaneCheck and Rim then
        local Ok, Open = pcall(State.AutoDunk.LaneOpen, Root, Rim)
        if Ok and Open == false then return false end
    end

    return true
end

function State.AutoOffense.DefenderIsRisk(
        Root, DefenderRoot, BallThreat, BallClearance, DefenderDistance)
    if BallThreat then return true end
    if not (Root and DefenderRoot) then return false end

    if (tonumber(DefenderDistance) or math.huge)
    < State.AutoOffense.DriveSafeDefenderDistance then
        return true
    end
    if (tonumber(BallClearance) or math.huge)
    < State.AutoOffense.DriveSafeClearance then
        return true
    end

    local Offset = DefenderRoot.Position - Root.Position
    local Flat = Vector3.new(Offset.X, 0, Offset.Z)
    if Flat.Magnitude < 0.05 then return true end

    local Ok, Velocity = pcall(function()
        return DefenderRoot.AssemblyLinearVelocity
    end)
    if Ok and typeof(Velocity) == 'Vector3' then
        local Closing = Vector3.new(Velocity.X, 0, Velocity.Z):Dot(-Flat.Unit)
        if Closing >= State.AutoOffense.DriveSafeClosingSpeed then return true end
    end

    return false
end

function State.AutoOffense.UpdateDriveState(
        Root, DefenderRoot, Forward, Court, Rim, TurnAround,
        BallThreat, BallClearance, DefenderDistance)
    local Now = os.clock()

    local Risk = State.AutoOffense.DefenderIsRisk(
        Root, DefenderRoot, BallThreat, BallClearance, DefenderDistance)
    local Open = (not Risk) and (not TurnAround)
        and State.AutoOffense.LaneOpen(Root, DefenderRoot, Forward, Court, Rim)

    if State.AutoOffense.DriveActive then
        if Open then
            State.AutoOffense.DriveUntil = Now + State.AutoOffense.DriveMinHold
            State.AutoOffense.DriveStatus = 'DRIVE'
            return true
        end
        if not Risk and Now < State.AutoOffense.DriveUntil then
            State.AutoOffense.DriveStatus = 'DRIVE HOLD'
            return true
        end
        State.AutoOffense.DriveActive = false
        State.AutoOffense.BodyingSince = Now
    end

    if State.AutoOffense.BodyingSince <= 0 then
        State.AutoOffense.BodyingSince = Now
    end

    if Risk or TurnAround then
        State.AutoOffense.BodyingSince = Now
        State.AutoOffense.DriveStatus = TurnAround and 'BODY CUTOFF' or 'BODY RISK'
        return false
    end

    if not Open then
        State.AutoOffense.DriveStatus = 'BODY NO LANE'
        return false
    end

    local Bodied = Now - State.AutoOffense.BodyingSince
    if Bodied < State.AutoOffense.DriveBodyMinTime then
        State.AutoOffense.DriveStatus = string.format('BODY %.2fs', Bodied)
        return false
    end

    State.AutoOffense.DriveActive = true
    State.AutoOffense.DriveUntil = Now + State.AutoOffense.DriveMinHold
    State.AutoOffense.DriveStatus = 'DRIVE'
    return true
end

function State.AutoOffense.ClearPathVisual()
    local Folder = State.AutoOffense.PathFolder
    if Folder and Folder.Parent then pcall(function() Folder:Destroy() end) end
    State.AutoOffense.PathFolder = nil
    table.clear(State.AutoOffense.PathParts)
    State.AutoOffense.PathUpdatedAt = 0
end

function State.AutoOffense.SetPathVisualEnabled(Enabled)
    Enabled = Enabled == true
    State.AutoOffense.PathVisualEnabled = Enabled
    CONFIG.AutoOffenseShowPath = Enabled
    if not Enabled then State.AutoOffense.ClearPathVisual() end
    if HubUI and HubUI.Sync then pcall(HubUI.Sync) end
end

function State.AutoOffense.GetPathFolder()
    local Folder = State.AutoOffense.PathFolder
    if Folder and Folder.Parent then return Folder end
    Folder = Instance.new('Folder')
    Folder.Name = 'GoldenEagleAutoOffensePath'
    Folder.Parent = Workspace
    State.AutoOffense.PathFolder = Folder
    State.AutoOffense.PathParts = {}
    return Folder
end

function State.AutoOffense.GetPathPart(Index)
    local Part = State.AutoOffense.PathParts[Index]
    if Part and Part.Parent then return Part end
    Part = Instance.new('Part')
    Part.Name = 'Route_' .. tostring(Index)
    Part.Anchored = true
    Part.CanCollide = false
    Part.CanTouch = false
    Part.CanQuery = false
    Part.CastShadow = false
    Part.Material = Enum.Material.Neon
    Part.Shape = Enum.PartType.Ball
    Part.Size = Vector3.new(0.48, 0.48, 0.48)
    Part.Transparency = 0.18
    Part.Parent = State.AutoOffense.GetPathFolder()
    State.AutoOffense.PathParts[Index] = Part
    return Part
end

function State.AutoOffense.UpdatePathVisual(Root, Points, Mode)
    if not State.AutoOffense.PathVisualEnabled
        or not State.AutoOffense.Enabled or not Root or not Points or #Points == 0 then
        State.AutoOffense.ClearPathVisual()
        return
    end
    local Now = os.clock()
    if Now - (State.AutoOffense.PathUpdatedAt or 0) < 0.05 then return end
    State.AutoOffense.PathUpdatedAt = Now
    local Color = Color3.fromRGB(255, 205, 55)
    if Mode == 'INBOUND' then Color = Color3.fromRGB(70, 215, 255)
    elseif Mode == 'PROTECT' then Color = Color3.fromRGB(255, 125, 45)
    elseif Mode == 'RECENTER' then Color = Color3.fromRGB(255, 70, 70)
    end
    local Samples = {}
    for Segment = 1, #Points - 1 do
        local A, B = Points[Segment], Points[Segment + 1]
        if typeof(A) == 'Vector3' and typeof(B) == 'Vector3' then
            local Delta = B - A
            local Steps = math.max(1, math.ceil(Delta.Magnitude / 2.5))
            for Index = 0, Steps - 1 do
                if #Samples >= 28 then break end
                Samples[#Samples + 1] = A:Lerp(B, Index / Steps)
            end
        end
        if #Samples >= 28 then break end
    end
    if #Samples < 28 and typeof(Points[#Points]) == 'Vector3' then
        Samples[#Samples + 1] = Points[#Points]
    end
    local GroundY = Root.Position.Y - 2.55
    for Index, Position in ipairs(Samples) do
        local Part = State.AutoOffense.GetPathPart(Index)
        Part.Color = Color
        Part.Size = Index == #Samples
            and Vector3.new(0.72, 0.72, 0.72)
            or Vector3.new(0.48, 0.48, 0.48)
        Part.Transparency = 0.18
        Part.CFrame = CFrame.new(Position.X, GroundY, Position.Z)
    end
    for Index = #Samples + 1, #State.AutoOffense.PathParts do
        local Part = State.AutoOffense.PathParts[Index]
        if Part and Part.Parent then Part.Transparency = 1 end
    end
end

function State.AutoOffense.GetLineRouteTarget(Origin, Rim, Court)
    if not Origin or not Rim then return Origin end
    local Delta = Rim.Position - Origin
    local Flat = Vector3.new(Delta.X, 0, Delta.Z)
    if Flat.Magnitude <= 0.05 then return Origin end
    local Target = Origin + Flat.Unit * math.max(0, Flat.Magnitude - 70)
    local _, SafeTarget = State.AutoOffense.GetSafeCourtBounds(Target, Court)
    return SafeTarget or Target
end

function State.AutoOffense.ChooseInboundSide(Root, Forward, Right, Court, DefenderRoot)
    local BestSign, BestTarget, BestScore = 1, nil, -math.huge
    for _, Sign in ipairs({ -1, 1 }) do
        local Direction = Right * Sign
        local Target = Root.Position + Direction * 9
        local Inside, SafeTarget, Clearance =
        State.AutoOffense.GetSafeCourtBounds(Target, Court)
        Target = SafeTarget or Target
        local Room = State.AutoOffense.LaneRoom(
            Root.Position, Direction, Court, 14,
            Sign < 0 and 'inbound-left' or 'inbound-right')
        local Score = Room * 2 + math.clamp(tonumber(Clearance) or 0, -20, 20)
        if Inside then Score += 30 else Score -= 50 end
        if DefenderRoot then
            local Predicted = DefenderRoot.Position
            + DefenderRoot.AssemblyLinearVelocity * 0.20
            Score += (Target - Predicted).Magnitude * 1.8
        end
        if Score > BestScore then
            BestSign, BestTarget, BestScore = Sign, Target, Score
        end
    end
    return BestSign, BestTarget
end

function State.AutoOffense.BeginInboundEscape(
        Root, Forward, Right, Court, DefenderRoot)
    local Sign, Target = State.AutoOffense.ChooseInboundSide(
        Root, Forward, Right, Court, DefenderRoot)
    State.AutoOffense.InboundActive = true
    State.AutoOffense.InboundStartedAt = os.clock()
    State.AutoOffense.InboundUntil = State.AutoOffense.InboundStartedAt + 0.72
    State.AutoOffense.InboundSide = Sign
    State.AutoOffense.InboundStartPosition = Root.Position
    State.AutoOffense.InboundTarget = Target
    State.AutoOffense.DriveStatus = Sign < 0
        and 'INBOUND LEFT' or 'INBOUND RIGHT'
end

function State.AutoOffense.EvaluateStrafeBallReach(
        Root, DefenderRoot, Forward, Right, Sign)
    if not (Root and DefenderRoot and Forward and Right and Sign) then
        return false, math.huge
    end
    local Basketball = GetHeldBasketballModel(LP)
    local Ball = Basketball and safe_find(Basketball, 'Ball')
    if not Ball then return false, math.huge end
    local DefenderVelocity = Vector3.new(
        DefenderRoot.AssemblyLinearVelocity.X, 0,
        DefenderRoot.AssemblyLinearVelocity.Z)
    local PredictedDefender = DefenderRoot.Position
    + DefenderVelocity * State.AutoOffense.DefenderPredictionTime
    local BallSideDistance = math.max(1.35, math.abs(
        (Ball.Position - Root.Position):Dot(Right)))
    local PredictedBall = Root.Position
    + Forward * 1.25
    + Right * Sign * (2.35 + BallSideDistance * 0.35)
    PredictedBall = Vector3.new(PredictedBall.X, Ball.Position.Y, PredictedBall.Z)
    local FlatDefender = Vector3.new(
        PredictedDefender.X, Ball.Position.Y, PredictedDefender.Z)
    local Clearance = (FlatDefender - PredictedBall).Magnitude
    local Reach = math.max(
        State.AutoOffense.BallThreatDistance,
        State.AutoOffense.EmergencyDefenderDistance) + 0.65
    return Clearance <= Reach, Clearance
end

function State.AutoOffense.GetGoalStrafeDirection(Forward, Right, Sign)
    if not (Forward and Right) then return Vector3.zero end
    Sign = Sign and Sign < 0 and -1 or 1

    local Direction = Forward * 0.52 + Right * Sign
    return Direction.Magnitude > 0.001 and Direction.Unit or Forward
end

function State.AutoOffense.SelectAdaptiveDriveDirection(Root, DefenderRoot, Forward, Right, Court, Rim)
    if not (Root and Forward and Right) then return Forward, 'FORWARD' end
    local Now = os.clock()
    local Routes = {
        { Name = 'FORWARD LEFT', Direction = Forward * 0.92 - Right * 0.55 },
        { Name = 'FORWARD RIGHT', Direction = Forward * 0.92 + Right * 0.55 },
        { Name = 'LEFT', Direction = Forward * 0.38 - Right * 0.94 },
        { Name = 'RIGHT', Direction = Forward * 0.38 + Right * 0.94 },
        { Name = 'BODY LEFT', Direction = Forward * 0.18 - Right * 0.98 },
        { Name = 'BODY RIGHT', Direction = Forward * 0.18 + Right * 0.98 },
    }
    local Opponents = {}
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LP and IsGuardOpponent(Player) then
            local Character = Player.Character
            local OpponentRoot = Character and Character:FindFirstChild('HumanoidRootPart')
            if OpponentRoot then Opponents[#Opponents + 1] = OpponentRoot end
        end
    end
    if DefenderRoot and not table.find(Opponents, DefenderRoot) then
        Opponents[#Opponents + 1] = DefenderRoot
    end
    local CrowdFactor = 1 + math.clamp(#Opponents - 1, 0, 4) * 0.12
    local LastRoute = State.AutoOffense.LastEscapeRoute
    local LastRouteAt = State.AutoOffense.LastEscapeRouteAt or 0
    local Profile = State.AutoOffense.ApplyBehaviorProfile()
    if State.AutoOffense.PredictiveEnabled == false then
        return Forward, 'DIRECT'
    end
    local RepeatWindow = Profile.RepeatWindow
    local RepeatPenalty = Profile.RepeatPenalty
    local Best, BestScore = nil, -math.huge
    for _, Route in ipairs(Routes) do
        local Direction = Route.Direction
        if Direction.Magnitude <= 0.01 then continue end
        Direction = Direction.Unit
        local Probe = Root.Position + Direction * math.clamp(
            State.AutoOffense.DriveLaneDistance or 9, 6, 14)
        local Score = Direction:Dot(Forward) * 9
        local LaneRoom = State.AutoOffense.LaneRoom(
            Root.Position, Direction, Court, State.AutoOffense.KeepInDistance,
            'adaptive-' .. Route.Name)
        Score += math.clamp(LaneRoom, -20, 20) * 1.4
        if Rim then
            local ToRim = Vector3.new(
                Rim.Position.X - Probe.X, 0, Rim.Position.Z - Probe.Z)
            if ToRim.Magnitude > 0.01 then
                Score += Direction:Dot(ToRim.Unit) * 5
            end
        end
        local MinimumClearance = 60
        for _, OpponentRoot in ipairs(Opponents) do
            local Velocity = OpponentRoot.AssemblyLinearVelocity
            local FlatVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
            local Predicted = OpponentRoot.Position
            + FlatVelocity * math.clamp(
                State.AutoOffense.DefenderPredictionTime or 0.28, 0.12, 0.65)
            local Clearance = (Predicted - Probe).Magnitude
            MinimumClearance = math.min(MinimumClearance, Clearance)
            local Closing = FlatVelocity.Magnitude > 0.05
                and FlatVelocity.Unit:Dot((Root.Position - Predicted).Unit) or 0
            local SameRouteMotion = FlatVelocity.Magnitude > 0.05
                and FlatVelocity.Unit:Dot(Direction) or 0
            Score += Clearance * (2.2 * CrowdFactor)
            Score -= math.max(0, Closing) * 1.8

            Score -= math.max(0, SameRouteMotion - 0.10) * 22
            Score += math.max(0, -SameRouteMotion) * 4
        end
        Score += math.clamp(MinimumClearance, 0, 24) * CrowdFactor
        if LastRoute == Route.Name
            and Now - LastRouteAt < math.max(RepeatWindow,
            State.AutoOffense.StrafeFlipCooldown or 0.45) then
            Score -= RepeatPenalty
        end
        if State.AutoOffense.PendingHardCut then
            Score += (Route.Name:find('LEFT', 1, true) and 2 or 0)
        end
        local Inside, _, EdgeClearance = State.AutoOffense.GetSafeCourtBounds(Probe, Court)
        if not Inside then Score -= 100 end
        Score += math.clamp(tonumber(EdgeClearance) or 0, 0, 10) * 0.5
        if Score > BestScore then
            Best, BestScore = { Direction = Direction, Name = Route.Name }, Score
        end
    end
    if not Best then return Forward, 'FORWARD' end
    if Best.Name ~= LastRoute then
        State.AutoOffense.LastEscapeRoute = Best.Name
        State.AutoOffense.LastEscapeRouteAt = Now
    end
    return Best.Direction, Best.Name
end

function State.AutoOffense.GetProtectedHand(Root, DefenderRoot, Forward, Right, RouteName)
    if not (Root and Forward and Right) then return nil end
    local DesiredHand
    local RouteText = tostring(RouteName or '')
    if RouteText:find('RIGHT', 1, true) then
        DesiredHand = 'R'
    elseif RouteText:find('LEFT', 1, true) then
        DesiredHand = 'L'
    else
        local Rim = State.AutoOffense.Target
        if not (Rim and Rim.Parent) then Rim = select(1, State.AutoOffense.GetScoringGoal()) end
        if Rim then
            local ToRim = Vector3.new(
                Rim.Position.X - Root.Position.X, 0,
                Rim.Position.Z - Root.Position.Z)
            if ToRim.Magnitude > 0.05 then
                DesiredHand = Right:Dot(ToRim.Unit) >= 0 and 'R' or 'L'
            end
        end
    end
    if DefenderRoot then
        local Offset = DefenderRoot.Position - Root.Position
        local Flat = Vector3.new(Offset.X, 0, Offset.Z)
        local Distance = Flat.Magnitude
        if Distance <= 13 and Distance > 0.05 then
            local DefenderSide = Flat.Unit:Dot(Right)
            if math.abs(DefenderSide) >= 0.18 then

                DesiredHand = DefenderSide > 0 and 'L' or 'R'
            end
        end
    end
    return DesiredHand
end

function State.AutoOffense.TryBallProtection(Root, DefenderRoot, Forward, Right, RouteName)
    if not (Root and DefenderRoot and State.AutoMix) then return nil end
    if State.AutoOffense.NativeHandlesEnabled == false then return nil end
    if not GetHeldBasketballModel(LP) then return nil end
    local Now = os.clock()
    local Offset = DefenderRoot.Position - Root.Position
    local FlatOffset = Vector3.new(Offset.X, 0, Offset.Z)
    local Distance = FlatOffset.Magnitude
    if Distance > 16 then return nil end
    local Velocity = DefenderRoot.AssemblyLinearVelocity
    local FlatVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
    local Closing = FlatOffset.Magnitude > 0.05
        and FlatVelocity:Dot(-FlatOffset.Unit) or 0
    local Action
    if RouteName and RouteName:find('LEFT', 1, true) then
        Action = 'BehindLeft'
    elseif RouteName and RouteName:find('RIGHT', 1, true) then
        Action = 'BehindRight'
    elseif (Closing >= 5 or Distance <= 6.5) then
        Action = 'SwitchHandles'
    else
        Action = (State.AutoOffense.BackdownStrafeSign or 1) < 0
            and 'BehindLeft' or 'BehindRight'
    end
    local CurrentHand = State.AutoBody and State.AutoBody.CurrentHand
    local DesiredHand = State.AutoOffense.GetProtectedHand(
        Root, DefenderRoot, Forward, Right, RouteName)
    local HandUnsafe = State.AutoOffense.RimSafeHandEnabled ~= false
        and DesiredHand and CurrentHand and CurrentHand ~= DesiredHand
    if HandUnsafe then
        Action = 'SwitchHandles'
    end
    local Cooldown = Action == 'SwitchHandles' and 0.85 or 0.55
    if Now - (State.AutoOffense.LastHandleActionAt or 0) >= Cooldown
        and not State.AutoMix.Busy then
        if State.AutoMix.Perform(Action) then
            State.AutoOffense.LastHandleActionAt = Now
            State.AutoOffense.LastHandleAction = Action
            State.AutoOffense.LastAutoHandAt = Now
            State.AutoOffense.AutoHandStatus = Action == 'SwitchHandles'
                and 'H SWITCH' or tostring(Action)
            local ExpectedHand = State.AutoMix.GetExpectedHand(
                Action, State.AutoBody.CurrentHand or 'R')
            if ExpectedHand then State.AutoBody.CurrentHand = ExpectedHand end
            return Action
        end
    end
    if Distance >= 9 and Closing <= 1
        and Now - (State.AutoOffense.LastTauntAt or 0) >= 2.5
        and not State.AutoMix.Busy then
        local Pressed = State.AutoMix.Perform('FakeOut')
        if Pressed then
            State.AutoOffense.LastTauntAt = Now
            return 'FAKE OUT R'
        end
    end
    return nil
end

function State.AutoOffense.PrepareShotFacing(Root, Humanoid, Rim, DeltaTime)

    State.AutoOffense.ShotShiftLockOwned = false
    State.AutoOffense.ShotFacingAt = os.clock()
    State.AutoOffense.ShotFacingGeneration =
    (State.AutoOffense.ShotFacingGeneration or 0) + 1
end

function State.AutoOffense.Step(DeltaTime)
    if not (State.Active and State.AutoOffense.Enabled) then return end
    if false then
        local Character=LP.Character
        local Humanoid=Character and Character:FindFirstChildOfClass('Humanoid')
        State.AutoOffense.ResetMovement(Humanoid,true)
        State.AutoOffense.Status='RIPPED | LOCAL GHOST STEAL'
        State.AutoOffense.ClearPathVisual()
        return
    end

    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
    if not Root or not Humanoid then
        State.AutoOffense.Status = 'WAITING FOR CHARACTER'
        State.AutoOffense.ClearPathVisual()
        return
    end

    if State.Movement and State.Movement.FlightEnabled then
        State.AutoOffense.ResetMovement(Humanoid, true)
        State.AutoOffense.Status = 'FLIGHT OVERRIDE'
        State.AutoOffense.ClearPathVisual()
        return
    end

    local HeldBall = GetHeldBasketballModel(LP)
    if not HeldBall then
        local LooseBall, LooseDistance = State.AutoGetOpen.GetNearestLooseBall(Root)
        if LooseBall and LooseDistance <= 85 then
            local BallDirection = Vector3.new(
                LooseBall.Position.X - Root.Position.X, 0,
                LooseBall.Position.Z - Root.Position.Z)
            if LooseDistance <= 4.5 and State.BallAssist.TryTouch then
                local TouchPart = State.BallAssist.GetNearestLocalPart(LooseBall)
                pcall(State.BallAssist.TryTouch, LooseBall, TouchPart, false)
            end
            if BallDirection.Magnitude > 0.08 then
                State.AutoOffense.MoveSmooth(Humanoid, Root, BallDirection, DeltaTime, State.AutoOffense.GetCourt())
            else
                State.AutoOffense.StopSmoothMovement(Humanoid)
            end
            State.AutoOffense.Status = string.format('RECOVERING LOOSE BALL | %.1f', LooseDistance)
            State.AutoOffense.ActionType = 'BALL RECOVERY'
            State.AutoOffense.Target = LooseBall.Position
            State.AutoOffense.TargetDistance = LooseDistance
            return
        end
        State.AutoOffense.HadBall = false
        State.AutoOffense.InboundActive = false
        State.AutoOffense.InboundStartPosition = nil
        State.AutoOffense.InboundTarget = nil
        State.AutoOffense.ResetMovement(Humanoid, true)
        State.AutoOffense.Status = 'NEED BALL'
        State.AutoOffense.ActionType = nil
        State.AutoOffense.Target = nil
        State.AutoOffense.TargetDistance = math.huge
        State.AutoOffense.ClearPathVisual()
        return
    end
    local NewPossession = not State.AutoOffense.HadBall
    if NewPossession then
        State.AutoOffense.HadBall = true
        State.AutoOffense.PossessionAt = os.clock()

        State.AutoOffense.InProgress = false
        State.AutoOffense.ShotRecoveryUntil = 0
        State.AutoOffense.Generation += 1
        State.AutoOffense.LastAction = 0
        State.AutoOffense.ActionType = 'POSSESSION RECOVERED'
        State.AutoOffense.SmoothedMoveDirection = Vector3.zero
        State.AutoOffense.LastIssuedDirection = Vector3.zero
        State.AutoOffense.DriveActive = false
        State.AutoOffense.BodyingSince = os.clock()
        State.AutoOffense.LastHandleActionAt = 0
        State.AutoOffense.LastLineAttempt = 0
        State.AutoOffense.LastTauntAt = 0
        State.AutoOffense.ShotFacingGeneration =
        (State.AutoOffense.ShotFacingGeneration or 0) + 1
        State.AutoOffense.ReleaseBackdown()
    end
    if State.AutoOffense.InProgress then return end
    local ManualDirection = State.AutoOffense.GetManualDirection(Humanoid, Root)
    local HasManual = ManualDirection.Magnitude > 0.05
    State.AutoOffense.ManualBlendActive = HasManual

    State.AutoOffense.MovementIsReset = false
    local Rim, Distance = State.AutoOffense.GetScoringGoal()
    State.AutoOffense.Target = Rim
    State.AutoOffense.TargetDistance = Distance or math.huge
    if not Rim then
        State.AutoOffense.ResetMovement(Humanoid)
        State.AutoOffense.Status = 'NO SCORING GOAL'
        State.AutoOffense.ClearPathVisual()
        return
    end

    local Delta = Rim.Position - Root.Position
    local Horizontal = Vector3.new(Delta.X, 0, Delta.Z)
    if Horizontal.Magnitude < 0.1 then
        State.AutoOffense.StopSmoothMovement(Humanoid)
        State.AutoOffense.ClearPathVisual()
        return
    end
    local Forward = Horizontal.Unit
    local Right = Vector3.new(-Forward.Z, 0, Forward.X)
    local Now = os.clock()
    local RefreshStatus = Now - State.AutoOffense.StatusUpdatedAt >= 0.08
    if RefreshStatus then State.AutoOffense.StatusUpdatedAt = Now end
    local Court = State.AutoOffense.GetCourt()
    local Defender, DefenderDistance = State.AutoOffense.GetDefender()
    local DefenderRoot = Defender and Defender.Character
        and Defender.Character:FindFirstChild('HumanoidRootPart')
    local NearbyDefenderCount = 0
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LP and IsGuardOpponent(Player) then
            local OtherCharacter = Player.Character
            local OtherRoot = OtherCharacter and OtherCharacter:FindFirstChild('HumanoidRootPart')
            if OtherRoot and (OtherRoot.Position - Root.Position).Magnitude <= 14 then
                NearbyDefenderCount += 1
            end
        end
    end
    State.AutoOffense.NearbyDefenderCount = NearbyDefenderCount
    State.AutoOffense.LastDefenderDistance = DefenderDistance
    local BallThreat, EscapeSign, BallClearance =
    State.AutoOffense.EvaluateBallThreat(Root, DefenderRoot, Right)
    local ImmediateThreat = BallThreat
        or (DefenderRoot and DefenderDistance <= 8.5)
    local ShieldThreat = BallThreat
        or State.AutoOffense.StealLaneAligned
        or Now < (State.AutoOffense.ShieldTurnUntil or 0)
    local TurnAround = State.AutoOffense.EvaluateCutoff(Root, DefenderRoot, Forward)
    local DriveLane = State.AutoOffense.UpdateDriveState(
        Root, DefenderRoot, Forward, Court, Rim, TurnAround,
        BallThreat, BallClearance, DefenderDistance)
    local MultiDefenderThreat = NearbyDefenderCount >= 2
    if MultiDefenderThreat then

        TurnAround = false
        DriveLane = true
        ShieldThreat = true
        if State.AutoOffense.RotationOwned then
            State.AutoBody.ReleaseRotation()
            State.AutoOffense.RotationOwned = false
        end
    end

    if DefenderRoot and ImmediateThreat and not State.AutoOffense.StealRangeLatched then
        State.AutoOffense.HandSwitchAllowed = false
        State.AutoOffense.HandSwitchBlockedUntil = math.max(
            State.AutoOffense.HandSwitchBlockedUntil or 0, Now + 0.18)
        State.AutoOffense.HandTurnAlignedSince = 0
        State.AutoOffense.HandCandidate = nil
        State.AutoOffense.HandCandidateSince = 0
    end
    if DefenderRoot and not DriveLane then
        State.AutoOffense.ApplyBackToDefender(
            Root, Humanoid, DefenderRoot, DeltaTime, TurnAround or ShieldThreat,
            ShieldThreat, BallClearance)
        State.AutoOffense.DriveStatus = ShieldThreat
            and 'SHIELD TURN | FAST TO 72 LINE'
            or 'BACK TURNED | FAST TO 72 LINE'
    elseif DefenderRoot and DriveLane then
        if State.AutoOffense.RotationOwned then
            State.AutoBody.ReleaseRotation()
            State.AutoOffense.RotationOwned = false
        end
        State.AutoOffense.DriveStatus = 'PREDICTIVE DRIVE | FAST TO 72 LINE'
    else
        State.AutoOffense.ReleaseBackdown()
    end

    if NewPossession and Distance > 76 then
        State.AutoOffense.BeginInboundEscape(
            Root, Forward, Right, Court, DefenderRoot)
    end

    if Distance <= 72.0 then
        if State.AutoOffense.ContinueAfterShot ~= false
            and Now < (State.AutoOffense.ShotRecoveryUntil or 0) then
            local ContinueDirection
            if DefenderRoot then
                ContinueDirection = select(1, State.AutoOffense.SelectAdaptiveDriveDirection(
                    Root, DefenderRoot, Forward, Right, Court, Rim))
            else
                ContinueDirection = Forward
            end
            State.AutoOffense.MoveSmooth(
                Humanoid, Root, ContinueDirection, DeltaTime, Court)
            State.AutoOffense.ActionType = 'POST SHOT ROUTE'
            State.AutoOffense.DriveStatus = 'POST-SHOT CONTINUE'
            State.AutoOffense.Status = 'POST-SHOT CONTINUE'
            return
        end
        local MinimumShotSeparation = math.max(
            8.5, tonumber(State.AutoOffense.StealThreatDistance) or 6.5)
        local SeparationBlocked = DefenderRoot and (
            DefenderDistance < MinimumShotSeparation
            or (tonumber(BallClearance) or math.huge) < 5.5
            or TurnAround
            or MultiDefenderThreat)
        if SeparationBlocked then
            local EscapeDirection, EscapeRoute =
            State.AutoOffense.SelectAdaptiveDriveDirection(
                Root, DefenderRoot, Forward, Right, Court, Rim)
            local EscapeAction = State.AutoOffense.TryBallProtection(
                Root, DefenderRoot, Forward, Right, EscapeRoute)
            State.AutoOffense.MoveSmooth(
                Humanoid, Root, EscapeDirection, DeltaTime, Court)
            State.AutoOffense.ActionType = 'SEPARATE BEFORE SHOT'
            State.AutoOffense.DriveStatus = string.format(
                'SEPARATING %s | %.1f TO 72 LINE%s',
                EscapeRoute, Distance - 72,
                EscapeAction and (' | ' .. EscapeAction) or '')
            State.AutoOffense.Status = State.AutoOffense.DriveStatus
            return
        end
        State.AutoOffense.InboundActive = false
        State.AutoOffense.LineShotDistance = Distance
        local NaturalShot, NaturalReason = State.AutoOffense.IsNaturalShotPosition(
            Root, Humanoid, Rim, Distance, DefenderRoot, DefenderDistance, BallClearance)
        if not NaturalShot then
            State.AutoOffense.ActionType = 'SETUP SHOT'
            State.AutoOffense.Status = NaturalReason or 'SETUP SHOT'
            local SetupDirection = Vector3.zero
            if Distance < 48 then

                SetupDirection = -Forward
            elseif NaturalReason == 'CREATE SEPARATION' or NaturalReason == 'PROTECT BALL' then
                SetupDirection = select(1, State.AutoOffense.SelectAdaptiveDriveDirection(
                    Root, DefenderRoot, Forward, Right, Court, Rim))
            end
            if SetupDirection.Magnitude > 0.05 then
                State.AutoOffense.MoveSmooth(
                    Humanoid, Root, SetupDirection, DeltaTime, Court)
            else
                State.AutoOffense.StopSmoothMovement(Humanoid)
            end
            return
        end
        State.AutoOffense.ActionType = 'SHOOT'
        local ShotPower = Distance >= 66 and 85
            or (Distance >= 56 and 80 or 75)
        State.AutoOffense.DriveStatus = string.format('OPEN RANGE | %d POWER', ShotPower)
        State.AutoOffense.BoundaryStatus = 'SHOT RANGE'
        State.AutoOffense.StopSmoothMovement(Humanoid)
        State.AutoOffense.ClearPathVisual()
        State.AutoOffense.PrepareShotFacing(Root, Humanoid, Rim, DeltaTime)
        State.AutoOffense.SelectedShotPower = ShotPower
        safe_set_attribute(LP, 'Power', ShotPower)
        if Now - (State.AutoOffense.LastLineAttempt or 0) >= math.clamp(
            tonumber(State.AutoOffense.ShotCooldown)
            or tonumber(CONFIG.AutoOffenseShotCooldown) or 0.45, 0.25, 2.0) then
            State.AutoOffense.LastLineAttempt = Now
            if State.AutoOffense.PerformShoot() then
                State.AutoOffense.Status = string.format(
                    'REGULAR JUMP SHOT | %d POWER | %.1f', ShotPower, Distance)
            else
                State.AutoOffense.Status = 'HOLDING 72 LINE | '
                .. tostring(State.AutoOffense.Status or 'WAITING')
            end
        end
        return
    end
    State.AutoOffense.LineShotDistance = math.huge

    local InsideSafe, RecoveryTarget, EdgeClearance =
    State.AutoOffense.GetSafeCourtBounds(Root.Position, Court)
    State.AutoOffense.EdgeClearance = EdgeClearance or math.huge
    if not InsideSafe and RecoveryTarget then
        local Recovery = Vector3.new(
            RecoveryTarget.X - Root.Position.X, 0,
            RecoveryTarget.Z - Root.Position.Z)
        if Recovery.Magnitude <= 0.05 then
            local Floor = State.AutoOffense.GetCourtFloor(Court)
            local Center = Floor and Floor.Position
            if not Center and Court then pcall(function() Center = Court:GetPivot().Position end) end
            if Center then
                Recovery = Vector3.new(
                    Center.X - Root.Position.X, 0,
                    Center.Z - Root.Position.Z)
            end
        end
        local RecoveryManual = false
        if Recovery.Magnitude > 0.05 then
            Recovery, RecoveryManual = State.AutoOffense.BlendManualDirection(
                Recovery, ManualDirection, true)
            State.AutoOffense.MoveSmooth(Humanoid, Root, Recovery, DeltaTime, Court)
        else
            State.AutoOffense.StopSmoothMovement(Humanoid)
        end
        State.AutoOffense.ManualBlendActive = RecoveryManual
        State.AutoOffense.ActionType = 'RECENTER'
        State.AutoOffense.DriveStatus = DefenderRoot
            and 'BACK TURNED | COURT RECENTER' or 'COURT RECENTER'
        local LineTarget = State.AutoOffense.GetLineRouteTarget(
            RecoveryTarget, Rim, Court)
        State.AutoOffense.UpdatePathVisual(
            Root, { Root.Position, RecoveryTarget, LineTarget }, 'RECENTER')
        if RefreshStatus then
            State.AutoOffense.Status = string.format(
                RecoveryManual and 'MANUAL + RECENTER | %.1f TO 72 LINE'
                or 'RECENTERING | %.1f TO 72 LINE', Distance - 72)
        end
        return
    end

    if State.AutoOffense.InboundActive then
        local Start = State.AutoOffense.InboundStartPosition or Root.Position
        local Travel = Vector3.new(
            Root.Position.X - Start.X, 0, Root.Position.Z - Start.Z).Magnitude
        if Now >= State.AutoOffense.InboundUntil or Travel >= 8 then
            State.AutoOffense.InboundActive = false
        else
            if ImmediateThreat then
                local Ok, Result = pcall(State.BallAssist.StepNoStealKeeper, Root)
                State.AutoOffense.ProtectStatus = Ok and tostring(Result) or 'KEEPER ERROR'
                if EscapeSign then
                    local SafeSign = State.AutoOffense.GetSafeStrafeSign(
                        Root.Position, Forward, Right, EscapeSign, Court)
                    if SafeSign then State.AutoOffense.InboundSide = SafeSign end
                end
            end
            local Sign = State.AutoOffense.InboundSide or 1
            local Direction = State.AutoOffense.GetGoalStrafeDirection(Forward, Right, Sign)
            local ManualInbound = false
            State.AutoOffense.ManualBlendActive = false
            local Actual, BoundaryAvoiding = State.AutoOffense.MoveSmooth(
                Humanoid, Root, Direction, DeltaTime, Court)
            local Target = State.AutoOffense.InboundTarget
                or (Root.Position + Direction * math.max(2, 8 - Travel))
            local LineTarget = State.AutoOffense.GetLineRouteTarget(Target, Rim, Court)
            State.AutoOffense.UpdatePathVisual(
                Root, { Root.Position, Target, LineTarget }, 'INBOUND')
            State.AutoOffense.ActionType = 'INBOUND'
            State.AutoOffense.DriveStatus = string.format(
                'BACK TURNED | INBOUND %s', Sign < 0 and 'LEFT' or 'RIGHT')
            if RefreshStatus then
                State.AutoOffense.Status = string.format(
                    '%s%s%s | THEN %.1f TO 72 LINE',
                    BoundaryAvoiding and 'COURT GUARD + ' or '',
                    ManualInbound and 'MANUAL + ' or '',
                    Sign < 0 and 'INBOUND LEFT' or 'INBOUND RIGHT',
                    Distance - 72)
            end
            return
        end
    end

    local Protecting = ImmediateThreat
    local CurrentSign = State.AutoOffense.BackdownStrafeSign
    if CurrentSign ~= -1 and CurrentSign ~= 1 then CurrentSign = 1 end
    local Sign = CurrentSign
    local CurrentReach, CurrentClearance = false, math.huge
    local OppositeReach, OppositeClearance = false, math.huge

    if DefenderRoot then
        local Ok, Result = pcall(State.BallAssist.StepNoStealKeeper, Root)
        State.AutoOffense.ProtectStatus = Ok and tostring(Result) or 'KEEPER ERROR'
        CurrentReach, CurrentClearance = State.AutoOffense.EvaluateStrafeBallReach(
            Root, DefenderRoot, Forward, Right, Sign)
        OppositeReach, OppositeClearance = State.AutoOffense.EvaluateStrafeBallReach(
            Root, DefenderRoot, Forward, Right, -Sign)
        local InStealRange = BallThreat or CurrentReach
        local CanCutBack = not State.AutoOffense.StealRangeLatched
            and Now >= (State.AutoOffense.StrafeLockUntil or 0)
            and Now - (State.AutoOffense.LastCutbackAt or 0)
        >= math.max(0.12, State.AutoOffense.StrafeFlipCooldown)
        if InStealRange then
            State.AutoOffense.StealRangeClearSince = 0

            if not State.AutoOffense.StealRangeLatched and CanCutBack then
                Sign = -Sign
                State.AutoOffense.StealRangeLatched = true
                State.AutoOffense.LastCutbackAt = Now
                State.AutoOffense.StrafeLockUntil = Now + 1.25
                State.AutoOffense.PendingHardCut = true
                State.AutoOffense.HandSwitchAllowed = false
                State.AutoOffense.HandSwitchBlockedUntil = Now + 0.18
                State.AutoOffense.HandTurnAlignedSince = 0
                State.AutoOffense.HandCandidate = nil
                State.AutoOffense.HandCandidateSince = 0
                State.AutoOffense.StrafeReason = 'TURN FIRST | THEN SWITCH HAND'
            else
                State.AutoOffense.StrafeReason = 'STEAL RANGE | HOLD SIDE'
            end
        else
            if State.AutoOffense.StealRangeLatched then
                if (State.AutoOffense.StealRangeClearSince or 0) <= 0 then
                    State.AutoOffense.StealRangeClearSince = Now
                elseif Now >= (State.AutoOffense.StrafeLockUntil or 0)
                    and Now - State.AutoOffense.StealRangeClearSince >= 0.85 then
                    State.AutoOffense.StealRangeLatched = false
                    State.AutoOffense.StealRangeClearSince = 0
                end
            end
            State.AutoOffense.StrafeReason = 'STICKY GOAL STRAFE'
        end
    else
        State.AutoOffense.ProtectStatus = 'CLEAR'
        State.AutoOffense.DefenderCanReachBall = false
        if State.AutoOffense.StealRangeLatched then
            if (State.AutoOffense.StealRangeClearSince or 0) <= 0 then
                State.AutoOffense.StealRangeClearSince = Now
            elseif Now >= (State.AutoOffense.StrafeLockUntil or 0)
                and Now - State.AutoOffense.StealRangeClearSince >= 0.85 then
                State.AutoOffense.StealRangeLatched = false
                State.AutoOffense.StealRangeClearSince = 0
            end
        end
        State.AutoOffense.StrafeReason = 'STICKY GOAL STRAFE'
    end

    local SafeSign, BoundaryFlip = State.AutoOffense.GetSafeStrafeSign(
        Root.Position, Forward, Right, Sign, Court)
    local CurrentRoom = State.AutoOffense.LaneRoom(
        Root.Position, Right * Sign, Court, State.AutoOffense.KeepInDistance,
        Sign < 0 and 'locked-left' or 'locked-right')
    local HardBoundary = CurrentRoom <= 2
    if SafeSign and (Now >= (State.AutoOffense.StrafeLockUntil or 0) or HardBoundary) then
        Sign = SafeSign
    end
    if BoundaryFlip and Sign ~= CurrentSign then
        State.AutoOffense.LastCutbackAt = Now
        State.AutoOffense.StrafeLockUntil = Now + 1.25
        State.AutoOffense.PendingHardCut = true
        State.AutoOffense.HandSwitchAllowed = false
        State.AutoOffense.HandSwitchBlockedUntil = Now + 0.18
        State.AutoOffense.HandTurnAlignedSince = 0
        State.AutoOffense.HandCandidate = nil
        State.AutoOffense.HandCandidateSince = 0
        State.AutoOffense.StrafeReason = 'COURT EDGE | TURN FIRST'
    end
    State.AutoOffense.BackdownStrafeSign = Sign
    State.AutoOffense.BackdownHasCommittedSide = true
    State.AutoOffense.DefenderCanReachBall = BallThreat or CurrentReach
    State.AutoOffense.OppositeBallClearance = OppositeClearance

    local Direction
    if DriveLane then
        local AdaptiveDirection, AdaptiveRoute =
        State.AutoOffense.SelectAdaptiveDriveDirection(
            Root, DefenderRoot, Forward, Right, Court, Rim)
        Direction = AdaptiveDirection
        State.AutoOffense.DriveStatus = string.format(
            'PREDICTIVE %s | FAST TO 72 LINE', AdaptiveRoute)
        local HandleAction = State.AutoOffense.TryBallProtection(
            Root, DefenderRoot, Forward, Right, AdaptiveRoute)
        if HandleAction then
            State.AutoOffense.DriveStatus = State.AutoOffense.DriveStatus
            .. ' | ' .. HandleAction
        end
    else
        Direction = State.AutoOffense.GetGoalStrafeDirection(Forward, Right, Sign)
    end
    if State.AutoOffense.PendingHardCut then

        State.AutoOffense.SmoothedMoveDirection = Direction
        State.AutoOffense.LastIssuedDirection = Direction
        State.AutoOffense.PendingHardCut = false
    end
    State.AutoOffense.ActionType = State.AutoOffense.DefenderCanReachBall
        and 'CUTBACK' or 'GOAL STRAFE'
    State.AutoOffense.DriveStatus = string.format(
        '%s | %s', Sign > 0 and 'STRAFE RIGHT' or 'STRAFE LEFT',
        State.AutoOffense.StrafeReason)

    State.AutoOffense.ManualBlendActive = false
    local ManualBlended = false
    local Actual, BoundaryAvoiding = State.AutoOffense.MoveSmooth(
        Humanoid, Root, Direction, DeltaTime, Court)
    local PreviewDirection = Actual and Actual.Magnitude > 0.05
        and Actual.Unit or Direction
    local Mid = Root.Position + PreviewDirection * math.min(10, Distance - 72)
    local LineTarget = State.AutoOffense.GetLineRouteTarget(Root.Position, Rim, Court)
    State.AutoOffense.UpdatePathVisual(
        Root, { Root.Position, Mid, LineTarget },
        Protecting and 'PROTECT' or 'SPRINT')
    if RefreshStatus then
        if BoundaryAvoiding then
            State.AutoOffense.Status = string.format(
                ManualBlended and 'MANUAL + COURT GUARD | %.1f TO 72 LINE'
                or 'COURT GUARD | %.1f TO 72 LINE', Distance - 72)
        elseif Protecting then
            State.AutoOffense.Status = string.format(
                ManualBlended
                and 'MANUAL + PROTECT | %.1f TO LINE | %.1f CLEAR'
                or 'BACK TURNED | PROTECT + SPRINT | %.1f TO LINE | %.1f CLEAR',
                Distance - 72, BallClearance or math.huge)
        else
            State.AutoOffense.Status = string.format(
                ManualBlended and 'MANUAL + ROUTE | %.1f TO 72 LINE'
                or (DefenderRoot and 'BACK TURNED | FULL SPEED | %.1f TO 72 LINE'
                or 'FULL SPEED | %.1f TO 72 LINE'), Distance - 72)
        end
    end
end

function State.AutoOffense.UpdateBinding()
    pcall(function() State.Lifecycle:UnbindFromRenderStep(State.AutoOffense.BindName) end)

    if not State.AutoOffense.Enabled then
        State.AutoOffense.ClearPathVisual()
        State.AutoOffense.Generation += 1
        State.AutoOffense.InProgress = false
        State.AutoOffense.Status = 'OFF'
        State.AutoOffense.Target = nil
        State.AutoOffense.TargetDistance = math.huge
        local Character = LP.Character
        local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
        State.AutoOffense.ResetMovement(Humanoid)
        if State.AutoDunk.InProgress then State.AutoDunk.ReleaseKey() end
        return
    end

    State.AutoOffense.Status = 'READY'
    State.Lifecycle:BindToRenderStep(
        State.AutoOffense.BindName,
        Enum.RenderPriority.Input.Value + 4,
        WYNF_JIT(function(DeltaTime)
        if not (State.Active and State.AutoOffense.Enabled) then return end
        State.AutoOffense.Step(DeltaTime)
    end)
    )
end

