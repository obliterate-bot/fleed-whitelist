    Status = 'off',
    Ghost = nil,
    GhostParts = {},
    SourceParts = {},
    SourceCharacter = nil,
    ClientHighlight = nil,
    ServerHighlight = nil,
    History = {},
    FrozenCFrame = nil,
    WarnedUpdate = false,
}

function State.DesyncVisualizer.DestroyGhost()
    if State.DesyncVisualizer.Ghost then pcall(function() State.DesyncVisualizer.Ghost:Destroy() end) end
    if State.DesyncVisualizer.ServerHighlight then pcall(function() State.DesyncVisualizer.ServerHighlight:Destroy() end) end
    if State.DesyncVisualizer.ClientHighlight then pcall(function() State.DesyncVisualizer.ClientHighlight:Destroy() end) end
    State.DesyncVisualizer.Ghost = nil
    State.DesyncVisualizer.ServerHighlight = nil
    State.DesyncVisualizer.ClientHighlight = nil
    State.DesyncVisualizer.SourceCharacter = nil
    table.clear(State.DesyncVisualizer.GhostParts)
    table.clear(State.DesyncVisualizer.SourceParts)
    table.clear(State.DesyncVisualizer.History)
    State.DesyncVisualizer.FrozenCFrame = nil
end

function State.DesyncVisualizer.BuildGhost()
    State.DesyncVisualizer.DestroyGhost()
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    if not (Character and Root) then
        State.DesyncVisualizer.Status = 'waiting for character'
        return false
    end
    local Ghost = State.GhostReplay.CloneCompleteInstance(Character)
    if not Ghost then
        State.DesyncVisualizer.Status = 'snapshot failed'
        return false
    end
    Ghost.Name = 'GoldenEagleDesyncGhost'
    local Transparency = math.clamp(tonumber(CONFIG.DesyncVisualizerTransparency) or 0.8, 0.05, 1)
    for _, Object in ipairs(Ghost:GetDescendants()) do
        if Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
            or Object:IsA('Sound') or Object:IsA('BillboardGui') or Object:IsA('ProximityPrompt')
            or Object:IsA('ForceField') then
            Object:Destroy()
        elseif Object:IsA('Humanoid') then
            Object.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            Object.NameDisplayDistance = 0
            Object.HealthDisplayDistance = 0
            Object.AutoRotate = false
            Object.PlatformStand = true
            Object.BreakJointsOnDeath = false

            pcall(function() Object.EvaluateStateMachine = false end)
            pcall(function() Object:ChangeState(Enum.HumanoidStateType.Physics) end)
        elseif Object:IsA('BasePart') then
            Object.Anchored = true
            Object.CanCollide = false
            Object.CanTouch = false
            Object.CanQuery = false
            Object.Massless = true
            Object.CastShadow = false
            Object.LocalTransparencyModifier = Transparency
        end
    end
    local Map = {}
    for _, Object in ipairs(Ghost:GetDescendants()) do
        if Object:IsA('BasePart') then
            Map[State.GhostReplay.GetPartPath(Object, Ghost)] = Object
        end
    end
    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:IsA('BasePart') then
            local Twin = Map[State.GhostReplay.GetPartPath(Object, Character)]
            if Twin then
                table.insert(State.DesyncVisualizer.SourceParts, Object)
                table.insert(State.DesyncVisualizer.GhostParts, Twin)
            end
        end
    end
    Ghost.Parent = HiddenWorld()
    local ServerHighlight = Instance.new('Highlight')
    ServerHighlight.Name = 'GoldenEagleDesyncServerHighlight'
    ServerHighlight.Adornee = Ghost
    ServerHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    ServerHighlight.FillColor = Color3.fromRGB(255, 64, 64)
    ServerHighlight.FillTransparency = 0.9
    ServerHighlight.OutlineColor = Color3.fromRGB(255, 70, 70)
    ServerHighlight.OutlineTransparency = 0
    ServerHighlight.Parent = HiddenGui()
    local ClientHighlight = Instance.new('Highlight')
    ClientHighlight.Name = 'GoldenEagleDesyncClientHighlight'
    ClientHighlight.Adornee = Character
    ClientHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    ClientHighlight.FillTransparency = 1
    ClientHighlight.OutlineColor = Color3.fromRGB(64, 255, 96)
    ClientHighlight.OutlineTransparency = 0
    ClientHighlight.Parent = HiddenGui()
    State.DesyncVisualizer.Ghost = Ghost
    State.DesyncVisualizer.ServerHighlight = ServerHighlight
    State.DesyncVisualizer.ClientHighlight = ClientHighlight
    State.DesyncVisualizer.SourceCharacter = Character
    State.DesyncVisualizer.Status = 'active'
    return true
end

function State.DesyncVisualizer.EstimateServerRootCFrame(RootCFrame, Now)
    State.DesyncVisualizer.FrozenCFrame = nil
    local Delay = math.clamp((State.Utility.GetPing() or 0) / 1000, 0.03, 0.6)
    local History = State.DesyncVisualizer.History
    local Best = RootCFrame
    for Index = #History, 1, -1 do
        local Entry = History[Index]
        if Now - Entry[1] >= Delay then
            Best = Entry[2]
            break
        end
    end
    return Best
end

function State.DesyncVisualizer.Update()
    if not State.DesyncVisualizer.Enabled then return end
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    if not (Character and Root) then
        State.DesyncVisualizer.Status = 'waiting for character'
        return
    end
    if State.DesyncVisualizer.SourceCharacter ~= Character
        or not State.DesyncVisualizer.Ghost
        or not State.DesyncVisualizer.Ghost.Parent then
        if not State.DesyncVisualizer.BuildGhost() then return end
    end
    local Now = os.clock()
    local History = State.DesyncVisualizer.History
    table.insert(History, { Now, Root.CFrame })
    while #History > 0 and Now - History[1][1] > 2 do
        table.remove(History, 1)
    end
    local ServerRoot = State.DesyncVisualizer.EstimateServerRootCFrame(Root.CFrame, Now)
    local ToServer = ServerRoot * Root.CFrame:Inverse()
    for Index, SourcePart in ipairs(State.DesyncVisualizer.SourceParts) do
        local GhostPart = State.DesyncVisualizer.GhostParts[Index]
        if GhostPart and GhostPart.Parent and SourcePart and SourcePart.Parent then
            GhostPart.CFrame = ToServer * SourcePart.CFrame

            if GhostPart.CanCollide then GhostPart.CanCollide = false end
            if GhostPart.CanTouch then GhostPart.CanTouch = false end
            if GhostPart.CanQuery then GhostPart.CanQuery = false end
            if not GhostPart.Anchored then GhostPart.Anchored = true end
        end
    end
    local Gap = (ServerRoot.Position - Root.Position).Magnitude
    State.DesyncVisualizer.Status = string.format('active  gap %.1f studs', Gap)
end

function State.DesyncVisualizer.SetEnabled(Enabled)
    State.DesyncVisualizer.Enabled = Enabled == true
    CONFIG.DesyncVisualizer = State.DesyncVisualizer.Enabled
    if State.DesyncVisualizer.Enabled then
        State.DesyncVisualizer.BuildGhost()
    else
        State.DesyncVisualizer.DestroyGhost()
        State.DesyncVisualizer.Status = 'off'
    end
    if HubUI.Sync then HubUI.Sync() end
end

