        local function AddName(Output, Seen, Name)
            Name = SanitizeConfigName(Name)
            if Name ~= '' and not Seen[Name] then
                Seen[Name] = true
                table.insert(Output, Name)
            end
        end

        local function RefreshNames(ScanDisk)
            local Found, Seen = {}, {}
            for Name in pairs(SessionStore) do AddName(Found, Seen, Name) end
            if ScanDisk and type(listfiles) == 'function' and type(isfolder) == 'function' then
                local FolderOk, Exists = pcall(isfolder, ConfigFolder)
                if FolderOk and Exists then
                    local ListOk, Files = pcall(listfiles, ConfigFolder)
                    if ListOk and type(Files) == 'table' then
                        for _, Path in ipairs(Files) do
                            local Stem = tostring(Path):match('([^/\\]+)%.json$')
                            if Stem then AddName(Found, Seen, Stem:gsub('_', ' ')) end
                        end
                    end
                end
            end
            table.sort(Found, function(A, B) return string.lower(A) < string.lower(B) end)
            table.clear(ConfigNames)
            if #Found == 0 then
                table.insert(ConfigNames, 'None')
                SelectedName = 'None'
            else
                for _, Name in ipairs(Found) do table.insert(ConfigNames, Name) end
                if not table.find(ConfigNames, SelectedName) then SelectedName = ConfigNames[1] end
            end
            if Selector then Selector:Set(SelectedName, false) end
        end
        RefreshNames(true)

        Selector = CreateDropdown(
            Groups.Profiles, 63, 'Saved config', ConfigNames, SelectedName,
            function(Value)
            SelectedName = tostring(Value)
            if SelectedName ~= 'None' then NameBox.Text = SelectedName end
        end,
            139
        )
