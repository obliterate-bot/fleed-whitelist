    if not (State.Active and State.OffenseTrainer.Recording) then return end
    pcall(State.OffenseTrainer.Step)
end)))

local POLICY_SCALES = {
    gd = 20,
    ga = 60,
    dd = 8,
    da = 90,
    dc = 10,
    help = 1.5,
    td = 20,
    to = 8,
    sp = 10,
    vg = 10,
    btb = 1,
    gr = 1,
    clk = 8,
    mg = 6,
}

State.OffensePolicy = {
    Enabled = false,
    Status = 'OFF',
    Action = '--',
    Confidence = 0,
    Neighbors = 0,
    Decision = '--',
    LastPredictAt = 0,
    Cached = nil,
    VetoSince = 0,
    Holds = 0,
    Overrides = 0,
    FeatureKeys = {
    'gd', 'ga', 'dd', 'da', 'dc', 'help', 'td',
    'to', 'sp', 'vg', 'btb', 'gr', 'clk', 'mg',
    },
}

function State.OffensePolicy.Distance(A, B)
    local Total = 0
    for _, Key in ipairs(State.OffensePolicy.FeatureKeys) do
        local Scale = POLICY_SCALES[Key]
        local Left = tonumber(A[Key]) or 0
        local Right = tonumber(B[Key]) or 0
        local Difference = (Left - Right) / Scale
        Total += Difference * Difference
    end
    return math.sqrt(Total)
end

function State.OffensePolicy.Predict(Features)
    local Samples = State.OffenseTrainer.Samples
    local SampleCount = #Samples
    if SampleCount == 0 then return nil end

    local K = math.clamp(
        math.floor(tonumber(CONFIG.OffensePolicyNeighbors) or 12), 3, 60)
    local Mode = State.OffenseTrainer.ModeKey()

    local Best = {}
    for Index = 1, SampleCount do
        local Row = Samples[Index]
        if Row and Row.o ~= nil and type(Row.f) == 'table' then
            local Distance = State.OffensePolicy.Distance(Features, Row.f)
            if Row.m ~= Mode then Distance += 0.6 end
            local Count = #Best
            if Count < K or Distance < Best[Count].d then
                local Position = Count + 1
                while Position > 1 and Best[Position - 1].d > Distance do
                    Best[Position] = Best[Position - 1]
                    Position -= 1
                end
                Best[Position] = { d = Distance, r = Row }
                if #Best > K then table.remove(Best) end
            end
        end
    end

    local Neighbors = #Best
    if Neighbors == 0 then return nil end

    local Scores = {}
    local Magnitude = 0
    for _, Entry in ipairs(Best) do
        local Row = Entry.r
        local Closeness = 1 / (Entry.d + 0.35)
        local Vote = Closeness * (tonumber(Row.w) or 1)
        * (Row.o == 1 and 1 or -0.6)
        Scores[Row.a] = (Scores[Row.a] or 0) + Vote
        Magnitude += math.abs(Vote)
    end

    local BestAction, BestScore = nil, 0
    for Action, Score in pairs(Scores) do
        if Score > BestScore then
            BestAction, BestScore = Action, Score
        end
    end
    if not BestAction or Magnitude <= 0 then
        return {
            action = nil, confidence = 0, neighbors = Neighbors,
            spread = Best[Neighbors].d,
        }
    end

    return {
        action = BestAction,
        confidence = math.clamp(BestScore / Magnitude, 0, 1),
        neighbors = Neighbors,
        spread = Best[Neighbors].d,
    }
end

function State.OffensePolicy.Decide()
    if not State.OffensePolicy.Enabled then
        State.OffensePolicy.Status = 'OFF'
        return nil
    end

    local Now = os.clock()
    if Now - State.OffensePolicy.LastPredictAt < 0.25 then
        return State.OffensePolicy.Cached
    end
    State.OffensePolicy.LastPredictAt = Now

    local Features = State.OffenseTrainer.BuildFeatures()
    if not Features then
        State.OffensePolicy.Status = 'NO READ'
        State.OffensePolicy.Cached = nil
        return nil
    end

    local Result = State.OffensePolicy.Predict(Features)
    if not Result then
        State.OffensePolicy.Status = 'NO TRAINING DATA'
        State.OffensePolicy.Action = '--'
        State.OffensePolicy.Confidence = 0
        State.OffensePolicy.Neighbors = 0
        State.OffensePolicy.Cached = nil
        return nil
    end

    local MinNeighbors = math.clamp(
        math.floor(tonumber(CONFIG.OffensePolicyMinNeighbors) or 8), 1, 60)
    if Result.neighbors < MinNeighbors then
        State.OffensePolicy.Status = string.format(
            'COLD START %d/%d', Result.neighbors, MinNeighbors)
        State.OffensePolicy.Action = Result.action or '--'
        State.OffensePolicy.Confidence = Result.confidence or 0
        State.OffensePolicy.Neighbors = Result.neighbors
        State.OffensePolicy.Cached = nil
        return nil
    end

    State.OffensePolicy.Status = 'LEARNED'
    State.OffensePolicy.Action = Result.action or '--'
    State.OffensePolicy.Confidence = Result.confidence or 0
    State.OffensePolicy.Neighbors = Result.neighbors
    State.OffensePolicy.Cached = Result
    return Result
end

function State.OffensePolicy.PreferredFinish()
    local Result = State.OffensePolicy.Decide()
    if not Result or not Result.action then return nil end
    local Threshold = math.clamp(
        tonumber(CONFIG.OffensePolicyConfidence) or 0.55, 0.05, 0.99)
    if Result.confidence < Threshold then return nil end
    if Result.action == 'dunk' or Result.action == 'shoot' then
        State.OffensePolicy.Decision = 'FINISH ' .. string.upper(Result.action)
        return Result.action
    end
    return nil
end

function State.OffensePolicy.AllowShot()
    if not State.OffensePolicy.Enabled then return true, 'PRESET' end

    local Result = State.OffensePolicy.Decide()
    if not Result or not Result.action then
        State.OffensePolicy.VetoSince = 0
        return true, 'PRESET'
    end

    local Threshold = math.clamp(
        tonumber(CONFIG.OffensePolicyConfidence) or 0.55, 0.05, 0.99)
    if Result.confidence < Threshold then
        State.OffensePolicy.VetoSince = 0
        State.OffensePolicy.Decision = string.format(
            'LOW CONF %.0f%%', Result.confidence * 100)
        return true, 'LOW CONFIDENCE'
    end

    if Result.action == 'shoot' or Result.action == 'dunk' then
        State.OffensePolicy.VetoSince = 0
        State.OffensePolicy.Overrides += 1
        State.OffensePolicy.Decision = 'TAKE ' .. string.upper(Result.action)
        return true, 'LEARNED ' .. string.upper(Result.action)
    end

    local Now = os.clock()
    local Patience = math.clamp(tonumber(CONFIG.OffensePolicyPatience) or 3, 0.5, 15)
    if State.OffensePolicy.VetoSince == 0 then
        State.OffensePolicy.VetoSince = Now
    end
    if Now - State.OffensePolicy.VetoSince >= Patience then
        State.OffensePolicy.VetoSince = 0
        State.OffensePolicy.Decision = 'PATIENCE EXPIRED'
        return true, 'PATIENCE'
    end

    State.OffensePolicy.Holds += 1
    State.OffensePolicy.Decision = 'WORK ' .. string.upper(Result.action)
    return false, 'HOLD FOR ' .. string.upper(Result.action)
end

function State.OffensePolicy.SetEnabled(Enabled, ShouldNotify)
    Enabled = Enabled == true
    CONFIG.OffensePolicy = Enabled
    State.OffensePolicy.Enabled = Enabled
    State.OffensePolicy.Cached = nil
    State.OffensePolicy.LastPredictAt = 0
    State.OffensePolicy.VetoSince = 0
    State.OffensePolicy.Status = Enabled and 'LEARNED' or 'OFF'
    if Enabled then
        State.OffenseTrainer.Load()
        local _, Labeled = State.OffenseTrainer.GetCounts()
        if ShouldNotify then
            Notify('LEARNED OFFENSE', string.format(
                'Auto Offense now uses %d scored rows from your games.', Labeled))
        end
    elseif ShouldNotify then
        Notify('LEARNED OFFENSE', 'Back to preset offense logic.')
    end
    if HubUI.Sync then HubUI.Sync() end
end

function State.OffenseTrainer.GetSummaryText()
    local Now = os.clock()
    if State.OffenseTrainer.SummaryAt and Now - State.OffenseTrainer.SummaryAt < 1 then
        return State.OffenseTrainer.SummaryCache or 'no data yet'
    end

    local Order = { 'shoot', 'dunk', 'pass', 'drive', 'backdown', 'reset' }
    local Stats = {}
    for _, Name in ipairs(Order) do Stats[Name] = { total = 0, labeled = 0, good = 0 } end
    for _, Row in ipairs(State.OffenseTrainer.Samples) do
        local Bucket = Stats[Row.a]
        if Bucket then
            Bucket.total += 1
            if Row.o ~= nil then
                Bucket.labeled += 1
                if Row.o == 1 then Bucket.good += 1 end
            end
        end
    end

    local Lines = {}
    for _, Name in ipairs(Order) do
        local Bucket = Stats[Name]
        table.insert(Lines, string.format(
            '%-9s %4d rows  %3d scored  %3d%% good',
            string.upper(Name),
            Bucket.total,
            Bucket.labeled,
            Bucket.labeled > 0 and math.floor(Bucket.good / Bucket.labeled * 100 + 0.5) or 0
        ))
    end

    State.OffenseTrainer.SummaryAt = Now
    State.OffenseTrainer.SummaryCache = table.concat(Lines, '\n')
    return State.OffenseTrainer.SummaryCache
end

