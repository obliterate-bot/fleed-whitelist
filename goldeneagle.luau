function State.Extras.GetCourtQueueArrival(Court)
    if not Court then return nil end
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local CourtCFrame = State.Extras.GetTravelObjectCFrame(Court)
    local Pads = safe_find(Court, '_CourtPads') or safe_find(Court, 'CourtPads')
    if not (CourtCFrame and Pads) then return CourtCFrame end

    local BestPadCFrame, BestDistance = nil, math.huge
    for _, Pad in ipairs(Pads:GetChildren()) do
        local PadCFrame = State.Extras.GetTravelObjectCFrame(safe_find(Pad, 'Center') or Pad)
        if PadCFrame then
            local Distance = Root and (Root.Position - PadCFrame.Position).Magnitude or 0
            if Distance < BestDistance then
                BestDistance, BestPadCFrame = Distance, PadCFrame
            end
        end
    end
    if not BestPadCFrame then return CourtCFrame end

    local Away = Vector3.new(
        BestPadCFrame.Position.X - CourtCFrame.Position.X,
        0,
        BestPadCFrame.Position.Z - CourtCFrame.Position.Z
    )
    if Away.Magnitude < 0.1 then
        Away = Vector3.new(BestPadCFrame.LookVector.X, 0, BestPadCFrame.LookVector.Z)
    end
    if Away.Magnitude < 0.1 then Away = Vector3.new(0, 0, 1) end
    Away = Away.Unit
    local Arrival = BestPadCFrame.Position + Away * 8
    return CFrame.lookAt(Arrival, Vector3.new(
        BestPadCFrame.Position.X, Arrival.Y, BestPadCFrame.Position.Z
    ))
end

function State.Extras.GetSafeCityArrival(City)
    if not City then return nil end
    local Parts = {}
    if safe_is_a(City, 'BasePart') then table.insert(Parts, City) end
    for _, Descendant in ipairs(City:GetDescendants()) do
        if safe_is_a(Descendant, 'BasePart') then table.insert(Parts, Descendant) end
    end
    if #Parts == 0 then return State.Extras.GetTravelObjectCFrame(City) end

    local Minimum = Vector3.new(math.huge, math.huge, math.huge)
    local Maximum = Vector3.new(-math.huge, -math.huge, -math.huge)
    for _, Part in ipairs(Parts) do
        local Half = Part.Size * 0.5
        local Position = Part.Position
        Minimum = Vector3.new(
            math.min(Minimum.X, Position.X - Half.X),
            math.min(Minimum.Y, Position.Y - Half.Y),
            math.min(Minimum.Z, Position.Z - Half.Z)
        )
        Maximum = Vector3.new(
            math.max(Maximum.X, Position.X + Half.X),
            math.max(Maximum.Y, Position.Y + Half.Y),
            math.max(Maximum.Z, Position.Z + Half.Z)
        )
    end

    local Center = (Minimum + Maximum) * 0.5
    local RayOrigin = Vector3.new(Center.X, Maximum.Y + 150, Center.Z)
    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude
    RayParams.FilterDescendantsInstances = LP.Character and { LP.Character } or {}
    RayParams.IgnoreWater = false
    local Hit = Workspace:Raycast(
        RayOrigin,
        Vector3.new(0, -math.max(600, Maximum.Y - Minimum.Y + 300), 0),
        RayParams
    )
    if Hit then
        return CFrame.new(Hit.Position, Hit.Position + Vector3.new(0, 0, -1))
    end

    local HighestPart = Parts[1]
    for _, Part in ipairs(Parts) do
        if Part.Position.Y + Part.Size.Y * 0.5 > HighestPart.Position.Y + HighestPart.Size.Y * 0.5 then
            HighestPart = Part
        end
    end
    return HighestPart.CFrame + Vector3.new(0, HighestPart.Size.Y * 0.5, 0)
end

function State.Extras.IsTravelPlayerInGame(Player)
    if not Player then return false end
    if safe_get_attribute(Player, 'Ingame') == true
        or safe_get_attribute(Player, 'InGame') == true
        or safe_get_attribute(Player, 'InMatch') == true then
        return true
    end

    local Character = Player.Character
    if Character and (safe_get_attribute(Character, 'Ingame') == true
        or safe_get_attribute(Character, 'InGame') == true
        or safe_get_attribute(Character, 'InMatch') == true) then
        return true
    end
    if GetHeldBasketballCurrentGame(Player) then return true end

    local Court = FindPlayerCourtSlot(Player)
    if Court then
        local Settings = safe_find(Court, '_CourtSettings')
        local Started = Settings and safe_find(Settings, 'Started')
        if Started then
            local ReadOk, StartedValue = pcall(function() return Started.Value end)
            if ReadOk and (StartedValue == true or StartedValue == 1 or StartedValue == 'true') then
                return true
            end
        end
        if safe_get_attribute(Court, 'Started') == true
            or safe_get_attribute(Court, 'InGame') == true
            or safe_get_attribute(Court, 'GameActive') == true then
            return true
        end
    end
    return false
end

function State.Extras.RefreshTravelOptions()
    local DestinationOptions = State.Extras.QuickTravelDestinationOptions
    table.clear(DestinationOptions)
    local Fixed = {
        'Nearest Queue', 'Current Court', 'Spawn', 'Daily Spin', 'Donation Area',
        'City Center', 'Leaderboard Hub', 'Leaderboard: ELO',
        'Leaderboard: Highest Streak', 'Leaderboard: Wins', 'Leaderboard: Donation',
        'Practice Entrance', 'Practice Exit', 'Nearest Practice Court',
        'Practice Half Court', 'Practice Full Court',
    }
    for _, Name in ipairs(Fixed) do table.insert(DestinationOptions, Name) end
    for LetterCode = string.byte('A'), string.byte('K') do
        table.insert(DestinationOptions, 'Court ' .. string.char(LetterCode))
    end

    for _, Court in ipairs(State.Extras.GetTravelCourts()) do
        local CourtName = Court.Name:gsub('_', ' ')
        if not table.find(DestinationOptions, CourtName) then
            table.insert(DestinationOptions, CourtName)
        end
        local Pads = safe_find(Court, '_CourtPads') or safe_find(Court, 'CourtPads')
        if Pads then
            local PadNames = {}
            for _, Pad in ipairs(Pads:GetChildren()) do
                if ResolveQuickTravelPart(safe_find(Pad, 'Center') or Pad) then
                    table.insert(PadNames, Pad.Name)
                end
            end
            table.sort(PadNames)
            for _, PadName in ipairs(PadNames) do
                table.insert(DestinationOptions, 'Queue | ' .. CourtName .. ' | ' .. PadName)
            end
        end
    end

    local Servers = {
        'Server: Park', 'Server: Arena', 'Server: Arena Mobile', 'Server: Arena League',
        'Server: Test Park', 'Server: Test Arena', 'Server: Troll Mode',
    }
    for _, Name in ipairs(Servers) do table.insert(DestinationOptions, Name) end
    if not table.find(DestinationOptions, CONFIG.QuickTravelDestination) then
        CONFIG.QuickTravelDestination = DestinationOptions[1] or 'Spawn'
    end

    local PlayerOptions = State.Extras.QuickTravelPlayerOptions
    local SelectedUsername = string.match(tostring(CONFIG.QuickTravelPlayer or ''), '^@([^|%s]+)')
    local UpdatedSelection = nil
    table.clear(PlayerOptions)
    table.insert(PlayerOptions, 'Select Player')
    local PlayerNames = {}
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LP then table.insert(PlayerNames, Player) end
    end
    table.sort(PlayerNames, function(A, B)
        return string.lower(A.Name) < string.lower(B.Name)
    end)
    for _, Player in ipairs(PlayerNames) do
        local Label = '@' .. Player.Name
        if Player.DisplayName ~= Player.Name then Label ..= ' | ' .. Player.DisplayName end
        if State.Extras.IsTravelPlayerInGame(Player) then Label ..= ' | IN GAME' end
        table.insert(PlayerOptions, Label)
        if SelectedUsername and string.lower(SelectedUsername) == string.lower(Player.Name) then
            UpdatedSelection = Label
        end
    end
    CONFIG.QuickTravelPlayer = UpdatedSelection or 'Select Player'
    State.Extras.LastTravelOptionsRefresh = os.clock()
end

function State.Extras.FindTravelTarget(Destination)
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    if not Root then return nil end
    Destination = tostring(Destination or '')

    if Destination == 'Nearest Queue' then
        local Candidate = FindBestQueuePad()
        return Candidate and Candidate.Center
    elseif Destination == 'Current Court' then
        return FindPlayerCourtSlot(LP)
    elseif Destination == 'Spawn' then
        return Workspace:FindFirstChildWhichIsA('SpawnLocation', true)
    elseif Destination == 'Daily Spin' then
        local WOF = safe_find(Workspace, 'WOF')
        local Area = WOF and safe_find(WOF, 'DailySpinArea')
        local Persistent = Area and safe_find(Area, 'Persistent')
        return Persistent and safe_find(Persistent, 'Center')
    elseif Destination == 'Donation Area' then
        local Area = safe_find(Workspace, 'DonateArea')
        local Persistent = Area and safe_find(Area, 'Persistent')
        return Persistent and safe_find(Persistent, 'Center')
    elseif Destination == 'City Center' then
        local Map = safe_find(Workspace, 'Map')
        local Base = Map and safe_find(Map, 'Base')
        return (Base and safe_find(Base, 'City')) or Base or Map
    elseif Destination == 'Practice Entrance' or Destination == 'Practice Exit' then
        local Teleporters = safe_find(Workspace, 'Teleporters')
        return Teleporters and safe_find(Teleporters,
            Destination == 'Practice Entrance' and 'Inside' or 'Outside')
    elseif Destination == 'Nearest Practice Court' then
        return FindNearestPracticeCourtFromPosition(Root.Position)
    elseif Destination == 'Practice Half Court' or Destination == 'Practice Full Court' then
        local Practice = safe_find(Workspace, 'PracticeArea')
        local Wanted = Destination == 'Practice Half Court' and 'Practice_Court' or 'Practice_FullCourt'
        return Practice and (safe_find(Practice, Wanted)
            or State.Extras.FindChildInsensitive(Practice, Wanted:gsub('_', ' ')))
    elseif Destination == 'Leaderboard Hub' or string.sub(Destination, 1, 13) == 'Leaderboard:' then
        local Map = safe_find(Workspace, 'Map')
        local Extra = Map and safe_find(Map, 'Extra')
        local Boards = Extra and safe_find(Extra, 'Leaderboards')
        if Destination == 'Leaderboard Hub' then return Boards end
        local Wanted = string.match(Destination, '^Leaderboard:%s*(.+)$')
        if Wanted == 'Highest Streak' then Wanted = 'HighestStreak' end
        return State.Extras.FindChildInsensitive(Boards, Wanted)
    end

    local QueueCourt, QueuePad = string.match(Destination, '^Queue%s*|%s*(.-)%s*|%s*(.+)$')
    if QueueCourt and QueuePad then
        local Court = State.Extras.GetCourtByTravelName(QueueCourt)
        local Pads = Court and (safe_find(Court, '_CourtPads') or safe_find(Court, 'CourtPads'))
        local Pad = State.Extras.FindChildInsensitive(Pads, QueuePad)
        return Pad and (safe_find(Pad, 'Center') or Pad)
    end
    if string.match(Destination, '^Court%s+[A-K]$') then
        return State.Extras.GetCourtByTravelName(Destination)
    end
    return nil
end

function State.Extras.TeleportCharacter(TargetCFrame, StatusLabel)
    local Character = LP.Character
    if not Character or typeof(TargetCFrame) ~= 'CFrame' then
        State.Extras.TravelStatus = 'TARGET UNAVAILABLE'
        return false
    end
    local Success = pcall(function()
        pcall(LP.RequestStreamAroundAsync, LP, TargetCFrame.Position)
        Character:PivotTo(TargetCFrame + Vector3.new(0, 4, 0))
        local Root = safe_find(Character, 'HumanoidRootPart')
        if Root then
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    State.Extras.TravelStatus = Success and ('TRAVELED | ' .. tostring(StatusLabel)) or 'TRAVEL FAILED'
    return Success
end

function State.Extras.QuickTravel(Destination)
    Destination = Destination or CONFIG.QuickTravelDestination
    local ServerName = string.match(tostring(Destination), '^Server:%s*(.+)$')
    if ServerName then
        local PlaceIds = {
            Park = 6229116934, Arena = 89892874044551, ['Arena Mobile'] = 120034035587945,
            ['Arena League'] = 103012657409979, ['Test Park'] = 117464274262425,
            ['Test Arena'] = 139182159811837, ['Troll Mode'] = 109988185694639,
        }
        local PlaceId = PlaceIds[ServerName]
        if not PlaceId then State.Extras.TravelStatus = 'SERVER UNAVAILABLE';
            return false end
        State.Extras.TravelStatus = 'JOINING | ' .. ServerName
        local Success = pcall(State.Utility.TeleportService.Teleport, State.Utility.TeleportService, PlaceId, LP)
        if not Success then State.Extras.TravelStatus = 'SERVER TRAVEL FAILED' end
        return Success
    end
    local TargetCFrame = nil
    if string.match(tostring(Destination), '^Court%s+[A-K]$') then
        TargetCFrame = State.Extras.GetCourtQueueArrival(
            State.Extras.GetCourtByTravelName(Destination)
        )
    else
        local Target = State.Extras.FindTravelTarget(Destination)
        if Destination == 'City Center' then
            TargetCFrame = State.Extras.GetSafeCityArrival(Target)
        else
            TargetCFrame = State.Extras.GetTravelObjectCFrame(Target)
        end
    end
    local ReturnRoot = LP.Character and safe_find(LP.Character, 'HumanoidRootPart')
    if ReturnRoot then State.Extras.LastTravelReturnCFrame = ReturnRoot.CFrame end
    return State.Extras.TeleportCharacter(TargetCFrame, Destination)
end

function State.Extras.FindTravelPlayer(Label)
    local Username = string.match(tostring(Label or ''), '^@([^|%s]+)')
    if not Username then return nil end
    for _, Player in ipairs(Players:GetPlayers()) do
        if string.lower(Player.Name) == string.lower(Username) then return Player end
    end
    return nil
end

function State.Extras.QuickTravelToPlayer(Label)
    Label = Label or CONFIG.QuickTravelPlayer
    local Player = State.Extras.FindTravelPlayer(Label)
    if Player and State.Extras.IsTravelPlayerInGame(Player) then
        State.Extras.TravelStatus = 'BLOCKED | PLAYER IN GAME'
        return false
    end
    local Character = Player and Player.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local HumanoidObject = Character and Character:FindFirstChildOfClass('Humanoid')
    if not (Player and Root and HumanoidObject and HumanoidObject.Health > 0) then
        State.Extras.TravelStatus = 'PLAYER UNAVAILABLE'
        return false
    end
    return State.Extras.TeleportCharacter(Root.CFrame * CFrame.new(0, 0, 4), '@' .. Player.Name)
end

local FindPlayerScoringGoal
FindPlayerScoringGoal = WYNF_JIT_MAX(function(TargetPlayer, RuntimeSnapshot)
    local Character = TargetPlayer and TargetPlayer.Character
    local TargetRoot = Character and safe_find(Character, 'HumanoidRootPart')
    if not TargetRoot then
        return nil
    end

    local CacheEnabled = RuntimeSnapshot == nil
    local Now = os.clock()
    if CacheEnabled then
        local Cached = PerfCache.PlayerScoringGoal[TargetPlayer]
        if Cached and Now - Cached.At < 0.15 then
            local Goal = Cached.Goal ~= false and Cached.Goal or nil
            if not Goal or Goal.Parent then return Goal end
        end
    end

    local function Finish(Goal)
        if CacheEnabled then
            PerfCache.PlayerScoringGoal[TargetPlayer] = {
                At = Now,
                Goal = Goal or false,
            }
        end
        return Goal
    end

    local Court, SlotName, Slot = ResolvePlayerCourt(TargetPlayer, RuntimeSnapshot)
    local TeamName = ResolvePlayerCourtTeam(TargetPlayer, Court, SlotName, Slot)
    local IsPractice = HasHeldPracticeBallState(TargetPlayer)

    if Court == nil and IsArenaMode then
        Court = safe_find(Workspace, 'Court')
    end

    if Court ~= nil and not IsPractice then
        local ScoringHitbox = IsArenaMode and (
            (TeamName == 'Home' and 'HitboxesHome') or
            (TeamName == 'Away' and 'HitboxesAway')
        ) or (
            (TeamName == 'Home' and 'HitboxesAway') or
            (TeamName == 'Away' and 'HitboxesHome')
        )

        if ScoringHitbox then
            local ScoringGoal = FindGoalPartInHitboxFolder(safe_find(Court, ScoringHitbox))
            if ScoringGoal then
                return Finish(ScoringGoal)
            end
        end

        local NeutralGoal = FindGoalPartInHitboxFolder(safe_find(Court, 'Hitboxes'))
        if NeutralGoal then
            return Finish(NeutralGoal)
        end

        local NearestCourtGoal = FindNearestGoalFromPosition(TargetRoot.Position, Court)
        if NearestCourtGoal then
            return Finish(NearestCourtGoal)
        end
    end

    if IsPractice then
        local PracticeCourt = FindNearestPracticeCourtFromPosition(TargetRoot.Position)
        if PracticeCourt then
            local PracticeGoal = FindNearestGoalFromPosition(TargetRoot.Position, PracticeCourt)
            if PracticeGoal then
                return Finish(PracticeGoal)
            end
        end
    end

    local FallbackGoal = FindNearestGoalFromPosition(TargetRoot.Position)
    return Finish(FallbackGoal)
end)

State.GoalLookup = State.GoalLookup or {}
State.GoalLookup.FindPlayerScoringGoal = FindPlayerScoringGoal
