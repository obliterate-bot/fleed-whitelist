function State.BallAssist.GetBasketballContainer(Object)
    local Current = Object
    while Current and Current ~= Workspace do
        if Current.Name == 'Basketball'
            and (Current:IsA('Model') or Current:IsA('Tool') or Current:IsA('Folder')) then
            return Current
        end
        Current = Current.Parent
    end
    return nil
end

function State.BallAssist.IsPracticeContainer(Container)
    if not Container then return false end
    local Current = Container
    while Current and Current ~= Workspace do
        local Success, IsPractice = pcall(function()
            return Current:GetAttribute('Practice')
        end)
        if Success and IsPractice == true then return true end
        Current = Current.Parent
    end

    local PracticeArea = safe_find(Workspace, 'PracticeArea')
    return PracticeArea ~= nil and Container:IsDescendantOf(PracticeArea)
end

function State.BallAssist.GetCanonicalBallPart(Container)
    if not Container then return nil end

    local Ball = Container:FindFirstChild('Ball', true)
    if Ball and Ball:IsA('BasePart') then return Ball end

    if Container:IsA('Model') and Container.PrimaryPart then
        return Container.PrimaryPart
    end

    for _, Object in ipairs(Container:GetDescendants()) do
        if Object:IsA('BasePart') then
            local Name = string.lower(Object.Name)
            if Name == 'handle' or Name == 'basketball'
                or string.find(Name, 'ball', 1, true) ~= nil then
                return Object
            end
        end
    end
    return nil
end

function State.BallAssist.RegisterCandidate(Object)
    if not (Object and Object:IsA('BasePart')) then return end

    if CollectionService:HasTag(Object, 'BallHandle') then
        State.BallAssist.Candidates[Object] = true
        return
    end

    local Container = State.BallAssist.GetBasketballContainer(Object)
    if not Container then return end

    local Canonical = State.BallAssist.GetCanonicalBallPart(Container)
    if Canonical == Object then
        State.BallAssist.Candidates[Object] = true
        return
    end

    if State.BallAssist.IsPracticeContainer(Container) then
        local Name = string.lower(Object.Name)
        if Name == 'ball' or Name == 'handle' or Name == 'basketball'
            or string.find(Name, 'ball', 1, true) ~= nil then
            State.BallAssist.Candidates[Object] = true
        end
    end
end

function State.BallAssist.RegisterBasketballContainer(Container)
    if not Container then return end
    local Canonical = State.BallAssist.GetCanonicalBallPart(Container)
    if Canonical then State.BallAssist.RegisterCandidate(Canonical) end

    if State.BallAssist.IsPracticeContainer(Container) then
        for _, Object in ipairs(Container:GetDescendants()) do
            if Object:IsA('BasePart') then
                State.BallAssist.RegisterCandidate(Object)
            end
        end
    end
end

function State.BallAssist.DiscoverExistingCandidates()
    for _, Ball in ipairs(CollectionService:GetTagged('BallHandle')) do State.BallAssist.RegisterCandidate(Ball) end
    local Context = State.CourtContext and State.CourtContext.Get and State.CourtContext.Get()
    if Context and Context.CurrentBall then State.BallAssist.RegisterCandidate(Context.CurrentBall) end
    for _, Player in ipairs(Players:GetPlayers()) do
        local Basketball = Player.Character and Player.Character:FindFirstChild('Basketball')
        if Basketball then State.BallAssist.RegisterBasketballContainer(Basketball) end
    end
    local PracticeArea = safe_find(Workspace, 'PracticeArea')
    if PracticeArea then for _, Object in ipairs(PracticeArea:GetDescendants()) do
            if Object.Name == 'Basketball' and (Object:IsA('Model') or Object:IsA('Tool') or Object:IsA('Folder')) then State.BallAssist.RegisterBasketballContainer(Object) end
        end end
end

function State.BallAssist.CanDirectMove(Ball)
    if not (Ball and Ball:IsA('BasePart')) then return false end
    if State.BallAssist.IsPracticeBall(Ball) then return true end
    local Ok, Age = pcall(function() return Ball.ReceiveAge end)
    return Ok and Age == 0
end

