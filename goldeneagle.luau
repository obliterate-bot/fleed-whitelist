function State.Extras.SaveAvatarAppearance()
    if State.Extras.AvatarOriginalAppearance then return true end
    local Character = LP.Character
    if not Character then return false end
    local Saved = { Clothing = {}, Accessories = {}, CharacterMeshes = {}, PartVisuals = {}, Face = nil, HeadMeshes = {}, HeadTransparency = 0 }
    for _, Child in ipairs(Character:GetChildren()) do
        if Child:IsA('Shirt') or Child:IsA('Pants') or Child:IsA('ShirtGraphic') or Child:IsA('BodyColors') then
            table.insert(Saved.Clothing, Child:Clone())
        elseif Child:IsA('Accessory') then
            table.insert(Saved.Accessories, Child:Clone())
        elseif Child:IsA('CharacterMesh') then
            table.insert(Saved.CharacterMeshes, Child:Clone())
        end
    end
    local Head = safe_find(Character, 'Head')
    local Face = Head and ((safe_find(Head, 'face') or safe_find(Head, 'Face')) or Head:FindFirstChildOfClass('Decal'))
    if Face then Saved.Face = Face:Clone() end
    if Head then
        Saved.HeadTransparency = Head.Transparency
        for _, Child in ipairs(Head:GetChildren()) do
            if Child:IsA('SpecialMesh') then table.insert(Saved.HeadMeshes, Child:Clone()) end
        end
    end
    for _, Part in ipairs(Character:GetChildren()) do
        if Part:IsA('BasePart') and Part.Name ~= 'HumanoidRootPart' then
            local Visual = {
                Transparency = Part.Transparency,
                Reflectance = Part.Reflectance,
                Color = Part.Color,
                Material = Part.Material,
                Meshes = {},
                VisualChildren = {},
            }
            if Part:IsA('MeshPart') then
                Visual.MeshId = Part.MeshId
                Visual.TextureID = Part.TextureID
            end
            for _, Child in ipairs(Part:GetChildren()) do
                if Child:IsA('SpecialMesh') then table.insert(Visual.Meshes, Child:Clone()) end
                if State.Extras.IsAvatarVisualChild(Child) and not Child:IsA('SpecialMesh') then
                    local CloneOk, Clone = pcall(function() return Child:Clone() end)
                    if CloneOk and Clone then table.insert(Visual.VisualChildren, Clone) end
                end
            end
            Saved.PartVisuals[Part.Name] = Visual
        end
    end
    State.Extras.AvatarOriginalAppearance = Saved
    State.Extras.AvatarOriginalDisplayName = Character:FindFirstChildOfClass('Humanoid')
        and Character:FindFirstChildOfClass('Humanoid').DisplayName or LP.DisplayName
    State.Extras.AvatarPreviousAliasEnabled = State.LocalAnonymizerEnabled
    State.Extras.AvatarPreviousAlias = State.LocalAlias
    return true
end

function State.Extras.AttachPreviewAccessory(SourceAccessory, Character)
    if State.GhostReplay and State.GhostReplay.AttachAccessoryExact then
        return State.GhostReplay.AttachAccessoryExact(SourceAccessory, Character)
    end
    local Clone = SourceAccessory:Clone()
    Clone.Parent = Character
    local Handle = safe_find(Clone, 'Handle')
    if not Handle then return Clone end
    local Weld = Handle:FindFirstChildOfClass('Weld') or safe_find(Handle, 'AccessoryWeld')
    if not Weld then return Clone end
    local TargetPart = Weld.Part1 and safe_find(Character, Weld.Part1.Name)
    if TargetPart then Weld.Part1 = TargetPart end
    return Clone
end

function State.Extras.ClearAvatarAppearance(Character)
    if not Character then return end
    for _, Child in ipairs(Character:GetChildren()) do
        if Child:IsA('Shirt') or Child:IsA('Pants') or Child:IsA('ShirtGraphic')
            or Child:IsA('BodyColors') or Child:IsA('Accessory') or Child:IsA('CharacterMesh') then
            Child:Destroy()
        end
    end
end

function State.Extras.SetPreviewFace(Character, SourceCharacter)
    local CharacterHead = Character and safe_find(Character, 'Head')
    local SourceHead = SourceCharacter and safe_find(SourceCharacter, 'Head')
    if not CharacterHead then return end
    local CurrentFace = (safe_find(CharacterHead, 'face') or safe_find(CharacterHead, 'Face'))
        or CharacterHead:FindFirstChildOfClass('Decal')
    if CurrentFace then CurrentFace:Destroy() end
    local SourceFace = SourceHead and ((safe_find(SourceHead, 'face') or safe_find(SourceHead, 'Face'))
        or SourceHead:FindFirstChildOfClass('Decal'))
    if SourceFace then SourceFace:Clone().Parent = CharacterHead end
end

function State.Extras.SetPreviewBodyParts(Character, SourceCharacter)
    if not (Character and SourceCharacter) then return false end
    local Complete = true
    for _, SourcePart in ipairs(SourceCharacter:GetChildren()) do
        if SourcePart:IsA('BasePart') and SourcePart.Name ~= 'HumanoidRootPart' then
            local TargetPart = safe_find(Character, SourcePart.Name)
            if TargetPart and TargetPart:IsA('BasePart') then
                TargetPart.Transparency = SourcePart.Transparency
                TargetPart.Reflectance = SourcePart.Reflectance
                TargetPart.Color = SourcePart.Color
                TargetPart.Material = SourcePart.Material
                if TargetPart:IsA('MeshPart') and SourcePart:IsA('MeshPart') then
                    local MeshOk = pcall(function() TargetPart.MeshId = SourcePart.MeshId end)
                    local TextureOk = pcall(function() TargetPart.TextureID = SourcePart.TextureID end)
                    if not (MeshOk and TextureOk) then Complete = false end
                end
                for _, Child in ipairs(TargetPart:GetChildren()) do
                    if State.Extras.IsAvatarVisualChild(Child) then Child:Destroy() end
                end
                for _, Child in ipairs(SourcePart:GetChildren()) do
                    if State.Extras.IsAvatarVisualChild(Child) then
                        local CloneOk, Clone = pcall(function() return Child:Clone() end)
                        if CloneOk and Clone then
                            Clone.Parent = TargetPart
                        else
                            Complete = false
                        end
                    end
                end
            end
        end
    end
    return Complete
end

function State.Extras.SetPreviewName(UserName, UserId)
    safe_set_attribute(LP, 'DisguiseName', UserName)
    safe_set_attribute(LP, 'DisguiseId', UserId)
    local Character = LP.Character
    local HumanoidObject = Character and Character:FindFirstChildOfClass('Humanoid')
    if HumanoidObject then pcall(function() HumanoidObject.DisplayName = UserName end) end
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local NameTag = Root and safe_find(Root, 'NameTag')
    if NameTag then
        local MainFrame = safe_find(NameTag, 'MainFrame')
        local GameFrame = safe_find(NameTag, 'GameFrame')
        local MainLabel = MainFrame and safe_find(MainFrame, 'NameLabel')
        local GameLabel = GameFrame and safe_find(GameFrame, 'NameLabel')
        if MainLabel then MainLabel.Text = UserName end
        if GameLabel then GameLabel.Text = UserName end
    end
    pcall(function() SetLocalAnonymizer(true, tostring(UserName), false) end)
end

function State.Extras.RestoreAvatarPreview()
    local Character = LP.Character
    local Saved = State.Extras.AvatarOriginalAppearance
    if Character and Saved then
        State.Extras.ClearAvatarAppearance(Character)
        for _, Child in ipairs(Saved.Clothing) do Child:Clone().Parent = Character end
        for _, Accessory in ipairs(Saved.Accessories) do
            State.Extras.AttachPreviewAccessory(Accessory, Character)
        end
        for _, CharacterMesh in ipairs(Saved.CharacterMeshes or {}) do CharacterMesh:Clone().Parent = Character end
        for PartName, Visual in pairs(Saved.PartVisuals or {}) do
            local Part = safe_find(Character, PartName)
            if Part and Part:IsA('BasePart') then
                Part.Transparency = Visual.Transparency or 0
                Part.Reflectance = Visual.Reflectance or 0
                if Visual.Color then Part.Color = Visual.Color end
                if Visual.Material then Part.Material = Visual.Material end
                if Part:IsA('MeshPart') then
                    if Visual.MeshId then pcall(function() Part.MeshId = Visual.MeshId end) end
                    if Visual.TextureID then pcall(function() Part.TextureID = Visual.TextureID end) end
                end
                for _, Child in ipairs(Part:GetChildren()) do
                    if Child:IsA('SpecialMesh') then Child:Destroy() end
                end
                for _, Child in ipairs(Part:GetChildren()) do
                    if State.Extras.IsAvatarVisualChild(Child) and not Child:IsA('SpecialMesh') then Child:Destroy() end
                end
                for _, Mesh in ipairs(Visual.Meshes or {}) do Mesh:Clone().Parent = Part end
                for _, VisualChild in ipairs(Visual.VisualChildren or {}) do VisualChild:Clone().Parent = Part end
            end
        end
        local Head = safe_find(Character, 'Head')
        if Head then
            local CurrentFace = (safe_find(Head, 'face') or safe_find(Head, 'Face')) or Head:FindFirstChildOfClass('Decal')
            if CurrentFace then CurrentFace:Destroy() end
            for _, Child in ipairs(Head:GetChildren()) do
                if Child:IsA('SpecialMesh') then Child:Destroy() end
            end
            for _, HeadMesh in ipairs(Saved.HeadMeshes or {}) do HeadMesh:Clone().Parent = Head end
            Head.Transparency = Saved.HeadTransparency or 0
            if Saved.Face then Saved.Face:Clone().Parent = Head end
        end
        local HumanoidObject = Character:FindFirstChildOfClass('Humanoid')
        if HumanoidObject then pcall(function()
                HumanoidObject.DisplayName = State.Extras.AvatarOriginalDisplayName or LP.DisplayName
            end) end
    end
    safe_set_attribute(LP, 'DisguiseName', nil)
    safe_set_attribute(LP, 'DisguiseId', nil)
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local NameTag = Root and safe_find(Root, 'NameTag')
    if NameTag then
        local MainFrame = safe_find(NameTag, 'MainFrame')
        local GameFrame = safe_find(NameTag, 'GameFrame')
        local MainLabel = MainFrame and safe_find(MainFrame, 'NameLabel')
        local GameLabel = GameFrame and safe_find(GameFrame, 'NameLabel')
        if MainLabel then MainLabel.Text = LP.Name end
        if GameLabel then GameLabel.Text = LP.Name end
    end
    if State.Extras.AvatarPreviousAliasEnabled ~= nil then pcall(function()
            SetLocalAnonymizer(State.Extras.AvatarPreviousAliasEnabled, State.Extras.AvatarPreviousAlias or State.LocalAlias, false)
        end) end
    State.Extras.AvatarPreviewEnabled = false
    State.Extras.AvatarPreviewUserId = nil
    State.Extras.AvatarPreviewName = nil
    State.Extras.AvatarPreviewStatus = 'RESTORED'
    State.Extras.AvatarOriginalAppearance = nil
    State.Extras.AvatarOriginalDisplayName = nil
    State.Extras.AvatarPreviousAliasEnabled = nil
    State.Extras.AvatarPreviousAlias = nil
end

function State.Extras.ApplyAvatarPreview(NameOrUserId)
    local Input = string.match(tostring(NameOrUserId or ''), '^%s*(.-)%s*$')
    if Input == '' then State.Extras.AvatarPreviewStatus = 'ENTER NAME OR USER ID';
        return false end
    local UserId = tonumber(Input)
    if UserId then
        UserId = math.floor(UserId)
    else
        local Found, Result = pcall(Players.GetUserIdFromNameAsync, Players, Input)
        if not Found then State.Extras.AvatarPreviewStatus = 'USERNAME NOT FOUND';
            return false end
        UserId = Result
    end
    if not UserId or UserId <= 0 then State.Extras.AvatarPreviewStatus = 'INVALID USER';
        return false end
    local Character = LP.Character
    if not Character then State.Extras.AvatarPreviewStatus = 'CHARACTER UNAVAILABLE';
        return false end
    State.Extras.AvatarPreviewStatus = 'LOADING'
    local Ok, Description, UserName = pcall(function()
        return Players:GetHumanoidDescriptionFromUserId(UserId), Players:GetNameFromUserIdAsync(UserId)
    end)
    if not Ok or not Description then State.Extras.AvatarPreviewStatus = 'USER LOAD FAILED';
        return false end
    if not State.Extras.AvatarPreviewEnabled and not State.Extras.SaveAvatarAppearance() then
        State.Extras.AvatarPreviewStatus = 'SAVE FAILED';
        return false
    end
    local HumanoidObject = Character:FindFirstChildOfClass('Humanoid')
    local RigType = HumanoidObject and HumanoidObject.RigType or Enum.HumanoidRigType.R6
    local Built, Temporary = pcall(function()
        return Players:CreateHumanoidModelFromDescription(Description, RigType)
    end)
    if not Built or not Temporary then State.Extras.AvatarPreviewStatus = 'MODEL BUILD FAILED';
        return false end
    Temporary.Name = 'GoldenEagleLocalDisguise'
    Temporary.Parent = ReplicatedStorage
    local PackageComplete = true
    local Applied, ApplyError = pcall(function()
        local Staged = {}
        for _, Child in ipairs(Temporary:GetChildren()) do
            if Child:IsA('Shirt') or Child:IsA('Pants') or Child:IsA('ShirtGraphic') or Child:IsA('BodyColors')
                or Child:IsA('CharacterMesh') or Child:IsA('Accessory') then
                table.insert(Staged, Child:Clone())
            end
        end
        State.Extras.ClearAvatarAppearance(Character)
        for _, Child in ipairs(Staged) do
            if Child:IsA('Accessory') then
                State.Extras.AttachPreviewAccessory(Child, Character)
                Child:Destroy()
            else
                Child.Parent = Character
            end
        end
        PackageComplete = State.Extras.SetPreviewBodyParts(Character, Temporary)
        State.Extras.SetPreviewFace(Character, Temporary)
    end)
    Temporary:Destroy()
    if not Applied then
        State.Extras.RestoreAvatarPreview()
        State.Extras.AvatarPreviewStatus = 'APPLY FAILED | RESTORED'
        State.Extras.AvatarPreviewLastError = tostring(ApplyError)
        return false
    end
    State.Extras.AvatarPreviewEnabled = true
    State.Extras.AvatarPreviewUserId = UserId
    State.Extras.AvatarPreviewName = UserName
    State.Extras.AvatarPreviewStatus = PackageComplete
        and ('PREVIEW | ' .. tostring(UserName))
        or ('PARTIAL PACKAGE | ' .. tostring(UserName))
    State.Extras.SetPreviewName(tostring(UserName), UserId)
    return true
end

State.GhostReplay = {
    Recording = false,
    Playing = false,
    Status = 'READY',
    Frames = {},
    SourceParts = {},
    SourcePaths = {},
    SourceCharacter = nil,
    Template = nil,
    BallTemplate = nil,
    Ghost = nil,
    GhostBall = nil,
    GhostParts = {},
    SourceAccessoryCount = 0,
    GhostAccessoryCount = 0,
    RecordTime = 0,
    RecordAccumulator = 0,
    PlaybackTime = 0,
    PlaybackIndex = 1,
    Loop = CONFIG.GhostLoop,
}

function State.GhostReplay.CloneCompleteInstance(Source)
    if not Source then return nil end
    local Objects = { Source }
    for _, Object in ipairs(Source:GetDescendants()) do table.insert(Objects, Object) end
    local Saved = table.create(#Objects)
    for Index, Object in ipairs(Objects) do
        Saved[Index] = Object.Archivable
        pcall(function() Object.Archivable = true end)
    end
    local CloneOk, Clone = pcall(function() return Source:Clone() end)
    for Index, Object in ipairs(Objects) do
        pcall(function() Object.Archivable = Saved[Index] end)
    end
    return CloneOk and Clone or nil
end

function State.GhostReplay.AttachAccessoryExact(SourceAccessory, Character)
    if not (SourceAccessory and Character) then return nil end
    local Clone = State.GhostReplay.CloneCompleteInstance(SourceAccessory)
    if not Clone then return nil end
    local HumanoidObject = Character:FindFirstChildOfClass('Humanoid')
    Clone.Parent = nil
    if HumanoidObject and Clone:IsA('Accessory') then
        local Added = pcall(HumanoidObject.AddAccessory, HumanoidObject, Clone)
        if not Added or Clone.Parent ~= Character then Clone.Parent = Character end
    else
        Clone.Parent = Character
    end
    local Handle = Clone:FindFirstChild('Handle')
    local SourceHandle = SourceAccessory:FindFirstChild('Handle')
    if not (Handle and Handle:IsA('BasePart')) then return Clone end
    local Existing = Handle:FindFirstChild('AccessoryWeld') or Handle:FindFirstChildOfClass('Weld')
    local MatchedAttachment
    local TargetAttachment
    for _, Attachment in ipairs(Handle:GetChildren()) do
        if Attachment:IsA('Attachment') then
            local Candidate = Character:FindFirstChild(Attachment.Name, true)
            if Candidate and Candidate:IsA('Attachment') and not Candidate:IsDescendantOf(Clone)
                and Candidate:FindFirstAncestorOfClass('Accessory') == nil
                and Candidate.Parent and Candidate.Parent:IsA('BasePart') then
                MatchedAttachment = Attachment
                TargetAttachment = Candidate
                break
            end
        end
    end
    if MatchedAttachment and TargetAttachment then
        if Existing then Existing:Destroy() end
        local Weld = Instance.new('Weld')
        Weld.Name = 'AccessoryWeld'
        Weld.Part0 = Handle
        Weld.Part1 = TargetAttachment.Parent
        Weld.C0 = MatchedAttachment.CFrame
        Weld.C1 = TargetAttachment.CFrame
        Weld.Parent = Handle
        return Clone
    end
    local SourceWeld = SourceHandle and (SourceHandle:FindFirstChild('AccessoryWeld') or SourceHandle:FindFirstChildOfClass('Weld'))
    local TargetPart = SourceWeld and SourceWeld.Part1 and Character:FindFirstChild(SourceWeld.Part1.Name, true)
    if SourceWeld and TargetPart and TargetPart:IsA('BasePart') then
        if Existing then Existing:Destroy() end
        local Weld = Instance.new('Weld')
        Weld.Name = 'AccessoryWeld'
        Weld.Part0 = Handle
        Weld.Part1 = TargetPart
        Weld.C0 = SourceWeld.C0
        Weld.C1 = SourceWeld.C1
        Weld.Parent = Handle
        return Clone
    end
    return Clone
end

function State.GhostReplay.GetPartPath(Part, Root)
    local Segments = {}
    local Current = Part
    while Current and Current ~= Root do
        local Index = 1
        local Parent = Current.Parent
        if Parent then
            for _, Sibling in ipairs(Parent:GetChildren()) do
                if Sibling == Current then break end
                if Sibling.Name == Current.Name and Sibling.ClassName == Current.ClassName then Index += 1 end
            end
        end
        table.insert(Segments, 1, Current.Name .. '|' .. Current.ClassName .. '|' .. tostring(Index))
        Current = Parent
    end
    return table.concat(Segments, '/')
end

function State.GhostReplay.DestroyGhost()
    if State.GhostReplay.Ghost then pcall(function() State.GhostReplay.Ghost:Destroy() end) end
    if State.GhostReplay.GhostBall then pcall(function() State.GhostReplay.GhostBall:Destroy() end) end
    State.GhostReplay.Ghost = nil
    State.GhostReplay.GhostBall = nil
    table.clear(State.GhostReplay.GhostParts)
    State.GhostReplay.Playing = false
    State.GhostReplay.PlaybackTime = 0
    State.GhostReplay.PlaybackIndex = 1
end

function State.GhostReplay.ClearRecording()
    State.GhostReplay.Recording = false
    State.GhostReplay.DestroyGhost()
    table.clear(State.GhostReplay.Frames)
    table.clear(State.GhostReplay.SourceParts)
    table.clear(State.GhostReplay.SourcePaths)
    if State.GhostReplay.Template then pcall(function() State.GhostReplay.Template:Destroy() end) end
    if State.GhostReplay.BallTemplate then pcall(function() State.GhostReplay.BallTemplate:Destroy() end) end
    State.GhostReplay.Template = nil
    State.GhostReplay.BallTemplate = nil
    State.GhostReplay.SourceCharacter = nil
    State.GhostReplay.SourceAccessoryCount = 0
    State.GhostReplay.GhostAccessoryCount = 0
    State.GhostReplay.RecordTime = 0
    State.GhostReplay.RecordAccumulator = 0
    State.GhostReplay.Status = 'CLEARED'
end

function State.GhostReplay.CaptureFrame()
    if not State.GhostReplay.Recording then return false end
    local Character = State.GhostReplay.SourceCharacter
    if not (Character and Character.Parent and Character == LP.Character) then
        State.GhostReplay.Recording = false
        State.GhostReplay.Status = 'CHARACTER CHANGED'
        return false
    end
    local Poses = table.create(#State.GhostReplay.SourceParts)
    for Index, Part in ipairs(State.GhostReplay.SourceParts) do
        Poses[Index] = Part and Part.Parent and Part.CFrame or false
    end
    local Ball = GetLocalBallHandle()
    if Ball and not State.GhostReplay.BallTemplate then
        local PreviousArchivable = Ball.Archivable
        Ball.Archivable = true
        local BallOk, BallClone = pcall(function() return Ball:Clone() end)
        Ball.Archivable = PreviousArchivable
        if BallOk and BallClone then
            BallClone.Name = 'GoldenEagleGhostBallTemplate'
            BallClone.Parent = nil
            State.GhostReplay.BallTemplate = BallClone
        end
    end
    table.insert(State.GhostReplay.Frames, {
        T = State.GhostReplay.RecordTime,
        Poses = Poses,
        Ball = Ball and Ball.Parent and Ball.CFrame or false,
    })
    return true
end

function State.GhostReplay.StartRecording()
    State.GhostReplay.ClearRecording()
    local Character = LP.Character
    if not Character then State.GhostReplay.Status = 'CHARACTER UNAVAILABLE';
        return false end
    local HumanoidObject = Character:FindFirstChildOfClass('Humanoid')
    if not (HumanoidObject and HumanoidObject.Health > 0) then State.GhostReplay.Status = 'CHARACTER NOT READY';
        return false end
    local Template = State.GhostReplay.CloneCompleteInstance(Character)
    if not Template then State.GhostReplay.Status = 'GHOST SNAPSHOT FAILED';
        return false end
    Template.Name = 'GoldenEagleGhostTemplate'
    Template.Parent = nil
    State.GhostReplay.Template = Template
    State.GhostReplay.SourceCharacter = Character
    State.GhostReplay.SourceAccessoryCount = 0
    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:IsA('Accessory') then State.GhostReplay.SourceAccessoryCount += 1 end
    end
    local Entries = {}
    for _, Object in ipairs(Character:GetChildren()) do
        if Object:IsA('BasePart') then
            table.insert(Entries, { Part = Object, Path = State.GhostReplay.GetPartPath(Object, Character) })
        end
    end
    table.sort(Entries, function(A, B) return A.Path < B.Path end)
    for _, Entry in ipairs(Entries) do
        table.insert(State.GhostReplay.SourceParts, Entry.Part)
        table.insert(State.GhostReplay.SourcePaths, Entry.Path)
    end
    if #State.GhostReplay.SourceParts == 0 then
        State.GhostReplay.ClearRecording()
        State.GhostReplay.Status = 'NO CHARACTER PARTS'
        return false
    end
    State.GhostReplay.Recording = true
    State.GhostReplay.Status = 'RECORDING'
    State.GhostReplay.CaptureFrame()
    return true
end

function State.GhostReplay.StopRecording(Reason)
    if not State.GhostReplay.Recording then return false end
    State.GhostReplay.CaptureFrame()
    State.GhostReplay.Recording = false
    State.GhostReplay.Status = Reason or (#State.GhostReplay.Frames > 1 and 'RECORDED' or 'NO MOVEMENT CAPTURED')
    if #State.GhostReplay.Frames > 1 then
        State.GhostReplay.Saved = State.GhostReplay.Saved or {}
        table.insert(State.GhostReplay.Saved, 1, {
            Label = os.date('%H:%M:%S') .. '  (' .. tostring(#State.GhostReplay.Frames) .. ' frames)',
            Frames = table.clone(State.GhostReplay.Frames),
        })
        while #State.GhostReplay.Saved > 5 do table.remove(State.GhostReplay.Saved) end
        if HubUI and HubUI.RefreshGhostRecordings then pcall(HubUI.RefreshGhostRecordings) end
    end
    return #State.GhostReplay.Frames > 1
end

function State.GhostReplay.CreateGhost()
    State.GhostReplay.DestroyGhost()
    if #State.GhostReplay.Frames <= 1 then
        State.GhostReplay.Status = 'RECORD A GHOST FIRST'
        return false
    end
    local Source = LP.Character or State.GhostReplay.Template
    if not Source then State.GhostReplay.Status = 'AVATAR SOURCE LOST';
        return false end
    local Ghost = State.GhostReplay.CloneCompleteInstance(Source)
    if not Ghost then Ghost = State.GhostReplay.CloneCompleteInstance(State.GhostReplay.Template) end
    if not Ghost then State.GhostReplay.Status = 'GHOST BUILD FAILED';
        return false end
    Ghost.Name = 'GoldenEagleReplayGhost'
    local ExistingAccessories = {}
    for _, Object in ipairs(Ghost:GetDescendants()) do
        if Object:IsA('Accessory') then table.insert(ExistingAccessories, Object) end
    end
    for _, Accessory in ipairs(ExistingAccessories) do Accessory:Destroy() end
    Ghost.Parent = HiddenWorld()
    State.GhostReplay.SourceAccessoryCount = 0
    State.GhostReplay.GhostAccessoryCount = 0
    for _, Accessory in ipairs(Source:GetChildren()) do
        if Accessory:IsA('Accessory') then
            State.GhostReplay.SourceAccessoryCount += 1
            if State.Extras.AttachPreviewAccessory(Accessory, Ghost) then
                State.GhostReplay.GhostAccessoryCount += 1
            end
        end
    end
    local Map = {}
    local DrivePaths = {}
    for _, Path in ipairs(State.GhostReplay.SourcePaths) do DrivePaths[Path] = true end
    for _, Object in ipairs(Ghost:GetDescendants()) do
        if Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
            or Object:IsA('Sound') or Object:IsA('BillboardGui') or Object:IsA('ProximityPrompt') then
            Object:Destroy()
        elseif Object:IsA('Humanoid') then
            Object.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            Object.NameDisplayDistance = 0
            Object.HealthDisplayDistance = 0
            Object.AutoRotate = false
            Object.PlatformStand = true
            Object.BreakJointsOnDeath = false
        elseif Object:IsA('BasePart') then
            local Path = State.GhostReplay.GetPartPath(Object, Ghost)
            Object.Anchored = DrivePaths[Path] == true
            Object.CanCollide = false
            Object.CanTouch = false
            Object.CanQuery = false
            Object.Massless = true
            Object.CastShadow = false
            Object.LocalTransparencyModifier = math.clamp(tonumber(CONFIG.GhostTransparency) or 0.35, 0.05, 0.9)
            Map[Path] = Object
        end
    end
    for Index, Path in ipairs(State.GhostReplay.SourcePaths) do
        State.GhostReplay.GhostParts[Index] = Map[Path] or false
    end
    local Highlight = Instance.new('Highlight')
    Highlight.Name = 'GoldenEagleGhostHighlight'
    Highlight.Adornee = Ghost
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.FillColor = Color3.fromRGB(255, 196, 64)
    Highlight.FillTransparency = 0.96
    Highlight.OutlineColor = Color3.fromRGB(255, 220, 120)
    Highlight.OutlineTransparency = 0.48
    Highlight.Parent = HiddenGui()
    local GhostParent = HiddenWorld()
    if Ghost.Parent ~= GhostParent then Ghost.Parent = GhostParent end
    State.GhostReplay.Ghost = Ghost
    if State.GhostReplay.GhostAccessoryCount < State.GhostReplay.SourceAccessoryCount then
        State.GhostReplay.Status = 'ACCESSORIES PARTIAL'
    end
    if State.GhostReplay.BallTemplate then
        local BallOk, GhostBall = pcall(function() return State.GhostReplay.BallTemplate:Clone() end)
        if BallOk and GhostBall and GhostBall:IsA('BasePart') then
            GhostBall.Name = 'GoldenEagleReplayGhostBall'
            GhostBall.Anchored = true
            GhostBall.CanCollide = false
            GhostBall.CanTouch = false
            GhostBall.CanQuery = false
            GhostBall.CastShadow = false
            GhostBall.LocalTransparencyModifier = math.clamp(tonumber(CONFIG.GhostTransparency) or 0.35, 0.05, 0.9)
            for _, Object in ipairs(GhostBall:GetDescendants()) do
                if Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
                    or Object:IsA('Sound') or Object:IsA('Weld') or Object:IsA('WeldConstraint')
                    or Object:IsA('Motor6D') then
                    Object:Destroy()
                elseif Object:IsA('BasePart') then
                    Object.Anchored = true
                    Object.CanCollide = false
                    Object.CanTouch = false
                    Object.CanQuery = false
                    Object.LocalTransparencyModifier = CONFIG.GhostTransparency
                end
            end
            local BallHighlight = Instance.new('Highlight')
            BallHighlight.FillColor = Color3.fromRGB(255, 196, 64)
            BallHighlight.FillTransparency = 0.92
            BallHighlight.OutlineColor = Color3.fromRGB(255, 230, 150)
            BallHighlight.OutlineTransparency = 0.30
            BallHighlight.Adornee = GhostBall
            BallHighlight.Parent = HiddenGui()
            GhostBall.Parent = HiddenWorld()
            State.GhostReplay.GhostBall = GhostBall
        elseif GhostBall then
            GhostBall:Destroy()
        end
    end
    return true
end

function State.GhostReplay.Play()
    if State.GhostReplay.Recording then State.GhostReplay.StopRecording() end
    if not State.GhostReplay.CreateGhost() then return false end
    State.GhostReplay.PlaybackTime = 0
    State.GhostReplay.PlaybackIndex = 1
    State.GhostReplay.Playing = true
    State.GhostReplay.Status = State.GhostReplay.GhostAccessoryCount < State.GhostReplay.SourceAccessoryCount
        and 'PLAYING | ACCESSORY ATTACH PARTIAL' or 'PLAYING'
    return true
end

function State.GhostReplay.StopPlayback(Reason)
    local HadGhost = State.GhostReplay.Playing or State.GhostReplay.Ghost ~= nil
    State.GhostReplay.DestroyGhost()
    if HadGhost then State.GhostReplay.Status = Reason or 'PLAYBACK STOPPED' end
end

function State.GhostReplay.SetLoop(Value)
    State.GhostReplay.Loop = Value == true
    CONFIG.GhostLoop = State.GhostReplay.Loop
end

function State.GhostReplay.SetMaxDuration(Value)
    CONFIG.GhostMaxDuration = math.clamp(math.floor((tonumber(Value) or 30) + 0.5), 5, 120)
end

function State.GhostReplay.SetSampleRate(Value)
    CONFIG.GhostSampleRate = math.clamp(math.floor((tonumber(Value) or 30) + 0.5), 10, 60)
end

function State.GhostReplay.SetPlaybackSpeed(Value)
    CONFIG.GhostPlaybackSpeed = math.clamp(tonumber(Value) or 1, 0.25, 3)
end

function State.GhostReplay.SetTransparency(Value)
    CONFIG.GhostTransparency = math.clamp(tonumber(Value) or 0.35, 0.05, 0.9)
    if State.GhostReplay.Ghost then
        for _, Object in ipairs(State.GhostReplay.Ghost:GetDescendants()) do
            if Object:IsA('BasePart') then Object.LocalTransparencyModifier = CONFIG.GhostTransparency end
        end
    end
    if State.GhostReplay.GhostBall then
        if State.GhostReplay.GhostBall:IsA('BasePart') then
            State.GhostReplay.GhostBall.LocalTransparencyModifier = CONFIG.GhostTransparency
        end
        for _, Object in ipairs(State.GhostReplay.GhostBall:GetDescendants()) do
            if Object:IsA('BasePart') then Object.LocalTransparencyModifier = CONFIG.GhostTransparency end
        end
    end
end

function State.GhostReplay.StepRecording(DeltaTime)
    if not State.GhostReplay.Recording then return end
    State.GhostReplay.RecordTime += DeltaTime
    State.GhostReplay.RecordAccumulator += DeltaTime
    if State.GhostReplay.RecordTime >= CONFIG.GhostMaxDuration then
        State.GhostReplay.StopRecording('MAX LENGTH REACHED')
        return
    end
    local Interval = 1 / math.clamp(tonumber(CONFIG.GhostSampleRate) or 30, 10, 60)
    while State.GhostReplay.RecordAccumulator >= Interval do
        State.GhostReplay.RecordAccumulator -= Interval
        State.GhostReplay.CaptureFrame()
    end
end

function State.GhostReplay.StepPlayback(DeltaTime)
    if not State.GhostReplay.Playing then return end
    local Frames = State.GhostReplay.Frames
    local LastFrame = Frames[#Frames]
    if not (State.GhostReplay.Ghost and LastFrame) then State.GhostReplay.StopPlayback('PLAYBACK LOST');
        return end
    State.GhostReplay.PlaybackTime += DeltaTime * math.clamp(tonumber(CONFIG.GhostPlaybackSpeed) or 1, 0.25, 3)
    if State.GhostReplay.PlaybackTime >= LastFrame.T then
        if State.GhostReplay.Loop then
            State.GhostReplay.PlaybackTime = State.GhostReplay.PlaybackTime % math.max(LastFrame.T, 0.001)
            State.GhostReplay.PlaybackIndex = 1
        else
            State.GhostReplay.StopPlayback('PLAYBACK COMPLETE')
            return
        end
    end
    local Index = math.clamp(State.GhostReplay.PlaybackIndex, 1, math.max(1, #Frames - 1))
    while Index < #Frames - 1 and Frames[Index + 1].T < State.GhostReplay.PlaybackTime do Index += 1 end
    while Index > 1 and Frames[Index].T > State.GhostReplay.PlaybackTime do Index -= 1 end
    State.GhostReplay.PlaybackIndex = Index
    local A = Frames[Index]
    local B = Frames[math.min(Index + 1, #Frames)]
    local Span = math.max(B.T - A.T, 0.0001)
    local Alpha = math.clamp((State.GhostReplay.PlaybackTime - A.T) / Span, 0, 1)
    for PartIndex, GhostPart in ipairs(State.GhostReplay.GhostParts) do
        if GhostPart and GhostPart.Parent then
            local From = A.Poses[PartIndex]
            local To = B.Poses[PartIndex]
            if typeof(From) == 'CFrame' and typeof(To) == 'CFrame' then
                GhostPart.CFrame = From:Lerp(To, Alpha)
            elseif typeof(From) == 'CFrame' then
                GhostPart.CFrame = From
            end
        end
    end
    if State.GhostReplay.GhostBall and State.GhostReplay.GhostBall.Parent then
        local BallFrom = A.Ball
        local BallTo = B.Ball
        if typeof(BallFrom) == 'CFrame' and typeof(BallTo) == 'CFrame' then
            State.GhostReplay.GhostBall.CFrame = BallFrom:Lerp(BallTo, Alpha)
            State.GhostReplay.GhostBall.LocalTransparencyModifier = CONFIG.GhostTransparency
        elseif typeof(BallFrom) == 'CFrame' then
            State.GhostReplay.GhostBall.CFrame = BallFrom
        else
            State.GhostReplay.GhostBall.LocalTransparencyModifier = 1
        end
    end
end

GiveSignal(RunService.Heartbeat:Connect(WYNF_JIT(function(DeltaTime)
    if not State.Active then return end
    if State.GhostReplay.Recording then State.GhostReplay.StepRecording(DeltaTime) end
    if State.GhostReplay.Ghost then State.GhostReplay.StepPlayback(DeltaTime) end
end)))

function State.Extras.FindChildInsensitive(Parent, WantedName)
    if not Parent then return nil end
    local Wanted = string.lower(tostring(WantedName or ''))
    for _, Child in ipairs(Parent:GetChildren()) do
