    local function BuildKeybindManager()
        local KeybindManager = {
            Entries = {},
            Ordered = {},
            Capture = nil,
            Held = {},
            RowControls = {},
            OverlayRows = {},
            MobileRows = {},
            MobileQuickRows = {},
            SaveSerial = 0,
        }
        HubUI.KeybindManager = KeybindManager

        local KeyDisplayNames = {
            LeftControl = 'LCTRL', RightControl = 'RCTRL', LeftShift = 'LSHIFT', RightShift = 'RSHIFT',
            LeftAlt = 'LALT', RightAlt = 'RALT', Return = 'ENTER', Backspace = 'BACKSPACE',
            Space = 'SPACE', CapsLock = 'CAPS', PageUp = 'PGUP', PageDown = 'PGDN',
            MouseButton1 = 'MB1', MouseButton2 = 'MB2', MouseButton3 = 'MB3',
            One = '1', Two = '2', Three = '3', Four = '4', Five = '5', Six = '6',
            Seven = '7', Eight = '8', Nine = '9', Zero = '0',
        }

        local function KeyCodeToken(KeyCode)
            return KeyCode and KeyCode ~= Enum.KeyCode.Unknown and ('KC:' .. KeyCode.Name) or nil
        end

        local function InputToken(Input)
            if Input.UserInputType == Enum.UserInputType.Keyboard and Input.KeyCode ~= Enum.KeyCode.Unknown then
                return 'KC:' .. Input.KeyCode.Name
            end
            if Input.UserInputType == Enum.UserInputType.MouseButton1
                or Input.UserInputType == Enum.UserInputType.MouseButton2
                or Input.UserInputType == Enum.UserInputType.MouseButton3 then
                return 'UI:' .. Input.UserInputType.Name
            end
            return nil
        end

        local function TokenDisplay(Token)
            if not Token or Token == '' then return '—' end
            local Name = tostring(Token):match('^[^:]+:(.+)$') or tostring(Token)
            return KeyDisplayNames[Name] or string.upper(Name)
        end

        local function TokenToKeyCode(Token)
            local Name = tostring(Token or ''):match('^KC:(.+)$')
            return Name and Enum.KeyCode[Name] or nil
        end

        local function IsShiftDown()
            return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        end

        local function ResolveControlPage(Control)
            local Current = Control and Control.SearchParent
            while Current do
                for PageName, Page in pairs(Pages) do
                    if Current == Page then return PageName end
                end
                Current = Current.Parent
            end
            return nil
        end

        local function ValidModesFor(Kind)
            if Kind == 'Toggle' then return { 'Toggle', 'Hold', 'Always' } end
            if Kind == 'Selector' or Kind == 'Dropdown' then return { 'Cycle' } end
            if Kind == 'Number' then return { 'Increment' } end
            return { 'Press' }
        end

        local function DefaultModeFor(Kind)
            if Kind == 'Toggle' then return 'Toggle' end
            if Kind == 'Selector' or Kind == 'Dropdown' then return 'Cycle' end
            if Kind == 'Number' then return 'Increment' end
            return 'Press'
        end

        local function ModeAllowed(Entry, Mode)
            return table.find(Entry.Modes, Mode) ~= nil
        end

        function KeybindManager:ScheduleSave()
            self.SaveSerial += 1
            local Serial = self.SaveSerial
            State.Lifecycle:Delay(0.12, function()
                if Serial == self.SaveSerial and State.Active then SaveInterfaceConfig() end
            end)
        end

        function KeybindManager:Store(Entry)
            InterfaceConfig.Keybinds[Entry.Id] = {
                Key = Entry.Key,
                Mode = Entry.Mode,
                Show = Entry.Show ~= false,
                MobileQuick = Entry.MobileQuick == true,
            }
            self:ScheduleSave()
        end

        function KeybindManager:GetActive(Entry)
            if Entry.Mode == 'Always' then return true end
            if Entry.Kind == 'Toggle' and Entry.Control then return Entry.Control.Value == true end
            return self.Held[Entry.Id] == true
        end

        function KeybindManager:UpdateLegacyKeys(Entry)
            local KeyCode = TokenToKeyCode(Entry.Key)
            if Entry.Id == 'MenuToggle' and KeyCode then
                CONFIG.MenuKey = KeyCode
                HubUI.MenuKey = KeyCode
            elseif Entry.Id == 'SilentAim' and KeyCode then
                CONFIG.ToggleKey = KeyCode
            elseif Entry.Id == 'SilentMode' and KeyCode then
                CONFIG.SilentModeToggleKey = KeyCode
            elseif Entry.Id == 'NoJumpShot' and KeyCode then
                CONFIG.NoJumpShotKey = KeyCode
                if State.NoJump and State.NoJump.BindKey then
                    State.NoJump.BindKey(KeyCode)
                end
            elseif Entry.Id == 'AutoGuard' and KeyCode then
                CONFIG.AutoGuardOnBallKey = KeyCode
            elseif Entry.Id == 'AutoGetOpen' and KeyCode then
                CONFIG.AutoGetOpenKey = KeyCode
            end
        end

        function KeybindManager:RefreshEntry(Entry)
            local KeyText = Entry.Mode == 'Always' and 'ALWAYS' or TokenDisplay(Entry.Key)
            if Entry.Control and Entry.Control.KeyButton and Entry.Control.KeyButton.Parent then
                Entry.Control.KeyButton.Text = KeyText
                Entry.Control.KeyButton.TextColor3 = (Entry.Key or Entry.Mode == 'Always') and Theme.Accent or Theme.Muted
            end
            local Row = self.RowControls[Entry.Id]
            if Row then
                Row.KeyButton.Text = KeyText
                Row.ModeButton.Text = string.upper(Entry.Mode)
                Row.VisibilityButton.Text = Entry.Show ~= false and '●' or '○'
                Row.VisibilityButton.TextColor3 = Entry.Show ~= false and Theme.Accent or Theme.Muted
                if Row.MobileButton then
                    Row.MobileButton.Text = 'RUN'
                    Row.MobileButton.TextColor3 = self:GetActive(Entry) and Theme.AccentBright or Theme.Accent
                end
            end
            if self.RefreshMobileEntry then self:RefreshMobileEntry(Entry) end
        end

        function KeybindManager:SetKey(Entry, Token, ShouldSave)
            if not Entry then return end
            Entry.Key = Token
            self:UpdateLegacyKeys(Entry)
            self:RefreshEntry(Entry)
            self:RefreshOverlay()
            self:ApplyOverlayWindowState(HubUI.Open == true)
            if ShouldSave ~= false then self:Store(Entry) end
        end

        function KeybindManager:SetMode(Entry, Mode, ShouldSave)
            if not Entry or not ModeAllowed(Entry, Mode) then return end
            local PreviousMode = Entry.Mode
            Entry.Mode = Mode
            if PreviousMode == 'Hold' and self.Held[Entry.Id] and Entry.Control and Entry.Kind == 'Toggle' then
                self.Held[Entry.Id] = nil
                Entry.Control:Set(false, true)
            end
            if Mode == 'Always' and Entry.Control and Entry.Kind == 'Toggle' and not Entry.Control.Value then
                Entry.Control:Set(true, true)
            end
            self:RefreshEntry(Entry)
            self:RefreshOverlay()
            if ShouldSave ~= false then self:Store(Entry) end
        end

        function KeybindManager:CycleMode(Entry)
            if not Entry or #Entry.Modes <= 1 then return end
            local Index = table.find(Entry.Modes, Entry.Mode) or 1
            Index = (Index % #Entry.Modes) + 1
            self:SetMode(Entry, Entry.Modes[Index], true)
        end

        function KeybindManager:SetShown(Entry, Value)
            Entry.Show = Value ~= false
            self:RefreshEntry(Entry)
            self:RefreshOverlay()
            self:Store(Entry)
        end

