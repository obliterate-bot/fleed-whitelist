function State.LocalSpoofs.ApplyAchievementSpoof()
    if not State.LocalAchievementSpoofEnabled then return end
    local Frames = State.LocalSpoofs.FindMenuFrames()
    local Achievements = Frames and Frames:FindFirstChild('Achievements')
    if not Achievements then return end
    local Set = State.LocalSpoofs.SetStatsUI
    local White = Color3.fromRGB(255, 255, 255)
    local Frame = Achievements:FindFirstChild('Frame')
    local Scroll = Frame and Frame:FindFirstChild('ScrollingFrame')
    local Total = 0
    if Scroll then
        for _, Row in ipairs(Scroll:GetChildren()) do
            for _, Item in ipairs(Row:GetChildren()) do
                local Button = Item:FindFirstChild('button')
                local Icon = Button and Button:FindFirstChild('Icon')
                if Icon and Icon:IsA('ImageLabel') then
                    Total = Total + 1
                    Set(Icon, 'ImageColor3', White)
                end
            end
        end
    end
    local Top = Achievements:FindFirstChild('Top')
    if Total > 0 and Top and Top:FindFirstChild('TextLabel') then
        Set(Top.TextLabel, 'Text', 'Achievements [' .. Total .. '/' .. Total .. ']')
    end
    local Info = Achievements:FindFirstChild('InfoFrame')
    local Equip = Info and Info:FindFirstChild('EquipButton')
    local Holder = Equip and Equip:FindFirstChild('Frame')
    local Label = Holder and Holder:FindFirstChild('TextLabel')
    if Label and tostring(Label.Text) == 'LOCKED' then
        Set(Label, 'Text', 'EQUIP')
        Set(Equip, 'BackgroundColor3', Color3.fromRGB(0, 255, 0))
    end
    local Multiplier = math.max(0, tonumber(State.LocalAchMultiplier) or 0)
    local Multipliers = Achievements:FindFirstChild('MyMultipliers')
    if Multiplier > 0 and Multipliers then
        for _, Key in ipairs({ 'Luck', 'Rank', 'Cash', 'Shield' }) do
            local Node = Multipliers:FindFirstChild(Key)
            local ValueLabel = Node and Node:FindFirstChild('Multiplier')
            if ValueLabel and ValueLabel:IsA('TextLabel') then
                Set(ValueLabel, 'Text', Multiplier .. 'x')
            end
        end
    end
end

