    State.BallAssist.AntiReachLostAt = nil
    State.BallAssist.AntiReachCounterUntil = 0
    State.BallAssist.AntiReachCounterAttempts = 0
    State.BallAssist.AntiReachCounterHolder = nil
    State.BallAssist.AntiReachStatus = 'OFF'
    State.BallAssist.AntiReachStepAt = 0
    State.BallAssist.AntiReachNoStealCheckedAt = 0
    State.BallAssist.AntiReachNoStealCachedStatus = 'IDLE'
