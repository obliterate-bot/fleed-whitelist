            State.Utility.ServerHopStatus = BadServer
                and ('POOR SERVER | ' .. tostring(State.Utility.ServerBadChecks) .. '/3')
                or string.format('GOOD | %.0f MS', Ping)
            if State.Utility.ServerBadChecks >= 3 then
                State.Utility.ServerBadChecks = 0
                pcall(State.Utility.HopNow, 'poor server')
            end
        end
        task.wait(1)
    end
