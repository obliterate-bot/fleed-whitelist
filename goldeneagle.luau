State.PassRange = {
    Highlight = nil,
    Maximum = nil,
    ReceiverInRange = false,
    FillA = Color3.fromRGB(212, 175, 55),
    FillB = Color3.fromRGB(255, 226, 122),
    OutlineColor = Color3.fromRGB(7, 7, 8),
}

function State.PassRange.GetMaximum()
    local Range = State.PassRange
    if Range.Maximum then return Range.Maximum end
    local Power = tonumber(CONFIG.PassPower) or 85
    local Gravity = Workspace.Gravity
    local Best = 0
    if Gravity > 0 then
        for Index = 0, 720 do
            local Angle = math.rad(-89 + 178 * (Index / 720))
            local Horizontal = Power * math.cos(Angle)
            local Vertical = Power * math.sin(Angle) + CONFIG.FormulaVerticalBoost
            if Horizontal > 0 and Vertical > 0 then
                Best = math.max(Best, Horizontal * ((2 * Vertical) / Gravity))
            end
        end
    end
    Range.Maximum = Best
    return Best
end

function State.PassRange.Destroy()
    local Range = State.PassRange
    if Range.Highlight then pcall(function() Range.Highlight:Destroy() end) end
    Range.Highlight = nil
    Range.Maximum = nil
    Range.ReceiverInRange = false
end

function State.PassRange.Hide()
    local Highlight = State.PassRange.Highlight
