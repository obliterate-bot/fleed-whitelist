local function ResolveQuickTravelPart(instance)
    if instance == nil then
        return nil
    end

    if safe_is_a(instance, 'BasePart') then
        return instance
    end

    if not safe_is_a(instance, 'Model') then
        return nil
    end

    if instance.PrimaryPart and safe_is_a(instance.PrimaryPart, 'BasePart') then
        return instance.PrimaryPart
    end

    local Center = safe_find(instance, 'Center')
    if Center and safe_is_a(Center, 'BasePart') then
        return Center
    end

    return instance:FindFirstChildWhichIsA('BasePart', true)
end

local function FindNearestPracticeCourtFromPosition(OriginPosition)
    if typeof(OriginPosition) ~= 'Vector3' then
        return nil, math.huge
    end

    local PracticeArea = safe_find(Workspace, 'PracticeArea')
    if PracticeArea == nil then
        return nil, math.huge
    end

    local OriginXZ = Vector3.new(OriginPosition.X, 0, OriginPosition.Z)
    local NearestPracticeCourt = nil
    local ShortestDistance = math.huge

    for _, PracticeCourt in ipairs(PracticeArea:GetChildren()) do
        if safe_is_a(PracticeCourt, 'Model') then
            local HasPracticeHitboxes = safe_find(PracticeCourt, 'Hitboxes') ~= nil
                or safe_find(PracticeCourt, 'HitboxesHome') ~= nil
                or safe_find(PracticeCourt, 'HitboxesAway') ~= nil

            if HasPracticeHitboxes then
                local PracticeCenter = ResolveQuickTravelPart(safe_find(PracticeCourt, 'Center') or PracticeCourt)
                if PracticeCenter then
                    local PracticeXZ = Vector3.new(PracticeCenter.Position.X, 0, PracticeCenter.Position.Z)
                    local Distance = (OriginXZ - PracticeXZ).Magnitude
                    if Distance < ShortestDistance then
                        ShortestDistance = Distance
                        NearestPracticeCourt = PracticeCourt
                    end
                end
            end
        end
    end

    return NearestPracticeCourt, ShortestDistance
end

