            RefreshPickerVisuals(true)
            ClosePicker(true)
        end)
        State.Lifecycle:Connect(PickerCancel.MouseButton1Click, function() ClosePicker(false) end)
        GiveSignal(PickerHex.FocusLost:Connect(function(EnterPressed)
            if not (PickerRole or PickerInitialColor) then return end
