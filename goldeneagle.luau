local function IsInsideSilentAimBand()
    local Rim, Distance = FindConfiguredGoal()
    if not Rim then return false end
    local AdjustedDistance = AdjustAimDistance(
        State.Backboard.GetConfiguredAimDistance(Rim, Distance))
    if not CustomAimDistanceAllowed(AdjustedDistance) then return false end
    local Power = State.PowerBypass.GetEffectivePower()
    return PowerSupportsDistance(Power, AdjustedDistance)
end

local function StartAutoSelfPass()
    if not State.Active or not State.AutoSelfPassEnabled or State.PassInProgress
        or (State.AutoDunk and State.AutoDunk.InProgress) then return end
    if not GetHeldBasketballModel(LP) then return end

    local Now = os.clock()
    if Now - State.LastSelfPassAt < 0.5 then return end
    State.LastSelfPassAt = Now
    if not HasHeldPracticeBallState(LP) and IsInsideSilentAimBand() then return end

    BeginPass(function(Generation)
        task.wait(CONFIG.SelfPassDelay)
        if not State.Active or not State.AutoSelfPassEnabled then return end
        local CurrentCharacter = LP.Character
        if not GetHeldBasketballModel(LP) then return end
        local Root = CurrentCharacter:FindFirstChild('HumanoidRootPart')
        local LocalHumanoid = CurrentCharacter:FindFirstChild('Humanoid')
        if not Root or not LocalHumanoid then return end

        local MoveDirection = LocalHumanoid.MoveDirection
        if MoveDirection.Magnitude >= 0.1 then
            MoveDirection = Vector3.new(MoveDirection.X, 0, MoveDirection.Z).Unit
        else
            MoveDirection = nil
        end

        local AimDirection
        if MoveDirection then
            local UpAngle = math.rad(170 - 90)
            AimDirection = MoveDirection * math.cos(UpAngle)
            + Vector3.new(0, math.sin(UpAngle), 0)
        else
            AimDirection = Vector3.new(0, 1, 0)
        end
        ExecutePassAt(Root.Position + AimDirection.Unit * 50, Generation)
    end)
end

