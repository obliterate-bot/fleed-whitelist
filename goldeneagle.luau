function State.Utility.InstallAntiTravelHook()
    GlobalEnv.__GOLDEN_EAGLE_TRAVEL_RUNTIME = State
    if GlobalEnv.__GOLDEN_EAGLE_TRAVEL_HOOK_INSTALLED then
        State.Utility.TravelFireServerOriginal = GlobalEnv.__GOLDEN_EAGLE_TRAVEL_ORIGINAL
        State.Utility.TravelHookMode =
        GlobalEnv.__GOLDEN_EAGLE_TRAVEL_HOOK_MODE or 'INSTALLED'
        return true
    end

    if not State.Utility.SBEvent then
        State.Utility.TravelHookMode = 'NO REMOTE'
        return false
    end
    local TargetEvent = State.Utility.SBEvent

    local function ShouldBlock(Self, First)
        local Runtime = GlobalEnv.__GOLDEN_EAGLE_TRAVEL_RUNTIME
        if not (Runtime and Runtime.Active and Runtime.AntiTravelEnabled) then
            return false
        end
        if Self ~= TargetEvent or First ~= 'Travel' then return false end
        Runtime.Utility.TravelBlocked += 1
        return true
    end

    if type(hookmetamethod) == 'function'
        and type(getnamecallmethod) == 'function' then
        local function NamecallHandler(Self, ...)
            local Original = GlobalEnv.__GOLDEN_EAGLE_TRAVEL_ORIGINAL
            local Method
            local Read = pcall(function() Method = getnamecallmethod() end)
            if Read and Method == 'FireServer'
                and ShouldBlock(Self, (select(1, ...))) then
                return nil
            end
            return Original(Self, ...)
        end

        local Success, Original = pcall(function()
            local Callback = NamecallHandler
            if type(newcclosure) == 'function' then
                Callback = newcclosure(NamecallHandler)
            end
            return hookmetamethod(game, '__namecall', Callback)
        end)

        if Success and Original then
            GlobalEnv.__GOLDEN_EAGLE_TRAVEL_HOOK_INSTALLED = true
            GlobalEnv.__GOLDEN_EAGLE_TRAVEL_ORIGINAL = Original
            GlobalEnv.__GOLDEN_EAGLE_TRAVEL_HOOK_MODE = 'NAMECALL'
            State.Utility.TravelFireServerOriginal = Original
            State.Utility.TravelHookMode = 'NAMECALL'
            return true
        end
    end

    if type(hookfunction) == 'function' and type(newcclosure) == 'function' then
        local Success, Original = pcall(function()
            local Previous
            Previous = hookfunction(TargetEvent.FireServer, newcclosure(function(Self, ...)
                if ShouldBlock(Self, (select(1, ...))) then return nil end
                return Previous(Self, ...)
            end))
            return Previous
        end)
        if Success and Original then
            GlobalEnv.__GOLDEN_EAGLE_TRAVEL_HOOK_INSTALLED = true
            GlobalEnv.__GOLDEN_EAGLE_TRAVEL_ORIGINAL = Original
            GlobalEnv.__GOLDEN_EAGLE_TRAVEL_HOOK_MODE = 'FIRESERVER'
            State.Utility.TravelFireServerOriginal = Original
            State.Utility.TravelHookMode = 'FIRESERVER (WEAK)'
            return true
        end
    end

    State.Utility.TravelHookMode = 'UNSUPPORTED EXECUTOR'
    return false
end

