function State.LogoBadges.SetUI(Object, Property, Value)
    if typeof(Object) ~= 'Instance' then return end
    local Store = State.LogoBadges.Originals[Object]
    if not Store then
        Store = {}
        State.LogoBadges.Originals[Object] = Store
    end
    if Store[Property] == nil then
        local Ok, Current = pcall(function() return Object[Property] end)
        if not Ok then return end
        Store[Property] = Current
    end
    pcall(function() Object[Property] = Value end)
end

function State.LogoBadges.RestoreUI()
    for Object, Store in pairs(State.LogoBadges.Originals) do
        for Property, Value in pairs(Store) do
            pcall(function() Object[Property] = Value end)
        end
    end
    State.LogoBadges.Originals = setmetatable({}, { __mode = 'k' })
    State.LogoBadges.ClearCustomIcons(false)
end

function State.LogoBadges.AnyActive()
    if #State.CustomLogos > 0 then return true end
    for _, Enabled in pairs(State.LocalLogos) do
        if Enabled then return true end
    end
