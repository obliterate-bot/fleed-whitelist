State.GoalLookup.FindGoalPartInHitboxFolder = FindGoalPartInHitboxFolder

local CachedAimCourt = nil
local CachedAimSlotName = nil
local CachedAimSlot = nil
local CachedAimCourtAt = 0

local function FindNearestGoal()
    local NearestRim = nil
    local ShortestDistance = math.huge
    if not HumanoidRootPart then return nil, math.huge end

    local Now = os.clock()
    if Now - CachedAimCourtAt > 0.5 then
        CachedAimCourt, CachedAimSlotName, CachedAimSlot = FindPlayerCourtSlot(LP)
        CachedAimCourtAt = Now
    end

    local HRPXZ = Vector3.new(HumanoidRootPart.Position.X, 0, HumanoidRootPart.Position.Z)
    local IsPracticeBallState = HasHeldPracticeBallState(LP)
    local LocalCourt, LocalSlotName, Slot = CachedAimCourt, CachedAimSlotName, CachedAimSlot
    local MyTeam = not IsPracticeBallState and ResolvePlayerCourtTeam(LP, LocalCourt, LocalSlotName, Slot) or nil

    local AimSnapshot = nil
    if LocalCourt then
        local PlayerSlotsByPlayer = {}
        PlayerSlotsByPlayer[LP] = { court = LocalCourt, slotName = LocalSlotName, slot = Slot }
        AimSnapshot = { playerSlotsByPlayer = PlayerSlotsByPlayer }
    end
    local ScopedGoal = FindPlayerScoringGoal(LP, AimSnapshot)
    if ScopedGoal then
        local ScopedGoalXZ = Vector3.new(ScopedGoal.Position.X, 0, ScopedGoal.Position.Z)
        local ScopedDistance = (HRPXZ - ScopedGoalXZ).Magnitude
        if ScopedDistance <= MaxRange or CONFIG.MaxRangeBypass then
            return ScopedGoal, ScopedDistance
        end
        return nil, math.huge
    end

    for _, Hitboxes in ipairs(GoalData.check) do
        local SkipHitbox = MyTeam and (IsArenaMode and (
            (MyTeam == 'Home' and Hitboxes.Name == 'HitboxesAway') or
            (MyTeam == 'Away' and Hitboxes.Name == 'HitboxesHome')
            ) or (
            (MyTeam == 'Home' and Hitboxes.Name == 'HitboxesHome') or
            (MyTeam == 'Away' and Hitboxes.Name == 'HitboxesAway')
        ))
        if not SkipHitbox then
            local Goal = FindGoalPartInHitboxFolder(Hitboxes)
            if Goal then
                local GoalXZ = Vector3.new(Goal.Position.X, 0, Goal.Position.Z)
                local Dist = (HRPXZ - GoalXZ).Magnitude
                if Dist < ShortestDistance then
                    ShortestDistance = Dist
                    NearestRim = Goal
                end
            end
        end
    end

    return NearestRim, ShortestDistance
end

local function FindNearestGoalUnscoped()
    if not HumanoidRootPart then return nil, math.huge end
    local OriginXZ = Vector3.new(HumanoidRootPart.Position.X, 0, HumanoidRootPart.Position.Z)
    local Best, BestDistance = nil, math.huge
    for _, Hitboxes in ipairs(GoalData.check) do
        local Goal = FindGoalPartInHitboxFolder(Hitboxes)
        if Goal then
            local GoalXZ = Vector3.new(Goal.Position.X, 0, Goal.Position.Z)
            local Distance = (OriginXZ - GoalXZ).Magnitude
            if Distance < BestDistance then
                Best, BestDistance = Goal, Distance
            end
        end
    end
    return Best, BestDistance
end

local FindConfiguredGoal
FindConfiguredGoal = WYNF_JIT_MAX(function()
    local Now = os.clock()
    local Rim = PerfCache.GoalRim
    if Rim and Rim.Parent
        and PerfCache.GoalMode == CONFIG.AimTargetMode
        and (Now - PerfCache.GoalAt) < 0.08
        and HumanoidRootPart then
        local RootPosition = HumanoidRootPart.Position
        local RimPosition = Rim.Position
        local Live = Vector3.new(
            RootPosition.X - RimPosition.X, 0, RootPosition.Z - RimPosition.Z).Magnitude
        if CONFIG.MaxRangeBypass or Live <= MaxRange then
            return Rim, Live
        end
    end

    if CONFIG.AimTargetMode == 'Nearest Goal' then
        PerfCache.GoalRim, PerfCache.GoalDistance = FindNearestGoalUnscoped()
    else
        PerfCache.GoalRim, PerfCache.GoalDistance = FindNearestGoal()
    end
    PerfCache.GoalMode = CONFIG.AimTargetMode
    PerfCache.GoalAt = Now
    return PerfCache.GoalRim, PerfCache.GoalDistance
end)

State.Backboard = State.Backboard or {}

function State.Backboard.FindForRim(Rim)
    local Container = Rim and Rim.Parent
    for _ = 1, 4 do
        if not Container then break end
        local Board = safe_find(Container, 'Backboard')
        if Board and safe_is_a(Board, 'BasePart') then
            return Board
        end
        Container = Container.Parent
    end
    return nil
end

function State.Backboard.GetCurrentReleaseGeometry()
    local Character = LP.Character
    local Head = Character and safe_find(Character, 'Head')
    if not Head then return nil end

    local Basketball = safe_find(Character, 'Basketball')
    local Ball = Basketball and Basketball:FindFirstChild('Ball', true)
    local ReleaseY = Ball and safe_is_a(Ball, 'BasePart') and Ball.Position.Y
        or Head.Position.Y
    local BallRadius = 1.25
    if Ball and safe_is_a(Ball, 'BasePart') then
        BallRadius = math.max(Ball.Size.X, Ball.Size.Y, Ball.Size.Z) * 0.5
    end

    return Vector3.new(Head.Position.X, ReleaseY, Head.Position.Z), BallRadius
end

function State.Backboard.GetPlane(Board, ReleaseOrigin, BallRadius)
    if not (Board and ReleaseOrigin) then return nil end

    local Size = Board.Size
    local RawNormal, Thickness
    if Size.X <= Size.Y and Size.X <= Size.Z then
        RawNormal, Thickness = Board.CFrame.RightVector, Size.X
    elseif Size.Y <= Size.X and Size.Y <= Size.Z then
        RawNormal, Thickness = Board.CFrame.UpVector, Size.Y
    else
        RawNormal, Thickness = Board.CFrame.LookVector, Size.Z
    end

    local Normal = Vector3.new(RawNormal.X, 0, RawNormal.Z)
    if Normal.Magnitude <= 0.0001 then return nil end
    Normal = Normal.Unit
    if (ReleaseOrigin - Board.Position):Dot(Normal) < 0 then
        Normal = -Normal
    end

    local Radius = math.max(tonumber(BallRadius) or 1.25, 0)
    local Padding = math.max(tonumber(CONFIG.BackboardSurfacePadding) or 0.08, 0)
    local PlanePoint = Board.Position
    + Normal * ((math.max(Thickness, 0) * 0.5) + Radius + Padding)
    return PlanePoint, Normal
end

function State.Backboard.GetMirrorTarget(Rim, ReleaseOrigin, BallRadius)
    local Board = State.Backboard.FindForRim(Rim)
    if not Board then return nil end

    local PlanePoint, Normal = State.Backboard.GetPlane(Board, ReleaseOrigin, BallRadius)
    if not PlanePoint then return nil end

    local Offset = Rim.Position - PlanePoint
    local FlatOffset = Vector3.new(Offset.X, 0, Offset.Z)
    local Target = Rim.Position - 2 * Normal * FlatOffset:Dot(Normal)
    Target += Vector3.new(0, tonumber(CONFIG.BackboardAimYOffset) or 0, 0)
    return Target, Board
end

function State.Backboard.GetConfiguredAimDistance(Rim, DirectDistance)
    local SideBank = CONFIG.SilentMode == 'Side Bank'
    if CONFIG.BackboardEnabled ~= true and not SideBank then
        return DirectDistance
    end

    local ReleaseOrigin, BallRadius = State.Backboard.GetCurrentReleaseGeometry()
    local Target, Board = ReleaseOrigin
        and State.Backboard.GetMirrorTarget(Rim, ReleaseOrigin, BallRadius)
    if Target and SideBank and Board then
        local _, Normal = State.Backboard.GetPlane(Board, ReleaseOrigin, BallRadius)
        if Normal then
            local Tangent = Vector3.new(-Normal.Z, 0, Normal.X)
            if Tangent.Magnitude > 0.001 then
                Tangent = Tangent.Unit
                local Side = (ReleaseOrigin - Rim.Position):Dot(Tangent) >= 0 and 1 or -1
                Target += Tangent * Side
                * (tonumber(CONFIG.ShotModeSideBankOffset) or 0.65)
            end
        end
    end
    if not Target then
        return CONFIG.BackboardFallbackToNormal and DirectDistance or math.huge
    end

    local Delta = Target - ReleaseOrigin
    return Vector3.new(Delta.X, 0, Delta.Z).Magnitude
end

