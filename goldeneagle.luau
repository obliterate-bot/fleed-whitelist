function State.LogoBadges.Apply()
    if not State.LogoBadges.AnyActive() then

        for LogoName in pairs(State.LocalLogos) do
            local Original = State.Cosmetics.Originals[LogoName] or false
            if safe_get_attribute(LP, LogoName) ~= Original then
                pcall(function() LP:SetAttribute(LogoName, Original) end)
            end
        end
        State.LogoBadges.RestoreUI()
        State.LogoBadges.ClearCustomIcons(false)
        return
    end
    for LogoName, Enabled in pairs(State.LocalLogos) do
        local Target = Enabled or State.Cosmetics.Originals[LogoName] or false
        if safe_get_attribute(LP, LogoName) ~= Target then
            pcall(function() LP:SetAttribute(LogoName, Target) end)
        end
    end
    pcall(State.LogoBadges.ApplyPlayerlist)
    pcall(State.LogoBadges.ApplySettingsPanel)
    pcall(State.LogoBadges.ApplyCreatorTag)
end

function State.LogoBadges.StartLoop()
    if State.LogoBadges.Bound then return end
    State.LogoBadges.Bound = true
    pcall(function() State.Lifecycle:UnbindFromRenderStep('GoldenEagleLogoBadges') end)
    State.Lifecycle:BindToRenderStep('GoldenEagleLogoBadges', Enum.RenderPriority.Last.Value + 12, WYNF_JIT(function()
        if not State.LogoBadges.AnyActive() then return end
        local Now = os.clock()
        if Now - (State.LogoBadges.LastApplyAt or 0) < 0.35 then return end
        State.LogoBadges.LastApplyAt = Now
        pcall(State.LogoBadges.Apply)
    end))
end

function State.Cosmetics.SetLocalLogoSpoof(LogoName, Enabled)
    if State.LocalLogos[LogoName] == nil then return end
    Enabled = Enabled == true
    State.LocalLogos[LogoName] = Enabled
    LP:SetAttribute(LogoName, Enabled or State.Cosmetics.Originals[LogoName])
    if Enabled then
        State.LogoBadges.StartLoop()
        pcall(State.LogoBadges.Apply)
    else
        State.LogoBadges.RestoreUI()
        if State.LogoBadges.AnyActive() then
            pcall(State.LogoBadges.Apply)
        end
    end
end

function State.Cosmetics.SetLocalCosmeticSpoof(Enabled, ShouldNotify)
    State.LocalCosmeticSpoofEnabled = Enabled == true
    CONFIG.LocalCosmeticSpoof = State.LocalCosmeticSpoofEnabled
    if State.LocalCosmeticSpoofEnabled then
        State.Cosmetics.ApplyLocalCosmetics()
    else
        RestoreLocalBallCosmetics()
        if LP.Character then ClearManualBodyAura(LP.Character) end
        State.Cosmetics.Runtime.Character = nil
        State.Cosmetics.Runtime.BodyAura = nil
        State.Cosmetics.Runtime.AppliedBall = nil
        State.Cosmetics.Runtime.AppliedSignature = nil
    end
end

State.PerfectShotStyle = {
    ActiveUntil = 0,
    Origin = nil,
    LastScanAt = 0,
    LastLockAt = 0,
    CachedColorKey = nil,
    CachedColor = nil,
    CachedSequence = nil,
    Objects = setmetatable({}, { __mode = 'k' }),
    ColorWatches = setmetatable({}, { __mode = 'k' }),
    Generation = 0,
}

function State.PerfectShotStyle.ClearWatches()
    for Object, Connection in pairs(State.PerfectShotStyle.ColorWatches) do
        State.Lifecycle:DisconnectConnection(Connection)
        State.PerfectShotStyle.ColorWatches[Object] = nil
    end
    table.clear(State.PerfectShotStyle.Objects)
    table.clear(State.PerfectShotStyle.Applying)
end

function State.PerfectShotStyle.Color()
    local R = math.clamp(math.floor(tonumber(CONFIG.PerfectShotColorR) or 80), 0, 255)
    local G = math.clamp(math.floor(tonumber(CONFIG.PerfectShotColorG) or 255), 0, 255)
    local B = math.clamp(math.floor(tonumber(CONFIG.PerfectShotColorB) or 120), 0, 255)
    local Key = R * 65536 + G * 256 + B
    if State.PerfectShotStyle.CachedColorKey ~= Key then
        State.PerfectShotStyle.CachedColorKey = Key
        State.PerfectShotStyle.CachedColor = Color3.fromRGB(R, G, B)
        State.PerfectShotStyle.CachedSequence = nil
    end
    return State.PerfectShotStyle.CachedColor
end

function State.PerfectShotStyle.Sequence()
    local Color = State.PerfectShotStyle.Color()
    if State.PerfectShotStyle.CachedSequence then return State.PerfectShotStyle.CachedSequence end
    State.PerfectShotStyle.CachedSequence = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color:Lerp(Color3.new(1, 1, 1), 0.3)),
        ColorSequenceKeypoint.new(0.5, Color),
        ColorSequenceKeypoint.new(1, Color:Lerp(Color3.new(0, 0, 0), 0.28)),
    })
    return State.PerfectShotStyle.CachedSequence
end

function State.PerfectShotStyle.ApplyText()
    local Character = LP.Character
    if not Character then return end
    local Text = tostring(CONFIG.PerfectShotText or 'Perfect Shot!'):gsub('[\r\n]', ' ')
    if #Text > 36 then Text = Text:sub(1, 36) end
    if Text == '' then Text = 'Perfect Shot!' end
    local Sequence = State.PerfectShotStyle.Sequence()
    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:IsA('TextLabel') then
            local Billboard = Object:FindFirstAncestorOfClass('BillboardGui')
            local Gradient = Object:FindFirstChildOfClass('UIGradient')
            local Stroke = Object:FindFirstChildOfClass('UIStroke')
            if Billboard and Gradient and Stroke then
                pcall(function()
                    Object.Text = Text
                    Gradient.Color = Sequence
                    Object.TextColor3 = Color3.new(1, 1, 1)
                    local StrokeGradient = Stroke:FindFirstChildOfClass('UIGradient')
                    if StrokeGradient then StrokeGradient.Color = Sequence end
                end)
            end
        end
    end
end

function State.PerfectShotStyle.IsNear(Object)
    local Part = Object:IsA('BasePart') and Object or Object:FindFirstAncestorWhichIsA('BasePart')
    if not Part then return true end
    local Origin = State.PerfectShotStyle.Origin
    if Origin and (Part.Position - Origin).Magnitude <= 24 then return true end
    local Root = LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
    return Root and (Part.Position - Root.Position).Magnitude <= 24 or false
end

State.PerfectShotStyle.Applying = State.PerfectShotStyle.Applying or setmetatable({}, { __mode = 'k' })

function State.PerfectShotStyle.ApplyObject(Object)
    if os.clock() > State.PerfectShotStyle.ActiveUntil then return end
    if not (Object and Object.Parent and State.PerfectShotStyle.IsNear(Object)) then return end
    local IsSequence = Object:IsA('ParticleEmitter') or Object:IsA('Trail') or Object:IsA('Beam')
    local IsLight = Object:IsA('PointLight') or Object:IsA('SpotLight') or Object:IsA('SurfaceLight')
    local IsHighlight = Object:IsA('Highlight')
    if not (IsSequence or IsLight or IsHighlight) then return end
    State.PerfectShotStyle.Objects[Object] = true

    if not IsHighlight and not State.PerfectShotStyle.ColorWatches[Object] then
        pcall(function()
            State.PerfectShotStyle.ColorWatches[Object] = State.Lifecycle:Connect(Object:GetPropertyChangedSignal('Color'), function()
                if os.clock() <= State.PerfectShotStyle.ActiveUntil and not State.PerfectShotStyle.Applying[Object] then
                    State.PerfectShotStyle.Applying[Object] = true
                    State.Lifecycle:Defer(function()
                        pcall(State.PerfectShotStyle.ApplyObject, Object)

                        State.Lifecycle:Defer(function() State.PerfectShotStyle.Applying[Object] = nil end)
                    end)
                end
            end)
        end)
    end
    local Sequence = State.PerfectShotStyle.Sequence()
    local Color = State.PerfectShotStyle.Color()
    State.PerfectShotStyle.Applying[Object] = true
    pcall(function()
        if IsSequence then
            if Object.Color ~= Sequence then Object.Color = Sequence end
        elseif IsLight then
            if Object.Color ~= Color then Object.Color = Color end
        elseif IsHighlight then
            if Object.FillColor ~= Color then Object.FillColor = Color end
            if Object.OutlineColor ~= Color then Object.OutlineColor = Color end
        end
    end)
    State.Lifecycle:Defer(function() State.PerfectShotStyle.Applying[Object] = nil end)
end

function State.PerfectShotStyle.ApplyEffects()
    local Effects = Workspace:FindFirstChild('Effects')
    if Effects then
        for _, Object in ipairs(Effects:GetDescendants()) do
            State.PerfectShotStyle.ApplyObject(Object)
        end
    end
    State.PerfectShotStyle.ApplyText()
end

function State.PerfectShotStyle.Trigger(Position)
    State.PerfectShotStyle.ClearWatches()
    State.PerfectShotStyle.Generation += 1
    local Generation = State.PerfectShotStyle.Generation
    State.PerfectShotStyle.Origin = typeof(Position) == 'Vector3' and Position or nil
    State.PerfectShotStyle.ActiveUntil = os.clock() + 2.4
    State.PerfectShotStyle.LastScanAt = 0
    State.PerfectShotStyle.LastLockAt = 0
    for _, Delay in ipairs({ 0, 0.03, 0.12, 0.3, 0.65, 1.1, 1.7 }) do
        State.Lifecycle:Delay(Delay, function()
            if Generation == State.PerfectShotStyle.Generation
                and os.clock() <= State.PerfectShotStyle.ActiveUntil then
                pcall(State.PerfectShotStyle.ApplyEffects)
            end
        end)
    end
    State.Lifecycle:Delay(2.55, function()
        if Generation == State.PerfectShotStyle.Generation then State.PerfectShotStyle.ClearWatches() end
    end)
end

pcall(function()
    GiveSignal(Workspace.DescendantAdded:Connect(function(Object)
        if os.clock() <= State.PerfectShotStyle.ActiveUntil then
            State.Lifecycle:Defer(function() pcall(State.PerfectShotStyle.ApplyObject, Object) end)
        end
    end))

    GiveSignal(RunService.RenderStepped:Connect(function()
        local Now = os.clock()
        if Now > State.PerfectShotStyle.ActiveUntil then return end
        if Now - State.PerfectShotStyle.LastLockAt >= (1 / 30) then
            State.PerfectShotStyle.LastLockAt = Now
            for Object in pairs(State.PerfectShotStyle.Objects) do
                pcall(State.PerfectShotStyle.ApplyObject, Object)
            end
        end
        if Now - State.PerfectShotStyle.LastScanAt >= 0.2 then
            State.PerfectShotStyle.LastScanAt = Now
            pcall(State.PerfectShotStyle.ApplyEffects)
        end
    end))
end)

State.BallStudio = {
    Tag = 'GoldenEagleBallStudio',
    Tracked = nil,
    Holding = false,
    FlightUntil = 0,
    LastTintAt = 0,
    LastUpdateAt = 0,
    LastProxyVerifyAt = 0,
    OriginalColor = setmetatable({}, { __mode = 'k' }),
    OriginalFade = setmetatable({}, { __mode = 'k' }),
    TakenOver = setmetatable({}, { __mode = 'k' }),
    SkinWatch = nil,
    LastSkinAt = 0,
    TextureCache = {},
    CatalogCache = {},
    Proxies = setmetatable({}, { __mode = 'k' }),
    Hidden = setmetatable({}, { __mode = 'k' }),
}

function State.BallStudio.Shade(RedKey, GreenKey, BlueKey)
    return Color3.fromRGB(
        math.clamp(math.floor(tonumber(CONFIG[RedKey]) or 255), 0, 255),
        math.clamp(math.floor(tonumber(CONFIG[GreenKey]) or 255), 0, 255),
        math.clamp(math.floor(tonumber(CONFIG[BlueKey]) or 255), 0, 255))
end

function State.BallStudio.Asset(Value)
    local Id = math.floor(tonumber(Value) or 0)
    if Id <= 0 then return nil end
    return 'rbxassetid://' .. tostring(Id)
end

function State.BallStudio.ResolveTexture(Value)
    local Number = math.max(0, math.floor(tonumber(Value) or 0))
    if Number <= 0 then return nil end
    local Cached = State.BallStudio.TextureCache[Number]
    if Cached ~= nil then return Cached ~= false and Cached or nil end
    local Direct = 'rbxassetid://' .. tostring(Number)
    local Resolved = Direct
    local Ok, Objects = pcall(game.GetObjects, game, Direct)
    if Ok and type(Objects) == 'table' then
        for _, Root in ipairs(Objects) do
            local Candidates = { Root }
            for _, Object in ipairs(Root:GetDescendants()) do Candidates[#Candidates + 1] = Object end
            for _, Object in ipairs(Candidates) do
                local Content
                if Object:IsA('Decal') or Object:IsA('Texture') then
                    Content = Object.Texture
                elseif Object:IsA('ImageLabel') or Object:IsA('ImageButton') then
                    Content = Object.Image
                elseif Object:IsA('SpecialMesh') then
                    Content = Object.TextureId
                elseif Object:IsA('MeshPart') then
                    Content = Object.TextureID
                end
                if type(Content) == 'string' and Content ~= '' then
                    Resolved = Content
                    break
                end
            end
            pcall(function() Root:Destroy() end)
            if Resolved ~= Direct then break end
        end
    end
    State.BallStudio.TextureCache[Number] = Resolved or false
    return Resolved
end

function State.BallStudio.Purge(Ball, Kind)
    if not Ball then return end
    local Objects = Ball:GetDescendants()
    for Index = #Objects, 1, -1 do
        local Object = Objects[Index]
        local Mark = Object:GetAttribute(State.BallStudio.Tag)
        if Mark ~= nil and (Kind == nil or Mark == Kind) then
            pcall(function() Object:Destroy() end)
        end
    end
end

function State.BallStudio.HardUnequip(Ball, Category)
    if not Ball then return end
    pcall(function() Ball:SetAttribute(Category, nil) end)
    pcall(State.ClearBallCosmeticObjects, Ball, Category)
    local Objects = Ball:GetDescendants()
    for Index = #Objects, 1, -1 do
        local Object = Objects[Index]
        if Object:GetAttribute(State.BallStudio.Tag) == nil then
            local Owner = Object
            local Matches = false
            while Owner and Owner ~= Ball do
                if Owner:GetAttribute(Category) ~= nil then
                    Matches = true
                    break
                end
                Owner = Owner.Parent
            end
            if Matches then pcall(function() Object:Destroy() end) end
        end
    end
end

function State.BallStudio.StripBodyAura(Character)
    Character = Character or LP.Character
    if not Character then return end
    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:GetAttribute('Takeover') ~= nil
            or Object:GetAttribute('GoldenEagleLocalAura') ~= nil then
            if Object:IsA('ParticleEmitter') or Object:IsA('Trail')
                or Object:IsA('Beam') or Object:IsA('PointLight')
                or Object:IsA('SpotLight') or Object:IsA('SurfaceLight') then
                pcall(function() Object.Enabled = false end)
            end
        end
    end
end

function State.BallStudio.EnsureTrail(Ball)
    if not (Ball and Ball:IsA('BasePart')) then return nil end
    local Existing = Ball:FindFirstChild('GoldenEagleTrail')
    if Existing and Existing:IsA('Trail') then return Existing end
    local Made
    pcall(function()
        local Radius = math.max(Ball.Size.X, Ball.Size.Y, Ball.Size.Z) * 0.5
        local Top = Instance.new('Attachment')
        Top.Name = 'GoldenEagleTrailA0'
        Top.Position = Vector3.new(0, Radius * 0.8, 0)
        Top:SetAttribute(State.BallStudio.Tag, 'Trail')
        Top.Parent = Ball
        local Bottom = Instance.new('Attachment')
        Bottom.Name = 'GoldenEagleTrailA1'
        Bottom.Position = Vector3.new(0, -Radius * 0.8, 0)
        Bottom:SetAttribute(State.BallStudio.Tag, 'Trail')
        Bottom.Parent = Ball
        local Trail = Instance.new('Trail')
        Trail.Name = 'GoldenEagleTrail'
        Trail.Attachment0 = Top
        Trail.Attachment1 = Bottom
        Trail.Enabled = false
        Trail:SetAttribute(State.BallStudio.Tag, 'Trail')
        Trail.Parent = Ball
        Made = Trail
    end)
    return Made
end

function State.BallStudio.StyleTrail(Trail)
    if not Trail then return end
    pcall(function()
        Trail.Color = ColorSequence.new(
            State.BallStudio.Shade('BallTrailStartR', 'BallTrailStartG', 'BallTrailStartB'),
            State.BallStudio.Shade('BallTrailEndR', 'BallTrailEndG', 'BallTrailEndB'))
        local Fade = math.clamp(tonumber(CONFIG.BallTrailFade) or 0.15, 0, 0.99)
        Trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, Fade),
            NumberSequenceKeypoint.new(1, 1),
        })
        Trail.Lifetime = math.clamp(tonumber(CONFIG.BallTrailLifetime) or 0.55, 0.05, 8)
        Trail.WidthScale = NumberSequence.new(
            math.clamp(tonumber(CONFIG.BallTrailWidth) or 1.7, 0.1, 12))
        Trail.MinLength = 0
        Trail.FaceCamera = true
        Trail.LightEmission = 0.45
        local Texture = State.BallStudio.ResolveTexture(CONFIG.BallTrailTextureId)
        Trail.Texture = Texture or ''

        Trail.TextureMode = Enum.TextureMode.Stretch
        Trail.TextureLength = math.max(0.01, Trail.Lifetime)
        if Texture then
            State.Lifecycle:Defer(function()
                if not Trail.Parent then return end
                pcall(function()
                    game:GetService('ContentProvider'):PreloadAsync({ Trail })
                end)
            end)
        end
    end)
end

function State.BallStudio.StripGameSkin(Ball)
    if not Ball then return end
    for _, Child in ipairs(Ball:GetChildren()) do
        if Child:GetAttribute('Ball') ~= nil
            and Child:GetAttribute(State.BallStudio.Tag) == nil then
            pcall(function() Child:Destroy() end)
        end
    end
end

function State.BallStudio.RestoreGameSkin(Ball)
    if not (Ball and State.BallStudio.TakenOver[Ball]) then return end
    State.BallStudio.TakenOver[Ball] = nil
    if State.Cosmetics.Replicator and State.Cosmetics.Replicator.ReplicateBall then
        pcall(function()
            State.Cosmetics.Replicator.ReplicateBall(Ball, Ball:GetAttribute('Ball') or 'Ball_Default')
        end)
    end
end

function State.BallStudio.WatchBall(Ball)
    if State.BallStudio.SkinWatch then
        pcall(function() State.Lifecycle:DisconnectConnection(State.BallStudio.SkinWatch) end)
        State.BallStudio.SkinWatch = nil
    end
    if not Ball then return end
    State.BallStudio.SkinWatch = State.Lifecycle:Connect(Ball.ChildAdded, function(Child)
        if not (CONFIG.BallStudioEnabled and CONFIG.CustomBallEnabled) then return end
        if Child:GetAttribute(State.BallStudio.Tag) ~= nil then return end
        State.Lifecycle:Defer(function()
            if Child.Parent == Ball and Child:GetAttribute('Ball') ~= nil then
                pcall(function() Child:Destroy() end)
            end
        end)
    end)
end

function State.BallStudio.Targets()
    local Found, Seen = {}, {}
    local function Add(Part)
        if Part and Part:IsA('BasePart') and not Seen[Part] then
            Seen[Part] = true
            Found[#Found + 1] = Part
        end
    end
    Add(GetLocalBallHandle())
    local Character = LP.Character
    local Basketball = Character and Character:FindFirstChild('Basketball')
    if Basketball then
        Add(Basketball:FindFirstChild('Ball'))
        for _, Object in ipairs(Basketball:GetDescendants()) do
            if Object:IsA('BasePart') and Object:GetAttribute(State.BallStudio.Tag) == nil then
                Add(Object)
            end
        end
    end
    return Found
end

function State.BallStudio.EnsureProxy(Ball)
    local Proxy = State.BallStudio.Proxies[Ball]
    if Proxy and Proxy.Parent then return Proxy end
    Proxy = nil
    pcall(function()
        Proxy = Instance.new('Part')
        Proxy.Name = 'GoldenEagleBallSkin'
        Proxy.Shape = Enum.PartType.Ball
        Proxy.Anchored = true
        Proxy.CanCollide = false
        Proxy.CanQuery = false
        Proxy.CanTouch = false
        Proxy.Massless = true
        Proxy.CastShadow = false
        Proxy.Material = Enum.Material.SmoothPlastic
        Proxy.Size = Ball.Size
        Proxy.CFrame = Ball.CFrame
        Proxy:SetAttribute(State.BallStudio.Tag, 'Skin')
        Proxy.Parent = Ball
    end)
    State.BallStudio.Proxies[Ball] = Proxy
    return Proxy
end

function State.BallStudio.DropProxy(Ball)
    local Proxy = State.BallStudio.Proxies[Ball]
    State.BallStudio.Proxies[Ball] = nil
    if Proxy then pcall(function() Proxy:Destroy() end) end
    if State.BallStudio.Hidden[Ball] then
        State.BallStudio.Hidden[Ball] = nil
        local Fade = State.BallStudio.OriginalFade[Ball]
        pcall(function() Ball.LocalTransparencyModifier = 0 end)
        pcall(function() Ball.Transparency = Fade or 0 end)
    end
end

function State.BallStudio.HideStock(Ball, Hide)
    if Hide then
        if State.BallStudio.OriginalFade[Ball] == nil then
            State.BallStudio.OriginalFade[Ball] = Ball.Transparency
        end
        State.BallStudio.Hidden[Ball] = true
        if Ball.Transparency < 1 then pcall(function() Ball.Transparency = 1 end) end
    elseif State.BallStudio.Hidden[Ball] then
        State.BallStudio.Hidden[Ball] = nil
        local Fade = State.BallStudio.OriginalFade[Ball]
        pcall(function() Ball.Transparency = Fade or 0 end)
    end
end

function State.BallStudio.LoadCatalogItem(Value)
    local Id = math.max(0, math.floor(tonumber(Value) or 0))
    if Id <= 0 then return nil end
    local Cached = State.BallStudio.CatalogCache[Id]
    if Cached == false then return nil end
    if typeof(Cached) == 'Instance' then
        local Ok, Copy = pcall(function() return Cached:Clone() end)
        return Ok and Copy or nil
    end
    local Direct = 'rbxassetid://' .. tostring(Id)
    local Ok, Objects = pcall(game.GetObjects, game, Direct)
    if not (Ok and type(Objects) == 'table' and Objects[1]) then
        State.BallStudio.CatalogCache[Id] = false
        return nil
    end
    local Template = Objects[1]
    for Index = 2, #Objects do pcall(function() Objects[Index]:Destroy() end) end
    for _, Object in ipairs(Template:GetDescendants()) do
        if Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
            or Object:IsA('JointInstance') or Object:IsA('WeldConstraint') then
            pcall(function() Object:Destroy() end)
        end
    end
    State.BallStudio.CatalogCache[Id] = Template
    local CloneOk, Copy = pcall(function() return Template:Clone() end)
    return CloneOk and Copy or nil
end

function State.BallStudio.MountCatalogItem(Ball, Proxy, Value, Scale, Tint)
    local Item = State.BallStudio.LoadCatalogItem(Value)
    if not Item then return false end
    local Container = Instance.new('Model')
    Container.Name = 'GoldenEagleCatalogBall'
    Container:SetAttribute(State.BallStudio.Tag, 'Skin')
    Item.Parent = Container
    Container.Parent = Proxy
    local Parts = {}
    for _, Object in ipairs(Container:GetDescendants()) do
        if Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
            or Object:IsA('JointInstance') or Object:IsA('WeldConstraint') then
            pcall(function() Object:Destroy() end)
        elseif Object:IsA('BasePart') then
            Parts[#Parts + 1] = Object
            Object.Anchored = true
            Object.CanCollide = false
            Object.CanQuery = false
            Object.CanTouch = false
            Object.Massless = true
            Object.CastShadow = false
            if Tint then
                Object.Color = Tint
                if Object:IsA('MeshPart') then pcall(function() Object.UsePartColor = true end) end
            end
        elseif Tint and (Object:IsA('Decal') or Object:IsA('Texture')) then
            Object.Color3 = Tint
        elseif Tint and Object:IsA('SpecialMesh') then
            Object.VertexColor = Vector3.new(Tint.R, Tint.G, Tint.B)
        end
    end
    if #Parts == 0 then Container:Destroy();
        return false end
    local _, InitialSize = Container:GetBoundingBox()
    local Largest = math.max(InitialSize.X, InitialSize.Y, InitialSize.Z)
    if Largest <= 0.0001 then Container:Destroy();
        return false end
    local Diameter = math.max(Ball.Size.X, Ball.Size.Y, Ball.Size.Z)
    local Factor = (Diameter * Scale) / Largest
    local ScaleOk = pcall(function() Container:ScaleTo(Factor) end)
    if not ScaleOk then Container:Destroy();
        return false end
    local BoxCFrame = Container:GetBoundingBox()
    local Shift = Proxy.CFrame * BoxCFrame:Inverse()
    Container:PivotTo(Shift * Container:GetPivot())
    for _, Part in ipairs(Parts) do
        Part.Anchored = false
        local Weld = Instance.new('WeldConstraint')
        Weld.Name = 'GoldenEagleCatalogWeld'
        Weld.Part0 = Proxy
        Weld.Part1 = Part
        Weld:SetAttribute(State.BallStudio.Tag, 'Skin')
        Weld.Parent = Part
    end
    return true
end

function State.BallStudio.ApplyBall(Ball)
    if not (Ball and Ball:IsA('BasePart') and Ball.Parent) then return end
    if State.BallStudio.OriginalColor[Ball] == nil then
        State.BallStudio.OriginalColor[Ball] = Ball.Color
        State.BallStudio.OriginalFade[Ball] = Ball.Transparency
    end
    if not (CONFIG.BallStudioEnabled and CONFIG.CustomBallEnabled) then
        State.BallStudio.Purge(Ball, 'Skin')
        State.BallStudio.DropProxy(Ball)
        local Color = State.BallStudio.OriginalColor[Ball]
        pcall(function() if Color then Ball.Color = Color end end)
        State.BallStudio.RestoreGameSkin(Ball)
        return
    end
    local Catalog = math.max(0, math.floor(tonumber(CONFIG.CustomBallCatalogId) or 0))
    local Skin = State.BallStudio.Asset(CONFIG.CustomBallDecalId)
    local Model = State.BallStudio.Asset(CONFIG.CustomBallMeshId)
    local Texture = State.BallStudio.Asset(CONFIG.CustomBallMeshTextureId)
    if Catalog <= 0 and not (Skin or Model) then

        State.BallStudio.Purge(Ball, 'Skin')
        State.BallStudio.DropProxy(Ball)
        return
    end
    local Tint = nil
    if CONFIG.CustomBallTint then
        Tint = State.BallStudio.Shade('CustomBallR', 'CustomBallG', 'CustomBallB')
    end
    local Scale = math.clamp(tonumber(CONFIG.CustomBallScale) or 1, 0.001, 5)
    State.BallStudio.StripGameSkin(Ball)
    State.BallStudio.TakenOver[Ball] = true
    State.BallStudio.HideStock(Ball, true)
    local Proxy = State.BallStudio.EnsureProxy(Ball)
    if not Proxy then

        State.BallStudio.HideStock(Ball, false)
        State.BallStudio.RestoreGameSkin(Ball)
        return
    end
    local Stamp = tostring(Catalog) .. '|' .. tostring(Model or '') .. '|' .. tostring(Skin or '') .. '|'
    .. tostring(Texture or '') .. '|' .. tostring(Scale) .. '|'
    .. tostring(Tint and Tint:ToHex() or 'none')
    if Proxy:GetAttribute('GoldenEagleStamp') == Stamp then return end
    Proxy:SetAttribute('GoldenEagleStamp', Stamp)
    for _, Child in ipairs(Proxy:GetChildren()) do
        pcall(function() Child:Destroy() end)
    end
    if Catalog > 0 then
        Proxy.Transparency = 1
        Proxy.Size = Ball.Size
        if State.BallStudio.MountCatalogItem(Ball, Proxy, Catalog, Scale, Tint) then return end
    end
    if Model then

        pcall(function()
            Proxy.Transparency = 1
            Proxy.Size = Ball.Size
            local Visual = Instance.new('MeshPart')
            Visual.Name = 'GoldenEagleBallMesh'
            Visual.MeshId = Model
            Visual.TextureID = Texture or Skin or ''
            local AppliedTint = Tint or Color3.fromRGB(255, 255, 255)
            Visual:SetAttribute('GoldenEagleFitScale', Scale)
            Visual:SetAttribute('GoldenEagleTextureId', Texture or Skin or '')
            Visual:SetAttribute('GoldenEagleTintR', AppliedTint.R)
            Visual:SetAttribute('GoldenEagleTintG', AppliedTint.G)
            Visual:SetAttribute('GoldenEagleTintB', AppliedTint.B)
            Visual.Size = Ball.Size * Scale
            Visual.CFrame = Proxy.CFrame
            Visual.Color = AppliedTint

            pcall(function() Visual.UsePartColor = true end)
            Visual.Transparency = 0
            Visual.Material = Enum.Material.SmoothPlastic
            Visual.Anchored = false
            Visual.CanCollide = false
            Visual.CanQuery = false
            Visual.CanTouch = false
            Visual.Massless = true
            Visual.CastShadow = false
            Visual:SetAttribute(State.BallStudio.Tag, 'Skin')
            Visual.Parent = Proxy
            local Weld = Instance.new('WeldConstraint')
            Weld.Name = 'GoldenEagleBallMeshWeld'
            Weld.Part0 = Proxy
            Weld.Part1 = Visual
            Weld:SetAttribute(State.BallStudio.Tag, 'Skin')
            Weld.Parent = Proxy
        end)
        return
    end

    pcall(function()
        Proxy.Shape = Enum.PartType.Ball
        Proxy.Size = Ball.Size * Scale
        Proxy.Transparency = 0
        Proxy.Color = Tint or Color3.fromRGB(255, 255, 255)
        local Wrap = Instance.new('SpecialMesh')
        Wrap.Name = 'GoldenEagleBallDecal'
        Wrap.MeshType = Enum.MeshType.Sphere
        Wrap.TextureId = Skin
        Wrap.Scale = Vector3.new(1, 1, 1)
        if Tint then
            Wrap.VertexColor = Vector3.new(Tint.R, Tint.G, Tint.B)
        else
            Wrap.VertexColor = Vector3.new(1, 1, 1)
        end
        Wrap:SetAttribute(State.BallStudio.Tag, 'Skin')
        Wrap.Parent = Proxy
    end)
end

function State.BallStudio.SyncProxies(VerifyAppearance)
    for Ball, Proxy in pairs(State.BallStudio.Proxies) do
        if not (Ball and Ball.Parent and Proxy and Proxy.Parent) then
            State.BallStudio.Proxies[Ball] = nil
            if Proxy then pcall(function() Proxy:Destroy() end) end
        else
            pcall(function()
                Proxy.CFrame = Ball.CFrame
                if VerifyAppearance == false then return end
                local Visual = Proxy:FindFirstChild('GoldenEagleBallMesh')
                if Visual and Visual:IsA('MeshPart') then

                    local FitScale = math.clamp(tonumber(Visual:GetAttribute('GoldenEagleFitScale')) or 1, 0.001, 5)
                    local WantedSize = Ball.Size * FitScale
                    if (Visual.Size - WantedSize).Magnitude > 0.001 then
                        Visual.Size = WantedSize
                    end

                    local WantedTexture = Visual:GetAttribute('GoldenEagleTextureId') or ''
                    if Visual.TextureID ~= WantedTexture then Visual.TextureID = WantedTexture end
                    local TintR = math.clamp(tonumber(Visual:GetAttribute('GoldenEagleTintR')) or 1, 0, 1)
                    local TintG = math.clamp(tonumber(Visual:GetAttribute('GoldenEagleTintG')) or 1, 0, 1)
                    local TintB = math.clamp(tonumber(Visual:GetAttribute('GoldenEagleTintB')) or 1, 0, 1)
                    local WantedTint = Color3.new(TintR, TintG, TintB)
                    if Visual.Color ~= WantedTint then Visual.Color = WantedTint end
                    pcall(function() Visual.UsePartColor = true end)
                end
            end)
        end
    end
end

function State.BallStudio.PlayShotSound(Ball, Force)
    if not Force and not (CONFIG.BallStudioEnabled and CONFIG.ShotSoundEnabled) then return end
    local Id = State.BallStudio.Asset(CONFIG.ShotSoundId)
    if not Id then return end
    pcall(function()
        local Sound = State.Lifecycle:OwnInstance(Instance.new('Sound'))
        Sound.Name = 'GoldenEagleShotSound'
        Sound.SoundId = Id
        Sound.Volume = math.clamp(tonumber(CONFIG.ShotSoundVolume) or 1.2, 0, 10)
        Sound.PlaybackSpeed = math.clamp(tonumber(CONFIG.ShotSoundPitch) or 1, 0.25, 4)
        Sound.RollOffMode = Enum.RollOffMode.Inverse
        Sound.RollOffMinDistance = 30
        Sound.RollOffMaxDistance = 1200
        Sound.Looped = false
        Sound:SetAttribute(State.BallStudio.Tag, 'Sound')
        Sound.Parent = game:GetService('SoundService')
        local Duration = math.clamp(tonumber(CONFIG.ShotSoundDuration) or 0, 0, 120)
        Sound.Ended:Once(function()
            if Sound.Parent then pcall(function() Sound:Destroy() end) end
        end)
        Sound.Played:Once(function()
            if Duration <= 0 then return end
            State.Lifecycle:Delay(Duration, function()
                if Sound.Parent then
                    pcall(function() Sound:Stop() end)
                    pcall(function() Sound:Destroy() end)
                end
            end)
        end)
        if not Sound.IsLoaded then
            Sound.Loaded:Once(function()
                if Sound.Parent and not Sound.IsPlaying then Sound:Play() end
            end)
        end
        Sound:Play()
        game:GetService('Debris'):AddItem(Sound, math.max(30, Duration + 5))
    end)
end

function State.BallStudio.IsCosmetic(Object)
    local Owner = Object
    while Owner and Owner ~= game do
        if Owner:GetAttribute('Aura') ~= nil or Owner:GetAttribute('Trail') ~= nil
            or Owner:GetAttribute('Ball') ~= nil or Owner:GetAttribute('Takeover') ~= nil
            or Owner:GetAttribute('GoldenEagleLocalAura') ~= nil then
            return true
        end
        Owner = Owner.Parent
    end
    return false
end

function State.BallStudio.TintObject(Object, Tint)
    if Object:IsA('ParticleEmitter') or Object:IsA('Trail') or Object:IsA('Beam') then
        Object.Color = ColorSequence.new(Tint)
    elseif Object:IsA('PointLight') or Object:IsA('SpotLight')
        or Object:IsA('SurfaceLight') then
        Object.Color = Tint
    elseif Object:IsA('Decal') or Object:IsA('Texture') then
        Object.Color3 = Tint
    elseif Object:IsA('BasePart') then
        Object.Color = Tint
    end
end

function State.BallStudio.TintCosmetics()
    if not (CONFIG.BallStudioEnabled and CONFIG.CosmeticTintEnabled) then return end
    local Tint = State.BallStudio.Shade('CosmeticTintR', 'CosmeticTintG', 'CosmeticTintB')
    local Ball = GetLocalBallHandle()
    local Character = LP.Character
    for _, Root in ipairs({ Character, Ball }) do
        if Root then
            for _, Object in ipairs(Root:GetDescendants()) do
                if Object ~= Ball and Object:GetAttribute(State.BallStudio.Tag) == nil
                    and State.BallStudio.IsCosmetic(Object) then
                    pcall(State.BallStudio.TintObject, Object, Tint)
                end
            end
        end
    end
end

function State.BallStudio.Refresh()
    local Ball = GetLocalBallHandle()
    if Ball then
        State.BallStudio.WatchBall(Ball)
        State.BallStudio.StyleTrail(State.BallStudio.EnsureTrail(Ball))
    end
    for _, Part in ipairs(State.BallStudio.Targets()) do
        State.BallStudio.ApplyBall(Part)
    end
    State.BallStudio.SyncProxies()
    State.BallStudio.LastTintAt = 0
    State.BallStudio.LastSkinAt = 0
end

function State.BallStudio.Cleanup()
    local Ball = State.BallStudio.Tracked or GetLocalBallHandle()
    if State.BallStudio.SkinWatch then
        pcall(function() State.Lifecycle:DisconnectConnection(State.BallStudio.SkinWatch) end)
        State.BallStudio.SkinWatch = nil
    end
    for Part in pairs(State.BallStudio.Proxies) do
        State.BallStudio.DropProxy(Part)
    end
    if Ball then
        State.BallStudio.Purge(Ball)
        State.BallStudio.RestoreGameSkin(Ball)
    end
    for Part in pairs(State.BallStudio.Hidden) do
        State.BallStudio.HideStock(Part, false)
    end
    for Part, Original in pairs(State.BallStudio.OriginalColor) do
        if Part and Part.Parent then
            pcall(function()
                Part.Color = Original
                local Fade = State.BallStudio.OriginalFade[Part]
                if Fade then Part.Transparency = Fade end
            end)
        end
        State.BallStudio.OriginalColor[Part] = nil
    end
    State.BallStudio.Tracked = nil
end

function State.BallStudio.Update()
    if not CONFIG.BallStudioEnabled then return end
    local Ball = GetLocalBallHandle()
    local Character = LP.Character
    local Holding = (Character and Character:FindFirstChild('Basketball')) ~= nil
    if Ball and Ball ~= State.BallStudio.Tracked then
        State.BallStudio.Tracked = Ball
        State.BallStudio.WatchBall(Ball)
        State.BallStudio.StyleTrail(State.BallStudio.EnsureTrail(Ball))
        State.BallStudio.LastSkinAt = 0
    end
    local Now = os.clock()
    if State.BallStudio.Holding and not Holding then
        State.BallStudio.FlightUntil = Now
        + math.clamp(tonumber(CONFIG.BallTrailDuration) or 4, 0.2, 20)
        State.BallStudio.PlayShotSound(Ball)
    end
    State.BallStudio.Holding = Holding
    if CONFIG.CustomBallEnabled and Now - State.BallStudio.LastSkinAt >= 0.25 then
        State.BallStudio.LastSkinAt = Now
        for _, Part in ipairs(State.BallStudio.Targets()) do
            State.BallStudio.ApplyBall(Part)
        end
    elseif not CONFIG.CustomBallEnabled and next(State.BallStudio.Proxies) ~= nil then
        for Part in pairs(State.BallStudio.Proxies) do
            State.BallStudio.DropProxy(Part)
        end
    end
    if Ball then
        local Trail = Ball:FindFirstChild('GoldenEagleTrail')
        if Trail and Trail:IsA('Trail') then
            local Speed = Ball.AssemblyLinearVelocity.Magnitude
            local ShouldShow = CONFIG.BallFlightTrail == true
                and not Holding
                and Now < State.BallStudio.FlightUntil
                and Speed >= math.max(0, tonumber(CONFIG.BallTrailMinSpeed) or 8)
            if ShouldShow ~= Trail.Enabled then
                if ShouldShow then State.BallStudio.StyleTrail(Trail) end
                Trail.Enabled = ShouldShow
            end
        end
    end
    if Now - State.BallStudio.LastTintAt >= 0.35 then
        State.BallStudio.LastTintAt = Now
        pcall(State.BallStudio.TintCosmetics)
    end
end

State.CosmeticStudio = {
    Tag = 'GoldenEagleCosmeticStudio',
    LastUpdateAt = 0,
    LastBodyStamp = '',
    LastBallStamp = '',
    LastTrailStamp = '',
    LastCourtStamp = '',
    TrackedCharacter = nil,
    TrackedBall = nil,
    CourtParts = {},
}

function State.CosmeticStudio.Clear(Root, Kind)
    if not Root then return end
    local Objects = Root:GetDescendants()
    for Index = #Objects, 1, -1 do
        local Object = Objects[Index]
        local Mark = Object:GetAttribute(State.CosmeticStudio.Tag)
        if Mark ~= nil and (Kind == nil or Mark == Kind) then
            pcall(function() Object:Destroy() end)
        end
    end
end

function State.CosmeticStudio.TintInstance(Object, Tint)
    if not (Object and Tint) then return end
    if Object:IsA('ParticleEmitter') or Object:IsA('Trail') or Object:IsA('Beam') then
        Object.Color = ColorSequence.new(Tint)
    elseif Object:IsA('PointLight') or Object:IsA('SpotLight') or Object:IsA('SurfaceLight') then
        Object.Color = Tint
    elseif Object:IsA('Decal') or Object:IsA('Texture') then
        Object.Color3 = Tint
    elseif Object:IsA('BasePart') then
        Object.Color = Tint
        if Object:IsA('MeshPart') then pcall(function() Object.UsePartColor = true end) end
    elseif Object:IsA('SpecialMesh') then
        Object.VertexColor = Vector3.new(Tint.R, Tint.G, Tint.B)
    end
end

function State.CosmeticStudio.MountCatalog(Parent, Kind, CatalogId, Scale, Tint)
    if not (Parent and Parent.Parent) then return false end
    local Id = math.max(0, math.floor(tonumber(CatalogId) or 0))
    if Id <= 0 then return false end
    local Item = State.BallStudio.LoadCatalogItem(Id)
    if not Item then return false end
    local Container = Instance.new('Model')
    Container.Name = 'GoldenEagleCustom' .. Kind
    Container:SetAttribute(State.CosmeticStudio.Tag, Kind)
    Item.Parent = Container
    Container.Parent = Parent
    local Parts = {}
    for _, Object in ipairs(Container:GetDescendants()) do
        if Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
            or Object:IsA('JointInstance') or Object:IsA('WeldConstraint') then
            pcall(function() Object:Destroy() end)
        elseif Object:IsA('BasePart') then
            Parts[#Parts + 1] = Object
            Object.Anchored = true
            Object.CanCollide = false
            Object.CanQuery = false
            Object.CanTouch = false
            Object.Massless = true
            Object.CastShadow = false
            State.CosmeticStudio.TintInstance(Object, Tint)
        elseif Tint then
            State.CosmeticStudio.TintInstance(Object, Tint)
        end
        Object:SetAttribute(State.CosmeticStudio.Tag, Kind)
    end
    if #Parts == 0 then

        return true
    end
    local _, Size = Container:GetBoundingBox()
    local Largest = math.max(Size.X, Size.Y, Size.Z)
    if Largest > 0.0001 then
        local Target = math.max(Parent.Size.X, Parent.Size.Y, Parent.Size.Z) * math.clamp(tonumber(Scale) or 1, 0.05, 8)
        pcall(function() Container:ScaleTo(Target / Largest) end)
    end
    local BoxCFrame = Container:GetBoundingBox()
    local Shift = Parent.CFrame * BoxCFrame:Inverse()
    Container:PivotTo(Shift * Container:GetPivot())
    for _, Part in ipairs(Parts) do
        Part.Anchored = false
        local Weld = Instance.new('WeldConstraint')
        Weld.Name = 'GoldenEagleCosmeticWeld'
        Weld.Part0 = Parent
        Weld.Part1 = Part
        Weld:SetAttribute(State.CosmeticStudio.Tag, Kind)
        Weld.Parent = Part
    end
    return true
end

function State.CosmeticStudio.ApplyBodyAura(Character)
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    if not Root then return end
    local Enabled = CONFIG.CosmeticStudioEnabled == true and CONFIG.CustomBodyAuraEnabled == true
    local Id = math.max(0, math.floor(tonumber(CONFIG.CustomBodyAuraCatalogId) or 0))
    local Scale = math.clamp(tonumber(CONFIG.CustomBodyAuraScale) or 1, 0.05, 8)
    local Tint = CONFIG.CustomBodyAuraTint and State.BallStudio.Shade(
        'CustomBodyAuraR', 'CustomBodyAuraG', 'CustomBodyAuraB') or nil
    local Stamp = table.concat({
        Enabled and '1' or '0', tostring(Id), tostring(Scale),
        Tint and Tint:ToHex() or 'none', tostring(Character),
        }, '|')
    if Stamp == State.CosmeticStudio.LastBodyStamp then return end
    State.CosmeticStudio.Clear(Character, 'BodyAura')
    State.CosmeticStudio.LastBodyStamp = Stamp
    State.CosmeticStudio.TrackedCharacter = Character
    if Enabled and Id > 0 then
        State.CosmeticStudio.MountCatalog(Root, 'BodyAura', Id, Scale, Tint)
    end
end

function State.CosmeticStudio.ApplyBallAura(Ball)
    if not (Ball and Ball:IsA('BasePart')) then return end
    local Enabled = CONFIG.CosmeticStudioEnabled == true and CONFIG.CustomBallAuraEnabled == true
    local Id = math.max(0, math.floor(tonumber(CONFIG.CustomBallAuraCatalogId) or 0))
    local Scale = math.clamp(tonumber(CONFIG.CustomBallAuraScale) or 1, 0.05, 8)
    local Tint = CONFIG.CustomBallAuraTint and State.BallStudio.Shade(
        'CustomBallAuraR', 'CustomBallAuraG', 'CustomBallAuraB') or nil
    local Stamp = table.concat({
        Enabled and '1' or '0', tostring(Id), tostring(Scale),
        Tint and Tint:ToHex() or 'none', tostring(Ball),
        }, '|')
    if Stamp == State.CosmeticStudio.LastBallStamp then return end
    State.CosmeticStudio.Clear(Ball, 'BallAura')
    State.CosmeticStudio.LastBallStamp = Stamp
    State.CosmeticStudio.TrackedBall = Ball
    if Enabled and Id > 0 then
        State.CosmeticStudio.MountCatalog(Ball, 'BallAura', Id, Scale, Tint)
    end
end

function State.CosmeticStudio.ApplyBodyTrail(Character)
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    if not Root then return end
    local Enabled = CONFIG.CosmeticStudioEnabled == true and CONFIG.CustomBodyTrailEnabled == true
    local TextureId = math.max(0, math.floor(tonumber(CONFIG.CustomBodyTrailTextureId) or 0))
    local Width = math.clamp(tonumber(CONFIG.CustomBodyTrailWidth) or 1.4, 0.1, 12)
    local Life = math.clamp(tonumber(CONFIG.CustomBodyTrailLifetime) or 0.45, 0.05, 8)
    local Start = State.BallStudio.Shade('CustomBodyTrailStartR', 'CustomBodyTrailStartG', 'CustomBodyTrailStartB')
    local Finish = State.BallStudio.Shade('CustomBodyTrailEndR', 'CustomBodyTrailEndG', 'CustomBodyTrailEndB')
    local Stamp = table.concat({
        Enabled and '1' or '0', tostring(TextureId), tostring(Width), tostring(Life),
        Start:ToHex(), Finish:ToHex(), tostring(Character),
        }, '|')
    if Stamp == State.CosmeticStudio.LastTrailStamp then return end
    State.CosmeticStudio.Clear(Character, 'BodyTrail')
    State.CosmeticStudio.LastTrailStamp = Stamp
    if not Enabled then return end
    pcall(function()
        local Top = Instance.new('Attachment')
        Top.Name = 'GoldenEagleBodyTrailA0'
        Top.Position = Vector3.new(0, 2.2, 0)
        Top:SetAttribute(State.CosmeticStudio.Tag, 'BodyTrail')
        Top.Parent = Root
        local Bottom = Instance.new('Attachment')
        Bottom.Name = 'GoldenEagleBodyTrailA1'
        Bottom.Position = Vector3.new(0, -2.2, 0)
        Bottom:SetAttribute(State.CosmeticStudio.Tag, 'BodyTrail')
        Bottom.Parent = Root
        local Trail = Instance.new('Trail')
        Trail.Name = 'GoldenEagleBodyTrail'
        Trail.Attachment0 = Top
        Trail.Attachment1 = Bottom
        Trail.Color = ColorSequence.new(Start, Finish)
        Trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.12),
            NumberSequenceKeypoint.new(1, 1),
        })
        Trail.Lifetime = Life
        Trail.WidthScale = NumberSequence.new(Width)
        Trail.FaceCamera = true
        Trail.LightEmission = 0.4
        local Texture = State.BallStudio.ResolveTexture(TextureId)
        Trail.Texture = Texture or ''
        Trail.TextureMode = Enum.TextureMode.Stretch
        Trail:SetAttribute(State.CosmeticStudio.Tag, 'BodyTrail')
        Trail.Parent = Root
    end)
end

function State.CosmeticStudio.ApplyCourtOverlay()
    local Enabled = CONFIG.CosmeticStudioEnabled == true and CONFIG.CustomCourtOverlayEnabled == true
    local Id = math.max(0, math.floor(tonumber(CONFIG.CustomCourtDecalId) or 0))
    local Tint = State.BallStudio.Shade('CustomCourtR', 'CustomCourtG', 'CustomCourtB')
    local Stamp = table.concat({ Enabled and '1' or '0', tostring(Id), Tint:ToHex() }, '|')
    if Stamp == State.CosmeticStudio.LastCourtStamp then return end
    for Part in pairs(State.CosmeticStudio.CourtParts) do
        if Part and Part.Parent then State.CosmeticStudio.Clear(Part, 'Court') end
        State.CosmeticStudio.CourtParts[Part] = nil
    end
    State.CosmeticStudio.LastCourtStamp = Stamp
    if not (Enabled and Id > 0) then return end
    local Texture = State.BallStudio.ResolveTexture(Id)
    if not Texture then return end
    local Courts = {}
    pcall(function() Courts = GetAllCourts() end)
    for _, Court in ipairs(Courts) do
        for _, Object in ipairs(Court:GetDescendants()) do
            if Object:IsA('BasePart') and (Object.Name == 'Floor' or Object.Name == 'Court'
                or string.find(string.lower(Object.Name), 'floor', 1, true)) then
                local Decal = Instance.new('Texture')
                Decal.Name = 'GoldenEagleCourtOverlay'
                Decal.Texture = Texture
                Decal.Face = Enum.NormalId.Top
                Decal.StudsPerTileU = math.max(8, Object.Size.X)
                Decal.StudsPerTileV = math.max(8, Object.Size.Z)
                Decal.Transparency = 0.15
                Decal.Color3 = Tint
                Decal:SetAttribute(State.CosmeticStudio.Tag, 'Court')
                Decal.Parent = Object
                State.CosmeticStudio.CourtParts[Object] = true
            end
        end
    end
end

function State.CosmeticStudio.PlayGoalBurst(Goal)
    if not (CONFIG.CosmeticStudioEnabled and CONFIG.CustomGoalBurstEnabled) then return end
    local Id = math.max(0, math.floor(tonumber(CONFIG.CustomGoalBurstCatalogId) or 0))
    local Anchor = Goal
    if typeof(Goal) == 'Instance' and not Goal:IsA('BasePart') then
        Anchor = Goal:FindFirstChildWhichIsA('BasePart', true)
    end
    if not (Id > 0 and Anchor and Anchor:IsA('BasePart')) then return end
    local Scale = math.clamp(tonumber(CONFIG.CustomGoalBurstScale) or 1, 0.05, 8)
    local Item = State.BallStudio.LoadCatalogItem(Id)
    if not Item then return end
    pcall(function()
        Item:SetAttribute(State.CosmeticStudio.Tag, 'GoalBurst')
        Item.Parent = workspace
        if Item:IsA('Model') then
            Item:PivotTo(Anchor.CFrame)
            pcall(function() Item:ScaleTo(Scale) end)
        elseif Item:IsA('BasePart') then
            Item.CFrame = Anchor.CFrame
            Item.Anchored = true
        end
        game:GetService('Debris'):AddItem(Item, 6)
    end)
end

function State.CosmeticStudio.Refresh()
    State.CosmeticStudio.LastBodyStamp = ''
    State.CosmeticStudio.LastBallStamp = ''
    State.CosmeticStudio.LastTrailStamp = ''
    State.CosmeticStudio.LastCourtStamp = ''
    State.CosmeticStudio.Update(true)
end

function State.CosmeticStudio.Cleanup()
    local Character = LP.Character
    if Character then
        State.CosmeticStudio.Clear(Character, 'BodyAura')
        State.CosmeticStudio.Clear(Character, 'BodyTrail')
    end
    local Ball = State.CosmeticStudio.TrackedBall or (GetLocalBallHandle and GetLocalBallHandle())
    if Ball then State.CosmeticStudio.Clear(Ball, 'BallAura') end
    for Part in pairs(State.CosmeticStudio.CourtParts) do
        if Part and Part.Parent then State.CosmeticStudio.Clear(Part, 'Court') end
        State.CosmeticStudio.CourtParts[Part] = nil
    end
    State.CosmeticStudio.LastBodyStamp = ''
    State.CosmeticStudio.LastBallStamp = ''
    State.CosmeticStudio.LastTrailStamp = ''
    State.CosmeticStudio.LastCourtStamp = ''
    State.CosmeticStudio.TrackedCharacter = nil
    State.CosmeticStudio.TrackedBall = nil
end

function State.CosmeticStudio.Update(Force)
    if not CONFIG.CosmeticStudioEnabled and not Force then
        if State.CosmeticStudio.TrackedCharacter or next(State.CosmeticStudio.CourtParts) then
            State.CosmeticStudio.Cleanup()
        end
        return
    end
    local Character = LP.Character
    State.CosmeticStudio.ApplyBodyAura(Character)
    State.CosmeticStudio.ApplyBodyTrail(Character)
    local Ball = GetLocalBallHandle and GetLocalBallHandle() or nil
    State.CosmeticStudio.ApplyBallAura(Ball)
    State.CosmeticStudio.ApplyCourtOverlay()
end
GiveSignal(RunService.RenderStepped:Connect(function()
    if State.Active and CONFIG.CosmeticStudioEnabled then
        local Now = os.clock()
        if Now - (State.CosmeticStudio.LastUpdateAt or 0) >= (1 / 20) then
            State.CosmeticStudio.LastUpdateAt = Now
            pcall(State.CosmeticStudio.Update)
        end
    end
    if not (State.Active and CONFIG.BallStudioEnabled) then return end
    local Now = os.clock()
    local VerifyAppearance = Now - State.BallStudio.LastProxyVerifyAt >= 0.25
    if VerifyAppearance then State.BallStudio.LastProxyVerifyAt = Now end
    if next(State.BallStudio.Proxies) ~= nil then
        pcall(State.BallStudio.SyncProxies, VerifyAppearance)
    end
    if Now - State.BallStudio.LastUpdateAt < (1 / 30) then return end
    State.BallStudio.LastUpdateAt = Now
    pcall(State.BallStudio.Update)
end))

GiveSignal(CollectionService:GetInstanceAddedSignal('BallHandle'):Connect(function(Ball)
    State.Cosmetics.Runtime.LastBallResolveAt = 0
    if State.LocalCosmeticSpoofEnabled and Ball:IsA('BasePart') then
        State.Lifecycle:Defer(function() pcall(State.Cosmetics.ApplyLocalCosmetics, true) end)
    end
end))
pcall(function()
    local ReplicateEvent = ReplicatedStorage.Remotes.replicateEvent
    GiveSignal(ReplicateEvent.OnClientEvent:Connect(function(Ball, Category)
        if State.LocalCosmeticSpoofEnabled and Ball and Ball.Parent
            and (Ball == State.Cosmetics.Runtime.LastBall or Ball:IsDescendantOf(LP.Character))
            and (Category == 'Aura' or Category == 'Trail' or Category == 'Ball') then
            State.Lifecycle:Defer(function() pcall(State.Cosmetics.ApplyLocalCosmetics, true) end)
        end
    end))
end)

local function GetLocalCosmeticOptions(Category, DefaultName, ModelOnly)
    local Options = {}
    local ShopItems = ReplicatedStorage:FindFirstChild('ShopItems')
    local Folder = ShopItems and ShopItems:FindFirstChild(Category)
    if Folder then
        for _, Item in ipairs(Folder:GetChildren()) do
            if ModelOnly == nil or Item:IsA('Model') == ModelOnly then
                table.insert(Options, Item.Name)
            end
        end
    end
    table.sort(Options)
    if #Options == 0 then table.insert(Options, DefaultName) end
    table.insert(Options, 1, 'None')
    return Options
end

