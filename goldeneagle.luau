function State.LocalSpoofs.ApplyClanSpoof()
    if not State.LocalClanSpoofEnabled then return end
    local Frames = State.LocalSpoofs.FindMenuFrames()
    local Clans = Frames and Frames:FindFirstChild('Clans')
    local Pages = Clans and Clans:FindFirstChild('PageFrames')
    local Clan = Pages and Pages:FindFirstChild('Clan')
    local Main = Clan and Clan:FindFirstChild('Main')
    if not Main then return end
    local Set = State.LocalSpoofs.SetStatsUI
    local Rankings = State.LocalSpoofs.GetRankings()
    local Name = tostring(State.LocalClanName or '')
    local Tag = tostring(State.LocalClanTagText or '')
    local Points = math.max(0, math.floor(tonumber(State.LocalClanELO) or 0))
    local Funds = math.max(0, math.floor(tonumber(State.LocalClanFunds) or 0))
    local Level = math.max(1, math.floor(tonumber(State.LocalClanLevel) or 1))
    local W = math.max(0, math.floor(tonumber(State.LocalClanWins) or 0))
    local L = math.max(0, math.floor(tonumber(State.LocalClanLosses) or 0))
    if #Name > 0 and Main:FindFirstChild('ClanName') then Set(Main.ClanName, 'Text', Name) end
    if #Tag > 0 and Main:FindFirstChild('ClanTag') then Set(Main.ClanTag, 'Text', '[' .. Tag .. ']') end
    local Frame = Main:FindFirstChild('Frame')
    local Stats = Frame and Frame:FindFirstChild('StatsFrame')
    if Stats then
        local Record = Stats:FindFirstChild('RecordFrame')
        if Record and Record:FindFirstChild('ValueLabel') then
            Set(Record.ValueLabel, 'Text', W .. ' - ' .. L)
        end
        local ELOFrame = Stats:FindFirstChild('ELOFrame')
        if ELOFrame then
            if ELOFrame:FindFirstChild('ValueLabel') then Set(ELOFrame.ValueLabel, 'Text', tostring(Points)) end
            if ELOFrame:FindFirstChild('TitleLabel') then
                local RankName, RankTier = Rankings.getRankFromELO(Points)
                Set(ELOFrame.TitleLabel, 'Text', tostring(RankName) .. ' ' .. tostring(RankTier))
            end
        end
        local FundsFrame = Stats:FindFirstChild('FundsFrame')
        if FundsFrame and FundsFrame:FindFirstChild('ValueLabel') then
            Set(FundsFrame.ValueLabel, 'Text', tostring(Funds))
        end
        local LevelFrame = Stats:FindFirstChild('LevelFrame')
        if LevelFrame and LevelFrame:FindFirstChild('ValueLabel') then
            Set(LevelFrame.ValueLabel, 'Text', 'Lvl. ' .. tostring(Level))
        end
        local Competitive = Stats:FindFirstChild('CompetitiveLabel')
        if Competitive and Competitive:FindFirstChild('ValueLabel') then
            Set(Competitive.ValueLabel, 'Text', Level >= 2 and 'Enabled' or 'Not Unlocked')
            Set(Competitive.ValueLabel, 'TextColor3', Level >= 2 and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 0, 0))
        end
    end
    if Main:FindFirstChild('LeagueIcon') and Main.LeagueIcon:IsA('ImageLabel') then
        Set(Main.LeagueIcon, 'Image', Rankings.getRankImageFromELO(Points) or '')
    end

    local MembersFrame = Main:FindFirstChild('MembersFrame')
    local Scroll = MembersFrame and MembersFrame:FindFirstChild('ScrollingFrame')
    if Scroll then
        for _, Row in ipairs(Scroll:GetChildren()) do
            local BG = Row:FindFirstChild('BG')
            local Username = BG and BG:FindFirstChild('Username')
            if Username and tostring(Username.Text) == '@' .. LP.Name then
                local Info = BG:FindFirstChild('InfoFrame')
                if Info and Info:FindFirstChild('DonatedAmount') then Set(Info.DonatedAmount, 'Text', tostring(Funds)) end
                if Info and Info:FindFirstChild('ELOAmount') then Set(Info.ELOAmount, 'Text', tostring(Points)) end
            end
        end
    end
end

function State.LocalSpoofs.SetClanSpoof(Enabled)
    State.LocalClanSpoofEnabled = Enabled == true
    CONFIG.LocalClanSpoof = State.LocalClanSpoofEnabled
    pcall(function() State.Lifecycle:UnbindFromRenderStep('GoldenEagleClanSpoof') end)
    if State.LocalClanSpoofEnabled then
        pcall(State.LocalSpoofs.ApplyClanSpoof)
        State.Lifecycle:BindToRenderStep('GoldenEagleClanSpoof', Enum.RenderPriority.Last.Value + 11, WYNF_JIT(function()
            if State.Active and State.LocalClanSpoofEnabled then
                local Now = os.clock()
                if Now - (State.LocalSpoofs.ClanSpoofAt or 0) >= 0.3 then
                    State.LocalSpoofs.ClanSpoofAt = Now
                    pcall(State.LocalSpoofs.ApplyClanSpoof)
                end
            end
        end))
