    function HubUI.BuildConfigControls()
        local Groups = HubUI.ConfigGroups
        if not (Groups and Groups.Profiles and Groups.System) then return end

        local ConfigFolder = 'GoldenEagle_Configs'
        local SessionStore = type(GlobalEnv.__GOLDEN_EAGLE_CONFIGS) == 'table'
            and GlobalEnv.__GOLDEN_EAGLE_CONFIGS or {}
        GlobalEnv.__GOLDEN_EAGLE_CONFIGS = SessionStore

        local function CreateConfigButton(Parent, Position, Size, Text, Callback, Danger)
            local Button = New('TextButton', {
                Position = Position, Size = Size,
                BackgroundColor3 = Danger and Theme.Bad or Theme.Surface,
                BackgroundTransparency = Danger and 0.12 or 0,
                BorderSizePixel = 0, AutoButtonColor = false,
                Font = Enum.Font.Code, Text = Text,
                TextColor3 = Danger and Color3.new(1, 1, 1) or Theme.Text,
                TextSize = 10, ZIndex = 7,
                }, Parent)
            New('UICorner', { CornerRadius = UDim.new(0, 3) }, Button)
            if Danger then DarkStroke(Button) else AccentStroke(Button, 1, 0.18) end
            HubUI.ActionCallbacks[Button] = Callback
            GiveSignal(Button.MouseButton1Click:Connect(Callback))
            GiveSignal(Button.MouseEnter:Connect(function()
                Tween(Button, 0.1, { BackgroundTransparency = Danger and 0 or 0.18 })
            end))
            GiveSignal(Button.MouseLeave:Connect(function()
                MotionOut(Button, 0.1, { BackgroundTransparency = Danger and 0.12 or 0 })
            end))

            GiveSignal(Button.MouseButton1Down:Connect(function()
                Tween(Button, 0.07, {
                    BackgroundTransparency = Danger and 0.3 or 0.32,
                    }, Enum.EasingStyle.Sine)
            end))
            GiveSignal(Button.MouseButton1Up:Connect(function()
                Tween(Button, 0.12, {
                    BackgroundTransparency = Danger and 0 or 0.18,
                    }, Enum.EasingStyle.Sine)
            end))
            return Button
        end

        local function SanitizeConfigName(Value)
            Value = tostring(Value or ''):gsub('[^%w _%-]', '')
            Value = Value:match('^%s*(.-)%s*$') or ''
            Value = Value:gsub('%s+', ' ')
            if #Value > 32 then Value = Value:sub(1, 32) end
            return Value ~= '' and Value or 'Default'
        end

        local function FileStem(Name)
            return SanitizeConfigName(Name):gsub('%s+', '_')
        end

        local function ConfigPath(Name)
            return ConfigFolder .. '/' .. FileStem(Name) .. '.json'
        end

        local function EnsureConfigFolder()
            if type(isfolder) == 'function' then
                local Ok, Exists = pcall(isfolder, ConfigFolder)
                if Ok and Exists then return true end
            end
            if type(makefolder) == 'function' then
                return pcall(makefolder, ConfigFolder)
            end
            return false
        end

