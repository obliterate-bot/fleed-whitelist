    local function SetCategorySearchVisibleLegacy(Category, Label, Visible, DelayIndex)
        CategorySearchSerials[Category] = (CategorySearchSerials[Category] or 0) + 1
        local Serial = CategorySearchSerials[Category]
        if Visible then
            if not Label.Visible then
                Label.Visible = true
                Label.Size = UDim2.new(1, -6, 0, 0)
                Label.TextTransparency = 1
            end
            State.Lifecycle:Delay((InterfaceConfig.ReducedMotion and 0 or math.min(DelayIndex, 5) * 0.012) / HubUI.Motion.Speed(), function()
                if CategorySearchSerials[Category] ~= Serial or not Label.Parent then return end
                Tween(Label, 0.15, {
                    Size = UDim2.new(1, -6, 0, 15),
                    TextTransparency = 0,
                    }, Enum.EasingStyle.Quart)
            end)
        elseif Label.Visible then
            Tween(Label, 0.1, {
                Size = UDim2.new(1, -6, 0, 0),
                TextTransparency = 1,
                }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            State.Lifecycle:Delay(InterfaceConfig.ReducedMotion and 0.002 or 0.11 / HubUI.Motion.Speed(), function()
                if CategorySearchSerials[Category] == Serial and Label.Parent then Label.Visible = false end
            end)
        end
    end

    local function SetNavigationTabSearchVisible(Data, Visible, DelayIndex)
        Data.SearchAnimationSerial += 1
        local Serial = Data.SearchAnimationSerial
        local Button = Data.Button
        local Selected = HubUI.ActiveTab == Button.Name:gsub('^Tab_', '')
        if Visible then
            if not Button.Visible then
                Button.Visible = true
                Button.Size = UDim2.new(1, -4, 0, 0)
                Button.TextTransparency = 1
                Button.BackgroundTransparency = 1
            end
            State.Lifecycle:Delay((InterfaceConfig.ReducedMotion and 0 or math.min(DelayIndex, 7) * 0.014) / HubUI.Motion.Speed(), function()
                if Data.SearchAnimationSerial ~= Serial or not Button.Parent then return end
                Tween(Button, 0.18, {
                    Size = UDim2.fromOffset(Data.BaseWidth or 68, 30),
                    TextTransparency = 0,
                    BackgroundTransparency = 0,
                    }, Enum.EasingStyle.Quart)
                Tween(Data.Marker, 0.16, {
                    BackgroundTransparency = Selected and 0 or 1,
                    Size = UDim2.new(1, 0, 0, 2),
                    Position = UDim2.new(0, 0, 1, -2),
                    }, Enum.EasingStyle.Quint)
            end)
        elseif Button.Visible then
            Tween(Button, 0.11, {
                Size = UDim2.new(1, -4, 0, 0),
                TextTransparency = 1,
                BackgroundTransparency = 1,
                }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            Tween(Data.Marker, 0.09, { BackgroundTransparency = 1 })
            State.Lifecycle:Delay(InterfaceConfig.ReducedMotion and 0.002 or 0.12 / HubUI.Motion.Speed(), function()
                if Data.SearchAnimationSerial == Serial and Button.Parent then Button.Visible = false end
            end)
        end
    end

    local function ApplyNavigationSearch()
        NavigationSearchSerial += 1
        local Query = string.lower(SearchBox.Text or ''):gsub('^%s+', ''):gsub('%s+$', '')
        AnimateClearButton(ClearSearchButton, Query ~= '')
        FirstSearchMatch = nil
        local CategoryMatches = {}
        local MatchIndex = 0
        for _, Definition in ipairs(TabDefinitions) do
            local Data = HubUI.TabButtons[Definition.Name]
            local SearchMatches = Query == '' or string.find(Data.SearchText, Query, 1, true) ~= nil
            local Matches = SearchMatches and (not InterfaceConfig.HiddenTabs[Definition.Name] or Definition.Name == 'Interface')
            if Matches then
                MatchIndex += 1
                CategoryMatches[Definition.Category] = true
                FirstSearchMatch = FirstSearchMatch or Definition.Name
            end
            SetNavigationTabSearchVisible(Data, Matches, MatchIndex)
        end
        local CategoryIndex = 0
        for Category, Label in pairs(CategoryLabels) do
            if CategoryMatches[Category] then CategoryIndex += 1 end
            SetCategorySearchVisible(Category, Label, CategoryMatches[Category] == true, CategoryIndex)
        end
        if Query == '' then
            EnsureTabVisible(HubUI.ActiveTab, true)
        else
            Tween(NavList, 0.12, { CanvasPosition = Vector2.zero })
        end
    end
