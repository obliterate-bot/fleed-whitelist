        end

        function KeybindManager:RefreshRows()
            local Query = string.lower(KeySearch.Text or ''):gsub('^%s+', ''):gsub('%s+$', '')
            local Order = 0
            for _, Entry in ipairs(self.Ordered) do
                local RowData = self.RowControls[Entry.Id]
                local Haystack = string.lower(Entry.Label .. ' ' .. Entry.Page .. ' ' .. Entry.Kind .. ' ' .. Entry.Mode .. ' ' .. TokenDisplay(Entry.Key))
                local Visible = Query == '' or string.find(Haystack, Query, 1, true) ~= nil
                if RowData then
                    RowData.Row.Visible = Visible
                    if Visible then Order += 1;
                        RowData.Row.LayoutOrder = Order end
                end
            end
            KeybindList.CanvasPosition = Vector2.zero
        end

        GiveSignal(KeySearch:GetPropertyChangedSignal('Text'):Connect(function() KeybindManager:RefreshRows() end))
        GiveSignal(OverlayVisibilityButton.MouseButton1Click:Connect(function()
            KeybindManager:SetOverlayVisible(not InterfaceConfig.KeybindMenuVisible, true)
        end))

        for _, Control in pairs(HubUI.Controls) do
            if type(Control) == 'table' and not Control.Kind and Control.SearchRoot and HubUI.ActionCallbacks[Control.SearchRoot] then
                Control.Kind = 'Action'
                Control.Trigger = HubUI.ActionCallbacks[Control.SearchRoot]
            end
        end

        local DefaultKeys = {
            SilentAim = KeyCodeToken(CONFIG.ToggleKey),
            SilentMode = KeyCodeToken(CONFIG.SilentModeToggleKey),
            KeybindMenuToggle = InterfaceConfig.KeybindMenuToggleKey or 'KC:K',
            AutoGuard = KeyCodeToken(CONFIG.AutoGuardOnBallKey),
            AutoGetOpen = KeyCodeToken(CONFIG.AutoGetOpenKey),
            AutoMix = KeyCodeToken(CONFIG.AutoMixKey),
            Freecam = KeyCodeToken(CONFIG.FreecamKey),
            BallColliders = KeyCodeToken(Enum.KeyCode.B),
        }
        local ControlEntries = {}
        for Id, Control in pairs(HubUI.Controls) do
            if type(Control) == 'table' and Control.Kind and Control.SearchLabel then
                local Page = ResolveControlPage(Control)
                if Page and Page ~= 'Keybinds' then
                    table.insert(ControlEntries, { Id = tostring(Id), Control = Control, Page = Page })
                end
            end
        end
        table.sort(ControlEntries, function(A, B)
            if A.Page == B.Page then return A.Control.SearchLabel < B.Control.SearchLabel end
            return A.Page < B.Page
        end)
        for _, Data in ipairs(ControlEntries) do
            local Options = {
                DefaultKey = DefaultKeys[Data.Id],
                MobileQuick = DefaultKeys[Data.Id] ~= nil,
            }
            if Data.Id == 'AutoGuard' then Options.Trigger = ToggleAdaptiveGuard end
            KeybindManager:Register(Data.Id, Data.Control.SearchLabel, Data.Page, Data.Control, Options)
        end

        KeybindManager:Register('MenuToggle', 'Toggle Menu', 'Interface', nil, {
            Kind = 'Action', DefaultKey = KeyCodeToken(CONFIG.MenuKey), Show = false, MobileQuick = false,
            Trigger = function() if HubUI.SetOpen then HubUI.SetOpen(not HubUI.Open) end end,
        })
        KeybindManager:Register('NoJumpShot', 'No Jump Shot', 'Aim', nil, {
            Kind = 'Action', DefaultKey = KeyCodeToken(CONFIG.NoJumpShotKey),
            Show = true, MobileQuick = true,
            Trigger = function()
            if not State.NoJump.IsEnabled() then
                Notify('GOLDEN EAGLE', 'Enable No Jump Shot under Silent Aim first.')
                return
            end
            State.Lifecycle:Spawn(State.NoJump.Fire)
        end,
        })
        for Index, KeyCode in ipairs({ Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five }) do
            local Slot = Index
            KeybindManager:Register('PassTarget' .. tostring(Slot), 'Pass to Teammate ' .. tostring(Slot), 'Pass', nil, {
                Kind = 'Action', DefaultKey = KeyCodeToken(KeyCode), MobileQuick = true,
                Trigger = function()
                if State.AutoPassEnabled then StartTeammatePass(Slot) end
            end,
            })
        end

        local function BuildDesktopTouchSupport()
            if not (UserInputService.TouchEnabled and InterfaceConfig.MobileSupportEnabled) then return end

            local TouchSupport = {
                LauncherMoved = false,
                SwipeInput = nil,
                SwipeStart = nil,
                FlightInputs = {},
            }
            HubUI.TouchSupport = TouchSupport

            local SavedLauncher = InterfaceConfig.MobileLauncherPosition or {}
            local LauncherPosition = UDim2.new(
                tonumber(SavedLauncher.XScale) or 1,
                tonumber(SavedLauncher.XOffset) or tonumber(SavedLauncher.X) or -18,
                tonumber(SavedLauncher.YScale) or 0.5,
                tonumber(SavedLauncher.YOffset) or tonumber(SavedLauncher.Y) or 0
            )

            local Launcher = New('TextButton', {
                Name = 'GoldenEagleDesktopLauncher',
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = LauncherPosition,
                Size = UDim2.fromOffset(54, 54),
                BackgroundColor3 = Theme.Panel,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Font = Enum.Font.GothamMedium,
                Text = 'GE',
                TextColor3 = Theme.Accent,
                TextSize = 14,
                Active = true,
                ZIndex = 410,
                }, ScreenGui)
            New('UICorner', { CornerRadius = UDim.new(1, 0) }, Launcher)
            AccentStroke(Launcher, 1.5, 0.08)
            local LauncherScale = New('UIScale', { Scale = 1 }, Launcher)
            local LauncherGlow = New('UIGradient', {
                Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Theme.Panel),
                ColorSequenceKeypoint.new(0.48, Theme.SurfaceHover),
                ColorSequenceKeypoint.new(1, Theme.Panel),
                }),
                Rotation = 22,
                }, Launcher)

            local LauncherCaption = New('TextLabel', {
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 1, 3),
                Size = UDim2.fromOffset(58, 13),
                BackgroundTransparency = 1,
                Font = Enum.Font.Code,
                Text = 'MENU',
                TextColor3 = Theme.Muted,
                TextSize = 7,
                ZIndex = 411,
                }, Launcher)

            local function ClampLauncher()
                local Camera = Workspace.CurrentCamera
                if not Camera or not Launcher.Parent then return end
                local Viewport = Camera.ViewportSize
                local X = Viewport.X * Launcher.Position.X.Scale + Launcher.Position.X.Offset
                local Y = Viewport.Y * Launcher.Position.Y.Scale + Launcher.Position.Y.Offset
                X = math.clamp(X, 34, math.max(34, Viewport.X - 34))
                Y = math.clamp(Y, 40, math.max(40, Viewport.Y - 40))
                Launcher.Position = UDim2.fromOffset(X, Y)
            end

            local function SaveLauncherPosition()
                InterfaceConfig.MobileLauncherPosition = {
                    XScale = Launcher.Position.X.Scale,
                    XOffset = Launcher.Position.X.Offset,
                    YScale = Launcher.Position.Y.Scale,
                    YOffset = Launcher.Position.Y.Offset,
                    X = Launcher.Position.X.Offset,
                    Y = Launcher.Position.Y.Offset,
                }
                SaveInterfaceConfig()
            end

            local LauncherDragging = false
            local LauncherStart
            local LauncherStartPosition

            GiveSignal(Launcher.InputBegan:Connect(function(Input)
                if Input.UserInputType ~= Enum.UserInputType.Touch
                    and Input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                LauncherDragging = true
                TouchSupport.LauncherMoved = false
                LauncherStart = Input.Position
                LauncherStartPosition = Launcher.Position
                HubUI.Motion.Press(LauncherScale, true)
            end))
            GiveSignal(UserInputService.InputChanged:Connect(function(Input)
                if not LauncherDragging then return end
                if Input.UserInputType ~= Enum.UserInputType.Touch
                    and Input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                local Delta = Input.Position - LauncherStart
                if Delta.Magnitude > 7 then TouchSupport.LauncherMoved = true end
                Launcher.Position = UDim2.new(
                    LauncherStartPosition.X.Scale,
                    LauncherStartPosition.X.Offset + Delta.X,
                    LauncherStartPosition.Y.Scale,
                    LauncherStartPosition.Y.Offset + Delta.Y
                )
                ClampLauncher()
            end))
            GiveSignal(UserInputService.InputEnded:Connect(function(Input)
                if Input.UserInputType ~= Enum.UserInputType.Touch
                    and Input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                if LauncherDragging then
                    LauncherDragging = false
                    SaveLauncherPosition()
                    HubUI.Motion.Press(LauncherScale, false)
                end
            end))
            GiveSignal(Launcher.Activated:Connect(function()
                if TouchSupport.LauncherMoved then
                    TouchSupport.LauncherMoved = false
                    return
                end
                HubUI.Motion.Press(LauncherScale, true)
                State.Lifecycle:Delay(0.09, function()
                    if LauncherScale.Parent then HubUI.Motion.Press(LauncherScale, false) end
                end)
                if HubUI.SetOpen then HubUI.SetOpen(not HubUI.Open) end
            end))

            Content.Active = true

            local PrevTabButton = New('TextButton', {
                Position = UDim2.new(0, 8, 1, -34),
                Size = UDim2.fromOffset(34, 25),
                BackgroundColor3 = Theme.Surface,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Font = Enum.Font.GothamMedium,
                Text = '‹',
                TextColor3 = Theme.Accent,
                TextSize = 18,
                ZIndex = 12,
                }, Sidebar)
            local SwipeLabel = New('TextLabel', {
                Position = UDim2.new(0, 45, 1, -34),
                Size = UDim2.fromOffset(38, 25),
                BackgroundTransparency = 1,
                Font = Enum.Font.Code,
                Text = 'SWIPE',
                TextColor3 = Theme.Muted,
                TextSize = 6,
                ZIndex = 12,
                }, Sidebar)
            local NextTabButton = New('TextButton', {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -8, 1, -34),
                Size = UDim2.fromOffset(34, 25),
                BackgroundColor3 = Theme.Surface,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Font = Enum.Font.GothamMedium,
                Text = '›',
                TextColor3 = Theme.Accent,
                TextSize = 18,
                ZIndex = 12,
                }, Sidebar)
            for _, Button in ipairs({ PrevTabButton, NextTabButton }) do
                New('UICorner', { CornerRadius = UDim.new(0, 4) }, Button)
                DarkStroke(Button)
                local Scale = New('UIScale', { Scale = 1 }, Button)
                GiveSignal(Button.Activated:Connect(function()
                    HubUI.Motion.Press(Scale, true)
                    State.Lifecycle:Delay(0.08, function()
                        if Scale.Parent then HubUI.Motion.Press(Scale, false) end
                    end)
                    CycleTab(Button == PrevTabButton and -1 or 1)
                end))
            end

            GiveSignal(Content.InputBegan:Connect(function(Input)
                if Input.UserInputType ~= Enum.UserInputType.Touch then return end
                if UserInputService:GetFocusedTextBox() or ActiveDropdown or ColorPickerOverlay.Visible then return end
                TouchSupport.SwipeInput = Input
                TouchSupport.SwipeStart = Input.Position
            end))
            GiveSignal(UserInputService.InputEnded:Connect(function(Input)
                if Input ~= TouchSupport.SwipeInput then return end
                local Start = TouchSupport.SwipeStart
                TouchSupport.SwipeInput = nil
                TouchSupport.SwipeStart = nil
                if not Start or not HubUI.Open then return end
                local Delta = Input.Position - Start
                if math.abs(Delta.X) >= 66 and math.abs(Delta.X) > math.abs(Delta.Y) * 1.35 then
                    CycleTab(Delta.X < 0 and 1 or -1)
                end
            end))

            local FlightFrame = New('Frame', {
                Name = 'GoldenEagleFlightTouch',
                AnchorPoint = Vector2.new(1, 1),
                Position = UDim2.new(1, -20, 1, -150),
                Size = UDim2.fromOffset(54, 114),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Visible = false,
                ZIndex = 405,
                }, ScreenGui)
            local function CreateFlightButton(Text, Y)
                local Button = New('TextButton', {
                    Position = UDim2.fromOffset(0, Y),
                    Size = UDim2.fromOffset(54, 52),
                    BackgroundColor3 = Theme.Panel,
                    BackgroundTransparency = 0.08,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Font = Enum.Font.GothamMedium,
                    Text = Text,
                    TextColor3 = Theme.Accent,
                    TextSize = 19,
                    Active = true,
                    ZIndex = 406,
                    }, FlightFrame)
                New('UICorner', { CornerRadius = UDim.new(0, 8) }, Button)
                AccentStroke(Button, 1.25, 0.12)
                return Button
            end
            local FlightUp = CreateFlightButton('▲', 0)
            local FlightDown = CreateFlightButton('▼', 62)

            local function RefreshFlightInput(Name, Value, Button)
                State.MobileInput[Name] = Value == true
                Tween(Button, 0.10, {
                    BackgroundColor3 = Value and Theme.Accent or Theme.Panel,
                    TextColor3 = Value and Theme.Background or Theme.Accent,
                })
            end

            local function BindFlightHold(Button, Name)
                GiveSignal(Button.InputBegan:Connect(function(Input)
                    if Input.UserInputType ~= Enum.UserInputType.Touch
                        and Input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                    TouchSupport.FlightInputs[Input] = { Name = Name, Button = Button }
                    RefreshFlightInput(Name, true, Button)
                end))
            end
            BindFlightHold(FlightUp, 'FlightUp')
            BindFlightHold(FlightDown, 'FlightDown')
            GiveSignal(UserInputService.InputEnded:Connect(function(Input)
                local Data = TouchSupport.FlightInputs[Input]
                if not Data then return end
                TouchSupport.FlightInputs[Input] = nil
                RefreshFlightInput(Data.Name, false, Data.Button)
            end))

            local MobileButtons = {}
            local ActiveDrags = {}
            local ActiveHolds = {}
            local DeleteInputs = {}

            local function MobileBindName(Entry)
                local Slot = tostring(Entry.Id):match('^PassTarget(%d+)$')
                if Slot then return 'PASS ' .. Slot end
                local Names = {
                    MenuToggle = 'MENU', SilentAim = 'AIM', SilentMode = 'AIM MODE',
                    AutoGuard = 'GUARD', AutoGetOpen = 'GET OPEN', BallColliders = 'COLLIDERS',
                }
                return Names[Entry.Id] or string.upper(string.sub(Entry.Label, 1, 12))
            end

            local function ClampMobileButton(Button)
                local Camera = Workspace.CurrentCamera
                if not (Camera and Button and Button.Parent) then return end
                local Viewport = Camera.ViewportSize
                local Radius = math.max(Button.AbsoluteSize.X, Button.AbsoluteSize.Y) * 0.5
                local X = Viewport.X * Button.Position.X.Scale + Button.Position.X.Offset
                local Y = Viewport.Y * Button.Position.Y.Scale + Button.Position.Y.Offset
                X = math.clamp(X, Radius + 5, math.max(Radius + 5, Viewport.X - Radius - 5))
                Y = math.clamp(Y, Radius + 5, math.max(Radius + 5, Viewport.Y - Radius - 5))
                Button.Position = UDim2.fromOffset(X, Y)
            end

            local function SaveMobileButton(Entry, Button)
                InterfaceConfig.MobileButtonPositions[Entry.Id] = {
                    X = Button.Position.X.Offset,
                    Y = Button.Position.Y.Offset,
                }
                KeybindManager:ScheduleSave()
            end

            local function PaintMobileButtons()
                for EntryId, Data in pairs(MobileButtons) do
                    local Entry = KeybindManager.Entries[EntryId]
                    local Active = Entry and KeybindManager:GetActive(Entry)
                    if Data.Button and Data.Button.Parent then
                        Data.Button.BackgroundColor3 = Active and Theme.Accent or Theme.Panel
                        Data.Button.TextColor3 = Active and Theme.Background or Theme.Text
                    end
                end
            end

            function KeybindManager:RefreshMobileQuick(Rebuild)
                if Rebuild ~= false then
                    for _, Data in pairs(MobileButtons) do
                        if Data.Button then Data.Button:Destroy() end
                    end
                    table.clear(MobileButtons)
                    table.clear(ActiveDrags)
                    table.clear(ActiveHolds)
                    table.clear(DeleteInputs)

                    local Assigned = {}
                    if InterfaceConfig.MobileQuickVisible ~= false then
                        for _, Entry in ipairs(self.Ordered) do
                            local Eligible
                            if InterfaceConfig.MobileQuickPinnedOnly then
                                Eligible = Entry.MobileQuick == true
                            else
                                Eligible = (Entry.Key ~= nil) or Entry.Mode == 'Always' or Entry.MobileQuick == true
                            end
                            if InterfaceConfig.MobileButtonHidden[Entry.Id] == true then Eligible = false end
                            if Eligible then
                                table.insert(Assigned, Entry)
                            end
                        end
                    end
                    table.sort(Assigned, function(A, B)
                        if A.Page == B.Page then return A.Label < B.Label end
                        return A.Page < B.Page
                    end)

                    for Index, Entry in ipairs(Assigned) do
                        local Saved = InterfaceConfig.MobileButtonPositions[Entry.Id]
                        local ButtonSize = math.clamp(tonumber(InterfaceConfig.MobileButtonSize) or 54, 34, 82)
                        local ButtonFade = math.clamp(tonumber(InterfaceConfig.MobileButtonFade) or 0.35, 0, 0.9)
                        local Pitch = ButtonSize + 8
                        local PerColumn = 4
                        local ViewCamera = Workspace.CurrentCamera
                        if ViewCamera then
                            PerColumn = math.clamp(math.floor((ViewCamera.ViewportSize.Y - 150) / Pitch), 2, 7)
                        end
                        local Column = math.floor((Index - 1) / PerColumn)
                        local Row = (Index - 1) % PerColumn
                        local DefaultX = math.floor(ButtonSize * 0.5) + 12 + Column * Pitch
                        local DefaultY = 100 + Row * Pitch
                        local Button = New('TextButton', {
                            Name = 'MobileBind_' .. tostring(Entry.Id),
                            AnchorPoint = Vector2.new(0.5, 0.5),
                            Position = UDim2.fromOffset(
                            type(Saved) == 'table' and tonumber(Saved.X) or DefaultX,
                            type(Saved) == 'table' and tonumber(Saved.Y) or DefaultY
                            ),
                            Size = UDim2.fromOffset(ButtonSize, ButtonSize),
                            BackgroundColor3 = Theme.Panel,
                            BackgroundTransparency = ButtonFade,
                            BorderSizePixel = 0,
                            AutoButtonColor = false,
                            Font = Enum.Font.GothamMedium,
                            Text = MobileBindName(Entry),
                            TextColor3 = Theme.Text,
                            TextSize = math.clamp(math.floor(ButtonSize * 0.17), 7, 12),
                            TextWrapped = true,
                            Active = true,
                            ZIndex = 425,
                            }, ScreenGui)
                        New('UICorner', { CornerRadius = UDim.new(0, math.floor(ButtonSize * 0.3)) }, Button)
                        AccentStroke(Button, 1.35, 0.10)
                        local Scale = New('UIScale', { Scale = 1 }, Button)
                        local DeleteSize = math.clamp(math.floor(ButtonSize * 0.27), 14, 20)
                        local DeleteButton = New('TextButton', {
                            Name = 'Delete',
                            AnchorPoint = Vector2.new(1, 0),
                            Position = UDim2.new(1, -3, 0, 3),
                            Size = UDim2.fromOffset(DeleteSize, DeleteSize),
                            BackgroundColor3 = Theme.Bad,
                            BackgroundTransparency = 0.08,
                            BorderSizePixel = 0,
                            AutoButtonColor = false,
                            Font = Enum.Font.GothamBold,
                            Text = '×',
                            TextColor3 = Color3.new(1, 1, 1),
                            TextSize = math.max(10, DeleteSize - 3),
                            ZIndex = 427,
                            }, Button)
                        New('UICorner', { CornerRadius = UDim.new(1, 0) }, DeleteButton)
                        DarkStroke(DeleteButton)
                        MobileButtons[Entry.Id] = { Button = Button, Scale = Scale, DeleteButton = DeleteButton }

                        GiveSignal(DeleteButton.InputBegan:Connect(function(Input)
                            if Input.UserInputType ~= Enum.UserInputType.Touch
                                and Input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                            local DeleteKey = Input.UserInputType == Enum.UserInputType.MouseButton1 and 'Mouse' or Input
                            DeleteInputs[DeleteKey] = true
                        end))
                        GiveSignal(DeleteButton.Activated:Connect(function()
                            self:DeleteMobileQuick(Entry)
                        end))

                        GiveSignal(Button.InputBegan:Connect(function(Input)
                            if Input.UserInputType ~= Enum.UserInputType.Touch
                                and Input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                            local DragKey = Input.UserInputType == Enum.UserInputType.MouseButton1 and 'Mouse' or Input
                            if DeleteInputs[DragKey] then return end
                            ActiveDrags[DragKey] = {
                                Entry = Entry,
                                Button = Button,
                                Start = Input.Position,
                                StartPosition = Button.Position,
                                Moved = false,
                            }
                            HubUI.Motion.Press(Scale, true)
                            if Entry.Mode == 'Hold' then
                                ActiveHolds[DragKey] = Entry
                                self:Invoke(Entry, true, 1)
                            end
                        end))
                        State.Lifecycle:Defer(function() ClampMobileButton(Button) end)
                    end
                end
                PaintMobileButtons()
            end

            GiveSignal(UserInputService.InputChanged:Connect(function(Input)
                local DragKey = Input.UserInputType == Enum.UserInputType.MouseMovement and 'Mouse' or Input
                local Drag = ActiveDrags[DragKey]
                if not Drag then return end
                local Delta = Input.Position - Drag.Start
                if Delta.Magnitude > 7 then
                    if not Drag.Moved and ActiveHolds[DragKey] then
                        local HeldEntry = ActiveHolds[DragKey]
                        ActiveHolds[DragKey] = nil
                        KeybindManager:Invoke(HeldEntry, false, 1)
                    end
                    Drag.Moved = true
                end
                if Drag.Moved then
                    Drag.Button.Position = UDim2.fromOffset(
                        Drag.StartPosition.X.Offset + Delta.X,
                        Drag.StartPosition.Y.Offset + Delta.Y
                    )
                    ClampMobileButton(Drag.Button)
                end
            end))

            GiveSignal(UserInputService.InputEnded:Connect(function(Input)
                local DragKey = Input.UserInputType == Enum.UserInputType.MouseButton1 and 'Mouse' or Input
                if DeleteInputs[DragKey] then
                    DeleteInputs[DragKey] = nil
                    ActiveDrags[DragKey] = nil
                    ActiveHolds[DragKey] = nil
                    return
                end
                local Drag = ActiveDrags[DragKey]
                if not Drag then return end
                ActiveDrags[DragKey] = nil
                local HeldEntry = ActiveHolds[DragKey]
                if HeldEntry then
                    ActiveHolds[DragKey] = nil
                    KeybindManager:Invoke(HeldEntry, false, 1)
                end
                local MobileData = MobileButtons[Drag.Entry.Id]
                if MobileData and MobileData.Scale then
                    HubUI.Motion.Press(MobileData.Scale, false)
                end
                if Drag.Moved then
                    SaveMobileButton(Drag.Entry, Drag.Button)
                elseif Drag.Entry.Mode ~= 'Hold' then
                    KeybindManager:Invoke(Drag.Entry, true, 1)
                end
            end))

            KeybindManager:RefreshMobileQuick(true)

            State.Lifecycle:Spawn(function()
                local LastOpen
                local LastFlight
                local LastViewport = Vector2.zero
                while State.Active and Launcher.Parent do
                    local Camera = Workspace.CurrentCamera
                    if Camera and Camera.ViewportSize ~= LastViewport then
                        LastViewport = Camera.ViewportSize
                        ClampLauncher()
                        for _, Data in pairs(MobileButtons) do ClampMobileButton(Data.Button) end
                    end
                    local Open = HubUI.Open == true
                    local FlightVisible = State.Movement.FlightEnabled and not Open
                    if Open ~= LastOpen then
                        LastOpen = Open
                        Launcher.Text = Open and '  ' or 'GE'
                        LauncherCaption.Text = Open and 'CLOSE' or 'MENU'
                        Tween(Launcher, 0.16, {
                            BackgroundColor3 = Open and Theme.SurfaceHover or Theme.Panel,
                            TextColor3 = Open and Theme.Text or Theme.Accent,
                        })
                    end
                    if FlightVisible ~= LastFlight then
                        LastFlight = FlightVisible
                        FlightFrame.Visible = FlightVisible
                        if not FlightVisible then
                            table.clear(TouchSupport.FlightInputs)
                            RefreshFlightInput('FlightUp', false, FlightUp)
                            RefreshFlightInput('FlightDown', false, FlightDown)
                        end
                    end
                    LauncherGlow.Rotation = (LauncherGlow.Rotation + 1.5) % 360
                    task.wait(HubUI.Motion.Hold(0.15))
                end
            end)

            State.Lifecycle:Defer(ClampLauncher)
        end

        BuildDesktopTouchSupport()

        for Index, Entry in ipairs(KeybindManager.Ordered) do
            KeybindManager:CreateRow(Entry, Index)
            if Entry.Mode == 'Always' and Entry.Kind == 'Toggle' and Entry.Control and not Entry.Control.Value then
                Entry.Control:Set(true, true)
            end
        end
        KeybindManager:RefreshRows()
        KeybindManager:RefreshOverlay()
        KeybindManager:SetOverlayVisible(InterfaceConfig.KeybindMenuVisible, false)

        GiveSignal(ResetKeybindsButton.MouseButton1Click:Connect(function()
            InterfaceConfig.Keybinds = {}
            InterfaceConfig.MobileButtonHidden = {}
            InterfaceConfig.MobileButtonPositions = {}
            for _, Entry in ipairs(KeybindManager.Ordered) do
                Entry.Key = nil
                Entry.Mode = DefaultModeFor(Entry.Kind)
                Entry.Show = Entry.Id ~= 'MenuToggle'
                Entry.MobileQuick = false
            end
            local Legacy = {
                MenuToggle = KeyCodeToken(Enum.KeyCode.RightShift),
                SilentAim = KeyCodeToken(Enum.KeyCode.RightControl),
                SilentMode = KeyCodeToken(Enum.KeyCode.X),
                NoJumpShot = KeyCodeToken(Enum.KeyCode.V),
                AutoGuard = KeyCodeToken(Enum.KeyCode.R),
                AutoGetOpen = KeyCodeToken(Enum.KeyCode.C),
                PassTarget1 = KeyCodeToken(Enum.KeyCode.One), PassTarget2 = KeyCodeToken(Enum.KeyCode.Two),
                PassTarget3 = KeyCodeToken(Enum.KeyCode.Three), PassTarget4 = KeyCodeToken(Enum.KeyCode.Four),
                PassTarget5 = KeyCodeToken(Enum.KeyCode.Five),
            }
            for Id, Token in pairs(Legacy) do
                local Entry = KeybindManager.Entries[Id]
                if Entry then
                    Entry.Key = Token
                    Entry.MobileQuick = Id ~= 'MenuToggle'
                    KeybindManager:UpdateLegacyKeys(Entry)
                end
            end
            for _, Entry in ipairs(KeybindManager.Ordered) do
                KeybindManager:RefreshEntry(Entry)
                InterfaceConfig.Keybinds[Entry.Id] = {
                    Key = Entry.Key, Mode = Entry.Mode, Show = Entry.Show ~= false,
                    MobileQuick = Entry.MobileQuick == true,
                }
            end
            KeybindManager:RefreshRows()
            KeybindManager:RefreshOverlay()
            if KeybindManager.RefreshMobileQuick then KeybindManager:RefreshMobileQuick() end
            if KeybindManager.RefreshMobileFilter then KeybindManager:RefreshMobileFilter() end
            KeybindManager:ScheduleSave()
            Notify('GOLDEN EAGLE', 'Keybinds reset to defaults.')
        end))

        State.Lifecycle:Spawn(function()
            while State.Active do
                for _, Entry in ipairs(KeybindManager.Ordered) do
                    if Entry.Mode == 'Always' and Entry.Kind == 'Toggle' and Entry.Control and not Entry.Control.Value then
                        pcall(function() Entry.Control:Set(true, true) end)
                    end
                end
                task.wait(1)
            end
        end)

    end
    BuildKeybindManager()

