            elseif State.Utility.PerformanceApplied and State.Utility.FPS > CONFIG.AutoPerformanceRestoreFPS then
                pcall(State.Utility.RestorePerformanceMode)
            end
        end
    end
    if State.AntiFallEnabled then pcall(State.Utility.StepAntiFall) end
end)))

State.Lifecycle:Spawn(function()
    local LastServerCheck = 0
    while State.Active do
        if State.AutoDailySpinEnabled then pcall(State.Utility.TryDailySpin) end
        if State.AutoServerHopEnabled and os.clock() - LastServerCheck >= CONFIG.AutoServerHopCheckDelay then
            LastServerCheck = os.clock()
            local Ping = State.Utility.GetPing()
            local BadServer = #Players:GetPlayers() < CONFIG.AutoServerHopMinPlayers
