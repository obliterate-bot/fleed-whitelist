function State.Movement.RefreshAirWalk()
    if not State.Movement.AirWalkEnabled then
        State.Movement.DestroyAirWalk()
        return
    end

    local _, HumanoidObject, Root = State.Movement.GetRig()
    if not (HumanoidObject and Root) or HumanoidObject.Health <= 0 then return end

    if State.Movement.FlightEnabled then return end

    if State.Movement.AirWalkY == nil then
        State.Movement.AirWalkY = Root.Position.Y
    end

    local Velocity = Root.AssemblyLinearVelocity
    if Velocity.Y > 0.5 then return end

    local Position = Root.Position
    Root.CFrame = CFrame.new(Position.X, State.Movement.AirWalkY, Position.Z)
    * (Root.CFrame - Position)
    Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
    pcall(function() HumanoidObject:ChangeState(Enum.HumanoidStateType.Running) end)
end

