        ButtonWidth = ButtonWidth or 118
        local LabelObject = New('TextLabel', {
            Position = UDim2.fromOffset(8, Y),
            Size = UDim2.new(1, -ButtonWidth - (ShowKeyButton and 72 or 24), 0, 20),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            Text = Label,
            TextColor3 = Color3.new(1, 1, 1),
            __SkipThemeBinding = true,
            TextSize = 11,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 5,
            }, Parent)
        ApplyThemedTextGradient(LabelObject)
        local Container = New('Frame', {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -8, 0, Y),
            Size = UDim2.fromOffset(ButtonWidth, 20),
            BackgroundColor3 = Theme.Background,
            BorderSizePixel = 0,
            ZIndex = 6,
            }, Parent)
        local ContainerStroke = DarkStroke(Container)
        local PreviousButton = New('TextButton', {
            Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1,
            BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.Code,
            Text = '<', TextColor3 = Theme.Muted, TextSize = 10, ZIndex = 7,
            }, Container)
        local ValueButton = New('TextButton', {
            Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -40, 1, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false,
            Font = Enum.Font.Code, Text = tostring(InitialValue), TextColor3 = Theme.Text,
            TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 7,
            }, Container)
        local NextButton = New('TextButton', {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1,
            BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.Code,
            Text = '>', TextColor3 = Theme.Muted, TextSize = 10, ZIndex = 7,
            }, Container)
        local KeyButton
        if ShowKeyButton then
            KeyButton = New('TextButton', {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -ButtonWidth - 14, 0, Y + 2),
                Size = UDim2.fromOffset(42, 16),
                BackgroundColor3 = Theme.Background,
                BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.Code,
                Text = '  ', TextColor3 = Theme.Muted, TextSize = 8, ZIndex = 8,
                }, Parent)
            local KeyStroke = DarkStroke(KeyButton)
            GiveSignal(KeyButton.MouseEnter:Connect(function()
                Tween(KeyButton, 0.1, { BackgroundColor3 = Theme.SurfaceHover, TextColor3 = Theme.Text })
                Tween(KeyStroke, 0.1, { Color = Theme.Accent })
            end))
            GiveSignal(KeyButton.MouseLeave:Connect(function()
                Tween(KeyButton, 0.1, { BackgroundColor3 = Theme.Background, TextColor3 = Theme.Muted })
                Tween(KeyStroke, 0.1, { Color = Theme.Border })
            end))
        end
        local Control = {
            Value = InitialValue, Container = Container, SearchRoot = Container,
            SearchParent = Parent, SearchLabel = Label, Kind = 'Selector', Options = Options,
            KeyButton = KeyButton,
        }
        function Control:Set(Value, FireCallback)
            Control.Value = Value
            ValueButton.Text = tostring(Value)
            ValueButton.TextTransparency = 0.55
            ValueButton.Position = UDim2.fromOffset(22, 0)
            Tween(ValueButton, 0.14, { TextTransparency = 0, Position = UDim2.fromOffset(20, 0) }, Enum.EasingStyle.Quart)
            if FireCallback ~= false then Callback(Value) end
        end
        function Control:Step(Direction)
            if #Options == 0 then return end
            local Index = table.find(Options, Control.Value) or 1
            Index = ((Index - 1 + Direction) % #Options) + 1
            Control:Set(Options[Index], true)
        end
        GiveSignal(PreviousButton.MouseButton1Click:Connect(function() Control:Step(-1) end))
        GiveSignal(NextButton.MouseButton1Click:Connect(function() Control:Step(1) end))
        GiveSignal(ValueButton.MouseButton1Click:Connect(function() Control:Step(1) end))
        GiveSignal(ValueButton.MouseButton2Click:Connect(function() Control:Step(-1) end))
        GiveSignal(Container.InputChanged:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseWheel then Control:Step(Input.Position.Z > 0 and -1 or 1) end
        end))
        local function SetHover(Value)
            Tween(Container, 0.1, { BackgroundColor3 = Value and Theme.SurfaceHover or Theme.Background })
            Tween(ContainerStroke, 0.1, { Color = Value and Theme.Accent or Theme.Border })
            Tween(LabelObject, 0.1, { TextColor3 = Value and Theme.AccentBright or Theme.Text })
            PreviousButton.TextColor3 = Value and Theme.Text or Theme.Muted
            NextButton.TextColor3 = Value and Theme.Text or Theme.Muted
        end
        GiveSignal(Container.MouseEnter:Connect(function() SetHover(true) end))
        GiveSignal(Container.MouseLeave:Connect(function() SetHover(false) end))
        return Control, Container
    end

    local function CreateDropdown(Parent, Y, Label, Options, InitialValue, Callback, ButtonWidth)
        ButtonWidth = ButtonWidth or 168
        local LabelObject = New('TextLabel', {
            Position = UDim2.fromOffset(8, Y),
            Size = UDim2.new(1, -ButtonWidth - 24, 0, 23),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            Text = Label,
            TextColor3 = Color3.new(1, 1, 1),
            __SkipThemeBinding = true,
            TextSize = 11,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 20,
            }, Parent)
        ApplyThemedTextGradient(LabelObject)
        local Button = New('TextButton', {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -8, 0, Y),
            Size = UDim2.fromOffset(ButtonWidth, 23),
            BackgroundColor3 = Theme.Background,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Font = Enum.Font.Code,
            Text = tostring(InitialValue) .. '      v',
            TextColor3 = Theme.Text,
            TextSize = 10,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 21,
            }, Parent)
        local DropdownStroke = DarkStroke(Button)

        local RowHeight = 23
        local PopupHeight = 171
        local Popup = New('CanvasGroup', {
            AnchorPoint = Vector2.zero,
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.fromOffset(ButtonWidth, PopupHeight),
            BackgroundColor3 = Theme.Background,
            BorderSizePixel = 0,
            Visible = false,
            GroupTransparency = 1,
            ZIndex = 200,
            }, ScreenGui)
        local PopupScale = New('UIScale', { Scale = 0.965 }, Popup)
        AccentStroke(Popup, 1, 0.08)
        New('UICorner', { CornerRadius = UDim.new(0, 4) }, Popup)
        local DropdownSearch = New('TextBox', {
            Position = UDim2.fromOffset(4, 4),
            Size = UDim2.new(1, -8, 0, 23),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            ClearTextOnFocus = false,
            Font = Enum.Font.Code,
            PlaceholderText = 'Filter options...',
            PlaceholderColor3 = Theme.Muted,
            Text = '',
            TextColor3 = Theme.Text,
            TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 201,
            }, Popup)
        New('UIPadding', { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }, DropdownSearch)
        local DropdownSearchStroke = DarkStroke(DropdownSearch)
        local List = New('ScrollingFrame', {
            Position = UDim2.fromOffset(4, 31),
            Size = UDim2.new(1, -8, 1, -35),
            BackgroundColor3 = Theme.Background,
            BorderSizePixel = 0,
            CanvasSize = UDim2.fromOffset(0, 0),
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Theme.Accent,
            ZIndex = 201,
            }, Popup)

        local Control = {
            Value = InitialValue, Open = false, Popup = Popup, Button = Button,
            SearchRoot = Button, SearchParent = Parent, SearchLabel = Label,
            Kind = 'Dropdown', Options = Options,
        }
        local Rows = {}
        local FilteredOptions = {}
        local function RebuildFilter()
            table.clear(FilteredOptions)
            local Query = string.lower(DropdownSearch.Text or '')
            for _, Option in ipairs(Options) do
                if Query == '' or string.find(string.lower(tostring(Option)), Query, 1, true) then
                    table.insert(FilteredOptions, Option)
                end
            end
            List.CanvasPosition = Vector2.zero
            List.CanvasSize = UDim2.fromOffset(0, #FilteredOptions * RowHeight)
        end
        local function UpdateRows()
            local First = math.max(1, math.floor(List.CanvasPosition.Y / RowHeight) + 1)
            for Slot, Entry in ipairs(Rows) do
                local Row = Entry.Button
                local Index = First + Slot - 1
                local Option = FilteredOptions[Index]
                Entry.Index = Index
                Entry.Option = Option
                Row.Visible = Option ~= nil
                Row.Position = UDim2.fromOffset(0, (Index - 1) * RowHeight)
                Row.Text = Option and ('  ' .. tostring(Option)) or ''
                Row.BackgroundColor3 = Index % 2 == 0 and Theme.Surface or Theme.Panel
            end
        end
        Control.AnimationSerial = 0
        function Control:Close()
            if not Control.Open and not Popup.Visible then return end
            Control.AnimationSerial += 1
            local Serial = Control.AnimationSerial
            Control.Open = false
            Button.Text = tostring(Control.Value) .. '      v'
            DropdownSearch:ReleaseFocus()
            Tween(Button, 0.18, { BackgroundColor3 = Theme.Background }, Enum.EasingStyle.Sine)
            Tween(Popup, 0.18, {
                GroupTransparency = 1,
                Position = Popup.Position + UDim2.fromOffset(0, -2),
                }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(PopupScale, 0.18, { Scale = 0.985 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            State.Lifecycle:Delay(InterfaceConfig.ReducedMotion and 0.002 or 0.19 / HubUI.Motion.Speed(), function()
                if Control.AnimationSerial == Serial and not Control.Open and Popup.Parent then Popup.Visible = false end
            end)
            if ActiveDropdown == Control then ActiveDropdown = nil end
        end
        function Control:Set(Value, FireCallback)
            Control.Value = Value
            Button.Text = tostring(Value) .. '      v'
            Control:Close()
            if FireCallback ~= false then Callback(Value) end
        end
        function Control:Step(Direction)
            if #Options == 0 then return end
            local Index = table.find(Options, Control.Value) or 1
            Index = ((Index - 1 + Direction) % #Options) + 1
            Control:Set(Options[Index], true)
        end
        function Control:RefreshOptions(NewOptions, PreferredValue)
            local PreviousCanvasPosition = List.CanvasPosition
            if type(NewOptions) == 'table' and NewOptions ~= Options then
                table.clear(Options)
                for _, Option in ipairs(NewOptions) do table.insert(Options, Option) end
            end
            local Wanted = PreferredValue or Control.Value
            if not table.find(Options, Wanted) then Wanted = Options[1] end
            Control.Value = Wanted
            Button.Text = tostring(Wanted or '--') .. '  v'
            RebuildFilter()
            if Control.Open then List.CanvasPosition = PreviousCanvasPosition end
            UpdateRows()
        end
        local function PositionPopup()
            local Camera = Workspace.CurrentCamera
            local Viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
            local Width = math.max(ButtonWidth, Button.AbsoluteSize.X)
            local X = math.clamp(Button.AbsolutePosition.X, 6, math.max(6, Viewport.X - Width - 6))
            local Below = Button.AbsolutePosition.Y + Button.AbsoluteSize.Y + 2
            local PopupY = Below
            if Below + PopupHeight > Viewport.Y - 6 then PopupY = Button.AbsolutePosition.Y - PopupHeight - 2 end
            PopupY = math.clamp(PopupY, 6, math.max(6, Viewport.Y - PopupHeight - 6))
            Popup.Position = UDim2.fromOffset(X, PopupY)
            Popup.Size = UDim2.fromOffset(Width, PopupHeight)
        end
        function Control:SetOpen(Value)
            Value = Value == true
            if Value and ActiveDropdown and ActiveDropdown ~= Control then ActiveDropdown:Close() end
            if not Value then Control:Close();
                return end
            Control.AnimationSerial += 1
            local Serial = Control.AnimationSerial
            Control.Open = true
            Button.Text = tostring(Control.Value) .. '  ^'
            local WasVisible = Popup.Visible
            local InterruptedPosition = Popup.Position
            PositionPopup()
            local FinalPosition = Popup.Position
            if WasVisible then
                Popup.Position = InterruptedPosition
            else
                Popup.Position = FinalPosition + UDim2.fromOffset(0, -3)
                Popup.GroupTransparency = 1
                PopupScale.Scale = 0.98
            end
            Popup.Visible = true
            ActiveDropdown = Control
            DropdownSearch.Text = ''
            RebuildFilter()
            UpdateRows()
            Tween(Button, 0.20, { BackgroundColor3 = Theme.SurfaceHover }, Enum.EasingStyle.Sine)
            Tween(Popup, 0.25, {
                GroupTransparency = 0,
                Position = FinalPosition,
                }, Enum.EasingStyle.Sine)
            Tween(PopupScale, 0.26, { Scale = 1 }, Enum.EasingStyle.Quint)
            for RowIndex, Entry in ipairs(Rows) do
                if Entry.Button.Visible then
                    Entry.Button.TextTransparency = 1
                    Entry.Button.BackgroundTransparency = 1
                    State.Lifecycle:Delay((InterfaceConfig.ReducedMotion and 0 or (RowIndex - 1) * 0.012) / HubUI.Motion.Speed(), function()
                        if Control.AnimationSerial ~= Serial or not Control.Open or not Entry.Button.Parent then return end
                        Tween(Entry.Button, 0.18, {
                            TextTransparency = 0,
                            BackgroundTransparency = 0,
                            }, Enum.EasingStyle.Sine)
                    end)
                end
            end
            task.defer(function() if DropdownSearch.Parent and Control.Open then DropdownSearch:CaptureFocus() end end)
        end

        for Slot = 1, 7 do
            local Row = New('TextButton', {
                Size = UDim2.new(1, -4, 0, RowHeight),
                BackgroundColor3 = Theme.Panel,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                Font = Enum.Font.Code,
                Text = '',
                TextColor3 = Theme.Text,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
                Visible = false,
                ZIndex = 202,
                }, List)
            local Entry = { Button = Row, Option = nil, Index = nil }
            Rows[Slot] = Entry
            GiveSignal(Row.MouseButton1Click:Connect(function() if Entry.Option then Control:Set(Entry.Option, true) end end))
            GiveSignal(Row.MouseEnter:Connect(function() Tween(Row, 0.08, { BackgroundColor3 = Theme.SurfaceHover }) end))
            GiveSignal(Row.MouseLeave:Connect(function() Tween(Row, 0.08, { BackgroundColor3 = Entry.Index and (Entry.Index % 2 == 0 and Theme.Surface or Theme.Panel) or Theme.Panel }) end))
        end
        GiveSignal(List:GetPropertyChangedSignal('CanvasPosition'):Connect(UpdateRows))
        GiveSignal(DropdownSearch:GetPropertyChangedSignal('Text'):Connect(function()
            RebuildFilter()
            UpdateRows()
            Tween(List, 0.1, { CanvasPosition = Vector2.zero })
        end))
        GiveSignal(DropdownSearch.Focused:Connect(function()
            Tween(DropdownSearch, 0.12, { BackgroundColor3 = Theme.SurfaceHover })
            Tween(DropdownSearchStroke, 0.12, { Color = Theme.Accent, Transparency = 0.05, Thickness = 1.3 })
        end))
        GiveSignal(DropdownSearch.FocusLost:Connect(function(EnterPressed)
            Tween(DropdownSearch, 0.12, { BackgroundColor3 = Theme.Surface })
            Tween(DropdownSearchStroke, 0.12, { Color = Theme.Border, Transparency = 0.15, Thickness = 1 })
            if EnterPressed and FilteredOptions[1] then Control:Set(FilteredOptions[1], true) end
        end))
        GiveSignal(Button.MouseButton1Click:Connect(function() Control:SetOpen(not Control.Open) end))

        GiveSignal(Button.MouseButton1Down:Connect(function()
            Tween(Button, 0.07, { BackgroundColor3 = Theme.Surface }, Enum.EasingStyle.Sine)
        end))
        GiveSignal(Button.MouseButton1Up:Connect(function()
            if Control.Open then return end
            Tween(Button, 0.12, { BackgroundColor3 = Theme.SurfaceHover }, Enum.EasingStyle.Sine)
        end))
        GiveSignal(Button.MouseEnter:Connect(function()
            Tween(Button, 0.1, { BackgroundColor3 = Theme.SurfaceHover, TextColor3 = Theme.AccentBright })
            Tween(DropdownStroke, 0.1, { Color = Theme.Accent })
        end))
        GiveSignal(Button.MouseLeave:Connect(function()
            Tween(Button, 0.1, { BackgroundColor3 = Theme.Background, TextColor3 = Theme.Text })
            Tween(DropdownStroke, 0.1, { Color = Theme.Border })
        end))
        RebuildFilter()
        UpdateRows()
        return Control, Button
    end

    local function CreateNumberInput(Parent, Y, Label, InitialValue, Minimum, Maximum, Decimals, Callback)
        New('TextLabel', {
            Position = UDim2.fromOffset(8, Y),
            Size = UDim2.new(1, -122, 0, 21),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            Text = Label,
            TextColor3 = Theme.Text,
            TextSize = 11,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 5,
            }, Parent)

        local Container = New('Frame', {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -8, 0, Y),
            Size = UDim2.fromOffset(108, 21),
            BackgroundColor3 = Theme.Background,
            BorderSizePixel = 0,
            Active = true,
            ZIndex = 6,
            }, Parent)
        local ContainerStroke = DarkStroke(Container)

        local Track = New('Frame', {
            Position = UDim2.fromOffset(4, 4),
            Size = UDim2.new(1, -8, 0, 13),
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            ZIndex = 7,
            }, Container)
        local TrackStroke = DarkStroke(Track)

        local Fill = New('Frame', {
            Size = UDim2.fromScale(0, 1),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 8,
            }, Track)
        BindAccent(Fill, 'BackgroundColor3')

        local Knob = New('Frame', {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(0, 0),
            BackgroundTransparency = 1,
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 9,
            }, Track)

        local Hitbox = New('TextButton', {
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = '',
            ZIndex = 10,
            }, Track)

        local Box = New('TextBox', {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.fromOffset(41, 21),
            BackgroundColor3 = Theme.Panel,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ClearTextOnFocus = false,
            Font = Enum.Font.Code,
            Text = '',
            TextColor3 = Theme.Text,
            TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 10,
            }, Container)
        New('UICorner', { CornerRadius = UDim.new(0, 3) }, Box)

        local Divider = New('Frame', {
            AnchorPoint = Vector2.new(0, 0),
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.fromOffset(0, 0),
            BackgroundColor3 = Theme.Border,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            ZIndex = 9,
            }, Container)

        local Control = {
            Value = tonumber(InitialValue) or Minimum,
            Container = Container,
            Track = Track,
            Knob = Knob,
            Box = Box,
            Dragging = false,
            DragInput = nil,
            DragStartValue = nil,
            SearchRoot = Container,
            SearchParent = Parent,
            SearchLabel = Label,
            Kind = 'Number',
            Minimum = Minimum,
            Maximum = Maximum,
        }
        local Range = math.max(0, Maximum - Minimum)
        local Scale = Decimals and Decimals > 0 and (10 ^ Decimals) or 1

        local function FormatValue(Value)
            if Decimals and Decimals > 0 then
                return string.format('%.' .. tostring(Decimals) .. 'f', Value)
            end
            return tostring(math.round(Value))
        end

        local function Quantize(Value)
            Value = math.clamp(tonumber(Value) or Control.Value or Minimum, Minimum, Maximum)
            return math.round(Value * Scale) / Scale
        end

        local function SetVisual(Value, Instant)
            local Alpha = Range > 0 and math.clamp((Value - Minimum) / Range, 0, 1) or 0
            local FillSize = UDim2.new(Alpha, 0, 1, 0)
            local KnobPosition = UDim2.new(Alpha, 0, 0.5, 0)
            if Instant or Control.Dragging then
                Fill.Size = FillSize
                Knob.Position = KnobPosition
            else
                Tween(Fill, 0.18, { Size = FillSize }, Enum.EasingStyle.Quint)
                Tween(Knob, 0.18, { Position = KnobPosition }, Enum.EasingStyle.Quint)
            end
            Box.Text = FormatValue(Value)
        end

        function Control:Set(Value, FireCallback)
            Value = Quantize(Value)
            local Changed = Value ~= Control.Value
            Control.Value = Value
            SetVisual(Value)
            if FireCallback ~= false and Changed then Callback(Value) end
        end

        function Control:Step(Direction)
            local Increment = Decimals and Decimals > 0 and (1 / Scale) or 1
            Control:Set(Control.Value + Increment * (Direction or 1), true)
        end

        function Control:PreviewFromX(PointerX)
            if not (Track and Track.Parent) then return end
            local Width = Track.AbsoluteSize.X
            if Width <= 0 then return end
            local Alpha = math.clamp((PointerX - Track.AbsolutePosition.X) / Width, 0, 1)
            Control:Set(Minimum + Range * Alpha, false)
        end

        function Control:BeginDrag(Input)
            local Previous = HubUI.ActiveSlider
            if Previous and Previous ~= Control and Previous.EndDrag then
                Previous:EndDrag(true)
            end
            Control.Dragging = true
            Control.DragInput = Input.UserInputType == Enum.UserInputType.Touch and Input or nil
            Control.DragStartValue = Control.Value
            HubUI.ActiveSlider = Control
            Control:PreviewFromX(Input.Position.X)
            Knob.Size = UDim2.fromOffset(0, 0)
        end

        function Control:EndDrag(FireCallback)
            if not Control.Dragging then return end
            Control.Dragging = false
            Control.DragInput = nil
            if HubUI.ActiveSlider == Control then HubUI.ActiveSlider = nil end
            Knob.Size = UDim2.fromOffset(0, 0)
            local Changed = Control.Value ~= Control.DragStartValue
            Control.DragStartValue = nil
            if FireCallback ~= false and Changed then Callback(Control.Value) end
        end

        if not HubUI.SliderControllerInstalled then
            HubUI.SliderControllerInstalled = true
            GiveSignal(RunService.RenderStepped:Connect(WYNF_JIT(function()
                local Active = HubUI.ActiveSlider
                if not (Active and Active.Dragging) then return end
                if not (Active.Track and Active.Track.Parent) then
                    HubUI.ActiveSlider = nil
                    return
                end
                if Active.DragInput then
                    Active:PreviewFromX(Active.DragInput.Position.X)
                else
                    Active:PreviewFromX(UserInputService:GetMouseLocation().X)
                end
            end)))
            GiveSignal(UserInputService.InputEnded:Connect(function(Input)
                local Active = HubUI.ActiveSlider
                if not (Active and Active.Dragging) then return end
                if Input.UserInputType == Enum.UserInputType.MouseButton1
                    or (Input.UserInputType == Enum.UserInputType.Touch and Input == Active.DragInput) then
                    Active:EndDrag(true)
                end
            end))
            GiveSignal(UserInputService.WindowFocusReleased:Connect(function()
                local Active = HubUI.ActiveSlider
                if Active and Active.Dragging then Active:EndDrag(true) end
            end))
        end

        GiveSignal(Hitbox.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1
                or Input.UserInputType == Enum.UserInputType.Touch then
                Control:BeginDrag(Input)
            end
        end))

        GiveSignal(Hitbox.InputChanged:Connect(function(Input)
            if Input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
            if Control.Dragging then return end
            local WheelStep = Decimals and Decimals > 0 and (1 / Scale) or 1
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
                WheelStep = WheelStep * 10
            end
            Control:Set(Control.Value + WheelStep * (Input.Position.Z > 0 and 1 or -1), true)
        end))

        GiveSignal(Box.Focused:Connect(function()
            Box.CursorPosition = 1
            Box.SelectionStart = #Box.Text + 1

            Tween(Box, 0.12, { BackgroundTransparency = 0.35 }, Enum.EasingStyle.Sine)
            Tween(ContainerStroke, 0.12, { Color = Theme.Accent }, Enum.EasingStyle.Sine)
        end))
        GiveSignal(Box.FocusLost:Connect(function()
            Tween(Box, 0.16, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
            Tween(ContainerStroke, 0.16, { Color = Theme.Border }, Enum.EasingStyle.Sine)
            local Parsed = tonumber(Box.Text)
            if Parsed == nil then
                SetVisual(Control.Value)
            else
                Control:Set(Parsed, true)
            end
        end))

        GiveSignal(Hitbox.MouseEnter:Connect(function()
            Tween(Container, 0.1, { BackgroundColor3 = Theme.SurfaceHover })
            Tween(ContainerStroke, 0.1, { Color = Theme.Accent })
            Tween(TrackStroke, 0.1, { Color = Theme.Accent })
            if not Control.Dragging then Knob.Size = UDim2.fromOffset(0, 0) end
        end))
