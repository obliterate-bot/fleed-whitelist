    HubUI.SanitizeBallPresetName = function(Value)
        Value = tostring(Value or ''):gsub('[^%w _%-]', '')
        Value = Value:match('^%s*(.-)%s*$') or ''
        Value = Value:gsub('%s+', ' ')
        if #Value > 28 then Value = Value:sub(1, 28) end
        if string.lower(Value) == 'custom' or string.lower(Value) == 'hamburger' then
            Value = Value .. ' Copy'
        end
        if Value == '' then
            local Index = 1
            repeat Value = 'Preset ' .. tostring(Index);
                Index += 1
            until HubUI.BallPresets[Value] == nil
        end
        return Value
    end

    HubUI.LoadBallPresets = function()
        if type(isfile) ~= 'function' or type(readfile) ~= 'function' then return end
        local ExistsOk, Exists = pcall(isfile, HubUI.BallPresetFile)
        if not (ExistsOk and Exists) then return end
        local ReadOk, Raw = pcall(readfile, HubUI.BallPresetFile)
        if not ReadOk then return end
        local DecodeOk, Data = pcall(State.Utility.HttpService.JSONDecode, State.Utility.HttpService, Raw)
        if not (DecodeOk and type(Data) == 'table') then return end
        for Name, Preset in pairs(Data) do
            if type(Preset) == 'table' then
                Name = HubUI.SanitizeBallPresetName(Name)
                HubUI.BallPresets[Name] = Preset
            end
        end
    end

    HubUI.WriteBallPresets = function()
        GlobalEnv.__GOLDEN_EAGLE_BALL_PRESETS = HubUI.BallPresets
        if type(writefile) ~= 'function' then return false end
        local EncodeOk, Encoded = pcall(State.Utility.HttpService.JSONEncode,
            State.Utility.HttpService, HubUI.BallPresets)
        if not EncodeOk then return false end
        return pcall(writefile, HubUI.BallPresetFile, Encoded)
    end

    HubUI.GetBallPresetOptions = function()
        local Names = {}
        for Name in pairs(HubUI.BallPresets) do Names[#Names + 1] = tostring(Name) end
        table.sort(Names, function(A, B) return string.lower(A) < string.lower(B) end)
        local Output = { 'Custom', 'Hamburger' }
        for _, Name in ipairs(Names) do Output[#Output + 1] = Name end
        return Output
    end

    HubUI.CollectBallPreset = function()
        return {
            CatalogItemId = math.max(0, math.floor(tonumber(CONFIG.CustomBallCatalogId) or 0)),
            BallDecalId = math.max(0, math.floor(tonumber(CONFIG.CustomBallDecalId) or 0)),
            BallMeshId = math.max(0, math.floor(tonumber(CONFIG.CustomBallMeshId) or 0)),
            MeshTextureId = math.max(0, math.floor(tonumber(CONFIG.CustomBallMeshTextureId) or 0)),
            Size = math.clamp(tonumber(CONFIG.CustomBallScale) or 1, 0.001, 5),
            Tint = CONFIG.CustomBallTint == true,
            Red = math.clamp(math.floor(tonumber(CONFIG.CustomBallR) or 255), 0, 255),
            Green = math.clamp(math.floor(tonumber(CONFIG.CustomBallG) or 255), 0, 255),
            Blue = math.clamp(math.floor(tonumber(CONFIG.CustomBallB) or 255), 0, 255),
            ShotSound = CONFIG.ShotSoundEnabled == true,
            ShotSoundId = math.max(0, math.floor(tonumber(CONFIG.ShotSoundId) or 0)),
            Volume = math.clamp(tonumber(CONFIG.ShotSoundVolume) or 1.2, 0, 10),
            Pitch = math.clamp(tonumber(CONFIG.ShotSoundPitch) or 1, 0.25, 4),
            Duration = math.clamp(tonumber(CONFIG.ShotSoundDuration) or 0, 0, 120),
        }
    end

