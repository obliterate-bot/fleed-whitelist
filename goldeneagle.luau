State.Lifecycle = {
    Alive = true,
    Generation = 1,
    Connections = {},
    NamedConnections = {},
    Tasks = {},
    NamedTasks = {},
    RenderBindings = {},
    Instances = {},
    Cleanups = {},
    LastPruneAt = 0,
    PruneInterval = 2,
}

function State.Lifecycle:GiveConnection(Connection, Name)
    if not Connection then return nil end
    if not self.Alive then
        pcall(function() Connection:Disconnect() end)
        return Connection
    end
    if Name then
        local Existing = self.NamedConnections[Name]
        if Existing and Existing ~= Connection then self:DisconnectConnection(Existing) end
        self.NamedConnections[Name] = Connection
    end
    self.Connections[Connection] = true
    return Connection
end

function State.Lifecycle:Connect(Signal, Callback, Name)
    if not (self.Alive and Signal and type(Callback) == 'function') then return nil end
    if Name and self.NamedConnections[Name] then
        self:DisconnectConnection(self.NamedConnections[Name])
    end
    local Generation = self.Generation
    local Connection = Signal:Connect(function(...)
        if not self.Alive or self.Generation ~= Generation then return end
        return Callback(...)
    end)
    return self:GiveConnection(Connection, Name)
end

function State.Lifecycle:DisconnectConnection(Connection)
    if not Connection then return end
    self.Connections[Connection] = nil
    for Name, Value in pairs(self.NamedConnections) do
        if Value == Connection then self.NamedConnections[Name] = nil end
    end
    pcall(function() Connection:Disconnect() end)
end

function State.Lifecycle:DisconnectNamed(Name)
    local Connection = self.NamedConnections[Name]
    if Connection then self:DisconnectConnection(Connection) end
end

function State.Lifecycle:Prune(Force)
    if not self.Alive then return end
    local Now = os.clock()
    if not Force and Now - (self.LastPruneAt or 0) < (self.PruneInterval or 2) then return end
    self.LastPruneAt = Now
    for Connection in pairs(self.Connections) do
        local Connected
        local ReadOk = pcall(function() Connected = Connection.Connected end)
        if ReadOk and Connected == false then
            self.Connections[Connection] = nil
            for Name, Value in pairs(self.NamedConnections) do
                if Value == Connection then self.NamedConnections[Name] = nil end
            end
        end
    end
    for Thread in pairs(self.Tasks) do
        local Status
        local ReadOk = pcall(function() Status = coroutine.status(Thread) end)
        if ReadOk and Status == 'dead' then self:ForgetTask(Thread) end
    end
end

function State.Lifecycle:ForgetTask(Thread)
    if not Thread then return end
    self.Tasks[Thread] = nil
    for Name, Value in pairs(self.NamedTasks) do
        if Value == Thread then self.NamedTasks[Name] = nil end
    end
end

function State.Lifecycle:CancelTask(Thread)
    if not Thread then return end
    self:ForgetTask(Thread)
    if Thread ~= coroutine.running() then pcall(task.cancel, Thread) end
end

function State.Lifecycle:CancelNamedTask(Name)
    local Thread = self.NamedTasks[Name]
    if Thread then self:CancelTask(Thread) end
end

function State.Lifecycle:Spawn(Callback, ...)
    if not (self.Alive and type(Callback) == 'function') then return nil end
    local Packed = table.pack(...)
    local Generation = self.Generation
    local Thread
    local Finished = false
    Thread = task.spawn(function()
        if self.Alive and self.Generation == Generation then
            local Ok, ErrorText = pcall(Callback, table.unpack(Packed, 1, Packed.n))
            if not Ok and self.Alive then warn('[GOLDEN EAGLE TASK] ' .. tostring(ErrorText)) end
        end
        Packed = nil
        Finished = true
        if Thread then self:ForgetTask(Thread) end
    end)
    if not Finished then self.Tasks[Thread] = true end
    return Thread
end

function State.Lifecycle:Delay(Seconds, Callback, ...)
    if not (self.Alive and type(Callback) == 'function') then return nil end
    local Packed = table.pack(...)
    local Generation = self.Generation
    local Thread
    Thread = task.delay(math.max(tonumber(Seconds) or 0, 0), function()
        if self.Alive and self.Generation == Generation then
            local Ok, ErrorText = pcall(Callback, table.unpack(Packed, 1, Packed.n))
            if not Ok and self.Alive then warn('[GOLDEN EAGLE DELAY] ' .. tostring(ErrorText)) end
        end
        Packed = nil
        if Thread then self:ForgetTask(Thread) end
    end)
    self.Tasks[Thread] = true
    return Thread
end

function State.Lifecycle:Defer(Callback, ...)
    if not (self.Alive and type(Callback) == 'function') then return nil end
    local Packed = table.pack(...)
    local Generation = self.Generation
    local Thread
    Thread = task.defer(function()
        if self.Alive and self.Generation == Generation then
            local Ok, ErrorText = pcall(Callback, table.unpack(Packed, 1, Packed.n))
            if not Ok and self.Alive then warn('[GOLDEN EAGLE DEFER] ' .. tostring(ErrorText)) end
        end
        Packed = nil
        if Thread then self:ForgetTask(Thread) end
    end)
    self.Tasks[Thread] = true
    return Thread
end

function State.Lifecycle:NameTask(Name, Thread)
    if not Name then return Thread end
    local Existing = self.NamedTasks[Name]
    if Existing and Existing ~= Thread then self:CancelTask(Existing) end
    self.NamedTasks[Name] = Thread
    return Thread
end

function State.Lifecycle:BindToRenderStep(Name, Priority, Callback)
    if not (self.Alive and Name and type(Callback) == 'function') then return end
    pcall(function() RunService:UnbindFromRenderStep(Name) end)
    local Generation = self.Generation
    RunService:BindToRenderStep(Name, Priority, function(...)
        if not self.Alive or self.Generation ~= Generation then return end
        return Callback(...)
    end)
    self.RenderBindings[Name] = true
end

function State.Lifecycle:UnbindFromRenderStep(Name)
    if not Name then return end
    self.RenderBindings[Name] = nil
    pcall(function() RunService:UnbindFromRenderStep(Name) end)
end

function State.Lifecycle:OwnInstance(Object)
    if typeof(Object) ~= 'Instance' then return Object end
    if not self.Alive then pcall(function() Object:Destroy() end);
        return Object end
    self.Instances[Object] = true
    local Watch
    pcall(function()
        Watch = Object.Destroying:Connect(function()
            self.Instances[Object] = nil
            if Watch then self:DisconnectConnection(Watch);
                Watch = nil end
        end)
    end)
    if Watch then self:GiveConnection(Watch) end
    return Object
end

function State.Lifecycle:ForgetInstance(Object)
    if Object then self.Instances[Object] = nil end
end

function State.Lifecycle:AddCleanup(Callback)
    if type(Callback) == 'function' then self.Cleanups[#self.Cleanups + 1] = Callback end
    return Callback
end

function State.Lifecycle:Cleanup()
    if not self.Alive then return end
    self.Alive = false
    self.Generation += 1
    for Name in pairs(self.RenderBindings) do
        pcall(function() RunService:UnbindFromRenderStep(Name) end)
    end
    table.clear(self.RenderBindings)
    local CurrentThread = coroutine.running()
    for Thread in pairs(self.Tasks) do
        if Thread ~= CurrentThread then pcall(task.cancel, Thread) end
    end
    table.clear(self.Tasks)
    table.clear(self.NamedTasks)
    for Connection in pairs(self.Connections) do
        pcall(function() Connection:Disconnect() end)
    end
    table.clear(self.Connections)
    table.clear(self.NamedConnections)
    for Index = #self.Cleanups, 1, -1 do
        pcall(self.Cleanups[Index])
        self.Cleanups[Index] = nil
    end
    for Object in pairs(self.Instances) do
        pcall(function() Object:Destroy() end)
    end
    table.clear(self.Instances)
    self.LastPruneAt = 0
end

