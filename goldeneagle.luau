        local function RefreshPalette()
            for _, Child in ipairs(PaletteList:GetChildren()) do
                if Child:IsA('TextButton') then Child:Destroy() end
            end
            local Query = string.lower(PaletteBox.Text or '')
            Query = string.gsub(string.gsub(Query, '^%s+', ''), '%s+$', '')
            local Entries = {}
            for _, Command in ipairs(PaletteCommands) do
                if Query == '' or string.find(string.lower(Command.Label), Query, 1, true) then
                    table.insert(Entries, { Label = Command.Label, Kind = 'Command', Run = Command.Run })
                end
            end
            local Keys = {}
            for Key, Control in pairs(HubUI.Controls) do
                if type(Control) == 'table' and Control.Kind and Control.SearchLabel then
                    if Control.Kind ~= 'Action' or type(Control.Trigger) == 'function' then
                        table.insert(Keys, Key)
                    end
                end
            end
            table.sort(Keys, function(A, B)
                return string.lower(tostring(HubUI.Controls[A].SearchLabel)) < string.lower(tostring(HubUI.Controls[B].SearchLabel))
            end)
            for _, Key in ipairs(Keys) do
                local Control = HubUI.Controls[Key]
                local Haystack = string.lower(tostring(Control.SearchLabel) .. ' ' .. Key .. ' ' .. tostring(Control.Kind))
                if Query == '' or string.find(Haystack, Query, 1, true) then
                    table.insert(Entries, { Label = Control.SearchLabel, Kind = Control.Kind, Control = Control })
                end
            end
            local Shown = 0
            for Index, Entry in ipairs(Entries) do
                if Shown >= 40 then break end
                Shown += 1
                local Control = Entry.Control
                local Row = New('TextButton', {
                    Size = UDim2.new(1, -4, 0, 22), BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.25,
                    BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.Code, Text = '',
                    LayoutOrder = Index, ZIndex = 293,
