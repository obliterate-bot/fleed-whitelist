            Page = Pages[Name], BaseWidth = Width,
            SearchText = string.lower(DisplayName .. ' ' .. Definition.Search),
            Category = Definition.Category, SearchAnimationSerial = 0, Hovered = false,
        }
        HubUI.TabButtons[Name] = Data
        GiveSignal(Button.MouseButton1Click:Connect(function() SwitchTab(Name) end))
        GiveSignal(Button.MouseEnter:Connect(function()
            if HubUI.ActiveTab ~= Name then
                Data.Hovered = true
                Tween(Button, 0.16, { BackgroundColor3 = Theme.SurfaceHover, TextColor3 = Theme.AccentBright }, Enum.EasingStyle.Sine)
                Tween(Marker, 0.16, {
                    BackgroundTransparency = 0.08,
                    Size = UDim2.new(1, 0, 0, 3),
                    Position = UDim2.new(0, 0, 1, -3),
                    }, Enum.EasingStyle.Sine)
            end
        end))
        GiveSignal(Button.MouseLeave:Connect(function()
            if HubUI.ActiveTab ~= Name then
                Data.Hovered = false
                Tween(Button, 0.18, { BackgroundColor3 = Theme.Background, TextColor3 = Theme.Muted }, Enum.EasingStyle.Sine)
                Tween(Marker, 0.16, {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 2),
                    Position = UDim2.new(0, 0, 1, -2),
                    }, Enum.EasingStyle.Sine)
            end
        end))
    end
    local PageLabelSerial = 0
    SwitchTab = function(Name)
        if not Pages[Name] then return end
        if ActiveDropdown then ActiveDropdown:Close() end
        if Name == HubUI.ActiveTab then
            SearchBox:ReleaseFocus()
            return
        end
        TabSerial += 1
        local ThisSerial = TabSerial
        local PreviousName = HubUI.ActiveTab
        local PreviousPage = Pages[PreviousName]
        local NextPage = Pages[Name]
        HubUI.ActiveTab = Name
        GlobalEnv.__GOLDEN_EAGLE_UI_TAB = Name
        EnsureTabVisible(Name, true)

        PageLabelSerial += 1
        local ThisLabelSerial = PageLabelSerial
        Tween(ActivePageLabel, 0.12, {
            TextTransparency = 1,
            Position = UDim2.fromOffset(196, -3),
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        State.Lifecycle:Delay(HubUI.Motion.Hold(0.125), function()
            if ThisLabelSerial ~= PageLabelSerial or not ActivePageLabel.Parent then return end
            ActivePageLabel.Text = string.upper(Name)
            ActivePageLabel.Position = UDim2.fromOffset(196, 4)
            Tween(ActivePageLabel, 0.20, {
                TextTransparency = 0,
                Position = UDim2.fromOffset(196, 0),
                }, Enum.EasingStyle.Quint)
        end)

        local NextWasVisible = NextPage.Visible
        NextPage.Visible = true
        if not NextWasVisible then
            NextPage.Position = UDim2.fromOffset(6, 0)
            NextPage.GroupTransparency = 1
        end
        NextPage.Rotation = 0
        Tween(NextPage, 0.26, {
            Position = UDim2.fromOffset(0, 0),
            GroupTransparency = 0,
            Rotation = 0,
            }, Enum.EasingStyle.Quint)
        if PreviousPage then
            Tween(PreviousPage, 0.15, {
                Position = UDim2.fromOffset(-4, 0),
                GroupTransparency = 1,
                Rotation = 0,
                }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        end

        for TabName, TabData in pairs(HubUI.TabButtons) do
            local Selected = TabName == Name
            local Hovered = TabData.Hovered == true and not Selected
            Tween(TabData.Button, 0.22, {
                BackgroundColor3 = Selected and Theme.Panel or (Hovered and Theme.SurfaceHover or Theme.Background),
                BackgroundTransparency = 0,
                TextColor3 = Selected and Theme.Accent or (Hovered and Theme.AccentBright or Theme.Muted),
                }, Enum.EasingStyle.Sine)
            Tween(TabData.Marker, 0.22, {
                BackgroundTransparency = Selected and 0 or (Hovered and 0.08 or 1),
                Size = UDim2.new(1, 0, 0, Hovered and 3 or 2),
                Position = UDim2.new(0, 0, 1, Hovered and -3 or -2),
                }, Enum.EasingStyle.Sine)
        end

        State.Lifecycle:Delay(HubUI.Motion.Hold(0.29), function()
            if ThisSerial ~= TabSerial then return end
            for PageName, Page in pairs(Pages) do
                local Selected = PageName == Name
                Page.Visible = Selected
                if not Selected then
                    Page.Position = UDim2.fromOffset(0, 0)
                    Page.GroupTransparency = 1
                    Page.Rotation = 0
                end
            end
        end)
        SearchBox:ReleaseFocus()
    end
    HubUI.SwitchTab = SwitchTab

    do
