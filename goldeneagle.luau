local function NewDrawing(Kind)
    if DrawingApi == nil then return nil end
    local Ok, Object = pcall(function()
        return DrawingApi.new(Kind)
    end)
    if not Ok or Object == nil then return nil end
    pcall(function() Object.Visible = false end)
    table.insert(Visuals.All, Object)
    return Object
end

local function ConfigureLine(Line, Thickness, Transparency, ZIndex)
    if not Line then return false end
    local Ok = pcall(function()
        Line.Thickness = Thickness
        Line.Transparency = Transparency
        Line.ZIndex = ZIndex
        Line.Visible = false
    end)
    return Ok
end

local function InitializeVisuals()
    if Visuals.Initialized then return true end
    if Visuals.Disabled then return false end

    local RangeSegments = math.clamp(math.floor(CONFIG.RangeIndicatorSegments or 32), 16, 64)
    local TrajectorySegments = math.clamp(math.floor(CONFIG.TrajectorySegments or 28), 12, 64)

    for Index = 1, RangeSegments do
        local Glow = NewDrawing('Line')
        local Core = NewDrawing('Line')
        if not ConfigureLine(Glow, 7, 0.28, 5)
            or not ConfigureLine(Core, 2, 1, 6) then
            DestroyVisuals()
            Visuals.Disabled = true
            return false
        end
        Visuals.RangeGlow[Index] = Glow
        Visuals.RangeCore[Index] = Core
    end

    for Index = 1, TrajectorySegments do
        local Glow = NewDrawing('Line')
        local Core = NewDrawing('Line')
        if not ConfigureLine(Glow, 7, 0.25, 7)
            or not ConfigureLine(Core, 2, 1, 8) then
            DestroyVisuals()
            Visuals.Disabled = true
            return false
        end
        Visuals.TrajectoryGlow[Index] = Glow
        Visuals.TrajectoryCore[Index] = Core
    end

    Visuals.LockGlow = NewDrawing('Circle')
    Visuals.LockCore = NewDrawing('Circle')
    Visuals.TargetGlow = NewDrawing('Circle')
    Visuals.TargetCore = NewDrawing('Circle')
    Visuals.DunkRangeGlow = NewDrawing('Circle')
    Visuals.DunkRangeCore = NewDrawing('Circle')
    Visuals.StatusShadow = NewDrawing('Text')
    Visuals.StatusText = NewDrawing('Text')

    local ExtrasOk = Visuals.LockGlow and Visuals.LockCore
        and Visuals.TargetGlow and Visuals.TargetCore
        and Visuals.DunkRangeGlow and Visuals.DunkRangeCore
        and Visuals.StatusShadow and Visuals.StatusText
        and pcall(function()
        Visuals.LockGlow.Filled = false
        Visuals.LockGlow.NumSides = 48
        Visuals.LockGlow.Thickness = 7
        Visuals.LockGlow.Transparency = 0.25
        Visuals.LockGlow.ZIndex = 7

        Visuals.LockCore.Filled = false
        Visuals.LockCore.NumSides = 48
        Visuals.LockCore.Thickness = 2
        Visuals.LockCore.Transparency = 1
        Visuals.LockCore.ZIndex = 8

        Visuals.TargetGlow.Filled = false
        Visuals.TargetGlow.NumSides = 40
        Visuals.TargetGlow.Thickness = 7
        Visuals.TargetGlow.Transparency = 0.25
        Visuals.TargetGlow.ZIndex = 9

        Visuals.TargetCore.Filled = false
        Visuals.TargetCore.NumSides = 40
        Visuals.TargetCore.Thickness = 2
        Visuals.TargetCore.Transparency = 1
        Visuals.TargetCore.ZIndex = 10

        Visuals.DunkRangeGlow.Filled = false
        Visuals.DunkRangeGlow.NumSides = 64
        Visuals.DunkRangeGlow.Thickness = 7
        Visuals.DunkRangeGlow.Transparency = 0.24
        Visuals.DunkRangeGlow.ZIndex = 7

        Visuals.DunkRangeCore.Filled = false
        Visuals.DunkRangeCore.NumSides = 64
        Visuals.DunkRangeCore.Thickness = 2
        Visuals.DunkRangeCore.Transparency = 1
        Visuals.DunkRangeCore.ZIndex = 8

        Visuals.StatusShadow.Center = true
        Visuals.StatusShadow.Outline = false
        Visuals.StatusShadow.Font = 2
        Visuals.StatusShadow.Size = CONFIG.RangeTextSize or 15
        Visuals.StatusShadow.Color = Visuals.Theme.Background
        Visuals.StatusShadow.Transparency = 0.7
        Visuals.StatusShadow.ZIndex = 9

        Visuals.StatusText.Center = true
        Visuals.StatusText.Outline = false
        Visuals.StatusText.Font = 2
        Visuals.StatusText.Size = CONFIG.RangeTextSize or 15
        Visuals.StatusText.Transparency = 1
        Visuals.StatusText.ZIndex = 10
    end)
    if not ExtrasOk then
        DestroyVisuals()
        Visuals.Disabled = true
        return false
    end

    Visuals.Initialized = true
    return true
end

local ProjectWorldPoint
ProjectWorldPoint = WYNF_JIT_MAX(function(Camera, WorldPoint)
    local ViewPoint, OnScreen = Camera:WorldToViewportPoint(WorldPoint)
    return Vector2.new(ViewPoint.X, ViewPoint.Y), OnScreen and ViewPoint.Z > 0
end)

local SetLinePair
SetLinePair = WYNF_JIT_MAX(function(Glow, Core, From, To, Color, IsVisible, CoreThickness)
    Glow.From = From
    Glow.To = To
    Glow.Color = Color
    Glow.Visible = IsVisible

    Core.From = From
    Core.To = To
    Core.Color = Color
    Core.Thickness = CoreThickness or 2
    Core.Visible = IsVisible
end)

local GetVisualShotData
GetVisualShotData = WYNF_JIT_MAX(function()
    if not (State.Active and State.Enabled and HumanoidRootPart and Humanoid) then
        return nil
    end

    local Basketball = GetHeldBasketballModel(LP)
    local Ball = Basketball and safe_find(Basketball, 'Ball')
    if CONFIG.VisualOnlyWithBall and not Ball then return nil end

    local Rim, RawDistance = FindConfiguredGoal()
    if not Rim or type(RawDistance) ~= 'number' or RawDistance == math.huge then
        return nil
    end

    local Power = State.PowerBypass.GetEffectivePower()
    local AimDistance = State.Backboard.GetConfiguredAimDistance(Rim, RawDistance)
    local TableDistance = AdjustAimDistance(AimDistance)
    local ShotRange = 72.0
    local Calibrated = PowerSupportsDistance(Power, TableDistance)
    local Supported = AimDistance <= ShotRange or CONFIG.MaxRangeBypass
    local ArcHeight = Calibrated and select(1, GetArcSettings(TableDistance, Power)) or nil

    local Head = safe_find(Char, 'Head') or HumanoidRootPart
    local OriginPart = Ball or Head
    if not OriginPart or not safe_is_a(OriginPart, 'BasePart') then return nil end

    return {
        Origin = OriginPart.Position,
        AimOrigin = Head.Position,
        Rim = Rim,
        Distance = RawDistance,
        Power = Power,
        Supported = Supported,
        ArcHeight = ArcHeight,
    }
end)

local function EnsureRangeHighlight()
    if not Char or not Char.Parent then return nil end
    local Existing = Visuals.CharacterHighlight
    if Existing and Existing.Parent == HiddenGui() and Existing.Adornee == Char then
        return Existing
    end
    if Existing then pcall(function() Existing:Destroy() end) end

    local Highlight = Instance.new('Highlight')
    local VisualTheme = Visuals.Theme
    Highlight.Name = 'GoldenEagleRangeHighlight'
    Highlight.Adornee = Char
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.FillColor = VisualTheme.Accent
    Highlight.FillTransparency = 0.58
    Highlight.OutlineColor = VisualTheme.AccentBright
    Highlight.OutlineTransparency = 0
    Highlight.Enabled = false
    Highlight.Parent = HiddenGui()
    Visuals.CharacterHighlight = Highlight
    return Highlight
end

local function HideLegacyShotLines(KeepTrajectory, KeepTarget)
    for Index = 1, #Visuals.RangeCore do
        if Visuals.RangeGlow[Index].Visible then Visuals.RangeGlow[Index].Visible = false end
        if Visuals.RangeCore[Index].Visible then Visuals.RangeCore[Index].Visible = false end
    end
    if not KeepTrajectory then
        for Index = 1, #Visuals.TrajectoryCore do
            if Visuals.TrajectoryGlow[Index].Visible then Visuals.TrajectoryGlow[Index].Visible = false end
            if Visuals.TrajectoryCore[Index].Visible then Visuals.TrajectoryCore[Index].Visible = false end
        end
    end
    if Visuals.LockGlow and Visuals.LockGlow.Visible then Visuals.LockGlow.Visible = false end
    if Visuals.LockCore and Visuals.LockCore.Visible then Visuals.LockCore.Visible = false end
    if not KeepTarget then
        if Visuals.TargetGlow and Visuals.TargetGlow.Visible then Visuals.TargetGlow.Visible = false end
        if Visuals.TargetCore and Visuals.TargetCore.Visible then Visuals.TargetCore.Visible = false end
    end
end

local function RenderVisuals()
    if not (CONFIG.RangeIndicatorEnabled or CONFIG.TrajectoryPreviewEnabled
        or CONFIG.ArcPreviewEnabled or CONFIG.DunkRangeIndicator) then
        HideVisuals()
        return
    end
    if not InitializeVisuals() then return end

    local Now = os.clock()
    if Now - Visuals.ShotDataAt >= (1 / 20) then
        Visuals.ShotDataAt = Now
        Visuals.ShotData = GetVisualShotData()
    end
    local Data = Visuals.ShotData
    local Camera = Workspace.CurrentCamera
    if not Data or not Camera then
        HideVisuals()
        return
    end

    HideLegacyShotLines(
        CONFIG.ArcPreviewEnabled,
        CONFIG.ArcPreviewEnabled and CONFIG.ArcPreviewLandingMarker)

    local Pulse = (math.sin(Now * 4.2) + 1) * 0.5
    local VisualTheme = Visuals.Theme
    local Accent = VisualTheme.Accent:Lerp(VisualTheme.AccentBright, Pulse)
    local Background = VisualTheme.Background
    local Muted = VisualTheme.Muted

    SetRangeScreenTint(Data.Supported)

    local DunkRangeShown = false
    if CONFIG.DunkRangeIndicator and State.AutoDunkEnabled and State.AutoDunk and State.AutoDunk.Target then
        local TargetPosition = State.AutoDunk.Target.Position
        local CenterPoint, CenterVisible = ProjectWorldPoint(Camera, TargetPosition)
        local EdgePoint = ProjectWorldPoint(Camera, TargetPosition + Vector3.new(CONFIG.AutoDunkTriggerDistance, 0, 0))
        local Radius = (EdgePoint - CenterPoint).Magnitude
        if CenterVisible and Radius >= 2 and Radius <= 1000 then
            Visuals.DunkRangeGlow.Position = CenterPoint
            Visuals.DunkRangeGlow.Radius = Radius
            Visuals.DunkRangeGlow.Color = Background
            Visuals.DunkRangeGlow.Visible = true
            Visuals.DunkRangeCore.Position = CenterPoint
            Visuals.DunkRangeCore.Radius = Radius
            Visuals.DunkRangeCore.Color = Accent
            Visuals.DunkRangeCore.Visible = true
            DunkRangeShown = true
        end
    end
    if not DunkRangeShown then
        if Visuals.DunkRangeGlow.Visible then Visuals.DunkRangeGlow.Visible = false end
        if Visuals.DunkRangeCore.Visible then Visuals.DunkRangeCore.Visible = false end
    end

    local Highlight = EnsureRangeHighlight()
    if Highlight then
        local HighlightEnabled = CONFIG.RangeIndicatorEnabled and Data.Supported
        if Highlight.Enabled ~= HighlightEnabled then Highlight.Enabled = HighlightEnabled end
        if HighlightEnabled then
            local GlowPulse = (math.sin(Now * 7.5) + 1) * 0.5
            local ThemeFill = VisualTheme.Accent:Lerp(VisualTheme.HighlightFill, 0.45 + GlowPulse * 0.25)
            local ThemeOutline = VisualTheme.AccentBright:Lerp(VisualTheme.White, 0.30 + GlowPulse * 0.50)
            Highlight.FillColor = ThemeFill
            Highlight.FillTransparency = 0.54 - GlowPulse * 0.16
            Highlight.OutlineColor = ThemeOutline
            Highlight.OutlineTransparency = 0.005 + (1 - GlowPulse) * 0.03
        end
    end

    if CONFIG.ArcPreviewEnabled then
        local LandingShown = false
        local Segments = #Visuals.TrajectoryCore
        local ArcInterval = 1 / 20
        if Now - Visuals.ArcPointsAt >= ArcInterval then
            Visuals.ArcPointsAt = Now
            local NewPoints = SilentAim.BuildArcPreviewPoints(Data, Segments)
            Visuals.ArcPoints = NewPoints
            if NewPoints then
                local Prior = #Visuals.ArcDisplay > 0 and Visuals.ArcDisplay
                    or Visuals.ArcTarget or NewPoints
                local From = table.create(#Prior)
                for Index = 1, #Prior do From[Index] = Prior[Index] end
                From.Landing = Prior.Landing
                From.Error = Prior.Error
                From.Arrival = Prior.Arrival
                Visuals.ArcFrom = From
                Visuals.ArcTarget = NewPoints
                Visuals.ArcTransitionAt = Now
            else
                Visuals.ArcFrom = nil
                Visuals.ArcTarget = nil
                table.clear(Visuals.ArcDisplay)
            end
        end
        local Points = Visuals.ArcTarget
        local From = Visuals.ArcFrom
        if Points and From and #Points == #From then
            local Alpha = math.clamp((Now - Visuals.ArcTransitionAt) / ArcInterval, 0, 1)
            local Display = Visuals.ArcDisplay
            for Index = 1, #Points do
                Display[Index] = From[Index]:Lerp(Points[Index], Alpha)
            end
            for Index = #Points + 1, #Display do Display[Index] = nil end
            Display.Landing = From.Landing and Points.Landing
                and From.Landing:Lerp(Points.Landing, Alpha) or Points.Landing
            Display.Error = Points.Error
            Display.Arrival = Points.Arrival
            Points = Display
        end
        local Total = Points and #Points or 0
        local OnTarget = Points and Points.Error and Points.Error <= 1.9
        local ArcColor = (Data.Supported and OnTarget) and Accent or Muted
        for Index = 1, Segments do
            local Glow = Visuals.TrajectoryGlow[Index]
            local Core = Visuals.TrajectoryCore[Index]
            if Total >= 2 and Index < Total then
                local FromPoint, FromVisible = ProjectWorldPoint(Camera, Points[Index])
                local ToPoint, ToVisible = ProjectWorldPoint(Camera, Points[Index + 1])
                local Fade = Index / Total
                local Shade = ArcColor:Lerp(VisualTheme.AccentBright, Fade * 0.55)
                SetLinePair(Glow, Core, FromPoint, ToPoint, Shade,
                    FromVisible and ToVisible, 2)
            else
                Glow.Visible = false
                Core.Visible = false
            end
        end
        if CONFIG.ArcPreviewLandingMarker and Points and Points.Landing then
            local LandPoint, LandVisible = ProjectWorldPoint(Camera, Points.Landing)
            local EdgePoint = ProjectWorldPoint(Camera,
                Points.Landing + Vector3.new(1.1, 0, 0))
            local LandRadius = (EdgePoint - LandPoint).Magnitude
            if LandVisible and LandRadius >= 2 and LandRadius <= 600 then
                Visuals.TargetGlow.Position = LandPoint
                Visuals.TargetGlow.Radius = LandRadius
                Visuals.TargetGlow.Color = Background
                Visuals.TargetGlow.Visible = true
                Visuals.TargetCore.Position = LandPoint
                Visuals.TargetCore.Radius = LandRadius
                Visuals.TargetCore.Color = ArcColor
                Visuals.TargetCore.Visible = true
                LandingShown = true
            end
        end
        if not LandingShown then
            if Visuals.TargetGlow.Visible then Visuals.TargetGlow.Visible = false end
            if Visuals.TargetCore.Visible then Visuals.TargetCore.Visible = false end
        end
    end

    if CONFIG.TrajectoryPreviewEnabled then
        local Root = HumanoidRootPart
        local TextPoint, TextVisible = ProjectWorldPoint(
            Camera,
            Root.Position + Vector3.new(0, 4.7, 0)
        )
        if not Visuals.StatusValue or Now - Visuals.StatusAt >= 0.2 then
            Visuals.StatusAt = Now
            local Minimum = MinRangeForPower[Data.Power]
            local Maximum = MaxRangeForPower[Data.Power]
            local BandText = Minimum and Maximum
                and string.format('%.1f-%.1f', Minimum, Maximum)
                or '--'
            local Status = Data.Supported and 'IN RANGE' or 'OUT OF RANGE'
            Visuals.StatusValue = string.format(
                '%s  |  %.1f STUDS  |  PWR %s  |  BAND %s',
                Status,
                Data.Distance,
                tostring(Data.Power),
                BandText
            )
        end
        local Stats = Visuals.StatusValue
        Visuals.StatusShadow.Text = Stats
        Visuals.StatusShadow.Position = TextPoint + Vector2.new(1, 2)
        Visuals.StatusShadow.Color = Background
        Visuals.StatusShadow.Visible = TextVisible
        Visuals.StatusText.Text = Stats
        Visuals.StatusText.Position = TextPoint
        Visuals.StatusText.Color = Data.Supported
            and Accent or Muted
        Visuals.StatusText.Visible = TextVisible
    else
        Visuals.StatusShadow.Visible = false
        Visuals.StatusText.Visible = false
    end

    Visuals.Visible = true
end

