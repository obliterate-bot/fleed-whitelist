GiveSignal(RunService.Heartbeat:Connect(WYNF_JIT(function(DeltaTime)
    if not State.Active then return end
    State.Lifecycle:Prune(false)
    if State.Movement.WalkSpeedEnabled and not CONFIG.IcePhysics and not CONFIG.InstantDirectionSwitch then pcall(State.Movement.ApplyWalkSpeed, DeltaTime) end
    if State.Movement.AdvancedFeaturesEnabled() then pcall(State.Movement.ApplyGroundFeatures, DeltaTime) end
    if State.Movement.FakeLagMode ~= 'Off' then pcall(State.Movement.ApplyFakeLag, DeltaTime) end
    if State.Movement.JumpPowerEnabled then pcall(State.Movement.ApplyJumpPower) end
    if State.Movement.AirWalkEnabled then pcall(State.Movement.RefreshAirWalk) end
    if State.Movement.BodyCollidersEnabled
        or next(State.Movement.BodyColliderOriginals) ~= nil then
        pcall(State.Movement.StepBodyColliders, false)
    end
    if State.BallAssist.ReachEnabled or State.BallAssist.MagEnabled then
        pcall(State.BallAssist.Step, DeltaTime)
    end
    if State.BallAssist.ColliderEnabled
        or next(State.BallAssist.ColliderOriginalCanCollide) ~= nil
        or next(State.BallAssist.ColliderOriginalCanTouch) ~= nil then
        pcall(State.BallAssist.StepBallColliders, false)
    end
    if State.BallAssist.AntiReachEnabled
        or State.BallAssist.AntiReachWatchConnection ~= nil then
        pcall(State.BallAssist.StepAntiReach)
    end
    if State.BallAssist.TipOffEnabled or State.BallAssist.TipOffArmed then
        pcall(State.BallAssist.StepTipOff)
    end
    if State.Extras and State.Extras.Step then pcall(State.Extras.Step, DeltaTime) end
end)))

