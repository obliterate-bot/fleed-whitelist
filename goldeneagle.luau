    local function ApplyThemedTextGradient(TextObject, Midpoint)

        local Gradient = New('UIGradient', {
            __SkipThemeBinding = true,
            Color = ColorSequence.new(Color3.new(1, 1, 1)),
            Rotation = 0,
            }, TextObject)
        local FlatColor = Midpoint or Theme.Text
        pcall(function() TextObject.TextColor3 = FlatColor end)
        local Role = ResolveThemeRole(FlatColor) or 'Text'
        table.insert(HubUI.ThemeBindings, { Object = TextObject, Property = 'TextColor3', Role = Role })
        return Gradient
    end

