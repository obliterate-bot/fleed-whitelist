function State.ESP.UpdateSkeleton(R,Character,Camera)
    if not R.Skeleton then return end
    local Torso=Character:FindFirstChild('UpperTorso') or Character:FindFirstChild('Torso')
    local Lower=Character:FindFirstChild('LowerTorso') or Torso
    local Pairs={{'Head',Torso and Torso.Name},{Torso and Torso.Name,Lower and Lower.Name},{Torso and Torso.Name,'LeftUpperArm'},{'LeftUpperArm','LeftLowerArm'},{'LeftLowerArm','LeftHand'},{Torso and Torso.Name,'RightUpperArm'},{'RightUpperArm','RightLowerArm'},{'RightLowerArm','RightHand'},{Lower and Lower.Name,'LeftUpperLeg'},{'LeftUpperLeg','LeftLowerLeg'},{'LeftLowerLeg','LeftFoot'},{Lower and Lower.Name,'RightUpperLeg'},{'RightUpperLeg','RightLowerLeg'},{'RightLowerLeg','RightFoot'}}
    if Character:FindFirstChild('Torso') then Pairs={{'Head','Torso'},{'Torso','Left Arm'},{'Torso','Right Arm'},{'Torso','Left Leg'},{'Torso','Right Leg'}} end
    for I,Line in ipairs(R.Skeleton) do
        local Pair=Pairs[I];
        local A=Pair and Character:FindFirstChild(Pair[1]);
        local B=Pair and Character:FindFirstChild(Pair[2])
        if CONFIG.ESPSkeleton and A and B then local SA,OA=Camera:WorldToViewportPoint(A.Position);
            local SB,OB=Camera:WorldToViewportPoint(B.Position);
            Line.From=Vector2.new(SA.X,SA.Y);
            Line.To=Vector2.new(SB.X,SB.Y);
            Line.Color=Visuals.Theme.AccentBright;
            Line.Visible=OA and OB else Line.Visible=false end
    end
end

function State.ESP.Update()
    if not CONFIG.ESPEnabled then return end
    local Camera=Workspace.CurrentCamera;
    local LocalRoot=LP.Character and LP.Character:FindFirstChild('HumanoidRootPart');
    if not (Camera and LocalRoot) then return end
    local Seen={}
    local HOFCandidates={}
    for _,Player in ipairs(Players:GetPlayers()) do
        if Player~=LP and (not CONFIG.ESPTeamCheck or not LP.Team or Player.Team~=LP.Team) then
            local Character=Player.Character;
            local Root=Character and Character:FindFirstChild('HumanoidRootPart');
            local H=Character and Character:FindFirstChildOfClass('Humanoid')
            if Root and H and H.Health>0 then
                local Distance=(Root.Position-LocalRoot.Position).Magnitude
                if Distance<=math.clamp(tonumber(CONFIG.ESPMaxDistance) or 350,25,2000) then
                    local R=State.ESP.Ensure(Player,Character,Root);
                    if R then Seen[Player]=true;
                        R.Gui.Enabled=true;
                        R.Gui.Size=UDim2.fromOffset(190*(CONFIG.ESPScale or 1),110*(CONFIG.ESPScale or 1))
                        local Rank,ELO=State.ESP.GetRank(Player);
                        local W,L=State.ESP.GetRecord(Player)
                        State.ESP.UpdateSkeleton(R,Character,Camera)
                        HOFCandidates[#HOFCandidates+1]={Player=Player,ELO=ELO,Root=Root,Record=R}
                        R.Ring.Visible=CONFIG.ESPShowCircle~=false
                        R.Name.Visible=CONFIG.ESPShowName;
                        R.Name.Text=Player.DisplayName .. (CONFIG.ESPShowDistance and string.format('  [%.0fm]',Distance) or '')
                        R.Rank.Visible=CONFIG.ESPShowRank;
                        R.Rank.Text=Rank .. '  •  ' .. tostring(ELO) .. ' ELO'
                        R.Record.Visible=CONFIG.ESPShowRecord;
                        R.Record.Text=(W and L) and string.format('%dW  /  %dL',W,L) or 'RECORD  LOADING...'
                        R.Health.Visible=CONFIG.ESPShowHealth;
                        R.Fill.Size=UDim2.fromScale(math.clamp(H.Health/math.max(H.MaxHealth,1),0,1),1)
                        R.Stroke.Color=Visuals.Theme.Accent;
                        R.Highlight.Enabled=CONFIG.ESPShowHighlight
                    end
                end end end
    end
    table.sort(HOFCandidates,function(A,B) return A.ELO>B.ELO end)
    local BeamCount=math.clamp(math.floor(tonumber(CONFIG.ESPTopELOCount) or 3),1,5)
    local BeamTargets={}
    local Eligible=0
    for _,C in ipairs(HOFCandidates) do if C.ELO>=10000 and Eligible<BeamCount then Eligible+=1;
            BeamTargets[C.Player]=true end end
    local Highest=HOFCandidates[1]
    for P,R in pairs(State.ESP.Records) do
        local Data=nil;
        for _,C in ipairs(HOFCandidates) do if C.Player==P then Data=C;
                break end end
        if R.Tracer then
            if CONFIG.ESPHighestELOTracer and Highest and Highest.Player==P then local V,On=Camera:WorldToViewportPoint(Highest.Root.Position);
                R.Tracer.From=Vector2.new(Camera.ViewportSize.X*.5,Camera.ViewportSize.Y-35);
                R.Tracer.To=Vector2.new(V.X,V.Y);
                R.Tracer.Color=Visuals.Theme.AccentBright;
                R.Tracer.Visible=On else R.Tracer.Visible=false end
        end
        if R.Beacon then
            local Active=CONFIG.ESPHOFBeams and BeamTargets[P] and Data and Data.ELO>=10000
            R.Beacon.Enabled=Active==true
            if Active then if R.BeaconTop.Parent~=Camera then R.BeaconTop.Parent=Camera end;
                R.BeaconTop.CFrame=CFrame.new(Data.Root.Position+Vector3.new(0,125,0));
                R.Beacon.Color=ColorSequence.new(Visuals.Theme.AccentBright,Visuals.Theme.Accent) end
        end
        if not Seen[P] then if R.Skeleton then for _,Line in ipairs(R.Skeleton) do Line.Visible=false end end;
            if R.Tracer then R.Tracer.Visible=false end;
            if R.Beacon then R.Beacon.Enabled=false end;
            if P.Parent then R.Gui.Enabled=false;
                R.Highlight.Enabled=false else State.ESP.Destroy(P) end end
    end
end
function State.ESP.SetEnabled(Value)
    CONFIG.ESPEnabled=Value==true
    pcall(function() State.Lifecycle:UnbindFromRenderStep(State.ESP.BindName) end)
    if not CONFIG.ESPEnabled then State.ESP.Clear();
        State.ESP.Status='OFF';
        return end
    State.ESP.Status='STARTING';
    State.ESP.LastError=nil
    local FirstOk,FirstErr=pcall(State.ESP.Update)
    if not FirstOk then State.ESP.Status='ERROR';
        State.ESP.LastError=tostring(FirstErr);
        warn('[GOLDEN EAGLE ESP] '..tostring(FirstErr)) else State.ESP.Status='ACTIVE' end
    State.Lifecycle:BindToRenderStep(State.ESP.BindName,Enum.RenderPriority.Camera.Value+60,function()
        if not State.Active then return end
        local Ok,Err=pcall(State.ESP.Update)
        if not Ok then
            State.ESP.Status='ERROR'
            if State.ESP.LastError~=tostring(Err) then State.ESP.LastError=tostring(Err);
                warn('[GOLDEN EAGLE ESP] '..tostring(Err)) end
        end
    end)
end

