        local TerminalStroke = HubUI.TerminalStroke
        local function SetTerminalStatus(Message, Good)
            TerminalStatus.Text = tostring(Message)
            TerminalStatus.TextColor3 = Good == false and Theme.Bad or Theme.Muted
        end
        GiveSignal(TerminalInput.Focused:Connect(function()
            Tween(TerminalStroke, 0.12, { Color = Theme.Accent, Transparency = 0 })
        end))
        GiveSignal(TerminalInput.FocusLost:Connect(function(EnterPressed)
            Tween(TerminalStroke, 0.12, { Color = Theme.Border, Transparency = 0 })
            if not EnterPressed then return end
            local Raw = tostring(TerminalInput.Text or '')
            TerminalInput.Text = ''
            local Command, Arguments = Raw:match('^%s*(%S+)%s*(.-)%s*$')
            Command = string.lower(Command or '')
            if Command == '' then return end
            if Command == 'help' then
                SetTerminalStatus('goto <tab> | find <text> | theme <name> | close', true)
            elseif Command == 'goto' or Command == 'tab' then
                local Wanted = string.lower(Arguments)
                local Match
                for _, Definition in ipairs(TabDefinitions) do
                    if string.lower(Definition.Name) == Wanted or string.lower(Definition.DisplayName or '') == Wanted then Match = Definition.Name break end
                end
                if Match then SwitchTab(Match);
                    SetTerminalStatus('[tab] ' .. Match, true)
                else SetTerminalStatus('[error] unknown tab: ' .. Arguments, false) end
            elseif Command == 'find' or Command == 'search' then
                GlobalSearchBox.Text = Arguments
                GlobalSearchBox:CaptureFocus()
                SetTerminalStatus('[find] ' .. Arguments, true)
            elseif Command == 'theme' then
                local Wanted = string.lower(Arguments)
                local PresetName
                for Name in pairs(ThemePresets) do if string.lower(Name) == Wanted then PresetName = Name break end end
                if PresetName then
                    InterfaceConfig.ThemePreset = PresetName
                    HubUI.ApplyTheme(ThemePresets[PresetName], true)
                    SetTerminalStatus('[theme] ' .. PresetName, true)
                else SetTerminalStatus('[error] unknown theme', false) end
            elseif Command == 'clear' then
                SetTerminalStatus('[ready]  Golden Eagle', true)
            elseif Command == 'close' or Command == 'hide' then
                Main.Visible = false
            else
                SetTerminalStatus('[error] unknown command: ' .. Command, false)
            end
        end))
    end

