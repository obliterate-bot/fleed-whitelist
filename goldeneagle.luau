function State.Utility.ApplyFPSCap()
    local Cap = math.clamp(math.floor(tonumber(State.Utility.FPSCap) or 60), 15, 360)
    State.Utility.FPSCap = Cap
    CONFIG.FPSCap = Cap
    if type(setfpscap) ~= 'function' then
        State.Utility.FPSCapStatus = 'UNSUPPORTED'
        return false
    end
    if State.Utility.FPSCapOriginal == nil and type(getfpscap) == 'function' then
        local ReadOk, Original = pcall(getfpscap)
        if ReadOk and tonumber(Original) then State.Utility.FPSCapOriginal = tonumber(Original) end
    end
    local Target = State.Utility.FPSCapEnabled and Cap or (State.Utility.FPSCapOriginal or 9999)
    local Success = pcall(setfpscap, Target)
    if not Success and not State.Utility.FPSCapEnabled and Target ~= 9999 then
        Success = pcall(setfpscap, 9999)
    end
    State.Utility.FPSCapStatus = Success
        and (State.Utility.FPSCapEnabled and (tostring(Cap) .. ' FPS') or 'OFF')
        or 'FAILED'
    return Success
end

