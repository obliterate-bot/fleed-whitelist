local SilentAim = {groundDist = 0, groundY = 0, rimName = '', LastShotAt = 0}

SilentAim.MethodHooksInstalled = false

local function InstallMouseHooks()
    if SilentAim.MethodHooksInstalled then return end
    local Method = CONFIG.SilentAimMethod or 'Camera Ray Spoof'
    if Method == 'Camera Ray Spoof' then return end
    local Mouse = LP:GetMouse()
    if not Mouse then return end
    if type(hookmetamethod) ~= 'function' then return end
    SilentAim.MethodHooksInstalled = true
    pcall(function()
        local OldIndex = hookmetamethod(game, '__index', newcclosure(function(Self, Key)
            if not checkcaller() and Self == Mouse then
                if Method == 'Mouse.Hit Spoof' and Key == 'Hit' then
                    local AimTarget = SilentAim.TargetPosition
                    if AimTarget then
                        return CFrame.new(AimTarget)
                    end
                elseif Method == 'Mouse.UnitRay Spoof' and Key == 'UnitRay' then
                    local AimTarget = SilentAim.TargetPosition
                    if AimTarget then
                        local Camera = Workspace.CurrentCamera
                        if Camera then
                            local Origin = Camera.CFrame.Position
                            local Direction = (AimTarget - Origin).Unit
                            return Ray.new(Origin, Direction)
                        end
                    end
                end
            end
            return OldIndex(Self, Key)
        end))
    end)
end

