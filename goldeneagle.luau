function State.LocalSpoofs.ApplyProfile()
    if not State.LocalSpoofs.Rankings then
        local Success, Rankings = pcall(require, ReplicatedStorage.Util.Rankings)
        if Success then State.LocalSpoofs.Rankings = Rankings end
    end
    if not State.LocalSpoofs.Rankings then return end
    State.LocalSpoofs.OriginalRankImage = State.LocalSpoofs.OriginalRankImage or State.LocalSpoofs.Rankings.getRankImageFromELO
    local E = State.LocalELOSpoofEnabled and State.LocalELO or (State.LocalSpoofs.RankImageELO[State.LocalRepImage] or 0)
    local Image = State.LocalSpoofs.OriginalRankImage and State.LocalSpoofs.OriginalRankImage(E)
    local Name, Tier = State.LocalSpoofs.Rankings.getRankFromELO(E)
    local Color = State.LocalSpoofs.Rankings.getRankColorFromELO(E)
    local Minimum, Maximum = State.LocalSpoofs.Rankings.getRankMinMaxFromELO(E)
    Minimum = tonumber(Minimum) or 0
    local HasMaximum = type(Maximum) == 'number'
    Maximum = HasMaximum and Maximum or Minimum
    local RankSpoofActive = State.LocalELOSpoofEnabled or State.LocalRepImageSpoofEnabled
    for _, Object in ipairs(LP.PlayerGui:GetDescendants()) do
        if Object.Name == 'ProfileFrame' then
            local U = Object:FindFirstChild('UserName')
            local ResetButton = Object:FindFirstChild('ResetButton')
            local IsStatsProfile = U and U:IsA('TextLabel') and Object:FindFirstChild('StatsFrame')
                and Object.Parent and Object.Parent:FindFirstChild('PercentageFrame')
            local AliasText = tostring(State.LocalAlias or '')
            local IsAliasProfile = State.LocalAliasEnabled
                and (U.Text == AliasText or U.Text == ('@' .. AliasText))
            local IsLocalProfile = IsStatsProfile and ((ResetButton and ResetButton.Visible)
                or U.Text == ('@'..LP.Name) or U.Text == LP.Name or IsAliasProfile)
            if IsLocalProfile then
                State.LocalSpoofs.StatsProfileFrame = Object
                local Icon = Object:FindFirstChild('RankIcon')
                if Icon and RankSpoofActive then
                    State.LocalSpoofs.SetStatsUI(Icon, 'Image', Image)
                    local T = Icon:FindFirstChild('TierLabel')
                    if T then State.LocalSpoofs.SetStatsUI(T, 'Text', string.rep('I',Tier)) end
                    if T and T:FindFirstChild('UIGradient') then State.LocalSpoofs.SetStatsUI(T.UIGradient, 'Color', Color) end
                    local AvatarFrame = Object:FindFirstChild('AvatarFrame')
                    local AvatarStroke = AvatarFrame and AvatarFrame:FindFirstChildOfClass('UIStroke')
                    local AvatarGradient = AvatarStroke and AvatarStroke:FindFirstChildOfClass('UIGradient')
                    if AvatarGradient then State.LocalSpoofs.SetStatsUI(AvatarGradient, 'Color', Color) end
                end
                local Stats=Object:FindFirstChild('StatsFrame');
                local EF=Stats and Stats:FindFirstChild('ELO');
                local V=EF and EF:FindFirstChild('ValueLabel')
                if V and State.LocalELOSpoofEnabled then V.Text=tostring(E):reverse():gsub('%d%d%d','%1,'):reverse():gsub('^,','') end
                local R=Object:FindFirstChild('RepFrame')
                if R and RankSpoofActive then
                    local CurrentRank = R:FindFirstChild('CurrentRank')
                    if CurrentRank then
                        State.LocalSpoofs.SetStatsUI(CurrentRank, 'Text', Name..' '..string.rep('I',Tier))
                        local CurrentGradient = CurrentRank:FindFirstChildOfClass('UIGradient')
                        if CurrentGradient then State.LocalSpoofs.SetStatsUI(CurrentGradient, 'Color', Color) end
                    end
                    local P=R:FindFirstChild('ProgressLabel')
                    if P then
                        State.LocalSpoofs.SetStatsUI(P, 'Text', HasMaximum and ((E-Minimum)..'/'..(Maximum-Minimum)) or 'MAX')
                        local ProgressGradient = P:FindFirstChildOfClass('UIGradient')
                        if ProgressGradient then State.LocalSpoofs.SetStatsUI(ProgressGradient, 'Color', Color) end
                    end
                    local Fill = R:FindFirstChild('Frame')
                    if Fill then
                        local Ratio = HasMaximum and math.clamp((E-Minimum) / math.max(1, Maximum-Minimum), 0, 1) or 1
                        State.LocalSpoofs.SetStatsUI(Fill, 'Size', UDim2.fromScale(Ratio, 1))
                        local Bar = Fill:FindFirstChild('Bar')
                        if Bar then
                            State.LocalSpoofs.SetStatsUI(Bar, 'Size', UDim2.fromScale(Ratio > 0 and 1 / Ratio or 1, 1))
                            local BarGradient = Bar:FindFirstChildOfClass('UIGradient')
                            if BarGradient then State.LocalSpoofs.SetStatsUI(BarGradient, 'Color', Color) end
                        end
                    end
                end
                if State.LocalStatsSpoofEnabled then
                    local Wins = math.max(0, math.floor(tonumber(State.LocalWins) or 0))
                    local Losses = math.max(0, math.floor(tonumber(State.LocalLosses) or 0))
                    local Goals = math.max(0, math.floor(tonumber(State.LocalGoals) or 0))
                    local Attempts = math.max(0, math.floor(tonumber(State.LocalAttempts) or 0))
                    local Streak = math.max(0, math.floor(tonumber(State.LocalStreak) or 0))
                    local Highest = math.max(0, math.floor(tonumber(State.LocalHighestStreak) or 0))
                    local Shields = math.max(0, math.floor(tonumber(State.LocalShields) or 0))
                    local ShieldEXP = math.clamp(math.floor(tonumber(State.LocalShieldEXP) or 0), 0, 100)
                    local WinPercent = Wins + Losses > 0 and math.round(Wins / (Wins + Losses) * 100) or 0
                    local ShootingPercent = Attempts > 0 and math.round(Goals / Attempts * 100) or 0
                    local StreakPercent = Highest > 0 and math.round(Streak / Highest * 100) or 0
                    local Main = Object.Parent
                    local Percent = Main and Main:FindFirstChild('PercentageFrame')
                    local Stats = Object:FindFirstChild('StatsFrame')
                    if Stats then
                        local Matches = Stats:FindFirstChild('Matches')
                        local Winrate = Stats:FindFirstChild('Winrate')
                        local ELO = Stats:FindFirstChild('ELO')
                        if Matches and Matches:FindFirstChild('ValueLabel') then State.LocalSpoofs.SetStatsUI(Matches.ValueLabel, 'Text', tostring(Wins + Losses)) end
                        if Winrate and Winrate:FindFirstChild('ValueLabel') then State.LocalSpoofs.SetStatsUI(Winrate.ValueLabel, 'Text', tostring(WinPercent)) end
                    end
                    if Percent then
                        local Winrate = Percent:FindFirstChild('Winrate')
                        local Shooting = Percent:FindFirstChild('Shooting')
                        local StreakFrame = Percent:FindFirstChild('Streak')
                        if Winrate then
                            local Num = Winrate:FindFirstChild('numText');
                            if Num then State.LocalSpoofs.SetStatsUI(Num, 'Text', tostring(WinPercent)) end
                            local Amount = Winrate:FindFirstChild('AmountLabel');
                            if Amount then State.LocalSpoofs.SetStatsUI(Amount, 'Text', "W: <font color='rgb(0,255,0)'>"..Wins.."</font> | L: <font color='rgb(255,0,0)'>"..Losses.."</font>") end
                            local F = Winrate:FindFirstChild('Frame');
                            local PV = F and F:FindFirstChild('ProgressValue');
                            if PV then State.LocalSpoofs.SetStatsUI(PV, 'Value', WinPercent) end
                        end
                        if Shooting then
                            local Num = Shooting:FindFirstChild('numText');
                            if Num then State.LocalSpoofs.SetStatsUI(Num, 'Text', tostring(ShootingPercent)) end
                            local Amount = Shooting:FindFirstChild('AmountLabel');
                            if Amount then State.LocalSpoofs.SetStatsUI(Amount, 'Text', "Goals: <font color='rgb(0,255,0)'>"..Goals.."</font>/"..Attempts) end
                            local F = Shooting:FindFirstChild('Frame');
                            local PV = F and F:FindFirstChild('ProgressValue');
                            if PV then State.LocalSpoofs.SetStatsUI(PV, 'Value', ShootingPercent) end
                        end
                        if StreakFrame then
                            local Num = StreakFrame:FindFirstChild('numText');
                            if Num then State.LocalSpoofs.SetStatsUI(Num, 'Text', tostring(StreakPercent)) end
                            local Amount = StreakFrame:FindFirstChild('AmountLabel');
                            if Amount then State.LocalSpoofs.SetStatsUI(Amount, 'Text', "Highest: <font color='rgb(225,0,255)'>"..Highest.."</font>") end
                            local F = StreakFrame:FindFirstChild('Frame');
                            local PV = F and F:FindFirstChild('ProgressValue');
                            if PV then State.LocalSpoofs.SetStatsUI(PV, 'Value', StreakPercent) end
                        end
                    end
                    local SideStreak = Object:FindFirstChild('Streak')
                    if SideStreak then State.LocalSpoofs.ApplyStreakVisual(SideStreak, Streak) end
                    local ShieldFrame = Object:FindFirstChild('ShieldFrame')
                    if ShieldFrame then
                        local Description = ShieldFrame:FindFirstChild('DescriptionLabel')
                        local Progress = ShieldFrame:FindFirstChild('ProgressLabel')
                        local Fill = ShieldFrame:FindFirstChild('Frame')
                        if Description then State.LocalSpoofs.SetStatsUI(Description, 'Text', tostring(Shields)..' 🛡️') end
                        if Progress then State.LocalSpoofs.SetStatsUI(Progress, 'Text', tostring(ShieldEXP)..'/100') end
                        if Fill then
                            local Ratio = ShieldEXP / 100
                            State.LocalSpoofs.SetStatsUI(Fill, 'Size', UDim2.fromScale(Ratio, 1))
                            local Bar = Fill:FindFirstChild('Bar')
                            if Bar then State.LocalSpoofs.SetStatsUI(Bar, 'Size', UDim2.fromScale(Ratio > 0 and 1 / Ratio or 1, 1)) end
                        end
                    end
                    State.LocalSpoofs.ApplyStatsLock()
                end
            end
        end
    end
    if State.LocalStatsSpoofEnabled and LP.Character then
        for _, Record in ipairs(LP.Character:GetDescendants()) do
            if Record.Name == 'RecordLabel' and Record:IsA('TextLabel') then
                local Main = Record.Parent
                if Main and Main:FindFirstChild('RankImage') then State.LocalSpoofs.RegisterIntroBanner(Record) end
            end
        end
        State.LocalSpoofs.ApplyStatsLock()
    end
end

function State.LocalSpoofs.ResolveEffect(ItemName)
    local Folder = ReplicatedStorage:FindFirstChild('ShopItems')
    Folder = Folder and Folder:FindFirstChild('Effect')
    local Item = Folder and Folder:FindFirstChild(ItemName)
    return Item and Item:IsA('StringValue') and Item.Value or ItemName
end

function State.LocalSpoofs.ExtractGoalEffectSource(ItemName)
    ItemName = tostring(ItemName or '')
    if ItemName == '' or ItemName == 'None' or ItemName == 'Custom Lua' then
        return nil, nil, 'Select an actual game goal effect first.'
    end
    local Root = ReplicatedStorage:FindFirstChild('ScoreEffects')
    if not (Root and Root:IsA('ModuleScript')) then
        return nil, nil, 'The game ScoreEffects module was not found.'
    end
    local Syn = type(GlobalEnv.syn) == 'table' and GlobalEnv.syn or nil
    local Decompiler = type(GlobalEnv.decompile) == 'function' and GlobalEnv.decompile
        or (type(decompile) == 'function' and decompile)
        or (Syn and type(Syn.decompile) == 'function' and Syn.decompile)
    if type(Decompiler) ~= 'function' then
        return nil, nil, 'This executor does not provide decompile().'
    end
    local Resolved = tostring(State.LocalSpoofs.ResolveEffect(ItemName) or ItemName)
    local function Clean(Value)
        return string.lower(tostring(Value or ''):gsub('[^%w]', ''))
    end
    local function TryDecompile(Target)
        if Target == nil then return nil end
        local Ok, Source = pcall(Decompiler, Target)
        if Ok and type(Source) == 'string' and #Source > 16 then return Source end
        return nil
    end

    local WantedA, WantedB = Clean(Resolved), Clean(ItemName:gsub('^Effect_', ''))
    local Assets = Root:FindFirstChild('Assets')
    local Best = Assets and Assets:FindFirstChild(Resolved, true)
    if not (Best and Best:IsA('ModuleScript')) then
        Best = Root:FindFirstChild(Resolved, true)
    end
    if not (Best and Best:IsA('ModuleScript')) then Best = nil end
    for _, Descendant in ipairs(Root:GetDescendants()) do
        if Descendant:IsA('ModuleScript') then
            local Candidate = Clean(Descendant.Name)
            if Candidate == WantedA or Candidate == WantedB then
                local IsAsset = Assets and Descendant:IsDescendantOf(Assets)
                if not Best or IsAsset or tostring(Descendant.Name) == Resolved then Best = Descendant end
                if IsAsset and tostring(Descendant.Name) == Resolved then break end
            end
        end
    end
    local Source
    if Best then
        Source = TryDecompile(Best)
        if Source then
            State.LocalSpoofs.LastExtractedGoalModule = Best
            State.LocalSpoofs.LastExtractedGoalName = Resolved
            return '-- GEH_EXTRACTED_EFFECT: '..Resolved..'\n'..Source, Best:GetFullName()
        end
    end

    Source = TryDecompile(Root)
    if Source then
        State.LocalSpoofs.LastExtractedGoalModule = Root
        State.LocalSpoofs.LastExtractedGoalName = Resolved
        return '-- GEH_EXTRACTED_EFFECT: '..Resolved..'\n'..Source, Root:GetFullName() .. ' / find: ' .. Resolved
    end
    return nil, nil, 'The executor could not decompile this effect.'
end

function State.LocalSpoofs.ResolveExtractedGoalModule(Source)
    local Name = tostring(Source or ''):match('%-%-%s*GEH_EXTRACTED_EFFECT:%s*([^\r\n]+)')
    if not Name then return nil, nil end
    Name = Name:match('^%s*(.-)%s*$') or Name
    if State.LocalSpoofs.LastExtractedGoalName == Name
        and State.LocalSpoofs.LastExtractedGoalModule
        and State.LocalSpoofs.LastExtractedGoalModule.Parent then
        return State.LocalSpoofs.LastExtractedGoalModule, Name
    end
    local Root = ReplicatedStorage:FindFirstChild('ScoreEffects')
    local Assets = Root and Root:FindFirstChild('Assets')
    local Module = Assets and Assets:FindFirstChild(Name, true)
    if not (Module and Module:IsA('ModuleScript')) then
        Module = Root and Root:FindFirstChild(Name, true)
    end
    if Module and Module:IsA('ModuleScript') then return Module, Name end
    return Root, Name
end

function State.LocalSpoofs.RestoreGoalEffects()
    if not State.LocalSpoofs.ScoreEffects then return end
    for Name, Original in pairs(State.LocalSpoofs.GoalOriginals) do
        if State.LocalSpoofs.ScoreEffects[Name] == State.LocalSpoofs.GoalHooks[Name] then
            State.LocalSpoofs.ScoreEffects[Name] = Original
        end
    end
    table.clear(State.LocalSpoofs.GoalHooks)
end

function State.LocalSpoofs.CallOwnedGoalEffect(EffectFunction, Scorer, Court, Goal, ...)
    if type(EffectFunction) ~= 'function' then return end
    State.LocalSpoofs.PlayerData = State.LocalSpoofs.PlayerData or require(ReplicatedStorage.Util.PlayerData)
    local Data = State.LocalSpoofs.PlayerData.storedData
    if type(Data) ~= 'table' then return EffectFunction(Scorer, Court, Goal, ...) end
    Data.Equipping = Data.Equipping or {}
    Data.Inventory = Data.Inventory or {}
    local ItemKey = State.LocalGoalEffect
    local OldEquipped = Data.Equipping.Effect
    local OldCount = Data.Inventory[ItemKey]
    Data.Equipping.Effect = ItemKey
    Data.Inventory[ItemKey] = math.max(tonumber(OldCount) or 0, 1)
    local Results = table.pack(pcall(EffectFunction, Scorer, Court, Goal, ...))
    Data.Equipping.Effect = OldEquipped
    Data.Inventory[ItemKey] = OldCount
    if not Results[1] then error(Results[2]) end
    return table.unpack(Results, 2, Results.n)
end

function State.LocalSpoofs.CompileCustomGoalEffect(Source)
    Source = tostring(Source or '')
    if type(loadstring) ~= 'function' then return nil, 'loadstring is unavailable in this environment.' end
    local SourceModule = State.LocalSpoofs.ResolveExtractedGoalModule(Source)
    local Wrapped = "return function(Context)\n"
    .. "local Scorer, Court, Goal = Context.Scorer, Context.Court, Context.Goal\n"
    .. "local TweenService, Debris, Lighting, Workspace = Context.TweenService, Context.Debris, Context.Lighting, Context.Workspace\n"
    .. Source .. "\nend"
    local Chunk, CompileError = loadstring(Wrapped, 'GEH_CustomGoalEffect')
    if not Chunk then return nil, tostring(CompileError) end
    if type(setfenv) == 'function' then
        local SafeEnvironment = {
            game = game, workspace = workspace, script = SourceModule, require = require,
            Instance = Instance, Enum = Enum, Color3 = Color3, Vector2 = Vector2, Vector3 = Vector3,
            CFrame = CFrame, UDim = UDim, UDim2 = UDim2, Rect = Rect,
            Ray = Ray, Random = Random, BrickColor = BrickColor, Region3 = Region3,
            NumberRange = NumberRange, NumberSequence = NumberSequence, NumberSequenceKeypoint = NumberSequenceKeypoint,
            ColorSequence = ColorSequence, ColorSequenceKeypoint = ColorSequenceKeypoint,
            TweenInfo = TweenInfo, RaycastParams = RaycastParams, OverlapParams = OverlapParams,
            math = math, string = string, table = table, task = task, coroutine = coroutine, utf8 = utf8,
            pairs = pairs, ipairs = ipairs, next = next, select = select, unpack = unpack,
            wait = task.wait, tick = tick, time = time, warn = warn, print = print,
            tonumber = tonumber, tostring = tostring, type = type, typeof = typeof,
            assert = assert, error = error, pcall = pcall, xpcall = xpcall,
        }
        setmetatable(SafeEnvironment, { __index = function() return nil end })
        local EnvironmentOk, EnvironmentError = pcall(setfenv, Chunk, SafeEnvironment)
        if not EnvironmentOk then return nil, 'Could not create the custom-effect environment: '..tostring(EnvironmentError) end
    end
    local FactoryOk, EffectFunction = pcall(Chunk)
    if not FactoryOk then return nil, tostring(EffectFunction) end
    if type(EffectFunction) ~= 'function' then return nil, 'The custom effect did not compile into a function.' end
    return EffectFunction
end

function State.LocalSpoofs.RunCustomGoalEffect(Scorer, Court, Goal, ...)
    local Source = tostring(CONFIG.CustomGoalEffectLua or '')
    if State.LocalSpoofs.CustomGoalSource ~= Source or type(State.LocalSpoofs.CustomGoalFunction) ~= 'function' then
        local EffectFunction, CompileError = State.LocalSpoofs.CompileCustomGoalEffect(Source)
        if not EffectFunction then
            State.LocalSpoofs.CustomGoalFunction = nil
            State.LocalSpoofs.CustomGoalSource = nil
            warn('[GOLDEN EAGLE] Custom goal effect compile error: '..tostring(CompileError))
            Notify('CUSTOM GOAL EFFECT', 'Compile error: '..tostring(CompileError))
            return nil
        end
        State.LocalSpoofs.CustomGoalSource = Source
        State.LocalSpoofs.CustomGoalFunction = EffectFunction
    end
    local Context = {
        Scorer = Scorer, Court = Court, Goal = Goal,
        TweenService = TweenService, Debris = Debris,
        Lighting = Lighting, Workspace = Workspace,
        Arguments = table.pack(...),
    }
    local Ok, Result = pcall(State.LocalSpoofs.CustomGoalFunction, Context)
    if not Ok then
        warn('[GOLDEN EAGLE] Custom goal effect runtime error: '..tostring(Result))
        Notify('CUSTOM GOAL EFFECT', 'Runtime error: '..tostring(Result))
        return nil
    end
    local SourceModule, ExtractedName = State.LocalSpoofs.ResolveExtractedGoalModule(Source)
    if ExtractedName then
        local RunOk, RunResult
        if type(Result) == 'table' and type(Result.Execute) == 'function' then
            local VfxDirectory = SourceModule and SourceModule:FindFirstChild(ExtractedName)
            if not VfxDirectory then
                local ScoreRoot = ReplicatedStorage:FindFirstChild('ScoreEffects')
                local Assets = ScoreRoot and ScoreRoot:FindFirstChild('Assets')
                local Container = Assets and Assets:FindFirstChild(ExtractedName, true)
                if Container then
                    VfxDirectory = Container:IsA('ModuleScript') and Container:FindFirstChild(ExtractedName) or Container
                end
            end
            if not VfxDirectory then
                local Message = 'Could not find the extracted effect assets for '..tostring(ExtractedName)..'.'
                warn('[GOLDEN EAGLE] '..Message)
                Notify('CUSTOM GOAL EFFECT', Message)
                return nil
            end
            local StartingCFrame
            if Goal and Goal:IsA('BasePart') then StartingCFrame = Goal.CFrame
            elseif Goal and Goal:IsA('Model') then StartingCFrame = Goal:GetPivot() end
            if not StartingCFrame then
                local Character = Scorer and Scorer.Character
                local Root = Character and Character:FindFirstChild('HumanoidRootPart')
                StartingCFrame = Root and Root.CFrame or CFrame.new()
            end
            RunOk, RunResult = pcall(Result.Execute, {
                CourtInstance = Court,
                StartingCFrame = StartingCFrame,
                vfxDirectory = VfxDirectory,
                }, Goal)
        elseif type(Result) == 'function' then
            local Packed = { Scorer, Court, Goal }
            local Extra = Context.Arguments
            for Index = 1, (Extra.n or #Extra) do Packed[#Packed + 1] = Extra[Index] end
            RunOk, RunResult = pcall(Result, Packed)
        elseif type(Result) == 'table' and type(Result[ExtractedName]) == 'function' then
            RunOk, RunResult = pcall(Result[ExtractedName], Scorer, Court, Goal,
                table.unpack(Context.Arguments, 1, Context.Arguments.n))
        else
            RunOk, RunResult = false, 'Extracted source did not return Execute, a function, or the named effect.'
        end
        if not RunOk then
            warn('[GOLDEN EAGLE] Extracted goal effect runtime error: '..tostring(RunResult))
            Notify('CUSTOM GOAL EFFECT', 'Extracted runtime error: '..tostring(RunResult))
            return nil
        end
        return RunResult
    end
    return Result
end

function State.LocalSpoofs.ReadGoalEffectScore(Court, Goal)
    local ResolvedCourt = typeof(Court) == 'Instance' and Court or nil
    if not ResolvedCourt and typeof(Goal) == 'Instance' then
        local Node = Goal
        for _ = 1, 8 do
            if not Node then break end
            if safe_find(Node, '_CourtSettings') or safe_find(Node, 'CourtSettings') then
                ResolvedCourt = Node
                break
            end
            Node = Node.Parent
        end
    end
    if not ResolvedCourt then return nil end
    local Settings = safe_find(ResolvedCourt, '_CourtSettings')
        or safe_find(ResolvedCourt, 'CourtSettings')
    if not Settings then return nil end
    local HomeObject = safe_find(Settings, 'HomeScore')
    local AwayObject = safe_find(Settings, 'AwayScore')
    local Home = HomeObject and tonumber(HomeObject.Value)
    local Away = AwayObject and tonumber(AwayObject.Value)
    if Home == nil or Away == nil then return nil end

    local TeamName
    local PlayersFolder = safe_find(ResolvedCourt, '_CourtPlayers')
        or safe_find(ResolvedCourt, 'CourtPlayers')
    if PlayersFolder then
        for _, Slot in ipairs(PlayersFolder:GetChildren()) do
            if safe_is_a(Slot, 'ObjectValue') and Slot.Value == LP then
                TeamName = string.match(Slot.Name, '^[A-Za-z]+')
                break
            end
        end
    end
    if TeamName == 'Home' then return Home end
    if TeamName == 'Away' then return Away end
    return Home + Away
end

function State.LocalSpoofs.PlaySelectedGoalEffect(Name, Scorer, Court, Goal, Arguments)
    if Scorer == LP then pcall(State.CosmeticStudio.PlayGoalBurst, Goal) end
    if not (State.Active and State.LocalGoalEffectSpoofEnabled and Scorer == LP) then return end
    if State.LocalGoalEffect == 'None' then return end
    State.LocalSpoofs.LastMadeGoalEffectAt = os.clock()
    if State.LocalGoalEffect == 'Custom Lua' then
        State.LocalSpoofs.RunCustomGoalEffect(Scorer, Court, Goal,
            table.unpack(Arguments, 1, Arguments.n))
        return
    end
    local Selected = State.LocalSpoofs.GoalOriginals[
        State.LocalSpoofs.ResolveEffect(State.LocalGoalEffect)]
    if type(Selected) == 'function' then
        State.LocalSpoofs.CallOwnedGoalEffect(Selected, Scorer, Court, Goal,
            table.unpack(Arguments, 1, Arguments.n))
    end
end

function State.LocalSpoofs.QueueMadeGoalEffect(Name, Scorer, Court, Goal, ...)
    local RequestedAt = os.clock()
    local Arguments = table.pack(...)
    State.Lifecycle:Delay(0.06, function()
        if not (State.Active and State.LocalGoalEffectSpoofEnabled and Scorer == LP) then return end
        local PerfectAt = State.PerfectRelease and State.PerfectRelease.LastPerfectAt or 0
        local IsPerfectCallback = PerfectAt > 0 and math.abs(RequestedAt - PerfectAt) <= 0.18
        if not IsPerfectCallback then
            State.LocalSpoofs.GoalEffectGeneration = (State.LocalSpoofs.GoalEffectGeneration or 0) + 1
            State.LocalSpoofs.PlaySelectedGoalEffect(Name, Scorer, Court, Goal, Arguments)
            return
        end

        local Before = State.LocalSpoofs.ReadGoalEffectScore(Court, Goal)
        if Before == nil then return end
        State.LocalSpoofs.GoalEffectGeneration = (State.LocalSpoofs.GoalEffectGeneration or 0) + 1
        local Generation = State.LocalSpoofs.GoalEffectGeneration
        local Deadline = os.clock() + 4
        while State.Active and State.LocalGoalEffectSpoofEnabled
            and Generation == State.LocalSpoofs.GoalEffectGeneration
            and os.clock() < Deadline do
            task.wait(0.05)
            local After = State.LocalSpoofs.ReadGoalEffectScore(Court, Goal)
            if After ~= nil and After > Before then
                State.LocalSpoofs.PlaySelectedGoalEffect(Name, Scorer, Court, Goal, Arguments)
                return
            end
        end
    end)
end

function State.LocalSpoofs.SetGoalEffect(Enabled, ShouldNotify)
    State.LocalGoalEffectSpoofEnabled = Enabled == true
    State.LocalSpoofs.GoalEffectGeneration = (State.LocalSpoofs.GoalEffectGeneration or 0) + 1
    CONFIG.LocalGoalEffectSpoof = State.LocalGoalEffectSpoofEnabled
    State.LocalSpoofs.RestoreGoalEffects()
    if State.LocalGoalEffectSpoofEnabled then pcall(function()
            State.LocalSpoofs.ScoreEffects = State.LocalSpoofs.ScoreEffects or require(ReplicatedStorage.ScoreEffects)
            for Name, Effect in pairs(State.LocalSpoofs.ScoreEffects) do
                if type(Effect) == 'function' and Name ~= 'Level Up' and Name ~= 'Level Down' then
                    State.LocalSpoofs.GoalOriginals[Name] = State.LocalSpoofs.GoalOriginals[Name] or Effect
                    State.LocalSpoofs.GoalHooks[Name] = function(Scorer, Court, Goal, ...)
                        if State.Active and State.LocalGoalEffectSpoofEnabled and Scorer == LP then
                            State.LocalSpoofs.QueueMadeGoalEffect(Name, Scorer, Court, Goal, ...)
                            return nil
                        end
                        return State.LocalSpoofs.GoalOriginals[Name](Scorer, Court, Goal, ...)
                    end
                    State.LocalSpoofs.ScoreEffects[Name] = State.LocalSpoofs.GoalHooks[Name]
                end
            end
        end) end
end

