        local MenuX = 5
        local function CloseMenus()
            if HubUI.OpenMenuPopup and HubUI.OpenMenuPopup.Parent then HubUI.OpenMenuPopup.Visible = false end
            if HubUI.OpenMenuButton and HubUI.OpenMenuButton.Parent then
                HubUI.OpenMenuButton.BackgroundTransparency = 1
            end
            HubUI.OpenMenuPopup = nil
            HubUI.OpenMenuButton = nil
        end
        HubUI.CloseMenus = CloseMenus

        for _, Definition in ipairs(MenuDefinitions) do
            local MenuDefinition = Definition
            local MenuWidth = math.ceil(#MenuDefinition.Name * 6.1) + 13
            local MenuButton = New('TextButton', {
                Position = UDim2.fromOffset(MenuX, 1), Size = UDim2.fromOffset(MenuWidth, 19),
                BackgroundColor3 = Theme.SurfaceHover, BackgroundTransparency = 1,
                BorderSizePixel = 0, AutoButtonColor = false,
                Font = Enum.Font.Code, Text = MenuDefinition.Name, TextColor3 = Theme.Text, TextSize = 10,
                ZIndex = 92,
                }, MenuBar)
            local PopupHeight = #MenuDefinition.Items * 21 + 6
            local Popup = New('Frame', {
                Position = UDim2.fromOffset(MenuX, 48), Size = UDim2.fromOffset(158, PopupHeight),
                BackgroundColor3 = Theme.Panel, BorderSizePixel = 0, Visible = false, ZIndex = 120,
                }, Main)
            DarkStroke(Popup)
            for ItemIndex, Item in ipairs(MenuDefinition.Items) do
                local MenuItem = Item
                local ItemButton = New('TextButton', {
                    Position = UDim2.fromOffset(3, 3 + (ItemIndex - 1) * 21),
                    Size = UDim2.new(1, -6, 0, 20),
                    BackgroundColor3 = Theme.SurfaceHover, BackgroundTransparency = 1,
                    BorderSizePixel = 0, AutoButtonColor = false,
                    Font = Enum.Font.Code, Text = '  ' .. MenuItem[1], TextColor3 = Theme.Text,
                    TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 121,
                    }, Popup)
                GiveSignal(ItemButton.MouseEnter:Connect(function()
                    ItemButton.BackgroundTransparency = 0
                end))
                GiveSignal(ItemButton.MouseLeave:Connect(function()
                    ItemButton.BackgroundTransparency = 1
                end))
                GiveSignal(ItemButton.MouseButton1Click:Connect(function()
                    CloseMenus()
                    local Success, ErrorMessage = pcall(MenuItem[2])
                    if not Success then MenuStatus('[menu error] ' .. tostring(ErrorMessage), true) end
                end))
            end
            local function OpenThisMenu()
                if HubUI.OpenMenuPopup == Popup then CloseMenus();
                    return end
                CloseMenus()
                Popup.Visible = true
                MenuButton.BackgroundTransparency = 0
                HubUI.OpenMenuPopup = Popup
                HubUI.OpenMenuButton = MenuButton
            end
            GiveSignal(MenuButton.MouseButton1Click:Connect(OpenThisMenu))
            GiveSignal(MenuButton.MouseEnter:Connect(function()
                if HubUI.OpenMenuPopup and HubUI.OpenMenuPopup ~= Popup then OpenThisMenu()
                elseif not HubUI.OpenMenuPopup then MenuButton.BackgroundTransparency = 0 end
            end))
            GiveSignal(MenuButton.MouseLeave:Connect(function()
                if HubUI.OpenMenuButton ~= MenuButton then MenuButton.BackgroundTransparency = 1 end
            end))
            MenuX += MenuWidth
        end
        GiveSignal(UserInputService.InputBegan:Connect(function(Input, Processed)
            if not Processed and Input.KeyCode == Enum.KeyCode.Escape then CloseMenus() end
        end))
