    LeaderboardGradients = setmetatable({}, { __mode = 'k' }),
    LeaderboardStyledLabels = setmetatable({}, { __mode = 'k' }),
    OriginalTopAttributes = {},
    BannerGuiBound = false,
}
if not State.LocalSpoofs.RankImageELO[State.LocalRepImage] then State.LocalRepImage = 'Rookie 1' end

function State.LocalSpoofs.SetELO(Enabled, Value, ShouldNotify)
    Enabled = Enabled == true
    Value = math.clamp(math.floor(tonumber(Value) or 0), 0, 1000000000)
    State.LocalELOSpoofEnabled, State.LocalELO = Enabled, Value
    CONFIG.LocalELOSpoof, CONFIG.LocalELO = Enabled, Value
    State.LocalSpoofs.ApplyingELO = true
    if Enabled then
        State.ClientSettings.SetConfig('Toggle_Rank', true)
        LP:SetAttribute('Toggle_Rank', true)

        local Pulse = Value >= 1000000000 and Value - 1 or Value + 1
        LP:SetAttribute('ELO', Pulse)
        LP:SetAttribute('ELO', Value)
    else
        LP:SetAttribute('ELO', State.LocalSpoofs.OriginalELO)
        LP:SetAttribute('Toggle_Rank', State.LocalSpoofs.OriginalToggleRank)
        State.ClientSettings.SetConfig('Toggle_Rank', State.LocalSpoofs.OriginalConfigToggleRank)
    end
    State.LocalSpoofs.ApplyingELO = false
    if State.LocalSpoofs.ELOBox then State.LocalSpoofs.ELOBox.Text = tostring(Value) end
    State.Lifecycle:Defer(function()
        if State.Active then
            pcall(State.LocalSpoofs.ApplyProfile)
            pcall(State.LocalSpoofs.ApplyNativeNameTags)
        end
    end)
end

function State.LocalSpoofs.RefreshRank()
    local Current = LP:GetAttribute('ELO')
    LP:SetAttribute('ELO', Current == 1000000000 and 999999999 or (tonumber(Current) or 0) + 1)
    LP:SetAttribute('ELO', Current)
end

function State.LocalSpoofs.SetRepImage(Enabled, ImageName, ShouldNotify)
    Enabled = Enabled == true
    if State.LocalSpoofs.RankImageELO[ImageName] then State.LocalRepImage = ImageName end
    State.LocalRepImageSpoofEnabled = Enabled
    CONFIG.LocalRepImageSpoof, CONFIG.LocalRepImage = Enabled, State.LocalRepImage
    pcall(function()
        State.LocalSpoofs.Rankings = State.LocalSpoofs.Rankings or require(ReplicatedStorage.Util.Rankings)
        State.LocalSpoofs.OriginalRankImage = State.LocalSpoofs.OriginalRankImage or State.LocalSpoofs.Rankings.getRankImageFromELO

        if State.LocalSpoofs.RankImageHook
            and State.LocalSpoofs.Rankings.getRankImageFromELO == State.LocalSpoofs.RankImageHook then
            State.LocalSpoofs.Rankings.getRankImageFromELO = State.LocalSpoofs.OriginalRankImage
        end
        State.LocalSpoofs.RankImageHook = nil
        State.LocalSpoofs.ApplyProfile()
        State.LocalSpoofs.ApplyNativeNameTags()
    end)
end

function State.LocalSpoofs.SetStatsUI(Object, Property, Value)
    if not Object then return end
    State.LocalSpoofs.StatsOriginals[Object] = State.LocalSpoofs.StatsOriginals[Object] or {}
    local Saved = State.LocalSpoofs.StatsOriginals[Object]
    if Saved[Property] == nil then Saved[Property] = Object[Property] end
    Object[Property] = Value
end

function State.LocalSpoofs.ApplyStreakVisual(Streak, Value)
    if not (Streak and Streak.Parent and Streak:IsA('ImageLabel')) then return end
    local S = math.max(0, math.floor(tonumber(Value) or 0))
    State.LocalSpoofs.Rankings = State.LocalSpoofs.Rankings or require(ReplicatedStorage.Util.Rankings)
    local Image = S > 1 and (State.LocalSpoofs.Rankings.getStreakImage(S) or '') or ''
    State.LocalSpoofs.SetStatsUI(Streak, 'Image', Image)
    State.LocalSpoofs.SetStatsUI(Streak, 'Visible', S > 1)
    State.LocalSpoofs.SetStatsUI(Streak, 'ImageTransparency', 0)

    State.LocalSpoofs.SetStatsUI(Streak, 'ImageColor3', Color3.new(1, 1, 1))
    local Amount = Streak:FindFirstChild('AmountLabel', true)
        or Streak:FindFirstChildWhichIsA('TextLabel', true)
    if Amount then
        State.LocalSpoofs.SetStatsUI(Amount, 'Text', S > 0 and tostring(S) or '')
        State.LocalSpoofs.SetStatsUI(Amount, 'Visible', S > 1)
        local Gradient = Amount:FindFirstChildOfClass('UIGradient')
        if Gradient then
            State.LocalSpoofs.SetStatsUI(Gradient, 'Color', ColorSequence.new(Color3.new(1, 1, 1)))
        end
        State.LocalSpoofs.SetStatsUI(Amount, 'TextColor3', Color3.new(1, 1, 1))
    end
end

function State.LocalSpoofs.ApplyOverallVisual(Main, Value)
    if not (Main and Main.Parent) then return end
    local Overall = Main:FindFirstChild('Overall', true)
    if not Overall then return end
    local O = math.clamp(math.floor(tonumber(Value) or 0), 0, 100)
    local Angle = O * 3.6
    local LeftClip = Overall:FindFirstChild('LeftClip')
    local RightClip = Overall:FindFirstChild('RightClip')
    local Left = LeftClip and LeftClip:FindFirstChild('Left')
    local Right = RightClip and RightClip:FindFirstChild('Right')
    local LeftGradient = Left and Left:FindFirstChildOfClass('UIGradient')
    local RightGradient = Right and Right:FindFirstChildOfClass('UIGradient')
    if Angle < 180 then
        if RightGradient then State.LocalSpoofs.SetStatsUI(RightGradient, 'Rotation', Angle) end
        if LeftGradient then State.LocalSpoofs.SetStatsUI(LeftGradient, 'Rotation', 0) end
    else
        if RightGradient then State.LocalSpoofs.SetStatsUI(RightGradient, 'Rotation', 180) end
        if LeftGradient then State.LocalSpoofs.SetStatsUI(LeftGradient, 'Rotation', Angle - 180) end
    end
    local Color = Color3.fromHSV(O / 360, 1, 0.8)
    if Left and Left:IsA('ImageLabel') then State.LocalSpoofs.SetStatsUI(Left, 'ImageColor3', Color) end
    if Right and Right:IsA('ImageLabel') then State.LocalSpoofs.SetStatsUI(Right, 'ImageColor3', Color) end
    local Frame = Overall:FindFirstChild('Frame')
    local Label = Frame and Frame:FindFirstChild('TextLabel')
    if Label then State.LocalSpoofs.SetStatsUI(Label, 'Text', tostring(O)) end
    State.LocalSpoofs.SetStatsUI(Overall, 'Visible', true)
end

function State.LocalSpoofs.RestoreStatsUI()
    for Object, Properties in pairs(State.LocalSpoofs.StatsOriginals) do
        if Object and Object.Parent then
            for Property, Value in pairs(Properties) do pcall(function() Object[Property] = Value end) end
        end
    end
    table.clear(State.LocalSpoofs.StatsOriginals)
    for Object in pairs(State.LocalSpoofs.LeaderboardClones) do
        if Object and Object.Parent then pcall(function() Object:Destroy() end) end
    end
    table.clear(State.LocalSpoofs.LeaderboardClones)
    for Gradient in pairs(State.LocalSpoofs.LeaderboardGradients) do
        if Gradient and Gradient.Parent then pcall(function() Gradient:Destroy() end) end
    end
    table.clear(State.LocalSpoofs.LeaderboardGradients)
    table.clear(State.LocalSpoofs.LeaderboardStyledLabels)
    table.clear(State.LocalSpoofs.BoardRowCache)
    table.clear(State.LocalSpoofs.PedestalApplied)
    for Attribute, Snapshot in pairs(State.LocalSpoofs.OriginalTopAttributes) do
        pcall(function() LP:SetAttribute(Attribute, Snapshot.HasValue and Snapshot.Value or nil) end)
    end
    table.clear(State.LocalSpoofs.OriginalTopAttributes)
    table.clear(State.LocalSpoofs.LeaderboardRanks)
end

function State.LocalSpoofs.ParseLeaderboardColor(Value, Fallback)
    local Hex = tostring(Value or ''):gsub('#', '')
    if #Hex == 3 then Hex = Hex:sub(1, 1):rep(2) .. Hex:sub(2, 2):rep(2) .. Hex:sub(3, 3):rep(2) end
    if not string.match(Hex, '^[%x][%x][%x][%x][%x][%x]$') then return Fallback end
    return Color3.fromRGB(tonumber(Hex:sub(1, 2), 16), tonumber(Hex:sub(3, 4), 16), tonumber(Hex:sub(5, 6), 16))
end

function State.LocalSpoofs.ApplyLeaderboardColor(Label)
    if not (Label and Label.Parent and (Label:IsA('TextLabel') or Label:IsA('TextButton'))) then return end
    local Primary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LeaderboardPrimaryColor, Color3.fromRGB(255, 59, 213))
    local Secondary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LeaderboardSecondaryColor, Color3.fromRGB(53, 217, 255))
    local Mode = tostring(CONFIG.LeaderboardColorMode or 'Solid')

    State.LocalSpoofs.SetStatsUI(Label, 'TextColor3', Mode == 'Solid' and Primary or Color3.new(1, 1, 1))
    local Gradient = Label:FindFirstChild('GoldenEagleLeaderboardGradient')
    if not Gradient then
        Gradient = Instance.new('UIGradient')
        Gradient.Name = 'GoldenEagleLeaderboardGradient'
        Gradient.Parent = Label
    end
    State.LocalSpoofs.LeaderboardGradients[Gradient] = true
    State.LocalSpoofs.LeaderboardStyledLabels[Label] = true
    Gradient.Enabled = Mode ~= 'Solid'

    Gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Secondary),
        ColorSequenceKeypoint.new(1, Primary),
    })

    Gradient.Rotation = 0
    Gradient.Offset = Vector2.zero
end

function State.LocalSpoofs.ApplyPlayerListHUD()
    local PlayerGui = LP:FindFirstChildOfClass('PlayerGui')
    if not PlayerGui then return end
    for _, Row in ipairs(PlayerGui:GetDescendants()) do
        if Row:IsA('Frame') and Row.Name == LP.Name then
            local Main = Row:FindFirstChild('Main')
            local NameFrame = Main and Main:FindFirstChild('NameFrame')
            local NameLabel = NameFrame and NameFrame:FindFirstChild('TextLabel')
            if NameLabel and (NameLabel:IsA('TextLabel') or NameLabel:IsA('TextButton')) then
                State.LocalSpoofs.ApplyLeaderboardColor(NameLabel)
            end
        end
    end
end

function State.LocalSpoofs.UpdateLeaderboardGradients()
    local Mode = tostring(CONFIG.LeaderboardColorMode or 'Solid')
    local Primary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LeaderboardPrimaryColor, Color3.fromRGB(255, 59, 213))
    local Speed = math.clamp(tonumber(CONFIG.LeaderboardGradientSpeed) or 0.65, 0.05, 5)
    local Rotation = (os.clock() * Speed * 90) % 360
    for Label in pairs(State.LocalSpoofs.LeaderboardStyledLabels) do
        if not (Label and Label.Parent) then
            State.LocalSpoofs.LeaderboardStyledLabels[Label] = nil
        else

            Label.TextColor3 = Mode == 'Solid' and Primary or Color3.new(1, 1, 1)
        end
    end
    for Gradient in pairs(State.LocalSpoofs.LeaderboardGradients) do
        if not (Gradient and Gradient.Parent) then
            State.LocalSpoofs.LeaderboardGradients[Gradient] = nil
        else
            Gradient.Enabled = Mode ~= 'Solid'
            Gradient.Offset = Vector2.zero
            Gradient.Rotation = Mode == 'Animated Gradient' and Rotation or 0
        end
    end
end

function State.LocalSpoofs.SetStatsSpoof(Enabled)
    State.LocalStatsSpoofEnabled = Enabled == true
    CONFIG.LocalStatsSpoof = State.LocalStatsSpoofEnabled
    pcall(function() State.Lifecycle:UnbindFromRenderStep('GoldenEagleProfileStatsLock') end)
    pcall(function() State.Lifecycle:UnbindFromRenderStep('GoldenEagleLeaderboardGradient') end)
    if State.LocalStatsSpoofEnabled then
        pcall(State.LocalSpoofs.ApplyProfile)
        State.Lifecycle:BindToRenderStep('GoldenEagleProfileStatsLock', Enum.RenderPriority.Last.Value + 10, WYNF_JIT(function()
            if State.Active and State.LocalStatsSpoofEnabled then
                local Now = os.clock()
                if Now - (State.LocalSpoofs.StatsLockAt or 0) >= 0.2 then
                    State.LocalSpoofs.StatsLockAt = Now
                    pcall(State.LocalSpoofs.ApplyStatsLock)
                end
            end
        end))
        State.Lifecycle:BindToRenderStep('GoldenEagleLeaderboardGradient', Enum.RenderPriority.Last.Value + 11, WYNF_JIT(function()
            if State.Active and State.LocalStatsSpoofEnabled then pcall(State.LocalSpoofs.UpdateLeaderboardGradients) end
        end))
    else
        State.LocalSpoofs.RestoreStatsUI()
        State.LocalSpoofs.StatsProfileFrame = nil
    end
end

function State.LocalSpoofs.SnapshotTopAttribute(Attribute)
    if State.LocalSpoofs.OriginalTopAttributes[Attribute] then return end
    local Value = LP:GetAttribute(Attribute)
    State.LocalSpoofs.OriginalTopAttributes[Attribute] = { HasValue = Value ~= nil, Value = Value }
end

function State.LocalSpoofs.GetBoardValue(BoardName)
    if BoardName == 'Wins' then return math.max(0, math.floor(tonumber(State.LocalWins) or 0)) end
    if BoardName == 'HighestStreak' or BoardName == 'Streak' then

        return math.max(0, math.floor(tonumber(State.LocalHighestStreak) or 0), math.floor(tonumber(State.LocalStreak) or 0))
    end
    if BoardName == 'Donation' then return math.max(0, math.floor(tonumber(State.LocalDonation) or 0)) end
    return math.max(0, math.floor(tonumber(State.LocalELOSpoofEnabled and State.LocalELO or LP:GetAttribute('ELO')) or 0))
end

function State.LocalSpoofs.BoardFolderMap()
    return { Wins = 'Wins', ELO = 'ELO', HighestStreak = 'HighestStreak', Streak = 'Streak', Donation = 'Donation' }
end

function State.LocalSpoofs.BoardPeriodNames()
    return { 'AllTime', 'Temporary' }
end

function State.LocalSpoofs.IsBoardPeriodName(Name)
    return Name == 'AllTime' or Name == 'Temporary'
end

function State.LocalSpoofs.DetectLeaderboardType(ListFrame)
    if not ListFrame then return nil end
    local Period, Node = nil, ListFrame
    for _ = 1, 8 do
        if not Node then break end
        if State.LocalSpoofs.IsBoardPeriodName(Node.Name) then Period = Node end
        Node = Node.Parent
    end
    if not Period then return nil end
    local Folder = Period.Parent
    if not Folder then return nil end
    return State.LocalSpoofs.BoardFolderMap()[Folder.Name]
end

function State.LocalSpoofs.RegisterLeaderboardList(Object)
    if not (Object and Object.Name == 'ListFrame') then return end
    State.LocalSpoofs.LeaderboardCandidates[Object] = true
    local BoardName = State.LocalSpoofs.DetectLeaderboardType(Object)
    if BoardName then State.LocalSpoofs.LeaderboardLists[Object] = BoardName end
end

function State.LocalSpoofs.DiscoverWorldLeaderboards()
    local Now = os.clock()
    if Now - (State.LocalSpoofs.WorldBoardScanAt or -math.huge) < 4 then return end
    State.LocalSpoofs.WorldBoardScanAt = Now
    local Root = Workspace:FindFirstChild('Leaderboards')
    if Root then
        for FolderName in pairs(State.LocalSpoofs.BoardFolderMap()) do
            local Folder = Root:FindFirstChild(FolderName)
            if Folder then
                for _, PeriodName in ipairs(State.LocalSpoofs.BoardPeriodNames()) do
                    local Period = Folder:FindFirstChild(PeriodName)
                    local Gui = Period and Period:FindFirstChild('ScreenGui')
                    local Bottom = Gui and Gui:FindFirstChild('Bottom')
                    local ListFrame = Bottom and Bottom:FindFirstChild('ListFrame')
                    if not ListFrame and Period then ListFrame = Period:FindFirstChild('ListFrame', true) end
                    if ListFrame then State.LocalSpoofs.RegisterLeaderboardList(ListFrame) end
                end
            end
        end
    end
    if not State.LocalSpoofs.WorldBoardConnectionBound then
        State.LocalSpoofs.WorldBoardConnectionBound = true
        GiveSignal(Workspace.DescendantAdded:Connect(function(Object)
            local ListFrame = Object.Name == 'ListFrame' and Object or Object:FindFirstAncestor('ListFrame')
            if ListFrame then
                State.Lifecycle:Delay(0.35, function()
                    if ListFrame and ListFrame.Parent then State.LocalSpoofs.RegisterLeaderboardList(ListFrame) end
                end)
            end
        end))
    end
end

function State.LocalSpoofs.ReadBoardRow(Row)
    local PlayerName = Row:FindFirstChild('playername', true)
    if not (PlayerName and (PlayerName:IsA('TextLabel') or PlayerName:IsA('TextButton'))) then return nil end
    return {
        Row = Row,
        PlayerName = PlayerName,
        ValueLabel = Row:FindFirstChild('value', true),
        RankLabel = Row:FindFirstChild('rank', true),
        Icon = (Row:FindFirstChild('Frame') and Row.Frame:FindFirstChild('playerIcon')) or Row:FindFirstChild('playerIcon', true),
        Order = tonumber(Row.Name) or math.huge,
    }
end

function State.LocalSpoofs.FindBoardPedestals(BoardName)
    local Map = Workspace:FindFirstChild('Map')
    local Extra = Map and Map:FindFirstChild('Extra')
    local Root = Extra and Extra:FindFirstChild('Leaderboards')
    local Folder = Root and Root:FindFirstChild(BoardName)
    return Folder and Folder:FindFirstChild('Pedestals') or nil
end

function State.LocalSpoofs.PedestalLabelText(BoardName, Value)
    if BoardName == 'Donation' then return ' ' .. Value .. ' Donated' end
    if BoardName == 'HighestStreak' or BoardName == 'Streak' then return Value .. ' Highest Streak' end
    return Value .. ' ' .. BoardName
end

function State.LocalSpoofs.PatchBoardPedestal(Pedestals, Slot, BoardName, Entry)
    if not (Pedestals and Entry) then return end
    local Dummy = Pedestals:FindFirstChild('PedestalDummy' .. tostring(Slot))
    local RootPart = Dummy and Dummy:FindFirstChild('HumanoidRootPart')
    local Billboard = RootPart and RootPart:FindFirstChild('BillboardGui')
    if not Billboard then return end
    local NameLabel = Billboard:FindFirstChild('NameLabel')
    local ValueLabel = Billboard:FindFirstChild('TextLabel')
    local Clean = tostring(Entry.Name or ''):gsub('^@', '')
    if NameLabel and (NameLabel:IsA('TextLabel') or NameLabel:IsA('TextButton')) then
        State.LocalSpoofs.SetStatsUI(NameLabel, 'Text', Clean)
    end
    if ValueLabel and (ValueLabel:IsA('TextLabel') or ValueLabel:IsA('TextButton')) then
        State.LocalSpoofs.SetStatsUI(ValueLabel, 'Text', State.LocalSpoofs.PedestalLabelText(BoardName, tostring(Entry.Value or '0')))
    end
    local UserId = tonumber(Entry.UserId)
    local Humanoid = Dummy and Dummy:FindFirstChildWhichIsA('Humanoid')
    if not (UserId and UserId > 0 and Humanoid) then return end
    if State.LocalSpoofs.PedestalApplied[Dummy] == UserId then return end
    State.LocalSpoofs.PedestalApplied[Dummy] = UserId
    State.Lifecycle:Spawn(function()
        local Ok, Description = pcall(function()
            return game:GetService('Players'):GetHumanoidDescriptionFromUserId(UserId)
        end)
        if Ok and Description and Dummy.Parent and Humanoid.Parent then
            pcall(function() Humanoid:ApplyDescription(Description) end)
        end
    end)
end

function State.LocalSpoofs.PatchLeaderboardList(ListFrame, BoardName)
    if not (ListFrame and ListFrame.Parent) then return end
    local Value = State.LocalSpoofs.GetBoardValue(BoardName)

    local Slots = {}
    for _, Row in ipairs(ListFrame:GetChildren()) do
        if Row:IsA('GuiObject') then
            local Data = State.LocalSpoofs.ReadBoardRow(Row)
            if Data then table.insert(Slots, Data) end
        end
    end
    if #Slots == 0 then return end
    table.sort(Slots, function(A, B) return A.Order < B.Order end)

    local Cache = State.LocalSpoofs.BoardRowCache[ListFrame]
    if not Cache then
        Cache = {}
        for Index, Data in ipairs(Slots) do
            local Image = (Data.Icon and Data.Icon:IsA('ImageLabel')) and Data.Icon.Image or nil
            Cache[Index] = {
                Name = Data.PlayerName and tostring(Data.PlayerName.Text or '') or '',
                Value = Data.ValueLabel and tostring(Data.ValueLabel.Text or '') or '',
                Image = Image,
                UserId = Image and tonumber(string.match(tostring(Image), 'userId=(%d+)')) or nil,
            }
        end
        State.LocalSpoofs.BoardRowCache[ListFrame] = Cache
    end

    local Entries = {}
    for _, Row in ipairs(Cache) do
        local Clean = tostring(Row.Name):gsub('^@', '')
        if Clean ~= LP.Name then
            local Numeric = tonumber((tostring(Row.Value):gsub('[^%d%-]', ''))) or -math.huge
            table.insert(Entries, { Name = Row.Name, Value = Row.Value, Numeric = Numeric, Image = Row.Image, UserId = Row.UserId })
        end
    end

    local Headshot = 'https://www.roblox.com/headshot-thumbnail/image?userId=' .. LP.UserId .. '&width=150&height=150&format=png'
    local Placement = 1
    for _, Entry in ipairs(Entries) do
        if Entry.Numeric > Value then Placement += 1 end
    end
    table.insert(Entries, math.min(Placement, #Entries + 1), {
        Name = '@' .. LP.Name, Value = tostring(Value), Numeric = Value, Image = Headshot, UserId = LP.UserId,
    })

    for Index, Data in ipairs(Slots) do
        local Entry = Entries[Index]
        if Entry then
            if Data.PlayerName then State.LocalSpoofs.SetStatsUI(Data.PlayerName, 'Text', Entry.Name) end
            if Data.ValueLabel then State.LocalSpoofs.SetStatsUI(Data.ValueLabel, 'Text', Entry.Value) end
            if Data.RankLabel then State.LocalSpoofs.SetStatsUI(Data.RankLabel, 'Text', tostring(Index)) end
            if Entry.UserId == LP.UserId then
                State.LocalSpoofs.ApplyLeaderboardColor(Data.PlayerName)
                State.LocalSpoofs.ApplyLeaderboardColor(Data.ValueLabel)
                State.LocalSpoofs.ApplyLeaderboardColor(Data.RankLabel)
            end
            if Data.Icon and Data.Icon:IsA('ImageLabel') and Entry.Image then
                State.LocalSpoofs.SetStatsUI(Data.Icon, 'Image', Entry.Image)
            end
        end
    end

    State.LocalSpoofs.LeaderboardRanks[BoardName] = math.min(State.LocalSpoofs.LeaderboardRanks[BoardName] or Placement, Placement)

    local Gui = ListFrame.Parent and ListFrame.Parent.Parent
    if not (Gui and Gui:FindFirstChild('Top')) then
        Gui = ListFrame:FindFirstAncestorWhichIsA('SurfaceGui') or ListFrame:FindFirstAncestorWhichIsA('ScreenGui')
    end
    local Top = Gui and Gui:FindFirstChild('Top', true)
    local Pedestals = State.LocalSpoofs.FindBoardPedestals(BoardName)
    for Slot = 1, 3 do
        local Entry = Entries[Slot]
        if Entry then
            local Podium = Top and Top:FindFirstChild(tostring(Slot))
            local TopIcon = Podium and Podium:FindFirstChild('playerIcon', true)
            if TopIcon and TopIcon:IsA('ImageLabel') and Entry.Image then
                State.LocalSpoofs.SetStatsUI(TopIcon, 'Image', Entry.Image)
            end
            if Entry.UserId == LP.UserId and Podium then
                for _, Label in ipairs(Podium:GetDescendants()) do
                    if Label:IsA('TextLabel') or Label:IsA('TextButton') then
                        State.LocalSpoofs.ApplyLeaderboardColor(Label)
                    end
                end
            end
            State.LocalSpoofs.PatchBoardPedestal(Pedestals, Slot, BoardName, Entry)
        end
    end
end

function State.LocalSpoofs.FindLocalNameTagMain(Banner)
    if not (Banner and Banner.Parent) then return nil end
    local Main = (Banner.Name == 'MainFrame' or Banner.Name == 'GameFrame') and Banner or Banner.Parent
    if Main.Name ~= 'MainFrame' and Main.Name ~= 'GameFrame' then
        Main = Banner:FindFirstAncestor('MainFrame') or Banner:FindFirstAncestor('GameFrame')
    end
    if not Main then return nil end
    local NameTag = Main.Parent
    local Adornee = NameTag and NameTag:IsA('BillboardGui') and (NameTag.Adornee or NameTag.Parent)
    if Adornee and LP.Character and Adornee:IsDescendantOf(LP.Character) then return Main end
    for _, Descendant in ipairs(Main:GetDescendants()) do
        if Descendant:IsA('TextLabel') or Descendant:IsA('TextButton') then
            local Text = tostring(Descendant.Text or '')
            if Text == LP.Name or Text == LP.DisplayName or Text == ('@' .. LP.Name)
                or (State.LocalAliasEnabled and Text == tostring(State.LocalAlias)) then return Main end
        end
    end
    return nil
end

function State.LocalSpoofs.RegisterNativeNameTag(Banner)
    local Main = State.LocalSpoofs.FindLocalNameTagMain(Banner)
    if not Main then return end
    local Record = Main:FindFirstChild('RecordLabel', true) or Main:FindFirstChild('Record', true)
    if not (Record and (Record:IsA('TextLabel') or Record:IsA('TextButton'))) then
        for _, Descendant in ipairs(Main:GetDescendants()) do
            if (Descendant:IsA('TextLabel') or Descendant:IsA('TextButton'))
                and string.match(tostring(Descendant.Text or ''), '^%s*%d+%s*[-–]%s*%d+%s*$') then Record = Descendant;
                break end
        end
    end
    local Streak = Main:FindFirstChild('Streak', true) or Main:FindFirstChild('StreakIcon', true)
    local Amount = Streak and (Streak:FindFirstChild('AmountLabel', true) or Streak:FindFirstChildWhichIsA('TextLabel', true))
    local RankImage = Main:FindFirstChild('RankImage', true) or Main:FindFirstChild('RankIcon', true)
    local RankLabel = Main:FindFirstChild('RankLabel', true)
    if not RankImage then
        for _, Descendant in ipairs(Main:GetDescendants()) do
            local Name = string.lower(Descendant.Name)
            if Descendant:IsA('ImageLabel') and not string.find(Name, 'streak', 1, true)
                and (string.find(Name, 'rank', 1, true) or string.find(Name, 'rep', 1, true)
                or string.find(Name, 'league', 1, true)) then
                RankImage = Descendant
                break
            end
        end
    end
    State.LocalSpoofs.StatsNativeNameTags[Main] = {
        Record=Record, Streak=Streak, Amount=Amount, RankImage=RankImage, RankLabel=RankLabel,
    }
    if Record then State.LocalSpoofs.SetStatsUI(Record, 'Text', Record.Text) end
    if Amount then State.LocalSpoofs.SetStatsUI(Amount, 'Text', Amount.Text) end
    if Streak and Streak:IsA('ImageLabel') then State.LocalSpoofs.SetStatsUI(Streak, 'Image', Streak.Image) end
    if RankImage and RankImage:IsA('ImageLabel') then State.LocalSpoofs.SetStatsUI(RankImage, 'Image', RankImage.Image) end
    if RankLabel and RankLabel:IsA('TextLabel') then State.LocalSpoofs.SetStatsUI(RankLabel, 'Text', RankLabel.Text) end
end

function State.LocalSpoofs.ApplyNativeNameTags()
    local CollectionService = game:GetService('CollectionService')
    for _, Banner in ipairs(CollectionService:GetTagged('Banners')) do State.LocalSpoofs.RegisterNativeNameTag(Banner) end

    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    local NameTag = Root and Root:FindFirstChild('NameTag')
    if NameTag then
        local MainFrame = NameTag:FindFirstChild('MainFrame')
        local GameFrame = NameTag:FindFirstChild('GameFrame')
        if MainFrame then State.LocalSpoofs.RegisterNativeNameTag(MainFrame) end
        if GameFrame then State.LocalSpoofs.RegisterNativeNameTag(GameFrame) end
    end
    local W = math.max(0, math.floor(tonumber(State.LocalWins) or 0))
    local L = math.max(0, math.floor(tonumber(State.LocalLosses) or 0))
    local S = math.max(0, math.floor(tonumber(State.LocalStreak) or 0))
    local E = State.LocalELOSpoofEnabled and State.LocalELO
        or (State.LocalRepImageSpoofEnabled and (State.LocalSpoofs.RankImageELO[State.LocalRepImage] or 0))
        or (LP:GetAttribute('ELO') or 0)
    State.LocalSpoofs.Rankings = State.LocalSpoofs.Rankings or require(ReplicatedStorage.Util.Rankings)
    for Main, Fields in pairs(State.LocalSpoofs.StatsNativeNameTags) do
        if Main and Main.Parent then
            if State.LocalStatsSpoofEnabled and Fields.Record and Fields.Record.Parent then State.LocalSpoofs.SetStatsUI(Fields.Record, 'Text', W .. ' - ' .. L) end
            if State.LocalStatsSpoofEnabled and Fields.Amount and Fields.Amount.Parent then State.LocalSpoofs.SetStatsUI(Fields.Amount, 'Text', S > 0 and tostring(S) or '') end
            if State.LocalStatsSpoofEnabled and Fields.Streak and Fields.Streak.Parent and Fields.Streak:IsA('ImageLabel') then
                State.LocalSpoofs.ApplyStreakVisual(Fields.Streak, S)
            end
            if (State.LocalELOSpoofEnabled or State.LocalRepImageSpoofEnabled)
                and Fields.RankImage and Fields.RankImage.Parent and Fields.RankImage:IsA('ImageLabel') then
                local RepImage = State.LocalSpoofs.OriginalRankImage
                    and State.LocalSpoofs.OriginalRankImage(E)
                    or State.LocalSpoofs.Rankings.getRankImageFromELO(E)
                State.LocalSpoofs.SetStatsUI(Fields.RankImage, 'Image', RepImage or '')
                State.LocalSpoofs.SetStatsUI(Fields.RankImage, 'Visible', true)
                State.LocalSpoofs.SetStatsUI(Fields.RankImage, 'ImageTransparency', 0)
                local Holder = Fields.RankImage.Parent
                while Holder and Holder ~= Main do
                    local HolderName = string.lower(Holder.Name)
                    if Holder:IsA('GuiObject') and (string.find(HolderName, 'rank', 1, true)
                        or string.find(HolderName, 'rep', 1, true) or string.find(HolderName, 'league', 1, true)) then
                        State.LocalSpoofs.SetStatsUI(Holder, 'Visible', true)
                    end
                    Holder = Holder.Parent
                end
            end
            if (State.LocalELOSpoofEnabled or State.LocalRepImageSpoofEnabled)
                and Fields.RankLabel and Fields.RankLabel.Parent and Fields.RankLabel:IsA('TextLabel') then
                local RankName, RankTier = State.LocalSpoofs.Rankings.getRankFromELO(E)
                State.LocalSpoofs.SetStatsUI(Fields.RankLabel, 'Text', tostring(RankName) .. ' ' .. string.rep('I', tonumber(RankTier) or 0))
                State.LocalSpoofs.SetStatsUI(Fields.RankLabel, 'Visible', true)
            end
        end
    end
end

function State.LocalSpoofs.ApplyGlobalLeaderboards()
    State.LocalSpoofs.DiscoverWorldLeaderboards()
    State.LocalSpoofs.LeaderboardRanks = {}
    for ListFrame in pairs(State.LocalSpoofs.LeaderboardCandidates) do
        if ListFrame and ListFrame.Parent and not State.LocalSpoofs.LeaderboardLists[ListFrame] then
            local BoardName = State.LocalSpoofs.DetectLeaderboardType(ListFrame)
            if BoardName then State.LocalSpoofs.LeaderboardLists[ListFrame] = BoardName end
        end
    end
    for ListFrame, BoardName in pairs(State.LocalSpoofs.LeaderboardLists) do
        if ListFrame and ListFrame.Parent then State.LocalSpoofs.PatchLeaderboardList(ListFrame, BoardName) end
    end
    for _, BoardName in ipairs({ 'Wins','HighestStreak','ELO' }) do
        local Rank = State.LocalSpoofs.LeaderboardRanks[BoardName]
        local Attribute = BoardName == 'HighestStreak' and 'TopHighestStreak' or ('Top' .. BoardName)
        State.LocalSpoofs.SnapshotTopAttribute(Attribute)
        if Rank then LP:SetAttribute(Attribute, Rank) end
    end
end

function State.LocalSpoofs.ApplyStatsLock()
    local W = math.max(0, math.floor(tonumber(State.LocalWins) or 0))
    local L = math.max(0, math.floor(tonumber(State.LocalLosses) or 0))
    local G = math.max(0, math.floor(tonumber(State.LocalGoals) or 0))
    local A = math.max(0, math.floor(tonumber(State.LocalAttempts) or 0))
    local S = math.max(0, math.floor(tonumber(State.LocalStreak) or 0))
    local H = math.max(0, math.floor(tonumber(State.LocalHighestStreak) or 0))
    local WP = W + L > 0 and math.round(W / (W + L) * 100) or 0
    local SP = A > 0 and math.round(G / A * 100) or 0
    local STP = H > 0 and math.round(S / H * 100) or 0
    local Object = State.LocalSpoofs.StatsProfileFrame
    local Now = os.clock()
    if Now - (State.LocalSpoofs.LeaderboardPatchAt or 0) >= 0.8 then
        State.LocalSpoofs.LeaderboardPatchAt = Now
        pcall(State.LocalSpoofs.ApplyGlobalLeaderboards)
        pcall(State.LocalSpoofs.ApplyPlayerListHUD)
        pcall(State.LocalSpoofs.ApplyNativeNameTags)
        State.LocalSpoofs.ScanBannerRoot(LP.PlayerGui)
        if LP.Character then State.LocalSpoofs.ScanBannerRoot(LP.Character) end
    end
    if Object and Object.Parent then
        local Main = Object.Parent
        local Percent = Main:FindFirstChild('PercentageFrame')
        local Stats = Object:FindFirstChild('StatsFrame')
        if Stats then
            local Matches = Stats:FindFirstChild('Matches')
            local Winrate = Stats:FindFirstChild('Winrate')
            if Matches and Matches:FindFirstChild('ValueLabel') then
                State.LocalSpoofs.SetStatsUI(Matches.ValueLabel, 'Text', tostring(W + L))
            end
            if Winrate and Winrate:FindFirstChild('ValueLabel') then
                State.LocalSpoofs.SetStatsUI(Winrate.ValueLabel, 'Text', tostring(WP))
            end
        end
        local function LockCard(Card, Value, Text)
            if not Card then return end
            local Num = Card:FindFirstChild('numText')
            local Amount = Card:FindFirstChild('AmountLabel')
            local Frame = Card:FindFirstChild('Frame')
            local Progress = Frame and Frame:FindFirstChild('ProgressValue')
            if Num then State.LocalSpoofs.SetStatsUI(Num, 'Text', tostring(Value) .. '%') end
            if Amount then State.LocalSpoofs.SetStatsUI(Amount, 'Text', Text) end
            if Progress then State.LocalSpoofs.SetStatsUI(Progress, 'Value', Value) end
        end
        if Percent then
            LockCard(Percent:FindFirstChild('Winrate'), WP, "W: <font color='rgb(0,255,0)'>" .. W .. "</font> | L: <font color='rgb(255,0,0)'>" .. L .. "</font>")
            LockCard(Percent:FindFirstChild('Shooting'), SP, "Goals: <font color='rgb(0,255,0)'>" .. G .. "</font>/" .. A)
            LockCard(Percent:FindFirstChild('Streak'), STP, "Highest: <font color='rgb(225,0,255)'>" .. H .. "</font>")
        end
        local SideStreak = Object:FindFirstChild('Streak')
        if SideStreak then State.LocalSpoofs.ApplyStreakVisual(SideStreak, S) end
    end
    for Main in pairs(State.LocalSpoofs.StatsIntroCards) do
        if Main and Main.Parent then
            State.LocalSpoofs.ApplyOverallVisual(Main, State.LocalOverall)
            local Record = Main:FindFirstChild('RecordLabel')
            local Streak = Main:FindFirstChild('Streak')
            local Amount = Streak and Streak:FindFirstChild('AmountLabel')
            if Record then State.LocalSpoofs.SetStatsUI(Record, 'Text', W .. ' - ' .. L) end
            if Amount then State.LocalSpoofs.SetStatsUI(Amount, 'Text', S > 0 and tostring(S) or '') end
            State.LocalSpoofs.Rankings = State.LocalSpoofs.Rankings or require(ReplicatedStorage.Util.Rankings)
            if Streak and Streak:IsA('ImageLabel') then
                State.LocalSpoofs.ApplyStreakVisual(Streak, S)
            end
            local E = State.LocalELOSpoofEnabled and State.LocalELO
                or (State.LocalRepImageSpoofEnabled and (State.LocalSpoofs.RankImageELO[State.LocalRepImage] or 0))
                or (LP:GetAttribute('ELO') or 0)
            local RankImage = Main:FindFirstChild('RankImage')
            if RankImage and RankImage:IsA('ImageLabel') then
                local Image = State.LocalSpoofs.OriginalRankImage and State.LocalSpoofs.OriginalRankImage(E)
                    or State.LocalSpoofs.Rankings.getRankImageFromELO(E)
                State.LocalSpoofs.SetStatsUI(RankImage, 'Image', Image or '')
            end
            local RankLabel = Main:FindFirstChild('RankLabel')
            if RankLabel and RankLabel:IsA('TextLabel') then
                local RankName, RankTier = State.LocalSpoofs.Rankings.getRankFromELO(E)
                State.LocalSpoofs.SetStatsUI(RankLabel, 'Text', tostring(RankName) .. ' ' .. string.rep('I', tonumber(RankTier) or 0))
            end
        end
    end
end

