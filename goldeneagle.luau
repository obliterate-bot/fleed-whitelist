            GiveSignal(ModeButton.MouseButton1Click:Connect(function() self:CycleMode(Entry) end))
            GiveSignal(KeyButton.MouseButton1Click:Connect(function() self:BeginCapture(Entry) end))
            GiveSignal(ClearButton.MouseButton1Click:Connect(function() self:SetKey(Entry, nil, true) end))
            GiveSignal(Row.MouseEnter:Connect(function() Tween(Row, 0.1, { BackgroundTransparency = 0.08 }) end))
            GiveSignal(Row.MouseLeave:Connect(function() MotionOut(Row, 0.1, { BackgroundTransparency = 0.34 }) end))
            self.RowControls[Entry.Id] = {
                Row = Row, Label = Label, Meta = Meta, MobileButton = MobileButton,
                VisibilityButton = VisibilityButton, ModeButton = ModeButton,
                KeyButton = KeyButton, ClearButton = ClearButton,
