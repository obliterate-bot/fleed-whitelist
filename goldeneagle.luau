    end
    return nil
end

function State.Extras.GetTravelObjectCFrame(Object)
    if safe_is_a(Object, 'BasePart') then return Object.CFrame end
    if safe_is_a(Object, 'Model') then
        local Positions = safe_find(Object, '_CourtPositions')
        local Center = (Positions and safe_find(Positions, 'Center')) or safe_find(Object, 'Center')
            or safe_find(Object, 'Floor') or safe_find(Object, 'Base')
        if safe_is_a(Center, 'BasePart') then return Center.CFrame end
        local Ok, Pivot = pcall(Object.GetPivot, Object)
        if Ok and typeof(Pivot) == 'CFrame' then return Pivot end
    end
    local Part = Object and Object:FindFirstChildWhichIsA('BasePart', true)
    return Part and Part.CFrame or nil
end

function State.Extras.GetTravelCourts()
    local Courts = safe_find(Workspace, 'Courts')
    local Results = {}
    if Courts then
        for _, Court in ipairs(Courts:GetChildren()) do
            if safe_is_a(Court, 'Model') then table.insert(Results, Court) end
        end
        table.sort(Results, function(A, B)
            return string.lower(A.Name) < string.lower(B.Name)
        end)
    end
    return Results
end

function State.Extras.GetCourtByTravelName(Name)
    local Wanted = string.lower(tostring(Name or ''):gsub('_', ' '))
    for _, Court in ipairs(State.Extras.GetTravelCourts()) do
