    local function CalculateFitScale()
        local Camera = Workspace.CurrentCamera
        if not Camera then return 1 end
        local Viewport = Camera.ViewportSize

        local Fit = math.min((Viewport.X - 20) / 580, (Viewport.Y - 20) / 620)
        return math.clamp(Fit, 0.4, 1.35)
    end

    local function SaveWindowPosition()
        PreferredWindowPosition = Main.Position
        GlobalEnv.__GOLDEN_EAGLE_UI_POSITION = {
            XScale = Main.Position.X.Scale,
            XOffset = Main.Position.X.Offset,
            YScale = Main.Position.Y.Scale,
            YOffset = Main.Position.Y.Offset,
        }
    end

    local EffectiveScale

    local function ClampWindowToViewport()
        local Camera = Workspace.CurrentCamera
        if not Camera then return end
        local Viewport = Camera.ViewportSize
        local Scale = EffectiveScale()
        local HalfWidth = 290 * Scale
        local HalfHeight = 310 * Scale
        local CenterX = Viewport.X * Main.Position.X.Scale + Main.Position.X.Offset
        local CenterY = Viewport.Y * Main.Position.Y.Scale + Main.Position.Y.Offset
        local TouchPortrait = UserInputService.TouchEnabled
            and InterfaceConfig.MobileSupportEnabled and Viewport.Y > Viewport.X
        if TouchPortrait and HalfWidth * 2 > Viewport.X - 16 then
            local MinimumVisible = math.min(112, Viewport.X * 0.32)
            CenterX = math.clamp(
                CenterX,
                MinimumVisible - HalfWidth,
                Viewport.X - MinimumVisible + HalfWidth
            )
        else
            CenterX = math.clamp(CenterX, HalfWidth + 8, math.max(HalfWidth + 8, Viewport.X - HalfWidth - 8))
        end
        if HalfHeight * 2 > Viewport.Y - 16 then
            local MinimumVisibleY = math.min(72, Viewport.Y * 0.24)
            CenterY = math.clamp(
                CenterY,
                MinimumVisibleY - HalfHeight,
                Viewport.Y - MinimumVisibleY + HalfHeight
            )
        else
            CenterY = math.clamp(CenterY, HalfHeight + 8, math.max(HalfHeight + 8, Viewport.Y - HalfHeight - 8))
        end
        Main.Position = UDim2.new(0.5, CenterX - Viewport.X * 0.5, 0.5, CenterY - Viewport.Y * 0.5)
    end
    HubUI.ClampWindowToViewport = ClampWindowToViewport

    EffectiveScale = function()
        local Requested = math.clamp(tonumber(InterfaceConfig.Scale) or 1, 0.65, 1.35)
        return math.min(HubUI.FitScale or CalculateFitScale(), Requested)
    end

    local OpenSerial = 0
    HubUI.FitScale = CalculateFitScale()
    HubUI.UserScale = InterfaceConfig.Scale
    function HubUI.SetOpen(Value)
        if HubUI.IntroPlaying then return end
        Value = Value == true
        OpenSerial += 1
        HubUI.Open = Value
        HubUI.Transitioning = false
        if HubUI.KeybindManager and HubUI.KeybindManager.ApplyOverlayWindowState then
            HubUI.KeybindManager:ApplyOverlayWindowState(Value)
        end
        HubUI.FitScale = CalculateFitScale()
        if not Value and ColorPickerOverlay.Visible then ClosePicker(false) end
        if not Value and HubUI.CustomGoalOverlay and HubUI.CustomGoalOverlay.Visible then HubUI.SetCustomGoalEditorVisible(false) end
        if ActiveDropdown then ActiveDropdown:Close() end
        SearchBox:ReleaseFocus();
        GlobalSearchBox:ReleaseFocus();
        CloseGlobalSearch(false)
        local TargetScale = EffectiveScale()
        if Value then
            local Camera = Workspace.CurrentCamera
            local Viewport = Camera and Camera.ViewportSize
            if UserInputService.TouchEnabled and InterfaceConfig.MobileSupportEnabled
                and Viewport and Viewport.Y > Viewport.X and type(SavedWindowPosition) ~= 'table' then
                Main.Position = UDim2.new(0, 8 + 290 * TargetScale, 0.5, 0)
            end
            ClampWindowToViewport()
            Main.Visible = true
            Main.GroupTransparency = 0
            Main.Rotation = 0
            MainScale.Scale = TargetScale
        else
            Main.Visible = false
            Main.GroupTransparency = 0
            Main.Rotation = 0
            MainScale.Scale = TargetScale
        end
    end

    State.Lifecycle:Spawn(function()
        local B64Alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
        local function B64Encode(Data)
            local Out = {}
            for Index = 1, #Data, 3 do
                local A, B, C = string.byte(Data, Index, Index + 2)
                local N = A * 65536 + (B or 0) * 256 + (C or 0)
                local C1 = math.floor(N / 262144) % 64
                local C2 = math.floor(N / 4096) % 64
                local C3 = math.floor(N / 64) % 64
                local C4 = N % 64
                table.insert(Out, string.sub(B64Alphabet, C1 + 1, C1 + 1) .. string.sub(B64Alphabet, C2 + 1, C2 + 1)
                    .. (B and string.sub(B64Alphabet, C3 + 1, C3 + 1) or '=')
                    .. (C and string.sub(B64Alphabet, C4 + 1, C4 + 1) or '='))
            end
            return table.concat(Out)
        end
        local B64Lookup = {}
        for Index = 1, 64 do B64Lookup[string.sub(B64Alphabet, Index, Index)] = Index - 1 end
        local function B64Decode(Data)
            Data = string.gsub(tostring(Data or ''), '[^%w%+/=]', '')
            if #Data == 0 or #Data % 4 ~= 0 then return nil end
            local Out = {}
            for Index = 1, #Data, 4 do
                local C1 = B64Lookup[string.sub(Data, Index, Index)]
                local C2 = B64Lookup[string.sub(Data, Index + 1, Index + 1)]
                local Q3 = string.sub(Data, Index + 2, Index + 2)
                local Q4 = string.sub(Data, Index + 3, Index + 3)
                if not (C1 and C2) then return nil end
                local C3 = Q3 ~= '=' and B64Lookup[Q3] or nil
                local C4 = Q4 ~= '=' and B64Lookup[Q4] or nil
                if Q3 ~= '=' and not C3 then return nil end
                if Q4 ~= '=' and not C4 then return nil end
                local N = C1 * 262144 + C2 * 4096 + (C3 or 0) * 64 + (C4 or 0)
                table.insert(Out, string.char(math.floor(N / 65536) % 256))
                if C3 then table.insert(Out, string.char(math.floor(N / 256) % 256)) end
                if C4 then table.insert(Out, string.char(N % 256)) end
            end
            return table.concat(Out)
        end

