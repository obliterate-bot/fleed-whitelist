        local function CollectProfile(Name, WithInterface)
            local Values = {}
            for Key, Control in pairs(HubUI.Controls) do
                if type(Control) == 'table' and type(Control.Set) == 'function'
                    and Control.Value ~= nil and not tostring(Key):match('^Interface')
                    and not tostring(Key):match('^Config') then
                    local ValueType = type(Control.Value)
                    if ValueType == 'boolean' or ValueType == 'number' or ValueType == 'string' then
                        Values[Key] = Control.Value
                    end
                end
            end
            return {
                Version = 2,
                Name = SanitizeConfigName(Name),
                SavedAt = os.time(),
                Config = DeepCopy(CONFIG),
                Controls = Values,
                Interface = WithInterface and DeepCopy(InterfaceConfig) or nil,
                Extra = {
                LocalAlias = State.LocalAlias,
                LocalELO = State.LocalELO,
                LocalRepImage = State.LocalRepImage,
                LocalWins = State.LocalWins,
                LocalLosses = State.LocalLosses,
                LocalShields = State.LocalShields,
                LocalShieldEXP = State.LocalShieldEXP,
                LocalGoals = State.LocalGoals,
                LocalAttempts = State.LocalAttempts,
                LocalStreak = State.LocalStreak,
                LocalHighestStreak = State.LocalHighestStreak,
                LocalOverall = State.LocalOverall,
                LocalDonation = State.LocalDonation,
                LocalClanName = State.LocalClanName,
                LocalClanTagText = State.LocalClanTagText,
                LocalClanELO = State.LocalClanELO,
                LocalClanFunds = State.LocalClanFunds,
                LocalClanLevel = State.LocalClanLevel,
                LocalClanWins = State.LocalClanWins,
                LocalClanLosses = State.LocalClanLosses,
                LocalAchMultiplier = State.LocalAchMultiplier,
                },
            }
        end

        local function WriteProfile(Name, Profile)
            Name = SanitizeConfigName(Name)
            Profile.Name = Name
            SessionStore[Name] = DeepCopy(Profile)
            local StoredToDisk = false
            if type(writefile) == 'function' and EnsureConfigFolder() then
                local EncodeOk, Encoded = pcall(HttpService.JSONEncode, HttpService, Profile)
                if EncodeOk then StoredToDisk = pcall(writefile, ConfigPath(Name), Encoded) end
            end
            SelectedName = Name
            RefreshNames(false)
            return StoredToDisk
        end

        local function ReadProfile(Name)
            Name = SanitizeConfigName(Name)
            if type(SessionStore[Name]) == 'table' then return DeepCopy(SessionStore[Name]) end
            local Path = ConfigPath(Name)
            if type(isfile) == 'function' and type(readfile) == 'function' then
                local ExistsOk, Exists = pcall(isfile, Path)
                if ExistsOk and Exists then
                    local ReadOk, Raw = pcall(readfile, Path)
                    local DecodeOk, Data = false, nil
                    if ReadOk then DecodeOk, Data = pcall(HttpService.JSONDecode, HttpService, Raw) end
                    if DecodeOk and type(Data) == 'table' then
                        SessionStore[Name] = DeepCopy(Data)
                        return Data
                    end
                end
            end
            return nil
        end

        local function ApplyInterfaceSnapshot(Data)
            if type(Data) ~= 'table' then return end
            MergeConfig(InterfaceConfig, DeepCopy(Data))
            NormalizeInterfaceConfig()
            HubUI.ApplyTheme(InterfaceConfig.Theme, false)
            HubUI.ApplyFont(InterfaceConfig.Font, false)
            HubUI.ImportTabLayout(InterfaceConfig.TabOrder, InterfaceConfig.HiddenTabs)
            HubUI.UserScale = InterfaceConfig.Scale
            local Controls = HubUI.Controls
            if Controls.InterfaceScale then Controls.InterfaceScale:Set(InterfaceConfig.Scale, false) end
            if Controls.InterfaceOpacity then Controls.InterfaceOpacity:Set(1 - InterfaceConfig.WindowTransparency, false) end
            if Controls.InterfaceAnimationSpeed then Controls.InterfaceAnimationSpeed:Set(InterfaceConfig.AnimationSpeed, false) end
            if Controls.InterfaceIntro then Controls.InterfaceIntro:Set(InterfaceConfig.Intro, false) end
            if Controls.InterfaceReducedMotion then Controls.InterfaceReducedMotion:Set(InterfaceConfig.ReducedMotion, false) end
            if Controls.InterfaceLockWindow then Controls.InterfaceLockWindow:Set(InterfaceConfig.LockWindow, false) end
            if Controls.InterfaceFont then Controls.InterfaceFont:Set(InterfaceConfig.Font, false) end
            Main.BackgroundTransparency = InterfaceConfig.WindowTransparency
            StaticGradientLayer.BackgroundTransparency = math.clamp(0.18 + InterfaceConfig.WindowTransparency * 0.72, 0.18, 0.82)
            Sidebar.BackgroundTransparency = 0
            Content.BackgroundTransparency = 0
            if HubUI.FitScale then MainScale.Scale = HubUI.FitScale * InterfaceConfig.Scale end
            if HubUI.KeybindManager then
                HubUI.KeybindManager:Import(InterfaceConfig.Keybinds)
                HubUI.KeybindManager:SetOverlayVisible(InterfaceConfig.KeybindMenuVisible, false)
            end
        end

        local function ApplyExtra(Data)
            if type(Data) ~= 'table' then return end
            if Data.LocalAlias ~= nil then
                AliasBox.Text = SanitizeLocalAlias(Data.LocalAlias)
                State.LocalAlias = AliasBox.Text
                CONFIG.LocalAlias = AliasBox.Text
                if State.LocalAnonymizerEnabled then SetLocalAnonymizer(true, AliasBox.Text, false) end
            end
            if Data.LocalELO ~= nil then
                State.LocalELO = math.clamp(math.floor(tonumber(Data.LocalELO) or 0), 0, 1000000000)
                CONFIG.LocalELO = State.LocalELO
                ELOBox.Text = tostring(State.LocalELO)
                if State.LocalELOSpoofEnabled then State.LocalSpoofs.SetELO(true, State.LocalELO, false) end
            end
            for _, Key in ipairs({ 'LocalWins', 'LocalLosses', 'LocalShields', 'LocalShieldEXP', 'LocalGoals', 'LocalAttempts', 'LocalStreak', 'LocalHighestStreak', 'LocalOverall', 'LocalDonation' }) do
                if Data[Key] ~= nil then
                    local Value = math.max(0, math.floor(tonumber(Data[Key]) or 0))
                    if Key == 'LocalOverall' then Value = math.min(Value, 100) end
                    State[Key] = Value
                    CONFIG[Key] = Value
                    local Box = State.LocalSpoofs.StatBoxes and State.LocalSpoofs.StatBoxes[Key]
                    local Prefix = State.LocalSpoofs.StatBoxPrefixes and State.LocalSpoofs.StatBoxPrefixes[Key]
                    if Box and Prefix then Box.Text = Prefix .. ': ' .. tostring(Value) end
                end
            end
            for _, Key in ipairs({ 'LocalClanELO', 'LocalClanFunds', 'LocalClanLevel', 'LocalClanWins', 'LocalClanLosses', 'LocalAchMultiplier' }) do
                if Data[Key] ~= nil then
                    local Value = math.max(0, tonumber(Data[Key]) or 0)
                    if Key ~= 'LocalAchMultiplier' then Value = math.floor(Value) end
                    if Key == 'LocalClanLevel' then Value = math.max(1, Value) end
                    State[Key] = Value
                    CONFIG[Key] = Value
                    local Box = State.LocalSpoofs.StatBoxes and State.LocalSpoofs.StatBoxes[Key]
                    local Prefix = State.LocalSpoofs.StatBoxPrefixes and State.LocalSpoofs.StatBoxPrefixes[Key]
                    if Box and Prefix then Box.Text = Prefix .. ': ' .. tostring(Value) end
                end
            end
            for _, Key in ipairs({ 'LocalClanName', 'LocalClanTagText' }) do
                if Data[Key] ~= nil then
                    local Value = tostring(Data[Key])
                    State[Key] = Value
                    CONFIG[Key] = Value
                    local Box = State.LocalSpoofs.StatBoxes and State.LocalSpoofs.StatBoxes[Key]
                    local Prefix = State.LocalSpoofs.StatBoxPrefixes and State.LocalSpoofs.StatBoxPrefixes[Key]
                    if Box and Prefix then Box.Text = Prefix .. ': ' .. Value end
                end
            end
            if State.LocalStatsSpoofEnabled then pcall(State.LocalSpoofs.ApplyProfile) end
            if State.LocalClanSpoofEnabled then pcall(State.LocalSpoofs.ApplyClanSpoof) end
            if State.LocalAchievementSpoofEnabled then pcall(State.LocalSpoofs.ApplyAchievementSpoof) end
            if State.LocalSpoofs.Extended and State.LocalSpoofs.Extended.RefreshControls then pcall(State.LocalSpoofs.Extended.RefreshControls) end
        end

        local function ApplyProfile(Profile)
            if HubUI.ConfigApplying then
                SetConfigStatus('A config is already being applied.', true)
                return
            end
            if type(Profile) ~= 'table' then
                SetConfigStatus('The selected profile is unavailable or invalid.', true)
                return
            end
            HubUI.ConfigApplying = true
            SetConfigStatus('Applying profile in safe batches...')
            State.Lifecycle:Spawn(function()
                if type(Profile.Config) == 'table' then MergeConfig(CONFIG, DeepCopy(Profile.Config)) end
                if type(Profile.Interface) == 'table' then pcall(ApplyInterfaceSnapshot, Profile.Interface) end
                local Queue = {}
                for Key, Value in pairs(type(Profile.Controls) == 'table' and Profile.Controls or {}) do
                    local Control = HubUI.Controls[Key]
                    if type(Control) == 'table' and type(Control.Set) == 'function' then
                        table.insert(Queue, { Key = tostring(Key), Control = Control, Value = Value })
                    end
                end
                table.sort(Queue, function(A, B) return A.Key < B.Key end)
                local Errors = 0
                for Index, Entry in ipairs(Queue) do
                    local Ok = pcall(function() Entry.Control:Set(Entry.Value, true) end)
                    if not Ok then Errors += 1 end
                    if Index % 6 == 0 then task.wait(HubUI.Motion.Hold(0.035)) end
                end
                pcall(ApplyExtra, Profile.Extra)
                if HubUI.Sync then pcall(HubUI.Sync) end
                SaveInterfaceConfig()
                HubUI.ConfigApplying = false
                SetConfigStatus(Errors == 0
                    and ('Loaded ' .. tostring(Profile.Name or 'profile') .. ' successfully.')
                    or ('Loaded with ' .. tostring(Errors) .. ' skipped control(s).'), Errors > 0)
            end)
        end

