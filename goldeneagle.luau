        warn('[GOLDEN EAGLE] Desync visualizer update failed: ' .. tostring(Err))
    end
end)))

State.ESP = { Records = {}, LastScan = 0, BindName = 'GoldenEagleESP', Status = 'OFF', LastError = nil, StatsCache = {}, StatsPending = {}, StatsQueueAt = 0 }
function State.ESP.GetNumber(Player, Names)
    for _,Name in ipairs(Names) do local V=Player:GetAttribute(Name);
        if tonumber(V) then return math.floor(tonumber(V)) end end
    local Stats=Player:FindFirstChild('leaderstats')
    if Stats then for _,Name in ipairs(Names) do local O=Stats:FindFirstChild(Name);
            if O and tonumber(O.Value) then return math.floor(tonumber(O.Value)) end end end
    return 0
end
function State.ESP.HideStatsPopup()
    local PG=LP:FindFirstChildOfClass('PlayerGui');
    if not PG then return end
    for _,Object in ipairs(PG:GetDescendants()) do
        if Object:IsA('GuiObject') and Object.Visible and (string.find(string.lower(Object.Name),'statsv2',1,true) or string.lower(Object.Name)=='stats') then pcall(function() Object.Visible=false end) end
    end
end
function State.ESP.RequestRecord(Player)
    if not Player or State.ESP.StatsCache[Player.UserId] or State.ESP.StatsPending[Player.UserId] then return end
    local Remote=ReplicatedStorage:FindFirstChild('Remotes') and ReplicatedStorage.Remotes:FindFirstChild('viewStatsEvent')
    if not Remote then return end
    State.ESP.StatsPending[Player.UserId]=true
    local WaitFor=math.max(0,State.ESP.StatsQueueAt-os.clock());
    State.ESP.StatsQueueAt=math.max(State.ESP.StatsQueueAt,os.clock())+.75
    State.Lifecycle:Delay(WaitFor,function() if State.Active and Player.Parent then pcall(function() Remote:FireServer(Player) end) end end)
end
pcall(function()
    local Remote=ReplicatedStorage:WaitForChild('Remotes',3) and ReplicatedStorage.Remotes:WaitForChild('viewStatsEvent',3)
    if Remote then State.Lifecycle:Connect(Remote.OnClientEvent,function(Data,Info)
            local Id=type(Info)=='table' and tonumber(Info.UserId) or nil
            if not Id or type(Data)~='table' then return end
            local Stats=Data.Stats or Data.Stats_Arena or {}
            local Arena=Data.Stats_Arena
            local Target=Players:GetPlayerByUserId(Id);
            local LiveELO=Target and tonumber(Target:GetAttribute('ELO'))
            if type(Arena)=='table' and LiveELO and math.abs((tonumber(Arena.ELO) or 0)-LiveELO)<math.abs((tonumber(Stats.ELO) or 0)-LiveELO) then Stats=Arena end
            State.ESP.StatsCache[Id]={Wins=tonumber(Stats.Wins) or 0,Losses=tonumber(Stats.Losses) or 0,At=os.clock()}
            State.ESP.StatsPending[Id]=nil
            State.Lifecycle:Defer(State.ESP.HideStatsPopup)
        end,'GoldenEagleESPStatsResponse') end
end)
function State.ESP.GetRecord(Player)
    local Cached=State.ESP.StatsCache[Player.UserId]
    if Cached then return Cached.Wins,Cached.Losses end
    local W=State.ESP.GetNumber(Player,{'Wins','Win','TotalWins','CareerWins'})
    local L=State.ESP.GetNumber(Player,{'Losses','Loss','TotalLosses','CareerLosses'})
    if W==0 and L==0 then
        for _,Object in ipairs(Player:GetDescendants()) do
            if Object:IsA('ValueBase') then
                local N=string.lower(Object.Name)
                if (N=='wins' or N=='win' or N=='totalwins') and tonumber(Object.Value) then W=math.floor(tonumber(Object.Value)) end
                if (N=='losses' or N=='loss' or N=='totallosses') and tonumber(Object.Value) then L=math.floor(tonumber(Object.Value)) end
            end
        end
    end
    if W==0 and L==0 then
        local Raw=Player:GetAttribute('Record') or Player:GetAttribute('WinLoss') or Player:GetAttribute('W-L')
        local A,B=tostring(Raw or ''):match('(%d+)%s*[-–/:]%s*(%d+)')
        if A then W,L=tonumber(A) or 0,tonumber(B) or 0 end
    end
    if W==0 and L==0 and Player.Character then
        for _,Object in ipairs(Player.Character:GetDescendants()) do
            if Object:IsA('TextLabel') or Object:IsA('TextButton') then
                local A,B=tostring(Object.Text or ''):match('(%d+)%s*[-–/:]%s*(%d+)')
                if A then W,L=tonumber(A) or 0,tonumber(B) or 0;
                    break end
            end
        end
    end
    if W==0 and L==0 then State.ESP.RequestRecord(Player);
        return nil,nil end
    State.ESP.StatsCache[Player.UserId]={Wins=W,Losses=L,At=os.clock()}
    return W,L
end
function State.ESP.GetRank(Player)
    local ELO=State.ESP.GetNumber(Player,{'ELO','Elo','Rating','RankPoints'})
    local Best='ROOKIE 1';
    local BestValue=-math.huge
    if State.LocalSpoofs and State.LocalSpoofs.RankImageELO then
        for Name,Value in pairs(State.LocalSpoofs.RankImageELO) do if Value<=ELO and Value>BestValue then Best,BestValue=string.upper(Name),Value end end
    else
        local T={{0,'ROOKIE'},{100,'VETERAN'},{500,'ELITE'},{1500,'PRO'},{3000,'SUPERSTAR'},{6000,'LEGEND'}}
        for _,Entry in ipairs(T) do if ELO>=Entry[1] then Best=Entry[2] end end
    end
    return Best,ELO
end
function State.ESP.Destroy(Player)
    local R=State.ESP.Records[Player];
    if not R then return end
    if R.Skeleton then for _,Line in ipairs(R.Skeleton) do pcall(function() Line.Visible=false;
                Line:Remove() end) end end
    if R.Tracer then pcall(function() R.Tracer.Visible=false;
            R.Tracer:Remove() end) end
    for Key,O in pairs(R) do if Key~='Character' and Key~='Skeleton' and Key~='Tracer' and typeof(O)=='Instance' then pcall(function() O:Destroy() end) end end
    State.ESP.Records[Player]=nil
end
