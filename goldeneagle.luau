        function KeybindManager:BeginCapture(Entry)
            if not Entry then return end
            if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
                Notify('GOLDEN EAGLE', 'A hardware keyboard is required to assign a physical key. Use RUN to activate this entry.')
                return
            end
            self.Capture = Entry
            CaptureTitle.Text = 'PRESS A KEY'
            CaptureTarget.Text = string.upper(Entry.Label)
            local WasVisible = CaptureOverlay.Visible
            CaptureOverlay.Visible = true
            if not WasVisible then
                CaptureOverlay.GroupTransparency = 1
                CaptureOverlay.BackgroundTransparency = 1
                CaptureScale.Scale = 0.97
            end
            Tween(CaptureOverlay, 0.24, { GroupTransparency = 0, BackgroundTransparency = 0.28 }, Enum.EasingStyle.Sine)
            Tween(CaptureScale, 0.26, { Scale = 1 }, Enum.EasingStyle.Quint)
        end

        function KeybindManager:EndCapture()
            self.Capture = nil
            Tween(CaptureOverlay, 0.18, { GroupTransparency = 1, BackgroundTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(CaptureScale, 0.18, { Scale = 0.985 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            State.Lifecycle:Delay(HubUI.Motion.Hold(0.19), function()
                if not self.Capture and CaptureOverlay.Parent then CaptureOverlay.Visible = false end
            end)
        end

        function KeybindManager:Register(Id, Label, Page, Control, Options)
            Options = Options or {}
            local Kind = Options.Kind or (Control and Control.Kind) or 'Action'
            local Modes = Options.Modes or ValidModesFor(Kind)
            local Saved = InterfaceConfig.Keybinds[Id]
            local HasSaved = type(Saved) == 'table'
            local DefaultKey = Options.DefaultKey
            local Entry = {
                Id = Id,
                Label = Label,
                Page = Page or 'General',
                Control = Control,
                Kind = Kind,
                Modes = Modes,
                Mode = HasSaved and tostring(Saved.Mode or '') or Options.DefaultMode or DefaultModeFor(Kind),
                Key = DefaultKey,
                Show = Options.Show ~= false,
                MobileQuick = Options.MobileQuick == true,
                Trigger = Options.Trigger or (Control and Control.Trigger),
                DefaultKey = DefaultKey,
                DefaultShow = Options.Show ~= false,
                DefaultMobileQuick = Options.MobileQuick == true,
            }
            if HasSaved then
                Entry.Key = Saved.Key
                Entry.Show = Saved.Show ~= false
                Entry.MobileQuick = Saved.MobileQuick == nil and Entry.DefaultMobileQuick or Saved.MobileQuick == true
            end
            if not ModeAllowed(Entry, Entry.Mode) then Entry.Mode = Options.DefaultMode or DefaultModeFor(Kind) end
            self.Entries[Id] = Entry
            table.insert(self.Ordered, Entry)
            if Control then Control.KeybindEntry = Entry end
            if Control and Control.KeyButton then
                GiveSignal(Control.KeyButton.MouseButton1Click:Connect(function() self:BeginCapture(Entry) end))
                GiveSignal(Control.KeyButton.MouseButton2Click:Connect(function() self:CycleMode(Entry) end))
            end
            self:UpdateLegacyKeys(Entry)
            self:RefreshEntry(Entry)
            return Entry
        end

        function KeybindManager:Invoke(Entry, Began, Direction)
            if not Entry then return end
            local Reverse = tonumber(Direction) or (IsShiftDown() and -1 or 1)
            if Entry.Kind == 'Toggle' and Entry.Control then
                if Entry.Mode == 'Hold' then
                    self.Held[Entry.Id] = Began == true
                    Entry.Control:Set(Began == true, true)
                elseif Entry.Mode == 'Toggle' and Began then
                    if Entry.Trigger then Entry.Trigger() else Entry.Control:Set(not Entry.Control.Value, true) end
                elseif Entry.Mode == 'Always' and not Entry.Control.Value then
                    Entry.Control:Set(true, true)
                end
            elseif Began and (Entry.Kind == 'Selector' or Entry.Kind == 'Dropdown') and Entry.Control and Entry.Control.Step then
                Entry.Control:Step(Reverse)
            elseif Began and Entry.Kind == 'Number' and Entry.Control and Entry.Control.Step then
                Entry.Control:Step(Reverse)
            elseif Began and Entry.Trigger then
                Entry.Trigger()
            end
            self:RefreshOverlay()
            if self.RefreshMobileQuick then self:RefreshMobileQuick(false) end
        end

        function KeybindManager:HandleInputBegan(Input, GameProcessed)
            local Token = InputToken(Input)
            if self.Capture then
                if Input.KeyCode == Enum.KeyCode.Escape then
                    self:EndCapture()
                    return true
                end
                if Input.KeyCode == Enum.KeyCode.Backspace or Input.KeyCode == Enum.KeyCode.Delete then
                    local Entry = self.Capture
                    self:EndCapture()
                    self:SetKey(Entry, nil, true)
                    return true
                end
                if Token then
                    local Entry = self.Capture
                    self:EndCapture()
                    self:SetKey(Entry, Token, true)
                    return true
                end
                return true
            end
            if GameProcessed or UserInputService:GetFocusedTextBox() ~= nil then return false end
            if Input.KeyCode == Enum.KeyCode.Escape then return false end
            local CtrlDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
            if CtrlDown and (Input.KeyCode == Enum.KeyCode.F or Input.KeyCode == Enum.KeyCode.Tab) then return false end
            if not Token then return false end
            local Fired = false
            for _, Entry in ipairs(self.Ordered) do
                if Entry.Key == Token and Entry.Mode ~= 'Always' then
                    self:Invoke(Entry, true)
                    Fired = true
                end
            end
            return Fired
        end

        function KeybindManager:HandleInputEnded(Input)
            local Token = InputToken(Input)
            if not Token then return end
            for _, Entry in ipairs(self.Ordered) do
                if Entry.Key == Token and Entry.Kind == 'Toggle' and Entry.Mode == 'Hold' and self.Held[Entry.Id] then
                    self:Invoke(Entry, false)
                end
            end
        end

        function KeybindManager:Import(Data)
            InterfaceConfig.Keybinds = type(Data) == 'table' and DeepCopy(Data) or {}
            for _, Entry in ipairs(self.Ordered) do
                local Saved = InterfaceConfig.Keybinds[Entry.Id]
                if type(Saved) == 'table' then
                    Entry.Key = Saved.Key
                else
                    Entry.Key = Entry.DefaultKey
                end
                local Mode = type(Saved) == 'table' and tostring(Saved.Mode or '') or DefaultModeFor(Entry.Kind)
                Entry.Mode = ModeAllowed(Entry, Mode) and Mode or DefaultModeFor(Entry.Kind)
                if type(Saved) == 'table' then
                    Entry.Show = Saved.Show ~= false
                    Entry.MobileQuick = Saved.MobileQuick == nil and Entry.DefaultMobileQuick or Saved.MobileQuick == true
                else
                    Entry.Show = Entry.DefaultShow
                    Entry.MobileQuick = Entry.DefaultMobileQuick
                end
                self:UpdateLegacyKeys(Entry)
                self:RefreshEntry(Entry)
                if Entry.Mode == 'Always' and Entry.Kind == 'Toggle' and Entry.Control and not Entry.Control.Value then
                    Entry.Control:Set(true, true)
                end
            end
            self:RefreshRows()
            self:RefreshOverlay()
            if self.RefreshMobileQuick then self:RefreshMobileQuick() end
            if self.RefreshMobileFilter then self:RefreshMobileFilter() end
        end

