    HubUI.ActiveTweens = setmetatable({}, { __mode = 'k' })

    HubUI.Motion = {
        Duration = { Micro = 0.10, Fast = 0.14, Base = 0.20, Slow = 0.28, Panel = 0.38 },
        Scale = { 0.10, 0.14, 0.20, 0.28, 0.38 },
        Movement = { Position = true, Rotation = true, Scale = true, Size = true, CanvasPosition = true },
        PressScale = 0.985, IconPressScale = 0.975,
        StaggerStep = 0.022, StaggerCap = 7,
    }
    function HubUI.Motion.Speed()
        return math.max(0.1, tonumber(InterfaceConfig.AnimationSpeed) or 1)
    end
    function HubUI.Motion.Snap(Value)
        local Best, Distance = HubUI.Motion.Scale[1], math.huge
        for _, Token in ipairs(HubUI.Motion.Scale) do
            local Candidate = math.abs(Token - Value)
            if Candidate < Distance then Best, Distance = Token, Candidate end
        end
        return Best
    end
    function HubUI.Motion.Resolve(Duration, Style, Direction)
        local Raw = math.max(0.001, tonumber(Duration) or HubUI.Motion.Duration.Base)
        if Style == Enum.EasingStyle.Linear then
            return Raw, Enum.EasingStyle.Linear, Enum.EasingDirection.Out
        end
        local Exiting = Direction == Enum.EasingDirection.In
        local Resolved = Raw > HubUI.Motion.Duration.Panel and math.min(Raw, 0.50)
            or HubUI.Motion.Snap(Raw)
        if Exiting then
            return math.max(0.08, Resolved * 0.72), Enum.EasingStyle.Quad, Enum.EasingDirection.In
        end
        return Resolved, Enum.EasingStyle.Quint, Enum.EasingDirection.Out
    end
    function HubUI.Motion.Stagger(Index)
        if InterfaceConfig.ReducedMotion then return 0 end
        return math.clamp(tonumber(Index) or 0, 0, HubUI.Motion.StaggerCap) * HubUI.Motion.StaggerStep
    end
    function HubUI.Motion.Hold(Duration)
        if InterfaceConfig.ReducedMotion then return 0.002 end
        return (math.max(0.001, tonumber(Duration) or HubUI.Motion.Duration.Base) + 0.02) / HubUI.Motion.Speed()
    end

    local function Tween(Object, Duration, Properties, EasingStyle, EasingDirection)
        if not (Object and Object.Parent) then return nil end

        local PropertySet = {}
        for Property in pairs(Properties) do PropertySet[Property] = true end

        local ObjectTweens = HubUI.ActiveTweens[Object]
        if ObjectTweens then
            for Index = #ObjectTweens, 1, -1 do
                local Entry = ObjectTweens[Index]
                local Overlaps = false
                if not Entry.Done and Entry.Motion then
                    for Property in pairs(Entry.Properties) do
                        if PropertySet[Property] then
                            Overlaps = true
                            break
                        end
                    end
                end

                if Entry.Done or not Entry.Motion then
                    table.remove(ObjectTweens, Index)
                elseif Overlaps then
                    table.remove(ObjectTweens, Index)
                    Entry.Done = true
                    pcall(function() Entry.Motion:Cancel() end)
                end
            end
        else
            ObjectTweens = {}
            HubUI.ActiveTweens[Object] = ObjectTweens
        end

        local Speed = HubUI.Motion.Speed()
        local SmoothDuration, ResolvedStyle, ResolvedDirection =
        HubUI.Motion.Resolve(Duration, EasingStyle, EasingDirection)
        local AnimatedProperties = Properties
        if InterfaceConfig.ReducedMotion then
            AnimatedProperties = {}
            for Property, Value in pairs(Properties) do
                if HubUI.Motion.Movement[Property] then
                    pcall(function() Object[Property] = Value end)
                else
                    AnimatedProperties[Property] = Value
                end
            end
            if next(AnimatedProperties) == nil then return nil end
            SmoothDuration = HubUI.Motion.Duration.Micro
        end
        local Motion = TweenService:Create(Object, TweenInfo.new(
            math.max(0.001, SmoothDuration / Speed),
            ResolvedStyle,
            ResolvedDirection
            ), AnimatedProperties)
        local Entry = { Motion = Motion, Properties = PropertySet, Done = false }
        table.insert(ObjectTweens, Entry)

        local CompletionConnection
        CompletionConnection = Motion.Completed:Connect(function()
            Entry.Done = true
            if CompletionConnection then
                CompletionConnection:Disconnect()
                CompletionConnection = nil
            end
            local CurrentTweens = HubUI.ActiveTweens[Object]
            if CurrentTweens then
                local EntryIndex = table.find(CurrentTweens, Entry)
                if EntryIndex then table.remove(CurrentTweens, EntryIndex) end
                if #CurrentTweens == 0 then HubUI.ActiveTweens[Object] = nil end
            end
        end)

        Motion:Play()
        return Motion
    end

    function HubUI.Motion.Cancel(Object, Properties)
        local ObjectTweens = HubUI.ActiveTweens[Object]
        if not ObjectTweens then return end
        for Index = #ObjectTweens, 1, -1 do
            local Entry = ObjectTweens[Index]
            local Overlaps = false
            if Entry and not Entry.Done and Entry.Motion then
                for Property in pairs(Entry.Properties or {}) do
                    if Properties[Property] then Overlaps = true;
                        break end
                end
            end
            if Overlaps then
                Entry.Done = true
                pcall(function() Entry.Motion:Cancel() end)
                table.remove(ObjectTweens, Index)
            elseif not Entry or Entry.Done then
                table.remove(ObjectTweens, Index)
            end
        end
        if #ObjectTweens == 0 then HubUI.ActiveTweens[Object] = nil end
    end

    local function MotionOut(Object, Duration, Properties, EasingStyle, EasingDirection)
        if EasingStyle ~= Enum.EasingStyle.Linear then Duration = math.max(0.14, tonumber(Duration) or 0.14) end
        return Tween(Object, Duration, Properties, EasingStyle, EasingDirection)
    end
    function HubUI.Motion.Press(ScaleObject, Down, Amount)
        if not (ScaleObject and ScaleObject.Parent) then return end
        if InterfaceConfig.HoverAnimations==false then ScaleObject.Scale=Down and .985 or 1;
            return end
        if InterfaceConfig.ReducedMotion then ScaleObject.Scale = 1 return end
        Tween(ScaleObject, Down and 0.10 or 0.20, {
            Scale = Down and (tonumber(Amount) or HubUI.Motion.PressScale) or 1,
            }, Enum.EasingStyle.Quint, Down and Enum.EasingDirection.In or Enum.EasingDirection.Out)
    end

    local function AnimateClearButton(Button, Visible)
        Button:SetAttribute('AnimationSerial', (Button:GetAttribute('AnimationSerial') or 0) + 1)
        local Serial = Button:GetAttribute('AnimationSerial')
        if Visible then
            if not Button.Visible then
                Button.Visible = true
                Button.TextTransparency = 1
                Button.Rotation = -28
            end
            Tween(Button, 0.20, { TextTransparency = 0, Rotation = 0 }, Enum.EasingStyle.Quint)
        else
            Tween(Button, 0.16, { TextTransparency = 1, Rotation = 24 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            State.Lifecycle:Delay(HubUI.Motion.Hold(0.17), function()
                if Button.Parent and Button:GetAttribute('AnimationSerial') == Serial then
                    Button.Visible = false
                    Button.Rotation = 0
                end
            end)
        end
    end

