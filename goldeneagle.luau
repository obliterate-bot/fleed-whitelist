function State.Extras.Step(DeltaTime)
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    local HumanoidObject = Character and Character:FindFirstChildOfClass('Humanoid')
    if State.Extras.SpinbotEnabled and Root and HumanoidObject and HumanoidObject.Health > 0 then
        Root.CFrame = Root.CFrame * CFrame.Angles(0, math.rad(State.Extras.SpinbotSpeed * DeltaTime), 0)
    end
    if not (State.Extras.AnklesReachEnabled and Root and type(firetouchinterest) == 'function') then return end
    local Now = os.clock()
    if Now - State.Extras.LastAnklesTouch < 0.12 then return end
    State.Extras.LastAnklesTouch = Now
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LP then
            local TargetCharacter = Player.Character
            local TargetRoot = TargetCharacter and safe_find(TargetCharacter, 'HumanoidRootPart')
            local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass('Humanoid')
            if TargetRoot and TargetHumanoid and TargetHumanoid.Health > 0
                and (TargetRoot.Position - Root.Position).Magnitude <= CONFIG.AnklesReachRadius then
                pcall(firetouchinterest, Root, TargetRoot, 0)
                pcall(firetouchinterest, Root, TargetRoot, 1)
            end
        end
    end
end

