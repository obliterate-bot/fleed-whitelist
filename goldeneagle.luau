            GiveSignal(MobileButton.InputEnded:Connect(function(Input)
                if Input.UserInputType ~= Enum.UserInputType.Touch
                    and Input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                if RunHolding then
                    RunHolding = false
                    self:Invoke(Entry, false, 1)
                end
