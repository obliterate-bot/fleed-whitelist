function State.Movement.GetFlightDirection()
    if UserInputService:GetFocusedTextBox() then return Vector3.zero end
    local Camera = Workspace.CurrentCamera
    if not Camera then return Vector3.zero end

    local Look = Camera.CFrame.LookVector
    local Right = Camera.CFrame.RightVector
    local Forward = Vector3.new(Look.X, 0, Look.Z)
    local Side = Vector3.new(Right.X, 0, Right.Z)
    if Forward.Magnitude > 0.001 then Forward = Forward.Unit end
    if Side.Magnitude > 0.001 then Side = Side.Unit end

    local Direction = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then Direction += Forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then Direction -= Forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then Direction += Side end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then Direction -= Side end

    if UserInputService.TouchEnabled then
        local _, HumanoidObject = State.Movement.GetRig()
        local TouchDirection = HumanoidObject and HumanoidObject.MoveDirection or Vector3.zero
        TouchDirection = Vector3.new(TouchDirection.X, 0, TouchDirection.Z)
        if TouchDirection.Magnitude > 0.05 then Direction += TouchDirection.Unit end
    end

    if UserInputService:IsKeyDown(Enum.KeyCode.Space) or State.MobileInput.FlightUp then
        Direction += Vector3.yAxis
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        or State.MobileInput.FlightDown then
        Direction -= Vector3.yAxis
    end
    return Direction.Magnitude > 1 and Direction.Unit or Direction
end

function State.Movement.RefreshFlight()
    pcall(function() State.Lifecycle:UnbindFromRenderStep(State.Movement.FlightRenderName) end)
    local _, HumanoidObject, Root = State.Movement.GetRig()
    if not State.Movement.FlightEnabled then
        if HumanoidObject then
            if State.Movement.OriginalAutoRotate ~= nil then
                pcall(function() HumanoidObject.AutoRotate = State.Movement.OriginalAutoRotate end)
            end
            pcall(function()
                if HumanoidObject:GetState() == Enum.HumanoidStateType.Physics then
                    HumanoidObject:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
        end
        if Root then
            pcall(function()
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
                local Stale = Root:FindFirstChild('GEFlightVelocity')
                if Stale then Stale:Destroy() end
            end)
        end
        return
    end

    if HumanoidObject then State.Movement.OriginalAutoRotate = HumanoidObject.AutoRotate end
    State.Lifecycle:BindToRenderStep(
        State.Movement.FlightRenderName,
        Enum.RenderPriority.Character.Value + 1,
        WYNF_JIT(function()
        if not State.Active or not State.Movement.FlightEnabled then return end
        local _, CurrentHumanoid, CurrentRoot = State.Movement.GetRig()
        if not (CurrentHumanoid and CurrentRoot) or CurrentHumanoid.Health <= 0 then return end

        CurrentHumanoid.AutoRotate = false
        pcall(function() CurrentHumanoid:ChangeState(Enum.HumanoidStateType.Physics) end)
        local Direction = State.Movement.GetFlightDirection()
        local Speed = math.clamp(tonumber(State.Movement.FlightSpeed) or 70, 1, 500)
        local Method = State.Movement.FlightMethod or 'Assembly Linear Velocity'

        if Method == 'PivotTo' then

            local Character = LP.Character
            if Character then
                local StepTime = 1 / 60
                local Offset = Direction * Speed * StepTime
                pcall(function()
                    Character:PivotTo(Character:GetPivot() + Offset)
                end)
            end
            CurrentRoot.AssemblyAngularVelocity = Vector3.zero
            return
        end

        if Method == 'BodyVelocity' then

            local Existing = CurrentRoot:FindFirstChild('GEFlightVelocity')
            if not Existing then
                Existing = Instance.new('BodyVelocity')
                Existing.Name = 'GEFlightVelocity'
                Existing.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                Existing.Parent = CurrentRoot
            end
            Existing.Velocity = Direction * Speed
            CurrentRoot.AssemblyAngularVelocity = Vector3.zero
            return
        end

        local Stale = CurrentRoot:FindFirstChild('GEFlightVelocity')
        if Stale then pcall(function() Stale:Destroy() end) end
        CurrentRoot.AssemblyLinearVelocity = Direction * Speed
        CurrentRoot.AssemblyAngularVelocity = Vector3.zero

        local Camera = Workspace.CurrentCamera
        if Camera then
            local Look = Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z)
            if Look.Magnitude > 0.001 then
                CurrentRoot.CFrame = CFrame.lookAt(CurrentRoot.Position, CurrentRoot.Position + Look.Unit)
            end
        end
    end)
    )
end

function State.Movement.SetFlight(Enabled)
    State.Movement.FlightEnabled = Enabled == true
    CONFIG.Flight = State.Movement.FlightEnabled
    if State.Movement.FlightEnabled then
