    State.Movement.LastFlightTapAt = 0
    GiveSignal(UserInputService.InputBegan:Connect(function(Input, GameProcessed)
        if not GameProcessed and not UserInputService:GetFocusedTextBox()
            and State.Freecam.Enabled and Input.KeyCode==(CONFIG.FreecamTeleportKey or Enum.KeyCode.T) then
            local Ok,Message=State.Freecam.TeleportToLook()
            Notify('FREECAM',Ok and 'Teleported to camera aim.' or tostring(Message))
        end
        if not GameProcessed and CONFIG.FlightDoubleTap and Input.KeyCode == Enum.KeyCode.Space then
            local Now = os.clock()
            if Now - (State.Movement.LastFlightTapAt or 0) <= 0.28 then

                local FlightControl = HubUI.Controls.Flight
                if FlightControl and FlightControl.Set then
                    FlightControl:Set(not FlightControl.Value, true)
                    Notify('GOLDEN EAGLE', FlightControl.Value and 'Flight on (double-tap).' or 'Flight off (double-tap).')
                end
            else
                State.Movement.LastFlightTapAt = Now
            end
        end
        if Input.KeyCode == Enum.KeyCode.LeftAlt then
            State.BallAssist.MagHoldActive = true
        end
    end))
    GiveSignal(UserInputService.InputEnded:Connect(function(Input)
        if Input.KeyCode == Enum.KeyCode.LeftAlt then
            State.BallAssist.MagHoldActive = false
        end
    end))

