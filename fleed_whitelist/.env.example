# ============================================================
#  FleedGuard backend configuration
#  Copy this file to `.env` (same folder) and adjust as needed.
#  run_server.py auto-loads `.env` before starting.
# ============================================================

# Signs ALL tokens (handshake, loader, session). Keep it SECRET.
# REQUIRED in production and must be >= 32 characters.
# For local dev you can leave this blank: run_server.py will generate one and
# save it back into `.env` so your tokens survive restarts.
FLEED_MASTER_SECRET=

# development | production
#   production  -> refuses to start without a strong FLEED_MASTER_SECRET
#   development -> relaxed, auto-generates a local secret if missing
FLEED_ENV=development

# Public base URL where the backend is reachable BY THE MACHINE RUNNING ROBLOX.
#   Same PC as Roblox:        http://127.0.0.1:8000
#   Another device on LAN:    http://<this-machine-LAN-IP>:8000  (e.g. 192.168.1.50)
#   Exposed via a tunnel:     https://your-subdomain.trycloudflare.com
FLEED_SERVER_URL=http://127.0.0.1:8000

# Process bind address + port.
#   0.0.0.0 = reachable from other devices on your LAN (recommended for testing)
#   127.0.0.1 = local machine only
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins allowed to call the dashboard (CORS).
# The executor handshake API is server-to-server and is unaffected by this.
FLEED_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: path to the SQLite database file.
# FLEED_WHITELIST_DB=fleed_whitelist.db
