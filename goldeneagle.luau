    local function ApplyTabLayout()
        local CategoryOrder = {}
        for _, Definition in ipairs(TabDefinitions) do
            if not table.find(CategoryOrder, Definition.Category) then table.insert(CategoryOrder, Definition.Category) end
        end
        local Order = 0
        for _, Category in ipairs(CategoryOrder) do
            local Label = CategoryLabels[Category]
            if Label then
                Order += 1
                Label.LayoutOrder = Order
            end
            for _, Name in ipairs(TabOrder) do
                local Data = HubUI.TabButtons[Name]
                if Data and Data.Category == Category then
                    Order += 1
                    Data.Button.LayoutOrder = Order
                end
            end
        end
        table.clear(InterfaceConfig.TabOrder)
        for _, Name in ipairs(TabOrder) do table.insert(InterfaceConfig.TabOrder, Name) end
        ApplyNavigationSearch()
    end
    HubUI.ApplyTabLayout = ApplyTabLayout

    function HubUI.MoveTab(Name, Direction)
        local Index = table.find(TabOrder, Name)
        local Data = HubUI.TabButtons[Name]
        if not (Index and Data) then return false end
        local TargetIndex = Index + (Direction < 0 and -1 or 1)
        while TargetIndex >= 1 and TargetIndex <= #TabOrder do
            local TargetData = HubUI.TabButtons[TabOrder[TargetIndex]]
            if TargetData and TargetData.Category == Data.Category then
                TabOrder[Index], TabOrder[TargetIndex] = TabOrder[TargetIndex], TabOrder[Index]
                ApplyTabLayout()
                SaveInterfaceConfig()
                return true
            end
            TargetIndex += Direction < 0 and -1 or 1
        end
        return false
    end

    function HubUI.SetTabHidden(Name, Hidden)
        if Name == 'Interface' then return false end
        InterfaceConfig.HiddenTabs[Name] = Hidden == true or nil
        if Hidden and HubUI.ActiveTab == Name then SwitchTab('Interface') end
        ApplyTabLayout()
        SaveInterfaceConfig()
        return true
    end

    function HubUI.ResetTabLayout()
        table.clear(TabOrder)
        for _, Name in ipairs(DefaultTabOrder) do table.insert(TabOrder, Name) end
        table.clear(InterfaceConfig.HiddenTabs)
        ApplyTabLayout()
        SaveInterfaceConfig()
    end

    function HubUI.ImportTabLayout(Order, HiddenTabs)
        local ImportedOrder = type(Order) == 'table' and Order or {}
        local NewOrder, Seen = {}, {}
        local Categories = {}
        for _, Name in ipairs(DefaultTabOrder) do
            local Data = HubUI.TabButtons[Name]
            if Data and not table.find(Categories, Data.Category) then table.insert(Categories, Data.Category) end
        end
        for _, Category in ipairs(Categories) do
            for _, Name in ipairs(ImportedOrder) do
                Name = tostring(Name)
                local Data = HubUI.TabButtons[Name]
                if Data and Data.Category == Category and not Seen[Name] then
                    table.insert(NewOrder, Name);
                    Seen[Name] = true
                end
            end
            for _, Name in ipairs(DefaultTabOrder) do
                local Data = HubUI.TabButtons[Name]
                if Data and Data.Category == Category and not Seen[Name] then
                    table.insert(NewOrder, Name);
                    Seen[Name] = true
                end
            end
        end
        table.clear(TabOrder)
        for _, Name in ipairs(NewOrder) do table.insert(TabOrder, Name) end
        InterfaceConfig.HiddenTabs = type(HiddenTabs) == 'table' and HiddenTabs or {}
        InterfaceConfig.HiddenTabs.Interface = nil
        if InterfaceConfig.HiddenTabs[HubUI.ActiveTab] then SwitchTab('Interface') end
        ApplyTabLayout()
    end

    local function CycleTab(Direction)
        local CurrentIndex = table.find(TabOrder, HubUI.ActiveTab) or 1
        for Offset = 1, #TabOrder do
            local Index = ((CurrentIndex - 1 + Direction * Offset) % #TabOrder) + 1
            local Name = TabOrder[Index]
            local Data = HubUI.TabButtons[Name]
            if Data and Data.Button.Visible then SwitchTab(Name);
                return end
        end
    end
    HubUI.CycleTab = CycleTab

