function State.Watch.GetCourtFrame(Court)
    if not Court then return nil, nil end
    local Now = os.clock()
    local Cached = State.Watch.FrameCache[Court]
    if Cached and Now - Cached.At < 1 then return Cached.Frame, Cached.Size end
    local Positions = Court:FindFirstChild('_CourtPositions')
    local Center = Positions and Positions:FindFirstChild('Center')
    if Center and Center:IsA('BasePart') then
        local Hitbox = Court:FindFirstChild('HitboxesHome') or Court:FindFirstChild('Hitboxes')
        local Away = Court:FindFirstChild('HitboxesAway')
        local HomeGoal = Hitbox and Hitbox:FindFirstChild('FieldGoal')
        local AwayGoal = Away and Away:FindFirstChild('FieldGoal')
        if HomeGoal and AwayGoal then
            local Axis = (AwayGoal.Position - HomeGoal.Position)
            local Length = Axis.Magnitude
            if Length > 1 then
                local Look = CFrame.lookAt(Center.Position, Center.Position + Axis.Unit)
                local Size = Vector3.new(math.max(40, Length * 0.6), 30, Length)
                State.Watch.FrameCache[Court] = { Frame = Look, Size = Size, At = Now }
                return Look, Size
            end
        end
        local Size = Vector3.new(60, 30, 90)
        State.Watch.FrameCache[Court] = { Frame = Center.CFrame, Size = Size, At = Now }
        return Center.CFrame, Size
    end
    local Ok, Frame, Size = pcall(function()
        local BoxFrame, BoxSize = Court:GetBoundingBox()
        return BoxFrame, BoxSize
    end)
    if Ok and Frame and Size then
        State.Watch.FrameCache[Court] = { Frame = Frame, Size = Size, At = Now }
        return Frame, Size
    end
    local PivotOk, Pivot = pcall(function() return Court:GetPivot() end)
    if PivotOk then
        local Size = Vector3.new(90, 30, 65)
        State.Watch.FrameCache[Court] = { Frame = Pivot, Size = Size, At = Now }
        return Pivot, Size
    end
    return nil, nil
end

function State.Watch.IsOnCourt(Position, Court, Margin)
    local Frame, Size = State.Watch.GetCourtFrame(Court)
    if not (Frame and Size and typeof(Position) == 'Vector3') then return false end
    local Local = Frame:PointToObjectSpace(Position)
    Margin = tonumber(Margin) or 0
    return math.abs(Local.X) <= Size.X * 0.5 + Margin
        and math.abs(Local.Z) <= Size.Z * 0.5 + Margin
        and math.abs(Local.Y) <= math.max(30, Size.Y * 0.5 + Margin)
end

function State.Watch.GetCourtSettings(Court)
    if not Court then return nil end
    return Court:FindFirstChild('_CourtSettings') or Court:FindFirstChild('CourtSettings')
end

function State.Watch.GetCourtPlayersFolder(Court)
    if not Court then return nil end
    return Court:FindFirstChild('_CourtPlayers') or Court:FindFirstChild('CourtPlayers')
end

function State.Watch.GetCourtValue(Court, Name)
    local Settings = State.Watch.GetCourtSettings(Court)
    local Value = Settings and Settings:FindFirstChild(Name)
    if Value and Value:IsA('ValueBase') then return Value.Value end
    return nil
end

function State.Watch.IsCourtStarted(Court)
    return State.Watch.GetCourtValue(Court, 'Started') == true
end

function State.Watch.GetCourtScore(Court)
    local Home = State.Watch.GetCourtValue(Court, 'HomeScore')
    local Away = State.Watch.GetCourtValue(Court, 'AwayScore')
    if Home == nil and Away == nil then return nil end
    return tostring(Home or 0) .. ' - ' .. tostring(Away or 0)
end

function State.Watch.IsPracticeCourt(Court)
    if not Court then return true end
    if string.find(Court.Name, 'Practice') then return true end
    if string.find(string.lower(Court.Name), 'practice', 1, true) then return true end
    if Court:GetAttribute('Practice') == true then return true end
    local PracticeArea = safe_find(Workspace, 'PracticeArea')
    if PracticeArea and Court:IsDescendantOf(PracticeArea) then return true end
    if not State.Watch.GetCourtPlayersFolder(Court) then return true end
    if not State.Watch.GetCourtSettings(Court) then return true end
    return false
end

State.Watch.IgnoredSlots = { Queue = true, Squad = true, Party = true }

function State.Watch.SlotIsPlaying(SlotName)
    SlotName = tostring(SlotName or '')
    for Prefix in pairs(State.Watch.IgnoredSlots) do
        if string.sub(SlotName, 1, #Prefix) == Prefix then return false end
    end
    return true
end

function State.Watch.SlotTeam(SlotName)
    return string.sub(tostring(SlotName or ''), 1, 4) == 'Home' and 'Home' or 'Away'
end

function State.Watch.GetPlayersForCourt(Court)
    local Output = {}
    local Folder = State.Watch.GetCourtPlayersFolder(Court)
    if not Folder then return Output end
    for _, Slot in ipairs(Folder:GetChildren()) do
        if Slot:IsA('ObjectValue') and State.Watch.SlotIsPlaying(Slot.Name) then
            local Player = Slot.Value
            if Player and Player:IsA('Player') then
                table.insert(Output, {
                    Player = Player,
                    Slot = Slot.Name,
                    Team = State.Watch.SlotTeam(Slot.Name),
                })
            end
        end
    end
    table.sort(Output, function(A, B)
        if A.Team ~= B.Team then return A.Team == 'Home' end
        return A.Slot < B.Slot
    end)
    return Output
end

function State.Watch.IsLiveMatch(Court, PlayerList)
    if State.Watch.IsPracticeCourt(Court) then return false end
    if type(PlayerList) ~= 'table' or #PlayerList == 0 then return false end
    if State.Watch.IsCourtStarted(Court) then return true end
    return #PlayerList >= 2
end

function State.Watch.FormatPlayers(PlayerList)
    if type(PlayerList) ~= 'table' or #PlayerList == 0 then return '--' end
    local Home, Away = {}, {}
    for _, Entry in ipairs(PlayerList) do
        local Player = Entry.Player
        if Player then
            local Name = Player.DisplayName ~= '' and Player.DisplayName or Player.Name
            table.insert(Entry.Team == 'Home' and Home or Away, Name)
        end
    end
    if #Home > 0 and #Away > 0 then
        return table.concat(Home, ', ') .. ' vs ' .. table.concat(Away, ', ')
    end
    local All = {}
    for _, Name in ipairs(Home) do table.insert(All, Name) end
    for _, Name in ipairs(Away) do table.insert(All, Name) end
    if #All == 0 then return '--' end
    return table.concat(All, ', ')
end

function State.Watch.RefreshOptions()
    local Watch = State.Watch
    table.clear(Watch.CourtOptions)
    table.clear(Watch.CourtLookup)
    table.clear(Watch.LiveCourts)
    table.clear(Watch.LivePlayers)
    table.insert(Watch.CourtOptions, 'Auto Live Match')

    local SelectedLabel
    for _, Court in ipairs(GetAllCourts()) do
        local Participants = State.Watch.IsPracticeCourt(Court) and {}
            or State.Watch.GetPlayersForCourt(Court)
        if State.Watch.IsLiveMatch(Court, Participants) then
            local Summary = State.Watch.FormatPlayers(Participants)
            local Score = State.Watch.GetCourtScore(Court)
            local Label = Court.Name .. '  |  ' .. Summary
            if Score and State.Watch.IsCourtStarted(Court) then
                Label = Label .. '  [' .. Score .. ']'
            end
            table.insert(Watch.CourtOptions, Label)
            Watch.CourtLookup[Label] = Court.Name
            Watch.LiveCourts[Court.Name] = Court
            Watch.LivePlayers[Court.Name] = Participants
            if Watch.CourtName == Court.Name then SelectedLabel = Label end
        end
    end

    table.sort(Watch.CourtOptions, function(A, B)
        if A == 'Auto Live Match' then return true end
        if B == 'Auto Live Match' then return false end
        return string.lower(A) < string.lower(B)
    end)
    if Watch.CourtName == 'Auto' or Watch.CourtName == 'Auto Match'
        or Watch.CourtName == 'Auto Live Match' then
        Watch.CourtName = 'Auto Live Match'
        Watch.CourtSelection = 'Auto Live Match'
    elseif SelectedLabel then
        Watch.CourtSelection = SelectedLabel
    else
        Watch.CourtName = 'Auto Live Match'
        Watch.CourtSelection = 'Auto Live Match'
    end
    Watch.LastRefresh = os.clock()
end

function State.Watch.GetCourt()
    local Watch = State.Watch
    if os.clock() - Watch.LastRefresh >= 0.75 then State.Watch.RefreshOptions() end
    if Watch.CourtName ~= 'Auto Live Match' then
        return Watch.LiveCourts[Watch.CourtName]
    end

    local Best, BestScore = nil, -math.huge
    for Name, Court in pairs(Watch.LiveCourts) do
        local Score = #(Watch.LivePlayers[Name] or {}) * 100
        if State.Watch.IsCourtStarted(Court) then Score += 1000 end
        local CurrentBall = State.Watch.GetCourtValue(Court, 'CurrentBall')
        if CurrentBall and CurrentBall.Parent then Score += 250 end
        if Score > BestScore then Best, BestScore = Court, Score end
    end
    return Best
end

function State.Watch.FindBall(Court)
    local Watch = State.Watch
    local Now = os.clock()
    if Watch.BallCourt == Court and Watch.Ball and Watch.Ball.Parent
        and Now - Watch.BallAt < 0.1 then
        return Watch.Ball
    end
    local BallModel = State.Watch.GetCourtValue(Court, 'CurrentBall')
    local Part
    if BallModel and BallModel.Parent then
        local Holder = BallModel.Parent
        local Root = Holder and Holder:FindFirstChild('HumanoidRootPart')
        if Root then
            Part = Root
        else
            Part = BallModel:FindFirstChild('Ball')
                or (BallModel:IsA('BasePart') and BallModel or nil)
                or BallModel:FindFirstChildWhichIsA('BasePart')
        end
    end
    if not Part then
        local Positions = Court and Court:FindFirstChild('_CourtPositions')
        local Center = Positions and Positions:FindFirstChild('Center')
        if Center and Center:IsA('BasePart') then Part = Center end
    end
    Watch.Ball = Part
    Watch.BallCourt = Court
    Watch.BallAt = Now
    return Part
end

function State.Watch.SetCourt(Selection)
    local Watch = State.Watch
    Selection = tostring(Selection or 'Auto Live Match')
    if Selection == 'Auto' or Selection == 'Auto Match' then Selection = 'Auto Live Match' end
    local CourtName = Watch.CourtLookup[Selection]
    Watch.CourtSelection = Selection
    Watch.CourtName = CourtName or 'Auto Live Match'
    CONFIG.WatchCourt = Watch.CourtName
    Watch.Court = nil
    Watch.CachedCourt = nil
    Watch.CachedParticipants = {}
    Watch.RosterAt = 0
    Watch.Ball = nil
    Watch.BallCourt = nil
    Watch.PlayerSummary = '--'
end

function State.Watch.SetMode(Mode)
    if not table.find(State.Watch.CameraModes, Mode) then Mode = '2K CAM' end
    State.Watch.Mode = Mode
    CONFIG.WatchCameraMode = Mode
    State.Watch.LastDirectorCut = 0
end

function State.Watch.RestoreCamera()
    local Watch = State.Watch
    local Camera = Workspace.CurrentCamera
    if not Camera then return end
    Camera.CameraType = Watch.SavedCameraType or Enum.CameraType.Custom
    local Character = LP.Character
    local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
    Camera.CameraSubject = Watch.SavedCameraSubject or Humanoid
    Camera.FieldOfView = Watch.SavedFieldOfView or 70
    State.Watch.ApplyFilter(nil)
end

function State.Watch.SetActive(Value)
    local Watch = State.Watch
    Value = Value == true
    if Value == Watch.Active then return end
    local Camera = Workspace.CurrentCamera
    if Value then
        State.Watch.RefreshOptions()
        Watch.Court = State.Watch.GetCourt()
        if not Watch.Court then
            Watch.Active = false
            Watch.Status = 'NO LIVE MATCHES'
            Watch.PlayerSummary = '--'
            return
        end
        if Camera then
            Watch.SavedCameraType = Camera.CameraType
            Watch.SavedCameraSubject = Camera.CameraSubject
            Watch.SavedFieldOfView = Camera.FieldOfView
        end
        Watch.Active = true
        Watch.CachedCourt = Watch.Court
        Watch.CachedParticipants = Watch.LivePlayers[Watch.Court.Name]
            or State.Watch.GetPlayersForCourt(Watch.Court)
        Watch.RosterAt = os.clock()
        Watch.PlayerSummary = State.Watch.FormatPlayers(Watch.CachedParticipants)
        Watch.Status = 'WATCHING LIVE MATCH'
    else
        Watch.Active = false
        Watch.Status = 'READY'
        Watch.Court = nil
        Watch.Ball = nil
        Watch.BallCourt = nil
        Watch.CachedCourt = nil
        Watch.CachedParticipants = {}
        State.Watch.RestoreCamera()
    end
end

function State.Watch.CycleCourt(Direction)
    State.Watch.RefreshOptions()
    local Options = State.Watch.CourtOptions
    if #Options <= 1 then return end
    local Index = table.find(Options, State.Watch.CourtSelection) or 1
    repeat
        Index = ((Index - 1 + Direction) % #Options) + 1
    until Options[Index] ~= 'Auto Live Match'
    State.Watch.SetCourt(Options[Index])
    if State.Watch.Active then State.Watch.Court = State.Watch.GetCourt() end
end

function State.Watch.CycleMode(Direction)
    local Modes = State.Watch.CameraModes
    local Index = table.find(Modes, State.Watch.Mode) or 1
    State.Watch.SetMode(Modes[((Index - 1 + Direction) % #Modes) + 1])
end

function State.Watch.ApplyFilter(Filter)
    local Watch = State.Watch
    if not Filter then
        if Watch.AppliedFilter == nil then return end
        Watch.AppliedFilter = nil
        if Watch.FilterEffect then Watch.FilterEffect.Enabled = false end
        return
    end
    if Watch.AppliedFilter == Filter and Watch.FilterEffect
        and Watch.FilterEffect.Parent and Watch.FilterEffect.Enabled then return end
    if not Watch.FilterEffect or not Watch.FilterEffect.Parent then
        Watch.FilterEffect = Instance.new('ColorCorrectionEffect')
        Watch.FilterEffect.Name = 'GoldenEagleSpectatorFilter'
        Watch.FilterEffect.Parent = Lighting
    end
    Watch.FilterEffect.Enabled = true
    Watch.FilterEffect.Saturation = Filter.Sat or 0
    Watch.FilterEffect.Contrast = Filter.Cont or 0
    Watch.FilterEffect.Brightness = Filter.Bright or 0
    Watch.FilterEffect.TintColor = Filter.Tint or Color3.new(1, 1, 1)
    Watch.AppliedFilter = Filter
end

function State.Watch.NearestPlayerRoot(Position, Court)
    local Watch = State.Watch
    local Participants = (Watch.CachedCourt == Court and Watch.CachedParticipants)
        or Watch.LivePlayers[Court and Court.Name or '']
        or State.Watch.GetPlayersForCourt(Court)
    local Nearest, Minimum = nil, math.huge
    for _, Entry in ipairs(Participants) do
        local Player = Entry.Player
        local Character = Player and Player.Character
        local Root = Character and Character:FindFirstChild('HumanoidRootPart')
        if Root then
            local Distance = (Root.Position - Position).Magnitude
            if Distance < Minimum then Nearest, Minimum = Root, Distance end
        end
    end
    return Nearest
end

function State.Watch.CameraForMode(Mode, FocusPosition, Court, DeltaTime)
    local Shot = State.Watch.Shots[Mode] or State.Watch.Shots['2K CAM']
    local LookTarget = FocusPosition
    if Shot.Type == 'Player' or Shot.Type == 'OrbitPlayer' then
        local Nearest = State.Watch.NearestPlayerRoot(FocusPosition, Court)
        if Nearest then LookTarget = Nearest.Position end
    end
    local CourtFrame = State.Watch.GetCourtFrame(Court)
    local CameraPosition
    if Shot.Type == 'OrbitBall' or Shot.Type == 'OrbitPlayer' then
        local Radius = Shot.Radius or 20
        local Height = Shot.Height or 10
        local Time = os.clock() * (Shot.Speed or 0.5)
        local OrbitOffset = Vector3.new(math.cos(Time) * Radius, Height, math.sin(Time) * Radius)
        CameraPosition = LookTarget + (CourtFrame and CourtFrame:VectorToWorldSpace(OrbitOffset) or OrbitOffset)
    else
        local Offset = Shot.Offset or Vector3.new(0, 10, 20)
        CameraPosition = LookTarget + (CourtFrame and CourtFrame:VectorToWorldSpace(Offset) or Offset)
    end
    local TargetCFrame = CFrame.new(CameraPosition, LookTarget + Vector3.new(0, 1.5, 0))
    if Shot.Roll and Shot.Roll ~= 0 then
        TargetCFrame = TargetCFrame * CFrame.Angles(0, 0, math.rad(Shot.Roll))
    end
    return TargetCFrame, 1 - math.exp(-8 * DeltaTime), Shot.Filter
end

function State.Watch.Update(DeltaTime)
    local Watch = State.Watch
    if not (Watch.Active and State.Active) then return end
    local Camera = Workspace.CurrentCamera
    if not Camera then return end

    local Now = os.clock()
    local Court = Watch.Court
    if Now - Watch.RosterAt >= 0.5 or not (Court and Court.Parent) then
        Watch.RosterAt = Now
        Court = State.Watch.GetCourt()
        Watch.Court = Court
        if not Court then
            State.Watch.SetActive(false)
            Watch.Status = 'MATCH ENDED / EMPTY'
            Watch.PlayerSummary = '--'
            return
        end
        local Participants = Watch.LivePlayers[Court.Name] or State.Watch.GetPlayersForCourt(Court)
        if not State.Watch.IsLiveMatch(Court, Participants) then
            State.Watch.SetActive(false)
            Watch.Status = 'MATCH ENDED / EMPTY'
            Watch.PlayerSummary = '--'
            return
        end
        Watch.CachedCourt = Court
        Watch.CachedParticipants = Participants
        Watch.PlayerSummary = State.Watch.FormatPlayers(Participants)
    end

    local Frame = State.Watch.GetCourtFrame(Court)
    if not Frame then
        Watch.Status = 'COURT UNAVAILABLE'
        State.Watch.ApplyFilter(nil)
        return
    end
    local Ball = State.Watch.FindBall(Court)
    local FocusPosition = Ball and Ball.Position or (Frame.Position + Vector3.new(0, 3, 0))
    local Desired, Smooth, Filter = State.Watch.CameraForMode(
        Watch.Mode, FocusPosition, Court, DeltaTime or 1 / 60
    )
    if Camera.CameraType ~= Enum.CameraType.Scriptable then Camera.CameraType = Enum.CameraType.Scriptable end
    if Camera.CameraSubject ~= nil then Camera.CameraSubject = nil end
    Camera.CFrame = Camera.CFrame:Lerp(Desired, Smooth)
    State.Watch.ApplyFilter(Filter)
    local Status = Ball and 'WATCHING LIVE MATCH' or 'WATCHING COURT'
    if Watch.Status ~= Status then Watch.Status = Status end
end

