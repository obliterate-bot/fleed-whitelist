State.PingAdaptive = {
    Raw = 0,
    Average = 0,
    Lead = 0,
    Samples = 0,
    LastSampleAt = 0,
    OwnerStatus = 'UNKNOWN',
    OwnerOwned = false,
    OwnerSource = 'NO BALL',
    OwnerCheckedAt = 0,
    FlightOwned = false,
    FlightSeenAt = 0,
}

function State.PingAdaptive.Sample()
    local Now = os.clock()
    if State.PingAdaptive.Samples > 0
        and (Now - State.PingAdaptive.LastSampleAt) < 0.25 then
        return State.PingAdaptive.Average
    end
    State.PingAdaptive.LastSampleAt = Now

    local Raw = tonumber(State.Utility.GetPing()) or 0
    if Raw < 0 then Raw = 0 end
    if Raw > 2000 then Raw = 2000 end
    State.PingAdaptive.Raw = Raw

    if State.PingAdaptive.Samples < 1 then
        State.PingAdaptive.Average = Raw
    else
        State.PingAdaptive.Average =
        State.PingAdaptive.Average * 0.75 + Raw * 0.25
    end
    State.PingAdaptive.Samples = State.PingAdaptive.Samples + 1
    return State.PingAdaptive.Average
end

function State.PingAdaptive.GetLead()
    if CONFIG.PingAdaptiveRelease ~= true then
        State.PingAdaptive.Lead = 0
        return 0
    end

    local Average = State.PingAdaptive.Sample()
    local Baseline = tonumber(CONFIG.PingAdaptiveBaseline) or 60
    local Strength = tonumber(CONFIG.PingAdaptiveStrength) or 1
    local MaximumLead = (tonumber(CONFIG.PingAdaptiveMaxLead) or 250) / 1000

    local Excess = (Average - Baseline) / 1000
    if Excess <= 0 then
        State.PingAdaptive.Lead = 0
        return 0
    end

    local Lead = math.clamp(Excess * Strength, 0, math.max(0, MaximumLead))
    State.PingAdaptive.Lead = Lead
    return Lead
end

function State.PingAdaptive.ResolveBall()
    local Held = GetHeldBasketballModel(LP)
    local HeldBall = Held and Held:FindFirstChild('Ball', true)
    if HeldBall and safe_is_a(HeldBall, 'BasePart') then
        return HeldBall, 'HELD'
    end

    if not HumanoidRootPart then return nil, 'NO ROOT' end
    local RootPosition = HumanoidRootPart.Position
    local Best, BestDistance = nil, math.huge
    local Ok, Tagged = pcall(function()
        return CollectionService:GetTagged('BallHandle')
    end)
    if Ok and type(Tagged) == 'table' then
        for _, Candidate in ipairs(Tagged) do
            if safe_is_a(Candidate, 'BasePart') and Candidate.Parent then
                local Distance = (Candidate.Position - RootPosition).Magnitude
                if Distance < BestDistance then
                    Best, BestDistance = Candidate, Distance
                end
            end
        end
    end

    if Best then return Best, 'LOOSE' end
    return nil, 'NO BALL'
end

function State.PingAdaptive.GetOwnership()
    local Now = os.clock()
    if (Now - State.PingAdaptive.OwnerCheckedAt) < 0.3 then
        return State.PingAdaptive.OwnerStatus, State.PingAdaptive.OwnerOwned
    end
    State.PingAdaptive.OwnerCheckedAt = Now

    local Status, Owned = 'UNKNOWN', false
    if type(isnetworkowner) ~= 'function' then
        Status = 'PROBE UNSUPPORTED'
    else
        local Ball, Source = State.PingAdaptive.ResolveBall()
        State.PingAdaptive.OwnerSource = Source
        if not Ball then
            Status = Source
        else
            local Ok, Result = pcall(isnetworkowner, Ball)
            if not Ok then
                Status = 'PROBE FAILED'
            else
                Owned = Result == true
                Status = (Owned and 'CLIENT / YOU' or 'SERVER')
                .. '  ' .. Source
                if Source == 'LOOSE' then
                    State.PingAdaptive.FlightOwned = Owned
                    State.PingAdaptive.FlightSeenAt = Now
                end
            end
        end
    end

    State.PingAdaptive.OwnerStatus = Status
    State.PingAdaptive.OwnerOwned = Owned
    return Status, Owned
end

function State.PingAdaptive.GetPingReadout()
    local Average = State.PingAdaptive.Sample()
    if CONFIG.PingAdaptiveRelease ~= true then
        return string.format('%d ms  OFF', math.floor(Average + 0.5))
    end
    local Lead = State.PingAdaptive.GetLead()
    return string.format('%d ms  +%d ms lead',
        math.floor(Average + 0.5), math.floor(Lead * 1000 + 0.5))
end

function State.PingAdaptive.GetOwnershipReadout()
    local Status = State.PingAdaptive.GetOwnership()
    if State.PingAdaptive.FlightSeenAt > 0
        and (os.clock() - State.PingAdaptive.FlightSeenAt) < 8 then
        return Status .. (State.PingAdaptive.FlightOwned
            and '  (flight: CLIENT)' or '  (flight: SERVER)')
    end
    return Status
end

