                Notify('GOLDEN EAGLE', 'Clipboard import unavailable.')
                return
            end
            local ReadSuccess, Raw = pcall(getclipboard)
            local DecodeSuccess, Decoded = false, nil
            if ReadSuccess then DecodeSuccess, Decoded = pcall(HttpService.JSONDecode, HttpService, Raw) end
            if not DecodeSuccess or type(Decoded) ~= 'table' then
                Notify('GOLDEN EAGLE', 'Clipboard does not contain valid profile JSON.')
