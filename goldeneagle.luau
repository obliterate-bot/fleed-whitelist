local function GetDirectPassFormulaTarget(Teammate)
    local Character = LP.Character
    local TargetCharacter = Teammate and Teammate.Character
    local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild('HumanoidRootPart')
    local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass('Humanoid')
    local Head = Character and Character:FindFirstChild('Head')
    if not (Character and TargetRoot and Head) then return nil end
    local Basketball = Character:FindFirstChild('Basketball')
    local Ball = Basketball and Basketball:FindFirstChild('Ball', true)
    local ReleaseOrigin = Ball and Ball:IsA('BasePart') and Ball.Position or Head.Position
    local Airborne = TargetHumanoid and TargetHumanoid.FloorMaterial == Enum.Material.Air
    local CatchOffset = Vector3.new(0, Airborne and 1.1 or 1.8, 0)
    local BaseCatch = TargetRoot.Position + CatchOffset
    local AimPosition = BaseCatch
    local ArcMode = CONFIG.PassArcMode == 'Low' and 'Low' or 'High'
    local LeadFactor = math.clamp(tonumber(CONFIG.PassLead) or 0, 0, 100) / 100
    local Angle, FlightTime, Flat, Distance
    for _ = 1, 2 do
        local Delta = AimPosition - ReleaseOrigin
        Flat = Vector3.new(Delta.X, 0, Delta.Z)
        Distance = Flat.Magnitude
        if Distance <= 0.0001 then return nil end
        Angle, FlightTime = SolveFormulaArc(Distance, Delta.Y, CONFIG.PassPower, ArcMode)
        if not Angle then return nil end
        AimPosition = BaseCatch + TargetRoot.AssemblyLinearVelocity * math.max(FlightTime or 0, 0) * LeadFactor
    end
    local Context = State.CourtContext and State.CourtContext.Get()
    for _, Defender in ipairs(Context and Context.Opponents or {}) do
        local DefenderRoot = Defender.Character and Defender.Character:FindFirstChild('HumanoidRootPart')
        if DefenderRoot and State.AutoGetOpen.DistanceToSegmentXZ(DefenderRoot.Position, ReleaseOrigin, AimPosition) < 3.5 then return nil end
    end
    local Direction = Flat.Unit * math.cos(Angle) + Vector3.new(0, math.sin(Angle), 0)
    return ReleaseOrigin + Direction * 1000, Distance
end

local function ExecutePassAt(TargetPosition, Generation)
    local Character = LP.Character
    local Root = Character and Character:FindFirstChild('HumanoidRootPart')
    local Camera = Workspace.CurrentCamera
    if not Root or not Camera or typeof(TargetPosition) ~= 'Vector3' then return false end

    if SilentAim.ActorAimReady ~= true then
        local Ready = false
        for Attempt = 1, 3 do
            SilentAim.HookNewActors()
            Ready = SilentAim.EnsureActorAim()
            if Ready then break end
            task.wait(0.05)
        end
        if not Ready then return false end
    end

    local PreviousPower = State.PowerBypass.GetEffectivePower()
    local PassPower = State.PowerBypass.SyncChannels(CONFIG.PassPower)
    SilentAim.ClearActorAim()
    local CenterX, CenterY = GetFullscreenCenterX(), Camera.ViewportSize.Y / 2
    local SavedCameraCFrame, SavedCameraFocus
    local MouseDown = false

    local Ok = pcall(function()
        if CONFIG.CameraIndependentFallback then
            local Head = Character:FindFirstChild('Head')
            if Head then
                SavedCameraCFrame = Camera.CFrame
                SavedCameraFocus = Camera.Focus
                Camera.CFrame = CFrame.new(Head.Position, TargetPosition)
                Camera.Focus = CFrame.new(TargetPosition)
            end
        end

        local Possession = GetHeldBasketballModel(LP)
        for Attempt = 1, 2 do
            if not Possession or GetHeldBasketballModel(LP) ~= Possession then break end
            SilentAim.FireActorAim(TargetPosition)
            RunService.RenderStepped:Wait()
            SilentAim.FireActorAim(TargetPosition)
            VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, true, game, 1)
            MouseDown = true
            task.wait(0.045)
            VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, false, game, 1)
            MouseDown = false
            if Attempt == 1 then
                for _ = 1, 10 do task.wait(0.02);
                    if GetHeldBasketballModel(LP) ~= Possession then break end end
                if GetHeldBasketballModel(LP) ~= Possession then break end
            end
        end
    end)

    if MouseDown then
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, false, game, 1)
        end)
    end
    if SavedCameraCFrame then
        pcall(function()
            Camera.CFrame = SavedCameraCFrame
            if SavedCameraFocus then Camera.Focus = SavedCameraFocus end
        end)
    end
    State.Lifecycle:Delay(0.25, function()
        if State.PassGeneration == Generation then SilentAim.ClearActorAim() end

        if PreviousPower ~= PassPower
            and State.PowerBypass.GetEffectivePower() == PassPower then
            State.PowerBypass.SyncChannels(PreviousPower)
        end
    end)
    return Ok
end

local function BeginPass(Work)
    if State.PassInProgress or State.silentShootActive then return false end
    State.PassGeneration += 1
    local Generation = State.PassGeneration
    State.PassInProgress = true
    State.Lifecycle:Spawn(function()
        local Ok, ErrorText = pcall(Work, Generation)
        if State.PassGeneration == Generation then State.PassInProgress = false end
        if not Ok then
            SilentAim.ClearActorAim()
            warn('[GOLDEN EAGLE] Pass failed: ' .. tostring(ErrorText))
        end
    end)
    return true
end

local function TriggerPassJump(Character)
    local LocalHumanoid = Character and Character:FindFirstChild('Humanoid')
    if not LocalHumanoid then return end
    local CurrentState = LocalHumanoid:GetState()
    if CurrentState ~= Enum.HumanoidStateType.Jumping
        and CurrentState ~= Enum.HumanoidStateType.Freefall then
        LocalHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

local function StartTeammatePass(Number)
    if not State.AutoPassEnabled then return end
    if not GetHeldBasketballModel(LP) then return end

    local Roster = GetPassTeammates()
    local Teammate = Roster[Number]
    if not Teammate then return end

    BeginPass(function(Generation)
        if State.JumpBeforePass then
            TriggerPassJump(LP.Character)
            task.wait(CONFIG.JumpPassDelay)
        end
        if not State.Active or not State.AutoPassEnabled then return end
        if not GetHeldBasketballModel(LP) then return end

        if not table.find(GetPassTeammates(), Teammate) then return end

        local FormulaTarget = GetDirectPassFormulaTarget(Teammate)
        if not FormulaTarget then return end
        ExecutePassAt(FormulaTarget, Generation)
    end)
end

