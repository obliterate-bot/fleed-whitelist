    CourtSkinner = nil,
    CourtSkinOptions = GetLocalCosmeticOptions('CourtSkin', 'CourtSkin_Default'),
    CourtSkinStatus = 'IDLE',
    OriginalClanTag = safe_get_attribute(LP, 'ClanTag'),
    OriginalClanColor = safe_get_attribute(LP, 'ClanColor'),
    OriginalChatTag = safe_get_attribute(LP, 'ChatTag'),
    ClanTagWatch = nil,
}

function State.LocalCosmeticExtras.GetCourtSkinner()
    local Cached = State.LocalCosmeticExtras.CourtSkinner
    if Cached then return Cached end
    local Module
    pcall(function()
        local Scripts = LP:FindFirstChild('PlayerScripts')
        local Found = Scripts and Scripts:FindFirstChild('CourtSkinner', true)
        if Found and Found:IsA('ModuleScript') then Module = require(Found) end
    end)
    if type(Module) == 'table' and type(Module.changeSkin) == 'function' then
        State.LocalCosmeticExtras.CourtSkinner = Module
        return Module
    end
    return nil
end

function State.LocalCosmeticExtras.ResolveCourtSkin(Name)
    local ShopItems = ReplicatedStorage:FindFirstChild('ShopItems')
    local Folder = ShopItems and ShopItems:FindFirstChild('CourtSkin')
    if not Folder then return nil end
    if Name and Name ~= 'None' then
        local Match = Folder:FindFirstChild(Name)
        if Match then return Match end
    end
    return Folder:FindFirstChild('CourtSkin_Default')
end

function State.LocalCosmeticExtras.ApplyCourtSkin()
    local Skinner = State.LocalCosmeticExtras.GetCourtSkinner()
    if not Skinner then
        State.LocalCosmeticExtras.CourtSkinStatus = 'UNSUPPORTED'
        return false
    end
    local Name = State.LocalCourtSkinSpoofEnabled
        and State.LocalCourtSkin or 'CourtSkin_Default'
    local Skin = State.LocalCosmeticExtras.ResolveCourtSkin(Name)
    if not Skin then
        State.LocalCosmeticExtras.CourtSkinStatus = 'NO ASSETS'
        return false
    end
    local Applied = 0
    for _, Court in ipairs(GetAllCourts()) do
        local Ok = pcall(function() Skinner.changeSkin(Court, Skin, false) end)
        if Ok then Applied = Applied + 1 end
    end
    State.LocalCosmeticExtras.CourtSkinStatus = Applied > 0
        and string.format('%s x%d', Name, Applied) or 'NO COURTS'
    return Applied > 0
end

function State.LocalCosmeticExtras.SetCourtSkin(Enabled, Name, ShouldNotify)
    Enabled = Enabled == true
    State.LocalCourtSkinSpoofEnabled = Enabled
    CONFIG.LocalCourtSkinSpoof = Enabled
    if Name then
        State.LocalCourtSkin = Name
        CONFIG.LocalCourtSkin = Name
    end
    if Enabled then
        pcall(function() State.ClientSettings.SetConfig('Toggle_CourtSkins', true) end)
    end
    local Ok = State.LocalCosmeticExtras.ApplyCourtSkin()
    if ShouldNotify then
        if not Enabled then
            Notify('Court skin', 'Restored the default court skin locally.')
        elseif Ok then
            Notify('Court skin', string.format(
                'Applied %s locally.', tostring(State.LocalCourtSkin)))
        else
            Notify('Court skin', string.format(
                'Could not apply (%s).', State.LocalCosmeticExtras.CourtSkinStatus))
        end
    end
    if HubUI.Sync then HubUI.Sync() end
    return Ok
end

function State.LocalCosmeticExtras.SanitizeClanTag(Value)
    Value = tostring(Value or ''):gsub('%s+', '')
    Value = Value:sub(1, 6)
    if Value == '' then Value = 'GEH' end
    Value = Value:upper()
    local Stripped = Value:lower():gsub('%W', '')
    for _, Blocked in ipairs({ 'staff', 'admin', 'developer', 'hoopz',
        'dev', 'owner', 'creator', 'mod', 'moderator' }) do
        if Stripped:find(Blocked, 1, true) then return 'GEH' end
    end
    return Value
end

State.LocalCosmeticExtras.ChatTagStyles = { 'Off', 'Custom tag', 'VIP', 'Fan',
    'Staff', 'Tester', 'Youtuber', 'Booster', 'Twitch' }

function State.LocalCosmeticExtras.ResolveChatTagStyle(Style)
    if Style == nil or Style == 'Off' then return nil end
    if Style == 'Custom tag' then return 'Clan' end
    if table.find(State.LocalCosmeticExtras.ChatTagStyles, Style) then return Style end
    return nil
end

function State.LocalCosmeticExtras.EncodeChatTagStyles()
    return table.concat(State.LocalChatTagStyles or {}, ',')
end

function State.LocalCosmeticExtras.DecodeChatTagStyles(Text)
    local Styles = {}
    if type(Text) ~= 'string' then return Styles end
    for Piece in string.gmatch(Text, '[^,]+') do
        local Style = Piece:match('^%s*(.-)%s*$')
        if Style ~= '' and Style ~= 'Off'
            and table.find(State.LocalCosmeticExtras.ChatTagStyles, Style)
            and not table.find(Styles, Style) then
            table.insert(Styles, Style)
        end
    end
    return Styles
end

function State.LocalCosmeticExtras.IsChatTagStyleActive(Style)
    return table.find(State.LocalChatTagStyles or {}, Style) ~= nil
end

function State.LocalCosmeticExtras.DescribeChatTagStyles()
    local Styles = State.LocalChatTagStyles or {}
    if #Styles == 0 then return 'Off' end
    return table.concat(Styles, ' + ')
end

State.LocalCosmeticExtras.ChatTagMarkup = {
    VIP = "<b><i><font color='rgb(255, 200, 0)'>[VIP]</font></i></b>  ",
    Fan = "<b><i><font color='rgb(125, 251, 90)'>[Fan]</font></i></b>  ",
    Staff = "<b><i><font color='rgb(0, 235, 255)'>[Staff]</font></i></b>  ",
    Tester = "<b><i><font color='rgb(175, 255, 255)'>[Tester]</font></i></b>  ",
    Youtuber = "<b><i><font color='rgb(255, 50, 50)'>[Youtuber]</font></i></b>  ",
    Booster = "<b><i><font color='rgb(255, 85, 255)'>[Booster]</font></i></b>  ",
    Twitch = "<b><i><font color='rgb(170, 85, 255)'>[Twitch]</font></i></b>  ",
}

function State.LocalCosmeticExtras.BuildChatTagMarkup(Style)
    if Style == 'Custom tag' or Style == 'Clan' then
        local Tag = State.LocalCosmeticExtras.SanitizeClanTag(State.LocalClanTag)
        if Tag == '' then return '' end
        local Primary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LocalChatTagPrimaryColor, Color3.fromRGB(255, 59, 213))
        local Secondary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LocalChatTagSecondaryColor, Color3.fromRGB(53, 217, 255))
        local Mode = tostring(CONFIG.LocalChatTagColorMode or 'Solid')
        local Speed = math.clamp(tonumber(CONFIG.LocalChatTagGradientSpeed) or 0.65, 0.05, 5)
        local Characters = '[' .. Tag .. ']'
        local Parts = {}
        for Index = 1, #Characters do
            local T = #Characters <= 1 and 0 or (Index - 1) / (#Characters - 1)
            if Mode == 'Animated Gradient' then T = (T + os.clock() * Speed * 0.18) % 1 end
            local Color = Mode == 'Solid' and Primary or Primary:Lerp(Secondary, T)
            table.insert(Parts, string.format("<font color='rgb(%d,%d,%d)'><b>%s</b></font>",
                math.round(Color.R * 255), math.round(Color.G * 255), math.round(Color.B * 255), Characters:sub(Index, Index)))
        end
        return table.concat(Parts) .. ' '
    end
    return State.LocalCosmeticExtras.ChatTagMarkup[Style] or ''
end

function State.LocalCosmeticExtras.DecorateChatMessage(Message, Properties)
    local Extras = State.LocalCosmeticExtras
    if not Extras.IsChatTagStyleActive('Custom tag') then return Properties end
    local Source = Message and Message.TextSource
    if not Source or Source.UserId ~= LP.UserId then return Properties end
    local Extra = ''
    for _, Style in ipairs(State.LocalChatTagStyles or {}) do
        Extra = Extra .. Extras.BuildChatTagMarkup(Style)
    end
    if Extra == '' then return Properties end
    Properties = Properties or Instance.new('TextChatMessageProperties')
    if Properties.Text == nil or Properties.Text == '' then Properties.Text = Message.Text or '' end
    local Name = LP:GetAttribute('DisguiseName') or LP.Name
    local NameColor = LP:GetAttribute('NameColor') or Color3.fromRGB(200, 200, 200)
    Properties.PrefixText = string.format("%s<b><font color='rgb(%d,%d,%d)'>%s:</font></b>",
        Extra, math.round(NameColor.R * 255), math.round(NameColor.G * 255),
        math.round(NameColor.B * 255), Name)
    return Properties
end

function State.LocalCosmeticExtras.GetChatRoot()
    local Root
    if type(gethui) == 'function' then
        local Ok, Hui = pcall(gethui)
        if Ok and Hui then Root = Hui:FindFirstChild('ExperienceChat') end
    end
    if not Root then
        local Ok, CoreGui = pcall(function() return game:GetService('CoreGui') end)
        if Ok and CoreGui then Root = CoreGui:FindFirstChild('ExperienceChat') end
    end
    return Root
end

function State.LocalCosmeticExtras.PatchChatWindow()
    local Extras = State.LocalCosmeticExtras
    if not Extras.IsChatTagStyleActive('Custom tag') then return end
    local Root = Extras.GetChatRoot()
    if not Root then return end
    local Tag = Extras.SanitizeClanTag(State.LocalClanTag)
    local TagMarkup = Extras.BuildChatTagMarkup('Custom tag')
    if Tag == '' or TagMarkup == '' then return end
    local Name = LP.Name
    local NameColon = Name .. ':'
    local Animated = tostring(CONFIG.LocalChatTagColorMode or 'Solid') == 'Animated Gradient'
    local NameColor = LP:GetAttribute('NameColor') or Color3.fromRGB(200, 200, 200)
    local NameMarkup = string.format("<b><font color='rgb(%d,%d,%d)'>%s:</font></b>",
        math.round(NameColor.R * 255), math.round(NameColor.G * 255),
        math.round(NameColor.B * 255), Name)
    for _, Obj in ipairs(Root:GetDescendants()) do
        if (Obj:IsA('TextLabel') or Obj:IsA('TextButton')) and Obj.RichText then
            local Text = Obj.Text
            local Styled = Obj:GetAttribute('GoldenEagleChatStyled') == true
            if type(Text) == 'string' and Text:find(NameColon, 1, true)
                and (Styled or Text:find('>' .. Tag .. '<', 1, true)) then
                if not Styled or Animated then
                    local NamePos = Text:find(NameColon, 1, true)
                    local PrefixEnd = Text:find('</font></b>', NamePos, true)
                    if PrefixEnd then
                        local Suffix = Text:sub(PrefixEnd + 11)
                        Obj.Text = TagMarkup .. NameMarkup .. Suffix
                        Obj:SetAttribute('GoldenEagleChatStyled', true)
                    end
                end
            end
        end
    end
end

function State.LocalCosmeticExtras.InstallChatTagAnimation()
    local Extras = State.LocalCosmeticExtras
    if Extras.ChatTagAnimationInstalled then return end
    Extras.ChatTagAnimationInstalled = true
    local RunService = game:GetService('RunService')
    local TextService = game:GetService('TextService')
    local function Attach(Label, Tag)
        local Overlay = Label:FindFirstChild('GoldenEagleAnimatedChatTag')
        if Overlay then return Overlay end
        Overlay = Instance.new('Frame')
        Overlay.Name = 'GoldenEagleAnimatedChatTag'
        Overlay.BackgroundTransparency = 1
        Overlay.BorderSizePixel = 0
        Overlay.Size = UDim2.new(1, 0, 1, 0)
        Overlay.Position = UDim2.new(0, 0, 0, 0)
        Overlay.ZIndex = Label.ZIndex + 2
        Overlay.Parent = Label
        local X = 0
        for Index = 1, #Tag do
            local Letter = Instance.new('TextLabel')
            Letter.Name = 'Letter' .. Index
            Letter.BackgroundTransparency = 1
            Letter.BorderSizePixel = 0
            Letter.RichText = false
            Letter.Font = Label.Font
            Letter.TextSize = Label.TextSize
            Letter.TextStrokeTransparency = Label.TextStrokeTransparency
            Letter.TextStrokeColor3 = Label.TextStrokeColor3
            Letter.TextTransparency = Label.TextTransparency
            Letter.TextYAlignment = Label.TextYAlignment
            Letter.TextXAlignment = Enum.TextXAlignment.Left
            Letter.Text = Tag:sub(Index, Index)
            local Width = TextService:GetTextSize(Letter.Text, Label.TextSize, Label.Font, Vector2.new(1000, Label.AbsoluteSize.Y)).X
            Letter.Size = UDim2.new(0, Width + 1, 1, 0)
            Letter.Position = UDim2.new(0, X, 0, 0)
            Letter.ZIndex = Overlay.ZIndex + 1
            Letter.Parent = Overlay
            X = X + Width
        end
        return Overlay
    end
    Extras.ChatTagAnimationConnection = State.Lifecycle:Connect(RunService.RenderStepped, function()
        local Now = os.clock()
        if Now - (Extras.ChatTagAnimationAt or 0) < 0.10 then return end
        Extras.ChatTagAnimationAt = Now
        if not Extras.IsChatTagStyleActive('Custom tag') then return end
        local Root = Extras.GetChatRoot()
        if not Root then return end
        local Tag = Extras.SanitizeClanTag(State.LocalClanTag)
        if Tag == '' then return end
        local Name = (LP:GetAttribute('DisguiseName') or LP.Name) .. ':'
        local Primary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LocalChatTagPrimaryColor, Color3.fromRGB(255, 80, 220))
        local Secondary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LocalChatTagSecondaryColor, Color3.fromRGB(55, 220, 255))
        local Mode = tostring(CONFIG.LocalChatTagColorMode or 'Solid')
        local Speed = math.max(0.05, tonumber(CONFIG.LocalChatTagGradientSpeed) or 0.65)
        for _, Label in ipairs(Root:GetDescendants()) do
            if (Label:IsA('TextLabel') or Label:IsA('TextButton')) then
                local Text = Label.Text
                if type(Text) == 'string' and Text:find(Tag .. Name, 1, true) then
                    local Overlay = Attach(Label, Tag)
                    for Index = 1, #Tag do
                        local Letter = Overlay:FindFirstChild('Letter' .. Index)
                        if Letter then
                            local Phase = #Tag <= 1 and 0 or (Index - 1) / (#Tag - 1)
                            if Mode == 'Animated Gradient' then
                                local Cycle = (Phase + os.clock() * Speed) % 2
                                Phase = Cycle <= 1 and Cycle or 2 - Cycle
                            end
                            Letter.TextColor3 = Mode == 'Solid' and Primary or Primary:Lerp(Secondary, Phase)
                        end
                    end
                end
            end
        end
    end)
end

function State.LocalCosmeticExtras.InstallChatTagHook()
    local Extras = State.LocalCosmeticExtras
    if Extras.ChatTagHookInstalled then return end
    Extras.ChatTagHookInstalled = true
    Extras.ChatTagHook = function(Message)
        if not Extras.IsChatTagStyleActive('Custom tag') then return nil end
        local Source = Message and Message.TextSource
        if not Source or Source.UserId ~= LP.UserId then return nil end
        local Extra = ''
        for _, Style in ipairs(State.LocalChatTagStyles or {}) do
            Extra = Extra .. Extras.BuildChatTagMarkup(Style)
        end
        if Extra == '' then return nil end
        local Properties = Instance.new('TextChatMessageProperties')
        local Name = LP:GetAttribute('DisguiseName') or LP.Name
        local NameColor = LP:GetAttribute('NameColor') or Color3.fromRGB(200, 200, 200)
        Properties.PrefixText = string.format("%s<b><font color='rgb(%d,%d,%d)'>%s:</font></b>",
            Extra, math.round(NameColor.R * 255), math.round(NameColor.G * 255),
            math.round(NameColor.B * 255), Name)
        Properties.Text = Message.Text or ''
        return Properties
    end
    Extras.ChatTagTask = State.Lifecycle:Spawn(function()
        local TextChatService = game:GetService('TextChatService')
        while Extras.ChatTagHookInstalled and Extras.IsChatTagStyleActive('Custom tag') do

            pcall(function() TextChatService.OnIncomingMessage = Extras.ChatTagHook end)
            task.wait(0.2)
        end
    end)
end

function State.LocalCosmeticExtras.RestoreChatTagHook()
    local Extras = State.LocalCosmeticExtras
    Extras.ChatTagHookInstalled = false
    if Extras.ChatTagTask then State.Lifecycle:CancelTask(Extras.ChatTagTask);
        Extras.ChatTagTask = nil end
    if Extras.ChatTagAnimationConnection then
        State.Lifecycle:DisconnectConnection(Extras.ChatTagAnimationConnection)
        Extras.ChatTagAnimationConnection = nil
    end
    Extras.ChatTagAnimationInstalled = false
    Extras.ChatTagHookWatch = false
    Extras.ChatTagHook = nil
    Extras.ChatTagHookOriginal = nil
    Extras.ChatTagFunctionTarget = nil
    Extras.ChatTagFunctionOriginal = nil
end

function State.LocalCosmeticExtras.ApplyClanTag()
    local Extras = State.LocalCosmeticExtras
    local Styles = State.LocalChatTagStyles or {}
    local Primary = Styles[#Styles]
    State.LocalChatTagStyle = Primary or 'Off'
    CONFIG.LocalChatTagStyle = State.LocalChatTagStyle
    CONFIG.LocalChatTagStyles = Extras.EncodeChatTagStyles()
    local Attribute = Extras.ResolveChatTagStyle(Primary)
    if Attribute then
        local HasCustomTag = Extras.IsChatTagStyleActive('Custom tag')
        if HasCustomTag then
            safe_set_attribute(LP, 'ClanTag', State.LocalClanTag)
            local FallbackColor = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LocalChatTagPrimaryColor, Color3.fromRGB(255, 190, 60))
            safe_set_attribute(LP, 'ClanColor', FallbackColor)

            safe_set_attribute(LP, 'ChatTag', 'Clan')
            Extras.InstallChatTagHook()
            Extras.InstallChatTagAnimation()

            Extras.ChatTagGuiWatch = false
        else
            safe_set_attribute(LP, 'ChatTag', Attribute)
            if #Styles > 1 then Extras.InstallChatTagHook() else Extras.RestoreChatTagHook() end
        end
    else
        safe_set_attribute(LP, 'ClanTag', Extras.OriginalClanTag)
        safe_set_attribute(LP, 'ClanColor', Extras.OriginalClanColor)
        safe_set_attribute(LP, 'ChatTag', Extras.OriginalChatTag)
        Extras.ChatTagGuiWatch = false
        Extras.ChatTagAnimationInstalled = false
        Extras.RestoreChatTagHook()
    end
end

function State.LocalCosmeticExtras.CommitChatTagStyles(ShouldNotify)
    local Extras = State.LocalCosmeticExtras
    local Styles = State.LocalChatTagStyles
    State.LocalClanTagSpoofEnabled = #Styles > 0
    CONFIG.LocalClanTagSpoof = State.LocalClanTagSpoofEnabled
    Extras.ApplyClanTag()
    if State.LocalClanTagSpoofEnabled and not Extras.ClanTagWatch then
        Extras.ClanTagWatch = true
        GiveSignal(LP:GetAttributeChangedSignal('ClanTag'):Connect(function()
            if Extras.ResolveChatTagStyle(State.LocalChatTagStyle) == 'Clan'
                and safe_get_attribute(LP, 'ClanTag') ~= State.LocalClanTag then
                pcall(Extras.ApplyClanTag)
            end
        end))
        GiveSignal(LP:GetAttributeChangedSignal('ChatTag'):Connect(function()
            local Expected = Extras.ResolveChatTagStyle(State.LocalChatTagStyle)
            if Expected and safe_get_attribute(LP, 'ChatTag') ~= Expected then
                pcall(Extras.ApplyClanTag)
            end
        end))
    end
    local Control = HubUI.Controls and HubUI.Controls.LocalChatTagStyle
    if Control then
        Control.Value = Extras.DescribeChatTagStyles()
        if Control.Button then
            Control.Button.Text = tostring(Control.Value) .. '      v'
        end
    end
    if ShouldNotify then
        local Message
        if #Styles == 0 then
            Message = 'Restored your real chat tag locally.'
        else
            local Labels = {}
            for _, Style in ipairs(Styles) do
                if Style == 'Custom tag' then
                    table.insert(Labels, string.format('[%s]', State.LocalClanTag))
                else
                    table.insert(Labels, string.format('[%s]', Style))
                end
            end
            Message = string.format('Showing %s locally.', table.concat(Labels, ' '))
        end
        Notify('Chat tag', Message)
    end
    if HubUI.Sync then HubUI.Sync() end
end

function State.LocalCosmeticExtras.SetChatTagStyle(Style, ShouldNotify)
    local Extras = State.LocalCosmeticExtras
    if not table.find(Extras.ChatTagStyles, Style) then Style = 'Off' end
    if Style == 'Off' then
        table.clear(State.LocalChatTagStyles)
    else
        State.LocalChatTagStyles = { Style }
    end
    Extras.CommitChatTagStyles(ShouldNotify)
end

function State.LocalCosmeticExtras.ToggleChatTagStyle(Style, ShouldNotify)
    local Extras = State.LocalCosmeticExtras
    if not table.find(Extras.ChatTagStyles, Style) then return end
    if Style == 'Off' then
        table.clear(State.LocalChatTagStyles)
    else
        local Index = table.find(State.LocalChatTagStyles, Style)
        if Index then
            table.remove(State.LocalChatTagStyles, Index)
        else
            table.insert(State.LocalChatTagStyles, Style)
        end
    end
    Extras.CommitChatTagStyles(ShouldNotify)
end

function State.LocalCosmeticExtras.SetClanTag(Enabled, Tag, ShouldNotify)
    local Extras = State.LocalCosmeticExtras
    Tag = Extras.SanitizeClanTag(Tag or State.LocalClanTag)
    State.LocalClanTag = Tag
    CONFIG.LocalClanTag = Tag
    if Enabled ~= true then
        Extras.SetChatTagStyle('Off', ShouldNotify)
        return
    end
    if not Extras.IsChatTagStyleActive('Custom tag') and #State.LocalChatTagStyles == 0 then
        Extras.ToggleChatTagStyle('Custom tag', ShouldNotify)
        return
    end
    Extras.CommitChatTagStyles(ShouldNotify)
end

