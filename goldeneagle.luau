function State.Movement.IsInMatch()
    local Now = os.clock()
    if Now - State.Movement.MatchCheckAt < 0.5 then return State.Movement.MatchCached end
    State.Movement.MatchCheckAt = Now

    local InMatch = safe_get_attribute(LP, 'Ingame') == true
        or safe_get_attribute(LP, 'InGame') == true
        or safe_get_attribute(LP, 'InMatch') == true

    if not InMatch and safe_find(Workspace, 'Court') then InMatch = true end

    if not InMatch then
        local Character = LP.Character
        local Basketball = Character and safe_find(Character, 'Basketball')
        local GameFolder = Basketball and safe_find(Basketball, '[GAME]')
        local CurrentGame = GameFolder and safe_find(GameFolder, 'CurrentGame')
        if CurrentGame and safe_is_a(CurrentGame, 'ObjectValue') and CurrentGame.Value then InMatch = true end
    end

    if not InMatch then
        local Courts = safe_find(Workspace, 'Courts')
        if Courts then
            for _, Court in ipairs(Courts:GetChildren()) do
                local CourtPlayers = safe_find(Court, '_CourtPlayers')
                local Settings = safe_find(Court, '_CourtSettings')
                local Started = Settings and safe_find(Settings, 'Started')
                local IsStarted = Started and ((safe_is_a(Started, 'BoolValue') and Started.Value == true)
                    or safe_get_attribute(Started, 'Value') == true)
                if CourtPlayers and IsStarted then
                    for _, Slot in ipairs(CourtPlayers:GetChildren()) do
                        if safe_is_a(Slot, 'ObjectValue') and Slot.Value == LP then
                            InMatch = true
                            break
                        end
                    end
                end
                if InMatch then break end
            end
        end
    end

    State.Movement.MatchCached = InMatch
    return InMatch
end

