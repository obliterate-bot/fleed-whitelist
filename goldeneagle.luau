    end
end

State.Desync = {
    Enabled = CONFIG.Desync == true,
    Status = 'off',
    Offset = Vector3.zero,
    LastUpdate = 0,
    Samples = {},
    Average = Vector3.zero,
    Threshold = 1.5,
    ClientPosition = nil,
    ClientAt = 0,
    ClientCharacter = nil,
    ClientParams = nil,
}
State.DesyncEnabled = State.Desync.Enabled

function State.Desync.GetServerPosition()
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    return Root and Root.Position or nil
end

function State.Desync.GetClientPosition()
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    return Root and Root.Position or nil
end

function State.Desync.Update()
    if not State.Desync.Enabled then return end
    local ServerPos = State.Desync.GetServerPosition()
    local ClientPos = State.Desync.GetClientPosition()
    if ServerPos and ClientPos then
        local Offset = ServerPos - ClientPos
        State.Desync.Offset = Offset
        table.insert(State.Desync.Samples, Offset)
        if #State.Desync.Samples > 10 then table.remove(State.Desync.Samples, 1) end
        local AvgX, AvgZ = 0, 0
        for _, Sample in ipairs(State.Desync.Samples) do AvgX += Sample.X;
            AvgZ += Sample.Z end
        State.Desync.Average = Vector3.new(AvgX / #State.Desync.Samples, 0, AvgZ / #State.Desync.Samples)
        State.Desync.LastUpdate = os.clock()
        State.Desync.Status = 'active'
    else
        State.Desync.Status = 'waiting'
    end
end

function State.Desync.GetClientDistance(TargetPosition)
    local ClientPos = State.Desync.GetClientPosition()
    if not ClientPos then return nil end
    local Delta = TargetPosition - ClientPos
    return Vector3.new(Delta.X, 0, Delta.Z).Magnitude
end

function State.Desync.CompensatePosition(TargetPosition)
    return TargetPosition - State.Desync.Average
end

function State.Desync.SetEnabled(Enabled)
    State.Desync.Enabled = Enabled == true
    State.DesyncEnabled = State.Desync.Enabled
    CONFIG.Desync = State.Desync.Enabled
    if not State.Desync.Enabled then
        State.Desync.Status = 'off'
        table.clear(State.Desync.Samples)
        State.Desync.Offset = Vector3.zero
        State.Desync.Average = Vector3.zero
    end
    if HubUI.Sync then HubUI.Sync() end
end

State.DesyncVisualizer = {
