local function StartLegitAimTween()
    local OriginalCamlock = CONFIG.AimMode == 'Original'
    local LegitFlick = CONFIG.AimMode == 'Legit Flick'
    if not ((LegitFlick or CONFIG.LegitTweenAim or OriginalCamlock) and State.Active and State.Enabled) then return false end
    if State.PassInProgress or (State.AutoDunk and State.AutoDunk.InProgress) then return false end
    local Character = LP.Character
    local LocalHumanoid = Character and safe_find(Character, 'Humanoid')
    if not Character or not LocalHumanoid or not Character:FindFirstChild('Basketball') then
        return false
    end

    local Target = GetLegitTweenTarget()
    if not Target then return false end
    StopLegitAimTween()
    State.LegitAimSequenceActive = true
    State.LegitAimTarget = Target
    State.LegitAimLastFrameAt = os.clock()
    State.LegitAimLastSolveAt = State.LegitAimLastFrameAt
    local StartingCamera = Workspace.CurrentCamera
    local StartingLook = StartingCamera and StartingCamera.CFrame.LookVector or Vector3.new(0, 0, -1)
    local StartingHead = Character and Character:FindFirstChild('Head')
    local StartingVector = StartingHead and (Target - StartingHead.Position) or nil
    local StartingDirection = StartingVector and StartingVector.Magnitude > 0.0001
        and StartingVector.Unit or StartingLook
    State.LegitAimSmoothedDirection = StartingLook
    State.LegitAimCorrectionDirection = StartingDirection
    State.LegitAimTurnSign = 0
    State.LegitAimLastFlickProgress = 0
    State.LegitAimAngularVelocityYaw = 0
    State.LegitAimAngularVelocityPitch = 0
    State.LegitAimNoiseYaw, State.LegitAimNoisePitch = 0, 0
    State.LegitAimNoiseTargetYaw, State.LegitAimNoiseTargetPitch = 0, 0
    State.LegitAimManualUntil = 0

    local ReactionMin = math.clamp(tonumber(CONFIG.LegitAimReactionMin) or 0.015, 0, 0.12)
    local ReactionMax = math.clamp(tonumber(CONFIG.LegitAimReactionMax) or 0.045, ReactionMin, 0.16)
    State.LegitAimReactionDelay = ReactionMin + (ReactionMax - ReactionMin) * math.random()
    State.LegitAimSwaySeed = math.random() * 1000
    local InitialDot = math.clamp(StartingLook.Unit:Dot(StartingDirection.Unit), -1, 1)
    local InitialAngle = math.deg(math.acos(InitialDot))
    State.LegitAimInitialAngle = InitialAngle
    local FlickMin = math.max(tonumber(CONFIG.LegitAimFlickMinTime) or 0.16, 0.06)
    local FlickMax = math.max(tonumber(CONFIG.LegitAimFlickMaxTime) or 0.60, FlickMin)

    local FittsBase = math.max(tonumber(CONFIG.LegitAimFlickBaseTime) or 0.11, 0.02)
    local FittsBit = math.max(tonumber(CONFIG.LegitAimFlickBitTime) or 0.078, 0)
    local FittsWidth = math.max(tonumber(CONFIG.LegitAimFlickTargetWidthDegrees) or 3, 0.5)
    local FittsBits = math.log(InitialAngle / FittsWidth + 1, 2)
    local FlickJitter = math.max(tonumber(CONFIG.LegitAimFlickTimeJitter) or 0.08, 0)
    local JitterScale = 1 + ((math.random() + math.random()) - 1) * FlickJitter
    State.LegitAimDynamicFlickTime = math.clamp(
        (FittsBase + FittsBit * FittsBits) * JitterScale, FlickMin, FlickMax)
    State.LegitAimNextCorrectionAt = State.LegitAimLastFrameAt
    local StartYaw = math.atan2(-StartingLook.X, -StartingLook.Z)
    local GoalYaw = math.atan2(-StartingDirection.X, -StartingDirection.Z)
    local StartPitch = math.asin(math.clamp(StartingLook.Y, -1, 1))
    local GoalPitch = math.asin(math.clamp(StartingDirection.Y, -1, 1))
    local InitialYawError = math.atan2(math.sin(GoalYaw - StartYaw), math.cos(GoalYaw - StartYaw))
    local InitialPitchError = GoalPitch - StartPitch

    local OvershootScale = 0
    local OvershootChance = math.clamp(tonumber(CONFIG.LegitAimOvershootChance) or 70, 0, 100)
    if InitialAngle >= math.max(tonumber(CONFIG.LegitAimOvershootMinAngle) or 22, 0) then
        if math.random() * 100 < OvershootChance then
            local MinScale = math.max(tonumber(CONFIG.LegitAimOvershootMinScale) or 0.015, 0)
            local MaxScale = math.max(tonumber(CONFIG.LegitAimOvershootMaxScale) or 0.045, MinScale)
            OvershootScale = MinScale + (MaxScale - MinScale) * math.random()
        end
    elseif InitialAngle >= 4 then
        local UndershootChance = math.clamp(tonumber(CONFIG.LegitAimUndershootChance) or 35, 0, 100)
        if math.random() * 100 < UndershootChance then
            local MinScale = math.max(tonumber(CONFIG.LegitAimUndershootMinScale) or 0.02, 0)
            local MaxScale = math.max(tonumber(CONFIG.LegitAimUndershootMaxScale) or 0.05, MinScale)
            OvershootScale = -(MinScale + (MaxScale - MinScale) * math.random())
        end
    end
    local LatencyMin = math.max(tonumber(CONFIG.LegitAimCorrectionLatencyMin) or 0.08, 0.02)
    local LatencyMax = math.max(tonumber(CONFIG.LegitAimCorrectionLatencyMax) or 0.14, LatencyMin)
    local CorrectMin = math.max(tonumber(CONFIG.LegitAimCorrectionTimeMin) or 0.16, 0.05)
    local CorrectMax = math.max(tonumber(CONFIG.LegitAimCorrectionTimeMax) or 0.24, CorrectMin)
    State.LegitAimFlickPlan = {
        StartYaw = StartYaw,
        StartPitch = StartPitch,

        YawSpan = InitialYawError,
        PitchSpan = InitialPitchError,
        Duration = State.LegitAimDynamicFlickTime,
        Clock = 0,

        SpringYaw = StartYaw,
        SpringPitch = StartPitch,
        IsLargeTurn = InitialAngle >= math.clamp(
        tonumber(CONFIG.LegitAimLargeTurnThreshold) or 150, 120, 179.9),
        OvershootScale = OvershootScale,
        CorrectionDelay = 0,
        CorrectionStart = State.LegitAimDynamicFlickTime * (0.78 + math.random() * 0.16),
        CorrectionTime = CorrectMin + (CorrectMax - CorrectMin) * math.random(),
        YawWarp = math.clamp((tonumber(CONFIG.LegitAimYawWarp) or 0.80)
        * (0.94 + math.random() * 0.12), 0.6, 1.25),
        PitchWarp = math.clamp((tonumber(CONFIG.LegitAimPitchWarp) or 0.95)
        * (0.94 + math.random() * 0.12), 0.7, 1.30),
        LateralCurveScale = (math.random() * 2 - 1)
        * (0.003 + math.random() * 0.013),
        CorrectionResidualScale = (math.random() * 2 - 1)
        * (0.002 + math.random() * 0.008),
        CorrectionStartYaw = nil,
        CorrectionStartPitch = nil,
        CorrectionTargetYaw = nil,
        CorrectionTargetPitch = nil,
    }
    State.LegitAimOvershootYaw, State.LegitAimOvershootPitch = 0, 0
    local Generation = State.LegitAimGeneration
    local StartedAt = State.LegitAimLastFrameAt
    local HoldTime = math.max(CONFIG.LegitTweenHoldTime, 0)
    local FadeTime = math.max(CONFIG.LegitTweenFadeTime, 0.01)
    local PlanTotal = math.max(State.LegitAimDynamicFlickTime,
        (tonumber(State.LegitAimFlickPlan.CorrectionStart) or 0)
        + State.LegitAimFlickPlan.CorrectionTime)
    local ReleaseAt = State.LegitAimReactionDelay + math.max(HoldTime, PlanTotal + 0.1) + FadeTime
    local LandingFadeAt = nil

    State.Lifecycle:BindToRenderStep(
        LEGIT_AIM_BIND_NAME,
        Enum.RenderPriority.Camera.Value + 1,
        WYNF_JIT(function(RenderDeltaTime)
        if not (State.Active and State.Enabled and State.LegitAimSequenceActive) then
            StopLegitAimTween()
            return
        end

        local Now = os.clock()
        local Elapsed = Now - StartedAt
        local MeasuredDelta = Now - (State.LegitAimLastFrameAt or Now)
        local DeltaTime = math.clamp(
            tonumber(RenderDeltaTime) or MeasuredDelta, 1 / 1000, 1 / 20)
        State.LegitAimLastFrameAt = Now
        local EffectiveReleaseAt = ReleaseAt
        if LandingFadeAt then
            local LandingReleaseAt = (LandingFadeAt - StartedAt) + FadeTime
            EffectiveReleaseAt = math.min(EffectiveReleaseAt, LandingReleaseAt)
        end
        if not OriginalCamlock and Elapsed >= EffectiveReleaseAt then
            StopLegitAimTween()
            return
        end

        if Now - State.LegitAimLastSolveAt >= (1 / 30) then
            State.LegitAimLastSolveAt = Now
            local UpdatedTarget = GetLegitTweenTarget()
            if UpdatedTarget then
                Target = UpdatedTarget
                State.LegitAimTarget = UpdatedTarget
            end
        end

        local CurrentCamera = Workspace.CurrentCamera
        local Head = Character:FindFirstChild('Head')
        if not CurrentCamera or not Head then return end

        local FormulaVector = Target - Head.Position
        if FormulaVector.Magnitude <= 0.0001 then return end
        local FormulaDirection = FormulaVector.Unit
        local Current = CurrentCamera.CFrame
        if OriginalCamlock then
            local Desired = CFrame.lookAt(
                Current.Position,
                Current.Position + FormulaDirection,
                Vector3.yAxis)
            CurrentCamera.CFrame = Desired
            CurrentCamera.Focus = CFrame.new(Current.Position + FormulaDirection * 1000)
            return
        end

        local ManualInput = IsManualCameraAimActive()
        if ManualInput then
            State.LegitAimManualUntil = Now
            + math.clamp(tonumber(CONFIG.LegitAimManualOwnershipTime) or 0.14, 0.02, 0.5)
        end
        local ManualOwned = Now < (tonumber(State.LegitAimManualUntil) or 0)
        local SmoothedDirection = State.LegitAimSmoothedDirection
        if typeof(SmoothedDirection) ~= 'Vector3' or SmoothedDirection.Magnitude < 0.5
            or ManualInput then
            SmoothedDirection = Current.LookVector
        else
            SmoothedDirection = SmoothedDirection.Unit
        end

        if Now >= (tonumber(State.LegitAimNextCorrectionAt) or 0) then
            State.LegitAimCorrectionDirection = FormulaDirection
            local CorrectionMin = math.max(tonumber(CONFIG.LegitAimCorrectionMin) or 0.07, 0.02)
            local CorrectionMax = math.max(tonumber(CONFIG.LegitAimCorrectionMax) or 0.13, CorrectionMin)
            State.LegitAimNextCorrectionAt = Now + CorrectionMin
            + (CorrectionMax - CorrectionMin) * ((math.random() + math.random()) * 0.5)
            local SwayAmp = math.rad(math.max(tonumber(CONFIG.LegitAimSwayDegrees) or 0.10, 0))
            State.LegitAimNoiseTargetYaw = (math.random() * 2 - 1) * SwayAmp
            State.LegitAimNoiseTargetPitch = (math.random() * 2 - 1) * SwayAmp * 0.65
        end
        local DecisionDirection = State.LegitAimCorrectionDirection or FormulaDirection
        local NoiseResponse = math.max(tonumber(CONFIG.LegitAimSwaySpeed) or 4.5, 0.1)
        local NoiseAlpha = 1 - math.exp(-NoiseResponse * DeltaTime)
        State.LegitAimNoiseYaw += ((tonumber(State.LegitAimNoiseTargetYaw) or 0)
            - (tonumber(State.LegitAimNoiseYaw) or 0)) * NoiseAlpha
        State.LegitAimNoisePitch += ((tonumber(State.LegitAimNoiseTargetPitch) or 0)
            - (tonumber(State.LegitAimNoisePitch) or 0)) * NoiseAlpha

        local Plan = State.LegitAimFlickPlan
        if ManualInput and Plan then
            State.LegitAimFlickPlan = false
            Plan = false
        end
        local MotionElapsed = math.max(0, Elapsed - State.LegitAimReactionDelay)
        if Plan then

            local PlaybackStep = Elapsed >= State.LegitAimReactionDelay and DeltaTime or 0
            Plan.Clock = math.max(0, tonumber(Plan.Clock) or 0) + PlaybackStep
            MotionElapsed = Plan.Clock
        end
        local Fade = 1
        local FadeStart = EffectiveReleaseAt - FadeTime
        if Elapsed > FadeStart then
            local FadeAlpha = math.clamp((Elapsed - FadeStart) / FadeTime, 0, 1)
            Fade = 1 - State.LegitAimMinimumJerk(FadeAlpha)
        end

        local CurrentYaw = math.atan2(-SmoothedDirection.X, -SmoothedDirection.Z)
        local CurrentPitch = math.asin(math.clamp(SmoothedDirection.Y, -1, 1))
        local NewYaw, NewPitch
        if Plan then

            local YawSpan = tonumber(Plan.YawSpan) or 0
            local PitchSpan = tonumber(Plan.PitchSpan) or 0
            local Duration = math.max(tonumber(Plan.Duration) or 0.28, 0.10)
            local BallisticScale = 1 + (tonumber(Plan.OvershootScale) or 0)
            local CorrectionStart = math.clamp(
                tonumber(Plan.CorrectionStart) or Duration * 0.86, Duration * 0.65, Duration)
            local CorrectionTime = math.max(tonumber(Plan.CorrectionTime) or 0.20, 0.08)
            local PrimaryP = math.clamp(MotionElapsed / Duration, 0, 1)
            local CorrectionP = math.clamp(
                (MotionElapsed - CorrectionStart) / CorrectionTime, 0, 1)
            local PrimaryYaw = State.LegitAimMinimumJerk(PrimaryP ^ Plan.YawWarp)
            local PrimaryPitch = State.LegitAimMinimumJerk(PrimaryP ^ Plan.PitchWarp)
            local CorrectionProgress = State.LegitAimMinimumJerk(CorrectionP)
            local FinalScale = 1 + (tonumber(Plan.CorrectionResidualScale) or 0)
            local CorrectionAmount = FinalScale - BallisticScale
            local YawProgress = BallisticScale * PrimaryYaw
            + CorrectionAmount * CorrectionProgress
            local PitchProgress = BallisticScale * PrimaryPitch
            + CorrectionAmount * CorrectionProgress
            local ArcWindow = math.sin(math.pi * PrimaryP)
            local Lateral = (tonumber(Plan.LateralCurveScale) or 0)
            * ArcWindow * ArcWindow * (1 - CorrectionProgress * 0.85)
            NewYaw = Plan.StartYaw + YawSpan * YawProgress - PitchSpan * Lateral
            NewPitch = Plan.StartPitch + PitchSpan * PitchProgress + YawSpan * Lateral
            local Done = PrimaryP >= 1 and CorrectionP >= 1
            State.LegitAimLastFlickProgress = Done and 1 or PrimaryP
            local NoiseScale = PrimaryP < 1 and 0.08 or 0.30
            NewYaw += (tonumber(State.LegitAimNoiseYaw) or 0) * NoiseScale
            NewPitch += (tonumber(State.LegitAimNoisePitch) or 0) * NoiseScale

            local MaxFlickSpeed = math.rad(math.max(
                tonumber(CONFIG.LegitAimFlickMaxDegreesPerSecond) or 600, 90))
            local SmoothTime = math.clamp(
                tonumber(CONFIG.LegitAimCameraSmoothTime) or 0.055, 0.015, 0.18)
            local PitchSmoothScale = math.clamp(
                tonumber(CONFIG.LegitAimCameraPitchSmoothScale) or 1.10, 0.75, 1.6)
            if Plan.IsLargeTurn then
                MaxFlickSpeed *= math.clamp(
                    tonumber(CONFIG.LegitAimLargeTurnSpeedBoost) or 1.25, 1, 1.6)
                SmoothTime *= 0.92
            end
            local YawVelocity = tonumber(State.LegitAimAngularVelocityYaw) or 0
            local PitchVelocity = tonumber(State.LegitAimAngularVelocityPitch) or 0
            local SpringYaw = tonumber(Plan.SpringYaw) or CurrentYaw
            local SpringPitch = tonumber(Plan.SpringPitch) or CurrentPitch
            NewYaw, YawVelocity = State.LegitAimSmoothDampAngle(
                SpringYaw, NewYaw, YawVelocity, SmoothTime, MaxFlickSpeed, DeltaTime, true)
            NewPitch, PitchVelocity = State.LegitAimSmoothDampAngle(
                SpringPitch, NewPitch, PitchVelocity, SmoothTime * PitchSmoothScale,
                MaxFlickSpeed * 0.82, DeltaTime, true)
            Plan.SpringYaw = NewYaw
            Plan.SpringPitch = NewPitch
            State.LegitAimAngularVelocityYaw = YawVelocity
            State.LegitAimAngularVelocityPitch = PitchVelocity
            if Done then

                State.LegitAimFlickPlan = false
            end
        else
            local TargetYaw = math.atan2(-DecisionDirection.X, -DecisionDirection.Z)
            + (tonumber(State.LegitAimNoiseYaw) or 0)
            local YawError = math.atan2(math.sin(TargetYaw - CurrentYaw), math.cos(TargetYaw - CurrentYaw))
            if math.abs(YawError) > math.rad(150) then
                if State.LegitAimTurnSign == 0 then State.LegitAimTurnSign = YawError >= 0 and 1 or -1 end
                YawError = math.abs(YawError) * State.LegitAimTurnSign
            elseif math.abs(YawError) < math.rad(90) then
                State.LegitAimTurnSign = 0
            elseif State.LegitAimTurnSign ~= 0 then
                YawError = math.abs(YawError) * State.LegitAimTurnSign
            end
            local TargetPitch = math.asin(math.clamp(DecisionDirection.Y, -1, 1))
            + (tonumber(State.LegitAimNoisePitch) or 0)
            local PitchError = TargetPitch - CurrentPitch
            local ErrorAngle = math.sqrt(YawError * YawError + PitchError * PitchError)
            local Deadzone = math.rad(math.max(tonumber(CONFIG.LegitAimDeadzoneDegrees) or 0.12, 0))
            if ErrorAngle <= Deadzone then
                YawError, PitchError = 0, 0
                ErrorAngle = 0
            end

            local ManualScale = ManualOwned
                and math.clamp(tonumber(CONFIG.LegitAimManualInputScale) or 0.42, 0, 1) or 1
            local Weight = ManualScale 
            local MaxDegrees = math.max(tonumber(CONFIG.LegitAimMaxDegreesPerSecond) or 340, 1)
            local MaxYawSpeed = math.rad(MaxDegrees) * Weight
            local PitchScale = math.clamp(tonumber(CONFIG.LegitAimPitchSpeedScale) or 0.78, 0.25, 1)
            local MaxPitchSpeed = MaxYawSpeed * PitchScale
            local Response = math.max(tonumber(CONFIG.LegitAimResponse) or 9.5, 0.1)
            local DesiredYawVelocity = math.clamp(YawError * Response, -MaxYawSpeed, MaxYawSpeed)
            local DesiredPitchVelocity = math.clamp(PitchError * Response, -MaxPitchSpeed, MaxPitchSpeed)
            local Acceleration = math.rad(math.max(
                tonumber(CONFIG.LegitAimAccelerationDegreesPerSecond) or 980, 1)) * Weight
            local YawVelocity = tonumber(State.LegitAimAngularVelocityYaw) or 0
            local PitchVelocity = tonumber(State.LegitAimAngularVelocityPitch) or 0
            YawVelocity += math.clamp(DesiredYawVelocity - YawVelocity,
                -Acceleration * DeltaTime, Acceleration * DeltaTime)
            PitchVelocity += math.clamp(DesiredPitchVelocity - PitchVelocity,
                -Acceleration * PitchScale * DeltaTime, Acceleration * PitchScale * DeltaTime)
            local YawStep = YawError == 0 and 0 or YawVelocity * DeltaTime
            local PitchStep = PitchError == 0 and 0 or PitchVelocity * DeltaTime
            if YawError ~= 0 and (math.abs(YawStep) > math.abs(YawError)
                or YawStep * YawError < 0) then YawStep, YawVelocity = YawError, 0 end
            if PitchError ~= 0 and (math.abs(PitchStep) > math.abs(PitchError)
                or PitchStep * PitchError < 0) then PitchStep, PitchVelocity = PitchError, 0 end
            if YawError == 0 then
                YawVelocity += math.clamp(-YawVelocity, -Acceleration * DeltaTime, Acceleration * DeltaTime)
            end
            if PitchError == 0 then
                PitchVelocity += math.clamp(-PitchVelocity,
                    -Acceleration * PitchScale * DeltaTime, Acceleration * PitchScale * DeltaTime)
            end
            State.LegitAimAngularVelocityYaw = YawVelocity
            State.LegitAimAngularVelocityPitch = PitchVelocity
            NewYaw = CurrentYaw + YawStep
            NewPitch = CurrentPitch + PitchStep
        end
        NewPitch = math.clamp(NewPitch, -math.pi * 0.495, math.pi * 0.495)
        local CosPitch = math.cos(NewPitch)
        local AimedDirection = Vector3.new(
            -math.sin(NewYaw) * CosPitch,
            math.sin(NewPitch),
            -math.cos(NewYaw) * CosPitch).Unit
        State.LegitAimSmoothedDirection = AimedDirection

        local OutputDirection = AimedDirection
        if Fade < 1 then
            local NativeDirection = Current.LookVector
            OutputDirection = State.LegitAimSlerpDirection(AimedDirection, NativeDirection, 1 - Fade)
        end
        local Aimed = CFrame.lookAt(
            Current.Position,
            Current.Position + OutputDirection,
            Vector3.yAxis)
        CurrentCamera.CFrame = Aimed
        CurrentCamera.Focus = CFrame.new(Aimed.Position + OutputDirection * 1000)
    end)
    )

    LegitAimLandConnection = State.Lifecycle:Connect(LocalHumanoid:GetPropertyChangedSignal('FloorMaterial'), function()
        if LocalHumanoid.FloorMaterial ~= Enum.Material.Air and not LandingFadeAt then

            LandingFadeAt = os.clock()
        end
    end)
    if not OriginalCamlock then
        State.LegitAimStopTask = State.Lifecycle:Delay(ReleaseAt, function()
            if Generation == State.LegitAimGeneration then StopLegitAimTween() end
        end)
    end
    return true
end

local LegitAimLastJumpInputAt = -math.huge
local function StartLegitAimFromJumpInput()
    local Now = os.clock()
    if Now - LegitAimLastJumpInputAt < 0.075 then return end
    if not (State.Active and State.Enabled) then return end
    if State.NoJump and State.NoJump.Active then return end
    LegitAimLastJumpInputAt = Now
    local Ok, Started = pcall(StartLegitAimTween)
    if not (Ok and Started) then LegitAimLastJumpInputAt = -math.huge end
end
GiveSignal(UserInputService.InputBegan:Connect(function(Input, GameProcessed)

    if Input.KeyCode == Enum.KeyCode.Space then
        StartLegitAimFromJumpInput()
    end
end))
GiveSignal(UserInputService.JumpRequest:Connect(StartLegitAimFromJumpInput))

local function UpdateSilentAimController()
    if not (State.Active and State.Enabled) then
        if AimbotConn then
            State.Lifecycle:DisconnectConnection(AimbotConn)
            AimbotConn = nil
        end
        SilentAim.ClearActorAim()
        return
    end

    if AimbotConn ~= nil then
        return
    end

    if not Humanoid then InitCharacter() end
    if not Humanoid then return end
    AimbotConn = State.Lifecycle:Connect(Humanoid:GetPropertyChangedSignal('Jump'), function()
        if Humanoid.Jump then
            if State.NoJump.Active then return end
            SilentAim.ReleasePredictionDeadline = 0
            State.ShotModeRandomSeed = (tonumber(State.ShotModeRandomSeed) or 0) + 1
            if CONFIG.HumanizeEnabled then State.Humanize.NewShot() end

            if os.clock() - LegitAimLastJumpInputAt > 0.12 then
                pcall(StartLegitAimTween)
            end
            if State.PassInProgress then
                SilentAim.ClearActorAim()
                return
            end
            local Basketball = safe_find(Char, 'Basketball')
            if Basketball or not CONFIG.AimRequireBall then
                if CONFIG.SmartShotSelector then pcall(State.SmartShot.Select, HumanoidRootPart) end
                if State.Stepback.HandleJumpAttempt(Humanoid, Char, HumanoidRootPart) then
                    SilentAim.ReleasePredictionDeadline = 0
                    SilentAim.ClearActorAim()
                    return
                end
                if State.Trickshot.HandleAutoEBLJump(Humanoid) then
                    SilentAim.ReleasePredictionDeadline = 0
                    SilentAim.ClearActorAim()
                    return
                end
                local StepbackUsed = State.Stepback.ChainedShot == true
                local TurnaroundUsed = false
                if not StepbackUsed and CONFIG.AutoTurnaroundShot then
                    local Ok, Started = pcall(State.TurnaroundShot.Start, Char, HumanoidRootPart)
                    TurnaroundUsed = Ok and Started == true
                end
                if not TurnaroundUsed and (CONFIG.AutoFadeaway or CONFIG.AutoStop)
                    and (not StepbackUsed or CONFIG.StepbackAllowFadeaway) then
                    pcall(State.Trickshot.StartShotMovement, Char, HumanoidRootPart)
                end
                if not TurnaroundUsed and CONFIG.TrickshotEnabled
                    and (not StepbackUsed or CONFIG.StepbackAllowTrickshot) then
                    pcall(State.Trickshot.StartSpin, Char, HumanoidRootPart)
                end
                local groundRim, groundDist = FindConfiguredGoal()
                if groundRim then
                    SilentAim.groundDist = groundDist
                    SilentAim.groundY = HumanoidRootPart.Position.Y
                    SilentAim.rimName = groundRim.Name
                end

                SilentAim.HookNewActors()
                local JumpArmTarget
                local ArmRim, ArmDist = FindConfiguredGoal()
                local ArmPower = State.PowerBypass.GetEffectivePower()
                if ArmRim then
                    local PredictedArmDistance = GetPredictedReleaseDistance(ArmRim)
                    if PredictedArmDistance == math.huge then PredictedArmDistance = ArmDist end
                    JumpArmTarget = select(1, BuildSilentAimTarget(
                        ArmRim, PredictedArmDistance, ArmPower
                    ))
                    if JumpArmTarget then
                        SilentAim.FireActorAim(JumpArmTarget)
                    end
                end

                local IsRising = false
                local StartedAt = os.clock()
                local TakeoffAt
                local ReleaseClientDelay, _ReleasePing, ReleaseOffset =
                GetPerfectReleaseClientDelay()
                local CheckPeakJump
                local PeakHandled = false

                local function AttemptPeakShot()
                    if PeakHandled then return end
                    PeakHandled = true
                    if CheckPeakJump then State.Lifecycle:DisconnectConnection(CheckPeakJump);
                        CheckPeakJump = nil end
                    if State.TurnaroundShot and State.TurnaroundShot.Active then
                        State.TurnaroundShot.WaitForStyle()
                    elseif CONFIG.TrickshotEnabled or CONFIG.AutoFadeaway then
                        State.Trickshot.WaitForStyle()
                    end

                    local PeakShotAttempted = false
                    local Rim, Dist = FindConfiguredGoal()
                    local DesiredPower = State.PowerBypass.GetEffectivePower()
                    if Rim then
                        local ShotTarget, ShotY = BuildSilentAimTarget(
                            Rim, Dist, DesiredPower, nil, true
                        )
                        if ShotTarget then
                            SilentAim.FireActorAim(ShotTarget)
                            PeakShotAttempted = SilentShoot(
                                Rim, ShotY or 0, ShotTarget, ShotTarget
                            ) == true
                        end
                    end
                    if JumpArmTarget and not PeakShotAttempted then
                        SilentAim.ClearActorAim()
                    end
                    SilentAim.ReleasePredictionDeadline = 0
                end

                CheckPeakJump = State.Lifecycle:Connect(RunService.Heartbeat, WYNF_JIT(function(DeltaTime)
                    if State.PassInProgress or (State.AutoDunk and State.AutoDunk.InProgress)
                        or not (State.Active and State.Enabled) or not HumanoidRootPart then
                        if JumpArmTarget then SilentAim.ClearActorAim() end
                        SilentAim.ReleasePredictionDeadline = 0
                        State.Lifecycle:DisconnectConnection(CheckPeakJump);
                        CheckPeakJump = nil
                        return
                    end
                    local VelY = HumanoidRootPart.AssemblyLinearVelocity.Y
                    if VelY > 0 and not TakeoffAt then
                        TakeoffAt = os.clock()
                        IsRising = true
                        if CONFIG.PerfectRelease then
                            SilentAim.ReleasePredictionDeadline =
                            TakeoffAt + ReleaseClientDelay
                        elseif Workspace.Gravity > 0 then
                            local TargetVelocity = GetAimReleaseVelocity()
                            SilentAim.ReleasePredictionDeadline = TakeoffAt
                            + math.max(0, (VelY - TargetVelocity) / Workspace.Gravity)
                        end
                    end

                    local LiveRim, LiveDistance = FindConfiguredGoal()
                    local LivePower = State.PowerBypass.GetEffectivePower()
                    if LiveRim then
                        local PredictedDistance = GetPredictedReleaseDistance(LiveRim)
                        if PredictedDistance == math.huge then PredictedDistance = LiveDistance end
                        JumpArmTarget = select(1, BuildSilentAimTarget(
                            LiveRim, PredictedDistance, LivePower
                        ))
                    end
                    if JumpArmTarget and SilentAim.ActorAimReady == true then
                        SilentAim.FireActorAim(JumpArmTarget)
                    end

                    if CONFIG.ClickToShoot and not State.Trickshot.ForceAutoRelease then
                        State.ClickShoot.Armed = true
                        State.ClickShoot.Target = JumpArmTarget
                        State.ClickShoot.Status = 'ARMED - LEFT CLICK TO RELEASE'
                        SilentAim.ReleasePredictionDeadline = 0
                        local Grounded = Humanoid and Humanoid.FloorMaterial ~= Enum.Material.Air
                        if (TakeoffAt and Grounded and os.clock() - TakeoffAt > 0.25)
                            or os.clock() - StartedAt > 5 then
                            State.ClickShoot.Armed = false
                            State.ClickShoot.Target = nil
                            State.ClickShoot.Status = 'IDLE'
                            if JumpArmTarget then SilentAim.ClearActorAim() end
                            State.Lifecycle:DisconnectConnection(CheckPeakJump);
                            CheckPeakJump = nil
                        end
                        return
                    end

                    local ShouldRelease = false
                    local StepTime = math.clamp(
                        DeltaTime or (1 / 60), 1 / 240, 1 / 15)
                    if CONFIG.PerfectRelease and TakeoffAt then
                        local ReleaseAt = TakeoffAt + ReleaseClientDelay
                        if os.clock() + StepTime >= ReleaseAt then
                            State.PerfectRelease.SpinUntil(ReleaseAt)
                            ShouldRelease = true
                        end
                    elseif IsRising then
                        local TargetVelocity = GetAimReleaseVelocity()
                        local NextVelY = VelY - Workspace.Gravity * StepTime
                        ShouldRelease = (VelY >= TargetVelocity and NextVelY <= TargetVelocity)
                            or VelY < TargetVelocity
                    end

                    if ShouldRelease then
                        if CONFIG.PerfectRelease and TakeoffAt then
                            State.PerfectRelease.RecordAttempt(
                                ReleaseClientDelay, ReleaseOffset)
                        end
                        AttemptPeakShot()
                        return
                    end
                    if not IsRising and os.clock() - StartedAt > 0.5 then
                        if JumpArmTarget then SilentAim.ClearActorAim() end
                        SilentAim.ReleasePredictionDeadline = 0
                        State.Lifecycle:DisconnectConnection(CheckPeakJump);
                        CheckPeakJump = nil
                    end
                end))
            end
        end
    end)
end

