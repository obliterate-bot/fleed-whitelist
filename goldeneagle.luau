GiveSignal(RunService.RenderStepped:Connect(WYNF_JIT(function(DeltaTime)
    if not State.Watch.Active then return end
    local WatchOk, WatchError = pcall(State.Watch.Update, DeltaTime)
    if not WatchOk and State.Watch.Active then
        State.Watch.SetActive(false)
        warn('[GOLDEN EAGLE] Watch camera stopped: ' .. tostring(WatchError))
    end
end)))

GiveSignal(RunService.RenderStepped:Connect(WYNF_JIT(function()
    if CONFIG.PassRangeIndicator ~= true then return end
    local Now = os.clock()
    if Now - PerfCache.PassRangeAt >= 0.15 then
        PerfCache.PassRangeAt = Now
        local PassRangeOk, PassRangeError = pcall(State.PassRange.Update)
        if not PassRangeOk and not State.PassRange.Disabled then
            State.PassRange.Disabled = true
            State.PassRange.Destroy()
            warn('[GOLDEN EAGLE] Pass range indicator disabled: ' .. tostring(PassRangeError))
        end
    end
    if not State.PassRange.Disabled then pcall(State.PassRange.Render) end
end)))

GiveSignal(RunService.RenderStepped:Connect(WYNF_JIT(function()
    if not (CONFIG.RangeIndicatorEnabled or CONFIG.TrajectoryPreviewEnabled
        or CONFIG.ArcPreviewEnabled or CONFIG.RangeScreenTintEnabled
        or CONFIG.DunkRangeIndicator) then return end
    if Visuals.Disabled then

        if os.clock() < (Visuals.RetryAt or 0) then return end
        Visuals.Disabled = false
    end
    local Ok, ErrorText = pcall(RenderVisuals)
    if Ok then
        if Visuals.FailStreak and Visuals.FailStreak ~= 0 then Visuals.FailStreak = 0 end
    elseif not Visuals.Disabled then
        Visuals.FailStreak = (Visuals.FailStreak or 0) + 1
        DestroyVisuals()
        Visuals.Disabled = true
        Visuals.RetryAt = os.clock() + math.min(10, Visuals.FailStreak * 2)
        warn('[GOLDEN EAGLE] Visual overlay error (retrying in '
            .. tostring(math.min(10, Visuals.FailStreak * 2)) .. 's): ' .. tostring(ErrorText))
    end
end)))

GiveSignal(LP.CharacterAdded:Connect(function(Character)
    if not State.Active then return end
    BindLocalBallColliderSafety(Character)
    if State.GhostReplay and State.GhostReplay.Recording then State.GhostReplay.StopRecording('RESPAWNED') end
    State.BallAssist.ColliderLastLocalPossession = nil
    State.BallAssist.ColliderLastScanAt = 0
    State.BallAssist.ColliderGraceUntil = os.clock()
    + math.clamp(tonumber(State.BallAssist.ColliderPossessionGrace) or 0.8, 0.2, 2)
    if AimbotConn then
        State.Lifecycle:DisconnectConnection(AimbotConn)
        AimbotConn = nil
    end
    Visuals.GroundY = nil
    State.Lifecycle:Defer(function() if State.MobilePass then State.MobilePass.Refresh() end end)
    StopLegitAimTween()
    InitCharacter()
    if State.Extras.AvatarPreviewEnabled and State.Extras.AvatarPreviewUserId then
        State.Lifecycle:Defer(State.Extras.ApplyAvatarPreview, State.Extras.AvatarPreviewUserId)
    end
    State.Movement.RefreshAll()
    State.Utility.SafeCFrame = nil
    State.Utility.FallDangerSince = nil
    State.LocalSpoofs.BindIntroBanners(LP.Character)
    BindSelfPassJumpDetector()
    UpdateSilentAimController()
    if State.AutoDunkEnabled then State.AutoDunk.UpdateBinding() end
    if State.AutoOffense.Enabled then State.AutoOffense.UpdateBinding() end
    if State.AutoGetOpenEnabled then UpdateAutoGetOpenBinding() end
    if State.AutoHeadRide then
        State.AutoHeadRide.Reset(
            State.AutoHeadRide.Enabled and (State.AutoGuardEnabled
            and 'WAITING FOR OFF-BALL' or 'AUTO GUARD OFF') or 'OFF')
    end
    if State.AutoBody.Enabled then
        State.AutoBody.Target = nil
        State.AutoBody.LastTargetScan = 0
        State.AutoBody.CurrentHand = nil
        State.AutoBody.HandStatus = CONFIG.AutoBodyAutoHands and 'WAITING' or 'MANUAL'
        State.AutoBody.ResetRuntime()
        State.AutoBody.ReleaseRotation()
    end
end))

