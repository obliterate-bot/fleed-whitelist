function State.Movement.SetFakeLagNetworkChoke(Enabled, RestoreOriginal)
    local Backend = State.Movement.FakeLagBackend
    if Backend == 'NETWORK SLEEP' then
        local Setter = State.Movement.FakeLagSetHidden
        local Root = State.Movement.FakeLagSleepRoot
        if type(Setter) ~= 'function' or not (Root and Root.Parent) then return false end
        if Enabled and State.Movement.FakeLagSleeping then return true end
        local Desired = Enabled and true
            or (RestoreOriginal and State.Movement.FakeLagSleepOriginal == true or false)
        local Success = pcall(Setter, Root, 'NetworkIsSleeping', Desired)
        if not Success then
            if Enabled then
                State.Movement.FakeLagSleeping = false
                State.Movement.FakeLagBackend = 'LOCAL CHOKE'
            end
            return false
        end
        State.Movement.FakeLagSleeping = Enabled == true
        return true
    end
    if Backend == 'PHYSICS SENDER' then
        local Setter = State.Movement.FakeLagSetFlag
        local Name = State.Movement.FakeLagFlagName
        if type(Setter) ~= 'function' or not Name then return false end
        if Enabled and State.Movement.FakeLagFlagApplied then return true end
        local Value = Enabled and '1' or tostring(State.Movement.FakeLagFlagOriginal or '15')
        local Success = pcall(Setter, Name, Value)
        if not Success then
            if Enabled then
                State.Movement.FakeLagFlagApplied = false
                State.Movement.FakeLagBackend = 'LOCAL CHOKE'
            end
            return false
        end
        State.Movement.FakeLagFlagApplied = Enabled == true
        return true
    end
    return Backend == 'LOCAL CHOKE'
end

function State.Movement.RestoreFakeLagNetwork(ClearBackend)
    local Backend = State.Movement.FakeLagBackend
    local Restored = State.Movement.SetFakeLagNetworkChoke(false, true)
    if not Restored and Backend == 'NETWORK SLEEP' then
        local Setter = State.Movement.FakeLagSetHidden
        local Root = State.Movement.FakeLagSleepRoot
        if type(Setter) == 'function' and Root then
            for _ = 1, 3 do
                if pcall(Setter, Root, 'NetworkIsSleeping', State.Movement.FakeLagSleepOriginal == true) then break end
            end
        end
    elseif not Restored and Backend == 'PHYSICS SENDER' then
        local Setter = State.Movement.FakeLagSetFlag
        local Name = State.Movement.FakeLagFlagName
        if type(Setter) == 'function' and Name then
            for _ = 1, 3 do
                if pcall(Setter, Name, tostring(State.Movement.FakeLagFlagOriginal or '15')) then break end
            end
        end
    end
    State.Movement.FakeLagSleeping = false
    State.Movement.FakeLagFlagApplied = false
    State.Movement.FakeLagSleepRoot = nil
    State.Movement.FakeLagSleepOriginal = false
    if ClearBackend then
        State.Movement.FakeLagBackend = 'UNRESOLVED'
        State.Movement.FakeLagSetHidden = nil
        State.Movement.FakeLagGetHidden = nil
        State.Movement.FakeLagSetFlag = nil
        State.Movement.FakeLagGetFlag = nil
        State.Movement.FakeLagFlagName = nil
        State.Movement.FakeLagFlagOriginal = nil
        State.Movement.FakeLagBackendNotified = nil
    end
end

function State.Movement.ResetFakeLag(Status, ClearBackend)
    State.Movement.RestoreFakeLagNetwork(ClearBackend == true)
    State.Movement.FakeLagBuffer = 0
    State.Movement.FakeLagNextPulseAt = 0
    State.Movement.FakeLagLastPosition = nil
    State.Movement.FakeLagBlockedUntil = 0
    State.Movement.FakeLagPhase = 'IDLE'
    State.Movement.FakeLagPhaseUntil = 0
    State.Movement.FakeLagHoldPosition = nil
    State.Movement.FakeLagHoldDirection = nil
    State.Movement.FakeLagStatus = Status
        or (State.Movement.FakeLagMode == 'Off' and 'OFF' or 'READY')
end

function State.Movement.SetFakeLagMode(Name)
    Name = tostring(Name or 'Off')
    if Name ~= 'Off' and not State.Movement.FakeLagProfiles[Name] then Name = 'Off' end
    State.Movement.ResetFakeLag(Name == 'Off' and 'OFF' or (string.upper(Name) .. ' READY'), true)
    State.Movement.FakeLagMode = Name
    CONFIG.FakeLagMode = Name
end

function State.Movement.ResolveFakeLagBackend(Root)
    local Backend = State.Movement.FakeLagBackend
    if Backend == 'NETWORK SLEEP' and type(State.Movement.FakeLagSetHidden) == 'function' then
        if State.Movement.FakeLagSleepRoot ~= Root then
            State.Movement.SetFakeLagNetworkChoke(false, true)
            State.Movement.FakeLagSleepRoot = Root
            State.Movement.FakeLagSleepOriginal = false
            local Getter = State.Movement.FakeLagGetHidden
            if type(Getter) == 'function' then
                local ReadOk, Original = pcall(Getter, Root, 'NetworkIsSleeping')
                if ReadOk then State.Movement.FakeLagSleepOriginal = Original == true end
            end
        end
        return Backend
    end
    if Backend == 'PHYSICS SENDER'
        and type(State.Movement.FakeLagSetFlag) == 'function'
        and State.Movement.FakeLagFlagName then return Backend end
    if Backend == 'LOCAL CHOKE' then return Backend end

    local SetHidden = rawget(GlobalEnv, 'sethiddenproperty')
        or rawget(GlobalEnv, 'sethiddenprop')
    local GetHidden = rawget(GlobalEnv, 'gethiddenproperty')
        or rawget(GlobalEnv, 'gethiddenprop')
    if type(SetHidden) == 'function' then
        local OriginalSleeping = false
        if type(GetHidden) == 'function' then
            local ReadOk, Original = pcall(GetHidden, Root, 'NetworkIsSleeping')
            if ReadOk then OriginalSleeping = Original == true end
        end
        local TestOk = pcall(SetHidden, Root, 'NetworkIsSleeping', false)
        if TestOk then
            State.Movement.FakeLagBackend = 'NETWORK SLEEP'
            State.Movement.FakeLagSetHidden = SetHidden
            State.Movement.FakeLagGetHidden = type(GetHidden) == 'function' and GetHidden or nil
            State.Movement.FakeLagSleepRoot = Root
            State.Movement.FakeLagSleepOriginal = OriginalSleeping
            return State.Movement.FakeLagBackend
        end
    end

    local SetFlag = rawget(GlobalEnv, 'setfflag')
    local GetFlag = rawget(GlobalEnv, 'getfflag')
    if type(SetFlag) == 'function' and type(GetFlag) == 'function' then
        for _, Name in ipairs({ 'S2PhysicsSenderRate', 'DFIntS2PhysicsSenderRate' }) do
            local ReadOk, Original = pcall(GetFlag, Name)
            if ReadOk and Original ~= nil then
                local TestOk = pcall(SetFlag, Name, tostring(Original))
                if TestOk then
                    State.Movement.FakeLagBackend = 'PHYSICS SENDER'
                    State.Movement.FakeLagSetFlag = SetFlag
                    State.Movement.FakeLagGetFlag = GetFlag
                    State.Movement.FakeLagFlagName = Name
                    State.Movement.FakeLagFlagOriginal = tostring(Original)
                    return State.Movement.FakeLagBackend
                end
            end
        end
    end

    State.Movement.FakeLagBackend = 'LOCAL CHOKE'
    return State.Movement.FakeLagBackend
end

function State.Movement.NotifyFakeLagBackend()
    local Backend = State.Movement.FakeLagBackend
    if State.Movement.FakeLagBackendNotified == Backend then return end
    State.Movement.FakeLagBackendNotified = Backend
    local Toast = rawget(GlobalEnv, '__GEH_TOAST')
    if type(Toast) ~= 'function' then return end
    local Message
    if Backend == 'NETWORK SLEEP' then
        Message = 'Outgoing physics choke: NetworkIsSleeping'
    elseif Backend == 'PHYSICS SENDER' then
        Message = 'Outgoing physics choke: S2PhysicsSenderRate'
    else
        Message = 'Executor lacks network controls; using visible pause/jump fallback'
    end
    pcall(Toast, 'FAKE LAG', Message)
end

function State.Movement.ReleaseFakeLagPulse(Character, Root, Direction, RequestedDistance)
    local ReleaseDistance = math.max(tonumber(RequestedDistance) or 0, 0)
    if ReleaseDistance < 0.025 then return 0, 'EMPTY' end
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = { Character }
    pcall(function() Params.RespectCanCollide = true end)
    local WallResult = Workspace:Raycast(
        Root.Position + Vector3.new(0, 0.25, 0),
        Direction * (ReleaseDistance + 0.55), Params)
    if WallResult then
        ReleaseDistance = math.min(ReleaseDistance, math.max(WallResult.Distance - 0.55, 0))
    end
    if ReleaseDistance < 0.025 then return 0, 'BLOCKED' end
    local Destination = Root.Position + Direction * ReleaseDistance
    local FloorResult = Workspace:Raycast(
        Destination + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), Params)
    if not FloorResult then return 0, 'EDGE HOLD' end
    local Success = pcall(function()
        Root.CFrame = Root.CFrame + Direction * ReleaseDistance
    end)
    return Success and ReleaseDistance or 0, Success and 'RELEASED' or 'FAILED'
end

function State.Movement.ApplyFakeLag(DeltaTime)
    local Mode = State.Movement.FakeLagMode or 'Off'
    local Profile = State.Movement.FakeLagProfiles[Mode]
    if not Profile then
        if State.Movement.FakeLagPhase ~= 'IDLE' then State.Movement.ResetFakeLag('OFF', true) end
        return
    end
    local Now = os.clock()
    if Now < (State.Movement.FakeLagBlockedUntil or 0) then return end
    if State.Movement.FlightEnabled or State.Movement.AirWalkEnabled or CONFIG.IcePhysics
        or (State.Stepback and State.Stepback.Active)
        or (State.Runtime and State.Runtime.MovementOwner
        and Now < (State.Runtime.MovementLeaseUntil or 0)) then
        if State.Movement.FakeLagPhase ~= 'IDLE' then State.Movement.ResetFakeLag('PAUSED', false) end
        return
    end
    local Character, HumanoidObject, Root = State.Movement.GetRig()
    if not (Character and HumanoidObject and Root) or HumanoidObject.Health <= 0
        or Root.Anchored or HumanoidObject.Sit
        or HumanoidObject.FloorMaterial == Enum.Material.Air then
        if State.Movement.FakeLagPhase ~= 'IDLE' then
            State.Movement.ResetFakeLag('WAITING FOR GROUND', false)
        end
        return
    end
    local Position = Root.Position
    local LastPosition = State.Movement.FakeLagLastPosition
    if LastPosition and (Position - LastPosition).Magnitude > 8 then
        State.Movement.ResetFakeLag('TELEPORT RESET', false)
        State.Movement.FakeLagLastPosition = Position
        State.Movement.FakeLagBlockedUntil = Now + 0.20
        return
    end
    State.Movement.FakeLagLastPosition = Position
    local RawDirection = HumanoidObject.MoveDirection
    local Direction = Vector3.new(RawDirection.X, 0, RawDirection.Z)
    if Direction.Magnitude > 0.001 then
        Direction = Direction.Unit
        State.Movement.FakeLagHoldDirection = Direction
    elseif State.Movement.FakeLagPhase == 'CHOKE'
        and typeof(State.Movement.FakeLagHoldDirection) == 'Vector3'
        and State.Movement.FakeLagHoldDirection.Magnitude > 0.001 then
        Direction = State.Movement.FakeLagHoldDirection.Unit
    else
        if State.Movement.FakeLagPhase ~= 'IDLE' then
            State.Movement.ResetFakeLag(string.upper(Mode) .. ' READY', false)
        end
        return
    end

    local Backend = State.Movement.ResolveFakeLagBackend(Root)
    State.Movement.NotifyFakeLagBackend()
    local DT = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.05)
    local Phase = State.Movement.FakeLagPhase
    if Phase ~= 'CHOKE' and Phase ~= 'RELEASE' then
        local Scale = 1 + (math.random() * 2 - 1) * Profile.Jitter
        State.Movement.FakeLagPhase = 'CHOKE'
        State.Movement.FakeLagPhaseUntil = Now + math.max(Profile.ChokeTime * Scale, 0.04)
        State.Movement.SetFakeLagNetworkChoke(true, false)
        if State.Movement.FakeLagBackend == 'LOCAL CHOKE' then
            State.Movement.FakeLagHoldPosition = Root.Position
        end
        Phase = 'CHOKE'
    end

    Backend = State.Movement.FakeLagBackend
    if Backend == 'LOCAL CHOKE' and Phase == 'CHOKE' then
        local BaseSpeed = State.Movement.WalkSpeedEnabled and State.Movement.WalkSpeedValue
            or HumanoidObject.WalkSpeed or 16
        if CONFIG.SpeedProfiles and not State.Movement.IsInMatch() then BaseSpeed = CONFIG.OutOfMatchSpeed end
        BaseSpeed = math.clamp(tonumber(BaseSpeed) or 16, 1, 250)
        State.Movement.FakeLagBuffer = math.min(
            (State.Movement.FakeLagBuffer or 0) + (BaseSpeed + Profile.ExtraSpeed) * DT,
            Profile.FallbackMaxPulse)
        local Hold = State.Movement.FakeLagHoldPosition or Root.Position
        State.Movement.FakeLagHoldPosition = Hold
        local Rotation = Root.CFrame - Root.Position
        local Velocity = Root.AssemblyLinearVelocity
        pcall(function()
            Root.CFrame = CFrame.new(Hold.X, Root.Position.Y, Hold.Z) * Rotation
            Root.AssemblyLinearVelocity = Vector3.new(0, Velocity.Y, 0)
        end)
    else
        State.Movement.FakeLagBuffer = math.min(
            (State.Movement.FakeLagBuffer or 0) + Profile.ExtraSpeed * DT,
            Profile.MaxPulse * 1.5)
        if Phase == 'CHOKE' then State.Movement.SetFakeLagNetworkChoke(true, false) end
    end

    if Phase == 'CHOKE' then
        State.Movement.FakeLagStatus = string.format('%s | CHOKE | %s',
            string.upper(Mode), State.Movement.FakeLagBackend)
        if Now < (State.Movement.FakeLagPhaseUntil or 0) then return end
        State.Movement.SetFakeLagNetworkChoke(false, false)
        local MaxPulse = State.Movement.FakeLagBackend == 'LOCAL CHOKE'
            and Profile.FallbackMaxPulse or Profile.MaxPulse
        local Requested = math.min(State.Movement.FakeLagBuffer or 0, MaxPulse)
        local Moved, Result = State.Movement.ReleaseFakeLagPulse(
            Character, Root, Direction, Requested)
        if Moved > 0 then
            State.Movement.FakeLagBuffer = math.max(0, (State.Movement.FakeLagBuffer or 0) - Moved)
            State.Movement.FakeLagPulses = (State.Movement.FakeLagPulses or 0) + 1
            State.Movement.FakeLagLastPosition = Root.Position
        else
            State.Movement.FakeLagBuffer = 0
        end
        State.Movement.FakeLagHoldPosition = nil
        State.Movement.FakeLagPhase = 'RELEASE'
        local Scale = 1 + (math.random() * 2 - 1) * Profile.Jitter
        State.Movement.FakeLagPhaseUntil = Now + math.max(Profile.ReleaseTime * Scale, 0.025)
        State.Movement.FakeLagStatus = string.format('%s | %s | +%.2f',
            string.upper(Mode), Result, Moved)
        return
    end

    State.Movement.SetFakeLagNetworkChoke(false, false)
    if Now >= (State.Movement.FakeLagPhaseUntil or 0) then
        local Scale = 1 + (math.random() * 2 - 1) * Profile.Jitter
        State.Movement.FakeLagPhase = 'CHOKE'
        State.Movement.FakeLagPhaseUntil = Now + math.max(Profile.ChokeTime * Scale, 0.04)
        State.Movement.SetFakeLagNetworkChoke(true, false)
        if State.Movement.FakeLagBackend == 'LOCAL CHOKE' then
            State.Movement.FakeLagHoldPosition = Root.Position
        end
    end
end

State.Lifecycle:AddCleanup(function()
    pcall(function() State.Movement.ResetFakeLag('OFF', true) end)
end)

function State.Movement.ApplyWalkSpeed(DeltaTime)
    if not State.Movement.WalkSpeedEnabled then return end
    local _, HumanoidObject, Root = State.Movement.GetRig()
    if not (HumanoidObject and Root) or HumanoidObject.Health <= 0 then return end

    local Value = State.Movement.WalkSpeedValue
    if CONFIG.SpeedProfiles and not State.Movement.IsInMatch() then Value = CONFIG.OutOfMatchSpeed end
    Value = math.clamp(tonumber(Value) or 32, 1, 250)

    local Direction = State.Movement.GetGroundInputDirection
        and State.Movement.GetGroundInputDirection(HumanoidObject, Root)
        or HumanoidObject.MoveDirection
    local Horizontal = Vector3.new(Direction.X, 0, Direction.Z)
    if Horizontal.Magnitude <= 0.001 then return end

    local Method = State.Movement.SpeedMethod or 'CFrame Step'

    if Method == 'WalkSpeed Property' then

        if HumanoidObject.WalkSpeed ~= Value then
            pcall(function() HumanoidObject.WalkSpeed = Value end)
        end
        return
    end

    if Method == 'Humanoid MoveTo' then

        local Target = Root.Position + Horizontal.Unit * (Value * 0.016)
        pcall(function() HumanoidObject:MoveTo(Target) end)
        return
    end

    if Method == 'Assembly Velocity' then

        local CurrentVelocity = Root.AssemblyLinearVelocity
        Root.AssemblyLinearVelocity = Vector3.new(
            Horizontal.Unit.X * Value,
            CurrentVelocity.Y,
            Horizontal.Unit.Z * Value)
        return
    end

    local StepTime = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.10)
    Root.CFrame = Root.CFrame + Horizontal.Unit * (Value * StepTime)
end

function State.Movement.AdvancedFeaturesEnabled()
    return CONFIG.InstantDirectionSwitch or CONFIG.OOBGuard or CONFIG.SprintKeyEnabled
        or CONFIG.SlowKeyEnabled or CONFIG.IcePhysics or State.Movement.TransientSpeedActive
end
function State.Movement.RestoreTransientSpeed(HumanoidObject)
    if not State.Movement.TransientSpeedActive then return end
    State.Movement.TransientSpeedActive = false
    if HumanoidObject and HumanoidObject.Parent and not State.Movement.WalkSpeedEnabled then
        local Original = State.Movement.OriginalWalkSpeed
        if Original then pcall(function() HumanoidObject.WalkSpeed = Original end) end
    end
end

function State.Movement.GetGroundInputDirection(HumanoidObject, Root)
    if UserInputService:GetFocusedTextBox() then return Vector3.zero end
    local Camera=Workspace.CurrentCamera
    local Forward=Camera and Vector3.new(Camera.CFrame.LookVector.X,0,Camera.CFrame.LookVector.Z)
        or (Root and Vector3.new(Root.CFrame.LookVector.X,0,Root.CFrame.LookVector.Z))
        or Vector3.zAxis
    local Right=Camera and Vector3.new(Camera.CFrame.RightVector.X,0,Camera.CFrame.RightVector.Z)
        or (Root and Vector3.new(Root.CFrame.RightVector.X,0,Root.CFrame.RightVector.Z))
        or Vector3.xAxis
    if Forward.Magnitude>.001 then Forward=Forward.Unit end
    if Right.Magnitude>.001 then Right=Right.Unit end
    local Direction=Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then Direction+=Forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then Direction-=Forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then Direction+=Right end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then Direction-=Right end
    if Direction.Magnitude<=.001 and HumanoidObject then
        local Raw=HumanoidObject.MoveDirection
        Direction=Vector3.new(Raw.X,0,Raw.Z)
    end
    return Direction.Magnitude>.001 and Direction.Unit or Vector3.zero
end

function State.Movement.ClearInstantDirectionSwitch()
    local Root=State.Movement.InstantSwitchRoot
    if Root and Root.Parent then
        for _,Name in ipairs({
            'SSInstantDirectionVelocity','SSInstantDirectionBodyVelocity','SSInstantDirectionAttachment'
        }) do
            local Stale=Root:FindFirstChild(Name)
            if Stale then pcall(function() Stale:Destroy() end) end
        end
    end
    local Track=State.Movement.InstantSwitchAnimationTrack
    State.Movement.InstantSwitchAnimationTrack=nil
    State.Movement.InstantSwitchAnimationAnimator=nil
    if Track then pcall(function() Track:Stop(0.08);
            Track:Destroy() end) end
    local HumanoidObject=State.Movement.InstantSwitchHumanoid
    local Original=State.Movement.InstantSwitchOriginalWalkSpeed
    if HumanoidObject and HumanoidObject.Parent and Original~=nil and not CONFIG.IcePhysics then
        local Restore=State.Movement.WalkSpeedEnabled
            and State.Movement.SpeedMethod=='WalkSpeed Property'
            and State.Movement.WalkSpeedValue or Original
        pcall(function() HumanoidObject.WalkSpeed=Restore end)
    end
    State.Movement.InstantSwitchRoot=nil
    State.Movement.InstantSwitchHumanoid=nil
    State.Movement.InstantSwitchOriginalWalkSpeed=nil
    State.Movement.InstantSwitchRaycastParams=nil
    State.Movement.InstantSwitchRaycastCharacter=nil
    State.Movement.InstantSwitchDirection=Vector3.zero
    State.Movement.InstantSwitchSpeed=0
    State.Movement.InstantSwitchMethod='CFRAME STEP'
    if State.Movement.AdvancedStatus=='INSTANT SWITCH' then State.Movement.AdvancedStatus='READY' end
end

function State.Movement.PrepareInstantDirectionController(Character,HumanoidObject,Root)
    if State.Movement.InstantSwitchRoot~=Root then
        State.Movement.ClearInstantDirectionSwitch()
        State.Movement.InstantSwitchRoot=Root
        State.Movement.InstantSwitchHumanoid=HumanoidObject
        State.Movement.InstantSwitchOriginalWalkSpeed=State.Movement.OriginalWalkSpeed or HumanoidObject.WalkSpeed
    end
    if State.Movement.InstantSwitchRaycastCharacter~=Character then
        local Params=RaycastParams.new()
        Params.FilterType=Enum.RaycastFilterType.Exclude
        Params.FilterDescendantsInstances={Character}
        Params.IgnoreWater=false
        pcall(function() Params.RespectCanCollide=true end)
        State.Movement.InstantSwitchRaycastParams=Params
        State.Movement.InstantSwitchRaycastCharacter=Character
    end
end

function State.Movement.GetInstantWalkAnimation(Character,HumanoidObject)
    local Animator=HumanoidObject and HumanoidObject:FindFirstChildOfClass('Animator')
    if not Animator then return nil end
    local Existing=State.Movement.InstantSwitchAnimationTrack
    if Existing and State.Movement.InstantSwitchAnimationAnimator==Animator then return Existing end
    if Existing then pcall(function() Existing:Stop(0.05);
            Existing:Destroy() end) end
    State.Movement.InstantSwitchAnimationTrack=nil
    State.Movement.InstantSwitchAnimationAnimator=nil

    local Animate=Character and Character:FindFirstChild('Animate')
    local AnimationObject
    if Animate then
        for _,Object in ipairs(Animate:GetDescendants()) do
            if Object:IsA('Animation') then
                local Name=string.lower(Object.Name)
                local ParentName=string.lower(Object.Parent and Object.Parent.Name or '')
                if string.find(Name,'walk',1,true) or string.find(ParentName,'walk',1,true) then
                    AnimationObject=Object
                    break
                end
            end
        end
        if not AnimationObject then
            for _,Object in ipairs(Animate:GetDescendants()) do
                if Object:IsA('Animation') then
                    local Name=string.lower(Object.Name)
                    local ParentName=string.lower(Object.Parent and Object.Parent.Name or '')
                    if string.find(Name,'run',1,true) or string.find(ParentName,'run',1,true) then
                        AnimationObject=Object
                        break
                    end
                end
            end
        end
    end

    local Temporary
    if not AnimationObject then
        Temporary=Instance.new('Animation')
        Temporary.Name='SSInstantWalkFallback'
        Temporary.AnimationId=HumanoidObject.RigType==Enum.HumanoidRigType.R15
            and 'rbxassetid://507777826' or 'rbxassetid://180426354'
        AnimationObject=Temporary
    end
    local Track
    pcall(function() Track=Animator:LoadAnimation(AnimationObject) end)
    if Temporary then pcall(function() Temporary:Destroy() end) end
    if not Track then return nil end
    Track.Priority=Enum.AnimationPriority.Movement
    Track.Looped=true
    State.Movement.InstantSwitchAnimationTrack=Track
    State.Movement.InstantSwitchAnimationAnimator=Animator
    return Track
end

function State.Movement.UpdateInstantWalkAnimation(Character,HumanoidObject,Speed,Moving)
    local Track=State.Movement.InstantSwitchAnimationTrack
    if not Moving or HumanoidObject.FloorMaterial==Enum.Material.Air then
        if Track and Track.IsPlaying then pcall(function() Track:Stop(0.10) end) end
        return
    end
    Track=State.Movement.GetInstantWalkAnimation(Character,HumanoidObject)
    if not Track then return end
    local Playback=math.clamp((tonumber(Speed) or 16)/14.5,0.35,3.5)
    if not Track.IsPlaying then pcall(function() Track:Play(0.08,1,Playback) end) end
    pcall(function() Track:AdjustSpeed(Playback) end)
end

function State.Movement.GetSafeInstantStep(Character,Root,Offset)
    if not (Character and Root) or Offset.Magnitude<=.0001 then return Offset end
    local Params=State.Movement.InstantSwitchRaycastParams
    if not Params then return Offset end
    local Result
    local Ok=pcall(function()
        Result=Workspace:Blockcast(Root.CFrame,Root.Size,Offset,Params)
    end)
    if not Ok then
        pcall(function() Result=Workspace:Raycast(Root.Position,Offset.Unit*(Offset.Magnitude+1),Params) end)
    end
    if not Result then return Offset end
    local Allowed=math.max(0,(tonumber(Result.Distance) or 0)-0.08)
    return Offset.Unit*math.min(Offset.Magnitude,Allowed)
end

function State.Movement.GetInstantDirectionSpeed(HumanoidObject)
    local Base=State.Movement.WalkSpeedEnabled and State.Movement.WalkSpeedValue
        or State.Movement.InstantSwitchOriginalWalkSpeed
        or State.Movement.OriginalWalkSpeed
        or (HumanoidObject and HumanoidObject.WalkSpeed)
        or 16
    if CONFIG.SpeedProfiles and not State.Movement.IsInMatch() then Base=CONFIG.OutOfMatchSpeed end
    if CONFIG.SprintKeyEnabled and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then Base=CONFIG.SprintSpeed end
    if CONFIG.SlowKeyEnabled and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then Base=CONFIG.SlowSpeed end
    return math.clamp(tonumber(Base) or 16,1,250)
end

function State.Movement.ApplyInstantDirectionSwitch(DeltaTime)
    if not CONFIG.InstantDirectionSwitch then
        if State.Movement.InstantSwitchRoot then State.Movement.ClearInstantDirectionSwitch() end
        return
    end
    if State.Movement.FlightEnabled or (State.Stepback and State.Stepback.Active) then
        State.Movement.ClearInstantDirectionSwitch()
        return
    end
    if State.Runtime and State.Runtime.MovementOwner
        and os.clock()<(State.Runtime.MovementLeaseUntil or 0) then
        State.Movement.ClearInstantDirectionSwitch()
        return
    end
    local Character,HumanoidObject,Root=State.Movement.GetRig()
    if not (Character and HumanoidObject and Root) or HumanoidObject.Health<=0
        or HumanoidObject.Sit or Root.Anchored then
        State.Movement.ClearInstantDirectionSwitch()
        return
    end
    local Direction=State.Movement.GetGroundInputDirection(HumanoidObject,Root)
    local Speed=State.Movement.GetInstantDirectionSpeed(HumanoidObject)
    if CONFIG.OOBGuard and Direction.Magnitude>.001 and State.AutoOffense
        and State.AutoOffense.GetCourt and State.AutoOffense.GetBoundarySafeDirection then
        local Court=State.AutoOffense.GetCourt()
        if Court then
            local Safe,Avoiding=State.AutoOffense.GetBoundarySafeDirection(Root,Direction,Court)
            if Avoiding and Safe and Safe.Magnitude>.001 then Direction=Safe.Unit end
        end
    end
    State.Movement.InstantSwitchDirection=Direction
    State.Movement.InstantSwitchSpeed=Speed

    if CONFIG.IcePhysics then
        if State.Movement.InstantSwitchRoot then State.Movement.ClearInstantDirectionSwitch() end
        if Direction.Magnitude>.001 then
            local Current=Root.AssemblyLinearVelocity
            State.Movement.IceMomentum=Direction*Speed
            Root.AssemblyLinearVelocity=Vector3.new(Direction.X*Speed,Current.Y,Direction.Z*Speed)
            State.Movement.AdvancedStatus='INSTANT SWITCH'
        end
        return
    end

    State.Movement.PrepareInstantDirectionController(Character,HumanoidObject,Root)
    pcall(function() HumanoidObject.WalkSpeed=0 end)
    local Current=Root.AssemblyLinearVelocity
    if Direction.Magnitude>.001 then
        HumanoidObject:Move(Direction,false)
        State.Movement.UpdateInstantWalkAnimation(Character,HumanoidObject,Speed,true)
        local DT=math.clamp(tonumber(DeltaTime) or 1/60,0,0.05)
        local Offset=State.Movement.GetSafeInstantStep(Character,Root,Direction*Speed*DT)
        local NewPosition=Root.Position+Offset
        if UserInputService.MouseBehavior~=Enum.MouseBehavior.LockCenter then
            Root.CFrame=CFrame.lookAt(NewPosition,NewPosition+Direction,Vector3.yAxis)
        else
            Root.CFrame=Root.CFrame+Offset
        end
        Root.AssemblyLinearVelocity=Vector3.new(0,Current.Y,0)
        State.Movement.LastManualDirection=Direction
        State.Movement.AdvancedStatus='INSTANT SWITCH'
    else
        HumanoidObject:Move(Vector3.zero,false)
        State.Movement.UpdateInstantWalkAnimation(Character,HumanoidObject,Speed,false)
        Root.AssemblyLinearVelocity=Vector3.new(0,Current.Y,0)
        State.Movement.AdvancedStatus='INSTANT READY'
    end
end

State.Lifecycle:AddCleanup(function()
    State.Movement.ClearInstantDirectionSwitch()
end)

function State.Movement.ApplyGroundFeatures(DeltaTime)
    local _, HumanoidObject, Root = State.Movement.GetRig()
    if not (HumanoidObject and Root) or HumanoidObject.Health <= 0 then return end
    if State.Stepback and State.Stepback.Active then return end
    if State.Runtime and State.Runtime.MovementOwner
        and os.clock() < (State.Runtime.MovementLeaseUntil or 0) then return end
    local DT=math.clamp(tonumber(DeltaTime) or 1/60,0,0.05)
    local Direction=State.Movement.GetGroundInputDirection(HumanoidObject,Root)
    local Base=State.Movement.WalkSpeedEnabled and State.Movement.WalkSpeedValue
        or (State.Movement.OriginalWalkSpeed or HumanoidObject.WalkSpeed or 16)
    if CONFIG.SpeedProfiles and not State.Movement.IsInMatch() then Base=CONFIG.OutOfMatchSpeed end
    local SprintHeld=CONFIG.SprintKeyEnabled and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
    local SlowHeld=CONFIG.SlowKeyEnabled and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
    local Speed=SlowHeld and CONFIG.SlowSpeed or (SprintHeld and CONFIG.SprintSpeed or Base)
    Speed=math.clamp(tonumber(Speed) or 16,1,250)
    if CONFIG.InstantDirectionSwitch then
        State.Movement.TransientSpeedActive=false
    elseif SprintHeld or SlowHeld then
        State.Movement.TransientSpeedActive=true
        if HumanoidObject.WalkSpeed~=Speed then pcall(function() HumanoidObject.WalkSpeed=Speed end) end
    else State.Movement.RestoreTransientSpeed(HumanoidObject) end

    if CONFIG.OOBGuard and State.AutoOffense then
        local Court=State.AutoOffense.GetCourt and State.AutoOffense.GetCourt() or nil
        if Court and State.AutoOffense.GetBoundarySafeDirection then
            local Existing=Root.AssemblyLinearVelocity
            local ExistingFlat=Vector3.new(Existing.X,0,Existing.Z)
            local GuardDirection=Direction
            if GuardDirection.Magnitude<=0.001 and ExistingFlat.Magnitude>0.05 then
                GuardDirection=ExistingFlat.Unit
            end
            if GuardDirection.Magnitude>0.001 then
                local Safe,Avoiding=State.AutoOffense.GetBoundarySafeDirection(Root,GuardDirection,Court)
                if Avoiding and Safe and Safe.Magnitude>0.001 then
                    Direction=Safe.Unit
                    HumanoidObject:Move(Direction,false)
                    local GuardSpeed=math.min(math.max(ExistingFlat.Magnitude,Speed),60)
                    Root.AssemblyLinearVelocity=Vector3.new(Direction.X*GuardSpeed,Existing.Y,Direction.Z*GuardSpeed)
                    if CONFIG.IcePhysics then State.Movement.IceMomentum=Direction*GuardSpeed end
                    local Inside,Recovery=State.AutoOffense.GetSafeCourtBounds(Root.Position,Court)
                    if not Inside and Recovery then
                        local Offset=Vector3.new(Recovery.X-Root.Position.X,0,Recovery.Z-Root.Position.Z)
                        Root.CFrame=Root.CFrame+Offset
                    end
                    State.Movement.AdvancedStatus='OOB GUARD'
                end
            end
        end
    end

    if Direction.Magnitude>0.001 then State.Movement.LastManualDirection=Direction end

    if CONFIG.IcePhysics then

        State.Movement.AdvancedStatus='ICE ACTIVE'
    elseif not (SprintHeld or SlowHeld) and State.Movement.AdvancedStatus~='OOB GUARD'
        and State.Movement.AdvancedStatus~='INSTANT SWITCH' then
        State.Movement.AdvancedStatus='READY'
    end
end

function State.Movement.RestoreIcePhysics()
    if State.Movement.IceHumanoid and State.Movement.IceHumanoid.Parent and State.Movement.IceOriginalWalkSpeed then
        pcall(function() State.Movement.IceHumanoid.WalkSpeed=State.Movement.IceOriginalWalkSpeed end)
    end
    for Part,Original in pairs(State.Movement.IceOriginalProperties) do
        if Part and Part.Parent then pcall(function() Part.CustomPhysicalProperties=Original end) end
        State.Movement.IceOriginalProperties[Part]=nil
    end
    State.Movement.IceHumanoid=nil;
    State.Movement.IceOriginalWalkSpeed=nil;
    State.Movement.IceCharacter=nil
    State.Movement.IceMomentum=Vector3.zero
    State.Movement.IceJumpQueuedUntil=0
end
function State.Movement.PrepareIceCharacter(Character,HumanoidObject,Root)
    if State.Movement.IceCharacter==Character then return end
    State.Movement.RestoreIcePhysics()
    State.Movement.IceCharacter=Character;
    State.Movement.IceHumanoid=HumanoidObject
    State.Movement.IceOriginalWalkSpeed=HumanoidObject.WalkSpeed
    local V=Root.AssemblyLinearVelocity;
    State.Movement.IceMomentum=Vector3.new(V.X,0,V.Z)
    for _,Part in ipairs(Character:GetChildren()) do
        if Part:IsA('BasePart') then
            State.Movement.IceOriginalProperties[Part]=Part.CustomPhysicalProperties
            local Current=Part.CurrentPhysicalProperties
            pcall(function() Part.CustomPhysicalProperties=PhysicalProperties.new(Current.Density,0,Current.Elasticity,100,Current.ElasticityWeight) end)
        end
    end
end
function State.Movement.GetIceInput(HumanoidObject,Root)
    if UserInputService:GetFocusedTextBox() then return Vector3.zero end
    local Camera=Workspace.CurrentCamera
    local Forward=Camera and Vector3.new(Camera.CFrame.LookVector.X,0,Camera.CFrame.LookVector.Z) or Vector3.new(Root.CFrame.LookVector.X,0,Root.CFrame.LookVector.Z)
    local Right=Camera and Vector3.new(Camera.CFrame.RightVector.X,0,Camera.CFrame.RightVector.Z) or Vector3.new(Root.CFrame.RightVector.X,0,Root.CFrame.RightVector.Z)
    if Forward.Magnitude>.001 then Forward=Forward.Unit end;
    if Right.Magnitude>.001 then Right=Right.Unit end
    local Direction=Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then Direction+=Forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then Direction-=Forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then Direction+=Right end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then Direction-=Right end

    if Direction.Magnitude<=.001 then local Raw=HumanoidObject.MoveDirection;
        Direction=Vector3.new(Raw.X,0,Raw.Z) end
    return Direction.Magnitude>.001 and Direction.Unit or Vector3.zero
end
function State.Movement.ApplyIcePhysics(DeltaTime)
    if not CONFIG.IcePhysics then return end
    if State.Movement.FlightEnabled or (State.Stepback and State.Stepback.Active) then return end
    if State.Runtime and State.Runtime.MovementOwner and os.clock()<(State.Runtime.MovementLeaseUntil or 0) then return end
    local Character,HumanoidObject,Root=State.Movement.GetRig()
    if not (Character and HumanoidObject and Root) or HumanoidObject.Health<=0 then return end
    State.Movement.PrepareIceCharacter(Character,HumanoidObject,Root)
    local DT=math.clamp(tonumber(DeltaTime) or 1/60,0,0.05)
    local Actual=Root.AssemblyLinearVelocity
    HumanoidObject.WalkSpeed=0
    local Direction=State.Movement.GetIceInput(HumanoidObject,Root)
    local Base=State.Movement.WalkSpeedEnabled and State.Movement.WalkSpeedValue or (State.Movement.IceOriginalWalkSpeed or 16)
    if CONFIG.SpeedProfiles and not State.Movement.IsInMatch() then Base=CONFIG.OutOfMatchSpeed end
    if CONFIG.SprintKeyEnabled and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then Base=CONFIG.SprintSpeed end
    if CONFIG.SlowKeyEnabled and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then Base=CONFIG.SlowSpeed end
    Base=math.clamp(tonumber(Base) or 16,1,250)
    local Momentum=State.Movement.IceMomentum or Vector3.zero
    local Grounded=HumanoidObject.FloorMaterial~=Enum.Material.Air
    local JumpQueued=os.clock()<=(State.Movement.IceJumpQueuedUntil or 0)

    if not Grounded then

        if CONFIG.IceAirMomentum~=false then Root.AssemblyLinearVelocity=Vector3.new(Momentum.X,Actual.Y,Momentum.Z) end
        State.Movement.AdvancedStatus='ICE AIR MOMENTUM'
        return
    end

    if Direction.Magnitude>.001 then
        local Speed=Momentum.Magnitude
        local Acceleration=math.clamp(tonumber(CONFIG.IceAcceleration) or 4.5,.25,20)
        local TurnGrip=math.clamp(tonumber(CONFIG.IceTurnGrip) or 3.25,.15,15)
        local SpeedAlpha=1-math.exp(-Acceleration*DT)
        local TurnAlpha=1-math.exp(-TurnGrip*DT)
        local NewSpeed=Speed+(Base-Speed)*SpeedAlpha
        if Speed<=.05 then Momentum=Direction*math.max(NewSpeed,Base*.08)
        else
            local Heading=Momentum.Unit:Lerp(Direction,TurnAlpha)
            Momentum=(Heading.Magnitude>.001 and Heading.Unit or Direction)*math.max(NewSpeed,.05)
        end
    else
        local Retention=math.clamp(tonumber(CONFIG.IceGlide) or .994,.90,.9998)
        Momentum*=Retention^(DT*60)
        if Momentum.Magnitude<.03 then Momentum=Vector3.zero end
    end
    if CONFIG.OOBGuard and State.AutoOffense then
        local Court=State.AutoOffense.GetCourt and State.AutoOffense.GetCourt() or nil
        if Court and State.AutoOffense.GetBoundarySafeDirection then
            local GuardDirection=Direction
            if GuardDirection.Magnitude<=.001 and Momentum.Magnitude>.05 then GuardDirection=Momentum.Unit end
            if GuardDirection.Magnitude>.001 then
                local Safe,Avoiding=State.AutoOffense.GetBoundarySafeDirection(Root,GuardDirection,Court)
                if Avoiding and Safe and Safe.Magnitude>.001 then
                    local PreservedSpeed=math.max(Momentum.Magnitude,math.min(Base,60))
                    Direction=Safe.Unit
                    Momentum=Direction*PreservedSpeed
                    local Inside,Recovery=State.AutoOffense.GetSafeCourtBounds(Root.Position,Court)
                    if not Inside and Recovery then
                        local Offset=Vector3.new(Recovery.X-Root.Position.X,0,Recovery.Z-Root.Position.Z)
                        Root.CFrame=Root.CFrame+Offset
                    end
                    State.Movement.AdvancedStatus='ICE OOB GUARD'
                end
            end
        end
    end
    State.Movement.IceMomentum=Momentum

    if Direction.Magnitude>.001 and UserInputService.MouseBehavior~=Enum.MouseBehavior.LockCenter then
        local FacingRate=math.clamp((tonumber(CONFIG.IceTurnGrip) or 3.25)*2.4,4,24)
        local FacingAlpha=1-math.exp(-FacingRate*DT)
        local TargetFacing=CFrame.lookAt(Root.Position,Root.Position+Direction,Vector3.yAxis)
        Root.CFrame=Root.CFrame:Lerp(TargetFacing,FacingAlpha)
    end

    if JumpQueued and not (State.NoJump and State.NoJump.Active) then
        State.Movement.IceJumpQueuedUntil=0
        local JumpVelocity
        if HumanoidObject.UseJumpPower then JumpVelocity=math.max(tonumber(HumanoidObject.JumpPower) or 50,1)
        else JumpVelocity=math.sqrt(2*Workspace.Gravity*math.max(tonumber(HumanoidObject.JumpHeight) or 7.2,.1)) end
        pcall(function() HumanoidObject.Jump=true;
            HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping) end)
        Root.AssemblyLinearVelocity=Vector3.new(Momentum.X,JumpVelocity,Momentum.Z)
        State.Movement.AdvancedStatus='ICE JUMP MOMENTUM'
        return
    end
    Root.AssemblyLinearVelocity=Vector3.new(Momentum.X,Actual.Y,Momentum.Z)
    State.Movement.AdvancedStatus=Direction.Magnitude>.001 and 'ICE STEER' or 'ICE GLIDE'
end
function State.Movement.SetIcePhysics(Value)
    Value=Value==true
    if Value and CONFIG.IcePhysics and State.Movement.IceCharacter then return end
    if not Value and not CONFIG.IcePhysics and not State.Movement.IceCharacter then return end
    if Value and State.Movement.InstantSwitchRoot then State.Movement.ClearInstantDirectionSwitch() end
    CONFIG.IcePhysics=Value
    if Value then
        local Character,HumanoidObject,Root=State.Movement.GetRig()
        if Character and HumanoidObject and Root then State.Movement.PrepareIceCharacter(Character,HumanoidObject,Root) end
        State.Movement.AdvancedStatus='ICE READY'
    else
        State.Movement.RestoreIcePhysics();
        State.Movement.AdvancedStatus='READY'
        State.Movement.ApplyWalkSpeed()
    end
end

