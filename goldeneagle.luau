if #ExternalArcTable == 0 and type(CONFIG.ArcTableFile) == 'string'
    and type(isfile) == 'function' and type(readfile) == 'function'
    and type(loadstring) == 'function' then
    local Ok, Loaded = pcall(function()
        if not isfile(CONFIG.ArcTableFile) then return nil end
        local Chunk, CompileError = loadstring(readfile(CONFIG.ArcTableFile))
        if not Chunk then error(CompileError or 'arc table compile failed') end
        return Chunk()
    end)
    if Ok then ExternalArcTable = NormalizeArcTable(Loaded) end
end

