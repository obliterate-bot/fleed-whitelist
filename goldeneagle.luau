    local function EnsureTabVisible(Name, AlignToStart)
        task.defer(function()
            if not (NavList and NavList.Parent and NavLayout and NavLayout.Parent) then return end
            local Data = HubUI.TabButtons[Name]
            local Button = Data and Data.Button
            if not (Button and Button.Parent and Button.Visible) then return end
            task.wait()
            if not (Button.Parent and NavList.Parent) then return end

            local CurrentX = NavList.CanvasPosition.X
            local NavLeft = NavList.AbsolutePosition.X
            local NavRight = NavLeft + NavList.AbsoluteSize.X
            local ButtonLeft = Button.AbsolutePosition.X
            local ButtonRight = ButtonLeft + Button.AbsoluteSize.X
            local TargetX = CurrentX

            if AlignToStart then
                TargetX = CurrentX + (ButtonLeft - NavLeft)
            elseif ButtonLeft < NavLeft then
                TargetX = CurrentX - (NavLeft - ButtonLeft)
            elseif ButtonRight > NavRight then
                TargetX = CurrentX + (ButtonRight - NavRight)
            end

            local MaximumX = math.max(0, NavLayout.AbsoluteContentSize.X - NavList.AbsoluteSize.X)
            TargetX = math.clamp(math.floor(TargetX + 0.5), 0, MaximumX)
            Tween(NavList, 0.26, { CanvasPosition = Vector2.new(TargetX, 0) }, Enum.EasingStyle.Sine)
        end)
    end
    HubUI.EnsureTabVisible = EnsureTabVisible

    local function CreateSideTab(Definition)
        LayoutOrder += 1
        local Name = Definition.Name
        local DisplayName = Definition.DisplayName or Name
        local InitiallySelected = Name == HubUI.ActiveTab

        local Width = math.max(58, math.ceil(#DisplayName * 6.6) + 22)
        local Button = New('TextButton', {
