local SetArcTableApi
SetArcTableApi = function(NewRows)
    local OverrideRows = NormalizeArcTable(NewRows)
    if #OverrideRows == 0 then
        local ErrorText = 'table contained no valid rows'
        Notify('GOLDEN EAGLE', 'Arc table rejected: ' .. ErrorText)
        return false, ErrorText
    end
    local Ok, CountOrError = InstallArcTable(MergeArcTables(BuiltInArcTable, OverrideRows))
    if not Ok then
        Notify('GOLDEN EAGLE', 'Arc table rejected: ' .. tostring(CountOrError))
        return false, CountOrError
    end
    GlobalEnv.__HOOPZ_ARC_TABLE = ArcTable
    GlobalEnv.__HOOPZ_ARC_TABLE_VERSION = CONFIG.ArcTableVersion
    Notify('GOLDEN EAGLE', string.format('Applied %d calibrated arc rows live.', CountOrError))
    return true, CountOrError
end
GlobalEnv.__HOOPZ_SILENTAIM_SET_ARC_TABLE = SetArcTableApi

local PowerSupportsDistance
PowerSupportsDistance = WYNF_JIT_MAX(function(power, distance)
    local Minimum = MinRangeForPower[power]
    local Maximum = MaxRangeForPower[power]
    return type(distance) == 'number' and Minimum ~= nil and Maximum ~= nil
        and distance >= Minimum and distance <= Maximum
end)

local GetArcSettings
GetArcSettings = WYNF_JIT_MAX(function(Dist, DesiredPower)
    local Below, Above = nil, nil
    for _, Entry in ipairs(ArcTable) do
        if Entry[3] == DesiredPower then
            local EntryDistance = Entry[1]
            if EntryDistance <= Dist and (Below == nil or EntryDistance > Below[1]) then
                Below = Entry
            end
            if EntryDistance >= Dist and (Above == nil or EntryDistance < Above[1]) then
                Above = Entry
            end
        end
    end

    if Below and Above then
        local Span = Above[1] - Below[1]
        if math.abs(Span) < 0.0001 then
            return Below[2], DesiredPower
        end
        local Alpha = (Dist - Below[1]) / Span
        return Below[2] + (Above[2] - Below[2]) * Alpha, DesiredPower
    end

    local Endpoint = Below or Above
    if Endpoint then return Endpoint[2], DesiredPower end
    return 0, DesiredPower or 0
end)

local GoalData = { check = {}, seen = {} }
local function RefreshGoalData()
    GoalData.check = {}
    GoalData.seen = {}

    local function AddHitboxes(Hitboxes)
        if Hitboxes and not GoalData.seen[Hitboxes] then
            GoalData.seen[Hitboxes] = true
            table.insert(GoalData.check, Hitboxes)
        end
    end

    for _, FieldGoal in ipairs(CollectionService:GetTagged('FieldGoals')) do
        AddHitboxes(FieldGoal.Parent)
    end

    for _, Court in ipairs(GetAllCourts()) do
        AddHitboxes(safe_find(Court, 'HitboxesHome'))
        AddHitboxes(safe_find(Court, 'HitboxesAway'))
        AddHitboxes(safe_find(Court, 'Hitboxes'))
    end
end

