        local function RefreshHud()
            if not Hud.Visible then return end
            local Labels = {}
            for _, Control in pairs(HubUI.Controls) do
                if type(Control) == 'table' and Control.Kind == 'Toggle' and Control.Value == true and Control.SearchLabel then
                    table.insert(Labels, Control.SearchLabel)
                end
            end
            table.sort(Labels)
            local Extra = math.max(0, #Labels - 12)
            while #Labels > 12 do table.remove(Labels) end
            local Signature = table.concat(Labels, '|') .. '|' .. Extra
            if Signature == HudSignature then return end
            HudSignature = Signature
            for _, Child in ipairs(HudList:GetChildren()) do
                if Child:IsA('TextLabel') then Child:Destroy() end
            end
            local Count = 0
            for Index, Label in ipairs(Labels) do
                Count += 1
                New('TextLabel', {
                    Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Font = Enum.Font.Code,
                    Text = '- ' .. Label, TextColor3 = Theme.AccentBright, TextSize = 10,
                    TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Left,
                    LayoutOrder = Index, ZIndex = 119,
                    }, HudList)
            end
            if Extra > 0 then
                Count += 1
                New('TextLabel', {
                    Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Font = Enum.Font.Code,
                    Text = '+ ' .. Extra .. ' more', TextColor3 = Theme.Muted, TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 99, ZIndex = 119,
                    }, HudList)
            end
            if Count == 0 then
                Count = 1
                New('TextLabel', {
                    Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Font = Enum.Font.Code,
                    Text = 'Nothing active', TextColor3 = Theme.Muted, TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, ZIndex = 119,
                    }, HudList)
            end
            Hud.Size = UDim2.fromOffset(196, 28 + Count * 15 + 4)
        end
