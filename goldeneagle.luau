local function HiddenGui()
    local Now = os.clock()
    if PerfCache.HiddenGui and Now - PerfCache.HiddenGuiAt < 3 then
        return PerfCache.HiddenGui
    end
    local Resolved
    if type(gethui) == 'function' then
        local HuiOk, Container = pcall(gethui)
        if HuiOk and Container then Resolved = Container end
    end
    if not Resolved then
        local Ok, Service = pcall(function() return game:GetService('CoreGui') end)
        if Ok and Service then Resolved = Service end
    end
    if not Resolved then Resolved = LP:FindFirstChildOfClass('PlayerGui') end
    PerfCache.HiddenGui, PerfCache.HiddenGuiAt = Resolved, Now
    return Resolved
end

