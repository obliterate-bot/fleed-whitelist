    end)
    if Ok then
        for _, Input in ipairs(Inputs) do
            if Input.KeyCode == Enum.KeyCode.Thumbstick1
                and Vector2.new(Input.Position.X, Input.Position.Y).Magnitude > 0.18 then
                return true
            end
        end
    end
    return false
end

function State.AutoOffense.GetManualDirection(Humanoid, Root)
    if UserInputService:GetFocusedTextBox() then return Vector3.zero end
    local Forward, Side = State.AutoMix.GetCameraBasis(Root)
    local Direction = Vector3.zero
    local Explicit = false
    if UserInputService:IsKeyDown(Enum.KeyCode.W)
        or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
        Direction += Forward;
        Explicit = true
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S)
        or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
        Direction -= Forward;
        Explicit = true
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D)
        or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
        Direction += Side;
        Explicit = true
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A)
        or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
        Direction -= Side;
        Explicit = true
    end
    local Ok, Inputs = pcall(
        UserInputService.GetGamepadState,
        UserInputService, Enum.UserInputType.Gamepad1)
    if Ok then
        for _, Input in ipairs(Inputs) do
            if Input.KeyCode == Enum.KeyCode.Thumbstick1 then
                local Stick = Vector2.new(Input.Position.X, Input.Position.Y)
                if Stick.Magnitude > 0.18 then
                    Direction += Side * Stick.X + Forward * Stick.Y
                    Explicit = true
                end
            end
        end
    end

    if not Explicit and UserInputService.TouchEnabled and Humanoid then
        local Touch = Vector3.new(
            Humanoid.MoveDirection.X, 0, Humanoid.MoveDirection.Z)
        local Last = State.AutoOffense.LastIssuedDirection or Vector3.zero
        local SameAsAuto = Touch.Magnitude > 0.05 and Last.Magnitude > 0.05
            and Touch.Unit:Dot(Last.Unit) >= 0.985
            and math.abs(Touch.Magnitude - Last.Magnitude) <= 0.12
        if Touch.Magnitude > 0.05 and not SameAsAuto then Direction = Touch end
    end
    Direction = Vector3.new(Direction.X, 0, Direction.Z)
    if Direction.Magnitude > 1 then Direction = Direction.Unit end
    State.AutoOffense.ManualDirection = Direction
    return Direction
end

function State.AutoOffense.BlendManualDirection(
        AutoDirection, ManualDirection, Threatened)
    local Auto = Vector3.new(AutoDirection.X, 0, AutoDirection.Z)
    local Manual = Vector3.new(ManualDirection.X, 0, ManualDirection.Z)
    if Manual.Magnitude <= 0.05 then return Auto, false end
    if Auto.Magnitude <= 0.05 then return Manual.Unit, true end
    local AssistWeight = Threatened and 0.42 or 0.20
    local Blended = Manual.Unit + Auto.Unit * AssistWeight
    if Blended.Magnitude <= 0.05 then return Manual.Unit, true end
    return Blended.Unit, true
end

function State.AutoOffense.GetAntiRipLead(DeltaTime)
    local PingSeconds=0
    if CONFIG.AutoOffenseAntiRipPingLead~=false and State.Utility and State.Utility.GetPing then
        PingSeconds=math.max(0,tonumber(State.Utility.GetPing()) or 0)/1000
    end
    local Frame=math.clamp(tonumber(DeltaTime) or (1/60),1/240,1/20)
    local Extra=math.clamp(tonumber(CONFIG.AutoOffenseAntiRipExtraLead) or .035,0,.20)
    local Maximum=math.clamp(tonumber(CONFIG.AutoOffenseAntiRipMaxLead) or .28,.05,.50)

    return math.clamp(PingSeconds*.5+Frame*2+Extra,.035,Maximum)
end

function State.AutoOffense.BallPartClearance(BallPosition,BallRadius,Part,Lead,VelocityOverride)
    if not (Part and Part.Parent and safe_is_a(Part,'BasePart')) then return math.huge end
    local Velocity=typeof(VelocityOverride)=='Vector3' and VelocityOverride or Part.AssemblyLinearVelocity
    local FlatVelocity=Vector3.new(Velocity.X,0,Velocity.Z)
    local PredictedFrame=Part.CFrame+FlatVelocity*(tonumber(Lead) or 0)
    local LocalPoint=PredictedFrame:PointToObjectSpace(BallPosition)
    local Half=Part.Size*.5
    local Closest=Vector3.new(
        math.clamp(LocalPoint.X,-Half.X,Half.X),
        math.clamp(LocalPoint.Y,-Half.Y,Half.Y),
        math.clamp(LocalPoint.Z,-Half.Z,Half.Z))
    local ClosestWorld=PredictedFrame:PointToWorldSpace(Closest)
    return (BallPosition-ClosestWorld).Magnitude-BallRadius
end

function State.AutoOffense.ScanAntiRipClearance(BallPosition,BallRadius,Lead)
    local BestClearance=math.huge
    local BestPlayer=nil
    local BestPart=nil
    local MyRoot=LP.Character and safe_find(LP.Character,'HumanoidRootPart')
    for _,Candidate in ipairs(Players:GetPlayers()) do
        if Candidate~=LP and IsGuardOpponent(Candidate) then
            local Character=Candidate.Character
            local DefenderRoot=Character and safe_find(Character,'HumanoidRootPart')
            if DefenderRoot and (not MyRoot or (DefenderRoot.Position-MyRoot.Position).Magnitude<=18) then
                for _,Part in ipairs(Character:GetChildren()) do
                    if safe_is_a(Part,'BasePart') and Part.CanTouch~=false then
                        local Clearance=State.AutoOffense.BallPartClearance(
                            BallPosition,BallRadius,Part,Lead)
                        if Clearance<BestClearance then
                            BestClearance=Clearance
                            BestPlayer=Candidate
                            BestPart=Part
                        end
                    end
                end
            end
        end
    end
    return BestClearance,BestPlayer,BestPart
end

function State.AutoOffense.TryEarlyNoSteal(Now)
    if CONFIG.AutoOffenseAntiRipNoSteal==false then return 'DISABLED' end
    if State.BallAssist.IsNoStealActive() then return 'PROTECTED' end
    local Cooldown=math.clamp(
        tonumber(CONFIG.AutoOffenseAntiRipNoStealCooldown) or .45,.15,1.5)
    if Now-(State.AutoOffense.AntiRipLastNoStealAt or 0)<Cooldown then return 'COOLDOWN' end
    local Remote=State.BallAssist.GetNoStealRemote()
    if not Remote then return 'NO REMOTE' end
    State.AutoOffense.AntiRipLastNoStealAt=Now
    local Ok=pcall(function() Remote:FireServer() end)
    return Ok and 'REQUESTED' or 'REMOTE ERROR'
end

function State.AutoOffense.StepAntiRip(DeltaTime)
    if not (State.Active and State.AutoOffense.Enabled and CONFIG.AutoOffenseAntiRip~=false) then
        if State.Runtime.MovementOwner=='AntiRip' then State.Runtime.ReleaseMovement('AntiRip') end
        State.AutoOffense.AntiRipActive=false
        State.AutoOffense.AntiRipStatus=CONFIG.AutoOffenseAntiRip==false and 'OFF' or 'STANDBY'
        return
    end
    local Character=LP.Character
    local Root=Character and safe_find(Character,'HumanoidRootPart')
    local Humanoid=Character and Character:FindFirstChildOfClass('Humanoid')
    local Basketball=GetHeldBasketballModel(LP)
    local Ball=Basketball and safe_find(Basketball,'Ball')
    if not (Root and Humanoid and Ball and safe_is_a(Ball,'BasePart'))
        or State.AutoOffense.InProgress then
        if State.Runtime.MovementOwner=='AntiRip' then State.Runtime.ReleaseMovement('AntiRip') end
        State.AutoOffense.AntiRipActive=false
        State.AutoOffense.AntiRipStatus=Ball and 'ACTION' or 'NEED BALL'
        return
    end

    local Now=os.clock()
    local Lead=State.AutoOffense.GetAntiRipLead(DeltaTime)
    local Padding=math.clamp(tonumber(CONFIG.AutoOffenseAntiRipPadding) or .90,0,3)
    local BallRadius=math.max(Ball.Size.X,Ball.Size.Y,Ball.Size.Z)*.5+Padding
    local RootVelocity=Root.AssemblyLinearVelocity
    local BallProjected=Ball.Position+Vector3.new(RootVelocity.X,0,RootVelocity.Z)*Lead
    local CurrentClearance,CurrentPlayer,CurrentPart=
    State.AutoOffense.ScanAntiRipClearance(Ball.Position,BallRadius,0)
    local ProjectedClearance,ProjectedPlayer,ProjectedPart=
    State.AutoOffense.ScanAntiRipClearance(BallProjected,BallRadius,Lead)
    State.AutoOffense.AntiRipLead=Lead
    State.AutoOffense.AntiRipClearance=CurrentClearance
    State.AutoOffense.AntiRipProjectedClearance=ProjectedClearance

    local Rim=State.AutoOffense.Target
    if not (Rim and Rim.Parent) then Rim=select(1,State.AutoOffense.GetScoringGoal()) end
    local GoalDelta=Rim and (Rim.Position-Root.Position) or Root.CFrame.LookVector
    local Forward=Vector3.new(GoalDelta.X,0,GoalDelta.Z)
    if Forward.Magnitude<=.01 then Forward=Vector3.new(Root.CFrame.LookVector.X,0,Root.CFrame.LookVector.Z) end
    Forward=Forward.Magnitude>.01 and Forward.Unit or Vector3.new(0,0,-1)
    local Right=Vector3.new(-Forward.Z,0,Forward.X)
    local WalkSpeed=math.max(12,tonumber(Humanoid.WalkSpeed) or 16)
    local Travel=WalkSpeed*Lead*1.05
    local BestSign=State.AutoOffense.BackdownStrafeSign>=0 and 1 or -1
    local BestDirection=nil
    local BestClearance=-math.huge
    for _,Sign in ipairs({-1,1}) do
        local Candidate=Forward*.16+Right*Sign
        Candidate=Candidate.Magnitude>.01 and Candidate.Unit or Right*Sign
        local CandidateBall=Ball.Position+Candidate*Travel
        local Clearance=State.AutoOffense.ScanAntiRipClearance(
            CandidateBall,BallRadius,Lead)

        if Sign==BestSign then Clearance+=.08 end
        if Clearance>BestClearance then
            BestClearance=Clearance
            BestSign=Sign
            BestDirection=Candidate
        end
    end

    local ThreatClearance=math.min(CurrentClearance,ProjectedClearance)
    local Threat=ThreatClearance<=0
    local NearThreat=ThreatClearance<=math.max(.35,Padding*.40)
    if Threat or NearThreat then
        local ThreatPlayer=ProjectedClearance<=CurrentClearance and ProjectedPlayer or CurrentPlayer
        local ThreatPart=ProjectedClearance<=CurrentClearance and ProjectedPart or CurrentPart
        State.AutoOffense.AntiRipThreatPlayer=ThreatPlayer
        State.AutoOffense.AntiRipThreatPart=ThreatPart
        State.AutoOffense.AntiRipLastThreatAt=Now
        State.AutoOffense.AntiRipHoldUntil=Now+.20
        State.AutoOffense.AntiRipActive=true
        State.AutoOffense.AntiRipEscapeSign=BestSign
        State.AutoOffense.BackdownStrafeSign=BestSign
        State.AutoOffense.StealRangeLatched=true
        State.AutoOffense.StealRangeClearSince=0
        State.AutoOffense.StrafeLockUntil=Now+.12
        State.AutoOffense.LastCutbackAt=Now
        State.AutoOffense.PendingHardCut=false
        State.AutoOffense.HandSwitchAllowed=false
        State.AutoOffense.HandSwitchBlockedUntil=Now+.10
        State.AutoOffense.HandTurnAlignedSince=0
        State.AutoOffense.StrafeReason='PRESIM ANTI-RIP CUT'
        State.AutoOffense.DefenderCanReachBall=true
        local Court=State.AutoOffense.GetCourt()
        local Escape=BestDirection
        if Court then
            local Safe=State.AutoOffense.GetBoundarySafeDirection(Root,Escape,Court)
            if Safe and Safe.Magnitude>.01 then Escape=Safe.Unit end
        end
        State.AutoOffense.AntiRipEscapeDirection=Escape
        State.AutoOffense.SmoothedMoveDirection=Escape
        State.AutoOffense.LastIssuedDirection=Escape
        if CONFIG.AutoOffenseAntiRipInstantCut~=false
            and State.Runtime.AcquireMovement('AntiRip',.08) then
            Humanoid:Move(Escape,false)
        end
        local DefenderRoot=ThreatPlayer and ThreatPlayer.Character
            and safe_find(ThreatPlayer.Character,'HumanoidRootPart')
        local HandleAction
        if DefenderRoot and State.AutoOffense.TryBallProtection then
            HandleAction = State.AutoOffense.TryBallProtection(
                Root, DefenderRoot, Forward, Right,
                BestSign < 0 and 'LEFT' or 'RIGHT')
        end
        if DefenderRoot then
            local Away=Root.Position-DefenderRoot.Position
            Away=Vector3.new(Away.X,0,Away.Z)
            if Away.Magnitude>.01 then
                State.AutoOffense.FaceDirection(Root,Away.Unit,DeltaTime,145)
            end
        end
        local Shield=State.AutoOffense.TryEarlyNoSteal(Now)
        State.AutoOffense.ProtectStatus = HandleAction
            and (Shield .. ' | ' .. HandleAction) or Shield
        State.AutoOffense.AntiRipStatus=string.format(
            'CUT %s | %.2f | %dMS | %s',
            BestSign<0 and 'LEFT' or 'RIGHT',ThreatClearance,
            math.floor(Lead*1000+.5),Shield)
        return
    end

    if State.AutoOffense.AntiRipActive and Now<(State.AutoOffense.AntiRipHoldUntil or 0) then
        local Escape=State.AutoOffense.AntiRipEscapeDirection
        if Escape and Escape.Magnitude>.01 and CONFIG.AutoOffenseAntiRipInstantCut~=false
            and State.Runtime.AcquireMovement('AntiRip',.08) then
            Humanoid:Move(Escape,false)
            State.AutoOffense.SmoothedMoveDirection=Escape
            State.AutoOffense.LastIssuedDirection=Escape
        end
        State.AutoOffense.AntiRipStatus=string.format(
            'HOLD %s | %.2f',State.AutoOffense.AntiRipEscapeSign<0 and 'LEFT' or 'RIGHT',
            ThreatClearance)
        return
    end

    if State.Runtime.MovementOwner=='AntiRip' then State.Runtime.ReleaseMovement('AntiRip') end
    State.AutoOffense.AntiRipActive=false
    State.AutoOffense.AntiRipThreatPlayer=nil
    State.AutoOffense.AntiRipThreatPart=nil
    State.AutoOffense.AntiRipStatus=string.format(
        'CLEAR | %.2f | %dMS',ThreatClearance,math.floor(Lead*1000+.5))
end

function State.AutoOffense.GetDefender()
    local Character = LP.Character
    local Root = Character and safe_find(Character, 'HumanoidRootPart')
    if not Root then return nil, math.huge end

    local Now = os.clock()
    if Now - State.AutoOffense.DefenderCachedAt < 0.10 then
        local Cached = State.AutoOffense.DefenderCache
        local CachedRoot = Cached and Cached.Character
            and safe_find(Cached.Character, 'HumanoidRootPart')
        if CachedRoot then
            return Cached, (CachedRoot.Position - Root.Position).Magnitude
        end
        if Cached == false then return nil, math.huge end
    end

    local Ok, Player, Distance = pcall(State.AutoBody.FindDefender, Root)
    if Ok then
        State.AutoOffense.DefenderCache = Player or false
        State.AutoOffense.DefenderCachedAt = Now
        return Player, Distance or math.huge
    end

    local Closest, ClosestDistance = nil, math.huge
    for _, Candidate in ipairs(Players:GetPlayers()) do
        if Candidate ~= LP and IsGuardOpponent(Candidate) then
            local TargetRoot = Candidate.Character
                and safe_find(Candidate.Character, 'HumanoidRootPart')
            if TargetRoot then
                local Gap = (TargetRoot.Position - Root.Position).Magnitude
                if Gap < ClosestDistance then
                    ClosestDistance = Gap
                    Closest = Candidate
                end
            end
        end
    end
    State.AutoOffense.DefenderCache = Closest or false
    State.AutoOffense.DefenderCachedAt = Now
    return Closest, ClosestDistance
end

