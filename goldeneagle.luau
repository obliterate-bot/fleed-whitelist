    local function ResolveThemeRole(Value)
        if typeof(Value) ~= 'Color3' then return nil end
        for Role, Color in pairs(Theme) do
            if Value == Color then return Role end
        end
        return nil
    end

    local function New(ClassName, Properties, Parent)
        Properties = Properties or {}
        local SkipThemeBinding = Properties.__SkipThemeBinding == true
        local Object = Instance.new(ClassName)
        for Property, Value in pairs(Properties) do
            if string.sub(tostring(Property), 1, 2) ~= '__' then Object[Property] = Value end
        end
        if (ClassName == 'TextLabel' or ClassName == 'TextButton' or ClassName == 'TextBox')
            and tonumber(Properties.TextSize) then
            Object.TextSize = math.max(8, tonumber(Properties.TextSize))
        end
        Object.Parent = Parent
        if ClassName == 'UICorner' and Properties.CornerRadius == nil then
            Object.CornerRadius = UDim.new(0, 0)
        end
        for Property, Value in pairs(Properties) do
            if string.sub(tostring(Property), 1, 2) ~= '__' then
                local Role = not SkipThemeBinding and ResolveThemeRole(Value) or nil
                if Role and string.find(Property, 'Color', 1, true) then
                    table.insert(HubUI.ThemeBindings, { Object = Object, Property = Property, Role = Role })
                    if ClassName == 'UIStroke' and Role == 'Border' and Properties.__OuterBorder == true then
                        table.insert(HubUI.PrismBorders, Object)
                    end
                elseif Property == 'Font' then
                    table.insert(HubUI.FontBindings, {
                        Object = Object,
                        OriginalFont = Value,
                        OriginalTextSize = tonumber(Properties.TextSize),
                    })
                end
            end
        end
        return Object
    end

